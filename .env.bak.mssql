# Local values — NOT committed (see .gitignore). Copied from .env.example and filled in.
# Both docker-compose.yml and docker-compose.dev.yml read these via ${VAR} substitution.

# Tells Docker Compose which compose file plain `docker compose <command>` should use.
# Set to dev mode by default so a fresh clone "just works" for day-to-day coding — use
# `docker compose -f docker-compose.yml <command>` explicitly to reach build mode instead.
COMPOSE_FILE=docker-compose.dev.yml

# ── Host ports (left side of "HOST:CONTAINER" in each compose file's ports:) ──────────
BACKEND_PORT=8000
FRONTEND_PORT=3001

# ── Database — points at the SQL Server container/instance YOU run separately ─────────
# (backend reaches it via host.docker.internal — see either compose file's extra_hosts
# comment for why — so DB_HOST should almost always stay host.docker.internal, not an
# actual hostname, unless your DB genuinely lives elsewhere)
DB_CLIENT=mssql
DB_USER=sa
DB_HOST=host.docker.internal
DB_NAME=Emr
DB_PASSWORD=Password1!
DB_PORT=1433

# ── Backend secrets/config — copied from emr_node/.env's original dev defaults ────────
ENCRYPTION_KEY=admin@1234
JWT_SECRET=admin@1234
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=12345
COCD=MW

# ── Frontend — baked into the JS bundle at build time (build mode) or read at
# `next dev` startup (dev mode); see either compose file's NEXT_PUBLIC_* comment ────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL_CUSTOM=http://localhost:8001
NEXT_PUBLIC_CLIENT_NAME=KBS
