Private Sub MainSec_Format(ByVal pFormattingInfo As Object)
  wPicHskHt = Me.PicSk.Height: wPicHskWdt = Me.PicSk.Width
  wPic3DHt = Me.Pic3D.Height: wPic3DWdt = Me.Pic3D.Width
  
