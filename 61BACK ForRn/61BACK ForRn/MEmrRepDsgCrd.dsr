Private Sub AddlImagesSec_Format(ByVal pFormattingInfo As Object)
 
 'Sachin 3.11.0 - Additional Images
  Call SetRptPic(mf_Pic3DHt, mf_Pic3DWdth, PicImg1, FldDmTcTyp.Value, False, False, FldDmCd.Value, FldDmSz.Value, , , , , , , , , "1")
