  If mf_PicSkHt = 0 Then mf_PicSkHt = PicSk.Height
  If mf_PicSkWdth = 0 Then mf_PicSkWdth = PicSk.Width
  If mf_Pic3DHt = 0 Then mf_Pic3DHt = Pic3D.Height
  If mf_Pic3DWdth = 0 Then mf_Pic3DWdth = Pic3D.Width
