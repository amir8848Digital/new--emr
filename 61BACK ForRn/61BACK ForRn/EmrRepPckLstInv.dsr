Private Sub RHLogo_Format(ByVal pFormattingInfo As Object)
  If mf_PicHt = 0 Then mf_PicHt = PicLogo.Height
  If mf_PicWdth = 0 Then mf_PicWdth = PicLogo.Width
  Call SetRptLogoPic(mf_PicHt, mf_PicWdth, PicLogo, gs_CoCd, RHLogo)
End Sub

Private Sub PicSec_Format(ByVal pFormattingInfo As Object)
    
  If mf_PicHtS = 0 Then mf_PicHtS = picdes.Height
  If mf_PicWdthS = 0 Then mf_PicWdthS = picdes.Width
  
  Call SetRptPic(mf_PicHtS, mf_PicWdthS, picdes, "DM", False, True, FldDmCd.Value, FldDmSz.Value, PICSEC, , , , , , , FldOdPicNm.Value)
End Sub

