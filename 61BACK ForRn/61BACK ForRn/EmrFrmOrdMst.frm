ADC.StartCopy
  '  m_ObjCmd.adoCommand.NamedParameters = False
    BeginEmrProcess Me, "Order Copy"   '578.40
    
  
    
    mf_CpyRate = False: mf_CpyFrSameCust = False: ms_CpyRateCd = "": ms_CpyRateOpt = ""
    mf_CpyLabRate = False
    mf_CpyVal = True '*** (Jen 2.13)
    ' ***** Manali Trading Module
    mf_CpyDmId = False
    mf_CpyFrBase = False
    mf_CpyFrRef = False
    If ms_OmTcTyp = "JT" Then
      If ADC("wCpyDmId") = "Y" Then mf_CpyDmId = True
      If mBaseTc <> "" Then
        mf_CpyFrBase = True
      'ElseIf mRefTc = adc("wOmTc") Then
      ElseIf InStr(1, mRefTc, ADC("wOmTc")) >= 1 Then
        mf_CpyFrRef = True
      End If
    End If
    ' ***** Manali Trading Module
    
    If ADC("wCpyRt") = "Y" Then
      mf_CpyRate = True
      'mf_CpyVal = True    '*** (Jen 2.13)
    End If
    If ADC("wCpyLabRt") = "Y" Then mf_CpyLabRate = True
    'If mf_CpyLabRate = False Then mf_CpyVal = False  '*** (Jen 2.13)
    ms_CpyRateCd = ADC("wCpyRtOpt")
                            
    'If ms_CpyRateCd <> "GPSDCXAM" Then mf_CpyVal = False    '*** (Jen 2.13)
    ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                    "PMCd= '" + ADC("wCpyRtOpt") + "' ")
    
    If wo_rsSrcOM!OmCmCd = ADC("OmCmCd") Then mf_CpyFrSameCust = True
             
    ' ***** Manali 3.9.0 - Copy KT from PDC
    mb_CpyKT = moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + ADC("wOmTc") + "' and PValue='PL' ")
    
    
    ' Manoj 2.10.0
    If wCurrDsgExists = False And (ms_OmTcTyp <> "JT" Or (ms_OmTcTyp = "JT" And _
                    Not moCn.RecSeek("Select 'x' from InvHd where InCoCd= '" + ms_OmCoCd + "' and InTc= '" + ADC("OmTc") + "' " + _
                                        "and InYy= '" + ADC("OmYy") + "' and InChr= '" + ADC("OmChr") + "' and InNo= " + CStr(ADC("OmNo"))))) Then
    ' Manoj 2.10.0
      With wo_rsSrcOM
          'ADC("OmDt") = moCn.SrvrDate
    '??? do u copy orddate,podt,pono
          ADC("OmPrtCd") = !OmPrtCd
          ADC("OmPerson") = !OmPerson
          
          'ADC("OmPoNo") = !OmPoNo
          'ADC("OmPoDt") = !OmPoDt
          
          If mf_CpyRate = True Then
            If InStr(1, "," + ms_CpyRateOpt + ",", ",G,") >= 1 Then
              'ADC("OmLmgCst") = !OmLmgCst    ' ***** Manali 3.03 - Cst Rt/Val always from Current
              ADC("OmLmgDt") = !OmLmgDt
              ADC("OmLmgSal") = !OmLmgSal
            End If
            If InStr(1, "," + ms_CpyRateOpt + ",", ",P,") >= 1 Then
              'ADC("OmLmpCst") = !OmLmpCst    ' ***** Manali 3.03 - Cst Rt/Val always from Current
              ADC("OmLmpDt") = !OmLmpDt
              ADC("OmLmpSal") = !OmLmpSal
            End If
            
            ' ****** Sachin 2.12 - 01/12/05 - SJM ******
            If InStr(1, "," + ms_CpyRateOpt + ",", ",S,") >= 1 Then
              'ADC("OmLmsCst") = !OmLmsCst    ' ***** Manali 3.03 - Cst Rt/Val always from Current
              ADC("OmLmsDt") = !OmLmsDt
              ADC("OmLmsSal") = !OmLmsSal
            End If
            ' ****** Sachin 2.12 - 01/12/05 - SJM ******
            
            ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
            If InStr(1, "," + ms_CpyRateOpt + ",", ",L,") >= 1 Then
              'ADC("OmLmlCst") = !OmLmlCst    ' ***** Manali 3.03 - Cst Rt/Val always from Current
              ADC("OmLmlDt") = !OmLmlDt
              ADC("OmLmlSal") = !OmLmlSal
            End If
            ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
            
            ADC("OmMulBy") = !OmMulBy
            
            ADC("OmMrpMulBy") = !OmMrpMulBy         '4.1.4.0
            
            ADC("OmFixPrc") = !OmFixPrc
            ADC("OmGldAs") = !OmGldAs
            '****** Sachin 2.13.0 - 24-05-2006 ******
            ADC("OmLabAs") = !OmLabAs
            '****** Sachin 2.13.0 - 24-05-2006 ******
            
  '          '**Geeta***3.02 Patch***
            ADC("OmChgPtrOnStwYN") = ADC("wCpyChgPtrOnStwYN")
  '          '**Geeta***3.02 Patch***
            
            ADC("OmIWtEqOrd") = !OmIwtEqOrd
            ADC("OmIWtFrOrd") = !OmIWtFrOrd
            ADC("OmIGldRtEqOrd") = !OmIGldRtEqOrd
            
            '****** Zubin 3.02.01 - 27/03/08
            ADC("OmILabWtFrOrd") = IIF(ADC("wCpyLabRt") = "Y", !OmILabWtFrOrd, ADC("OmILabWtFrOrd"))
            '****** Zubin 3.02.01 - 27/03/08
            
          End If
          ADC("OmInvAllBags") = moCn.GetFldVal("Select CmInvAllBags from CustMst " + _
                                  "where CmCtg='" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
        
          '5.0.1 - Change 97
          ' HF.7(adding JSO)
          ADC("OMPONO") = IIF(ADC("OmPoNo") = "" And (chkFCPOSubPO.Value = vbChecked Or ms_OmTcTyp = "JT" Or ADC("wOmTc") = "JPO" Or ADC("wOmTc") = "JSO"), !OmPoNo, ADC("OmPoNo"))
          '6.1b-19
          ADC("OMSUBCUST") = IIF(ADC("OMSUBCUST") = "" And (chkFCPOSubPO.Value = vbChecked Or ms_OmTcTyp = "JT" Or ADC("wOmTc") = "JPO" Or ADC("wOmTc") = "JSO"), !OMSUBCUST, ADC("OMSUBCUST"))
                     
          If mf_CpyFrSameCust = True Then
            ADC("OmCmDelTerms") = !OmCmDelTerms
            ADC("OmCmPayTerms") = !OmCmPayTerms
            If ADC("OmCell") = "" Then
              ADC("OmCell") = !OmCell
            End If
          End If
      End With
      If Not ADC.SaveRec Then
        DispMsg "X Save Failed", etInfo
        EndEmrProcess Me  '578.40
        ADC.EndCopy
        Exit Sub
      End If
    ' Manoj 2.10.0
    End If
    ' Manoj 2.10.0
    mDsgSrNotCopied = ""
