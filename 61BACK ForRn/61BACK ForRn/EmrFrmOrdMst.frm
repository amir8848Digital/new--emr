Private Function ParamsCT(ps_Name As Integer) As Variant
    ParamsCT = m_objCmdCT.QryParameters(ps_Name)
End Function

Private Function InsOrdCTCpy(ByVal pOdSr As Long, ByRef ErrMsg As String) As Boolean
  On Error GoTo ErrH
  InitKeyForOrdCTCpy pOdSr
  m_objCmdCT.QryExecute
  InsOrdCTCpy = True
  Exit Function
ErrH:
  ErrMsg = "SrcOctSrNo/CTDets:" + CStr(ParamsCT(wOctSrNo)) + "/" + ParamsCT(wOctCd) + "/" + ParamsCT(wOctSz) + GetErrorMessage(Err.Description)
  InsOrdCTCpy = False
End Function

Private Sub InitKeyForOrdCTCpy(ByVal pOdSr As Long)
  With GrdOrdCT
    SetParamsValCT ms_OmCoCd, wOctCoCd
    SetParamsValCT ADC("OmTc"), wOctTc
    SetParamsValCT ADC("OmYy"), wOctYy
    SetParamsValCT ADC("OmChr"), wOctChr
    SetParamsValCT ADC("OmNo"), wOctNo
    SetParamsValCT pOdSr, wOctSr
    
    SetParamsValCT moCn.GetFldVal("Select OdIdNo From OrdDsg " + _
