                                       0, 0, 0, "C", 0, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                       IIF(1 = 1, ctCurrPrtn, "")), wOrAlyCstRt
      End If

End With
End Sub
Private Sub RecalcForCpy_GrdOrdRm(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  Dim wOldRmCtg As String, wRmSTWGrp As String
  Dim wOldSpGrav As Single, wNewSpGrav As Single
  Dim wOldRmSCtg As String
  
  Dim wRmDetOld As String, wRmSTWGrpOld As String    '*** (Jen 3.1.3)
  Dim wRmDetArr() As String
  
  '*** (Jen 2.13)
  Dim ws_BaseLme As Single
  '*** (Jen 2.13)
  
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  Dim wFndPcWt As Single
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  Dim wWtRngChg As String, wSetSalRt As Double

  Dim wReqStrSri As String
  wReqStrSri = "ROW:" + CStr(RowNum) + "||+ID:" + ColName + "||Source:" + SourceColName
  With GrdOrdRm
    Select Case ColName
      
    Case Is = UCase("OrLmeSal")
        RecalcForCpyRm_OrLmeSal RowNum, ColName, OldVal, SourceName, SourceColName
    Case Is = UCase("OrSalRt")
      RecalcForCpyRm_OrSalRt RowNum, ColName, OldVal, SourceName, SourceColName
    Case Is = UCase("OrSalVal")
      RecalcForCpy_OrSalVal
      
      
    Case Is = UCase("OrSetSalRt")
      RecalcForCpyRm_OrSetSalRt RowNum, ColName, OldVal, SourceName, SourceColName
    Case Is = UCase("OrSetSalVal")
      RecalcForCpy_OrSetSalVal
    Case Is = UCase("OrAlyCd")
          RecalcForCpy_OrAlyCd RowNum, ColName, OldVal, SourceName, SourceColName
    Case Is = UCase("OrAlySalRt")
      If .Mode = fgmnorm Or .Mode = fgmCopy Or mf_InCopyFromServer Then
        If mf_InCopyFromServer = True And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + ParamsRm(wOrRmCtg) + ",") >= 1 Or ParamsRm(wOrRmCtg) = "") Then Exit Sub
        SetParamsValRm GetRmRt(ADC("OmCmCd"), ParamsRm(wOrAlyCd), _
                                       0, 0, 0, "S", 0, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                       IIF(1 = 1, ctCurrPrtn, "")), wOrAlySalRt
      End If
    Case Is = UCase("OrCstRt")
      If .Mode = fgmnorm Or .Mode = fgmCopy Or mf_InCopyFromServer Then
        If mf_InCopyFromServer = True And mf_CstRtEdt = True And mf_CstRatePDCM = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + ParamsRm(wOrRmCtg) + ",") >= 1 Or ParamsRm(wOrRmCtg) = "") Then Exit Sub
        '6.1-13 , , added in GetGldrt of GPSL. these parameters ignored and partition key values entered in this palce
        'so LkupRmrt parameter passed as C (partition key)
        If ParamsRm(wOrRmCtg) = "G" Then
          SetParamsValRm GetGldRt(ADC("OmCmCd"), ADC("OmLmgCst"), _
                                      ParamsRm(wOrRmCd), ParamsRm(wOrAlyCstRt), _
                                      ms_DmTcTyp, Params(woddmcd), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
        ElseIf ParamsRm(wOrRmCtg) = "P" Then
          SetParamsValRm GetGldRt(ADC("OmCmCd"), ADC("OmLmpCst"), _
                                      ParamsRm(wOrRmCd), ParamsRm(wOrAlyCstRt), _
                                      ms_DmTcTyp, Params(woddmcd), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
        ElseIf ParamsRm(wOrRmCtg) = "S" Then
          If mf_SlvMod = True Then
            SetParamsValRm GetGldRt(ADC("OmCmCd"), ADC("OmLmsCst"), _
                                        ParamsRm(wOrRmCd), ParamsRm(wOrAlyCstRt), _
                                        ms_DmTcTyp, Params(woddmcd), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
          Else
            SetParamsVal 0, wOrCstRt
          End If
        ElseIf ParamsRm(wOrRmCtg) = "L" Then
          If mf_PdMod = True Then
            SetParamsValRm GetGldRt(ADC("OmCmCd"), ADC("OmLmlCst"), _
                                        ParamsRm(wOrRmCd), ParamsRm(wOrAlyCstRt), _
                                        ms_DmTcTyp, Params(woddmcd), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
          Else
            SetParamsValRm 0, wOrCstRt
          End If
        Else
            If ADC("OmHistCmCtg") <> vbNullString And _
                (UCase(ParamsRm(wOrRmCtg)) = "D" Or UCase(ParamsRm(wOrRmCtg)) = "C") Then
              SetParamsValRm GetRmRt(ADC("OmCmCd"), ParamsRm(wOrRmCd), _
                                      ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                      Round(MWLib.Div(ParamsRm(wOrPrdWt), ParamsRm(wOrPrdQty)), 5), "C", _
                                      0, ADC("OmCmCtg"), ADC("OmHistCmCtg"), ADC("OmHistCmCd"), ADC("OmHistYyyyMm"), ADC("OmCmCurCd"), , IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
            Else
              If UCase(ParamsRm(wOrRmCtg)) = "X" Then
                ws_BaseLme = moCn.GetFldVal("Select IsNull((Select (case B.RmCtg when 'G' then " + CStr(ADC("OmLmgCst")) + " " + _
                             "when 'P' then " + CStr(ADC("OmLmpCst")) + " when 'S' then " + CStr(ADC("OmLmsCst")) + " " + _
                             "when 'L' then " + CStr(ADC("OmLmlCst")) + " else 0 end) from RmMst B where " + _
                             "RmCd= (Select Rm.RmBaseCd from RmMst Rm where Rm.RmCd= '" + ParamsRm(wOrRmCd) + "' and RmPrtKey='" + ctCurrPrtn + "')  and RmPrtKey='" + ctCurrPrtn + "'), 0) ")
              Else
                ws_BaseLme = 0
              End If
              SetParamsValRm GetRmRt(ADC("OmCmCd"), ParamsRm(wOrRmCd), _
                                      ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                      Round(MWLib.Div(ParamsRm(wOrPrdWt), ParamsRm(wOrPrdQty)), 5), _
                                        "C", ws_BaseLme, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                      IIF(1 = 1, ctCurrPrtn, "")), wOrCstRt
            
            End If
        End If
      End If

    Case Is = UCase("OrCstVal")
      RecalcForCpy_OrCstVal
    Case Is = UCase("OrSetCstRt")
      If .Mode = fgmnorm Or .Mode = fgmCopy Or mf_InCopyFromServer Then
        Dim wSetCstRt As Double
        wWtRngChg = ""
        If (UCase(SourceColName) = UCase("OrPrdWt") And Val(OldVal) <> ParamsRm(wOrPrdWt)) Then
            wSetCstRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              .Value(RowNum, "OrSetSCd"), "C", _
                                              MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), ADC("OmCmCtg"), , _
                                              MWLib.Div(Val(OldVal), .Value(RowNum, "OrPrdQty")), wWtRngChg, ADC("OmCmCurCd"))
           
       ElseIf (UCase(SourceColName) = UCase("OrPrdQty") And Val(OldVal) <> ParamsRm(wOrPrdQty)) Then
            wSetCstRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "C", _
                                              MWLib.Div(ParamsRm(wOrPrdWt), ParamsRm(wOrPrdQty)), ADC("OmCmCtg"), , _
                                             MWLib.Div(ParamsRm(wOrPrdWt), Val(OldVal)), wWtRngChg, ADC("OmCmCurCd"))
           
       ElseIf UCase(SourceColName) <> UCase("OrPrdWt") And UCase(SourceColName) <> UCase("OrPrdQty") Then
               SetParamsValRm GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "C", _
                                              MWLib.Div(ParamsRm(wOrPrdWt), ParamsRm(wOrPrdQty)), ADC("OmCmCtg"), , , , ADC("OmCmCurCd")), wOrSetCstRt
      End If
      If wWtRngChg = "T" Then SetParamsValRm wSetCstRt, wOrSetCstRt
    End If
    Case Is = UCase("OrSetCstVal")
      RecalcForCpy_OrSetCstVal RowNum, ColName, OldVal, SourceName, SourceColName
    
    Case Is = UCase("OrAlyCstRt")
      RecalcForCpy_OrAlyCstRt RowNum, ColName, OldVal, SourceName, SourceColName
    Case Is = UCase("OrCustRmCd")
      RecalcForCpy_OrCustRmCd RowNum, ColName, OldVal, SourceName, SourceColName
    End Select
  End With
End Sub
