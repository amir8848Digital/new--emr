              wOdYy = wOdKeyArr(1)
              wOdChr = wOdKeyArr(2)
              wOdNo = wOdKeyArr(3)
              wOdSr = wOdKeyArr(4)
              Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg " + _
                                        " Join OrdMst On OmCoCd=OdCoCd and OmTc=OdTc and OmChr=OdChr and OmNo=OdNo and OmIdNo=OdOmIdNo and OmPrtKey=OdPrtKey " + _
                                        " Join TcMst On TmCoCd=OdCoCd and TmTc='" + ms_OmTc + "' and TmBaseTcs=OdTc " + _
                                        " Where OdCoCd='" + IIF(ms_OmTc = "JIN" Or ms_OmTc = "LIN", ADC("OmBaseCoCd"), ms_OmCoCd) + "' and OdTc='" + wOdTc + "' " + _
                                        " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                        " and OdDmCd='" + .Value(RowNum, "OdDmCd") + "'  " + _
                                        " and OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd='" + ADC("OmCmCd") + "' " + _
                                        " and OdPrtKey='" + ctCurrPrtn + "' ")
              If Cancel = True Then ErrMsg = "Invalid Base Voucher": Exit Sub
'            ElseIf wBaseMustYn = "Y" And NewValue = "" Then
'              Cancel = True: ErrMsg = "Base Voucher Is Must, Cannot Be Blank": Exit Sub

            End If
          End If

        End If
      End If
    ' ***** Manali Trading Module
    Case Is = UCase("wOdRefVchSr")
      If ms_OmTcTyp = ctJtTcTyp Then
        If .Mode = fgmnorm Or .Mode = fgmCopy Or .Mode = fgmInitOver Then
'          If GrdOrdRm.Rows - 1 > 0 Or GrdOrdLab.Rows - 1 > 0 Then
'            Cancel = NewValue <> "" And NewValue <> .Value(RowNum, "wOdRefVchSr") And .Value(RowNum, "wOdRefVchSr") <> ""
'            If Cancel = True Then ErrMsg = "Reference Voucher Cannot be changed when Rm/lab Details Exist": Exit Sub
'          End If
          If mRefTc <> "" Then
            If NewValue <> "" Then
              wOdKeyArr = Split(NewValue, "/")
              If UBound(wOdKeyArr) <> 4 Then Cancel = True: ErrMsg = "Invalid Reference Voucher": Exit Sub
              If Not (IsNumeric(wOdKeyArr(3)) And IsNumeric(wOdKeyArr(4))) Then Cancel = True: ErrMsg = "Invalid Reference Voucher": Exit Sub
              wOdTc = wOdKeyArr(0)
              wOdYy = wOdKeyArr(1)
              wOdChr = wOdKeyArr(2)
              wOdNo = wOdKeyArr(3)
              wOdSr = wOdKeyArr(4)
              Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg " + _
                                        " Join TcMst On TmCoCd=OdCoCd and TmTc='" + ms_OmTc + "' and ','+TmRefTcs+',' like '%,'+OdTc +',%' " + _
                                        " Where OdCoCd='" + ms_OmCoCd + "' and OdTc='" + wOdTc + "' " + _
                                        " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                        " and OdDmCd='" + .Value(RowNum, "OdDmCd") + "' " + _
                                        " and OdPrtKey='" + ctCurrPrtn + "'  ")
              If Cancel = True Then ErrMsg = "Invalid Reference Voucher": Exit Sub

            End If
          End If
        End If
      End If
    Case Is = UCase("OdJLRmCd")
    Cancel = .Value(RowNum, "ODPrtKey") = ctCurrPrtn And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                           "RmCd = '" + NewValue + "' And RmPrtKey='" + ctCurrPrtn + "'"))
      If Cancel = True Then ErrMsg = "Invalid Raw Material Code": Exit Sub
                             
    Case Is = UCase("OdJLRateByQw")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'LABQW' And PMCd = '" + NewValue + "'")
      ErrMsg = "Invalid RateBy QW": Exit Sub
    Case Is = UCase("OdMrpDisc")
       If mf_MrpChr Then
          Dim wMrdInMst As Double
          wMrdInMst = GetMRD(ADC("OmCmCtg"), ADC("OmCmCd"), GrdOrdDsg.Value(RowNum, "OdDmCd"), _
                            GrdOrdDsg.Value(RowNum, "OdDmSz"), GrdOrdDsg.Value(RowNum, "OdSfx"))
          If NewValue > wMrdInMst Then
            Cancel = True: ErrMsg = "MRP Discount cannot be greater than " + CStr(wMrdInMst): Exit Sub
          End If
          CalculateOdSalPrcFromMrp RowNum, NewValue
       End If
    End Select
  End With
End Sub
Private Sub CalculateOdSalPrcFromMrp(ByVal RowNum As Integer, Optional OdMrpDisc As Variant = -1)
  If OdMrpDisc = -1 Then
    OdMrpDisc = GrdOrdDsg.Value(RowNum, "OdMrpDisc")
  End If
  GrdOrdDsg.Value(RowNum, "OdSalPrc") = FnRndOff(GrdOrdDsg.Value(RowNum, "OdMrp") * (1 - OdMrpDisc / 100), 2, _
                                    moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd= '" + ADC("OmCmCd") + "'"))
   
End Sub

Private Sub ForCpy_CalculateOdSalPrcFromMrp(ByVal RowNum As Integer, Optional OdMrpDisc As Variant = -1)
  If OdMrpDisc = -1 Then
      OdMrpDisc = Params(wOdMrpDisc)
  End If
  SetParamsVal FnRndOff(Params(wOdMrp) * (1 - OdMrpDisc / 100), 2, _
                                    moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd= '" + ADC("OmCmCd") + "'")), wOdSalPrc
   
End Sub
Private Function ValidateBagOrDmStkNumForRepair(ByVal NewValue As Variant, ByVal RowNum As Integer, ByRef Cancel As Boolean, ByRef ErrMsg As String, ByRef wMatchesBagYN As String, ByRef wExistingDmStkNumYN As String) As Boolean
  If ms_OmTc = "JRI" Then
    'Can be there in an Emr bag, if so check if same DmCd, Sfx,Sz
    If moCn.RecSeek("Select 'x' from Bag where " + _
               "BCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and BYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and BChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and BNo = " + CStr(NewValue) + " ") Then
        wMatchesBagYN = "Y"
        Cancel = Not moCn.RecSeek("Select 'x' from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "BCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and BOdDmCd='" + GrdOrdDsg.Value(RowNum, "OdDmCd") + "' and BOdSfx='" + GrdOrdDsg.Value(RowNum, "OdSfx") + _
               "' and BOdDmSz='" + GrdOrdDsg.Value(RowNum, "OdDmSz") + "' and BYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and BChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and BNo = " + CStr(NewValue) + " and BCls='Y' and BLoc='PFG' and BRepYN='N'")
        ErrMsg = "Given DmStkNo not a valid Bag No For this Dsg Code-Sz-Suffix or Bag not closed or Bag not in FG or Bag already in Repair"
    Else
      ' no Emr bag but can be a valid DmStkNum from jEmr
      If moCn.RecSeek("Select 'x' from OrdDsg where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "OdDmStkCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' " + _
               " and OdDmStkYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and OdDmStkChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and OdDmStkNo = " + CStr(NewValue) + " ") Then
        wExistingDmStkNumYN = "Y"
        ' if so is it same DmCd, DmSfx and DmSz
        Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "OdDmStkCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and OdDmCd='" + GrdOrdDsg.Value(RowNum, "OdDmCd") + "' and OdSfx='" + GrdOrdDsg.Value(RowNum, "OdSfx") + _
               "' and OdDmSz='" + GrdOrdDsg.Value(RowNum, "OdDmSz") + "' and OdDmStkYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and OdDmStkChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and OdDmStkNo = " + CStr(NewValue) + " ")
        ErrMsg = "Given DmStkNo Not A valid DmStkNum for this Dsg Code-Sz-Suffix or given DmStkNum not present in System "
      Else
        ' can be not a bag and not a DmStkNum new DmStkNum ok for JRI
        wExistingDmStkNumYN = "N"
        wMatchesBagYN = "N"
        Cancel = False
        ErrMsg = ""
      End If
    End If
  ElseIf ms_OmTc = "JRO" Then
    'JRO it has to be a valid bag or a valid DmStkNum, cannot be just standing by itself
    wMatchesBagYN = "N"
    wExistingDmStkNumYN = "N"
    If moCn.RecSeek("Select 'x' from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "BCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and BOdDmCd='" + GrdOrdDsg.Value(RowNum, "OdDmCd") + "' and BOdSfx='" + GrdOrdDsg.Value(RowNum, "OdSfx") + _
               "' and BOdDmSz='" + GrdOrdDsg.Value(RowNum, "OdDmSz") + "' and BYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and BChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and BNo = " + CStr(NewValue) + " ") Then
       wMatchesBagYN = "Y"
       Cancel = Not moCn.RecSeek("Select 'x' from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "BCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and BOdDmCd='" + GrdOrdDsg.Value(RowNum, "OdDmCd") + "' and BOdSfx='" + GrdOrdDsg.Value(RowNum, "OdSfx") + _
               "' and BOdDmSz='" + GrdOrdDsg.Value(RowNum, "OdDmSz") + "' and BYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and BChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and BNo = " + CStr(NewValue) + " and BRepYN='Y' ")
       ErrMsg = "Given DmStkNo Not Valid BagNo or Bag not of this Dsg Code-Sz-Suffix Combination or Bag not in Repair"
    Else
      If moCn.RecSeek("Select 'x' from OrdDsg where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "OdDmStkCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' " + _
               " and OdDmStkYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and OdDmStkChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and OdDmStkNo = " + CStr(NewValue) + " ") Then
        wExistingDmStkNumYN = "Y"
      End If
      Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg where OdTc='JRI' and " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey= '" + ctCurrPrtn + "' And ", "") + _
               "OdDmStkCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and OdDmCd='" + GrdOrdDsg.Value(RowNum, "OdDmCd") + "' and OdSfx='" + GrdOrdDsg.Value(RowNum, "OdSfx") + _
               "' and OdDmSz='" + GrdOrdDsg.Value(RowNum, "OdDmSz") + "' and OdDmStkYy = '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + _
               "' and OdDmStkChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and OdDmStkNo = " + CStr(NewValue) + " ")
      ErrMsg = "Given DmStkNo Not A valid DmStkNum for this Dsg Code-Sz-Suffix or given DmStkNum not in Repair"
    End If
  End If
  ValidateBagOrDmStkNumForRepair = Cancel
End Function

