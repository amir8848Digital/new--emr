                    "' and OdDmStkChr = '" + GrdOrdDsg.Value(r, "OdDmStkChr") + "' and ODDmStkNo =" + CStr(GrdOrdDsg.Value(r, "ODDmStkNo")) + _
                    " and OdCoCd+'/'+OdTc+'/'+OdYy+'/'+OdChr+'/'+ltrim(str(OdNo))+'/'+LTrim(Str(OdSr))<> '" + ms_OmCoCd + "/" + ADC("OmTc") + _
                    "/" + ADC("OmYy") + "/" + ADC("OmChr") + "/" + CStr(ADC("OmNo")) + "/" + CStr(GrdOrdDsg.Value(r, "OdSr")) + "'")

      If wOrdDsgCnt > 0 Then wOrdDsgStr = wOrdDsgStr + IIF(wOrdDsgStr <> "", ",", "") + CStr(wOrdDsgCnt)
    Next r
    
    m_AddAmtNewVal = moCn.GetFldVal("select InAmt12 from InvHd where InCoCd ='" + ms_OmCoCd + "' and InTC='" + ADC("OmTc") + _
