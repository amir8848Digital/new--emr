        ADC.AllowAdd = True
        'ADC.AllowDelete = True
      Else
        Call SetAdcAllowAddDel("ADD", True)
        'Call SetAdcAllowAddDel("DELETE", True)
      End If
      ADC.AllowDelete = True
      '*** (Jen 3.01)
    End If
 '***Geeta***Crm***2.12
   End If
   
   '************Geeta*********Emr207***
   '19 wNewDt added to check new order date
   
 Case Is = UCase("OmDt")
    Cancel = (pv_NewValue = "")
