Private Sub atxt_KeyDown(Index As Integer, KeyCode As Integer, Shift As Integer)
  If KeyCode = vbKeyTab Then
    If Index = 42 Then
      Dim i As Integer
      i = 10
    End If
  End If

  'Vk.4 - Press Ctrl+W to exit from RfId text box, cursor will move to GetDsg command button
  If KeyCode = vbKeyW And Shift = 2 Then
    If atxt(Index).IdName = UCase("wDsCpyRfId") Then
      cmdStkCpyGo.SetFocus
    End If
  End If
End Sub
