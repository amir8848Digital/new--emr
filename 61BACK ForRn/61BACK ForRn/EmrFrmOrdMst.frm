Private Function CopyOrLotVal(ByVal pv_OrdCpy As Boolean, ByVal CopyFromInv As Boolean, ByVal CopyFromDsgMst As Boolean, ByVal wTgt_OdTc As String, ByVal wSrcOd_OdTc As String, InvOdCoCd As String, InvOdYy As String, InvOdTc As String, InvOdChr As String, InvOdNo As Long, InvOdSr As Long, wOrRmCd As String, wOrLotNo As String, wi_RmRow As Integer)
    If ChkCopyOrLotVal(pv_OrdCpy, CopyFromInv, CopyFromDsgMst, wTgt_OdTc, wSrcOd_OdTc, InvOdCoCd, InvOdYy, InvOdTc, InvOdChr, InvOdNo, InvOdSr, wOrRmCd, wOrLotNo, wi_RmRow) Then
