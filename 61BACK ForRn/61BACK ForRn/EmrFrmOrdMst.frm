Private Sub ADC_NonKeyValid(pr_Cancel As Boolean, pr_ErrMsg As String)
  '****** For All entries in OrdDsg there should be atleast one row of OrdRm where OrMainMet= 'Y' ***
  Dim wOdSr As Single, wOdRec As MDORowSet, wOdSrStr As String, wOdSrStrForNegativeVal As String
  wOdSr = 0
  
  Dim wb_TmJLooseTC  As String
  'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
  wb_TmJLooseTC = moCn.GetFldVal("Select TmJLooseTC   from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'")
  'uma *** Repair In/OUT
  If ADC("OmTc") = "PL" Or ADC("OmTc") = "QB" Or ADC("OmTc") = "QT" Or ADC("OmTc") = "SO" Then wb_TmJLooseTC = "N"
  
  'vm.4 - when save record this check applies only to PDCM, gets filter condition from scope frame
  'it checks filter given in scope OR any new record added to Dsg grid
  Dim wScCnd As String
  If ADC("OmTc") = "PL" Then
    wScCnd = IIF(ms_ScCnd <> "", " and ((" + ms_ScCnd + ") Or (OdSr > " + CStr(mi_MaxOdSr) + ")) ", "")
  End If
  If wb_TmJLooseTC = "N" And ms_OmTc <> "JRI" And ms_OmTc <> "JRO" Then
    'vm.4 1 wScCnd added
    wOdSr = moCn.GetFldVal("Select min(OdSr) from OrdDsg where " + _
                           "OdCoCd= '" + ms_OmCoCd + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                           "OdYy='" + ADC("OmYy") + "' and OdChr='" + ADC("OmChr") + "' and " + _
                           "OdNo=" + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "'" + " and " + _
                           "not exists(Select 'x' from OrdRm where " + _
                           "OrOdIdNo=OdIdNo and OrCoCd= OdCoCd and OrTc= OdTc and OrYy= OdYy and " + _
                           "OrChr= OdChr and OrNo= OdNo and OrSr= OdSr and OrPrtKey=OdPrtKey and OrMainMet= 'Y')" + wScCnd)
                           
    If wOdSr <> 0 Then pr_Cancel = True: pr_ErrMsg = "Main Metal Does Not Exist For Sr: " + CStr(wOdSr): Exit Sub
    'vm.4 2 wScCnd added
    wOdSr = moCn.GetFldVal("Select min(OdSr) from OrdDsg where " + _
                           "OdCoCd= '" + ms_OmCoCd + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                           "OdYy='" + ADC("OmYy") + "' and OdChr='" + ADC("OmChr") + "' and " + _
                           "OdNo=" + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "'" + " and " + _
                           " exists(Select 'x' from OrdRm where OrWt = 0 and " + _
