      Or Trim(IdName) = UCase("wOmChr") Or Trim(IdName) = UCase("wOmNo") Or Trim(IdName) = UCase("wFrOdPrtCd") Or Trim(IdName) = UCase("wToOdPrtCd") Then _
  mf_PDCSelCnt = False
  
 Select Case Trim(IdName)
 
