                    ElseIf .Value(wi_L, "OlMCd") = ctCBRKLMCd And .Value(wi_L, "OlQw") = "Q" Then
                              wLabAsWt = 0#
                                            .Value(wi_L, "OlSalRt") = GetLabRt(ADC("OmCmCd"), .Value(wi_L, "OlMCd"), _
