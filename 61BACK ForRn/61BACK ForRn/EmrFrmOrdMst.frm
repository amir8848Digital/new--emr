Private Function ChkCopyOrLotVal(ByVal pv_OrdCpy As Boolean, ByVal CopyFromInv As Boolean, ByVal CopyFromDsgMst As Boolean, ByVal wTgt_OdTc As String, ByVal wSrcOd_OdTc As String, InvOdCoCd As String, InvOdYy As String, InvOdTc As String, InvOdChr As String, InvOdNo As Long, InvOdSr As Long, wOrRmCd As String, wOrLotNo As String, wi_RmRow As Integer) As Boolean
    ChkCopyOrLotVal = False
    Dim wSrcTcIsJT As String
    Dim wTargetTcIsJT As String
    ChkCopyOrLotVal = False
    If (Not mb_OrLot) Or moCn.GetFldVal("Select RmCtg from RmMst where RmCd = '" + wOrRmCd + "'") <> "D" Then
      ChkCopyOrLotVal = False
      Exit Function
    End If
    If moCn.RecSeek("Select 'a' from OrdTgt where (OtRmCtg='D' and OtCoCd= '" + ms_OmCoCd + "' and " + _
                    "OtTc= '" + ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and " + _
                    "OtChr= '" + ADC("OmChr") + "' and OtNo= " + CStr(ADC("OmNo")) + " and " + _
                    IIF(pv_OrdCpy = True, "OtSr= 0 ", "OtSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))) + ")") Then
        ChkCopyOrLotVal = False
        Exit Function
    End If
    If (CopyFromDsgMst) Then
      ChkCopyOrLotVal = False
      Exit Function
    End If
    wSrcTcIsJT = moCn.GetFldVal("Select 'Y' from Param where PValue='JT' and PTyp= 'TC' and PMCd= '" + wSrcOd_OdTc + "' and PValue1='N' ")
    wTargetTcIsJT = moCn.GetFldVal("Select 'Y' from Param where PValue='JT' and PTyp= 'TC' and PMCd= '" + wTgt_OdTc + "' and PValue1='N' ")
    'HF.7 added JSO
    If ((wTgt_OdTc = "SO" And (wSrcOd_OdTc = "JPO" Or wSrcOd_OdTc = "JSO")) Or (wTargetTcIsJT = "Y" And wSrcTcIsJT = "Y")) Then
      ChkCopyOrLotVal = True
      Exit Function
    End If
    
    If CopyFromInv = True And wTargetTcIsJT = "Y" Then
        If moCn.RecSeek("Select 'a'  " + _
                   "From OrdRm where OrCoCd= '" + InvOdCoCd + "' " + _
                   " and OrTc = '" + InvOdTc + "' " + _
                   " and OrYy= '" + InvOdYy + "' " + _
                   " and OrChr= '" + InvOdChr + "' " + _
                   " and OrNo = " + CStr(InvOdNo) + _
                   " and OrSr= " + CStr(InvOdSr) + _
                   " and OrRmCd= '" + wOrRmCd + "' and OrLotNo = '" + wOrLotNo + "'") Then
          ChkCopyOrLotVal = True
          Exit Function
        End If
     End If
     
End Function

