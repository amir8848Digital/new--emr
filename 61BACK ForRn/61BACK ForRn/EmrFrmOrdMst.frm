Private Function GetGrd(ps_GrdName As String) As MwfCtl.MWCTL_FLX
  Dim wo_Grd As MwfCtl.MWCTL_FLX
  
  Select Case UCase(ps_GrdName)
  Case Is = UCase("GrdOrdDsg")
    Set wo_Grd = GrdOrdDsg
  Case Is = UCase("GrdOrdLab")
    Set wo_Grd = GrdOrdLab
  Case Is = UCase("GrdOrdRm")
    Set wo_Grd = GrdOrdRm
  Case Is = UCase("GrdOrdAmd")
    Set wo_Grd = GrdOrdAmd
  Case Is = UCase("GrdOrdTgt")
    Set wo_Grd = GrdOrdTgt
  Case Is = UCase("GrdOrdCT")
    Set wo_Grd = GrdOrdCT
  Case Is = UCase("GrdDsgSel")
    Set wo_Grd = GrdDsgSel
  Case Is = UCase("GrdDsgAnaSel")
    Set wo_Grd = GrdDsgAnaSel
  Case Is = UCase("GrdOrdDsgTgt")
    Set wo_Grd = GrdOrdDsgTgt
  Case Is = UCase("GrdOrdDsgSumm")
    Set wo_Grd = GrdOrdDsgSumm
  Case Is = UCase("GrdDsgLabSumm")
    Set wo_Grd = GrdDsgLabSumm
  Case Is = UCase("GrdDsgRmSumm")
    Set wo_Grd = GrdDsgRmSumm
  Case Is = UCase("GrdOrdLabSumm")
    Set wo_Grd = GrdOrdLabSumm
  Case Is = UCase("GrdOrdRmSumm")
    Set wo_Grd = GrdOrdRmSumm
  Case Is = UCase("GrdOrdTgt")
    Set wo_Grd = GrdOrdTgt
  Case Is = UCase("GrdHR")
    Set wo_Grd = GrdHR
  Case Is = UCase("GrdHL")
    Set wo_Grd = GrdHL
  Case Is = UCase("GrdHD")
    Set wo_Grd = GrdHD
  End Select
  
  Set GetGrd = wo_Grd
  Set wo_Grd = Nothing
End Function

Private Function ColSty(ByVal pe_CurrStyle As en_fgColStyle, ByVal ps_ColSty As String) As en_fgColStyle
  '*** Function to return the Style of columns in the Grid
  Select Case ps_ColSty
  Case Is = "I"
    ColSty = en_fgColStyle.fgcinvisible
  Case Is = "D"
    If pe_CurrStyle = fgcReadOnly Or pe_CurrStyle = fgcNormal Then
      ColSty = en_fgColStyle.fgcReadOnly
    Else
      ColSty = pe_CurrStyle
    End If
  Case Is = "E"
    If pe_CurrStyle = fgcNormal Then
      ColSty = en_fgColStyle.fgcNormal
    Else
      ColSty = pe_CurrStyle
    End If
  End Select
End Function
Private Sub SetGrdEnaVis(ByVal ps_GrdName As String, ByVal pb_Enable As Boolean, ByVal pb_visible As Boolean)
  '*** Procedure to set the Enable/ Disable property of Grid.
  Dim wo_Grd As MwfCtl.MWCTL_FLX, ws_Style As String
  Set wo_Grd = GetGrd(ps_GrdName)
  
  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                            "and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + ps_GrdName + "' and UrName= '' ")
  
  Select Case UCase(ws_Style)
  Case Is = "", "E"
    wo_Grd.Enabled = True
    wo_Grd.Visible = True
  Case Is = "D"
    wo_Grd.Enabled = False
    wo_Grd.Visible = True
  Case Is = "I"
    wo_Grd.Enabled = False
    wo_Grd.Visible = False
  End Select
  
  If pb_Enable = False Then wo_Grd.Enabled = False
  If pb_visible = False Then wo_Grd.Visible = False
End Sub

