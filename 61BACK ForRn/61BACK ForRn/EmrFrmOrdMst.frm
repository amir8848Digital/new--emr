      If Not moCn.RecSeek("select 'x' from RmRtHist where " + _
            "RhCmCtg = '" + ADC("OmCmCtg") + "' and RhCmCd = isnull((Select max(RhCmCd) from RmRtHist where " + _
            "RhCmCtg = '" + ADC("OmCmCtg") + "' and RhCmCd = '" + ADC("OmHistCmCd") + "' and RhYyyyMm = " + _
