                                          " and OdYy='" + wIDkey_OdYy + "' and OdChr='" + wIdKey_OdChr + "' and OdNo=" + CStr(wIdKey_OdNo) + " and OdSr=" + CStr(widkey_odsr) + " " + _
                                          " and OdPrtKey='" + ctCurrPrtn + "' ")
                                          
          End If
        Else
         GetOdIdKey = 0
        End If
     ' End If
     ' GetOdIdKey = wOdBaseIdKey
