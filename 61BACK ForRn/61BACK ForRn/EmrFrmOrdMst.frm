Private Sub ADC_KeyValid(Cancel As Boolean, ErrMsg As String)
  '*** Force the user to enter proper Tc, Yy, Chr values
  Call ATXT_FldChange(99, "OmYy", Cancel, ErrMsg, ADC("OmYy"))
  If Cancel = True Then Exit Sub
  Call ATXT_FldChange(99, "OmTc", Cancel, ErrMsg, ADC("OmTc"))
  If Cancel = True Then Exit Sub
  Cancel = (Not moCn.RecSeek("Select vPSCd from vParam where " + _
                         "vPCoCd= '" + ms_OmCoCd + "' and vPTyp= 'CHR' and " + _
                         "vPMCd = '" + ADC("OmTc") + "' and vPSCd='" + ADC("OmChr") + "'"))
  '*** Jay 3.4(FG)
  If Cancel = True Then ErrMsg = "Invalid Voucher Character": Exit Sub
  '*** Jay 3.4(FG)
  '************Geeta*********Emr207***
  Call ATXT_FldChange(99, "OmChr", Cancel, ErrMsg, ADC("OmChr"))
  If Cancel = True Then ErrMsg = "User Has No Right To Access This Voucher Character": Exit Sub
  '*** Jay 3.4(FG)
  ' ***** Manali Trading Module   - Or ms_OmTc = "JMI" Or ms_OmTc = "JMS" Or ms_OmTc = "JSA" Or ms_OmTc = "JMI"
  If (ms_OmTc = "FOT") _
      And Not moCn.RecSeek("Select 'x' from InvHd where InCoCd= '" + ms_OmCoCd + "' and InTc= '" + ADC("OmTc") + "' " + _
                  "and InYy= '" + ADC("OmYy") + "' and InChr= '" + ADC("OmChr") + "' and InNo= " + CStr(ADC("OmNo"))) Then
    Cancel = True: ErrMsg = "Invoice Head Not Generated For This Voucher": Exit Sub
  End If
  '*** Jay 3.4(FG)
End Sub
Private Sub adc_AutoGen()
  '*** write code for AutoGenerating the Order Number
      'If the OmNo is Zero then generate the number
      'If the user himself enters the number then write this number in the autogen table (if it is greater than the number in the autogen table)
  If ADC("OmNo") = 0 Then
    ADC("OmNo") = moCn.AutoGen("OrdMst", "OmNo", ms_OmCoCd + ADC("OmTc") + ADC("OmYy") + ADC("OmChr"))
  Else
    Call moCn.AutoGen("OrdMst", "OmNo", ms_OmCoCd + ADC("OmTc") + ADC("OmYy") + ADC("OmChr"), ADC("OmNo"))
  End If
End Sub
Private Sub AutoGenDmStkNum(RowNum As Integer, AutoGenOrUpdateAutoGen As Boolean)
  '*** write code for AutoGenerating the DmStkNum
  'If number is Zero then generate the number
  'If the user himself enters the number then write this number in the autogen table (if it is greater than the number in the autogen table)
  'Stkcocd
  Dim wAutoGenNo As Long
  Dim wMaxNo As Long
  If AutoGenOrUpdateAutoGen Then
    wAutoGenNo = moCn.AutoGen("OrdDsg", "DmStkNum", GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + GrdOrdDsg.Value(RowNum, "OdDmStkChr"))
    wMaxNo = moCn.GetFldVal("select IsNull(max(OdDmStkNo), 0)+ 1 from OrdDsg where " + _
                                       " OdDmStkYy= '" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + "' and " + _
                                       "OdDmStkChr = '" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and " + _
                                       "OdDmStkCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "'")
    GrdOrdDsg.Value(RowNum, "OdDmStkNo") = IIF(wAutoGenNo > wMaxNo, wAutoGenNo, wMaxNo)
  Else
  ' never being called WITH AutoGenOrUpdateAutoGen flag set to False
    Call moCn.AutoGen("OrdDsg", "OdDmStkNo", GrdOrdDsg.Value(RowNum, "OdDmStkYy") + GrdOrdDsg.Value(RowNum, "OdDmStkChr"), GrdOrdDsg.Value(RowNum, "OdDmStkNum"))
  End If
End Sub
