        .Value(wi_OdRow, "OdPrdEnt") = IIF(ADC("wOmTc") = "JPO" Or ADC("wOmTc") = "JSO" Or ADC("wOmTc") = "JMT", .Value(wi_OdRow, "OdOrdEnt"), .Value(wi_OdRow, "OdPrdEnt"))
        
