'****** Sachin 3.3.0 (25-06-08) - [13. Copy From Invoice] ******
Private Sub CopyInv(ByVal ps_cocd As String, ByVal ps_IdTc As String, ByVal ps_IdYy As String, ByVal ps_IdChr As String, ByVal pi_IdNo As Long, Optional ByVal pi_IdSrFr As Integer, Optional ByVal pi_IdSrTo As Integer, Optional ByVal pi_ApplyXDM As String)

  Dim InvExist As Boolean, ws_Cnd As String, wf_Cancel As Boolean, wf_errmsg As String
  Dim wo_rsSrcOd As MDORowSet, DmHldExclChkStr As String
  If IsMissing(pi_IdSrFr) Then pi_IdSrFr = 0
  If IsMissing(pi_IdSrTo) Then pi_IdSrTo = 0
  If pi_IdSrTo = 0 Then pi_IdSrTo = pi_IdSrFr
  
  mb_CpyCol = True
    
'  mb_CpyFrmHist = IIF(pi_IdSrFr = 0, False, True)
'  mb_CpyFrmHist = False
  
  '****** [Check 1 - General Checks] ******
  If ADC("OMLOCKYN") = "Y" Then DispMsg "Cannot Copy As Current Order is Locked", etError: Exit Sub
  If ADC("OMLOCKSALPRCYN") = "Y" Then DispMsg "Cannot Copy As Current Order Sales Price is Locked.", etError: Exit Sub
  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    DispMsg "Rates can not be Refreshed, Invoice Is Closed.", etError: Exit Sub
  
  '****** [Check 2 - Source and Target Currencies Not Matching] ******
'  If Not moCn.RecSeek("Select 'x' from InvHd where InCoCd= '" + ps_CoCd + "' and " + _
'            "InTc= '" + ps_IdTc + "' and InYy= '" + ps_IdYy + "' and InChr= '" + ps_IdChr + "' and " + _
'            "InNo= " + CStr(pi_IdNo) + " and (Select CmCurCd From CustMst Where CmCtg='C' And CmCd=InCmCd)= '" + adc("OmCmCurCd") + "' /* And InPrtKey='" + ctCurrPrtn + "' */ ") Then _
'    DispMsg "Invalid Voucher No. / Source And Target Currencies Are Not Matching", etError: Exit Sub
    
    If Not moCn.RecSeek("Select 'x' from InvHd where InCoCd= '" + ps_cocd + "' and " + _
            "InTc= '" + ps_IdTc + "' and InYy= '" + ps_IdYy + "' and InChr= '" + ps_IdChr + "' and " + _
            "InNo= " + CStr(pi_IdNo) + " and (Select CmCurCd From CustMst Where CmCtg='C' And CmCd=InCmCd)= '" + ADC("OmCmCurCd") + "' /* And InPrtKey='" + ctCurrPrtn + "' */ ") _
        And (ADC("wCpyRt") = "Y" Or ADC("wCpyLabRt") = "Y") Then
        DispMsg "Copy Rate Options Cannot Be 'Y' When Source And Target Currencies Are Not Matching", etError: Exit Sub
    End If
    
  
  '****** [Check 3 - Source Record Does Not Exist] ******
  If Not moCn.RecSeek("Select 'x' from InvDsg where " + _
                  "IdCoCd= '" + ps_cocd + "' and IdTc= '" + ps_IdTc + "' and " + _
                  "IdYy= '" + ps_IdYy + "' and IdChr= '" + ps_IdChr + "' and " + _
                  "IdNo= " + CStr(pi_IdNo) + " and IdSr>=" + IIF(pi_IdSrFr = 0, "IdSr", CStr(pi_IdSrFr)) + _
                  " and IdSr<=" + IIF(pi_IdSrTo = 0, "IdSr", CStr(pi_IdSrTo)) + _
                  " /* And IdPrtKey='" + ctCurrPrtn + "' */ ") Then _
   DispMsg "Cannot Copy As Invoice details do not Exist", etError: Exit Sub
  
  '****** [Check 4 - Source Record Design Not In Current Partition] ******
  If Not moCn.RecSeek("Select 'x' from InvDsg Join DsgMst On DmTcTyp='" + ms_DmTcTyp + "' And DmCd=IdDmCd And DmPrtKey='" + ctCurrPrtn + "' Where " + _
                  "IdCoCd= '" + ps_cocd + "' and IdTc= '" + ps_IdTc + "' and " + _
                  "IdYy= '" + ps_IdYy + "' and IdChr= '" + ps_IdChr + "' and " + _
                  "IdNo= " + CStr(pi_IdNo) + " and IdSr>=" + IIF(pi_IdSrFr = 0, "IdSr", CStr(pi_IdSrFr)) + _
                  " and IdSr<=" + IIF(pi_IdSrTo = 0, "IdSr", CStr(pi_IdSrTo)) + _
                  " /* And IdPrtKey='" + ctCurrPrtn + "' */ ") Then _
   DispMsg "Cannot Copy As Some of the Designs in Copy Scope are not in Current Partition/Push Designs First to Copy", etError: Exit Sub
  
 '****** [Check 5 - Source Record Rm Code In Current Partition] ******
  If Not moCn.RecSeek("Select 'x' from InvRm Join RmMst On RmCd=IrRmCd And RmPrtKey='" + ctCurrPrtn + "' Where " + _
                  "IrCoCd= '" + ps_cocd + "' and IrTc= '" + ps_IdTc + "' and " + _
                  "IrYy= '" + ps_IdYy + "' and IrChr= '" + ps_IdChr + "' and " + _
                  "IrNo= " + CStr(pi_IdNo) + " and IrSr>=" + IIF(pi_IdSrFr = 0, "IrSr", CStr(pi_IdSrFr)) + _
                  " and IrSr<=" + IIF(pi_IdSrTo = 0, "IrSr", CStr(pi_IdSrTo))) Then _
   DispMsg "Cannot Copy As Some of the Raw Materials in Copy Scope are not in Current Partition/Push Raw Materials First to Copy", etError: Exit Sub
   
  '****** [Check 4 - CRM Checks] ******
  If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
    DispMsg "Order/Quotation is Unacknowledged,Acknowledge to Edit Value", etError: Exit Sub
  ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
    DispMsg "Order/Quotation is Submitted,Can not Edit.", etError: Exit Sub
  End If
  
  ' ***** Manali 3.8.0 - Trading Module - Copy From IN in JPR
  'If ms_OmTcTyp = ctJtTcTyp And mBaseTc <> "" Then
  If ms_OmTcTyp = ctJtTcTyp And mBaseTc = ADC("wOmTc") Then
    If UCase(ADC("OmCmCd")) <> UCase(ADC("wCustFr")) Then _
      DispMsg "Cannot Copy As Source Voucher Should Be Of The Same " + mCmCtgName + " As In The Current Voucher", etError: Exit Sub
  End If
  
  If ms_OmTcTyp = ctJtTcTyp Then
    If ADC("wCpyDmId") = "" Then DispMsg "Specify Copy DmId Option (Y/N)", etError: Exit Sub
  End If
'  sv.71 deleting old error message once copy started
 moCn.Execute ("Delete from OrdCpyErr where OceCoCd= '" + ms_OmCoCd + "' and OceTc= '" + ADC("OmTc") + "' and OceYy= '" + ADC("OmYy") + "' and " + _
                 "OceChr= '" + ADC("OmChr") + "' and OceNo= " + CStr(ADC("OmNo")) + " and OcePrtKey = '" + ctCurrPrtn + "'")
  mi_ErrSr = 0
      
  
  
  ' **** Manali 3.8.0 - Allow Copy Rates for RmCtg Other Than in Target Grid
  Dim wRsTgt As MDORowSet, wRmCtgStr As String
  If ADC("wCpyRtOpt") <> "" Then
  Set wRsTgt = moCn.OpenRes(" Select Distinct OtRmCtg as OtRmCtg from OrdTgt " + _
                      " Where OtCoCd ='" + ms_OmCoCd + "'" + _
                      " And OtTc ='" + ADC("OmTc") + "'" + _
                      " And OtYy = '" + ADC("OmYy") + "'" + _
                      " And OtChr ='" + ADC("OmChr") + "' " + _
                      " And OtNo =" + CStr(ADC("OmNo")) + _
                      " And OtSr = 0  " + _
                      " And OtPrtKey = '" + ctCurrPrtn + "' ")
                          
  ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wCpyRtOpt") + "' ")
  
  Do While Not (wRsTgt.EOF Or wRsTgt.BOF)
    If InStr(1, "," + ms_CpyRateOpt + ",", "," + wRsTgt!otrmctg + ",") >= 1 Then
      wRmCtgStr = wRmCtgStr + IIF(wRmCtgStr = "", "", ",") + wRsTgt!otrmctg
    End If
    wRsTgt.MoveNext
  Loop
  If wRmCtgStr <> "" Then DispMsg "Cannot Copy Rates for RmCtg '" + wRmCtgStr + "' as Record Exists in Target Grid For The Same", etError: Exit Sub
  End If
   ' **** Manali 3.8.0 - Allow Copy Rates for RmCtg Other Than in Target Grid
  
'  wf_Cancel = False
'  Call atxt_FldChange(99, "OmCmCd", wf_Cancel, wf_errmsg, ADC("OmCmCd"))
'  If wf_Cancel = True Then
'      DispMsg wf_errmsg, etError
