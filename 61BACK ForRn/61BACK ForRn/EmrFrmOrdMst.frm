      'MWLib.RunningProcess "Copy In Progress...Row: " + CStr(ijk)
      TrackStatus ("Started Voucher of Row:" + CStr(ijk) + ":" + CStr(Now))
      If ADC.Mode = xCopy Then
        .AddItem
        wi_OdRow = .Rows - 1
        .Value(wi_OdRow, "OdSr") = .Value(wi_OdRow, "OdSr")
        .Value(wi_OdRow, "OdJLRmCd") = pv_rsSrcOd!OdJLRmCd
        .Value(wi_OdRow, "OdJLLn1") = pv_rsSrcOd!OdJLLn1
