                                  "OmNo=" + CStr(pv_rsSrcOd!OdNo))
              
      End If
      'apply business rule to when to copy OdMrpDisc and OdMrp (if both are MRP CHRs and same customer and target is JSA and source is JSO)
      If mf_MrpChr And wf_SrcMRPChr And ws_SrcCmCtg = ADC("OmCmCtg") And ws_SrcCmCd = ADC("OmCmCd") And ADC("OmTc") = "JSA" And pv_rsSrcOd!OdTc = "JSO" Then
