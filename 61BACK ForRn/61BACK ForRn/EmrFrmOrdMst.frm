 ' IIF(ADC("wDsCpyTc") = "JSO" Or ADC("wDsCpyTc") = "JPO" Or ADC("wDsCpyTc") = "IN", "", " and OdDmStkCoCd = DDmStkCoCd and OdDmStkYy = DDmStkYy and OdDmStkChr = OdDmStkChr and DDmStkNo = OdDmStkNo")
  
