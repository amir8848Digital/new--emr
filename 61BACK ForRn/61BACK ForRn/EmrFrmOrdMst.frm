Private Sub CmdOrdCpyGo_Click()
  If ADC("WORDCPYGRP") = "-" And (GrdOrdTgt.ColProp("OTCOL").Style = fgcNormal Or GrdOrdTgt.ColProp("OTRMRSZ").Style = fgcNormal) Then
  DispMsg "Mismatch in Grid View and Group by selection ", etError: Exit Sub
  End If
  
  If ADC("WORDCPYGRP") = "RMCOL" And (GrdOrdTgt.ColProp("OTCOL").Style = fgcinvisible Or GrdOrdTgt.ColProp("OTRMRSZ").Style = fgcNormal) Then
  DispMsg "Mismatch in Grid View and Group by selection ", etError: Exit Sub
  End If
  If ADC("WORDCPYGRP") = "RMCOL-SZ" And (GrdOrdTgt.ColProp("OTCOL").Style = fgcinvisible Or GrdOrdTgt.ColProp("OTRMRSZ").Style = fgcinvisible) Then
  DispMsg "Mismatch in Grid View and Group by selection ", etError: Exit Sub
  End If
  If ADC("WORDCPYGRP") = "RMRNGSZ" And (GrdOrdTgt.ColProp("OTCOL").Style = fgcNormal Or GrdOrdTgt.ColProp("OTRMRSZ").Style = fgcinvisible) Then
  DispMsg "Mismatch in Grid View and Group by selection ", etError: Exit Sub
  End If
  If ADC("WORDCPYGRP") = "RMRT" Then
  DispMsg "RmRt option is not a valid Group By filter for Copying details", etError: Exit Sub
  End If
  If ADC("WORDCPYGRP") = "RMCDRT" Then
  DispMsg "RmCdRt option is not a valid Group By filter for Copying details", etError: Exit Sub
  End If
  
  moCn.Execute ("Delete from OrdTgt where OtCoCd= '" + ms_OmCoCd + "' and OtTc= '" + ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and " + _
                   "OtChr= '" + ADC("OmChr") + "' and OtNo= " + CStr(ADC("OmNo")) + " and OtRmCd= '' " + _
                    " And OtPrtKey = '" + ctCurrPrtn + "'")


  TrackStatus ("Started")
  '6.1b-22 Rfid is replaced with Bag Alias No.
  If ADC("WCPYFRMEXCEL") <> "" And ADC("wCpyFrmOrdRfId") <> "" Then _
    DispMsg "Both Copy From Ord/Excel and Copy From Ord/Bag Alias No. Options Cannot Be Set at a time", etError: Exit Sub
  '6.1b-22 Rfid is replaced with Bag Alias No.
  If ADC("WCPYFRMEXCEL") = "" And ADC("wCpyFrmOrdRfId") = "" Then _
    DispMsg "Both Copy From Ord/Excel and Copy From Ord/Bag Alias No. Options Cannot Be Blank at a time", etError: Exit Sub
  '6.1b-22 Rfid is replaced with Bag Alias No.
  If ADC("wCpyFrmOrdRfId") = "N" And (ADC("wCpyRt") = "Y" Or ADC("wCpyRt") = "Y") Then _
    DispMsg "Rate Copy Option Cannot Be Set To 'Y' When Copy From Ord/Bag Alias No. Value Set to 'N'", etError: Exit Sub
    moCn.Execute ("Delete from OrdCpyErr where OceCoCd= '" + ms_OmCoCd + "' and OceTc= '" + ADC("OmTc") + "' and OceYy= '" + ADC("OmYy") + "' and " + _
                   "OceChr= '" + ADC("OmChr") + "' and OceNo= " + CStr(ADC("OmNo")) + " and OcePrtKey = '" + ctCurrPrtn + "'")
  mi_ErrSr = 0

  If (ADC("wCpyRt") = "Y" Or ADC("WCOSTFRPDCMYN") = "Y") And ADC("wCpyRtOpt") = "" Then DispMsg "Copy Rate Option Is Compulsory", etError: Exit Sub
  If (UCase$(ms_OmTcTyp) = "QT" Or UCase$(ms_OmTcTyp) = ctJtTcTyp Or UCase$(ms_OmTcTyp) = "SO") And ADC("wOmTc") = "IN" Then
      Call CopyInv(ADC("woCoCd"), ADC("wOmTc"), ADC("wOmYy"), ADC("wOmChr"), CStr(ADC("wOmNo")), ADC("wFrOdSr"), ADC("wToOdSr"))
      Call CmdOrdCpy_Click
      Exit Sub
  End If
  mf_CstRatePDCM = IIF(ADC("WCOSTFRPDCMYN") = "Y", True, False)
  Dim wOdSrCnd As String
 If ADC("wOmTc") <> "IN" Then
  wOdSrCnd = IIF(ADC("wFrOdSr") = 0, "", " And OdSr>= " + CStr(ADC("wFrOdSr")))
  wOdSrCnd = wOdSrCnd + IIF(ADC("wToOdSr") = 0, "", " And OdSr<= " + CStr(ADC("wToOdSr")))
 Else
  wOdSrCnd = IIF(ADC("wFrOdSr") = 0, "", " And IdSr>= " + CStr(ADC("wFrOdSr")))
  wOdSrCnd = wOdSrCnd + IIF(ADC("wToOdSr") = 0, "", " And IdSr<= " + CStr(ADC("wToOdSr")))
 End If
  Dim wRsTgt As MDORowSet, wRmCtgStr As String
    ' **** Manali 3.8.0 - Allow Copy Rates for RmCtg Other Than in Target Grid
    If ADC("wCpyRtOpt") <> "" Then
    Set wRsTgt = moCn.OpenRes(" Select Distinct OtRmCtg as OtRmCtg from OrdTgt " + _
                        " Where OtCoCd ='" + ms_OmCoCd + "'" + _
                        " And OtTc ='" + ADC("OmTc") + "'" + _
                        " And OtYy = '" + ADC("OmYy") + "'" + _
                        " And OtChr ='" + ADC("OmChr") + "' " + _
                        " And OtNo =" + CStr(ADC("OmNo")) + _
                        " And OtSr = 0  " + _
                        " And OtPrtKey = '" + ctCurrPrtn + "' ")
                            
    ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                    "PMCd= '" + ADC("wCpyRtOpt") + "' ")
    
    Do While Not (wRsTgt.EOF Or wRsTgt.BOF)
      If InStr(1, "," + ms_CpyRateOpt + ",", "," + wRsTgt!otrmctg + ",") >= 1 Then
        wRmCtgStr = wRmCtgStr + IIF(wRmCtgStr = "", "", ",") + wRsTgt!otrmctg
      End If
      wRsTgt.MoveNext
    Loop
    If wRmCtgStr <> "" Then DispMsg "Cannot Copy Rates for RmCtg '" + wRmCtgStr + "' as Record Exists in Target Grid For The Same", etError: Exit Sub
    End If
   If ADC("WCPYFRMEXCEL") = "N" Or ADC("wCpyFrmOrdRfId") = "Y" Then   '****** Sachin 3.3.0 (25-06-08) - [12. Copy From Excel] ******
    Dim OrdExist As Boolean
    Dim wCurrDsgExists As Boolean
    Dim ws_Cnd As String
    If Not moCn.RecSeek("Select 'x' from OrdMst where OmCoCd= '" + ADC("woCoCd") + "' and " + _
                "OmTc= '" + ADC("wOmTc") + "' and OmYy= '" + ADC("wOmYy") + "' and OmChr= '" + ADC("wOmChr") + "' and " + _
                "OmNo= " + CStr(ADC("wOmNo")) + " and OmCmCurCd= '" + ADC("OmCmCurCd") + "' And OmPrtKey='" + ctCurrPrtn + "' ") _
        And (ADC("wCpyRt") = "Y" Or ADC("wCpyLabRt") = "Y") Then
        DispMsg "Copy Rate Options Cannot Be 'Y' When Source And Target Currencies Are Not Matching", etError: Exit Sub
    End If
      
     OrdExist = moCn.RecSeek("Select 'x' from OrdDsg where " + _
                    "OdCoCd= '" + ADC("WOCoCd") + "' and OdTc= '" + ADC("wOmTc") + "' and " + _
                    "OdYy= '" + ADC("wOmYy") + "' and OdChr= '" + ADC("wOmChr") + "' and " + _
                    "OdNo= " + CStr(ADC("wOmNo")) + wOdSrCnd + "  And OdPrtKey='" + ctCurrPrtn + "'  ")
    If OrdExist = False Then DispMsg "Cannot Copy As Order details does not Exist", etError: Exit Sub
    If ADC("OMLOCKYN") = "Y" Then DispMsg "Cannot Copy As Current Order is Locked", etError: Exit Sub
    If ADC("OMLOCKSALPRCYN") = "Y" Then DispMsg "Cannot Copy As Current Order Sales Price is Locked.", etError: Exit Sub
    If ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then DispMsg "Cannot Edit, Invoice Is Closed.", etError: Exit Sub
      If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
        DispMsg "Order/Quotation is Unacknowledged,Acknowledge to Edit Value", etError: Exit Sub
      ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
        DispMsg "Order/Quotation is Submitted,Can not Edit.", etError: Exit Sub
      End If
    If ADC("woCoCd") = ctSelfCoCd And ms_OmTcTyp <> "PL" And UCase(ADC("OmCmCd")) <> UCase(ADC("wCustFr")) Then
      DispMsg "Cannot Copy As PDC Should Be Of The Same Customer As In The Order", etError: Exit Sub
    End If
    If ms_OmTcTyp = ctJtTcTyp And mBaseTc <> "" And moCn.GetFldVal("Select TmBaseMustYN from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'") = "Y" Then
      If UCase(ADC("OmCmCd")) <> UCase(ADC("wCustFr")) Then _
        DispMsg "Cannot Copy As Source Voucher Should Be Of The Same " + mCmCtgName + " As In The Current Voucher", etError: Exit Sub
    End If
    
    If ms_OmTcTyp = ctJtTcTyp Then
      If ADC("wCpyDmId") = "" Then DispMsg "Specify Copy DmId Option (Y/N)", etError: Exit Sub
    End If
    
    wCurrDsgExists = False
    If moCn.RecSeek("Select 'x' from OrdDsg where " + _
                      "OdCoCd= '" + ms_OmCoCd + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                      "OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and " + _
                      "OdNo= " + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "'") Then wCurrDsgExists = True
    Dim wf_Cancel As Boolean, wf_errmsg As String, wo_rsSrcOM As MDORowSet, wo_rsSrcOd As MDORowSet
    Dim wo_RsDsgSrNotCopied As MDORowSet, ws_DsgSrNotCopied As String
    
    wf_Cancel = False
    Call ATXT_FldChange(99, "OmCmCd", wf_Cancel, wf_errmsg, ADC("OmCmCd"))
    If wf_Cancel = True Then
        DispMsg wf_errmsg, etError
        Exit Sub
    End If
    Set wo_rsSrcOM = moCn.OpenRes("Select * from OrdMst where " + _
                 "OmCoCd='" + ADC("WOCocd") + "' and OmTc='" + ADC("wOmTc") + "' and " + _
                 "OmYy='" + ADC("wOmYy") + "' and OmChr='" + ADC("wOmChr") + "' and " + _
                 "OmNo=" + CStr(ADC("wOmNo")) + " And OmPrtKey='" + ctCurrPrtn + "' ")
    If wo_rsSrcOM.RecCount <> 1 Then
        DispMsg "This Voucher Does Not Exist", etError
