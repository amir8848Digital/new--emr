              wrs_ShowDsgStk!QSRCVCH = wFldValues(3, 1)
              wrs_ShowDsgStk!qStkQty = wFldValues(4, 1)
              wrs_ShowDsgStk!qSrcVchBalQty = wFldValues(5, 1)
              wrs_ShowDsgStk!qTargetVchQty = wFldValues(6, 1)
              wrs_ShowDsgStk!qTargetVchOdSalPrc = wFldValues(7, 1)
              wrs_ShowDsgStk!qOdDmCd = wFldValues(8, 1)
              wrs_ShowDsgStk!qOdDmSz = wFldValues(9, 1)
              wrs_ShowDsgStk!qOdSfx = wFldValues(10, 1)
              wrs_ShowDsgStk!qOdDmStkCoCd = wFldValues(11, 1)
              wrs_ShowDsgStk!qOdDmStkYy = wFldValues(12, 1)
              wrs_ShowDsgStk!qOdDmStkChr = wFldValues(13, 1)
              wrs_ShowDsgStk!qOdDmStkNo = wFldValues(14, 1)
              wrs_ShowDsgStk!qSrcBaseOdIdNo = wFldValues(15, 1)
              wrs_ShowDsgStk!qOdOmDt = wFldValues(16, 1)
              wrs_ShowDsgStk!qCpyFrVch = wFldValues(17, 1)
              wrs_ShowDsgStk!qOdPoNo = wFldValues(18, 1)
              wrs_ShowDsgStk!qOdSubCust = wFldValues(19, 1)
              wrs_ShowDsgStk!qGrsWt = wFldValues(20, 1)
