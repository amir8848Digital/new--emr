Private Sub GrdOrdCT_ColChange(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  Select Case UCase(ColName)
    '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctCd"), UCase("OctSz")
      If mf_CTMod = True And GrdOrdCT.Mode = fgmnorm Then
        Dim wRsOrdCT As MwfLib.MDORowSet
        Dim ws_Cnd As String
        If UCase(ColName) = UCase("OctCd") Then
            ws_Cnd = "and DmCd= '" + NewValue + "' and DmSz= '" + GrdOrdCT.Value(RowNum, "OctSz") + "'"
        ElseIf UCase(ColName) = UCase("OctSz") Then
            ws_Cnd = "and DmCd = '" + GrdOrdCT.Value(RowNum, "OctCd") + "' and DmSz = '" + NewValue + "'"
        End If
        '****** Sachin 3.02 18-12-07
        If GrdOrdCT.Value(RowNum, "OctPrtKey") = ctCurrPrtn And Not moCn.RecSeek("Select 'x' from Bag Where BCoCd = '" + ms_OmCoCd + "'" + _
                           " And BOdTc = '" + ADC("OmTc") + "'" + _
                           " And BOdYy = '" + ADC("OmYy") + "'" + _
                           " And BOdChr = '" + ADC("OmChr") + "' " + _
                           " And BOdNo = " + CStr(ADC("OmNo")) + _
                           " And BOdSr = " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + _
                           " And BChr = '" + GrdOrdCT.Value(RowNum, "OctCtChr") + "' And BPrtKey='" + ctCurrPrtn + "' ") Then
           '*** Jay 2.14Next *** [MainMet Chk Added]
           
           '****** Sachin 3.02 (10/09/07) - added id fields in joins
           ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
           Set wRsOrdCT = moCn.OpenRes("Select DrRmCd as qDctRmCd, DmCol as qDctDmCol, DrPrdWt as qDctRmWt, " + _
                        "(Select (case when sum(case when DrRmCtg= 'D' then 1 else 0 end)> 0 then 'D' else '' end)+  " + _
                        "(case when sum(case when DrRmCtg= 'C' then 1 else 0 end)> 0 then 'C' else '' end) " + _
                        "From DsgRm " + _
                        "where DrPrtKey=DmPrtKey and Drtctyp = DmTcTyp and DrCd = DmCd and DrSz = DmSz and DrRmCtg in ('C','D') " + _
                        ") as qDctDc, " + _
                        "DmPrdSeq As qDctPrdSeq, '' as qDctDesc, 'N' as qDctMainPrtYn " + _
                        "From DsgMst " + _
                        "Right outer join DsgRm on /* DmIdNo=DrDmIdNo And */ DrTcTyp = DmTcTyp and DrCd = DmCd and DrSz = DmSz " + _
                        IIF(gs_Partition = ctCurrPrtn, " and DmPrtKey='" + ctCurrPrtn + "'", "") + _
                        "and " + _
                        "DrRmCtg in ('G','P','S','L')  and DrMainMet= 'Y' " + _
                        "where DmTcTyp= 'PM' " + ws_Cnd + " ")
           '*** Jay 2.14Next *** [MainMet Chk Added]
           With wRsOrdCT
              If Not (.EOF Or .BOF) Then
                  GrdOrdCT.Value(RowNum, "OctParts") = 1
                  GrdOrdCT.Value(RowNum, "OctRmCd") = !qDctRmCd
                  GrdOrdCT.Value(RowNum, "OctDmCol") = !qDctDmCol
                  GrdOrdCT.Value(RowNum, "OctRmWt") = !qDctRmWt
                  GrdOrdCT.Value(RowNum, "OctDc") = !qDctDc
                  GrdOrdCT.Value(RowNum, "OctPrdSeq") = !qDctPrdSeq
                  GrdOrdCT.Value(RowNum, "OctDesc") = !qDctDesc
                  GrdOrdCT.Value(RowNum, "OctMainPrtYn") = !qDctMainPrtYn
                Else
                  GrdOrdCT.Value(RowNum, "OctParts") = 1
                  GrdOrdCT.Value(RowNum, "OctRmCd") = ""
                  GrdOrdCT.Value(RowNum, "OctDmCol") = ""
                  GrdOrdCT.Value(RowNum, "OctRmWt") = ""
                  GrdOrdCT.Value(RowNum, "OctDc") = ""
                  GrdOrdCT.Value(RowNum, "OctPrdSeq") = ""
                  GrdOrdCT.Value(RowNum, "OctDesc") = ""
                  GrdOrdCT.Value(RowNum, "OctMainPrtYn") = ""
              End If
           End With
        Else
           Cancel = True: ErrMsg = "Cannot Change CompCd/ Sz, Component Bag Is Generated": Exit Sub
        End If
      End If
    '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctCtChr")
      Cancel = Not moCn.RecSeek("select PMCd from Param where " + _
                                " PTyp='BCHR' and PValue= 'C' and PMCd= '" + NewValue + "'")
      If Cancel = True Then ErrMsg = "Invalid Component Character": Exit Sub
    Case Is = UCase("OctParts")
      Cancel = NewValue <= 0
      ErrMsg = "Part Quantity Can not be <= Zero": Exit Sub
    Case Is = UCase("OctRmCd")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' " + _
                                                       "And RmCd = '" + NewValue + "' And RmPrtKey='" + ctCurrPrtn + "'"))
      ErrMsg = "Invalid Raw Material Code": Exit Sub
    Case Is = UCase("OctDmCol")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select PMCd From Param where PTyp= 'DMCOL' and " + _
                                                      "PMCd = '" + NewValue + "'"))
      If Cancel = True Then ErrMsg = "Invalid Design Colour": Exit Sub
    Case Is = UCase("OctRmWt")
      Cancel = NewValue < 0
      ErrMsg = "RmWeight Can Not Be Less Then 0": Exit Sub
    Case Is = UCase("OctDc")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("select PMCd from Param where " + _
                                " PTyp='CTDC' and PMCd= '" + NewValue + "'"))
      ErrMsg = "Invalid Component DC": Exit Sub
    Case Is = UCase("OctPrdSeq")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("select vPMCd from vParam where " + _
                           "vPTyp= 'PRDSEQ' and vPMCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Production Sequence": Exit Sub
    '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctMainPrtYn")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("select PMCd from Param where " + _
                                " PTyp='YN' and PMCd= '" + NewValue + "'"))
      ErrMsg = "Invalid Main Part Y/N Option": Exit Sub
    '*** Jay 2.13(CT) *** (New CT)
  End Select
End Sub
'*** Jay 2.13(CT) ***
Private Sub GrdOrdCT_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  '*** Set Helps For Each Field
  
  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If
  If mf_CTMod = False Then Cancel = True: ErrMsg = "Component Module Is Not Enabled": Exit Sub
  
  Select Case UCase(ColName)
  '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctCd")
      Call HlpList.DmCd("PM")
    Case Is = UCase("OctSz")
      Call HlpList.DmSz("PM", GrdOrdCT.Value(RowNum, "OctCd"))
    '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctCtChr")
      If GrdOrdCT.IsNew(RowNum) Then Call HlpList.PMCd("BCHR", "'C'")
    ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
    Case Is = UCase("OctRmCd")
      Call HlpList.RmCd("N", "'G','P','S','L'")
    Case Is = UCase("OctDmCol")
      Call HlpList.PMCd("DMCOL")
    Case Is = UCase("OctDC")
      Call HlpList.PMCd("CTDC")
    Case Is = UCase("OctPrdSeq")
      Call HlpList.vPMCd(ms_OmCoCd, "PRDSEQ")
    '*** Jay 2.13(CT) *** (New CT)
    Case Is = UCase("OctMainPrtYn")
        Call HlpList.PMCd("YN")
    '*** Jay 2.13(CT) *** (New CT)
  End Select
End Sub

