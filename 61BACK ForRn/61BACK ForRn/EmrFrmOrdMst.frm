                      wLabAsWt = GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(wi_L, "OlMCd"), .Value(wi_L, "OlSCd")))
                      .Value(wi_L, "OlSalRt") = GetLabRt(ADC("OmCmCd"), .Value(wi_L, "OlMCd"), _
                                      .Value(wi_L, "OlSCd"), "S", _
