        ' ***** Manali Trading Module
          .Value(wi_OdRow, "OdOrdEnt") = IIF(pv_CpyXl = False, pv_rsSrcOd!OdOrdEnt, mi_xlQty) '****** Sachin 3.3.0 (25-06-08) - [12. Import From Excel] ******
