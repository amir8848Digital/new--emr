Private Sub JTRmStkCpy()
  If moCn.RecSeek("Select 'x' from InvHd Where InCoCd='" + ms_OmCoCd + "' and InTc='" + ADC("OmTc") + "' " + _
                  " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' ") Then mInvExists = True

  
  If mf_DtLocked = True Then DispMsg "Cannot Copy In Locked Entry", etError: Exit Sub
  
  If ADC("OmPrtKey") <> ctCurrPrtn Or CDate(ms_PurgeDt) > ADC("OmDt") Then DispMsg "Cannot Copy In Previous Partition Orders/Orders Prior to Purge Date", etError: Exit Sub

  Dim wb_ValidCmCd As Boolean
  wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= '" + ADC("OmCmCtg") + "' and " + _
                          "CmCd = '" + ADC("OmCmCd") + "'")
   
  If wb_ValidCmCd = False Then DispMsg "Invalid " + mCmCtgName + "  code", etError: Exit Sub
  
  If mf_DtLocked = True Then Exit Sub
  
  If RetMemExists = True Then Exit Sub
  
  If ADC("OmCnvFct") = "0" Then DispMsg "Conversion Factor Should Be > 0", etError: Exit Sub
  If ADC("OmMulDiv") = "" Then DispMsg "Conversion Factor From Base Currency To Voucher Currency Not Defined In Date Table", etError: Exit Sub
  
  
  If ms_OmTcTyp = ctJtTcTyp Then
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
      DispMsg "Invalid From RM Location", etError: Exit Sub
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
      DispMsg "Invalid To RM Location", etError: Exit Sub
    If ms_OmTc = "LIN" Then
        If ADC("OmBaseCoCd") = "" Then DispMsg "Base Company Code Cannot be Blank.", etError: Exit Sub
           ADC("wRmCpyCoCd") = ADC("OmBaseCoCd"): ADC("wRmCpyCoCd").Enabled = False
    End If
  End If

  ' **** Manali Trading Module
  If ms_OmTcTyp = ctJtTcTyp Then
      Dim wf_invhdmust As Boolean
    wf_invhdmust = moCn.RecSeek("Select 'x' from TcMst where TmTc = '" + ADC("omTc") + "' and TmCoCd = '" + ms_OmCoCd + "' and TmInvHdMustYn = 'Y'")

    If Not mInvExists And wf_invhdmust And CmdInvHd.Visible Then DispMsg "Invoice Header Not Created", etError: Exit Sub
  End If
  
  
  
  Call DispFra(LRmStkCpy)

  If FraLRmStkCpy.Visible = True Then
    ' ***** Manali 3.7.1 - Copy From Voucher
    If ADC("wRmCpyFrYn") = "" Then ADC("wRmCpyFrYn") = "Y"
    If ADC("wRmDtFr") = "" Then ADC("wRmDtFr") = moCn.GetFldVal("Select DateAdd(mm,-1,Getdate())")  '"01/01/80"
    If ADC("wRmDtTo") = "" Then ADC("wRmDtTo") = moCn.SrvrDate '"01/01/80"
    If ADC("wRmCpyCoCd") = "" Then ADC("wRmCpyCoCd") = ms_OmCoCd
    If ADC("wRmCmCtg") = "" Then ADC("wRmCmCtg") = moCn.GetFldVal("Select TmSrcCmCtg From TcMst where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "'")
    If ADC("wRmCmCd") = "" And ADC("wRmCmCtg") = ADC("OmCmCtg") Then ADC("wRmCmCd") = ADC("OmCmCd")
    
    If ADC("wRmSLocFr") = "" And ADC("wRmSLocTo") = "" Then ADC("wRmSLocFr") = ADC("OmFrDmLoc"): ADC("wRmSLocTo") = ADC("OmFrDmLoc")
    
    If mBaseTc <> "" And ADC("wRmCpyTc") = "" Then ADC("wRmCpyTc") = mBaseTc
    If mRefTc <> "" And ADC("wRmCpyTc") = "" Then ADC("wRmCpyTc") = IIF(InStr(1, mRefTc + ",", ",", vbTextCompare) > 0, Mid(mRefTc, 1, InStr(1, mRefTc + ",", ",", vbTextCompare) - 1), mRefTc)
    If ADC("wRmCpyTc") = "" And mSrcTc <> "" Then ADC("wRmCpyTc") = IIF(InStr(1, mSrcTc + ",", ",", vbTextCompare) > 0, Mid(mSrcTc, 1, InStr(1, mSrcTc + ",", ",", vbTextCompare) - 1), mSrcTc)
    'ADC("WDSCPYDMID") = "Y"
    'If ms_OmTc = "JPO" Or ms_OmTc = "JSO" Then ADC("wDsCpyDmId") = "N"
    
    
    If moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "' and TmBaseMustYn='Y' ") Then
      ADC("wRmCpyFrYn").Enabled = False
    End If
     ' ***** Manali 3.7.1 - Copy From Voucher
  ' ***** Bef 3.7.1
  '    adc("wDsDmCdFr").CmpStr = "DDmCd >=": adc("wDsDmCdTo").CmpStr = "DDmCd <="
  '    adc("wDsOdSfxFr").CmpStr = "DOdSfx >=": adc("wDsOdSfxTo").CmpStr = "DOdSfx <="
  '    adc("wDsDmSzFr").CmpStr = "DDmSz >=": adc("wDsDmSzTo").CmpStr = "DDmSz <="
  '    adc("wDsDmIdFr").CmpStr = "DDmId >=": adc("wDsDmIdTo").CmpStr = "DDmId <="
  '    adc("wDsSLocFr").CmpStr = "DLoc >=": adc("wDsSLocTo").CmpStr = "DLoc <="
  Else
    ADC("wRmCdFr").CmpStr = "": ADC("wRmCdTo").CmpStr = ""
    ADC("wRmLn1Fr").CmpStr = "": ADC("wRmLn1To").CmpStr = ""
    ADC("wRmLn2Fr").CmpStr = "": ADC("wRmLn2To").CmpStr = ""
    ADC("wRmLn3Fr").CmpStr = "": ADC("wRmLn3To").CmpStr = ""
    ADC("wRmLotNoFr").CmpStr = "": ADC("wRmLotNoTo").CmpStr = ""
    ADC("wRmSLocFr").CmpStr = "": ADC("wRmSLocTo").CmpStr = ""
    ADC("wRmDtFr").CmpStr = "": ADC("wRmDtTo").CmpStr = ""
    ADC("wRmCpyTc").CmpStr = ""
    ADC("wRmCPYCOCD").CmpStr = "": ADC("wRmCMCTG").CmpStr = "": ADC("wRmCMCd").CmpStr = ""
  End If

End Sub
