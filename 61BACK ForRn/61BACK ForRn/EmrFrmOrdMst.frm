                    Call SetCellVal(ADC("WXLSHTNO"), wo_rsExcel!qRow, 30, "Unexpected Error during Copy, unable to save row to the database")
                    Call SetCellVal(ADC("WXLSHTNO"), wo_rsExcel!qRow, 31, "Unexpected Error during Copy, unable to save row to the database")
                    'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
                    Call SetCellVal(ADC("WXLSHTNO"), wo_rsExcel!qRow, 32, ms_OmCoCd + "/" + ms_OmTc + "/" + ms_OmYy + "/" + ms_OmChr + "/" + CStr(ADC("OmNo")))
                    wb_ErrorDuringCopy = True

                  End If
              ADC.EndCopy
              wo_rsExcel.MoveNext
      Loop
        GrdOrdDsg.EndServerCopy
              ADC.EndCopy

        If wb_ErrorDuringCopy Then
          MsgBox "Unexpected error during Copy"
        End If
        If wo_rsExcel.RecCount < (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then DispMsg "Copy completed with Error(s).Check Excel for Errors.", etInfo
  '      If (wb_ErrorDuringCopy) Then MsgBox "Some unexpected error during Copy, Check Excel for Errors"
        'If (Not wb_ErrorDuringCopy) And wo_rsExcel.RecCount = (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then MsgBox "Copy completed Successfully.", etInfo
        If wo_rsExcel.RecCount = (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then MsgBox "Copy completed Successfully.", etInfo

        CloseExcel
      '  ADC.EndCopy
        MWLib.EndProcess Me
        EndEmrProcess Me
        mf_CopyModeStartedByParent = False

    End If
  ElseIf ADC("wCpyFrmOrdRfId") = "N" Then
  
    Dim wRs_RfId As MDORowSet
    ms_ErrMsg = "": ms_RfIdStr = ""
    ReadRfId
    ''CmdOrdRfIdRead.Enabled = True         ' ***** Manali 3.10.0 - 20/04/12 - Instead of Read RfId Button, Text box given Where RfId Dtring can be kept to initiate copy
    If ms_ErrMsg <> "" Then Call CmdOrdCpy_Click: Exit Sub
    'ms_RfIdStr = "1,2,6"

    Set wRs_RfId = moCn.OpenRes("Select * from RfIdMst Where RimNo In (" + ms_RfIdStr + ") ")
    wRs_RfId.MoveFirst
    
    If wRs_RfId.RecCount > 0 Then
      Do While Not wRs_RfId.EOF
        'sv.71 old design exclusive check not necessary and removed
        'IIF(ms_OmTcTyp = "JT" Or ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                           "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmCmGrp= 'Y' and " + _
                           "(Select CmGrp from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) = '" + ms_CmGrp + "' ) or " + _
                           " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                           " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ")
        Set wo_rsSrcOd = moCn.OpenRes("Select DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                           "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, 1 as OdPrdEnt, 0 as OdOmIdNo, " + _
                           "DmPrdInst as OdDmPrdInst, '' as OdSzInst, DmVaCtg as OdVaCtg, '" + ADC("OmCell") + "' as OdCell, " + _
                           "DmKt as OdKt,DmBagPcs as OdBagPcs, '' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm,'' as OdTc,'' as OdYy,'' as OdChr, 0 as OdNo, 0 as OdSr " + _
                           " from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                           " and DmCd='" + wRs_RfId!RimDmCd + "' and " + _
                           " DmHld = 'N' " + _
                           "and DmSz = '' and DmPrtKey= '" + ctCurrPrtn + "' ")

        If wo_rsSrcOd.RecCount > 0 Then
          mf_CpyRate = False: mf_CpyLabRate = False
          ms_CpyRateCd = "": ms_CpyRateOpt = "": mf_CpyFrSameCust = False
          mf_CpyVal = False: wf_CpyFrDsgMst = True
          mb_CpyKT = False
        Else
          DispMsg "This Dsg Does Not Exist In Design Mst/Dsg On Hold/Exclusive For Other Customer", etError: Exit Sub
        End If
        ADC.StartCopy
        BeginEmrProcess Me, "Order Copy"   '578.40
        'GrdOrdDsg.StartServerCopy (True)   '578.40 records copy twice so commented
        If Not ADC.SaveRec Then
          DispMsg "OrdMst Save Failed", etError
          EndEmrProcess Me  '578.40 added
          ADC.EndCopy
          Exit Sub
        End If
        Call CpyDetsWithGrd(wo_rsSrcOd, True, True)
        'GrdOrdDsg.EndServerCopy    '578.40 records copy twice so commented
        EndEmrProcess Me  '578.40
        '4.1.3.0
        ADC.EndCopy
        wRs_RfId.MoveNext
      Loop
    End If
'umaaa
  End If
  Call ShowMsgBoxForErr     '578.40 show msgbox if any error captured
'umaaa
  'If chkLoadOrdCpyRows.Value = 1 Then
'    CpyDetsLoadData
  'End If
  Call CmdOrdCpy_Click
  Exit Sub
ErrHdlr:
  If Err.Number = 429 Then
    DispMsg "MS Excel is either Corrupt Or Missing on this PC. Please Install/Re-Install MS Excel ! ", etError
  ElseIf Err.Number = 70 Then       '4.1.4
    DispMsg "Cannot Access Template File. Close If Already Open and Continue.", etError
  Else
    DispMsg Err.Description, etError
  End If
  If ADC("WCPYFRMEXCEL") = "Y" Then CloseExcel
  mf_CopyModeStartedByParent = False
  '****** Sachin 3.3.0 - (25-06-08) - [12. Import From Excel] ******
End Sub

