    Dim wCndForSrcVchr As String, wCndForStk As String, wCndForSrcVchrInv As String
    Dim wCpyFrStkOrVchr As String
    Dim wOrderBy As String
    
    If ADC("wDsCpyTc") = "IN" Then
      OptDsCpyFr(0).Value = False
      OptDsCpyFr(1).Value = True
    Else
      If ChkVchrFliter.Value <> vbChecked Then
        OptDsCpyFr(1).Value = True
        OptDsCpyFr(0).Value = False
      End If
      If ChkStkFilter.Value <> vbChecked Then
        OptDsCpyFr(1).Value = False
        OptDsCpyFr(0).Value = True
      End If
    End If
    If ChkVchrFliter.Value = vbChecked And ADC("WDSCPYTC") = "" Then
      MsgBox "Please enter a Tc to Apply Source Voucher Filter, or uncheck Apply Source Voucher Filter"
      Exit Sub
    End If
    
    If ChkStkFilter.Value = vbChecked And (ADC("WDSSLOCFR") = "" And ADC("WDSSLOCTO") = "") Then
       ADC("WDSSLOCTO") = "ZZZZZZZZ"
'      MsgBox "Please enter From Location, To Location to Apply Stock Filter, or uncheck Apply Stock Filter"
'      Exit Sub
    End If
    'sri added this cause say you have RFID string provided but removed Stock Filter checkbox then AutoMap doesnt make any sense
    'In fact Automap Yes doesnt make any sense unles I have 2 side Stock and Open Voucher; Only exception is on the side of IN, we pretend one side IN of Emr is stock
    'and JPO is the other side
    If (ChkVchrFliter.Value = vbUnchecked Or ChkStkFilter.Value = vbUnchecked) And ADC("wdsCpyTc") <> "IN" Then
        ADC("WDSCPYAUTOMAP") = "N"
    End If
    
'    If ADC("WDSCPYAUTOMAP") = "Y" And (ChkStkFilter.Value = vbUnchecked Or ChkVchrFliter.Value = vbUnchecked) Then
'Print MsgBox; "Please set AutoMap to N when either Stock filter or Voucher filter is applied."
 '   End If
    If ADC("WDSSRTBY") = "" Then
       ADC("WDSSRTBY") = "2"
    End If
    If ADC("WDSCPYAUTOMAP") = "Y" Then
      ADC("WDSCPYBASEVCH") = "Y"
'      MsgBox "Assign Base must be Yes if Automap is Yes"
 '     Exit Sub
    End If

    If ADC("wDsCpyTc") = "IN" And (ADC("WDSCPYAUTOMAP") = "N" And ADC("wDsCpyBaseVch") = "N") And (ADC("WDSENFORCECMCD") = "Y" Or ADC("WDSENFORCESUBPO") = "Y") Then
