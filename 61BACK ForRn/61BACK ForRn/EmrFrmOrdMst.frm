Private Sub CmdDsgCpy_Click()
  '*** Display or hide the Copy frame depending on the toggle state
  '*** The CausesValidation property of this command button is false. The purpose of this is
      'when the Design Copy option is selected, the grid GrdOrdDsg should not be fully
      'validated i.e. only the validation of the column on which the cursor was previously
      'standing should take place and the row itself should not be saved. When the user exits
      'out of this option, the cursor returns to the same row. The reason is some of the
      'key fields can be filled up only during copy. Hence the row should not be saved
      'before copy as it might generate a trigger error
      
  If mf_DtLocked = True Then Exit Sub
  If FraDsgCpy.Visible = False Then
  'CostRtPDCM-Getting Copy Cost rate from PDCM (Y/N) from ZZZ by default
  ADC("WDSGCOSTFRPDCMYN") = ADC("WCOSTFRPDCMYN")
  If GrdOrdDsg.Row <= 0 Then Exit Sub
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If (GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn) Or (ADC("OmTc") <> "PL" And CDate(ms_PurgeDt) > ADC("OmDt")) Then DispMsg "Cannot Copy Designs In Orders Prior to Purge Date", etError: Exit Sub
      If GrdOrdDsg.HalfValidate Then
      GrdOrdDsg.SetFocus
      Exit Sub
    End If
    
    '*** Jay 3.4(FG) ***
    If ms_OmTc = "FOT" And Not moCn.RecSeek("select 'x' from OrdDsg where OdTc= 'FIN' and OdDmCd= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' " + _
                "and OdSfx= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx") + "' and OdDmStkYy = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy") + "' and OdDmStkChr = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr") + "' " + _
                " and OdDmStkNo= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkNo")) + " and OdCoCd= '" + ms_OmCoCd + "' ") Then
        DispMsg "DmStkNum Not Present For Dsg Code and Suffix Combination in ''FG In'' Entry", etError: GrdOrdDsg.SetFocus: Exit Sub
    End If
    '*** Jay 3.4(FG) ***
    '*** (Jen 2.11)
    Dim ws_QbWtEqOrd As String, ws_QbWtFrOrd As String
    ws_QbWtEqOrd = ADC("wDsgQbWtEqOrd")
    ws_QbWtFrOrd = ADC("wDsgQbWtFrOrd")
    '*** (Jen 2.11)
    'umaa
                    
    If RetMemExists = True Then Exit Sub    '*** (Jen 2.13)

    Call DispFra(DsgCpy)
        
    ADC("wDsgDmCd") = "": ADC("wDsgSrNo") = 0
    ADC("wDsgDmCd") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd")
    ADC("wDsgSfx") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx")
    ADC("wDsgSz") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz")
    
    '*** (Jen 2.11)
    If UCase(ADC("wDsgSource")) = UCase(ctDsgCpyBag) And ws_QbWtEqOrd <> "" Then
      ADC("wDsgQbWtEqOrd") = ws_QbWtEqOrd
      ADC("wDsgQbWtFrOrd") = ws_QbWtFrOrd
    End If
    '*** (Jen 2.11)
    
    If GrdOrdDsg.IsNew(GrdOrdDsg.Row) Then
      'Diagold.1- when a new row added to OrdDsg grid if any record in OrdTgt table for that new sr. number then that will be delete
      moCn.Execute ("Delete From OrdTgt where " + _
                    "OtCoCd= '" + ADC("OmCoCd") + "' and OtTc= '" + ADC("OmTc") + "' and " + _
                    "OtYy= '" + ADC("OmYy") + "' and OtChr= '" + ADC("OmChr") + "' and " + _
                    "OtNo= " + CStr(ADC("OmNo")) + " AND oTSR= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and OtPrtKey='" + ctCurrPrtn + "'  ")
      GrdOrdDsgTgt.Rows = 1
      '****** Sachin 3.02 08-12-07 - Ordtgt will be deleted from Current Partition
          
      Dim wRsOrdTgt As MDORowSet, i As Integer
      '****** Sachin 3.02 08-12-07 - Ordtgt will be deleted from Current Partition
      Set wRsOrdTgt = moCn.OpenRes("Select OtRmCtg, OtRmSCtg, OtRmCd from OrdTgt where " + _
                      "OtCoCd= '" + ms_OmCoCd + "' and OtTc= '" + ADC("OmTc") + "' and " + _
                      "OtYy= '" + ADC("OmYy") + "' and OtChr= '" + ADC("OmChr") + "' and " + _
                      "OtNo= " + CStr(ADC("OmNo")) + " and OtPrtKey='" + ctCurrPrtn + "' and OtSr= 0 ")
      With GrdOrdDsgTgt
        GrdOrdDsgTgt.StartCopy
        Do While Not (wRsOrdTgt.EOF Or wRsOrdTgt.BOF)
          .AddItem
          i = .Rows - 1
          .Value(i, "OtSr") = CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
          .Value(i, "OtRmCtg") = wRsOrdTgt!otrmctg
          .Value(i, "OtRmSCtg") = wRsOrdTgt!OtRmSCtg
          .Value(i, "OtRmCd") = wRsOrdTgt!OtRmCd
          .SaveRec (i)
          wRsOrdTgt.MoveNext
        Loop
        GrdOrdDsgTgt.EndCopy
        If GrdOrdDsgTgt.Rows - 1 > 0 Then ADC("wDsgCpyRt") = "N": ADC("wDsgCpyLabRt") = "N"
      End With
    End If

    If ADC("wDsgCpyRt") = "" Then ADC("wDsgCpyRt") = "N"
    If ms_OmTcTyp = "QB" And ADC("wDsgQbWtEqOrd") = "" Then ADC("wDsgQbWtEqOrd") = "N" '*** Manali 3.3 (QB Condition Added)
    If ADC("wRtByStkYN") = "" Then ADC("wRtByStkYN") = "N"          '****** Sachin 3.3.0
    If ADC("wDsgCpyLabRt") = "" Then ADC("wDsgCpyLabRt") = "N"
    '****** Zubin 3.02.01 - 26/03/08
    ADC("wDsgCpyChgPtrOnStwYN") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN")
    '****** Zubin 3.02.01 - 26/03/08
    'kc.8- setting default source Tc for repair differnce
    ADC("wDsgAddRprDiffTc") = "JRO"
  Else
    '(Bef 2.11) If ADC("WDSGSOURCE") <> "" Then ADC("WDSGSOURCE") = ""
    
    Call DispFra(DsgCpy)
  End If
  'uma changed
  'Call DsgOrdDefGp(ctDsgSumm)
End Sub
Private Function GetOdCell(pSameCust As Boolean, pOdOmIdNoOfSource As Long, pOdCellOfSource As String, pOmCellOfTargetFromX As String) As String
  Dim wOdCell As String
  Dim wOmCellOfSource As String
  If pOdOmIdNoOfSource <> 0 Then
    wOmCellOfSource = moCn.GetFldVal("Select OmCell from OrdMst where OmIdNo =" + CStr(pOdOmIdNoOfSource))
  End If
  If pSameCust And wOmCellOfSource = pOmCellOfTargetFromX Then
    wOdCell = pOdCellOfSource
  Else
    wOdCell = pOmCellOfTargetFromX
  End If
  GetOdCell = wOdCell
End Function
Private Function GetOdPrdSeq(wSameCust As Boolean, OdCell As String, OdPrdSeqFromSource As String, DmCd As String, DmSz As String) As String
      Dim wPrdSeq As String
      
      If wSameCust Then
        wPrdSeq = OdPrdSeqFromSource
      End If
      
      If wPrdSeq <> "" Then
        If Not moCn.RecSeek("Select vPMCd from vParam where vPCoCd = '" + ms_OmCoCd + "' and " + _
                      "vPTyp = 'PRDSEQ' and vPMCd = '" + wPrdSeq + "'") Then
          wPrdSeq = ""
        End If
      End If
      
      If wPrdSeq = "" Then
        wPrdSeq = moCn.GetFldVal("Select DmPrdSeq from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                       "and DmCd='" + DmCd + "' " + _
                       "and (DmSz= '" + DmSz + "' or (DmDefSz<> '' and DmDefSz= '" + DmSz + "') ) " + _
                       "and DmPrtKey= '" + ctCurrPrtn + "' ")
        If wPrdSeq <> "" Then
          If Not moCn.RecSeek("Select vPMCd from vParam where vPCoCd = '" + ms_OmCoCd + "' and " + _
                      "vPTyp = 'PRDSEQ' and vPMCd = '" + wPrdSeq + "'") Then
            wPrdSeq = ""
          End If
        End If
      End If
      If wPrdSeq = "" Then
        wPrdSeq = moCn.GetFldVal("Select min(vPMCd) from vParam where vPCoCd ='" + ms_OmCoCd + "' and vPTyp ='PRDSEQ' and vPValue2 ='" + _
                ADC("OMCELL") + "' and vPValue1 =(select DmPrcsSeq from DsgMst where DmTcTyp='DM' and " + _
                "DmCd='" + DmCd + "' and (DmSz= '" + DmSz + "' or (DmDefSz<> '' and DmDefSz= '" + DmSz + "') ) " + _
                       "and DmPrtKey= '" + ctCurrPrtn + "') ")
      End If
      
      If wPrdSeq = "" Then
          wPrdSeq = moCn.GetFldVal("Select hDmPrdSeq from Head where HCd='ZSELF' and HCoCd='" + ms_OmCoCd + "'")
      End If
      GetOdPrdSeq = wPrdSeq
End Function
Private Sub InitCpySalPrcVar(pv_CpyFrRet As Boolean, wFixPrc As String, pv_rsSrcOd_IdFixPrc As String)
      If mf_MrpChr Then
        mf_CpySalPrc = False
      Else
        If pv_CpyFrRet = True Then
          If pv_rsSrcOd_IdFixPrc = "Y" Then
            mf_CpySalPrc = True
          Else
            mf_CpySalPrc = False
          End If
        Else
          If ADC("WDSCPYFRYN") = "Y" Then
              If mf_CpyVal = True And mf_CpyRate = True And ms_CpyRateCd = "GPSLDCXM" And mf_CpyLabRate = True Then
                mf_CpySalPrc = True
              End If
          Else
            mf_CpyVal = False
            If mf_CpyRate = True And ms_CpyRateCd = "GPSLDCXM" And mf_CpyLabRate = True Then
              If wFixPrc = "Y" Then
                mf_CpySalPrc = True
              Else
                mf_CpySalPrc = False
              End If
            Else
              mf_CpySalPrc = False
            End If
          End If
        End If
      End If
End Sub
Private Sub CpyOdMrpAndMrpDiscForMRTCHR(pv_rsSrcOd As MDORowSet, RowNum As Integer, DmCd As String, DmSfx As String, DmSz As String)
      Dim wMrp As Double
      Dim wMrpDisc As Double
      Dim wf_SrcMRPChr As Boolean
      Dim ws_SrcOmTcTyp As String
      Dim ws_SrcCmCtg As String
      Dim ws_SrcCmCd As String
      If Not mf_MrpChr Then Exit Sub
      ws_SrcOmTcTyp = moCn.GetFldVal("Select PValue from Param where PTyp ='" + "TC" + "' and PMCd='" + pv_rsSrcOd!OdTc + "'")
      ' Getting more values needed to apply CpyMrp Business Rule - since pv_rsSrcOd has so many sources trying to seek values directly instead of modifying rs_SrcOd everywhere to get fields I need
      If ws_SrcOmTcTyp = ctJtTcTyp Then
        wf_SrcMRPChr = IIF(ws_SrcOmTcTyp = ctJtTcTyp And moCn.GetFldVal("Select vPValue3 from vParam where vPTyp = 'CHR' and vPCoCd='" + pv_rsSrcOd!OdCoCd + "' and vPMCd='" + _
         pv_rsSrcOd!OdTc + "' and vPSCd='" + pv_rsSrcOd!OdChr + "'") = "Y", True, False)
        
        ws_SrcCmCtg = moCn.GetFldVal("Select OmCmCtg from OrdMst where OmCoCd='" + pv_rsSrcOd!OdCoCd + "' and OmTc='" + pv_rsSrcOd!OdTc + "' and OmYy='" + pv_rsSrcOd!OdYy + "' and OmChr='" + pv_rsSrcOd!OdChr + "' and " + _
                                  "OmNo=" + CStr(pv_rsSrcOd!OdNo))
        ws_SrcCmCd = moCn.GetFldVal("Select OmCmCd from OrdMst where OmCoCd='" + pv_rsSrcOd!OdCoCd + "' and OmTc='" + pv_rsSrcOd!OdTc + "' and OmYy='" + pv_rsSrcOd!OdYy + "' and OmChr='" + pv_rsSrcOd!OdChr + "' and " + _
                                  "OmNo=" + CStr(pv_rsSrcOd!OdNo))
              
      End If
      'apply business rule to when to copy OdMrpDisc and OdMrp (if both are MRP CHRs and same customer and target is JSA and source is JSO)
      If mf_MrpChr And wf_SrcMRPChr And ws_SrcCmCtg = ADC("OmCmCtg") And ws_SrcCmCd = ADC("OmCmCd") And ADC("OmTc") = "JSA" And pv_rsSrcOd!OdTc = "JSO" Then
        wMrpDisc = pv_rsSrcOd!OdMrpDisc
        wMrp = pv_rsSrcOd!OdMrpDisc
      Else
        wMrp = GetMRP(ADC("OmCmCtg"), ADC("OmCmCd"), ADC("OmCmCurCd"), DmCd, DmSz, DmSfx)
        wMrpDisc = GetMRD(ADC("OmCmCtg"), ADC("OmCmCd"), DmCd, DmSz, DmSfx)
      End If
      SetParamsVal wMrp, wOdMrp
      SetParamsVal wMrpDisc, wOdMrpDisc
      ForCpy_CalculateOdSalPrcFromMrp (RowNum)
End Sub
