                              " And OmTc='" + pv_rsSrcOd!OdTc + "' And OmYy='" + pv_rsSrcOd!OdYy + "' And OmChr='" + pv_rsSrcOd!OdChr + "' And OmNo=" + CStr(pv_rsSrcOd!OdNo)) = ADC("OmCmCd") + " And OmPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OmPrtKey"))
