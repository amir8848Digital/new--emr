Private Sub GrdOrdDsg_GotFocus()
Dim wf_Cancel As Boolean, wf_errmsg As String
Dim wf_invhdmust As Boolean
' ***** Manali Trading Module
If moCn.RecSeek("Select 'x' from InvHd Where InCoCd='" + ms_OmCoCd + "' and InTc='" + ADC("OmTc") + "' " + _
                  " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' ") Then mInvExists = True
wf_invhdmust = moCn.RecSeek("Select 'x' from TcMst where TmTc = '" + ADC("omTc") + "' and TmCoCd = '" + ms_OmCoCd + "' and TmInvHdMustYn = 'Y'")
If (CmdInvHd.Visible = True And Not mInvExists And wf_invhdmust = True) Then
    GrdOrdDsg.AllowAdd = False    ': GrdOrdDsg.AllowDelete = False
    DispMsg "Cannot Add Designs as Invoice Header Does Not Exist", etError: Exit Sub
Else
    Call ATXT_FldChange(99, "OrdLockYN", wf_Cancel, wf_errmsg, ADC("OmLockYN"))
    If (CmdInvHd.Visible = True And mInvExists) Then GrdOrdDsg.AllowAdd = True ': GrdOrdDsg.AllowDelete = True
End If
End Sub

