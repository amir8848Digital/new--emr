            .Value(wi_OdRow, "OdDmStkCoCd") = pv_rsSrcOd!OdDmStkCoCd
            .Value(wi_OdRow, "OdDmStkYy") = pv_rsSrcOd!OdDmStkYy
            .Value(wi_OdRow, "OdDmStkChr") = pv_rsSrcOd!OdDmStkChr
            .Value(wi_OdRow, "OdDmStkNo") = pv_rsSrcOd!OdDmStkNo
        End If
      End If
      
      If pv_OrdCpy = True And pv_CpyBags = False Then
