Private Sub EnaDisaCmds(ByVal pv_ShowFra As Boolean, Optional ByVal pv_CmdBut As MWCTL_BTN1, Optional ByVal pv_DispFra As en_DispFra, Optional pb_DsgFt As Boolean = False)
  '*** This procedure is used to give the toggle option (enable and disable) to
      'the command buttons
  '*** storing the state of all cmd buttons, when the frame is going to be visible.
  Dim X As Integer
  If pv_ShowFra = True Then
    Call StoreState
  End If

  If Not pv_CmdBut Is Nothing Then
    If pv_ShowFra = True Then
        '*** Jenny (Old Code Bef Color)
        'pv_CmdBut.BackColor = vbWhite
        'pv_CmdBut.FontBold = True
        '*** Jenny (Old Code Bef Color)
        If pv_CmdBut.Pic = 0 Then
          pv_CmdBut.BackColor = vbWhite
          'pv_CmdBut.FontBold = True
        End If
        pv_CmdBut.CausesValidation = True
    Else
        '*** Jenny (Old Code Bef Color)
        'pv_CmdBut.BackColor = &H8000000F
        'pv_CmdBut.FontBold = False
        '*** Jenny (Old Code Bef Color)
        
        If pv_CmdBut.Pic = 0 Then
          pv_CmdBut.BackColor = &H8000000F
          'pv_CmdBut.FontBold = False
        End If
        
        ' pv_CmdBut.CausesValidation = False
        '*** restoring the 'Causes Validation' state of the current pv_cmdbutton
        If Not IsMissing(pv_DispFra) Then
          pv_CmdBut.CausesValidation = mArr_Cv(pv_DispFra)
        End If
    End If
  End If
  
  FraNKeyAll.Enabled = Not pv_ShowFra
  ADC.AllowSave = Not pv_ShowFra
  ADC.AllowDelete = Not pv_ShowFra   '*** (Bef 3.01)
  
  '*** (Jen 3.01)
  'If mb_CustomiseOrd = False Or pv_ShowFra = True Then
  '  ADC.AllowDelete = Not pv_ShowFra
  'Else
  '  Call SetAdcAllowAddDel("DELETE", Not pv_ShowFra)
  'End If
  '*** (Jen 3.01)
  
  ADC.AllowCancel = Not pv_ShowFra
  
  If pv_ShowFra = True Then
    '** All command buttons are disabled
    CmdDsgCpy.Enabled = Not pv_ShowFra
    CmdDsgDet.Enabled = Not pv_ShowFra
    CmdOrdCpy.Enabled = Not pv_ShowFra
    CmdOrdDet.Enabled = Not pv_ShowFra
    CmdSumm.Enabled = Not pv_ShowFra
    CmdOrdAmd.Enabled = Not pv_ShowFra
    CmdSc.Enabled = Not pv_ShowFra
    CmdGS.Enabled = Not pv_ShowFra
    CmdDsgSel.Enabled = Not pv_ShowFra
    CmdRefRt.Enabled = Not pv_ShowFra
    ' Manoj 2.10.0
    CmdSH.Enabled = Not pv_ShowFra
    ' Manoj 2.10.0
' ########################  Manoj #### Ver: 2.11.0 #### Date: 01/06/2005  ########################
    CmdSM.Enabled = Not pv_ShowFra
' ###########################################  Manoj  ###########################################
    CmdCpyBags.Enabled = Not pv_ShowFra   ' ****** Sachin 2.12 - 13/12/05
    CmdCustDsg.Enabled = Not pv_ShowFra   ' ****** Sachin 2.12 - 20/12/05
    
    CmdCpyRet.Enabled = Not pv_ShowFra    ' *** (Jen 2.13)
    CmdCT.Enabled = Not pv_ShowFra        ' ***  jay 2.13(CT) ***
    CmdGenDmStkNo.Enabled = Not pv_ShowFra   ' *** Jay 3.4(FG)
    CmdInvHd.Enabled = Not pv_ShowFra     ' **** Manali Trading Module
    CmdStkCpy.Enabled = Not pv_ShowFra    ' **** Manali Trading Module
    CmdRefDiaAvlDt.Enabled = Not pv_ShowFra
    CmdCustSel.Enabled = Not pv_ShowFra   'pg.2- customer selection
    CmdChgDt.Enabled = Not pv_ShowFra   '19 change date
    CmdCpyErr.Enabled = Not pv_ShowFra   'sv.71
    CmdDsgTagOk.Enabled = Not pv_ShowFra '5716 tag
    CmdOrdDel.Enabled = Not pv_ShowFra   '6.1B-6
    CmdShowPO.Enabled = Not pv_ShowFra  '6.1b-39
    
    ' Zubin 3.02.01
    If pb_DsgFt = False Then
      FraDsgFt.Enabled = Not pv_ShowFra
      CmdSelPic.Enabled = Not pv_ShowFra
      CmdDsgFtOk.Enabled = Not pv_ShowFra
    End If
    ' Zubin 3.02.01
  Else
    '*** Restoring Ena/Disa state of all Command Buttons
    CmdDsgCpy.Enabled = mArr_Ed(DsgCpy)
    CmdDsgDet.Enabled = mArr_Ed(DsgDet)
    CmdOrdCpy.Enabled = mArr_Ed(ORDCPY)
    CmdOrdDet.Enabled = mArr_Ed(OrdDet)
    CmdSumm.Enabled = mArr_Ed(Summ)
    CmdGenDmStkNo.Enabled = mArr_Ed(GenDmStkNo)
