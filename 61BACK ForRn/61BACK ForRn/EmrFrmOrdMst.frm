Private Sub SetGrdOrdLab(mOpt)
  '*** Procedure to make the fields if the grid GrdOrdLab visible or invisible according to
      'requirement for display purposes
  '*** If the parameter passed is 'S' then make the fields invisible
  '*** If the parameter passed is 'E' then make the fields visible except the fields which
      'were kept invisible at design time

  Static WLEFT As Long
  
  '*** 02/04/05 (Jenny Color)
  Static wtmp As Long
  Dim i As Integer
  '*** 02/04/05 (Jenny Color)
  
  'Dim wtmp As Long, i As Integer   (Old Code Bef 02/04/05)
  If mOpt = "S" Then
    If mi_LabGrdLeft = 0 Then mi_LabGrdLeft = GrdOrdLab.Left
    WLEFT = mi_LabGrdLeft      '*** (Old Code) WLEFT = GrdOrdLab.Left
    wtmp = 0
    For i = 4 To 6
      wtmp = wtmp + GrdOrdLab.ColProp(i).Width
      GrdOrdLab.ColProp(i).Style = fgcinvisible
    Next i
'??? consider speed
    GrdOrdLab.Left = wtmp + WLEFT
    'GrdOrdLab.Width = GrdOrdLab.Width - wtmp  '*** 02/04/05 (Jenny Color)
  End If
  
  If mOpt = "E" Then
    If WLEFT <> 0 Then
      GrdOrdLab.Left = WLEFT
      'GrdOrdLab.ColProp(4).Style = fgcReadOnly
      
      '*** (Bef 3.01)
      'GrdOrdLab.ColProp(4).Style = fgcNormal
      'GrdOrdLab.ColProp(5).Style = fgcNormal
      'GrdOrdLab.ColProp(6).Style = fgcNormal
      '*** (Bef 3.01)
      
      '*** (Jen 3.01)
      If mb_CustomiseOrd = False Then
        GrdOrdLab.ColProp(4).Style = fgcNormal
        GrdOrdLab.ColProp(5).Style = fgcNormal
        GrdOrdLab.ColProp(6).Style = fgcNormal
      Else
        Call SetGrdColStyle("GrdOrdLab", GrdOrdLab.ColProp(4).ColName, fgcNormal)
        Call SetGrdColStyle("GrdOrdLab", GrdOrdLab.ColProp(5).ColName, fgcNormal)
        Call SetGrdColStyle("GrdOrdLab", GrdOrdLab.ColProp(6).ColName, fgcNormal)
      End If
      '*** (Jen 3.01)
      
      GrdOrdLab.Width = GrdOrdLab.Width + wtmp  '*** 02/04/05 (Jenny Color)
    End If
  End If
End Sub
Private Sub DsgRmSumm()
  '*** Procedure to show the Design Rm Summary in the Summary Frame
  Dim wd_DsgRmTotWt As Double, wd_DsgRmTotQty As Double, wd_DsgRmTotVal As Double, wo_rsDsgRmSumm As MwfLib.MDORowSet, wi_Row As Integer, ws_SQL As String
  Dim wd_DsgRmProfit As Double
  wd_DsgRmTotWt = 0: wd_DsgRmTotQty = 0: wd_DsgRmTotVal = 0: wd_DsgRmProfit = 0
  ws_SQL = RmSummSql(ctDsgSumm)
  GrdDsgRmSumm.Rows = 1
  If ws_SQL = "" Then DispMsg "Invalid GroupBy option", etInfo: Exit Sub
  Set wo_rsDsgRmSumm = moCn.OpenRes(ws_SQL)
  GrdDsgRmSumm.AllowAdd = True
  With GrdDsgRmSumm
    Do While Not (wo_rsDsgRmSumm.EOF Or wo_rsDsgRmSumm.BOF)
      .AddItem
      wi_Row = .Rows - 1
      .Value(wi_Row, "wDsgRmCtg") = wo_rsDsgRmSumm!OrRmCtg
      .Value(wi_Row, "wDsgRmSCtg") = wo_rsDsgRmSumm!OrRmSCtg
      .Value(wi_Row, "wDsgRmCd") = wo_rsDsgRmSumm!OrRmCd
      .Value(wi_Row, "wDsgRmQty") = wo_rsDsgRmSumm!OrQty
      .Value(wi_Row, "wDsgRmWt") = wo_rsDsgRmSumm!OrWt
      .Value(wi_Row, "wDsgRmVal") = wo_rsDsgRmSumm!OrSalVal
      .Value(wi_Row, "wDsgRmCstVal") = wo_rsDsgRmSumm!OrCstVal
      
      If UCase(ADC("wBaseVal")) = "C" Then
        'If wo_rsDsgRmSumm!OrCstVal <> 0 And wo_rsDsgRmSumm!OrCstVal <> Null Then
          wd_DsgRmProfit = MWLib.Div((wo_rsDsgRmSumm!OrSalVal - wo_rsDsgRmSumm!OrCstVal) * 100, wo_rsDsgRmSumm!OrCstVal)
        'Else
        '  wd_DsgRmProfit = (wo_rsDsgRmSumm!OrSalVal * 100) / 1
        'End If
      ElseIf UCase(ADC("wBaseVal")) = "S" Then
        'If wo_rsDsgRmSumm!OrSalVal <> 0 And wo_rsDsgRmSumm!OrSalVal <> Null Then
          wd_DsgRmProfit = MWLib.Div((wo_rsDsgRmSumm!OrSalVal - wo_rsDsgRmSumm!OrCstVal) * 100, wo_rsDsgRmSumm!OrSalVal)
        'Else
        '  wd_DsgRmProfit = (wo_rsDsgRmSumm!OrCstVal * 100) / 1
        'End If
      End If
      
      .Value(wi_Row, "wDsgRmProfit") = wd_DsgRmProfit
      
      Select Case Trim(wo_rsDsgRmSumm!OrRmCtg)
      ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
      Case Is = "G", "P", "S", "L", "M", "X"
        wd_DsgRmTotWt = wd_DsgRmTotWt + wo_rsDsgRmSumm!OrWt
      Case Is = "D", "C"
        wd_DsgRmTotWt = wd_DsgRmTotWt + MWLib.Div(wo_rsDsgRmSumm!OrWt, 5)
      End Select
      wd_DsgRmTotQty = wd_DsgRmTotQty + wo_rsDsgRmSumm!OrQty
      wd_DsgRmTotVal = wd_DsgRmTotVal + wo_rsDsgRmSumm!OrSalVal
      wo_rsDsgRmSumm.MoveNext
    Loop
  End With
  ADC("wDsgRmTotWt") = wd_DsgRmTotWt
  ADC("wDsgRmTotQty") = wd_DsgRmTotQty
  ADC("wDsgRmTotVal") = wd_DsgRmTotVal
  GrdDsgRmSumm.AllowAdd = False
End Sub
