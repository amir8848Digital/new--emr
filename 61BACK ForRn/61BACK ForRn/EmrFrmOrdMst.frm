      ''End If
      '************************** urmi *****************************************************'
'      MWLib.RunningProcess "Copying of Row: " + CStr(ijk) + " OrdLab Done"
      TrackStatus ("Done OrdLab of Row: " + CStr(ijk) + ":" + CStr(Now))

      'IG.97 -If Rtn category is RMK then calculates the difference between OdSalPrc & InvSalPrc.
      If pv_CpyFrRet Then
        If pv_rsSrcOd!ReRtnCtg = "RMK" Then
