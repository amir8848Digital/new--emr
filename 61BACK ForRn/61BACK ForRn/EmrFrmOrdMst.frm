Private Function ForCpy_GetGldAsCstLabAsAndLabAsWt() As String
  Dim wLabAsWt As Double, wBigStr As String, wBigStrLABAS As String, i As Integer, wWt As Double
  Dim wChnLabAs As String, ws_RmSCtg As String, wChnGldAs As String                                                   ' **************Bhavna for Chain Labour wt calc, w
  Dim ws_RmCtg As String
  Dim wCstLabAsWt As Double
  Dim ws_ErrMsg As String
  md_ForCpyOdCalcPrc = 0
  md_ForCpyOdCstPrc = 0
  
  wBigStrLABAS = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                  "PTyp='GLDAS' and PMCd = '" + Params(wOdLabAs) + "'") + ","
                  
  wBigStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                  "PTyp='GLDAS' and PMCd = '" + Params(wOdGldAs) + "'") + ","
                  
  If ADC("wChnCustYn") = "Y" Then
    wChnGldAs = "," + moCn.GetFldVal("Select hChnSubCtgForGld from Head where hCoCd = 'ZZZ'") + ","
  Else
    wChnGldAs = ""
  End If
  Dim wGldAsWt As Double
  
  If ADC("wChnCustYn") = "Y" Then
    wChnLabAs = "," + moCn.GetFldVal("Select hChnSubCtgForLab from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain labour gold wt calc
  Else
    wChnLabAs = ""
  End If
  Dim wd_RmValSal As Double
  
  Dim wd_RmValCst As Double
  md_ForCpyOdCstPrc = 0
  md_ForCpyOdCalcPrc = 0
  
  
  
  Dim wRsRmRows As MDORowSet
  Set wRsRmRows = moCn.OpenRes("Select * from OrdRm where OrCoCd= '" + ms_OmCoCd + "' and " + _
                    "OrTc= '" + ADC("OmTc") + "' and OrYy= '" + ADC("OmYy") + "' and " + _
                    "OrChr= '" + ADC("OmChr") + "' and OrNo= " + CStr(ADC("OmNo")) + " and " + _
                    "OrSr= " + CStr(Params(wctOdSr)) + " and OrPrtKey='" + ctCurrPrtn + "' " + _
                    " order by OrMainMet ")
  Dim wd_OrSalVal As Double
  Dim wd_OrCstVal As Double
  Dim wd_OrSetSalVal As Double
  Dim wd_OrSetCstVal As Double
  Dim wb_Errinsrvrcpy As Boolean
  Dim ws_errInSrvrCpyLvl As String
  
  Do While Not (wRsRmRows.EOF Or wRsRmRows.BOF)
      ws_RmCtg = UCase(wRsRmRows!OrRmCtg)                                            '************
      ws_RmSCtg = UCase(wRsRmRows!OrRmSCtg)
      wWt = IIF((InStr(1, wBigStrLABAS, "," + ws_RmCtg + ",") <> 0) And (InStr(1, wChnLabAs, "," + ws_RmSCtg + ",") = 0), _
                wRsRmRows!OrWt, 0)
      
      wLabAsWt = wLabAsWt + IIF(ws_RmCtg = "D" Or _
                                ws_RmCtg = "C", MWLib.Div(wWt, 5), wWt)
                                
      If Not (ws_RmCtg = "D" Or ws_RmCtg = "C" Or ws_RmCtg = "X") Then
            wCstLabAsWt = wCstLabAsWt + wWt
      End If

      wWt = IIF(((InStr(1, wBigStr, "," + ws_RmCtg + ",") <> 0) And ws_RmCtg <> Params(qOdMainMetRmCtg) And _
                       (InStr(1, wChnGldAs, "," + ws_RmSCtg + ",") = 0) And _
                    ws_RmCtg <> "G" And ws_RmCtg <> "P" And ws_RmCtg <> "S" And ws_RmCtg <> "L") _
                    Or wRsRmRows!OrMainMet = "Y", _
                  wRsRmRows!OrWt, 0)
      wGldAsWt = wGldAsWt + IIF(wRsRmRows!OrRmCtg = "D" Or _
                                  wRsRmRows!OrRmCtg = "C", MWLib.Div(wWt, 5), wWt)
      If wRsRmRows!OrMainMet = "N" Then
        wd_OrSetCstVal = wRsRmRows!OrSetCstVal
        wd_OrSetSalVal = wRsRmRows!OrSetSalVal
        wd_OrCstVal = wRsRmRows!OrCstVal
        wd_OrSalVal = wRsRmRows!OrSalVal

        wd_RmValSal = wd_RmValSal + wd_OrSalVal + wd_OrSetSalVal
        wd_RmValCst = wd_RmValCst + wd_OrCstVal + wd_OrSetCstVal
      End If
      If wRsRmRows!OrMainMet = "Y" Then Exit Do
      wRsRmRows.MoveNext

    Loop
    
    SetParamsVal IIF(wCstLabAsWt < 0, 0, wCstLabAsWt), qOdCstLabAsWt
    SetParamsVal IIF(wLabAsWt < 0, 0, wLabAsWt), wOdLabAsWt
    SetParamsVal IIF(wGldAsWt < 0, 0, wGldAsWt), wOdGldAsWt
    If Not (wRsRmRows.EOF Or wRsRmRows.BOF) Then
    If wRsRmRows!OrMainMet = "Y" Then
      SetParamsValRm wRsRmRows!OrRmCtg, wOrRmCtg
      SetParamsValRm wRsRmRows!OrRmCd, wOrRmCd
      SetParamsValRm wRsRmRows!OrPrdQty, wOrPrdQty
      SetParamsValRm wRsRmRows!OrPrdWt, wOrPrdWt
      SetParamsValRm wRsRmRows!OrCstRt, wOrCstRt
      SetParamsValRm wRsRmRows!OrMainMet, wOrMainMet
      SetParamsValRm wRsRmRows!OrRmCd, wOrRmCd
      SetParamsValRm wRsRmRows!OrQty, wOrQty
      SetParamsValRm wRsRmRows!OrSalRt, wOrSalRt
      SetParamsValRm wRsRmRows!OrCstVal, wOrCstVal

      If mf_InCopyFromServer And mf_CpyVal = True And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + ParamsRm(wOrRmCtg) + ",") >= 1 Or ParamsRm(wOrRmCtg) = "") Then
        SetParamsValRm wRsRmRows!OrCstVal, wOrCstVal
        SetParamsValRm wRsRmRows!OrSalVal, wOrSalValCt
        
      Else
        
          RecalcForCpy_OrSalVal
          RecalcForCpy_OrCstVal
          SetParamsValRm wRsRmRows!OrSrNo, wOrSrNo
          SetParamsValRm 2, qOrMode
          
          
          wb_Errinsrvrcpy = Not InsOrdRmCpy(Params(wctOdSr), ws_ErrMsg)
          
          If wb_Errinsrvrcpy Then
            ForCpy_GetGldAsCstLabAsAndLabAsWt = ws_ErrMsg
            Exit Function
  '          moCn.Execute ("Delete From OrdRm Where OrCoCd ='" + ms_OmCoCd + "' And " + _
                          " OrTc = '" + ADC("OmTc") + "' And OrYy = '" + ADC("OmYy") + "' And " + _
                          " OrChr = '" + ADC("OmChr") + "' And OrNo = " + CStr(ADC("OmNo")) + " And " + _
                          " OrSr = " + CStr(GrdOrdDsg.Value(wi_OdRow, "OdSr")))
         End If
      End If
        
      wd_OrCstVal = ParamsRm(wOrCstVal)
      wd_OrSalVal = ParamsRm(wOrSalValCt)
      wd_OrSetSalVal = 0
      wd_OrSetCstVal = 0
      wd_RmValSal = wd_RmValSal + wd_OrSalVal + wd_OrSetSalVal
      wd_RmValCst = wd_RmValCst + wd_OrCstVal + wd_OrSetCstVal
      
    End If
    End If
    
    md_ForCpyOdCalcPrc = wd_RmValSal
    md_ForCpyOdCstPrc = wd_RmValCst
    ForCpy_GetGldAsCstLabAsAndLabAsWt = ""
End Function


Private Sub GrdOrdRm_ColChange(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  '*** OrRmCtg          valid PMCd('RMCTG')
  '*** OrRmSCtg         valid PSCd('RMSCTG', OrRmCtg) or ''
  '*** OrRmCd           valid RmCd from RmMst(RmCtg= OrRmCtg, RmSCtg= OrRmCtg, RmZ= 'N') or ''
  '*** OrSetSCd         valid PSCd('LABSCD', 'SET') or ''
  '*** OrSubShp         valid PMCd('SUBSHP') or ''
  '*** OrAlyCd          valid RmCd from RmMst(RmCtg= 'A', RmZ= 'N') or ''
  '*** OrMainMet        valid PMCd('YN')
  '*** OrWsQty          <= OrQty
  
  With GrdOrdRm
    Select Case ColName
    Case Is = UCase("OrRmCtg")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'RMCTG' And PMCd = '" + NewValue + "'")
      If Cancel = True Then ErrMsg = "Invalid Raw Material Category": Exit Sub
      'mw.84 if Rmctg <>D and if any value in RmLot then give error message
      If NewValue <> "D" And ADC("wOrLotNo") <> "" Then _
        Cancel = True: ErrMsg = "RmCtg Cannot Be Change, If RmLot exists ": Exit Sub
    Case Is = UCase("OrRmSCtg")
      
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select PSCd From Param Where PTyp= 'RMSCTG' And " + _
                           "PMCd='" + .Value(RowNum, "OrRmCtg") + "' " + _
                           "And PSCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Raw Material Sub Category": Exit Sub
      
    Case Is = UCase("OrRmCd")
      '*** if the user specifies blank rmcd it went into a loop and generated a runtime error
      'Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                           "RmCtg= '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                           "RmSCtg='" + .Value(RowNum, "OrRmSCtg") + "' " + _
                           "And RmCd = '" + NewValue + "'"))
                                   
      '****** Sachin 3.02 07-12-07 - Rm Codes to be checked from Current partition
      Cancel = .Value(RowNum, "OrPrtKey") = ctCurrPrtn And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                           "RmCtg= '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                           "RmSCtg='" + .Value(RowNum, "OrRmSCtg") + "' " + _
                           "And RmCd = '" + NewValue + "' And RmPrtKey='" + ctCurrPrtn + "'"))
      If Cancel = True Then ErrMsg = "Invalid Raw Material Code": Exit Sub
                             
      '*** (Jen 2.13 18/10/06) This check is required because when the usr tries to change an RmCode which already is transacted the error message from the trigger is displayed in aloop and 'Out of stack' runtime error occurs
      '****** Sachin 3.02 - Complete Db (to be checked)
      Cancel = (.Value(RowNum, "OrPrtKey") = ctCurrPrtn) And (.Value(RowNum, "OrRmCd") <> "") And (GrdOrdDsg.Value(GrdOrdDsg.Row, "OdExpQty") > 0 Or _
                moCn.RecSeek("Select 'x' from Bag where BCoCd = '" + ms_OmCoCd + "' and BOdTc= '" + ADC("OmTc") + "' and " + _
                "BOdYy= '" + ADC("OmYy") + "' and BOdChr= '" + ADC("OmChr") + "' and BOdNo = " + CStr(ADC("OmNo")) + " and " + _
                "BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and BPrtKey='" + ctCurrPrtn + "' And  " + _
                "exists (Select 'x' from Txnd where TdBIdNo=BIdNo and TdCoCd= BCoCd and TdBYy= BYy and TdBChr= BChr and TdBNo= BNo " + _
                "and TDRmCd= '" + .Value(RowNum, "OrRmCd") + "' And TdPrtKey='" + ctCurrPrtn + "') "))
      If Cancel = True Then ErrMsg = "Raw Material Code Cannot Be Changed As Rm Txn Exists/ Order Export Has Taken Place": Exit Sub
      '*** (Jen 2.13 18/10/06) This check is required because when the usr tries to change an RmCode which already is transacted the error message from the trigger is displayed in aloop and 'Out of stack' runtime error occurs
        
      '*** Jay 2.13(CT) ***
      ' ******** manali 3.3.0 - Component Open for "QT" also
      If Cancel = False And mf_CTMod = True And (UCase(ms_OmTcTyp) = "PL" Or UCase(ms_OmTcTyp) = "SO" Or UCase(ms_OmTcTyp) = "QT") And _
        GrdOrdCT.Rows - 1 > 0 Then
      ' **** Manali 3.03 - 19/06/08 - "L" included
        If .Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Then
          Dim i As Integer
          i = 1
          Do While i < GrdOrdCT.Rows
            If GrdOrdCT.Value(i, "OctRmCd") = .Value(RowNum, "OrRmCd") Then
              If Not moCn.RecSeek("Select 'x' from Bag where BPrtKey='" + ctCurrPrtn + "' and BCoCd = '" + ms_OmCoCd + "' and BOdTc= '" + ADC("OmTc") + "' " + _
                              "and BOdYy= '" + ADC("OmYy") + "' and BOdChr= '" + ADC("OmChr") + "' " + _
                              "and BOdNo = " + CStr(ADC("OmNo")) + " and BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " " + _
                              "and BChr= '" + GrdOrdCT.Value(i, "OctCtChr") + "' ") Then _
              GrdOrdCT.Value(i, "OctRmCd") = NewValue
            End If
            i = i + 1
          Loop
          GrdOrdRm.AddSave "GrdOrdCT", asAll
        End If
      End If
'      UpdateOdKtAndColFromOrdRm NewValue, GrdOrdRm.Value(RowNum, "OrMainMet")
    Case Is = UCase("OrLn1")
      If mb_VldRmLn = True And (.Value(RowNum, "OrRmCtg") = "D" Or .Value(RowNum, "OrRmCtg") = "C") Then
        Cancel = Not moCn.RecSeek("Select 'x' From VldRmLn Where VrsRmCtg= '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                             " VrsRmId=(Select RmId From RmMst Where RmCtg='" + .Value(RowNum, "OrRmCtg") + "' And RmCd= '" + .Value(RowNum, "OrRmCd") + "') And VrsLn1 = " + CStr(NewValue) + " ")
        ErrMsg = "Raw Material Ln Not Defined": Exit Sub
      End If
    
    Case Is = UCase("OrLn2")
      If mb_VldRmLn = True And (.Value(RowNum, "OrRmCtg") = "D" Or .Value(RowNum, "OrRmCtg") = "C") Then
        Cancel = Not moCn.RecSeek("Select 'x' From VldRmLn Where VrsRmCtg= '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                             "VrsRmId=(Select RmId From RmMst Where RmCtg='" + .Value(RowNum, "OrRmCtg") + "' And RmCd= '" + .Value(RowNum, "OrRmCd") + "') And VrsLn1 = " + CStr(.Value(RowNum, "OrLn1")) + " And VrsLn2 = " + CStr(NewValue))
        ErrMsg = "Raw Material Ln-Ln2 Combination Not Defined": Exit Sub
      End If
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master] ******
    
    Case Is = UCase("OrSetSCd")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select PSCd From Param Where " + _
                "PTyp= 'LABSCD' And PMCd='SET' " + _
                "And PSCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Setting Code": Exit Sub
    Case Is = UCase("OrSubShp")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select PMCd From Param Where " + _
                "PTyp= 'SUBSHP' And PMCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Sub Shape": Exit Sub
    Case Is = UCase("OrAlyCd")
        Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where " + _
                 " RmPrtKey='" + ctCurrPrtn + "' and RmZ='N' And RmCtg= 'A' And RmCd = '" + NewValue + "'"))
        If Cancel = True Then ErrMsg = "Invalid Alloy Code": Exit Sub
    '****** Sachin 2.13.0 - 05-07-2006 ******
    Case Is = UCase("OrAlySalRt")
      If GrdOrdRm.Value(RowNum, "OrAlyCd") = "" And NewValue <> 0 Then
        Cancel = True: ErrMsg = "Please Specify the Alloy Code before Entering Alloy Rate"
      End If
    '****** Sachin 2.13.0 - 05-07-2006 ******
    Case Is = UCase("OrMainMet")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'YN' And PMCd = '" + NewValue + "'")
      If Cancel = True Then ErrMsg = "Invalid Main Metal Y/N Option": Exit Sub
    
      '*** (Jen 2.13)
      Cancel = NewValue = "Y" And moCn.RecSeek("select 'x' from OrdRm where OrCoCd= '" + ms_OmCoCd + "' and " + _
                      "OrTc= '" + ADC("OmTc") + "' and OrYy= '" + ADC("OmYy") + "' and " + _
                      "OrChr= '" + ADC("OmChr") + "' and OrNo= " + CStr(ADC("OmNo")) + " and " + _
                      "OrSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and " + _
                      "OrSrNo<> " + CStr(.Value(RowNum, "OrSrNo")) + " " + _
                      "and OrMainMet = 'Y'  and OrPrtKey='" + ctCurrPrtn + "'")
      If Cancel = True Then ErrMsg = "Cannot Have More Than One Main Metal": Exit Sub
   
      If NewValue = "Y" Then
           Call UpdateOdKtAndColFromOrdRm(GrdOrdRm.Value(RowNum, "OrRmCd"), NewValue)
       End If

 
      
    Case Is = UCase("OrWsQty")
      If NewValue > .Value(RowNum, "OrQty") Then _
         Cancel = True: ErrMsg = "Wax Set Quantity Cannot Be Greater Than RM Quantity"
    End Select
  End With
End Sub
Private Sub UpdateOdKtAndColFromOrdRm(ByVal pOrRmCd As String, ByVal pOrMainMet As String)
    Dim wKt As String
    Dim wCol As String
    wKt = ""
    wCol = ""
    If GrdOrdDsg.Mode <> fgmnorm Then
      Exit Sub
    End If
    If GrdOrdDsg.Mode = fgmnorm Or (GrdOrdDsg.Mode = fgmCopy And Not mb_CpyKT) Then
      If pOrMainMet = "Y" Then
        wKt = moCn.GetFldVal("Select RmKt from RmMst where RmCd= '" + pOrRmCd + "' and RmPrtKey='" + ctCurrPrtn + "'")
        If wKt <> "" And wKt = moCn.GetFldVal("Select RmKT from RmMst where RmCd= '" + GrdOrdRm.Value(GrdOrdRm.Row, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "'") Then wKt = ""
        If wKt <> "" Then
          GrdOrdDsg.Value(GrdOrdDsg.Row, "OdKt") = wKt
         
        End If
      End If
    End If

    If GrdOrdDsg.Mode = fgmnorm Or (GrdOrdDsg.Mode = fgmCopy And Not mb_CpyCol) Then
      If pOrMainMet = "Y" Then
      
        wCol = moCn.GetFldVal("Select RmCol from RmMst where RmCd= '" + pOrRmCd + "' and RmPrtKey='" + ctCurrPrtn + "'")
        If wCol = moCn.GetFldVal("Select RmCol from RmMst where RmCd= '" + GrdOrdRm.Value(GrdOrdRm.Row, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "'") Then wCol = ""
        
        If wCol <> "" Then
          wCol = moCn.GetFldVal("Select IsNull((Select PmCd From Param where PTyp='DMCOL' and PMCd='" + wCol + "' and PSCd=''),'-')")
          If wCol <> "" Then GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCol") = wCol
        End If
      End If
    End If
    If wKt <> "" Or wCol <> "" Then GrdOrdRm.AddSave "GrdOrdDsg", asCurrent
End Sub

Private Sub GrdOrdRm_InitKey(ByVal RowNum As Integer)
  '*** Initialise Key Fields
  With GrdOrdRm
    .Store "OrCoCd", ms_OmCoCd
    .Store "OrTc", ADC("OmTc")
    .Store "OrYy", ADC("OmYy")
    .Store "OrChr", ADC("OmChr")
    .Store "OrNo", ADC("OmNo")
    .Store "OrSr", GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")
    '****** Sachin 3.02 (10/09/07) ******
    If .IsNew(RowNum) Then
      Dim wOrOdIdNo As Long
      wOrOdIdNo = moCn.GetFldVal("Select OdIdNo From OrdDsg " + _
                                      " Where OdPrtKey='" + ctCurrPrtn + "' and OdCoCd='" + ms_OmCoCd + "' And OdTc='" + ADC("OmTc") + "' " + _
                                      " And OdYy='" + ADC("OmYy") + "' And OdChr='" + ADC("OmChr") + "' And OdNo='" + CStr(ADC("OmNo")) + "'" + _
                                      " And OdSr=" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")))
      .Store "OrOdIdNo", wOrOdIdNo
      If ADC("OmTc") = "JRO" And GrdOrdDsg.Row >= 1 Then
      .Store "OrOdMstIdNo", moCn.GetFldVal("Select OdIdNo  From vwDmStkNumMaster  Where OdDmCd ='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "'" + _
          "AND MasterYN = 'Y' " + _
          " AND OdSfx='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx") + "'" + _
          " AND OdDmSz='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz") + "'" + _
          " AND OdDmStkCoCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkCoCd") + "'" + _
          " AND OdDmStkYy='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy") + "'" + _
          " AND OdDmStkChr = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr") + "'" + _
          " AND ODDmStkNo = " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkNo")))
'      Else
'      .Store "OrOdMstIdNo", wOrOdIdNo
      End If
      
    End If
    '****** Sachin 3.02 (10/09/07) ******
  End With
End Sub
Private Function GetOrRmCtgMainMetVal(pOrCS As String) As Double
  Dim wMainMetRmCtg As String
  Dim i As Integer
  
  
  Dim wLmeRt As Double
  wMainMetRmCtg = GetOrRmCtgMainMet
  If pOrCS = "S" Then
    wLmeRt = IIF(wMainMetRmCtg = "G", ADC("OmLmgSal"), _
                                     IIF(wMainMetRmCtg = "P", ADC("OmLmpSal"), _
                                     IIF(wMainMetRmCtg = "S", ADC("OmLmsSal"), _
                                     IIF(wMainMetRmCtg = "L", ADC("OmLmlSal"), 0))))
  Else
    wLmeRt = IIF(wMainMetRmCtg = "G", ADC("OmLmgCst"), _
                                     IIF(wMainMetRmCtg = "P", ADC("OmLmpCst"), _
                                     IIF(wMainMetRmCtg = "S", ADC("OmLmsCst"), _
                                     IIF(wMainMetRmCtg = "L", ADC("OmLmlCst"), 0))))
  End If
  GetOrRmCtgMainMetVal = GetGldRtForLabCdPure(ADC("OmCmCd"), wLmeRt, GetOrRmCd, 0, "", "", pOrCS, "", , ADC("OmCmCurCd"), "", "", "")

End Function
Private Function ForCpy_GetOrRmCtgMainMetVal(pOrCS As String, pMainMetRmCd As String) As Double
  Dim wMainMetRmCtg As String
  Dim i As Integer
  Dim wLmeRt As Double
  wMainMetRmCtg = Params(qOdMainMetRmCtg)
  If pOrCS = "S" Then
    wLmeRt = IIF(wMainMetRmCtg = "G", ADC("OmLmgSal"), _
                                     IIF(wMainMetRmCtg = "P", ADC("OmLmpSal"), _
                                     IIF(wMainMetRmCtg = "S", ADC("OmLmsSal"), _
                                     IIF(wMainMetRmCtg = "L", ADC("OmLmlSal"), 0))))
  Else
    wLmeRt = IIF(wMainMetRmCtg = "G", ADC("OmLmgCst"), _
                                     IIF(wMainMetRmCtg = "P", ADC("OmLmpCst"), _
                                     IIF(wMainMetRmCtg = "S", ADC("OmLmsCst"), _
                                     IIF(wMainMetRmCtg = "L", ADC("OmLmlCst"), 0))))
  End If
  ForCpy_GetOrRmCtgMainMetVal = GetGldRtForLabCdPure(ADC("OmCmCd"), wLmeRt, pMainMetRmCd, 0, "", "", pOrCS, "", , ADC("OmCmCurCd"), "", "", "")
End Function
Private Function GetOrRmCd() As String
  Dim i As Integer
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      If GrdOrdRm.Value(i, "OrMainMet") = "Y" Then
        GetOrRmCd = GrdOrdRm.Value(i, "OrRmCd")
        Exit For
      End If
    End If
  Next i

End Function
Private Function GetOrRmCtgMainMet() As String
  Dim i As Integer
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      If GrdOrdRm.Value(i, "OrMainMet") = "Y" Then
        GetOrRmCtgMainMet = GrdOrdRm.Value(i, "OrRmCtg")
        Exit For
      End If
    End If
  Next i

End Function
Private Sub GrdOrdRm_RowSave(ByVal RowNum As Integer, Cancel As Boolean, ErrMsg As String)
  If RowNum <= 0 Or RowNum > GrdOrdRm.Rows - 1 Then Exit Sub
  Cancel = ValidateStkSize(GrdOrdRm.Value(RowNum, "OrLn1"), GrdOrdRm.Value(RowNum, "OrLn2"), GrdOrdRm.Value(RowNum, "OrLn3"), ErrMsg)
  If Cancel = True Then
    If GrdOrdDsg.Row >= 1 And GrdOrdDsg.Row <= GrdOrdDsg.Rows - 1 Then
      ErrMsg = ErrMsg + ";Row OdSr/OrSrNo is:" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + "/" + CStr(GrdOrdRm.Value(RowNum, "OrSrNo"))
    End If
    Exit Sub
  End If
  
  If GrdOrdDsg.Mode = fgmnorm And GrdOrdLab.Mode = fgmnorm Then
    Dim wi_i As Integer
    With GrdOrdLab
      For wi_i = 1 To .Rows - 1
        If (.Value(wi_i, "OlMCd") = ctBrkLMCd And .Value(wi_i, "OlSCd") = ctBrkLSCd) Then
              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") / 100 * GetDCRmVal("OrSalVal")
              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") / 100 * GetDCRmVal("OrCstVal")
              .SaveRec (wi_i)
        ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC"
        ' ***** Manali 3.9.0 - ctDCHCLSCd='-' removed
        ElseIf .Value(wi_i, "OlMCd") = ctDHCLMCd Then         'And .Value(wi_i, "OlSCd") = ctDCHCLSCd
              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", "D")
              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", "D")
              .SaveRec (wi_i)
        ElseIf .Value(wi_i, "OlMCd") = ctGHCLMCd Then         'And .Value(wi_i, "OlSCd") = ctDCHCLSCd
        '

              
              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, GrdOrdLab.Value(wi_i, "OlSCd")), GetOrRmCtgMainMet(), "S")
              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, GrdOrdLab.Value(wi_i, "OlSCd")), GetOrRmCtgMainMet(), "C")
              .SaveRec (wi_i)
              
        ElseIf .Value(wi_i, "OlMCd") = ctCHCLMCd Then         'And .Value(wi_i, "OlSCd") = ctDCHCLSCd
              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", "C")
              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", "C")
              .SaveRec (wi_i)
        ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC"
        
        '************Bhavna OlMcd = 'CHN' for chain labour charges
        ElseIf .Value(wi_i, "OlMCd") = ctCBRKLMCd Then         'And .Value(wi_i, "OlSCd") = ctDCHCLSCd
                .Value(wi_i, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(wi_i, "OlMCd"), _
                                          .Value(wi_i, "OlSCd"), .Value(wi_i, "OlSalRt"), _
                                          .Value(wi_i, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcCsWt"), _
                                          .Value(wi_i, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
                .Value(wi_i, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(wi_i, "OlMCd"), _
                                          .Value(wi_i, "OlSCd"), .Value(wi_i, "OlCstRt"), _
                                          .Value(wi_i, "OlQty"), GetDCRmVal("OrWt", ctCBRKLMCd, "C"), _
                                          .Value(wi_i, "OlQw"), "C", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
              .SaveRec (wi_i)
        ElseIf .Value(wi_i, "OlMCd") = "CHN" And ADC("wChnCustYn") = "Y" Then
              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") * GetDCRmVal("OrWt", "CHN")  '**Bhavna- chain lab val = rt * chn wt
              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") * GetDCRmVal("OrWt", "CHN")
              .SaveRec (wi_i)
        '************Bhavna OlMcd = 'CHN' for chain labour charges
        
        ElseIf .Value(wi_i, "OlMCd") = ctCDWLMCd And .Value(wi_i, "OlQw") = "W" Then                     ' Diamond certification charges
'              .Value(wi_i, "OlSalVal") = .Value(wi_i, "OlSalRt") * GetDCRmVal("OrWt", ctCDWLMCd)
'              .Value(wi_i, "OlCstVal") = .Value(wi_i, "OlCstRt") * GetDCRmVal("OrWt", ctCDWLMCd)
                .Value(wi_i, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(wi_i, "OlMCd"), _
                                          .Value(wi_i, "OlSCd"), .Value(wi_i, "OlSalRt"), _
                                          .Value(wi_i, "OlQty"), GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(wi_i, "OlMCd"), .Value(wi_i, "OlSCd"))), _
                                          .Value(wi_i, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
                .Value(wi_i, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(wi_i, "OlMCd"), _
                                          .Value(wi_i, "OlSCd"), .Value(wi_i, "OlCstRt"), _
                                          .Value(wi_i, "OlQty"), GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(wi_i, "OlMCd"), .Value(wi_i, "OlSCd"))), _
                                          .Value(wi_i, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
              .SaveRec (wi_i)
        
        End If
      Next wi_i
    End With
  End If
  '*** (Jen 2.12)
End Sub
Private Sub GrdOrdRm_valid()
  '*** Call the SetGrdOrdRm sub procedure with parameter as 'S' to make some of the fields
      'of grid GrdOrdRm invisible so that the width of the grid can be reduced to show the
      'grid GrdOrdLab also.
  '*** This is done to display both the grids simultaneously
      '(Some of the fields have th be made invisible because of space constraint)

  SetGrdOrdRm "S"
  ADC("wOrCustRmCd") = ""   '4.1.0.0
End Sub
Private Sub GrdOrdlab_GotFocus()
  '*** Call the SetGrdOrdLab sub procedure with parameter as 'E' to make all the fields
      'of grid GrdOrdLab visible except the fields which were kept invisible at design time
      'This is done so that the user can see all the fields in the grid when the focus is on that grid
      'In the process of accomodating all the fields of GrdOrdLab, the grid GrdOrdRm is only partially visible
  SetGrdOrdLab "E"
  GrdOrdLab.ZOrder
  '****** Sachin 3.02.0 - Locking Add and Delete of Rows in OrdRm Grid
  ' ***** Manali Trading Module
    Dim wf_invhdmust As Boolean
    wf_invhdmust = moCn.RecSeek("Select 'x' from TcMst where TmTc = '" + ADC("omTc") + "' and TmCoCd = '" + ms_OmCoCd + "' and TmInvHdMustYn = 'Y'")
  
  If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn Or (Not mInvExists And CmdInvHd.Visible And wf_invhdmust) Then
     GrdOrdLab.AllowAdd = False: GrdOrdLab.AllowDelete = False
  Else
    Dim wf_Cancel As Boolean, wf_errmsg As String
    Call ATXT_FldChange(99, UCase("OmLockYN"), wf_Cancel, wf_errmsg, ADC("OmLockYN"))
    'GrdOrdLab.AllowAdd = True: GrdOrdLab.AllowDelete = True
  End If
  If ms_OmTcTyp = "JT" Then
    Call ChkIsJEmrMasterRecord(GrdOrdDsg.Row, wf_Cancel, wf_errmsg)
    If wf_Cancel Then
      Call DispMsg(wf_errmsg, etError)
      GrdOrdLab.AllowAdd = False: GrdOrdLab.AllowDelete = False
    Else
      GrdOrdLab.AllowAdd = True: GrdOrdLab.AllowDelete = True
    End If
  End If
End Sub
Private Sub GrdOrdLab_RowWhen(ByVal RowNum As Integer)
  '*** If GrdOrdLab.IsNew Then OlSrNo= Max + 1
  With GrdOrdLab
    If .Value(RowNum, "OlSrNo") = 0 Then _
       .Value(RowNum, "OlSrNo") = .MaxVal("OlSrNo") + 1
    If .IsNew(RowNum) Then .Value(RowNum, "OlPrtKey") = ctCurrPrtn   '****** Sachin 3.02 Default value for Partition Key field
  End With
End Sub
Private Sub GrdOrdLab_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  '*** Set Helps For Each Field
  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdLab.Value(RowNum, "OlPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub
  
'  If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub

'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If

  Call ChkIsJEmrMasterRecord(GrdOrdDsg.Row, Cancel, ErrMsg)
  If Cancel = True Then Exit Sub
  
  Select Case UCase(ColName)
  Case Is = UCase("OlMCd")
    Call HlpList.PMCd("LABMCD")
  Case Is = UCase("OlSCd")
    Call HlpList.PSCd("LABSCD", GrdOrdLab.Value(RowNum, "OlMCd"))
  Case Is = UCase("OlQw")
    '*** (Jen 2.12)
    ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC" added
    ' ***** Manali 3.9.0 - ctDCHCLSCd='-' removed
    '6.1-35 GrdOrdLab.Value(RowNum, "OlMCd") = ctCDWLMCd removed to edit QW
    If (GrdOrdLab.Value(RowNum, "OlMCd") = ctCDWLMCd And GrdOrdLab.Value(RowNum, "OlMCd") = ctBrkLMCd And GrdOrdLab.Value(RowNum, "OlSCd") = ctBrkLSCd) Or _
      ((GrdOrdLab.Value(RowNum, "OlMCd") = ctDHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctGHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCBRKLMCd _
      )) Then         ''''And GrdOrdLab.Value(RowNum, "OlSCd") = ctDCHCLSCd
        Cancel = True: ErrMsg = "Cannot Edit Labour Q/W For '" & GrdOrdLab.Value(RowNum, "OlMCd") + "'": Exit Sub
    '*** (Jen 3.2.0)
    ElseIf GrdOrdLab.Value(RowNum, "OlSalRt") < 0 Then
      Cancel = True: ErrMsg = "Cannot Edit Labour Q/W When Labour Sale Rate Is Negative": Exit Sub
    ElseIf GrdOrdLab.Value(RowNum, "OlMCd") = "CHN" And ADC("wChnCustYn") = "Y" Then
        GrdOrdLab.Value(RowNum, "OlQw") = "W"
        Cancel = True: ErrMsg = "Cannot Edit Labour Q/W For 'CHN'": Exit Sub
    '*** (Jen 3.2.0)
    End If
    '*** (Jen 2.12)
    
    Call HlpList.PMCd("LABQW")
  Case Is = UCase("OlCstQw")
    Call HlpList.PMCd("LABQW")
  Case Is = UCase("OlQty")
    '*** (Jen 2.12)
    ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC" added
    ' ***** Manali 3.9.0 - ctDCHCLSCd='-' removed
    If (GrdOrdLab.Value(RowNum, "OlMCd") = ctBrkLMCd And GrdOrdLab.Value(RowNum, "OlSCd") = ctBrkLSCd) Or _
      ((GrdOrdLab.Value(RowNum, "OlMCd") = ctDHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctGHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCBRKLMCd)) Then            '''''And GrdOrdLab.Value(RowNum, "OlSCd") = ctDCHCLSCd
        Cancel = True: ErrMsg = "Cannot Edit Labour Quantity For '" & GrdOrdLab.Value(RowNum, "OlMCd") + "'": Exit Sub
    End If
    '*** (Jen 2.12)
  Case Is = UCase("OlSalVal")
    '*** (Jen 2.12)
    ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC" added
    ' ***** Manali 3.9.0 - ctDCHCLSCd='-' removed
    If (GrdOrdLab.Value(RowNum, "OlMCd") = ctBrkLMCd And GrdOrdLab.Value(RowNum, "OlSCd") = ctBrkLSCd) Or _
       ((GrdOrdLab.Value(RowNum, "OlMCd") = ctDHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctGHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCHCLMCd Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCBRKLMCd _
        Or GrdOrdLab.Value(RowNum, "OlMCd") = ctCDWLMCd)) Then          ''''' And GrdOrdLab.Value(RowNum, "OlSCd") = ctDCHCLSCd
          Cancel = True: ErrMsg = "Cannot Edit Labour Value For '" & GrdOrdLab.Value(RowNum, "OlMCd") + "'": Exit Sub
    End If
    '*** (Jen 2.12)
  

'    If GrdOrdLab.Value(RowNum, "OlQw") = "W" Then _
'       Cancel = True: ErrMsg = "Cannot Enter Labour Quantity": Exit Sub
  End Select
End Sub
Private Sub GrdOrdLab_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  '***/r OlQw on OlMCd,OlSCd               Normal,Copy
      'PValue('LABSCD', OlMCd, OlSCd)
  '***/r OlCstQw on OlMCd,OlSCd            Normal,Copy
      'PValue('LABSCD', OlMCd, OlSCd)
  '***/r OlSalRt on OmCmCd,OlMCd,OlSCd     Normal,Copy
      'Check if Labour Sales Rates exists in LabRt for LrMCd= OlMCd, LrSCd= OlSCd
      '   for the specified customer.
      'If Not, Check if Labour Sales Rates exists in LabRt for LrMCd= OlMCd, LrSCd= OlSCd
      '   for customer= 'ZSELF'.
  '***/r OlSalVal on OmCmCd,OlMCd,OlSCd,OlSalRt,OlQty,OdGldAsWt,OlQw           Normal,Copy
      'GetLabVal(OmCmCd, OlMCd, OlSCd, OlSalRt, OlQty, OdGldAsWt, OlQw, 'S')
      'In the Change Event Of OdGldAsWt, recalc of OlSalVal takes place
  '***/r OlCstRt on OmCmCd,OlMCd,OlSCd     Normal,Copy
      'Similar to OlSalRt except that here the Cost Rate is calculated instead of the Sale rate
  '***/r OlCstVal on OmCmCd,OlMCd,OlSCd,OlCstRt,OlQty,OdGldAsWt,OlCstQw           Normal,Copy
      ''Similar to OlSalVal except that here the Cost Value is calculated instead of the Sale Value
  
   Dim wLabAsStr As String
           Dim wCstLabAsWt As Single
          
  With GrdOrdLab
    Select Case ColName

'*** Jay 2.14 ***
'      Case Is = UCase("OlQw")
'        'urmi 2.06 LabRt
'        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False) Then
'         If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
'            .Value(RowNum, "OlQw") = moCn.GetFldVal("Select PValue from Param " + _
'                                "where PTyp='LABSCD' and PMCd= '" + _
'                                .Value(RowNum, "OlMCd") + "' and " + _
'                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")
'        End If
'      Case Is = UCase("OlCstQw")
'        'urmi 2.06 LabRt
'        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False) Then
'         If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
'            .Value(RowNum, "OlCstQw") = moCn.GetFldVal("Select PValue from Param " + _
'                                "where PTyp='LABSCD' and PMCd= '" + _
'                                .Value(RowNum, "OlMCd") + "' and " + _
'                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")
'        End If
'*** Jay 2.14 ***

'      Case Is = UCase("OlQty")
'        If (.Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False)) Then
'          If .Value(RowNum, "OlQw") = "W" Then .Value(RowNum, "OlQty") = 0
'        End If
      Case Is = UCase("OlSalRt")
        Dim wOlQw As String
        Dim wLabAsWt As Single      ' ***** Manali 3.5.0 - DHC and CHC introduced
        wOlQw = ""
        
        'urmi 2.06 LabRt
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False) Then
        If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
        
          '*** (Jen 3.2.0)
          If .Value(RowNum, "OlSalRt") < 0 And UCase(SourceColName) <> UCase("OlMCd") And _
             UCase(SourceColName) <> UCase("OlSCd") And .Value(RowNum, "OlQw") = "Q" Then Exit Sub
          '*** (Jen 3.2.0)
          
          If .Value(RowNum, "OlMCd") = ctDHCLMCd Then
            wLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcDiaWt")
          ElseIf .Value(RowNum, "OlMCd") = ctGHCLMCd Then
            wLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcDiaWt")
            
          ElseIf .Value(RowNum, "OlMCd") = ctCHCLMCd Then
            wLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcCSWt")
           ElseIf .Value(RowNum, "OlMCd") = ctCBRKLMCd Then
            wLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcCSWt")
               ElseIf .Value(RowNum, "OlMCd") = ctCBRKLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                .Value(RowNum, "OlMCd") + "' and " + _
                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")) = "W" Then
            wLabAsWt = GetDCRmVal("OrWt", "C")
            
          ElseIf .Value(RowNum, "OlMCd") = ctCBRKLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                .Value(RowNum, "OlMCd") + "' and " + _
                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")) = "Q" Then
            wLabAsWt = 0#
       
      
          ElseIf .Value(RowNum, "OlMCd") = ctCDWLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                .Value(RowNum, "OlMCd") + "' and " + _
                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")) = "W" Then
            wLabAsWt = GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(RowNum, "OlMCd"), .Value(RowNum, "OlSCd")))
            
          ElseIf .Value(RowNum, "OlMCd") = ctCDWLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                .Value(RowNum, "OlMCd") + "' and " + _
                                "PSCd='" + .Value(RowNum, "OlSCd") + "'")) = "Q" Then
            wLabAsWt = 0#
          Else
          'srichange
            wLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAsWt")
          End If
          
          ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpLabRt") passed as parameter if not blank
          ' ***** Manali 3.5.0
          ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
          .Value(RowNum, "OlSalRt") = GetLabRt(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                      .Value(RowNum, "OlSCd"), "S", _
                                      wLabAsWt, ADC("OmCmCtg"), wOlQw, , , ADC("OmCmCurCd"), _
                                      IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
          
''          .Value(RowNum, "OlSalRt") = GetLabRt(adc("OmCmCd"), .Value(RowNum, "OlMCd"), _
''                                      .Value(RowNum, "OlSCd"), "S", _
''                                      GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAsWt"), "C", wOlQw, , , adc("OmCmCurCd"), _
''                                      IIF(adc("OmLkUpLabRt") <> "", adc("OmLkUpLabRt"), ""))
           '.Value(RowNum, "OlSalRt") = GetLabRt(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                      .Value(RowNum, "OlSCd"), "S", _
                                      GrdOrdDsg.Value(GrdOrdDsg.Row, "OdGldAsWt"), wOlQw)
          If wOlQw <> "" Then
            .Value(RowNum, "OlQw") = wOlQw
          '*** Jay 2.14 ***
          Else
            .Value(RowNum, "OlQw") = moCn.GetFldVal("select PValue from Param where PTyp= 'LABSCD' and PMCd= '" + .Value(RowNum, "OlMCd") + "' and PSCd= '" + .Value(RowNum, "OlSCd") + "'")
          End If
          If .Value(RowNum, "OlQty") = 0 Or .Value(RowNum, "OlMCd") = ctBrkLMCd Or .Value(RowNum, "OlMCd") = ctDHCLMCd _
              Or .Value(RowNum, "OlMCd") = ctGHCLMCd Or .Value(RowNum, "OlMCd") = ctCHCLMCd Or .Value(RowNum, "OlMCd") = ctCBRKLMCd Or .Value(RowNum, "OlMCd") = ctCDWLMCd Then .Value(RowNum, "OlQty") = 1
        End If
      Case Is = UCase("OlSalVal")
        If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyLabRate = False Or mf_CpyVal = False)) Then
          If .Value(RowNum, "OlMCd") = ctBrkLMCd Then
             .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") / 100 * GetDCRmVal("OrSalVal")
          ElseIf .Value(RowNum, "OlMCd") = ctDHCLMCd Then
             .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", "D")
          ElseIf .Value(RowNum, "OlMCd") = ctGHCLMCd Then
             .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, GrdOrdLab.Value(RowNum, "OlSCd")), GetOrRmCtgMainMet(), "S")
          ElseIf .Value(RowNum, "OlMCd") = ctCHCLMCd Then
             .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") / 100 * GetDCRmVal("OrSalVal", "C")
          ElseIf .Value(RowNum, "OlMCd") = ctCBRKLMCd Then
 '            .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") / 100 * GetDCRmVal("OrWt", "C")
           .Value(RowNum, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlSalRt"), _
                                          .Value(RowNum, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcCSWt"), _
                                          .Value(RowNum, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
  
          
          ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC"
          ElseIf .Value(RowNum, "OlMCd") = ctCDWLMCd And .Value(RowNum, "OlQw") = "W" Then                     ' Diamond certification charges
'              .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") * GetDCRmVal("OrWt", ctCDWLMCd)
            .Value(RowNum, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlSalRt"), _
                                          .Value(RowNum, "OlQty"), GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(RowNum, "OlMCd"), .Value(RowNum, "OlSCd"))), _
                                          .Value(RowNum, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
           
          '**********Bhavna added chain labour value
          ElseIf .Value(RowNum, "OlMCd") = "CHN" And ADC("wChnCustYn") = "Y" Then
             .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") * GetDCRmVal("OrWt", "CHN")
          '**********Bhavna added chain labour value
          
          ElseIf .Value(RowNum, "OlSalRt") < 0 Then
            .Value(RowNum, "OlSalVal") = .Value(RowNum, "OlSalRt") * .Value(RowNum, "OlQty")
          '*** (Jen 3.2.0)
          Else
              ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpLabRt") passed as parameter if not blank
              ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
             .Value(RowNum, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlSalRt"), _
                                          .Value(RowNum, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAsWt"), _
                                          .Value(RowNum, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
          End If
        End If
        '*** (Jen 2.12)
        
        '*** (Bef 2.12)
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
        '     .Value(RowNum, "OlSalVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
        '                                  .Value(RowNum, "OlSCd"), .Value(RowNum, "OlSalRt"), _
        '                                  .Value(RowNum, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdGldAsWt"), _
        '                                  .Value(RowNum, "OlQw"), "S", "C")
        'End If
        '*** (Bef 2.12)
      Case Is = UCase("OlCstRt")
        Dim wOlCstQw As String
        wOlCstQw = ""
        'urmi 2.06 LabRt
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False) Then
        
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        
        If .Mode = fgmnorm Or .Mode = fgmCopy Then
          '  wLabAsStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                                                "PTyp='GLDAS' and PMCd = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAs") + "'") + ","
          ' wCstLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAsWt")
            'If InStr(1, wLabAsStr, ",D,") <> 0 Or InStr(1, wLabAsStr, ",C,") <> 0 Or InStr(1, wLabAsStr, ",X,") <> 0 Then
           wCstLabAsWt = GetCstLabAsWt(GrdOrdDsg.Row)
              
              ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
             .Value(RowNum, "OlCstRt") = GetLabRt(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                         .Value(RowNum, "OlSCd"), "C", _
                                         wCstLabAsWt, ADC("OmCmCtg"), wOlCstQw, , , ADC("OmCmCurCd"))
          '*** jay 2.14 ***
          'If wOlCstQw <> "" Then .Value(RowNum, "OlCstQw") = wOlCstQw
          If wOlCstQw <> "" Then
            .Value(RowNum, "OlCstQw") = wOlCstQw
          Else
            .Value(RowNum, "OlCstQw") = moCn.GetFldVal("select PValue from Param where PTyp= 'LABSCD' and PMCd= '" + .Value(RowNum, "OlMCd") + "' and PSCd= '" + .Value(RowNum, "OlSCd") + "'")
          End If
          '*** jay 2.14 ***

          If .Value(RowNum, "OlQty") = 0 Then .Value(RowNum, "OlQty") = 1
        End If
      Case Is = UCase("OlCstVal")
      
        '*** (Jen 2.12)
        '*** (Bef 2.13)
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
        '*** (Bef 2.13)
        
        '*** (Jen 2.13)
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyLabRate = False Or mf_CpyVal = False)) Then
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        '*** (Jen 2.13)
        
        ' ***** Manali 3.03 - Cst Rt/Val always from Current
        If .Mode = fgmnorm Or .Mode = fgmCopy Then
          If .Value(RowNum, "OlMCd") = ctBrkLMCd Then
             .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") / 100 * GetDCRmVal("OrCstVal")
          ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC"
          ElseIf .Value(RowNum, "OlMCd") = ctDHCLMCd Then
             .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", "D")
          ElseIf .Value(RowNum, "OlMCd") = ctGHCLMCd Then
             .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, GrdOrdLab.Value(RowNum, "OlSCd")), GetOrRmCtgMainMet(), "C")
          ElseIf .Value(RowNum, "OlMCd") = ctCHCLMCd Then
             .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") / 100 * GetDCRmVal("OrCstVal", "C")
          ElseIf .Value(RowNum, "OlMCd") = ctCBRKLMCd Then
            .Value(RowNum, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlCstRt"), _
                                          .Value(RowNum, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdPerPcCsWt"), _
                                          .Value(RowNum, "OlQw"), "C", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
'
          ' ****** Manali 3.5.0 - 16/05/09 - "DHC" and "CHC"
          ElseIf .Value(RowNum, "OlMCd") = ctCDWLMCd And .Value(RowNum, "OlQw") = "W" Then
            .Value(RowNum, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlCstRt"), _
                                          .Value(RowNum, "OlQty"), GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(.Value(RowNum, "OlMCd"), .Value(RowNum, "OlSCd"))), _
                                          .Value(RowNum, "OlQw"), "C", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
'            .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") * GetDCRmVal("OrWt", ctCDWLMCd)
            
          '**************Bhavna added chain labour value
          ElseIf .Value(RowNum, "OlMCd") = "CHN" And ADC("wChnCustYn") = "Y" Then
             .Value(RowNum, "OlCstVal") = .Value(RowNum, "OlCstRt") * GetDCRmVal("OrWt", "CHN")
          '**************Bhavna added chain labour value
          
          Else
            'wLabAsStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
            '                                    "PTyp='GLDAS' and PMCd = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAs") + "'") + ","
            wCstLabAsWt = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdLabAsWt")
            If InStr(1, wLabAsStr, ",D,") <> 0 Or InStr(1, wLabAsStr, ",C,") <> 0 Or InStr(1, wLabAsStr, ",X,") <> 0 Then wCstLabAsWt = GetCstLabAsWt(GrdOrdDsg.Row)
              ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
             .Value(RowNum, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
                                          .Value(RowNum, "OlSCd"), .Value(RowNum, "OlCstRt"), _
                                          .Value(RowNum, "OlQty"), wCstLabAsWt, _
                                          .Value(RowNum, "OlCstQw"), "C", ADC("OmCmCtg"), ADC("OmCmCurCd"))
          End If
        End If
        '*** (Jen 2.12)
      
      
        '$$$ In the Change Event Of OdGldAsWt, recalc of OlCstVal takes place
        'urmi 2.06 LabRt
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyRate = False) Then
        '*** (Bef 2.12)
        'If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
        '     .Value(RowNum, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(RowNum, "OlMCd"), _
        '                                  .Value(RowNum, "OlSCd"), .Value(RowNum, "OlCstRt"), _
        '                                  .Value(RowNum, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdGldAsWt"), _
        '                                  .Value(RowNum, "OlCstQw"), "C", "C")
        'End If
        '*** (Bef 2.12)
    End Select
  End With
End Sub
Private Sub GrdOrdLab_ColChange(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  '*** OlMCd            valid PMCd('LABMCD')
  '*** OlSCd            valid PSCd('LABSCD', OlMCd) or ''
  
  With GrdOrdLab
    Select Case ColName
    Case Is = UCase("OlMCd")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'LABMCD' And PMCd = '" + NewValue + "'")
      ErrMsg = "Invalid Labour Main Code": Exit Sub
    Case Is = UCase("OlSCd")
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select PSCd From Param Where " + _
                "PTyp= 'LABSCD' And PMCd='" + .Value(RowNum, "OlMCd") + "' " + _
                "And PSCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Labour Sub Code": Exit Sub
    
    '*** (Jen 3.2.0)
    Case Is = UCase("OlSalRt")
      If NewValue < 0 Then .Value(RowNum, "OlQw") = "Q"
      '.Value(RowNum, "OlQty") = 1
    '*** (Jen 3.2.0)
    
    Case Is = UCase("OlQw"), UCase("OlCstQw")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'LABQW' And PMCd = '" + NewValue + "'")
      ErrMsg = "Invalid Labour QW": Exit Sub
    End Select
  End With
End Sub
Private Sub GrdOrdLab_InitKey(ByVal RowNum As Integer)
