            End If
            
            .Value(wi_LabRow, "OlPrtKey") = ADC("OmPrtKey")   '****** Sachin 3.02 - Partition Key value
  ' ########################  Manoj #### Ver: 2.0.6 #### Date: 26/04/2004  ########################
  '          .SaveRec (wi_LabRow)
            If .SaveRec(wi_LabRow) = False Then
              'Manoj 2.10.0
  '            moCn.Execute ("Delete From OrdLab Where OlCoCd ='" + ms_OmCoCd + "' And " + _
  '                          " OlTc = '" + adc("OmTc") + "' And OlYy = '" + adc("OmYy") + "' And " + _
  '                          " OlChr = '" + adc("OmChr") + "' And OlNo = " + CStr(adc("OmNo")) + " And " + _
  '                          " OlSr = " + CStr(GrdOrdDsg.Value(wi_OdRow, "OdSr")))
