        '33 Subremark & size instruction added as 23 & 24th column
        '49 Karat, Gram min&max wt, Dia min&max tolerance added as 25,26,27,28,29th column
       If wErrMsg = "" Then _
        moCn.Execute ("Insert Into #TmpXls Values (" + CStr(i) + "," + ReadCell(ADC("WXLSHTNO"), i, 1) + ",'" + ReadCell(ADC("WXLSHTNO"), i, 2) + "','" + _
                        ReadCell(ADC("WXLSHTNO"), i, 3) + "','" + ReadCell(ADC("WXLSHTNO"), i, 4) + "','" + ReadCell(ADC("WXLSHTNO"), i, 5) + "'," + _
                        ReadCell(ADC("WXLSHTNO"), i, 6) + "," + ReadCell(ADC("WXLSHTNO"), i, 7) + ", '" + ReadCell(ADC("WXLSHTNO"), i, 8) + "', '" + _
