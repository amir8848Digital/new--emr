                        "'," + ReadCell(ADC("WXLSHTNO"), i, 13) + "," + _
                        "'" + IIF(ReadCell(ADC("WXLSHTNO"), i, 14) = "", "01/01/80", ReadCell(ADC("WXLSHTNO"), i, 14)) + "','" + _
                        IIF(ReadCell(ADC("WXLSHTNO"), i, 15) = "", "01/01/80", ReadCell(ADC("WXLSHTNO"), i, 15)) + "','" + _
