    Set wRs_DsgStk = moCn.OpenRes("Select IsNull(OdTc+'/'+OdYy+'/'+OdChr+'/'+LTrim(Str(OdNo))+'/'+LTrim(Str(OdSr)),'') as qSrcVch, Max(OdOmDt) as OdOmDt, DLoc, DDmCd, DOdSfx, DDmSz, DDmStkCoCd, DDmStkYy, DDmStkChr, DDmStkNo,isnull(max(OdSubCust),'') as OdSubCust, isnull(max(OdPoNo),'') as OdPoNo," + _
                                "(Case when Max(IsNull(qOdQty,0))<>0 and Max(IsNull(qOdQty,0))<Convert(Decimal(14,1),Sum(DDmDrQty-DDmCrQty)) " + _
                                " Then Max(IsNull(qOdQty,0))  Else  Convert(Decimal(14,1),Sum(DDmDrQty-DDmCrQty)) End ) as qStkQty, 0.0 as OdSalPrc, " + _
                                "IsNull((Select Top 1 Sum(OrWt/ (Case When OrRmCtg In ('D', 'C') Then 5 Else 1 End)) " + _
                                "From OrdRm " + _
                                "Join OrdDsg Od1 On Od1.OdCoCd=OrCoCd and Od1.OdTc=OrTc and Od1.OdYy=OrYy and Od1.OdChr=OrChr  and Od1.OdNo=OrNo and Od1.OdSr=OrSr " + _
                                "Where Od1.OdCoCd=DCoCd and Od1.OdDmCd=DDmCd and Od1.OdSfx=DOdSfx and Od1.OdDmSz=DDmSz and Od1.OdDmStkCoCd=DDmStkCoCd and Od1.OdDmStkYy=DDmStkYy and Od1.OdDmStkChr =DDmStkChr and Od1.OdDmStkNo=DDmStkNo " + _
