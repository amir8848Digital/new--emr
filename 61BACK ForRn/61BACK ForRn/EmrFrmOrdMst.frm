              wFldValues(12, 1) = wrs_ShowDsgStk!qOdDmStkYy
              wFldValues(13, 1) = wrs_ShowDsgStk!qOdDmStkChr
              wFldValues(14, 1) = wrs_ShowDsgStk!qOdDmStkNo
              wFldValues(15, 1) = -1 'qSrcBaseOdIdNo
              wFldValues(16, 1) = wrs_ShowDsgStk!qOdOmDt
              wFldValues(17, 1) = wrs_ShowDsgStk!qCpyFrVch
              wFldValues(18, 1) = wrs_ShowDsgStk!qOdPoNo
              wFldValues(19, 1) = wrs_ShowDsgStk!qOdSubCust
              wFldValues(20, 1) = wrs_ShowDsgStk!qGrsWt
              wFldValues(21, 1) = "" 'qSrcBaseVch
              wFldValues(22, 1) = "" 'qSrcBaseVchCoCd
              wFldValues(23, 1) = wrs_ShowDsgStk!qStkMasterVchSrt
