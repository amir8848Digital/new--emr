Private Sub CmdRefDiaAvlDtGo_Click()
'    DispMsg "RefDiaAvlDtGo", etError
If ADC("wRdOrdSrFr") = 0 And ADC("wRdOrdSrTo") = 0 And ADC("wRdOrdSrSel") = "" Then DispMsg "Enter Ord Sr No. Scope to Refresh Dates", etError: Exit Sub
If ADC("wRdOrdSrTo") < ADC("wRdOrdSrFr") Then DispMsg "Enter Ord Sr To >= Ord Sr Fr", etError: Exit Sub

If ADC("wRDWsDiaAvlDt") = "" Or _
    ADC("wRDHsDiaAvlDt") = "" Then _
    DispMsg "Dia Avl Dates Cannot Be Blank", etError: Exit Sub
Dim wi_x As Integer, wi_FrSr As Integer, wi_ToSr As Integer, wmsgstr As String
wmsgstr = "Replaced Dates In Sr."
wi_FrSr = IIF(ADC("wRDOrdSrFr") <> 0, ADC("wRDOrdSrFr"), 1)
wi_ToSr = IIF(ADC("wRDOrdSrTo") <> 0, ADC("WRDOrdSrTO"), GrdOrdDsg.Rows - 1)

  For wi_x = wi_FrSr To wi_ToSr
    GrdOrdDsg.Row = wi_x
    If GrdOrdDsg.Value(wi_x, "OdPrtKey") = ctCurrPrtn And (ADC("wRDOrdSrSel") = "" Or InStr(1, "," + ADC("wRDOrdSrSel") + ",", "," + CStr(wi_x) + ",") > 0) Then
      If (ADC("wRDWSDiaAvlDt") <> "01/01/80") Then
        GrdOrdDsg.Value(wi_x, "OdWDiaAvlblDt") = ADC("wRDWSDiaAvlDt")
      End If
      If (ADC("wRDHSDiaAvlDt") <> "01/01/80") Then
          GrdOrdDsg.Value(wi_x, "OdHDiaAvlblDt") = ADC("wRDHSDiaAvlDt")
      End If
      'sv.78 if finding avalbl dt is given then update to OrdDsg grid
      If (ADC("wRDFndAvlDt") <> "01/01/80") Then
        GrdOrdDsg.Value(wi_x, "OdFndAvlblDt") = ADC("wRDFndAvlDt")
      End If
      wmsgstr = wmsgstr + CStr(wi_x) + ","
    End If
    'IG.204- it will save each updated record in OrdDsg grid
    GrdOrdDsg.SaveRec (wi_x)
  Next wi_x
  DispMsg wmsgstr, etInfo
  
  Call DispFra(RefDiaAvlDt)
End Sub
