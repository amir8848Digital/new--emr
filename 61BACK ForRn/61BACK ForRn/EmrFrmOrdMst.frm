Private Sub SetParamsVal(pv_Val As Variant, ps_Name As Integer)
  Dim ws_Mask As String
  pv_Val = LTrim(RTrim(pv_Val))
  
  ws_Mask = SetMask(ps_Name)
  If Mid(ws_Mask, 1, 1) = "-" Then
      ws_Mask = Mid(ws_Mask, 2)
  End If
  If ws_Mask <> "" Then
      pv_Val = Format(pv_Val, ws_Mask)
  End If
  m_ObjCmd.QryParameters(ps_Name) = pv_Val
End Sub
