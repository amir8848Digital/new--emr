Private Function CpyRepairDiff(ByVal pv_rsSrcOd As MDORowSet) As String
  Dim ws_AlyCdStr As String
  If mf_CpyFrSameCust = True Then
    ws_AlyCdStr = " OrAlyCd "
  Else
    If mf_CpyRate = True Then
      ws_AlyCdStr = " Case When '" + "," + ms_CpyRateOpt + "," + "' Like '%,' + OrRmCtg + ',%' Then OrAlyCd Else isNull(CaAlyCd, OrAlyCd) End "
    Else
      ws_AlyCdStr = " isNull(CaAlyCd, OrAlyCd) "
    End If
  End If
  
  CpyRepairDiff = "Select OrSrNo as qSrNo,OrRmCtg as qRmCtg, OrRmSCtg as qRmSCtg ,OrRmCd as qRmCd,OrRmCtg as qRmOldCtg," + _
                  "OrRmSCtg as qRmOldSCtg, OrRmCd as qRmOldCd, 0 as qStkRt, OrLn1 as qLn1, OrLn2 as qLn2,OrLn3 as qLn3," + _
                  "OrQty as qQty, OrRmPtr as qRmPtr, OrWt as qWt, 0 as qXtraWt, OrPrdQty as qPrdQty,OrPrdWt as qPrdWt," + _
                  "OrSetSCd as qSetSCd,OrWsQty as qWsQty, OrHsQty as qHsQty, OrSubShp as qSubShp, " + ws_AlyCdStr + " as qAlyCd," + _
                  "OrMainMet As qMainMet, OrLmeSal, OrSalRt, OrCstRt, OrSalVal, OrCstVal,OrSetSalRt, OrSetCstRt, " + _
                  "OrSetSalVal, OrSetCstVal, OrAlySalRt,OrAlyCstRt , OrLotNo From OrdRm " + _
                  "Join OrdMst on OrCoCd=OmCoCd and OrTc=OmTc and OrYy=OmYy and OrChr=OmChr and OrNo= OmNo and OrPrtKey=OmPrtKey " + _
                  "Join OrdDsg on OdCoCd=OrCoCd and OdTc=OrTc and OdYy=OrYy and OdChr=OrChr and OdNo= OrNo and OdSr =OrSr and OdPrtKey=OrPrtKey " + _
                  "Join RmMst On RmCd= OrRmCd and RmPrtKey =OrPrtKey " + _
                  "Left outer join CustAly on CaCtg= '" + ADC("OmCmCtg") + "' and CaCd= '" + ADC("OmCmCd") + "' " + _
                  "and CaRmCd= OrRmCd and CaDmCol= '" + pv_rsSrcOd!OdDmCol + "' " + _
                  "where OrCoCd= '" + pv_rsSrcOd!OdCoCd + "' and OrTc='" + pv_rsSrcOd!OdTc + "' and OrYy='" + pv_rsSrcOd!OdYy + _
                  "' and OrChr='" + pv_rsSrcOd!OdChr + "' and OrNo=" + CStr(pv_rsSrcOd!OdNo) + _
                  " and OrSr=" + CStr(pv_rsSrcOd!OdSr) + " Order By OrSrNo "

End Function




