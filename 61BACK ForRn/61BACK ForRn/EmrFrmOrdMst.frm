  End With
  GrdDsgStk.EndCopy
  GrdDsgStk.AllowAdd = False
  Set wRs_DsgStk = Nothing
  ms_CpySrcStk = ADC("wDsCpyFrYn")
 
 
End Sub
Private Sub ShowDsgStkAutoMap(pv_ShowDsgStk As MDORowSet)
  Dim wv_DmStkNumInStock As New Dictionary
  Dim wBalQtyToMap As Long
  Dim wCurRowBaseOdIdNo As Long
  wCurRowBaseOdIdNo = 0
  Dim wrs_ShowDsgStk As MDORowSet
  Set wrs_ShowDsgStk = pv_ShowDsgStk
  'wrs_ShowDsgStk
  Do While Not (wrs_ShowDsgStk.EOF Or wrs_ShowDsgStk.BOF)
  
    If wrs_ShowDsgStk!qSrcBaseOdIdNo = -1 Then GoTo NextRow
    If wCurRowBaseOdIdNo <> wrs_ShowDsgStk!qSrcBaseOdIdNo Then
      wBalQtyToMap = wrs_ShowDsgStk!qSrcVchBalQty
      wCurRowBaseOdIdNo = wrs_ShowDsgStk!qSrcBaseOdIdNo
    End If
    If wrs_ShowDsgStk!qOdDmStkNo = 20949 Then
        Dim EG As String
        EG = "L"
    End If
    If Not wv_DmStkNumInStock.Exists(wrs_ShowDsgStk!qStkDmIdNo) Then
      wv_DmStkNumInStock.Add wrs_ShowDsgStk!qStkDmIdNo, wrs_ShowDsgStk!qStkQty
    End If

    If wBalQtyToMap = 0 Then
        wrs_ShowDsgStk.edit
        wrs_ShowDsgStk!qTargetVchQty = 0
        wrs_ShowDsgStk.Update
        'Delete
    Else
'      If Not wv_DmStkNumInStock.Exists(wrs_ShowDsgStk!qStkDmIdNo) Then
 '       wv_DmStkNumInStock.Add wrs_ShowDsgStk!qStkDmIdNo, wrs_ShowDsgStk!qStkQty
  '    End If
      wrs_ShowDsgStk.edit
      wrs_ShowDsgStk!qTargetVchQty = IIF(wBalQtyToMap > wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo), wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo), wBalQtyToMap)
      wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo) = wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo) - wrs_ShowDsgStk!qTargetVchQty
      wBalQtyToMap = wBalQtyToMap - wrs_ShowDsgStk!qTargetVchQty
      wrs_ShowDsgStk.Update
    End If
NextRow:
  wrs_ShowDsgStk.MoveNext
  Loop
'
  Dim wCurrPos As Variant
  Dim wFldValues(27, 1) As Variant
  If ADC("WDSCPYNOBASE") = "Y" Then
    wrs_ShowDsgStk.MoveFirst
    Do While Not (wrs_ShowDsgStk.EOF Or wrs_ShowDsgStk.BOF)
      If wrs_ShowDsgStk!qOdDmStkNo = 20949 Then
        Dim EM As String
          EM = "hf"
      End If
      If wrs_ShowDsgStk!qSrcBaseOdIdNo = -1 Then
      Else
        If wrs_ShowDsgStk!qSrcBaseOdIdNo > 0 Then
          If wv_DmStkNumInStock.Exists(wrs_ShowDsgStk!qStkDmIdNo) Then
            If wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo) <> 0 Then
              wFldValues(0, 1) = wrs_ShowDsgStk!qSrcBaseOdIdNo
              wFldValues(1, 1) = wrs_ShowDsgStk!qStkDmIdNo
              wFldValues(2, 1) = wrs_ShowDsgStk!qStkMasterVch
              wFldValues(3, 1) = "" 'qSrcVch
              wFldValues(4, 1) = wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo) 'qStkQty
              wFldValues(5, 1) = 0 'qSrcVchBalQty
              wFldValues(6, 1) = wv_DmStkNumInStock(wrs_ShowDsgStk!qStkDmIdNo) 'qTargetVchQty
              wFldValues(7, 1) = wrs_ShowDsgStk!qTargetVchOdSalPrc '!qTargetVchOdSalPrc
              wFldValues(8, 1) = wrs_ShowDsgStk!qOdDmCd
              wFldValues(9, 1) = wrs_ShowDsgStk!qOdDmSz
              wFldValues(10, 1) = wrs_ShowDsgStk!qOdSfx
