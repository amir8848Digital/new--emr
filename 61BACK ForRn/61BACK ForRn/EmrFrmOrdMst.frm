'6.1_36 checking Production sequence, WsQty and Hsqty link
Private Sub ShowMsgForWsHsPrdSeqUpd(ByVal pOdSr As String, Optional ByVal pPrdSeq As String, _
Optional ByVal pOrSrNo As Integer, Optional ByVal pWsQty As Double, Optional ByVal pHsQty As Double _
, Optional ByVal pChkAllOdSr As String)
Dim wsPrdSeq As String, wWsCnt As Integer, wHsCnt As Integer
Dim wWsQty As Integer, wHsQty As Integer
Dim wOdSrArr() As String, i As Integer, wWsErrSr As String, wHsErrSr As String
Dim Cancel As Boolean, wWsErrMsg As String, wHsErrMsg As String
'store production sequence
wsPrdSeq = IIF(pPrdSeq <> "", pPrdSeq, "")
'splitting odsr serials from adc_nonkey valid and each row
If pChkAllOdSr <> "" Then
  wOdSrArr = Split(pChkAllOdSr, ",")
Else
  wOdSrArr = Split(pOdSr, ",")
End If
  
If IsArray(wOdSrArr) Then
  For i = 0 To UBound(wOdSrArr)
    'getting procduction sequence for nonkey valid( odsr serials)
    If pChkAllOdSr <> "" Then
      wsPrdSeq = moCn.GetFldVal("select OdPrdSeq From OrdDsg " + _
                  "where OdCoCd='" + ms_OmCoCd + "' and OdTc='" + ADC("OmTc") + "' and OdYy='" + ADC("OmYy") + "'" + _
                  "and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")) + _
                  " and OdSr =" + CStr(wOdSrArr(i)))
    End If
    'store wax set qty
    If pOrSrNo > 0 Then
      wWsQty = pWsQty
    Else
      wWsQty = moCn.GetFldVal("select sum(OrWsQty) From OrdRm " + _
                "where OrCoCd='" + ms_OmCoCd + "' and OrTc='" + ADC("OmTc") + "' and OrYy='" + ADC("OmYy") + "'" + _
                "and OrChr='" + ADC("OmChr") + "' and OrNo=" + CStr(ADC("OmNo")) + _
                " and OrSr in(" + CStr(wOdSrArr(i)) + ") and OrWsQty >0 ")
    End If
    'store handset qty
    If pOrSrNo > 0 Then
      wHsQty = pHsQty
    Else
      wHsQty = moCn.GetFldVal("select sum(OrHsQty) From OrdRm " + _
                "where OrCoCd='" + ms_OmCoCd + "' and OrTc='" + ADC("OmTc") + "' and OrYy='" + ADC("OmYy") + "'" + _
                "and OrChr='" + ADC("OmChr") + "' and OrNo=" + CStr(ADC("OmNo")) + _
                " and OrSr in(" + CStr(wOdSrArr(i)) + ") and OrHsQty >0 ")
    End If
    'checking Production sequence and WsQty link
    If wWsQty > 0 Then
      wWsCnt = moCn.GetFldVal("select COUNT(*) from vParam " + _
                "join Loc Lp on Lp.LocCoCd ='" + ms_OmCoCd + "' and Lp.LocTyp ='P' and ','+ vPDesc225  + ',' like  '%,'+ Lp.LocCd+ ',%' " + _
                "join Loc Lr on Lr.LocCoCd ='" + ms_OmCoCd + "' and Lr.LocTyp ='R' and Lr.LocCd=Lp.LocPrcs " + _
                " where vPCoCd ='" + ms_OmCoCd + "' and vPTyp ='PRDSEQ' and vPMCd ='" + wsPrdSeq + "' and vPSCd ='' " + _
                " and Lr.LocPrdTyp='WS' ")
        
      If wWsCnt = 0 Then
        If pChkAllOdSr <> "" Then
          wWsErrSr = IIF(wWsErrSr = "", "", wWsErrSr + ",") + CStr(wOdSrArr(i))
        End If
      End If
    End If
    'checking Production sequence and HsQty link
    If wHsQty > 0 Then
      wHsCnt = moCn.GetFldVal("select COUNT(*) from vParam " + _
                "join Loc Lp on Lp.LocCoCd ='" + ms_OmCoCd + "' and Lp.LocTyp ='P' and ','+ vPDesc225  + ',' like  '%,'+ Lp.LocCd+ ',%' " + _
                "join Loc Lr on Lr.LocCoCd ='" + ms_OmCoCd + "' and Lr.LocTyp ='R' and Lr.LocCd=Lp.LocPrcs " + _
                " where vPCoCd ='" + ms_OmCoCd + "' and vPTyp ='PRDSEQ' and vPMCd ='" + wsPrdSeq + "' and vPSCd ='' " + _
                " and Lr.LocPrdTyp='GS' ")
        
      If wHsCnt = 0 Then
        If pChkAllOdSr <> "" Then
          wHsErrSr = IIF(wHsErrSr = "", "", wHsErrSr + ",") + CStr(wOdSrArr(i))
        End If
      End If
    End If

  Next i
End If
'if error it show while save voucher
If wWsErrSr <> "" Then
  mb_WsHsPrdSeqUpd = True: ms_WsHsPrdSeqUpdErr = "WaxSet Location Does Not Exists In Production Sequence for Design Serial(s): " + wWsErrSr + " ": Exit Sub
End If
If wHsErrSr <> "" Then
  mb_WsHsPrdSeqUpd = True: ms_WsHsPrdSeqUpdErr = "HandSet Location Does Not Exists In Production Sequence for Design Serial(s): " + wHsErrSr + " ": Exit Sub
End If

End Sub

