            .Value(wi_LabRow, "OlMCd") = wo_rsSrcOl!OlMCd
            .Value(wi_LabRow, "OlSCd") = wo_rsSrcOl!OlSCd
            .Value(wi_LabRow, "OlQty") = wo_rsSrcOl!OlQty
            'urmi 2.06 LabRt
            'If mf_CpyRate = True Then
             If mf_CpyLabRate = True Then
              .Value(wi_LabRow, "OlQw") = wo_rsSrcOl!OlQw
              '.Value(wi_LabRow, "OlCstQw") = wo_rsSrcOl!OlCstQw    ' ***** Manali 3.03 - Cst Rt always from Current
              .Value(wi_LabRow, "OlQty") = wo_rsSrcOl!OlQty
              .Value(wi_LabRow, "OlSalRt") = wo_rsSrcOl!OlSalRt
              '.Value(wi_LabRow, "OlCstRt") = wo_rsSrcOl!OlCstRt    ' ***** Manali 3.03 - Cst Rt always from Current
              
              '*** (Bef 2.13)
              '.Value(wi_LabRow, "OlSalVal") = wo_rsSrcOl!OlSalVal
              '.Value(wi_LabRow, "OlCstVal") = wo_rsSrcOl!OlCstVal
              '*** (Bef 2.13)
              
              '*** (Jen 2.13)
              If mf_CpyVal = True Then
                .Value(wi_LabRow, "OlSalVal") = wo_rsSrcOl!OlSalVal
                '.Value(wi_LabRow, "OlCstVal") = wo_rsSrcOl!OlCstVal    ' ***** Manali 3.03 - Cst Rt always from Current
              End If
              '*** (Jen 2.13)
              
            End If
            
            
            If FraStkCpy.Visible And ms_OmTcTyp = "JT" Then
              If pv_rsSrcOd!OdTc + "/" + pv_rsSrcOd!OdYy + "/" + pv_rsSrcOd!OdChr + "/" + CStr(pv_rsSrcOd!OdNo) + "/" + CStr(pv_rsSrcOd!OdSr) <> pv_rsSrcOd!qBaseRefVch And pv_rsSrcOd!qBaseRefVch <> "" _
                          And mf_CpyLabRate Then
            
              ws_baseVch = Split(pv_rsSrcOd!qBaseRefVch, "/")
              
              Set wo_rsBaseRt = moCn.OpenRes("Select OlQw,OlSalRt,OlSalVal " + _
                                             "  From OrdLab " + _
                                             "  where OlCoCd='" + wCoCd + "' and OlTc='" + ws_baseVch(0) + "' and OlYy='" + ws_baseVch(1) + "' and OlChr='" + ws_baseVch(2) + "' " + _
                                             "  and  OlNo=" + ws_baseVch(3) + " and OlSr=" + ws_baseVch(4) + _
                                             "  and  OlMCd='" + wo_rsSrcOl!OlMCd + "' and OlSCd='" + wo_rsSrcOl!OlSCd + "' " + _
                                             "  Order By (Case when OlSrNo=" + CStr(wo_rsSrcOl!OlSrNo) + " Then 1 Else 2 End), OlSalRt Desc ")
      
              
                    If Not (wo_rsBaseRt.BOF Or wo_rsBaseRt.EOF) Then
                      ' SRI
                      '.Value(wi_LabRow, "OlQW") = wo_rsSrcOl!OlQw
                      '.Value(wi_LabRow, "OlSalRt") = wo_rsSrcOl!OlSalRt
                      '.Value(wi_LabRow, "OlSalVal") = wo_rsSrcOl!OlSalVal
                      
                      .Value(wi_LabRow, "OlQW") = wo_rsBaseRt!OlQw
                      .Value(wi_LabRow, "OlSalRt") = wo_rsBaseRt!OlSalRt
