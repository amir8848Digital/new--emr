  ' ###########################################  Manoj  ###########################################
            wo_rsSrcOl.MoveNext
          Loop
  
          GrdOrdLab.EndCopy
        End With
    End If
      '###########################################  Manoj  ###########################################
      ' Manoj 2.10.0 For Test Don't Open it
      'Call SetDsgPrc(GrdOrdDsg.Row, VtCalc)
      'Call SetDsgPrc(GrdOrdDsg.Row, VtCst)
      '.SaveRec (GrdOrdDsg.Row)
      ' Manoj 2.10.0 For Test Don't Open it
      '###########################################  Manoj  ###########################################

      '************************** urmi **27 Jun 03********************************************'
      ''If Pdc is source, Pdc has Fixed Price 'Y', the target copy is for the same Customer,
      ''copy with Rate YN = 'Y' and the Copy rate = 'GPSDCXAM' (hardcoded or has length 8 )
      ''then the value of OdSalVal will be copied from source.
      ''Best do it at end of copy routine for each design
      '
      ''If pv_CpyFrDsgMst = False Then
      ''  If moCn.GetFldVal("Select PValue from Param where PTyp= 'TC' " + _
      ''                    "and PMCd= '" + pv_rsSrcOd!OdTc + "'") = "PL" _
      ''     And mf_CpyFrSameCust = True And mf_CpyRate = True And ms_CpyRateCd = "GPSDCXAM" Then
      ''    If UCase(pv_rsSrcOd!ODFIXPRC) = "Y" Then .Value(wi_OdRow, "OdSalPrc") = pv_rsSrcOd!OdSalPrc
