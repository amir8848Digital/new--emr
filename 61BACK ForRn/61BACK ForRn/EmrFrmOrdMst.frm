Private Sub GrdOrdRm_GotFocus()
  '*** Call the SetGrdOrdRm sub procedure with parameter as 'E' to make all the fields
      'of grid GrdOrdRm visible except the fields which were kept invisible at design time
      'This is done so that the user can see all the fields if the grid when the focus is on that grid
      'In the process of accomodating all the fields of GrdOrdRm, the grid GrdOrdLab becomes invisible
  SetGrdOrdRm "E"
  GrdOrdRm.ZOrder
  '****** Sachin 3.02.0 - Locking Add and Delete of Rows in OrdRm Grid
  ' ***** Manali Trading Module
 If GrdOrdDsg.Row > 0 Then
    Dim wf_invhdmust As Boolean
    wf_invhdmust = moCn.RecSeek("Select 'x' from TcMst where TmTc = '" + ADC("omTc") + "' and TmCoCd = '" + ms_OmCoCd + "' and TmInvHdMustYn = 'Y'")
    If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn Or (Not mInvExists And CmdInvHd.Visible And wf_invhdmust) Then
       GrdOrdRm.AllowAdd = False: GrdOrdRm.AllowDelete = False
    Else
      Dim wf_Cancel As Boolean, wf_errmsg As String
      Call ATXT_FldChange(99, UCase("OmLockYN"), wf_Cancel, wf_errmsg, ADC("OmLockYN"))
      'GrdOrdRm.AllowAdd = True: GrdOrdRm.AllowDelete = True
    End If
    If ms_OmTcTyp = "JT" Then
      Call ChkIsJEmrMasterRecord(GrdOrdDsg.Row, wf_Cancel, wf_errmsg)
      If wf_Cancel Then
        Call DispMsg(wf_errmsg, etError)
        GrdOrdRm.AllowAdd = False: GrdOrdRm.AllowDelete = False
      Else
        GrdOrdRm.AllowAdd = True: GrdOrdRm.AllowDelete = True
      End If
    End If
 End If
End Sub
