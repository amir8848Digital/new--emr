Private Sub CmdCustSelGo_Click()
Dim i As Integer
Dim w_rsCustSel As MwfLib.MDORowSet
  GrdCustSel.Visible = True
  GrdCertDet.Visible = False
  FraCustSelDet.Visible = True

  'selecting records from CustMst table matching with user entered values in scope
  Set w_rsCustSel = moCn.OpenRes("Select CmCd,CmName from CustMst where  CmCtg='" + ADC("OmCmCtg") + "' and ('" + _
                  ADC("WCUSTNAME") + "'='' or (CMName  LIKE '%" + ADC("WCUSTNAME") + "%') or (dbo.ReplaceSpecialCharacter(CmName) like '%' + dbo.ReplaceSpecialCharacter('" + _
                  ADC("WCUSTNAME") + "') + '%')) and ('" + _
                  ADC("WCUSTADDR") + "'='' or (CMAdd1+CmAdd2+CMAdd3 LIKE '%" + ADC("WCUSTADDR") + "%') or (dbo.ReplaceSpecialCharacter(CMAdd1+CmAdd2+CmAdd3) like '%'+ dbo.ReplaceSpecialCharacter('" + _
                  ADC("WCUSTADDR") + "')+'%')) and ('" + _
                  ADC("WCUSTEMAIL") + "'='' or CmEMail LIKE  '%" + ADC("WCUSTEMAIL") + "%') " + _
                  "and ('" + ADC("WCUSTPH") + "'= '' or (CmTel like '%" + ADC("WCUSTPH") + "%') or (dbo.ReplaceSpecialCharacter(CmTel) like '%'+dbo.ReplaceSpecialCharacter('" + ADC("WCUSTPH") + "')+'%') or " + _
                  " (CmTel<>'' and (dbo.ReplaceSpecialCharacter('" + ADC("WCUSTPH") + "') like '%'+dbo.ReplaceSpecialCharacter(CmTel)+'%'))) ")
    
  'copies date to grid
  GrdCustSel.Rows = 1
    With GrdCustSel
    .StartCopy
      Do While Not (w_rsCustSel.EOF Or w_rsCustSel.BOF)
        .AddItem
        i = .Rows - 1
        .Value(i, "WCUSTCODE") = w_rsCustSel!CmCd
        .Value(i, "WCUSTNAME") = w_rsCustSel!CmName
        w_rsCustSel.MoveNext
      Loop
    .EndCopy
    End With

End Sub

Private Sub CmdDsgAddRprDiff_Click()
  Dim wo_rsSrcOd As MwfLib.MDORowSet
  If ADC("wDsgAddRprDiffCoCd") = "" Or ADC("wDsgAddRprDiffTc") = "" Or ADC("wDsgAddRprDiffYy") = "" Or ADC("wDsgAddRprDiffChr") = "" Or ADC("wDsgAddRprDiffNo") = 0 Or ADC("wDsgAddRprDiffSr") = 0 Then
    DispMsg "Cannot Copy Records. Enter Repair Difference Details", etError: Exit Sub
  End If
                         
  'kc.8-checking copy rate options
  mf_CpyRate = IIF(ADC("wDsgCpyRt") = "Y", True, False)
  mf_CstRatePDCM = IIF(ADC("WDSGCOSTFRPDCMYN") = "Y", True, False)
  If (ADC("wDsgCpyRt") = "Y" Or ADC("WDSGCOSTFRPDCMYN") = "Y") And ADC("wDsgCpyRtOpt") = "" Then DispMsg "Copy Rate Option Is Compulsory", etError: Exit Sub
  mf_CpyVal = True
  ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wDsgCpyRtOpt") + "' ")
  'kc.8-Add repair differece is not applicable for JRO vouchers
  If GrdOrdDsgTgt.Rows > 1 Then DispMsg "Please clear the Rm Target Grid", etError: Exit Sub
  If ADC("OmTc") = "JRO" Then DispMsg "Cannot Add Rm Details to this Voucher", etError: Exit Sub
  'kc.8- checking currency check
  If ADC("OmCmCurCd") <> moCn.GetFldVal("Select OmCmCurCd from OrdMst where OmCoCd= '" + ADC("wDsgAddRprDiffCoCd") + "' " + _
                         "and OmTc= '" + ADC("wDsgAddRprDiffTc") + "' and OmYy= '" + ADC("wDsgAddRprDiffYy") + "' " + _
                         "and OmChr= '" + ADC("wDsgAddRprDiffChr") + "' and OmNo= " + CStr(ADC("wDsgAddRprDiffNo")) + " " + _
                         "and OmPrtKey='" + ctCurrPrtn + "' ") And (ADC("wDsgCpyRt") = "Y") Then
          DispMsg "Cannot copy with Rate Yes, Currency of Source Voucher and Target Voucher not matching", etError: Exit Sub
  End If
  If ADC("OmCmCurCd") <> moCn.GetFldVal("Select OmCmCurCd from OrdMst where OmCoCd= '" + ADC("wDsgAddRprDiffCoCd") + "' " + _
                         "and OmTc= '" + ADC("wDsgAddRprDiffTc") + "' and OmYy= '" + ADC("wDsgAddRprDiffYy") + "' " + _
                         "and OmChr= '" + ADC("wDsgAddRprDiffChr") + "' and OmNo= " + CStr(ADC("wDsgAddRprDiffNo")) + " " + _
                         "and OmPrtKey='" + ctCurrPrtn + "' ") And (ADC("WDSGCPYLABRT") = "Y") Then
          DispMsg "Cannot copy with LabRate Yes, Currency of Source Voucher and Target Voucher not matching", etError: Exit Sub
  End If
  'sv.71 deleting old error message once copy started
  moCn.Execute ("Delete from OrdCpyErr where OceCoCd= '" + ms_OmCoCd + "' and OceTc= '" + ADC("OmTc") + "' and OceYy= '" + ADC("OmYy") + "' and " + _
                   "OceChr= '" + ADC("OmChr") + "' and OceNo= " + CStr(ADC("OmNo")) + " and OcePrtKey = '" + ctCurrPrtn + "'")
  mi_ErrSr = 0

  Set wo_rsSrcOd = moCn.OpenRes("Select * from OrdDsg where OdCoCd= '" + ADC("wDsgAddRprDiffCoCd") + "' " + _
                         "and OdTc= '" + ADC("wDsgAddRprDiffTc") + "' and OdYy= '" + ADC("wDsgAddRprDiffYy") + "' " + _
                         "and OdChr= '" + ADC("wDsgAddRprDiffChr") + "' and OdNo= " + CStr(ADC("wDsgAddRprDiffNo")) + " " + _
                         "and OdSr= " + CStr(ADC("wDsgAddRprDiffSr")) + " and OdPrtKey='" + ctCurrPrtn + "' and " + _
                         "OdDmCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' and OdSfx='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx") + _
                         "' and OdDmSz='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz") + "' and " + _
                         "OdDmStkCoCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkCoCd") + "' and OdDmStkYy='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy") + "' and " + _
                         "OdDmStkChr='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr") + "' and OdDmStkNo=" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkNo")))
    
  If wo_rsSrcOd.RecCount <> 1 Then DispMsg "Caanot Copy As Order Details Does Not Exist or given Design Cd, Sfx, Sz, StkCoCd, Yy, Chr, No mismatch", etError: Exit Sub
  'kc.8 checking customer
  mf_CpyFrSameCust = IIF(ADC("OmCmCd") = wo_rsSrcOd!OdOmCmCd, True, False)
  If ADC("wDsgCpyLabRt") = "Y" Then mf_CpyLabRate = True
  ms_CpyRateCd = ADC("wDsgCpyRtOpt")
  BeginEmrProcess Me, "Copying"    '578.40
  Call CpyDets(wo_rsSrcOd, False, False, , , , , True)
  EndEmrProcess Me  '578.40
  Call ShowMsgBoxForErr       '578.40 show msgbox if any error captured
  Call CmdDsgCpy_Click
End Sub

