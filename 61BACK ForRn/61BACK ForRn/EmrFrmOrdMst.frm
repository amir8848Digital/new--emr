        Else




            GrdDsgStk.Value(wRow, "WDSDMSTKNUM") = !DDmStkNo


        End If
        GrdDsgStk.Value(wRow, "wDsStkQty") = !qStkQty
        GrdDsgStk.Value(wRow, "wDsGrsWt") = !qGrsWt

        GrdDsgStk.Value(wRow, "wDsSrcVch") = !QSRCVCH
        GrdDsgStk.Value(wRow, "wDsDsgPrc") = !OdSalPrc
        GrdDsgStk.Value(wRow, "wDsOrdDt") = !OdOmDt

        GrdDsgStk.Value(wRow, "wDsCpyYn") = "N"
      .MoveNext
    Loop
