          wDmAllowStr = GetDmAllowStr(ms_DmTcTyp, pv_rsSrcOd!IdDmCd, IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")))
          If moCn.GetFldVal(wDmAllowStr) = "N" Then
