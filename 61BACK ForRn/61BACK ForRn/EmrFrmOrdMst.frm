Private Function ForCpy_GetDCRmVal(ByVal wRsRmRows As MDORowSet, ByVal ws_IdName As String, Optional wRmCtg As String, Optional wSubLogic As String, Optional wOrMainMetRmCtg As String, Optional wOrCS As String) As Double
  Dim wf_RmVal As Double, wi_i As Integer, ws_RmCtg As String, ws_RmSCtg As String, wChnLabAs As String, ws_RmCd As String
  Dim wb_CustRm As Boolean
  Dim ws_MainMetRmCd As String
  ws_MainMetRmCd = ""
  wf_RmVal = 0
  If ADC("wChnCustYn") = "Y" Then

    wChnLabAs = "," + moCn.GetFldVal("Select hChnSubCtgForLab from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain labour gold wt calc
  Else
    wChnLabAs = ""
  End If
  wRsRmRows.MoveFirst
  Do While Not (wRsRmRows.EOF Or wRsRmRows.BOF)
    ws_RmCtg = wRsRmRows!OrRmCtg
    ws_RmCd = wRsRmRows!OrRmCd
    ws_RmSCtg = wRsRmRows!OrRmSCtg
    ws_MainMetRmCd = IIF(wRsRmRows!OrMainMet = "Y", wRsRmRows!OrRmCd, "")
    
    If moCn.RecSeek("Select 'x' from CustMst where CmCtg='C' and CmCd = (select RmCmCd from RmMst where RmCd = '" + ws_RmCd + "')") Then
        wb_CustRm = True
    Else
        wb_CustRm = False
    End If
    If wRmCtg <> "" Then
      If wRmCtg = "CHN" And ADC("wChnCustYn") = "Y" And (InStr(1, wChnLabAs, "," + wRsRmRows!OrRmSCtg + ",") <> 0) Then
        wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
      ElseIf wRmCtg = ctCDWLMCd And ws_RmCtg = "D" Then
        If wSubLogic = "C" And wRsRmRows!OrSubShp = "C" Then
        wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
        ElseIf wSubLogic = "-" Then
          wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
        ElseIf wSubLogic = "NC" And wRsRmRows!OrSubShp <> "C" Then
          wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
        End If
      ElseIf ws_RmCtg = wRmCtg And Not (False) And (Not mb_CHCDHCOnCustRm Or wb_CustRm) Then
        wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
      ElseIf wRmCtg = ctGHCLMCd And wSubLogic = "K" And ws_RmCtg = wOrMainMetRmCtg And InStr(1, wChnLabAs, "," + ws_RmSCtg + ",") = 0 Then
        wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
      ElseIf wRmCtg = ctGHCLMCd And wSubLogic = "P" And (ws_RmCtg = wOrMainMetRmCtg And InStr(1, wChnLabAs, "," + ws_RmSCtg + ",") = 0) Then
        If wRsRmRows!OrMainMet = "Y" Then
          wf_RmVal = wf_RmVal + Params(wOdGldAsWt)
        Else
          wf_RmVal = wf_RmVal + wRsRmRows!OrWt
        End If
      End If
    Else
      If (ws_RmCtg = "C" Or ws_RmCtg = "D") And Not (GrdOrdRm.IsDel(wi_i)) Then
        wf_RmVal = wf_RmVal + wRsRmRows.FldValue(ws_IdName)
      End If
    End If
    wRsRmRows.MoveNext
  Loop
  If wRmCtg = ctGHCLMCd And wSubLogic = "P" Then
    wf_RmVal = wf_RmVal * ForCpy_GetOrRmCtgMainMetVal(wOrCS, ws_MainMetRmCd)
  End If
  
  ForCpy_GetDCRmVal = wf_RmVal
End Function
