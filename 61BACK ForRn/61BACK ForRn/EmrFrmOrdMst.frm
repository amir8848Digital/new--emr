                                    " OdTc='" + ADC("OmTc") + "' and OdYy='" + ADC("OmYY") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")) + " and OdSr=" + ReadCell(ADC("WXLSHTNO"), i, 1)) Then _
