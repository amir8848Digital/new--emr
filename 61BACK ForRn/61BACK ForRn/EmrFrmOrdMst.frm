Private Sub PropSet(Optional ByVal pb_JtFld As Boolean = False)
  '*** Set Visible and Enabled Properties for X Fields ***
  '*** Set Visible and Enabled Properties for Grid controls and Grid Columns ***
  '*** Set Visible and Enabled Properties for Command Buttons ***
  '*** Set Visible and Enabled Properties for ADC Buttons ***
  On Error GoTo ErrProp
  
  Dim wRsCtrl As MwfLib.MDORowSet, wRsGrds As MwfLib.MDORowSet
  Dim wo_Grd As MwfCtl.MWCTL_FLX
  Dim wColSty_Curr As en_fgColStyle, wColSty_Prop As en_fgColStyle
  
  If Not pb_JtFld Then
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'ADC' ")
     
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I", "D"
         If wRsCtrl!UrName = "ADD" Then ADC.AllowAdd = False
         If wRsCtrl!UrName = "DELETE" Then ADC.AllowDelete = False
       Case Is = "E"
       End Select
       wRsCtrl.MoveNext
     Loop
    
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'X' and UrName<> ''")
     
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I"
         ADC(wRsCtrl!UrName).Enabled = False
         ADC(wRsCtrl!UrName).BckColorDisable = ADC(wRsCtrl!UrName).ForColorDisable
       Case Is = "D"
         ADC(wRsCtrl!UrName).Enabled = False
       Case Is = "E"
       End Select
       
       wRsCtrl.MoveNext
     Loop
     
     Set wRsGrds = moCn.OpenRes("Select upper(RTrim(LTrim(UrCtlSTyp))) as UrCtlSTyp, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight " + _
                                "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'GRD' and UrName= '' and UrCtlSTyp<> '' " + _
                                "Order By UrCtlSTyp ")
     
     Do While Not (wRsGrds.EOF Or wRsGrds.BOF)
       Set wo_Grd = GetGrd(wRsGrds!UrCtlSTyp)
       ms_GrdUrStyle = IIF(wRsGrds!UrCtlSTyp = "GRDORDRM", wRsGrds!UrStyle, "")    '****** Sachin 3.5.0
       Select Case UCase(wRsGrds!UrStyle)
       Case Is = ""
         '*** Full Rights
       Case Is = "I"
         wo_Grd.Enabled = False
         wo_Grd.Visible = False
       Case Is = "D"
         wo_Grd.Enabled = False
         'wo_Grd.Visible = True
       Case Is = "E"
         '*** This option means the grid is available for editing but new
         'wo_Grd.Enabled = True
         'wo_Grd.Visible = True
         
         wo_Grd.AllowAdd = False
         wo_Grd.AllowDelete = False
       End Select
     
       If wRsGrds!UrStyle = "" Or wRsGrds!UrStyle = "E" Or wRsGrds!UrStyle = "D" Then
         Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                    "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                    "and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + wRsGrds!UrCtlSTyp + "' and UrName<> '' ")
         
         Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
           wColSty_Curr = wo_Grd.ColProp(wRsCtrl!UrName).Style
           wColSty_Prop = ColSty(wColSty_Curr, wRsCtrl!UrStyle)
           If wColSty_Curr <> wColSty_Prop And Not (wRsGrds!UrCtlSTyp = "GRDORDRM" And wRsCtrl!UrStyle = "D") Then _
                   wo_Grd.ColProp(wRsCtrl!UrName).Style = wColSty_Prop
           'wo_Grd.ColProp(wRsCtrl!UrName).Style = ColSty(wo_Grd.ColProp(wRsCtrl!UrName).Style, wRsCtrl!UrStyle)
           wRsCtrl.MoveNext
         Loop
       End If
       
       wRsGrds.MoveNext
     Loop
     
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'CMD' ")
     
     '*** Setting Vis and Ena Properties for MwCtl_Btn1 (Button) Conrols ***
     'Dim wo_CmdCtrl As Control
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I"
         Me.Controls(wRsCtrl!UrName).Enabled = False
         Me.Controls(wRsCtrl!UrName).Visible = False
       Case Is = "D"
         Me.Controls(wRsCtrl!UrName).Enabled = False
       Case Is = "E"
       End Select
       
       wRsCtrl.MoveNext
     Loop
  Else
  ' **** Manali Trading Module
    Set wRsCtrl = moCn.OpenRes("Select * from TcStr where TsTbl='ORD' and TsTyp= '" + ms_OmTc + "' and TsSTyp= 'X' ")
    
    Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
      ADC(wRsCtrl!TsIdName).Enabled = FldEna(wRsCtrl!TsStyle)
      ADC(wRsCtrl!TsIdName).Visible = FldVis(wRsCtrl!TsStyle)
       wRsCtrl.MoveNext
    Loop

    Set wRsCtrl = Nothing
  
    Call GrdPropSet(GrdOrdDsg, "DSG")
      
    Set wRsCtrl = moCn.OpenRes("Select * from TcStr where TsTbl='ORD' and TsTyp='" + ms_OmTc + "' and TsSTyp='Lbl'")
    Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
      Me.Controls(wRsCtrl!TsIdName).Visible = FldVis(wRsCtrl!TsStyle)
      wRsCtrl.MoveNext
    Loop
    Set wRsCtrl = Nothing
       
    Call CmdPropSet
    
  End If
  
  Set wRsCtrl = Nothing
  Set wRsGrds = Nothing
  
  Call SetJLVisInvis
  
  Exit Sub

ErrProp:
  If pb_JtFld = False Then
    DispMsg "Invalid UsrRight Settings", etError
  Else
    DispMsg "Invalid Display Settings", etError
  End If
  Resume Next
End Sub
Private Sub SetJLVisInvis()
  Dim wb_TmJLooseTC  As String
  wb_TmJLooseTC = moCn.GetFldVal("Select TmJLooseTC   from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'")
  If ADC("OmTc") = "PL" Or ADC("OmTc") = "QB" Or ADC("OmTc") = "QT" Or ADC("OmTc") = "SO" Then wb_TmJLooseTC = "N"
  If wb_TmJLooseTC = "Y" Then
    GrdOrdDsg.ColProp("OdDmStkYy").Style = fgcinvisible
    GrdOrdDsg.ColProp("OdDmStkChr").Style = fgcinvisible
    GrdOrdDsg.ColProp("OdDmStkNo").Style = fgcinvisible
    GrdOrdDsg.ColProp("OdDmStkCoCd").Style = fgcinvisible 'Stkcocd
    GrdOrdDsg.ColProp("wOdPONO").Style = fgcinvisible
