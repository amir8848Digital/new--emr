          .Value(wi_OdRow, "wOdBaseVchSr") = pv_rsSrcOd!OdTc + "/" + pv_rsSrcOd!OdYy + "/" + pv_rsSrcOd!OdChr + "/" + CStr(pv_rsSrcOd!OdNo) + "/" + CStr(pv_rsSrcOd!OdSr)
        Else
