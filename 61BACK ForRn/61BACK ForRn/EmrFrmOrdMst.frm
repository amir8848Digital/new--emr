        .Value(wi_OdRow, "OdPrdEnt") = pv_rsSrcOd!RedQty
      '*** (Jen 2.13)
      ' **** Manali Trading Module - StockCpy
      ElseIf pv_StkCpy = True Then
        .Value(wi_OdRow, "OdOrdEnt") = IIF(pv_rsSrcOd!qStkQty > 0, pv_rsSrcOd!qStkQty, 0)
