Private Sub CpyDets(ByVal pv_rsSrcOd As MDORowSet, ByVal pv_CpyFrDsgMst As Boolean, ByVal pv_OrdCpy As Boolean, Optional pv_CpyBags As Boolean, Optional pv_CpyFrRet As Boolean = False, Optional pv_CpyXl As Boolean = False, Optional pv_StkCpy As Boolean = False, Optional pv_RprDiff As Boolean = False, Optional ByRef ps_ErrMsg As String, Optional ByRef rdex As Boolean)
      Dim wb_Errinsrvrcpy As Boolean
      Dim ws_errInSrvrCpyLvl As String
      Dim ws_ErrMsg As String
      If Not mf_CopyModeStartedByParent Then
      m_icunt = 1
      End If
  Dim wi_OdRow As Integer, wi_RmRow As Integer, wi_LabRow As Integer '*** Jay 2.13(CT) ***
  Dim wo_rsSrcORm As MDORowSet, wo_rsSrcOl As MDORowSet, wo_rsSrcOCT As MDORowSet, wo_rsStkRt As MDORowSet
  Dim ws_TmpTbl As String, ws_RmStr As String, ws_RmCdStr As String, wOldSpGrav As Single, wNewSpGrav As Single
  Dim ws_RmCdStrGp As String, ws_RmStrGp As String
  Dim ws_OdWh As String, wb_RetVch As Boolean
  Dim ws_RmCount As Integer, i As Integer
  Dim wCoCd As String, ws_AlyCdStr As String
  Dim wDmDefSz As String
  Dim ws_baseVch() As String
  Dim wErrMsg As String
  Dim ws_DsgCpy_OdDmCd As String
  Dim ws_DsgCpy_OdSfx As String
  Dim ws_DsgCpy_OdDmSz As String
  Dim ws_DsgCpy_OdSr As Long
  Dim ws_DsgCPy_OdBYy As String
  Dim ws_DsgCPy_OdBChr  As String
  Dim ws_DsgCPy_OdBNo As Long
  Dim ws_DsgCPy_OdOrdEnt As Long
      
      
  Dim ws_TmpOrdRm1 As String
  mDsgSrNotCopied = ""
  
  Dim wb_RmChgFlag As Boolean
  wb_RmChgFlag = False
  mf_InCopyFromServer = True
  If FraDsgCpy.Visible = True And GrdOrdDsg.Row >= 1 And GrdOrdDsg.Row <= GrdOrdDsg.Rows - 1 Then
      ws_DsgCpy_OdDmCd = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd")
      ws_DsgCpy_OdSfx = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx")
      ws_DsgCpy_OdDmSz = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz")
      ws_DsgCpy_OdSr = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")
      ws_DsgCPy_OdBYy = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdByy")
      ws_DsgCPy_OdBChr = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBChr")
      ws_DsgCPy_OdBNo = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBNo")
      ws_DsgCPy_OdBNo = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBNo")
      ws_DsgCPy_OdOrdEnt = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdOrdEnt")
      GrdOrdDsg.Rows = GrdOrdDsg.Rows - 1
  End If
  
  If Not mf_CopyModeStartedByParent Then
    GrdOrdDsg.StartServerCopy (True)
  End If
  
  Dim wi_MainMetRow As Integer, wd_NonMainMetWt As Double
  If Not mf_MrpChr Then
    mf_CpySalPrc = mf_CpyVal
  Else
    mf_CpySalPrc = False
  End If
  Dim ws_StkRtStr As String   '****** Sachin 3.3.0
  

  Dim ws_BagStr As String, ws_TmpOrdRmTbl As String, ws_OrdRmStr As String, ws_Vch() As String
  Dim ws_CtgStr As String
  Dim ws_HOdGmChk As String
  Dim wi_Cnt As Integer, wi_TotCnt As Integer, ws_RunMsg As String    '4.1.3.0 - Sachin
  ws_HOdGmChk = moCn.GetFldVal("Select HOdGmChk From Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")
  If pv_CpyFrDsgMst = False Then
    wCoCd = CoCdVal(pv_rsSrcOd!OdTc, pv_OrdCpy)
  End If
  
  wb_RetVch = IIF(ADC("OmReNo") <> 0, True, False)
  
  wi_TotCnt = pv_rsSrcOd.RecCount
  wi_Cnt = 0
  Dim ijk As Integer
  ijk = 0
  If pv_RprDiff = True Then GoTo AddRprDiff
  With GrdOrdDsg
      mf_ShowDsg = False
'      If Not mf_CopyModeStartedByParent Then GrdOrdDsg.StartCopy
     If Not mf_CopyModeStartedByParent Then MWLib.BeginProcess Me, "Copying Order"                    '4.1.3.0 - Sachin
     If Not mf_CopyModeStartedByParent Then BeginEmrProcess Me, "Copying Order"                    '4.1.3.0 - Sachin
'      TrackStatus (mFrmTrackStatus.txtStatus.Text + vbCrLf + "Started Copying")
    Do While Not (pv_rsSrcOd.EOF Or pv_rsSrcOd.BOF)
      Dim uu1 As String
      If m_rdEx = True Then
      GoTo chek
      End If
  
      ijk = ijk + 1
      UpdateEmrProcess "CpyDets OrdDsg Copy In Progress...Row: " + CStr(m_icunt)
      OrdDsgWhenForCpy
      mb_CpyKT = True
      mb_CpyCol = True
      If wb_RetVch = False Then
    '     If moCn.RecSeek("Select 'x' From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' " + _
          " And DmSz=IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "'" + _
          "  and DmPrtKey='" + ctCurrPrtn + "'" + _
          " ),'') and DmPrtKey='" + ctCurrPrtn + "'" + _
          " And DmHld = 'Y'  And DmValidYN='N' " + _
          IIF(ms_OmTcTyp = "JT" Or ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " And ((DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
          "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmCmGrp= 'Y' and " + _
          "(Select CmGrp from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) = '" + ms_CmGrp + "' ) or " + _
          " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
          " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' ))) ")) Then _
          GoTo NextOd
        '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******
          
        '*** Jay 3.1.0_1 [Comp On Hold Added.]
        'indigo.164-sketch order will not check component data
    '    If mf_CTMod = True And (UCase(ms_OmTcTyp) <> "QS" And UCase(ms_OmTcTyp) <> "OS") Then
     '     If moCn.RecSeek("Select 'x' from DsgMst " + _
            "Join (Select DctCd, DctSz from DsgCt where DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = '" + pv_rsSrcOd!OdDmCd + "' and " + _
            "DctDmSz = '' and DctPrtKey='" + ctCurrPrtn + "'  /* IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "' and DmPrtKey='" + ADC("OmPrtKey") + "' ),'') */ ) CT " + _
            "On DmCd = DctCd and DmSz= DctSz " + _
            "where DmTcTyp = 'PM' and DmHld = 'Y' ") Then _
            GoTo NextOd
      '  End If
        '*** Jay 3.1.0_1 [Comp On Hold Added]
      End If
      
      '*** Jay 3.2.0 [PicNm]
      ' ***** Manali 3.5.0 - 11/11/08 - Return Memo cond added
      If ADC("OmTc") = "SO" And pv_rsSrcOd!OdDmSz = "" And wb_RetVch = False Then
        wDmDefSz = moCn.GetFldVal("Select DmDefSz from DsgMst where DmTcTyp= 'DM' and DmCd= '" + pv_rsSrcOd!OdDmCd + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "'")
      End If
      '*** Jay 3.2.0 [PicNm]
      
      ' ***** Manali 3.10.0 - Copy in PDCM allowed From QT
      If UCase(ms_OmTcTyp) = UCase("PL") And pv_OrdCpy Then
        If moCn.RecSeek("Select 'x' from OrdDsg where " + _
                  "OdCoCd= '" + ms_OmCoCd + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                  "OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and " + _
                  "OdNo= " + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "' and " + _
                  "OdDmCd='" + pv_rsSrcOd!OdDmCd + "' and OdSfx ='" + pv_rsSrcOd!OdSfx + "' and OdDmSz='" + pv_rsSrcOd!OdDmSz + "' ") Then
              mDsgSrNotCopied = mDsgSrNotCopied + IIF(mDsgSrNotCopied <> "", ", ", "") + CStr(pv_rsSrcOd!OdSr)
              GoTo NextOd
        End If
      End If
      If ADC.Mode = xCopy Then
        SetParamsVal IIF(pv_CpyXl = True And mi_xlOdSr > 0, mi_xlOdSr, Params(wctOdSr)), wctOdSr
        SetParamsVal pv_rsSrcOd!OdDmCd, woddmcd
        SetParamsVal IIF(pv_rsSrcOd!OdSfx = "" And pv_CpyXl = True, ms_xlSfx, pv_rsSrcOd!OdSfx), wOdSfx
        SetParamsVal IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, wDmDefSz), wOdDmSz
        Dim wDmAllowStr As String
        If Not (ms_OmTcTyp = "JT" Or ADC("OmCmCd") = ctSelfCmCd Or ADC("OmCmCtg") = "S") Then
          If wb_RetVch = False Then '5716 exlusivity check not needed for return entry
            wDmAllowStr = GetDmAllowStr(ms_DmTcTyp, pv_rsSrcOd!OdDmCd, IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, wDmDefSz))
            If moCn.GetFldVal(wDmAllowStr) = "N" Then
            ws_ErrMsg = "Invalid Dsg Cd/ Dsg On Hold/ Dsg Is Exclusive For Another Cust Or Regn"
            wb_Errinsrvrcpy = True: GoTo NextOd
          End If
          End If
        End If
      End If
     If FraDsgCpy.Visible = True Then
        SetParamsVal ws_DsgCpy_OdSr, wctOdSr
        SetParamsVal ws_DsgCpy_OdDmCd, woddmcd
        SetParamsVal ws_DsgCpy_OdSfx, wOdSfx
        SetParamsVal ws_DsgCpy_OdDmSz, wOdDmSz
        SetParamsVal ws_DsgCPy_OdBYy, wOdByy
        SetParamsVal ws_DsgCPy_OdBChr, wOdBChr
        SetParamsVal ws_DsgCPy_OdBNo, wOdBNo
        SetParamsVal ws_DsgCPy_OdOrdEnt, wOdOrdEnt
      End If

      
      wi_OdRow = .Row
      If Params(wOdCmPrdInst) = "" And Params(woddmcd) <> "" Then
         SetParamsVal moCn.GetFldVal("Select IsNull" + _
            "((Select CiCustPrdInst from CustInst where " + _
            "CiCtg = '" + ADC("OmCmCtg") + "' and CiCd = '" + ADC("OmCmCd") + "' and " + _
            "CiDmCtg = (select max(DmCtg) from DsgMst where DmCd = '" + Params(woddmcd) + "')) , " + _
            "(Select CmPrdInst from CustMst where CmCtg='" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "') )"), wOdCmPrdInst
      End If

      '4.1.3.0 - Sachin
    '  wi_Cnt = wi_Cnt + 1
      'ws_RunMsg = IIF(Trim(pv_CpyStr) <> "", "Copying from " + pv_CpyStr, "Copying Design " + IIF(pi_TotRecs <> 0, " Sr : " + CStr(.Value(wi_OdRow, "OdSr")), CStr(wi_Cnt)) + " of " + CStr(wi_TotCnt) + " ")
      
      If wi_TotCnt <= 1 Then
         ws_RunMsg = "Copying Design Sr : " + CStr(Params(wctOdSr)) + " "
      Else
         ws_RunMsg = "Copying Design " + CStr(wi_Cnt) + " of " + CStr(wi_TotCnt) + " "
      End If
                       
      '*** (Jen 2.13)

      Dim wFixPrc As String
      If FraStkCpy.Visible And ms_OmTcTyp = "JT" Then
        If pv_rsSrcOd!OdTc + "/" + pv_rsSrcOd!OdYy + "/" + pv_rsSrcOd!OdChr + "/" + CStr(pv_rsSrcOd!OdNo) + "/" + CStr(pv_rsSrcOd!OdSr) <> pv_rsSrcOd!qBaseRefVch And pv_rsSrcOd!qBaseRefVch <> "" Then
           
           ws_baseVch = Split(pv_rsSrcOd!qBaseRefVch, "/")
          
           wFixPrc = moCn.GetFldVal("Select OdFixPrc From OrdDsg " + _
                                            "  where OdCoCd='" + wCoCd + "' and OdTc='" + ws_baseVch(0) + "' and OdYy='" + ws_baseVch(1) + "' and OdChr='" + ws_baseVch(2) + "' " + _
                                            "  and  OdNo=" + ws_baseVch(3) + " and OdSr=" + ws_baseVch(4))
        End If
      End If


      mf_CpySalPrc = False
      If pv_CpyFrRet Then
        Call InitCpySalPrcVar(pv_CpyFrRet, wFixPrc, pv_rsSrcOd!IdFixPrc)
      Else
        Call InitCpySalPrcVar(pv_CpyFrRet, wFixPrc, "")
      End If
      If pv_CpyFrRet = True Then
        SetParamsVal pv_rsSrcOd!RedSr, wctOdSr
      End If
      '*** (Jen 2.13)
                     
      '****** Sachin 2.12 16/12/05 Copy FG Bags In QB
      If pv_OrdCpy = True And pv_CpyBags = True Then
        mf_CpyFrSameCust = (moCn.GetFldVal("Select OmCmCd From OrdMst Where OmCoCd='" + pv_rsSrcOd!OdCoCd + "' " + _
                              " And OmTc='" + pv_rsSrcOd!OdTc + "' And OmYy='" + pv_rsSrcOd!OdYy + "' And OmChr='" + pv_rsSrcOd!OdChr + "' And OmNo=" + CStr(pv_rsSrcOd!OdNo)) = ADC("OmCmCd") + " And OmPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OmPrtKey"))
      End If
      '****** Sachin 2.12 16/12/05 Copy FG Bags In QB
                 
      '*** (Jen 2.11)
      If (ms_OmTcTyp = "QB" Or ms_OmTc = "sri") And pv_OrdCpy = True Then
        If pv_CpyBags = False Then
          SetParamsVal pv_rsSrcOd!OdBYy, wOdByy
          SetParamsVal pv_rsSrcOd!OdBChr, wOdBChr
          SetParamsVal pv_rsSrcOd!OdBNo, wOdBNo
'          SetParamsVal pv_rsSrcOd!OdBYy + "/" + pv_rsSrcOd!OdBChr + "/" + Trim(CStr(pv_rsSrcOd!OdBNo)), wOdBag
        ' ****** Sachin 2.12 16/12/05 - Copy FG Bags in QB
        Else
          SetParamsVal pv_rsSrcOd!BYy, wOdByy
          SetParamsVal pv_rsSrcOd!BChr, wOdBChr
          SetParamsVal pv_rsSrcOd!BNo, wOdBNo
 '         SetParamsVal pv_rsSrcOd!BYy + "/" + pv_rsSrcOd!BChr + "/" + Trim(CStr(pv_rsSrcOd!BNo)), wOdBag
        End If
        ' ****** Sachin 2.12 16/12/05 - Copy FG Bags in QB
      End If
      '*** (Jen 2.11)
      
      If Params(wOdSfx) = pv_rsSrcOd!OdSfx Then
