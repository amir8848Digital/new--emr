Private Sub GrdOrdCT_InitKey(ByVal RowNum As Integer)
  '*** Initialise Key Fields
  With GrdOrdCT
    .Store "OctCoCd", ms_OmCoCd
    .Store "OctTc", ADC("OmTc")
    .Store "OctYy", ADC("OmYy")
    .Store "OctChr", ADC("OmChr")
    .Store "OctNo", ADC("OmNo")
    .Store "OctSr", GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")
    '.Store "OctSrNo", GrdOrdDsg.Value(GrdOrdCT.Row, "OctSrNo") '*** Jay 2.14Next *** [Multiple Comp in One BCHR]
    
    '****** Sachin 3.02 - Id Fields Change
    If .IsNew(RowNum) Then
      .Store "OctOdIdNo", moCn.GetFldVal("Select OdIdNo From OrdDsg " + _
                                      "Where OdCoCd='" + ms_OmCoCd + "' And OdTc='" + ADC("OmTc") + "' " + _
                                      " And OdYy='" + ADC("OmYy") + "' And OdChr='" + ADC("OmChr") + "' And OdNo='" + CStr(ADC("OmNo")) + "'" + _
                                      " And OdSr=" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and OdPrtKey='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") + "'")
    End If
    
  End With
End Sub
'*** Jay 2.13(CT) ***
Private Sub GrdOrdCT_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  With GrdOrdCT
    Select Case UCase(ColName)
      Case Is = UCase("OctRmWt")
        If .Mode = fgmnorm Then
        
          If UCase(SourceColName) = UCase("OctRmCd") Then
            Dim wOldRmCtg As String, wNewRmCtg As String, NewRmCtg As String, wOldSpGrav As Single, wNewSpGrav As Single
            '****** Sachin 3.02.0 - Partition Key added
            wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OctPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "'", ""))
            wNewRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + .Value(RowNum, "OctRmCd") + "' " + IIF(.Value(RowNum, "OctPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "'", ""))
            If Trim(wOldRmCtg) = wNewRmCtg And OldVal <> "" Then
              wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OctPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "'", ""))
              wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OctRmCd") + "' " + IIF(.Value(RowNum, "OctPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "'", ""))
              .Value(RowNum, "OctRmWt") = MWLib.Div(.Value(RowNum, "OctRmWt") * wNewSpGrav, wOldSpGrav)
            End If
          End If
        End If
    End Select
  End With
End Sub
