Private Sub cmdBulkCpyGo_Click()
  Dim wBagStr As String, wBagArr() As String, wBagNo As String, ws_BagNo() As String
  Dim i As Integer, ErrMsg As String
  
  If GrdOrdDsg.Rows > 1 Then
    DispMsg "Cannot use Bulk copy when there are Designs in the Grid", etError
    Exit Sub
  End If

  If ADC("wBagSel") = "" Then DispMsg "Please enter list of Bag Nos to use for Bulk Copy", etError: Exit Sub
  
  wBagStr = ADC("wBagSel")
  If Left(wBagStr, 1) = "," Or Right(wBagStr, 1) = "," Then _
                DispMsg "Invalid Bag list format", etError: Exit Sub
  
  wBagArr = Split(wBagStr, ",")
  Dim wTotalBagCount As Long
  wTotalBagCount = UBound(wBagArr)
  Dim wTotalRecCopied As Long
  For i = 0 To wTotalBagCount
    wBagNo = wBagArr(i)
    ws_BagNo = Split(wBagNo, "/")
    If UBound(ws_BagNo) <> 3 Then DispMsg "Invalid Bag Format " + wBagNo, etError: Exit Sub
    If Not IsNumeric(ws_BagNo(3)) Then DispMsg "Invalid Bag No " + wBagNo, etError: Exit Sub
    If Len(ws_BagNo(0)) > 3 Then DispMsg "Invalid Bag Company Code " + wBagNo, etError: Exit Sub
    If Len(ws_BagNo(1)) > 2 Then DispMsg "Invalid Bag Year " + wBagNo, etError: Exit Sub
    If Len(ws_BagNo(2)) > 3 Then DispMsg "Invalid Bag Character " + wBagNo, etError: Exit Sub
  Next
  On Error GoTo ErrH
  ADC.SaveRec
  MWLib.BeginProcess Me, "Starting Copying"
  moCn.Execute ("exec XeroxBulkcopy 2,'" + ADC("WBAGSEL") + "','','','','',0," + "'" + ms_OmCoCd + "','" + ADC("OmYy") + "','" + ADC("OmTc") + "','" + ADC("OmChr") + "'," + CStr(ADC("OmNo")))
  MWLib.EndProcess Me
  wTotalRecCopied = moCn.GetFldVal("Select count('a') from OrdDsg where OdCoCd = '" + ms_OmCoCd + "' and OdYy ='" + ADC("OmYy") + "' and OdTc ='" + ADC("OmTc") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")))
  MsgBox ("Copy Completed. Copied " + CStr(wTotalRecCopied) + " records of " + CStr(wTotalBagCount + 1) + ". Click Save and re-open the voucher.")
  Call CmdOrdCpy_Click
  Exit Sub
ErrH:
  moCn.Execute ("Delete from OrdDsg where OdCoCd= '" + ADC("OmCoCd") + "' and OdYy='" + ADC("OmYy") + "' and OdTc='" + ADC("OmTc") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")))
  MsgBox ("Unable to do Bulk Copy. Encountered error during Copy. ") + Err.Description
  MWLib.EndProcess Me
End Sub

Private Sub CmdCertDetSelGo_Click()
'mw.132 Find records from CertDet table and display result to grid
  Dim w_rsCertDetSel As MwfLib.MDORowSet
  Dim wCertDetCnd As String, i As Integer
  
  GrdCertDet.Visible = True
  GrdCustSel.Visible = False
  FraCustSelDet.Visible = False
  
  ' condition for certificate Lkup scope
  wCertDetCnd = ""
  If ADC("wLkUpBCoCd") <> "" Then wCertDetCnd = IIF(wCertDetCnd <> "", wCertDetCnd + " and ", "") + "CdBCoCd='" + ADC("wLkUpBCoCd") + "' "
  If ADC("wLkUpBYy") <> "" Then wCertDetCnd = IIF(wCertDetCnd <> "", wCertDetCnd + " and ", "") + "CdBYy='" + ADC("wLkUpBYy") + "' "
  If ADC("wLkUpBChr") <> "" Then wCertDetCnd = IIF(wCertDetCnd <> "", wCertDetCnd + " and ", "") + "CdBChr='" + ADC("wLkUpBChr") + "' "
  If ADC("wLkUpBNo") <> 0 Then wCertDetCnd = IIF(wCertDetCnd <> "", wCertDetCnd + " and ", "") + "CdBNo=" + CStr(ADC("wLkUpBNo"))
  If ADC("wLkUpCertNo") <> "" Then wCertDetCnd = IIF(wCertDetCnd <> "", wCertDetCnd + " and ", "") + "(CdCertNo LIKE  '%" + ADC("wLkUpCertNo") + "%')"

  'selecting records from CertDet table as per values in scope
  Set w_rsCertDetSel = moCn.OpenRes("select CdBCoCd ,CdBYy ,CdBChr ,CdBNo ,CdCertNo " + _
                              "from CertDet where CdCtg='B'  " + IIF(wCertDetCnd <> "", " and ", "") + wCertDetCnd)
  
  'copy date to grid
  GrdCertDet.Rows = 1
  With GrdCertDet
    .StartCopy
    Do While Not (w_rsCertDetSel.EOF Or w_rsCertDetSel.BOF)
      .AddItem
      i = .Rows - 1
      If Trim(w_rsCertDetSel!CdBCoCd) = "" And Trim(w_rsCertDetSel!CdBYy) = "" And Trim(w_rsCertDetSel!CdBChr) = "" And Trim(w_rsCertDetSel!CdBNo) = 0 Then
        .Value(i, "wCertBagNo") = ""
      Else
        .Value(i, "wCertBagNo") = Trim(w_rsCertDetSel!CdBCoCd) + "/" + Trim(w_rsCertDetSel!CdBYy) + "/" + Trim(w_rsCertDetSel!CdBChr) + "/" + CStr(Trim(w_rsCertDetSel!CdBNo))
      End If
      .Value(i, "wCertNo") = w_rsCertDetSel!CDCERTNO
      w_rsCertDetSel.MoveNext
    Loop
    .EndCopy
  End With

End Sub
