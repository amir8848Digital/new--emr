Private Sub CmdUpdPDCM_Click()
Dim wRs_Inv As MwfLib.MDORowSet, ws_SQL As String
Dim wRs_InvPL As MwfLib.MDORowSet, ws_PLSQL As String
Dim wUpdCnd As String, wDmJoin As String
Dim wOdRow, i As Integer
Dim wDispCnd As String
On Error GoTo ErrH
wUpdCnd = ""
mb_UpdPDCMAddingNewDesign = False
mb_UpdPDCM = False
If ADC("wScInYyFr") <> "" Then wUpdCnd = wUpdCnd + " and IdYy>='" + ADC("wScInYyFr") + "'"
If ADC("wScInChrFr") <> "" Then wUpdCnd = wUpdCnd + " and IdChr>='" + ADC("wScInChrFr") + "'"
If ADC("wScInNoFr") > 0 Then wUpdCnd = wUpdCnd + " and IdNo>=" + CStr(ADC("wScInNoFr")) + ""
If ADC("wScInYyTo") <> "" Then wUpdCnd = wUpdCnd + " and IdYy<='" + ADC("wScInYyTo") + "'"
If ADC("wScInChrTo") <> "" Then wUpdCnd = wUpdCnd + " and IdChr<='" + ADC("wScInChrTo") + "'"
If ADC("wScInNoTo") > 0 Then wUpdCnd = wUpdCnd + " and IdNo<=" + CStr(ADC("wScInNoTo")) + ""
If wUpdCnd <> "" And (ADC("wScInCoCd") = "" Or ADC("wScInTc") = "") Then
  MsgBox "Filter entered for Invoice Yy, Chr, No. A valid CoCd and Tc must be selected in Scope frame to apply these filters"
  Exit Sub
End If
If ADC("wScDsgNwEx") = "" Then
  MsgBox "Please select if you want to update 'New Designs\Existing designs' in Scope frame to proceed with PDCM update"
  Exit Sub
  
End If
'sv.71 deleting old error message once copy started
moCn.Execute ("Delete from OrdCpyErr where OceCoCd= '" + ms_OmCoCd + "' and OceTc= '" + ADC("OmTc") + "' and OceYy= '" + ADC("OmYy") + "' and " + _
                 "OceChr= '" + ADC("OmChr") + "' and OceNo= " + CStr(ADC("OmNo")) + " and OcePrtKey = '" + ctCurrPrtn + "'")
mi_ErrSr = 0

If ADC("wScInCoCd") <> "" Then wUpdCnd = wUpdCnd + " and IdCoCd='" + ADC("wScInCoCd") + "'"
If ADC("wScInTc") <> "" Then wUpdCnd = wUpdCnd + " and IdTc='" + ADC("wScInTc") + "'"
If ADC("wScInDtFr") <> "" And ADC("wScInDtFr") <> "01/01/80" Then wUpdCnd = wUpdCnd + " and InDt>='" + CStr(ADC("wScInDtFr")) + "'"
If ADC("wScInDtTo") <> "" And ADC("wScInDtTo") <> "01/01/80" Then wUpdCnd = wUpdCnd + " and InDt<='" + CStr(ADC("wScInDtTo")) + "'"
'Global.3 update for Existing designs.
'selecting latest invoice record for given Design code, suffix, and Sz. with condition
mf_CpyRate = True
mf_CpyVal = True
mf_CpyLabRate = True
If ADC("wCpyRtOpt") <> "" Then _
ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wCpyRtOpt") + "' ")
mCpyInvDetsSpclErrMsg = ""
Dim wFullErrMsg As String

If ADC("wScDsgNwEx") = "Y" Then
  wDispCnd = "updated for existing Designs. " + IIF(wUpdCnd <> "", "Invoice Filter :" + wUpdCnd, "No filters. Displayed rows will be updated from all Invoice till date.")
  If MsgBox("PDCM will be " + wDispCnd, vbOKCancel) = vbOK Then
     mb_UpdPDCM = True
     wOdRow = GrdOrdDsg.Rows
     MWLib.BeginProcess Me, "Starting Update"
     BeginEmrProcess Me, "Starting Update"   '578.40
     For i = 1 To wOdRow - 1
       MWLib.RunningProcess "Updating " + CStr(i) + " of " + CStr(wOdRow)
       
       GrdOrdDsg.Row = i
       ws_SQL = "Select top 1 * from InvDsg " + _
               "Join InvHd On InCoCd=IdCoCd and InTc=IdTc and InYy=IdYY and InChr=IdChr and InNo=IdNo and InIdNo=IdInIdNo " + _
               "and InPrtKey=IdPrtkey where IdDmCd='" + GrdOrdDsg.Value(i, "OdDmCd") + "' and " + _
               "IdSfx='" + GrdOrdDsg.Value(i, "OdSfx") + "'" + IIF(GrdOrdDsg.Value(i, "OdDmSz") = "", "", " and IdDmSz='" + GrdOrdDsg.Value(i, "OdDmSz") + "' ") + _
               IIF(ADC("OmCmCd") = "ZSELF", "", " and IdExpCmCd='" + ADC("OmCmCd") + "' ") + _
               " and '" + ADC("OmCmCurCd") + "'=(select CmCurCd from CustMst where CmCtg= '" + _
               ADC("OmCmCtg") + "' and CmCd= InCmCd) " + _
               wUpdCnd + " Order By InDt Desc, InCoCd Desc, InTc Desc, InYy Desc, InChr Desc, InNo Desc, IdSr Desc"
    
       Set wRs_Inv = moCn.OpenRes(ws_SQL)
       If Not (wRs_Inv.EOF Or wRs_Inv.BOF) Then
         GrdOrdRm.DelAllRecs
         GrdOrdLab.DelAllRecs
         Call CpyInvDets(wRs_Inv)
         wFullErrMsg = wFullErrMsg + mCpyInvDetsSpclErrMsg
       End If
     Next
     EndEmrProcess Me  '578.40
     MWLib.EndProcess Me
  End If
  mb_UpdPDCM = False
  'Global.3 update for New designs
ElseIf ADC("wScDsgNwEx") = "N" Then
  wFullErrMsg = ""
  mb_UpdPDCMAddingNewDesign = True
  If ADC("wScDmCdFr") <> "" Then wUpdCnd = wUpdCnd + " and IdDmCd>='" + ADC("wScDmCdFr") + "'"
  If ADC("wScDmCdTo") <> "" Then wUpdCnd = wUpdCnd + " and IdDmCd<='" + ADC("wScDmCdTo") + "'"
  If ADC("wScDmCtgFr") <> "" Or ADC("wScDmCtgTo") <> "" Then
    wDmJoin = " and exists(Select 'x' from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' and DmCd= IdDmCd and DmSz='' " + IIF(ADC("wScDmCtgFr") <> "", " and DmCtg>='" + ADC("wScDmCtgFr") + "'", "") + _
                IIF(ADC("wScDmCtgTo") <> "", " and DmCtg<='" + ADC("wScDmCtgTo") + "'", "") + ")"
  Else
    wDmJoin = ""
  End If
  wDispCnd = wUpdCnd + IIF(ADC("wScDmCtgFr") <> "", " and DmCtg>='" + ADC("wScDmCtgFr") + "'", "") + _
                IIF(ADC("wScDmCtgTo") <> "", " and DmCtg<='" + ADC("wScDmCtgTo") + "'", "")
                
  wDispCnd = "New designs will be added to PDCM. " + IIF(wDispCnd <> "", "Invoice Filter :" + wDispCnd, "No filters, all new Designs will be added.")
  If MsgBox(wDispCnd, vbOKCancel) = vbOK Then
    mb_UpdPDCM = True
    
    'Finding design code,suffix for the given condition and checking whether that records are exist in PDCM database or not
    'If not in PDCM database then selecting those records
    ws_PLSQL = "Select * from " + _
              "(Select IdDmCd ,IdSfx from InvDsg Join InvHd On InCoCd=IdCoCd and InTc=IdTc and InYy=IdYY and InChr=IdChr and InNo=IdNo and InIdNo=IdInIdNo and InPrtKey=IdPrtkey " + _
              "where '" + ADC("OmCmCurCd") + "'=(select CmCurCd from CustMst where CmCtg= '" + _
              ADC("OmCmCtg") + "' and CmCd= InCmCd)  " + _
              IIF(ADC("OmCmCd") = "ZSELF", "", " and IdExpCmCd='" + ADC("OmCmCd") + "' ") + _
              wUpdCnd + " group by IdDmCd ,IdSfx ) tmp " + _
              " left outer join OrdDsg on OdDmCd=IdDmCd and OdSfx=IdSfx and OdDmSz ='' and OdTc ='PL' " + _
              " and OdYy ='" + ADC("OmYy") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")) + " where IdDmCd <>isnull(OdDmCd,'')" + wDmJoin
  
    Set wRs_InvPL = moCn.OpenRes(ws_PLSQL)
    
    'getting latest Invoice reocrd for that selected range (which are not in PDCM database)
    If wRs_InvPL.RecCount > 0 Then
      wRs_InvPL.MoveFirst
      MWLib.BeginProcess Me, "Starting Update"
      BeginEmrProcess Me, "Starting Update"   '578.40
      Dim mk As Long
      Dim wTot As Long
      wTot = wRs_InvPL.RecCount
      Do While Not (wRs_InvPL.BOF Or wRs_InvPL.EOF)
        mk = mk + 1
        MWLib.RunningProcess "Updating " + CStr(mk) + " of " + CStr(wTot)
        ws_SQL = "Select top 1 * from InvDsg " + _
                "Join InvHd On InCoCd=IdCoCd and InTc=IdTc and InYy=IdYY and InChr=IdChr and InNo=IdNo and InIdNo=IdInIdNo and InPrtKey=IdPrtkey " + _
                "where IdDmCd='" + wRs_InvPL!IdDmCd + "' and IdSfx='" + wRs_InvPL!IdSfx + "' " + _
                IIF(ADC("OmCmCd") = "ZSELF", "", " and IdExpCmCd='" + ADC("OmCmCd") + "' ") + _
                " and '" + ADC("OmCmCurCd") + "'=(select CmCurCd from CustMst where CmCtg= '" + _
                ADC("OmCmCtg") + "' and CmCd= InCmCd) " + _
                wUpdCnd + " Order By InDt Desc, InCoCd Desc, InTc Desc, InYy Desc, InChr Desc, InNo Desc, IdSr Desc"
   
        Set wRs_Inv = moCn.OpenRes(ws_SQL)
      
        If Not (wRs_Inv.EOF Or wRs_Inv.BOF) Then
          ADC.StartCopy
          Call CpyInvDets(wRs_Inv)
          wFullErrMsg = wFullErrMsg + mCpyInvDetsSpclErrMsg
  
        End If
        wRs_InvPL.MoveNext
      Loop
      EndEmrProcess Me  '578.40
      MWLib.EndProcess Me
    End If
    mb_UpdPDCM = False
    mb_UpdPDCMAddingNewDesign = False
  End If
End If
If wFullErrMsg <> "" Then
  wFullErrMsg = IIF(wFullErrMsg <> "", "Error while processing ", "") + wFullErrMsg
  MsgBox wFullErrMsg
  DispMsg wFullErrMsg, etError
End If
ErrH:
  MWLib.EndProcess Me
  mb_UpdPDCM = False
  mb_UpdPDCMAddingNewDesign = False
  Call ShowMsgBoxForErr       '578.40 show msgbox if any error captured
  Call CmdOrdCpy_Click
End Sub
Private Sub cmdXeroxCpyGo_Click()
  Dim wTotalRecCopied As Long
  If GrdOrdDsg.Rows > 1 Then
    DispMsg "Cannot use Xerox Copy when there are Designs in the Grid", etError
    Exit Sub
  End If
  
  If ADC("WOCOCD") = "" Or ADC("wOmYy") = "" Or ADC("wOmTc") = "" Or ADC("wOmChr") = "" Or ADC("wOmNo") = 0 Then
    DispMsg "Please provide Source Yy, Tc, Chr and No to Xerox copy from", etError
    Exit Sub
  End If
  
  Dim wf_IsSourceMrpChr As Boolean
  wf_IsSourceMrpChr = IIF(moCn.GetFldVal("Select PValue from Param where PTyp ='TC' and PMCd='" + ADC("wOmTc") + "'") = ctJtTcTyp And moCn.GetFldVal("Select vPValue3  from vParam where vPTyp = 'CHR' and vPCoCd='" + ADC("wOCoCd") + "' and vPMCd='" + _
         ADC("wOmTc") + "' and vPSCd='" + ADC("wOmChr") + "'") = "Y", True, False)
  
  If wf_IsSourceMrpChr <> mf_MrpChr Then
    DispMsg "Cannot use Xerox copy, Source and Target Currencies must both be MRP or regular vouchers", etError
    Exit Sub
  End If
  
  If ADC("wOmTc") = "IN" Then
    DispMsg "Cannot use Xerox copy to copy from Invoice", etError
    Exit Sub
  End If
  
  
'  If moCn.GetFldVal("Select PValue from Param where PTyp ='TC' and PMCd='" + ADC("wOmTc") + "'") <> ctJtTcTyp Then
 '   DispMsg "Cannot use Xerox copy when Source is not a jEmr Tc", etError
  '  Exit Sub
'  End If
  
  If Not moCn.RecSeek("Select 'x' from OrdMst where OmCoCd= '" + ADC("woCoCd") + "' and " + _
          "OmTc= '" + ADC("wOmTc") + "' and OmYy= '" + ADC("wOmYy") + "' and OmChr= '" + ADC("wOmChr") + "' and " + _
          "OmNo= " + CStr(ADC("wOmNo")) + " and OmCmCurCd= '" + ADC("OmCmCurCd") + "' And OmPrtKey='" + ctCurrPrtn + "' ") Then
    DispMsg "Cannot use Xerox copy when Source And Target Currencies Are Not Matching", etError
    Exit Sub
  End If

  ADC.SaveRec
  MWLib.BeginProcess Me, "Starting Copying"
  On Error GoTo ErrH
  
  moCn.Execute ("exec XeroxBulkcopy 1,'','" + ADC("WOCOCD") + "','" + ADC("wOmYy") + "','" + ADC("wOmTc") + "','" + ADC("wOmChr") + "'," + CStr(ADC("wOmNo")) + ",'" + ADC("OmCoCd") + "','" + ADC("OmYy") + "','" + ADC("OmTc") + "','" + ADC("OmChr") + "'," + CStr(ADC("OmNo")))
  MWLib.EndProcess Me
  wTotalRecCopied = moCn.GetFldVal("Select count('a') from OrdDsg where OdCoCd = '" + ADC("OmCoCd") + "' and OdYy ='" + ADC("OmYy") + "' and OdTc ='" + ADC("OmTc") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")))
  MsgBox ("Copy Completed. Copied " + CStr(wTotalRecCopied) + " records. Click Save and re-open the voucher")
  Call CmdOrdCpy_Click
  Exit Sub
ErrH:
  MsgBox ("Unable to do Xerox Copy. Encountered error during Copy.") + Err.Description
    moCn.Execute ("Delete from OrdDsg where OdCoCd= '" + ADC("OmCoCd") + "' and OdYy='" + ADC("OmYy") + "' and OdTc='" + ADC("OmTc") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")))

  MWLib.EndProcess Me
End Sub

