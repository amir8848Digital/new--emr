Private Sub SetParamsValCT(pv_Val As Variant, ps_Name As Integer)
  Dim ws_Mask As String
  pv_Val = LTrim(RTrim(pv_Val))
  
  ws_Mask = SetMaskOrdCT(ps_Name)
  If Mid(ws_Mask, 1, 1) = "-" Then
      ws_Mask = Mid(ws_Mask, 2)
  End If
   If ws_Mask <> "" Then
      pv_Val = Format(pv_Val, ws_Mask)
   End If

  m_objCmdCT.QryParameters(ps_Name) = pv_Val
End Sub

Private Function SetMaskOrdCT(ps_Name As Integer) As String
  Const wMaskwOctRmWt = "###0.000"
  Const wMaskwOctParts = "##0"

  If ps_Name = wOctParts Then
    SetMaskOrdCT = wMaskwOctParts
  ElseIf ps_Name = wOctRmWt Then
    SetMaskOrdCT = wMaskwOctRmWt
  Else
    SetMaskOrdCT = ""
  End If
End Function

