          Do While Not (wo_rsSrcOl.EOF Or wo_rsSrcOl.BOF)
UpdateEmrProcess "CpyDets OrdDsg Copy In Progress...Row: " + CStr(GrdOrdDsg.Rows - 1) + "::OrdLab: " + CStr(wi_LabRow)

            .AddItem
            wi_LabRow = .Rows - 1
