      wi_OdRow = .Row

       '.Value(wi_OdRow, "OdDmSz") = IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, ""))
      
         mf_CpySalPrc = False
      ' ******* Bef 3.03 *********
