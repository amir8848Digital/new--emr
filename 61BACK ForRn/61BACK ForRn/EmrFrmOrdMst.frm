          If GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmCopyOver Or GrdOrdRm.Mode = fgmdel Then
            ' ***** Manali Trading Module
             If ms_OmTcTyp = "JT" Then
                    .Value(.Row, "OdMinDiaTolWt") = 0
                    .Value(.Row, "OdMaxDiaTolWt") = 0
             Else
             ' ***** Manali Trading Module
               Dim wTotDiaWt As Single, wMinTolWt As Single, wMaxTolWt As Single
               Dim wRs_TolWt As MDORowSet
               
               wTotDiaWt = 0#
               For i = 1 To GrdOrdRm.Rows - 1
                 If Not GrdOrdRm.IsDel(i) Then
                   wTotDiaWt = wTotDiaWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D", GrdOrdRm.Value(i, "OrPrdWt"), 0)
                 End If
               Next i
               
               If GrdOrdRm.Mode = fgmCopyOver Or (wTotDiaWt < .Value(.Row, "OdMinDiaTolWt") Or wTotDiaWt > .Value(.Row, "OdMaxDiaTolWt")) Or UCase(SourceColName) = UCase("OdFixPrc") Then
                 ' ***** Manali Trading Module - 'SPL' - 'C' Replaced By adc("OmCmCtg")
                 Set wRs_TolWt = moCn.OpenRes("Select Top 1 " + _
                                            "(Case when ('" + .Value(.Row, "OdIWtEqOrd") + "'='Y' or '" + .Value(.Row, "OdFixPrc") + "'='Y' Or ('" + .Value(.Row, "OdIWtEqOrd") + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMinTol Else RrOpnMinTol End) as qMinTolWt, " + _
                                            "(Case when ('" + .Value(.Row, "OdIWtEqOrd") + "'='Y' or '" + .Value(.Row, "OdFixPrc") + "'='Y' Or ('" + .Value(.Row, "OdIWtEqOrd") + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMaxTol Else RrOpnMaxTol End) as qMaxTolWt " + _
                                           "From RmRt Left Outer Join Param On  PTyp='IWTFRORD' and PMCd='" + .Value(.Row, "OdIWtFrOrd") + "'  " + _
                                           "Where (RrCmCurCd='" + ADC("OmCmCurCd") + "' Or RrCmCurCd='') and RrTcTyp='WTT'  and RrCmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and RrCtg='D' and RrSCtg='' " + _
                                           "and " + CStr(wTotDiaWt) + " between round(RrFrLn,3) and round(RrToLn,3) " + _
                                           "And RrCmCd In ('" + ADC("OmCmCd") + "','" + ctSelfCmCd + "') And RrDmCd In ('" + .Value(.Row, "OdDmCd") + "','') " + _
                                           "Order By (Case when RrCmCd='" + ADC("OmCmCd") + "' Then 1 Else 2 End), " + _
                                           "(Case when RrCmCurCd<>'' Then  1 Else 2 End)," + _
                                           "(Case when RrDmCd='" + .Value(.Row, "OdDmCd") + "' Then 1 Else 2 End) ")
              
                  If wRs_TolWt.RecCount > 0 Then
                          Dim wHRndOffOdTolWtYn As Boolean
                     wHRndOffOdTolWtYn = moCn.RecSeek("Select 'x' from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "' And HRndOffOdTolWtYn='Y'")
                     If wHRndOffOdTolWtYn = True Then

                    '3.11.0
                      .Value(.Row, "OdMinDiaTolWt") = Fix((wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)) * 100) / 100
                      .Value(.Row, "OdMaxDiaTolWt") = Round((wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)) + 0.004, 2)
                    Else
                     .Value(.Row, "OdMinDiaTolWt") = wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)
                      .Value(.Row, "OdMaxDiaTolWt") = wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)
                    End If
                  ElseIf GrdOrdRm.Mode = fgmCopyOver Then
                    .Value(.Row, "OdMinDiaTolWt") = 0
                    .Value(.Row, "OdMaxDiaTolWt") = 0
                  End If
  
                 Set wRs_TolWt = Nothing
               End If
            End If
          End If
        End If
      End If
    ' ******** Manali 3.5.0 -  Diamond Tolerance at Order Level
    
    Case Is = UCase("OdMaxDiaTolWt")
      ' ***** recalc for this is written in "OdMinDiaTolWt"
      
      
    ' ******** Manali 3.5.0 - 14/05/09 - Per Pc Dia Qty/Wt on Od Footer and "DHC" and "CHC"
    Case Is = UCase("wOdPerPcDiaWt")
      Dim wPerPcDiaWt As Single
      wPerPcDiaWt = 0#
      If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmdel Or GrdOrdRm.Mode = fgmCopyOver Or GrdOrdRm.Mode = fgmInitOver) Then
         
         For i = 1 To GrdOrdRm.Rows - 1
            If Not GrdOrdRm.IsDel(i) Then
              wPerPcDiaWt = wPerPcDiaWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D", GrdOrdRm.Value(i, "OrWt"), 0)
            End If
         Next i
        .Value(.Row, "wOdPerPcDiaWt") = wPerPcDiaWt
      End If
      
    ' ******** Manali 3.5.0 - 14/05/09 - Per Pc Dia Qty/Wt on Od Footer
    Case Is = UCase("wOdPerPcDiaQty")
      Dim wPerPcDiaQty As Integer
      wPerPcDiaQty = 0#
      If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmdel Or GrdOrdRm.Mode = fgmCopyOver Or GrdOrdRm.Mode = fgmInitOver) Then
         For i = 1 To GrdOrdRm.Rows - 1
            If Not GrdOrdRm.IsDel(i) Then
              wPerPcDiaQty = wPerPcDiaQty + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D", GrdOrdRm.Value(i, "OrQty"), 0)
            End If
         Next i
        .Value(.Row, "wOdPerPcDiaQty") = wPerPcDiaQty
      End If
   ' ******** Manali 3.5.0 - 14/05/09 - Per Pc Dia Qty/Wt on Od Footer
  
    ' ******** Manali 3.5.0 - 14/05/09 - "DHC" and "CHC"
    Case Is = UCase("wOdPerPcCSWt")
      Dim wPerPcCSWt As Single
      wPerPcCSWt = 0#
      If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmdel Or GrdOrdRm.Mode = fgmCopyOver Or GrdOrdRm.Mode = fgmInitOver) Then
         For i = 1 To GrdOrdRm.Rows - 1
            If Not GrdOrdRm.IsDel(i) Then
              wPerPcCSWt = wPerPcCSWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "C", GrdOrdRm.Value(i, "OrWt"), 0)
            End If
         Next i
        .Value(.Row, "wOdPerPcCSWt") = wPerPcCSWt
      End If
      ' ******** Manali 3.5.0 - 14/05/09 - "DHC" and "CHC"
                         
                         
    ' ****** Manali Trading Module
    Case Is = UCase("OdBaseIdKey")
    If ADC.Mode = xNorm Or ADC.Mode = xCopy Then
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        If .Value(RowNum, "wOdBaseVchSr") <> "" Then
          wOdKeyArr = Split(.Value(RowNum, "wOdBaseVchSr"), "/")
          If UBound(wOdKeyArr) = 4 Then
          wOdTc = wOdKeyArr(0)
          wOdYy = wOdKeyArr(1)
          wOdChr = wOdKeyArr(2)
          wOdNo = wOdKeyArr(3)
          wOdSr = wOdKeyArr(4)
          'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
          .Value(RowNum, "OdBaseIdKey") = moCn.GetFldVal("Select OdIdNo from OrdDsg Where OdCoCd='" + IIF(ms_OmTc = "JIN" Or ms_OmTc = "LIN", ADC("OmBaseCoCd"), ms_OmCoCd) + "' and OdTc='" + wOdTc + "' " + _
                                          " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                          " and OdPrtKey='" + ctCurrPrtn + "' ")
          End If
        Else
          .Value(RowNum, "OdBaseIdKey") = 0
        End If
      End If
    End If
    
    Case Is = UCase("OdRefIdKey")
    If ADC.Mode = xNorm Or ADC.Mode = xCopy Then
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        If .Value(RowNum, "wOdRefVchSr") <> "" Then
          wOdKeyArr = Split(.Value(RowNum, "wOdRefVchSr"), "/")
          If UBound(wOdKeyArr) = 4 Then
            wOdTc = wOdKeyArr(0)
            wOdYy = wOdKeyArr(1)
            wOdChr = wOdKeyArr(2)
            wOdNo = wOdKeyArr(3)
            wOdSr = wOdKeyArr(4)
            'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
            .Value(RowNum, "OdRefIdKey") = moCn.GetFldVal("Select OdIdNo from OrdDsg Where OdCoCd='" + ms_OmCoCd + "' and OdTc='" + wOdTc + "' " + _
                                            " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                            " and OdPrtKey='" + ctCurrPrtn + "' ")
          End If
        Else
          .Value(RowNum, "OdRefIdKey") = 0
        End If
      End If
    End If
    
    
    Case Is = UCase("wOdBaseVchSr")
'    If adc.Mode = xNorm Or adc.Mode = xCopy Then
'      If .Mode = fgminit Or .Mode = fgmCopy Then
    If ADC.Mode = xNorm Or ADC.Mode = xCopy Then
      If .Mode = fgminit Then
      
        If .Value(RowNum, "OdBaseIdKey") <> 0 Then
          .Value(RowNum, "wOdBaseVchSr") = moCn.GetFldVal("Select OdTc+'/'+OdYy+'/'+OdChr+'/'+Ltrim(Str(OdNo))+'/'+Ltrim(Str(OdSr)) " + _
                                          " from OrdDsg Where OdIdNo=" + CStr(.Value(RowNum, "OdBaseIdKey")) + " " + _
                                          " and OdPrtKey='" + ctCurrPrtn + "' ")
        End If
      End If
    End If
    
    Case Is = UCase("wOdRefVchSr")
    If (ADC.Mode = xNorm Or ADC.Mode = xCopy) Then
      If .Mode = fgminit Then
        If .Value(RowNum, "OdRefIdKey") <> 0 Then
          .Value(RowNum, "wOdRefVchSr") = moCn.GetFldVal("Select OdTc+'/'+OdYy+'/'+OdChr+'/'+Ltrim(Str(OdNo))+'/'+Ltrim(Str(OdSr)) " + _
                                          " from OrdDsg Where OdIdNo=" + CStr(.Value(RowNum, "OdRefIdKey")) + " " + _
                                          " and OdPrtKey='" + ctCurrPrtn + "' ")
        End If
      End If
    End If
    
    ' ****** Manali Trading Module
    
    Case Is = UCase("OdMrp")                '4.1.4
      wl_SourceGrdMode = Me.Controls(SourceName).Mode
      If (Not mf_MrpChr) And (Not mf_MRTChr) Then
        If (.Mode = fgmnorm Or .Mode = fgmCopy) Then
          .Value(RowNum, "OdMrp") = FnRndOff(.Value(RowNum, "OdCalcPrc") * .Value(RowNum, "OdMrpMulBy"), 2, _
                                    moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' and CmCd= '" + ADC("OmCmCd") + "'"))
        End If
      End If
    Case Is = UCase("OdJLVchVal")                '4.1.4
      wl_SourceGrdMode = Me.Controls(SourceName).Mode
      If (.Mode = fgmnorm Or .Mode = fgmCopy) Then
      If .Value(RowNum, "OdJLRateByQW") = "Q" Then
          .Value(RowNum, "OdJLVchVal") = .Value(RowNum, "OdJLQty") * .Value(RowNum, "OdJLVchRt")
      Else
          .Value(RowNum, "OdJLVchVal") = .Value(RowNum, "OdJLWt") * .Value(RowNum, "OdJLVchRt")
      End If
      End If
    Case Is = UCase("OdDmStkNo")
    If (.Mode = fgmnorm) Then
        If .IsNew(RowNum) Then
        If (.Value(RowNum, "OdDmStkYy") <> "" And .Value(RowNum, "OdDmStkChr") <> "" And .Value(RowNum, "OdDmStkCoCd") <> "") Then
          If (InStr(1, "," + ms_TCToAutoGenerateDmStkNum + ",", "," + ADC("OmTc") + ",") > 0) Then
            AutoGenDmStkNum RowNum, True
          End If
        End If
      End If
    End If
      
    'uma *** Repair GrWt
    Case Is = UCase("OdRepGrWt")
    If ADC("OMTC") = "JRI" Then
      If (.Mode = fgmnorm Or .Mode = fgmCopy) Then
          Dim W As Double
          If 1 = 1 Then
            i = moCn.GetFldVal("Select BQty from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
                                      "BCoCd = '" + .Value(RowNum, "OdDmStkCoCd") + "' and BOdDmCd='" + .Value(RowNum, "OdDmCd") + "' and BOdSfx='" + .Value(RowNum, "OdSfx") + _
                                      "' and BOdDmSz='" + .Value(RowNum, "OdDmSz") + "' and BYy = '" + .Value(RowNum, "OdDmStkYy") + _
                                      "' and BChr ='" + .Value(RowNum, "OdDmStkChr") + "' and BNo=" + CStr(.Value(RowNum, "OdDmStkNo")))
        
            W = moCn.GetFldVal("Select BGrWt from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
                                      "BCoCd = '" + .Value(RowNum, "OdDmStkCoCd") + "' and BOdDmCd='" + .Value(RowNum, "OdDmCd") + "' and BOdSfx='" + .Value(RowNum, "OdSfx") + _
                                      "' and BOdDmSz='" + .Value(RowNum, "OdDmSz") + "' and BYy = '" + .Value(RowNum, "OdDmStkYy") + _
                                      "' and BChr ='" + .Value(RowNum, "OdDmStkChr") + "' and BNo=" + CStr(.Value(RowNum, "OdDmStkNo")))
            If GrdOrdDsg.Value(RowNum, "OdOrdEnt") <= 0 Then
              .Value(RowNum, "OdRepGrWt") = 0
            Else
              .Value(RowNum, "OdRepGrWt") = (W / (IIF(i = 0, 1, i))) * GrdOrdDsg.Value(RowNum, "OdOrdEnt")
            End If
          End If
      End If
    End If
    If ADC("OMTC") = "JRO" Then
      If (.Mode = fgmnorm Or .Mode = fgmCopy) Then
              If .Value(RowNum, "wOdBaseVchSr") <> "" Then
                  wOdKeyArr = Split(.Value(RowNum, "wOdBaseVchSr"), "/")
                  If UBound(wOdKeyArr) = 4 Then
                    wOdTc = wOdKeyArr(0)
                    wOdYy = wOdKeyArr(1)
                    wOdChr = wOdKeyArr(2)
                    wOdNo = wOdKeyArr(3)
                    wOdSr = wOdKeyArr(4)
                    W = moCn.GetFldVal("Select OdRepGrWt from OrdDsg Where OdCoCd='" + IIF(ms_OmTc = "JIN" Or ms_OmTc = "LIN", ADC("OmBaseCoCd"), ms_OmCoCd) + "' and OdTc='" + wOdTc + "' " + _
                                            " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                            " and OdPrtKey='" + ctCurrPrtn + "' ")
                 End If
              End If
            'End If
            .Value(RowNum, "OdRepGrWt") = (W)
          End If
      End If
    Case Is = UCase("OdMrpMulBy")
    If (.Mode = fgmnorm Or .Mode = fgmCopy) Then
        If (.Value(RowNum, "OdMrpMulBy")) Then
          If mf_MrpChr Then
            .Value(RowNum, "OdMrpMulBy") = 1 - (.Value(RowNum, "OdMrpDisc") / 100)
          End If
        End If
    End If
    'End If
    
    End Select
  End With
End Sub
Private Sub GrdOrdDsg_ColChange(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  '*** OdDmCd           valid DmCd from DsgMst(DmTcTyp= ms_DmTcTyp and DmSz= '' and DmHld= 'N')
  '                     Show the Sketch and 3D pictures for the design in the current row of GrdOrdDsg
  '*** OdDmSz           valid PMCd('DMSZ') or ''
  '*** OdDelDt          >= OmDt
  '*** OdExpDelDt       >= OmDt
  '*** OdOrdEnt         >= 0
  '*** OdPrtCd          valid PMCd('PRTCD')
  '*** OdKt             valid PMCd('KT')
  '*** OdGldAsWt        In GrdOrdRm the OrSalVal value of the row with OrMainMet= 'Y' is changed
  '                     OrSalVal= OdGldAsWt* OrSalRt
  '                     In GrdOrdLab the OlSalVal value of the rows with OlQw= 'W' is changed
  '                     OlSalVal= OdGldAsWt* OlSalRt
  '                     In GrdOrdLab the OlCstVal value of the rows with OlCstQw= 'W' is changed
  '                     OlCstVal= OdGldAsWt* OlCstRt
  '*** OdLabAsWt        In GrdOrdRm the OrSalVal value of the row with OrMainMet= 'Y' is changed
  '                     OrSalVal= OdLabAsWt* OrSalRt
  '                     In GrdOrdLab the OlSalVal value of the rows with OlQw= 'W' is changed
  '                     OlSalVal= OdLabAsWt* OlSalRt
  '                     In GrdOrdLab the OlCstVal value of the rows with OlCstQw= 'W' is changed
  '                     OlCstVal= OdLabAsWt* OlCstRt
  
  Dim w3DPth As String, wHskPth As String     '*** (Jen 3.2.0)
  Dim wOlCstQw As String, wOlLabRt As Single, wWtRngChg As String, wOlQw As String
  Dim ws_PrdSeqArr() As String
  ' ***** Manali Trading Module
  Dim wOdBaseRefVchSr As String, wOdKeyArr() As String
  Dim wOdTc As String, wOdYy As String, wOdChr As String, wOdNo As Long, wOdSr As Integer
  ' ***** Manali Trading Module


  With GrdOrdDsg
    Select Case ColName
    Case Is = UCase("wOdBag")
    '*** (Jen 2.11)
      Dim ws_BagNo() As String

      If NewValue = "" Then Cancel = True: ErrMsg = "Bag Number Cannot Be Blank": Exit Sub
      If NewValue <> "" Then
        ws_BagNo = Split(NewValue, "/")
        If UBound(ws_BagNo) <> 2 Then Cancel = True: ErrMsg = "Invalid Bag Number Format": Exit Sub
        If Not IsNumeric(ws_BagNo(2)) Then Cancel = True: ErrMsg = "Invalid FG Bag No Format": Exit Sub
        ' ***** Manali Trading Module
        If ms_OmTc = "sri" Then
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And Not moCn.RecSeek("Select 'x' From Bag Where BCoCd= '" + ms_OmCoCd + "' and " + _
                                    "BYy= '" + ws_BagNo(0) + "' And " + _
                                    "BChr = '" + ws_BagNo(1) + "' And " + _
                                    "BNo= " + ws_BagNo(2) + " and BLoc = '" + ctFgLoc + "' And BPrtKey='" + ctCurrPrtn + "' " + _
                                    "and BCls='N' ")
          If Cancel = True Then ErrMsg = "Invalid Bag Number/ Bag Not In FG/ Bag Is Closed": Exit Sub
        Else
        ' ***** Manali Trading Module
          '****** Sachin 3.02 07-12-07 - Check On Current Partition
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And Not moCn.RecSeek("Select 'x' From Bag Where BCoCd= '" + ms_OmCoCd + "' and " + _
                                    "BYy= '" + ws_BagNo(0) + "' And " + _
                                    "BChr = '" + ws_BagNo(1) + "' And " + _
                                    "BNo= " + ws_BagNo(2) + " and BLoc = '" + ctFgLoc + "' And BPrtKey='" + ctCurrPrtn + "' ")
          If Cancel = True Then ErrMsg = "Invalid Bag Number/ Bag Not In FG": Exit Sub
        End If
      End If
         
      If .Mode = fgmnorm Then
        Dim wRs_Bag As MwfLib.MDORowSet
        '****** Sachin 3.02 07-12-07 - Bags From Current Partition
        Set wRs_Bag = moCn.OpenRes("Select BOdDmCd, BOdDmSz, BOdSfx From Bag Where " + _
                                   "BCoCd= '" + ms_OmCoCd + "' and " + _
                                   "BYy= '" + ws_BagNo(0) + "' and " + _
                                   "BChr = '" + ws_BagNo(1) + "' and " + _
                                   "BNo= " + ws_BagNo(2) + " and BLoc = '" + ctFgLoc + "' And BPrtKey='" + ctCurrPrtn + "'")
        
        Call GrdOrdDsg_ColChange(RowNum, UCase("OdDmCd"), wRs_Bag!BOdDmCd, Cancel, ErrMsg)
        If Cancel = True Then Exit Sub
        
        .Value(RowNum, "OdBYy") = ws_BagNo(0)
        .Value(RowNum, "OdBChr") = ws_BagNo(1)
        .Value(RowNum, "OdBNo") = ws_BagNo(2)
        
        If Not (wRs_Bag.EOF Or wRs_Bag.BOF) Then
          .Value(RowNum, "OdDmCd") = wRs_Bag!BOdDmCd
          .Value(RowNum, "OdDmSz") = wRs_Bag!BOdDmSz
          .Value(RowNum, "OdSfx") = wRs_Bag!BOdSfx
        End If
      End If
    '*** (Jen 2.11)
    Case Is = UCase("OdDmCd")
      '****** Sachin 3.02 07-12-07 - Designs From the Current Partition
      '****** Sachin Before 3.3.0 ******
      'Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And Not moCn.RecSeek("Select DmCd From DsgMst Where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                           "And DmHld = 'N' and DmCd = '" + NewValue + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' and " + _
                           "(DmCmCd= '' or DmCmCd= '" + ADC("OmCmCd") + "' or " + _
                           "(DmCmCd<> '" + ADC("OmCmCd") + "' and DmRegnExc= 'Y' and " + _
                           "(Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= DmCmCd) <> '" + ms_CmRegnCd + "')) ")
      '****** Sachin Before 3.3.0 ******
      '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******
      ' ***** Manali 350NXt - Check of Design and Region Exclusivity excluded for OmCMCd='ZSELF'
      ' ***** Manali Trading Module - Exclusivity Checked only for CmCtg='C'
      '4.1.3.0
 '         Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And Not moCn.RecSeek("Select DmCd From DsgMst Where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                             "And DmHld = 'N' and DmValidYN='Y' and DmCd = '" + NewValue + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' " + _
                             IIF(ms_OmTcTyp = "JT" Or adc("OmCmCd") = ctSelfCmCd Or adc("OmCmCtg") = "S", "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + adc("OmCmCd") + "'+',%' or " + _
                             "(','+DmCmCd+',' Not Like '%,'+'" + adc("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
