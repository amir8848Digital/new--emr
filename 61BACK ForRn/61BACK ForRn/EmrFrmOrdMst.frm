        If mf_CpyVal = True Then .Value(wi_OdRow, "OdGldAsWt") = (pv_rsSrcOd!IdIGldAsWt / pv_rsSrcOd!IdQty)
        
      End If
      .Value(wi_OdRow, "OdInvAllBags") = ADC("OmInvAllBags")
      If mf_CpyLabRate = True Then
        .Value(wi_OdRow, "OdLabAs") = pv_rsSrcOd!IdLabAs
