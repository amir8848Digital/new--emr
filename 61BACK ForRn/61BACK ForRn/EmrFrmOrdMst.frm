                   " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' ))") Then _
            wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Design is Region Exclusive / Customer not in Dsg Group."
        'End If
              'sv.45
          Dim ws_CmLkUpPDCM As String
