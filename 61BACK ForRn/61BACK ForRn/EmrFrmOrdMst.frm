Private Sub GrdOrdAmd_RowWhen(ByVal RowNum As Integer)
  '*** If GrdOrdAmd.IsNew Then OaSrNo= Max + 1
  With GrdOrdAmd
    If .Value(RowNum, "OaSrNo") = 0 Then _
       .Value(RowNum, "OaSrNo") = .MaxVal("OaSrNo") + 1
    If .IsNew(RowNum) Then
      .Value(RowNum, "OaPrtKey") = ctCurrPrtn   '****** Sachin 3.02 Default value for Partition Key field
      If ms_OmTcTyp = ctJtTcTyp Then .Value(RowNum, "OaPrdQty") = 0    ' ****** Manali Trading Module
    End If
  End With
End Sub
Private Sub GrdOrdAmd_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  
  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdAmd.Value(RowNum, "OaPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub
  
'  If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

' ***** Manali Trading Module
If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
  Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub

'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If
  
  If ColName = UCase("OaDt") And GrdOrdAmd.Value(RowNum, "OaDt") = "" Then GrdOrdAmd.Value(RowNum, "OaDt") = moCn.SrvrDate  '*** Jay 3.01 *** [OaDt= SrvrDt]
  
End Sub
Private Sub GrdOrdAmd_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  '*** OaPrdQty on OaOrdQty               Normal
      'OaPrdQty= OaOrdQty
  
  With GrdOrdAmd
    Select Case ColName
    Case Is = UCase("OaPrdQty")
      If .Mode = fgmnorm Then
        ' ***** Manali Trading Module
        If ms_OmTcTyp <> ctJtTcTyp Then _
          .Value(RowNum, "OaPrdQty") = .Value(RowNum, "OaOrdQty")
      End If
    End Select
  End With
