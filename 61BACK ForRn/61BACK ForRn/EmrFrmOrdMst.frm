Private Sub TagPrcCalcWithGrd(ByVal pv_rsSrcOd As MDORowSet, ByVal RowNum As Long)
  If ADC("OmTc") = "JSA" Or ADC("OmTc") = "JMI" Then
    Dim wcost As Double, wMstOdIdNo As Double, wMstCstRt As Double, wInFob As Double, wInAmt12 As Double
    wMstOdIdNo = moCn.GetFldVal("Select OdIdNo  From vwDmStkNumMaster  Where OdDmCd ='" + pv_rsSrcOd!OdDmCd + "'" + _
        "AND MasterYN = 'Y' " + _
        " AND OdSfx='" + pv_rsSrcOd!OdSfx + "'" + _
        " AND OdDmSz='" + pv_rsSrcOd!OdDmSz + "'" + _
        " AND OdDmStkCoCd='" + pv_rsSrcOd!OdDmStkCoCd + "'" + _
        " AND OdDmStkYy='" + pv_rsSrcOd!OdDmStkYy + "'" + _
        " AND OdDmStkChr = '" + pv_rsSrcOd!OdDmStkChr + "'" + _
        " AND ODDmStkNo = " + CStr(pv_rsSrcOd!OdDmStkNo))
    wMstCstRt = moCn.GetFldVal("select OdSalPrc from orddsg where OdIdNo =" + CStr(wMstOdIdNo))
    'Cost is Master Record * (1 + Amt12 / FOB)
    wInFob = moCn.GetFldVal("select InFOB from InvHd join OrdDsg on OdYy = InYy and OdCoCd=InCoCd and OdTc=InTc and OdChr=InChr and OdNo=InNo where OdIdNo=" + CStr(wMstOdIdNo))
    wInAmt12 = moCn.GetFldVal("select InAmt12 from InvHd join OrdDsg on OdYy = InYy and OdCoCd=InCoCd and OdTc=InTc and OdChr=InChr and OdNo=InNo where OdIdNo=" + CStr(wMstOdIdNo))
    If wInFob <> 0 Then
      wcost = wMstCstRt * (wInAmt12 / wInFob)
    End If
    GrdOrdDsg.Value(RowNum, "OdMasterPrc") = wcost
    ADC("WTGCOST") = wcost
  End If

'''''''tag
  Dim wTgFactor As Double
  wTgFactor = moCn.GetFldVal("select OdOmTag from orddsg where OdIdNo =" + CStr(wMstOdIdNo))
  GrdOrdDsg.Value(RowNum, "ODomTAG") = wTgFactor
  
  GrdOrdDsg.Value(RowNum, "ODTAG") = GrdOrdDsg.Value(RowNum, "OdMasterPrc") * wTgFactor
  GrdOrdDsg.Value(RowNum, "OdMrpDisc") = ADC("oMMRPDISC")

  Dim wMRPDn As Double
  wMRPDn = GrdOrdDsg.Value(RowNum, "OdTag") * (1 - (GrdOrdDsg.Value(RowNum, "OdMrpDisc") / 100))
  GrdOrdDsg.Value(RowNum, "OdMrp") = wMRPDn


GrdOrdDsg.Value(RowNum, "OdProfit") = GrdOrdDsg.Value(RowNum, "OdMrp") - GrdOrdDsg.Value(RowNum, "OdMasterPrc")
  
''''''''prof %
  If GrdOrdDsg.Value(RowNum, "OdMrp") <> 0 Then
    GrdOrdDsg.Value(RowNum, "OdProfitPer") = GrdOrdDsg.Value(RowNum, "OdProfit") / GrdOrdDsg.Value(RowNum, "OdMrp") * 100
  Else
    GrdOrdDsg.Value(RowNum, "OdProfitPer") = 0
  End If
  GrdOrdDsg.Value(RowNum, "OdSalPrc") = GrdOrdDsg.Value(RowNum, "OdMrp")

End Sub

Private Sub CmdOrdDel_Click()
 Call DispFra(OrdDel)
 On Error GoTo OrdDelErr
 If MsgBox("This will delete all the Order Serials. Are You Sure You Want To Delete?", vbYesNo) = vbYes Then
  If ms_PwdFlag = False Then _
    DispMsg "Enter SEO Password to Delete", etError: Exit Sub
      
  'Deletion Not allowed if Bag created for this order
'  If ADC("OMPRTKEY") <> ctCurrPrtn Then DispMsg "Cannot Delete Order of Previous Partition ", etError: Exit Sub
  If moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ADC("OMCOCD") + "' and BOdTc= '" + ADC("OmTc") + "' and " + _
                  "BOdYy=  '" + ADC("OmYy") + "' and BOdChr=  '" + ADC("OmChr") + "' and " + _
                  "BOdNo=  " + CStr(ADC("OmNo")) + " and BPrtKey='" + ctCurrPrtn + "' ") Then
    DispMsg "Cannot Delete Order As Bag Exists For This Order", etError: Exit Sub
  End If

  Dim wOmIdNo As Long
  wOmIdNo = moCn.GetFldVal("Select OmIdNo from OrdMst where OmCoCd= '" + ADC("OMCOCD") + "' and OmTc= '" + ADC("OmTc") + "' and " + _
                  "OmYy=  '" + ADC("OmYy") + "' and OmChr=  '" + ADC("OmChr") + "' and OmNo=  " + CStr(ADC("OmNo")))
  
  MWLib.BeginProcess Me, "Deleting Order "
  moCn.Execute ("Delete From OrdDsg where OdOmIdNo = '" + CStr(wOmIdNo) + "'")

  GrdOrdRm.Rows = 1
  GrdOrdLab.Rows = 1
  GrdOrdDsg.Rows = 1
  GrdOrdCT.Rows = 1
  GrdOrdAmd.Rows = 1
  GrdOrdDsgTgt.Rows = 1
  EndEmrProcess Me
  MWLib.EndProcess Me
  CmdOrdDel.SetFocus
  MsgBox "All Order Serial have been deleted"
  Exit Sub
OrdDelErr:
  EndEmrProcess Me
  MWLib.EndProcess Me
  MsgBox "Unable to Delete Order, Error encountered." + Err.Description
  DispMsg "Unable to Delete Order, Error encountered." + Err.Description, etError
  CmdOrdDel.SetFocus
 Else
  Exit Sub
 End If

End Sub
