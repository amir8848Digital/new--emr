Private Sub GrdOrdTgt_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  '*** Set Helps For Each Field
  '*** In the help of OtRmCd do not show the Custom Codes
  '    The first param is Custom Code (Y/N), the 2nd is the RmCtg and third is RmSCtg

  'If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '*** (Jen 2.13)
  If ADC("OmReNo") > 0 Then Cancel = True: ErrMsg = "Cannot Edit As Voucher Linked To Return Memo": Exit Sub
  '*** (Jen 2.13)
  'uma *****
  Select Case UCase(ColName)
  Case Is = UCase("OtRmCtg")
    Call HlpList.PMCd("RMCTG")
  Case Is = UCase("OtRmSCtg")
    Call HlpList.PSCd("RMSCTG", GrdOrdTgt.Value(RowNum, "OtRmCtg"))
  Case Is = UCase("OtCol")
    Call HlpList.PSCd("RMCOL", GrdOrdTgt.Value(RowNum, "OtRmCtg"))
  Case Is = UCase("OtRmRSZ")
    Call HlpList.RangeSz(GrdOrdTgt.Value(RowNum, "OtRmCtg"), GrdOrdTgt.Value(RowNum, "OtRmSCtg"))
        
  '4.1.0.0
  'Uma added 'X' in RmCtg and SubCtg
  Case Is = UCase("OtRmCd"), UCase("OtSrcRmCd")
    If GrdOrdTgt.Value(RowNum, "OtRmCtg") = "G" Or GrdOrdTgt.Value(RowNum, "OtRmCtg") = "P" Or GrdOrdTgt.Value(RowNum, "OtRmCtg") = "S" Or GrdOrdTgt.Value(RowNum, "OtRmCtg") = "L" Or GrdOrdTgt.Value(RowNum, "OtRmCtg") = "X" Then
      Call HlpList.RmCd("N", "'G','P','S','L','X'", GrdOrdTgt.Value(RowNum, "OtRmSCtg"))
    Else
        If GrdOrdTgt.Value(RowNum, "OtRmCtg") = "D" Or GrdOrdTgt.Value(RowNum, "OtRmCtg") = "C" Then
            Call HlpList.RmCd("N", "'D','C'", GrdOrdTgt.Value(RowNum, "OtRmSCtg"))
        Else
            Call HlpList.RmCd("N", "'" + GrdOrdTgt.Value(RowNum, "OtRmCtg") + "'", GrdOrdTgt.Value(RowNum, "OtRmSCtg"))
        End If
    End If
    'Call HlpList.RmCd("N", "'" + GrdOrdTgt.Value(RowNum, "OtRmCtg") + "'", GrdOrdTgt.Value(RowNum, "OtRmSCtg"))
   
  End Select
End Sub
Private Sub GrdOrdTgt_ColChange(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  '*** OtRmCtg          valid PMCd('RMCTG')
  '*** OtRmSCtg         valid PSCd('RMSCTG', OtRmCtg) or ''
  '*** OtRmCd           valid RmCd from RmMst(RmCtg= OtRmCtg, RmSCtg= OtRmCtg, RmZ= 'N') or ''
  
  With GrdOrdTgt
  'uma *******
    Select Case ColName
    Case Is = UCase("OtRmCtg")
      Cancel = Not moCn.RecSeek("Select PMCd From Param Where " + _
                           "PTyp= 'RMCTG' And PMCd = '" + NewValue + "'")
      ErrMsg = "Invalid Raw Material Category": Exit Sub
    Case Is = UCase("OtRmSCtg")
      Cancel = (Not moCn.RecSeek("Select PSCd From Param Where PTyp= 'RMSCTG' And " + _
                          "PMCd='" + .Value(RowNum, "OtRmCtg") + "' " + _
                           "And PSCd = '" + NewValue + "'"))
      ErrMsg = "Invalid Raw Material Sub Category": Exit Sub
    Case Is = UCase("OtCol")
      Cancel = (Not moCn.RecSeek("Select RmCol From RmMst Where RmZ='N' And " + _
                              "RmCtg ='" + .Value(RowNum, "OtRmCtg") + "' and RmSCtg='" + .Value(RowNum, "OtRmSCtg") + _
                              "' And RmPrtKey='" + ctCurrPrtn + "' and RmCol='" + NewValue + "'"))
      ErrMsg = "Invalid Raw Material Colour": Exit Sub
    Case Is = UCase("OtRmRSZ")
      Cancel = (Not moCn.RecSeek("Select RrRngSz From RmRt Where RrCtg ='" + .Value(RowNum, "OtRmCtg") + _
                              "' and RrSCtg='" + .Value(RowNum, "OtRmSCtg") + "' And RrPrtKey='" + ctCurrPrtn + _
                              "' and RrRngSz='" + NewValue + "'"))
      ErrMsg = "Invalid Range Size": Exit Sub
      
    '4.1.0.0
    Case Is = UCase("OtRmCd"), UCase("OtSrcRmCd")
   ' ****** Manali 3.5.0 - 17/11/08 - Allow Change in OtRmCd of Other RmCtg in case of Main Metals
   'uma ***
    If .Value(RowNum, "OtRmCtg") = "G" Or .Value(RowNum, "OtRmCtg") = "P" Or .Value(RowNum, "OtRmCtg") = "S" Or .Value(RowNum, "OtRmCtg") = "L" Or .Value(RowNum, "OtRmCtg") = "X" Then
      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                                                      "RmCtg In ('G', 'P', 'S', 'L','M','X') And " + _
                                                      "RmCd = '" + NewValue + "' and RmPrtKey='" + ctCurrPrtn + "'"))
      ErrMsg = "Invalid Target Raw Material Code/ Rm Code Allowed Only Of RmCtg ['G', 'P', 'S', 'L','M','X'] ": Exit Sub
    Else
      If .Value(RowNum, "OtRmCtg") = "D" Or .Value(RowNum, "OtRmCtg") = "C" Then
        Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                                                      "RmCtg In ('D', 'C') And " + _
                                                      "RmSCtg='" + .Value(RowNum, "OtRmSCtg") + "' And " + _
                                                      "RmCd = '" + NewValue + "' and RmPrtKey='" + ctCurrPrtn + "'"))
        ErrMsg = "Invalid Target Raw Material Code/ Rm Code Allowed Only Of RmCtg ['D', 'C'] ": Exit Sub
     Else
        Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
                             "RmCtg= '" + .Value(RowNum, "OtRmCtg") + "' And " + _
                             "RmSCtg='" + .Value(RowNum, "OtRmSCtg") + "' " + _
                             "And RmCd = '" + NewValue + "' and RmPrtKey='" + ctCurrPrtn + "'"))
        ErrMsg = "Invalid Target Raw Material Code": Exit Sub
      End If
    End If
    
    '    Bef 3.5.0
    '      Cancel = (NewValue <> "") And (Not moCn.RecSeek("Select RmCd From RmMst Where RmZ='N' And " + _
    '                           "RmCtg= '" + .Value(RowNum, "OtRmCtg") + "' And " + _
    '                           "RmSCtg='" + .Value(RowNum, "OtRmSCtg") + "' " + _
    '                           "And RmCd = '" + NewValue + "' and RmPrtKey='" + ctCurrPrtn + "'"))

    End Select
  End With
End Sub
