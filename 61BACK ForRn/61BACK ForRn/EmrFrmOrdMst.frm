              .Value(wi_OdRow, "OdJLVchRt") = GetAvgStkRtJL(ms_OmCoCd, ADC("OmFrDmLoc"), .Value(wi_OdRow, "ODJLRmCd"), .Value(wi_OdRow, "ODJLLotNo"), .Value(wi_OdRow, "ODJLLn1"), .Value(wi_OdRow, "ODJLLn2"), .Value(wi_OdRow, "OdJLLn3"))
