Private Sub RecalcForCpy_OrAlyCd(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
With GrdOrdRm
      If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmCopy Or mf_InCopyFromServer) And (mf_InCopyFromServer Or GrdOrdDsg.Mode = fgmnorm Or GrdOrdDsg.Mode = fgmCopy) Then
        Dim i As Integer
        If UCase(SourceName) = UCase("GrdOrdRm") Then
          If RowNum > 0 Then
            SetParamsValRm GetAlyCd(ADC("OmCmCd"), ParamsRm(wOrRmCd), _
                                        Params(wOdDmCol)), wOrAlyCd
          End If
        ElseIf UCase(SourceName) = UCase("GrdOrdDsg") Then 'not usedfor copy
          For i = 1 To GrdOrdRm.Rows - 1
            If .Value(i, "OrRmCtg") = "G" Or .Value(i, "OrRmCtg") = "P" Or .Value(i, "OrRmCtg") = "S" Or .Value(i, "OrRmCtg") = "L" Then
              If Me.Controls(SourceName).Mode <> fgmCopyOver Or (Me.Controls(SourceName).Mode = fgmCopyOver And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(i, "OrRmCtg") + ",") < 1))) Then
                .Value(i, "OrAlyCd") = GetAlyCd(ADC("OmCmCd"), .Value(i, "OrRmCd"), _
                                       GrdOrdDsg.Value(RowNum, "OdDmCol"))
                GrdOrdRm.SaveRec i
              End If
            End If
          Next i
        End If
      End If
  End With
End Sub
