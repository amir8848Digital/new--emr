Private Sub GetRetBagWt(ByVal ms_TmpTbl As String, ByRef ms_Vch() As String, ByVal ms_CtgStr As String, ByVal mb_CpyFrRet As Boolean)
  '*** added  ByVal mb_CpyFrRet As Boolean '*** (Jen 2.13)

  Dim ws_CmDiaRtFA As String, ws_CmCsRtFA As String
  Dim wRs_UniqRm As MDORowSet, wRs_TotActWtQty As MDORowSet, wd_TotRmOWt As Double
  Dim wd_TotRmAWt As Double, wi_TotRmOQty As Long, wi_TotRmAQty As Long
  Dim wRs_RmDet As MDORowSet, wi_TotRecs As Long, wi_Row As Long
  Dim wd_OldWt As Double, wi_OldRmQty As Long, wd_RmWt As Double, wi_RmQty As Long
  Dim wd_MulFactWt As Single, wd_MulFactQty As Single
  
  Dim wi_BagQty As Long

  Dim ws_str As String      '*** (Jen 2.13)

  ws_CmDiaRtFA = moCn.GetFldVal("Select CmDiaRtFA from CustMst where CmCtg= 'C' and " + _
               "CmCd= '" + ADC("OmCmCd") + "' ")
  ws_CmCsRtFA = moCn.GetFldVal("Select CmCSRtFA from CustMst where CmCtg= 'C' and " + _
               "CmCd= '" + ADC("OmCmCd") + "' ")

  '*** (Bef 2.13)
  'Set wRs_UniqRm = moCn.OpenRes("Select Rtrim(max(qRmCtg)) as qRmCtg, qRmCd, " + _
                   "sum(qWt) as qTotRmOWt, sum(qQty) as qTotRmOQty " + _
                   "from " + ms_TmpTbl + " " + _
                   "where ','+ qRmCtg+ ',' not like '%" + ms_CtgStr + "%' " + _
                   "Group By qRmCd")
  '*** (Bef 2.13)
  
  '*** (Jen 2.13)
  Set wRs_UniqRm = moCn.OpenRes("Select Rtrim(max(qRmCtg)) as qRmCtg, qRmCd, " + _
                   "sum(qWt) as qTotRmOWt, sum(qQty) as qTotRmOQty " + _
                   "from " + ms_TmpTbl + " " + _
                   IIF(ms_CtgStr <> "", "where '," + ms_CtgStr + ",' not like '%,'+ qRmCtg+ ',%' ", " ") + _
                   "Group By qRmCd")
  '*** (Jen 2.13)


  Do While Not (wRs_UniqRm.EOF Or wRs_UniqRm.BOF)
    wd_TotRmOWt = wRs_UniqRm!qTotRmOWt
    wi_TotRmOQty = wRs_UniqRm!qTotRmOQty
    
    '*** (Jen 2.13)
    '****** Sachin 3.02 - Current Partition
    If mb_CpyFrRet = True Then
      ws_str = "Select sum(FrRmWt* " + _
               "(Case when F.LocTyp= 'F' and FrFrRmDc= 'D' then 1 " + _
               "when F.LocTyp='F' and FrFrRmDc= 'C' then -1 " + _
               "when T.LocTyp='F' and FrToRmDc= 'D' then 1 " + _
               "when T.LocTyp='F' and FrToRmDc= 'C' then -1 " + _
               "Else 0 end)) as qTotAWt, " + _
               "sum(FrRmQty* (Case when F.LocTyp= 'F' and FrFrRmDc= 'D' then 1 " + _
               "when F.LocTyp='F' and FrFrRmDc= 'C' then -1 " + _
               "when T.LocTyp='F' and FrToRmDc= 'D' then 1 " + _
               "when T.LocTyp='F' and FrToRmDc= 'C' then -1 " + _
               "Else 0 end)) as qTotAQty " + _
               "From Fgd join FgRm on FrFdIdNo=FdIdNo And FrCoCd= FdCoCd and FrTc= FdTc and FrYy= FdYy and " + _
               "FrChr= FdChr and FrNo= FdNo and FrSr= FdSr and FrPrtKey=FdPrtKey " + _
               "join Loc F on F.LocCoCd= FrCoCd and F.LocCd= FrFrRmLoc " + _
               "join Loc T on T.LocCoCd= FrCoCd and T.LocCd= FrToRmLoc "
      'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
      ws_str = ws_str + " where FdCoCd= '" + ms_OmCoCd + "' " + _
               "and  exists (Select 'x' from InvFgd where IfCoCd= '" + ms_OmCoCd + "' " + _
               "and IfTc= '" + ms_Vch(0) + "' and IfYy= '" + ms_Vch(1) + "' " + _
               "and IfChr= '" + ms_Vch(2) + "' and IfNo= " + ms_Vch(3) + " " + _
               "and IfSr= " + ms_Vch(4) + " and IfPrtKey='" + ctCurrPrtn + "' and FdTc= IfFdTc and FdYy= IfFdYy " + _
               "and FdChr= IfFdChr and FdNo= IfFdNo and FdSr= IfFdSr and FdPrtKey=IfPrtKey) " + _
               "and FrRmCd= '" + wRs_UniqRm!qRmCd + "' " + _
               "group by FrRmCd "
    
      Set wRs_TotActWtQty = moCn.OpenRes(ws_str)
    
      '****** Sachin 3.02 - Current Partition
      'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
      wi_BagQty = moCn.GetFldVal("Select sum(IfQty) From InvFgd where IfCoCd= '" + ms_OmCoCd + "' " + _
                  "and IfTc= '" + ms_Vch(0) + "' and IfYy= '" + ms_Vch(1) + "' " + _
                  "and IfChr= '" + ms_Vch(2) + "' and IfNo= " + ms_Vch(3) + " " + _
                  "and IfSr= " + ms_Vch(4) + " ")
    Else
      '****** Sachin 3.02 - Current Partition
      'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
      wi_BagQty = moCn.GetFldVal("Select BQty From Bag where BCoCd= '" + ms_OmCoCd + "' " + _
                  "and BYy= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBYy") + "' " + _
                  "and BChr= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBChr") + "' " + _
                  "and BNo= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBNo")) + " ")
    '*** (Jen 2.13)
    
      '****** Sachin 3.02 (10/09/07) - added id fields in joins
      '****** Sachin 3.02 - Current Partition
      'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
      Set wRs_TotActWtQty = moCn.OpenRes("Select sum(FrRmWt* " + _
                            "(Case when F.LocTyp= 'F' and FrFrRmDc= 'D' then 1 " + _
                            "when F.LocTyp='F' and FrFrRmDc= 'C' then -1 " + _
                            "when T.LocTyp='F' and FrToRmDc= 'D' then 1 " + _
                            "when T.LocTyp='F' and FrToRmDc= 'C' then -1 " + _
                            "Else 0 end)) as qTotAWt, " + _
                            "sum(FrRmQty* (Case when F.LocTyp= 'F' and FrFrRmDc= 'D' then 1 " + _
                            "when F.LocTyp='F' and FrFrRmDc= 'C' then -1 " + _
                            "when T.LocTyp='F' and FrToRmDc= 'D' then 1 " + _
                            "when T.LocTyp='F' and FrToRmDc= 'C' then -1 " + _
                            "Else 0 end)) as qTotAQty " + _
                            "From Fgd join FgRm on FrFdIdNo=FdIdNo And FrCoCd= FdCoCd and FrTc= FdTc and FrYy= FdYy and " + _
                            "FrChr= FdChr and FrNo= FdNo and FrSr= FdSr and FrPrtKey=FdPrtKey " + _
                            "join Loc F on F.LocCoCd= FrCoCd and F.LocCd= FrFrRmLoc " + _
                            "join Loc T on T.LocCoCd= FrCoCd and T.LocCd= FrToRmLoc " + _
                            "where FdCoCd= '" + ms_OmCoCd + "' and FdTc= '" + ms_Vch(0) + "' " + _
                            "and FdYy= '" + ms_Vch(1) + "' and FdChr= '" + ms_Vch(2) + "' " + _
                            "and FdNo= " + ms_Vch(3) + " and FdSr= " + ms_Vch(4) + "  " + _
                            "and FrRmCd= '" + wRs_UniqRm!qRmCd + "' " + _
                            "group by FrRmCd ")
    
    '*** (Jen 2.13)
    End If
    '*** (Jen 2.13)
    
    If wRs_TotActWtQty.RecCount > 0 Then
      '*** (Bef 2.13)
      'wi_BagQty = moCn.GetFldVal("Select BQty From Bag where BCoCd= '" + ms_OmCoCd + "' " + _
                  "and BYy= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBYy") + "' " + _
                  "and BChr= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBChr") + "' " + _
                  "and BNo= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdBNo")) + " ")
      '*** (Bef 2.13)
      wd_TotRmAWt = MWLib.Div(wRs_TotActWtQty!qTotAWt, wi_BagQty)
      wi_TotRmAQty = MWLib.Div(wRs_TotActWtQty!qTotAQty, wi_BagQty)
    End If

    If (ADC("wDsgCpyRt") = "Y") And ((ws_CmDiaRtFA = "F" And UCase(Trim(wRs_UniqRm!qRmCtg)) = "D") Or _
       (ws_CmCsRtFA = "F" And UCase(Trim(wRs_UniqRm!qRmCtg)) = "C")) Then
      If wd_TotRmAWt >= wd_TotRmOWt Then
        Set wRs_RmDet = moCn.OpenResultset("Select * from " + ms_TmpTbl + " where " + _
                        "qRmCd= '" + wRs_UniqRm!qRmCd + "' Order By OrSalRt asc, OrSetSalRt asc")
      Else
        Set wRs_RmDet = moCn.OpenResultset("Select * from " + ms_TmpTbl + " where " + _
                        "qRmCd= '" + wRs_UniqRm!qRmCd + "' Order By OrSalRt desc, OrSetSalRt desc")
      End If
    
      wi_TotRecs = wRs_RmDet.RecCount
      If wi_TotRecs > 0 Then wRs_RmDet.MoveFirst
      wi_Row = 0
      Do While Not (wRs_RmDet.EOF Or wRs_RmDet.BOF)
        wRs_RmDet.edit
        wi_Row = wi_Row + 1
        If wi_Row < wi_TotRecs Then
          '*** If Not The Last Record ***
          wd_RmWt = IIF(wRs_RmDet!qWt < wd_TotRmAWt, wRs_RmDet!qWt, wd_TotRmAWt)
          wi_RmQty = IIF(wRs_RmDet!qQty < wi_TotRmAQty And Round(wd_TotRmAWt - wd_RmWt, 3) > 0, wRs_RmDet!qQty, wi_TotRmAQty)
        Else
          '*** If Last Record ***
          wd_RmWt = wd_TotRmAWt
          wi_RmQty = wi_TotRmAQty
        End If
        wRs_RmDet!qWt = wd_RmWt
        wRs_RmDet!qQty = wi_RmQty
        
        '*** 22/08/05
        wRs_RmDet!qWsQty = IIF(wRs_RmDet!qWsQty > 0, wRs_RmDet!qQty, 0)
        wRs_RmDet!qHsQty = wRs_RmDet!qQty - wRs_RmDet!qWsQty
        '*** 22/08/05
        
        wRs_RmDet.Update
        wd_TotRmAWt = wd_TotRmAWt - wd_RmWt
        'wi_TotRmAQty = wi_TotRmAQty - wi_RmQty
        wi_TotRmAQty = wi_TotRmAQty - wRs_RmDet!qQty
        wRs_RmDet.MoveNext
      Loop
    Else
      Set wRs_RmDet = moCn.OpenResultset("Select * from " + ms_TmpTbl + " where " + _
                                         "qRmCd= '" + wRs_UniqRm!qRmCd + "' ")
      wi_TotRecs = wRs_RmDet.RecCount
      If wi_TotRecs > 0 Then wRs_RmDet.MoveFirst
      wi_Row = 0
      Do While Not (wRs_RmDet.EOF Or wRs_RmDet.BOF)
        wd_MulFactWt = MWLib.Div(wd_TotRmAWt, wd_TotRmOWt)
        wd_MulFactQty = MWLib.Div(wi_TotRmAQty, wi_TotRmOQty)
        wRs_RmDet.edit
        wi_Row = wi_Row + 1
        wd_OldWt = wRs_RmDet!qWt
        wi_OldRmQty = wRs_RmDet!qQty
        If wi_Row < wi_TotRecs Then
          '*** If Not The Last Record ***
          wd_RmWt = wRs_RmDet!qWt * wd_MulFactWt
          wi_RmQty = wRs_RmDet!qQty * wd_MulFactQty
        Else
          '*** If Last Record ***
          wd_RmWt = wd_TotRmAWt
          wi_RmQty = wi_TotRmAQty
        End If
        wRs_RmDet!qWt = wd_RmWt
        wRs_RmDet!qQty = IIF(wi_RmQty > 0, wi_RmQty, 0)
        
        '*** 22/08/05
        wRs_RmDet!qWsQty = IIF(wRs_RmDet!qWsQty > 0, wRs_RmDet!qQty, 0)
        wRs_RmDet!qHsQty = wRs_RmDet!qQty - wRs_RmDet!qWsQty
        '*** 22/08/05
        
        wRs_RmDet.Update
  
        wd_TotRmOWt = wd_TotRmOWt - wd_OldWt
        wd_TotRmAWt = wd_TotRmAWt - wd_RmWt
        wi_TotRmOQty = wi_TotRmOQty - wi_OldRmQty
        'wi_TotRmAQty = wi_TotRmAQty - wi_RmQty
        wi_TotRmAQty = wi_TotRmAQty - wRs_RmDet!qQty
        wRs_RmDet.MoveNext
      Loop
      
    End If
    
    wRs_UniqRm.MoveNext
  Loop

  Set wRs_UniqRm = Nothing
  Set wRs_TotActWtQty = Nothing
  Set wRs_RmDet = Nothing
  
End Sub

Private Sub GetBagWt_Old(ByVal ms_TmpTbl As String, ByRef ms_Vch() As String, ByVal ms_CtgStr As String)
  '****** Partition Key Not used in this Subroutine as it is not used anywhere ******
  Dim wCtgStr As String, wDmCtg As String, wTmpTbl As String
  Dim wOrStr As String, wStr As String, wMainMet As Boolean
  Dim wRsRmDet As MDORowSet, wOrRecSet As MDORowSet
  Dim wDivFactor As Single, wRmRow As Single
  Dim wTotAWt As Double, wf_CnvRt As Single
  Dim wDRrTcTyp As String, wCRrTcTyp As String, wDFrOrdYN As String
  Dim wCFrOrdYN As String, wSetRt As Boolean
  Dim wTotWtDiff As Double, wWtDiff As Double, wTotIrRmWt As Double, wAddWt As Double
  Dim wIrRmWt As MDORowSet, wRmCtg As String, wFrOrdYN As String, wMainMetWt As Double
  Dim wFrRmWt As Double, wFrRmQty As Double, wOrTotWt As Double, wOrTotQty As Double
  Dim wFRmDet As MDORowSet, wSetTyp As Boolean, wCnd As String
  Dim wOrLnStr As String, wRetMemCnd As String, wRs As MDORowSet

  Dim wRs_RmCd As MDORowSet, wb_WtFrOrd As Boolean, ws_ShowPtr As String
  Dim ws_OrLn As String, ws_Ptr As String
'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
  Set wRs = moCn.OpenResultset("Select * From Fgd " + _
                               "Where FdCoCd= '" + ms_OmCoCd + "' and FdTc= '" + ms_Vch(0) + "' " + _
                               " And FdYy= '" + ms_Vch(1) + "' and FdChr= '" + ms_Vch(2) + "' " + _
                               " And FdNo= " + ms_Vch(3) + " and FdSr= " + ms_Vch(4))

  ws_OrLn = "(case when Pvalue3='Y' then (Case when PValue2='Y' then  " + _
          "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty=0 then 0 else  " + _
          "cast((OrPrdWt/OrPrdQty) as Decimal(12,4)) end ) end )  " + _
          "else cast(Orln1 as Decimal(12,4)) end ) "
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
  ws_ShowPtr = moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ms_OmCoCd + "' and HCd= '" + ctSelfCmCd + "'")
  ws_Ptr = "max(case when '" + ws_ShowPtr + "'= 'Y' then (Case when PValue2='Y' then  " + _
           "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty= 0 then 0 else  " + _
           "cast((OrPrdWt/ OrPrdQty) as Decimal(12, 4)) end ) end )  " + _
           "else 0 end) as qRmPtr "

  wStr = " Select (case when max(isnull(qOrRmCd, ''))= '' then '' else 'Y' end) as qOrRmExists, " + _
         " 0 as qSrNo, max(RmCtg) as qRmCtg, max(RmSCtg) as qRmSCtg, FrRmCd as qRmCd, FrRmCd as qRmOldCd,  " + _
         " Max(IsNull(qLn1, (case when PValue3= 'N' then FrRmSz else 0 end) )) as qLn1, Max(IsNull(qOrLn2,0)) as qLn2, " + _
         " sum(FrRmQty) as qQty, " + _
         " max(IsNull(qRmPtr, (case when PValue3= 'Y' then FrRmSz else 0 end))) as qRmPtr, sum(FrRmWt) As qWt, Convert(Decimal(14,3),0) as qXtraWt," + _
         " sum(FrRmQty) as qPrdQty, sum(FrRmWt) As qPrdWt, IsNull(qOrSetSCd, '') as qSetSCd, " + _
         " Sum(IsNull(qOrWsQty,0)) as qWsQty, Sum(IsNull(qOrHsQty,0)) as qHsQty, " + _
         " Max(IsNull(qOrSubShp,'')) as qSubShp, Max(IsNull(qOrAlyCd,''))as qAlyCd, Space(1) as qMainMet,  0 as OrLmeSal, " + _
         " Convert(Decimal(14,3),0) as OrSalRt, Convert(Decimal(14,3),0) as OrCstRt, Convert(Decimal(14,2),0) as OrSalVal, Convert(Decimal(14,2),0) as OrCstVal, Convert(Decimal(14,2),0) as OrSetSalRt, " + _
         " Convert(Decimal(14,2),0) as OrSetCstRt, Convert(Decimal(14,2),0) as OrSetSalVal, Convert(Decimal(14,2),0) as OrSetCstVal, Convert(Decimal(14,2),0) as OrAlySalRt, Convert(Decimal(14,2),0) as OrAlyCstRt, " + _
         " Max(IsNull(qOrQty,0)) as qOrQty, Max(RmSTWGrp) as qRmSTWGrp, max(Isnull(qOrWt,0)) as qOrWt "

         '****** Sachin - line below temporarily commented ******
         '" Max(PValue3) as qStkByPtr, Max(IsNull(qOrQty,0)) as qOrQty, Max(RmSTWGrp) as qRmSTWGrp, max(Isnull(qOrWt,0)) as qOrWt "

  '****** Sachin 3.02 (10/09/07) - added id fields in joins
  'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
  wStr = wStr + " Into " + ms_TmpTbl + " From Fgd join FgRm on /* FrFdIdNo=FdIdNo And */ FrCoCd= FdCoCd and FrTc= FdTc and FrYy= Fdyy and " + _
         "FrChr= FdChr and FrNo = FdNo And FrSr = FdSr " + _
         "Join RmMst on FrRmCd = RmCd " + _
         "Join Param P1 on P1.PTyp= 'RMSCTG' and P1.PMCd= RmCtg and P1.PSCd= RmSCtg " + _
         "Left Outer Join (select OrRmCd as qOrRmCd, " + ws_OrLn + " as qOrLn1, OrSetSCd as qOrSetSCd, " + _
         "sum(OrWt) as qOrWt, sum(OrQty) as qOrQty, OrLn2 as qOrLn2, Sum(OrWsQty) as qOrWsQty, " + _
         "Sum(OrHsQty) as qOrHsQty, Max(OrSubShp) as qOrSubShp, max(OrAlyCd) as qOrAlyCd, " + _
         ws_Ptr + ", max(OrLn1) as qLn1 from OrdRm " + _
         "Join RmMst on RmCd= OrRmCd " + _
         "Join Param on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
         "where OrCoCd= '" + ms_OmCoCd + "'  and OrTc = '" + wRs!FdPrdOdTc + "' " + _
         "and OrYy= '" + wRs!FdPrdOdYy + "' " + _
         " and OrChr= '" + wRs!FdPrdOdChr + "' and OrNo = " + CStr(wRs!FdPrdOdNo) + _
         " and OrSr= " + CStr(wRs!FdPrdOdSr) + " Group By " + _
         "OrRmCd, " + ws_OrLn + ", OrLn2, OrSetSCd, OrSetSalRt) Or2 On qOrRmCd= FrRmCd and qOrLn1= FrRmSz " + _
         " Where FdCoCd = '" + ms_OmCoCd + "' and FdTc= '" + wRs!FdTc + "' and FdYy= '" + _
         wRs!FdYy + "' and FdChr= '" + wRs!FdChr + "' and " + _
         "FdNo = " + CStr(wRs!FdNo) + " and FdSr = " + CStr(wRs!FdSr) + _
         IIF(ms_CtgStr <> "", " and '," + ms_CtgStr + ",' Not Like '%,'+ RmCtg+ ',%' ", " ") + _
         "Group by FrRmCd, FrRmSz, qOrSetSCd "

  '*** Creating Temporary Table #TmpOrdRm ***
  moCn.CreateTmpTable ms_TmpTbl, wStr
  Set wRsRmDet = moCn.OpenResultset("Select * from " + ms_TmpTbl)

  If moCn.RecSeek(" Select count(qSetSCd) From " + ms_TmpTbl + " " + _
                    " Group by qRmCd, qLn1 Having count(qSetSCd)> 1") Then

    '*** To get Proportionate weights
    Set wFRmDet = moCn.OpenRes("Select FrRmCd as qFrRmCd, max(FrRmSz) as qFrRmsz, " + _
                       " Sum(FrRmWt) as qFrRmWt, Sum(FrRmQty) as qFrRmQty from FgRm  " + _
                       " Join RmMst On RmCd=FrRmCd " + _
                       " Join Fgd on /* FrFdIdNo=FdIdNo */ And FrCoCd= FdCoCd and FrTc= FdTc and FrYy= FdYy and  " + _
                       " FrChr= FdChr and FrNo = FdNo And FrSr = FdSr " + _
                       "where FdCoCd = '" + wRs!FdCoCd + "' and FdTc= '" + wRs!FdTc + "' and FdYy= '" + _
                       wRs!FdYy + "' and FdChr= '" + wRs!FdChr + "' and " + _
                       "FdNo = " + CStr(wRs!FdNo) + " and FdSr = " + CStr(wRs!FdSr) + " " + _
                       IIF(ms_CtgStr <> "", " and '," + ms_CtgStr + ",' Not Like '%,'+ RmCtg+ ',%' ", " ") + _
                       "Group By FrRmCd, FrRmSz Order By FrRmCd, FrRmSz")

    Do While Not (wFRmDet.EOF Or wFRmDet.BOF)
      wFrRmWt = wFRmDet!qFrRmWt
      wFrRmQty = wFRmDet!qFrRmQty
      wOrTotWt = moCn.GetFldVal("Select Sum(qOrWt) From " + ms_TmpTbl + " Where qRmCd= '" + wFRmDet!qFrRmCd + "' and qFrRmSz= '" + CStr(wFRmDet!qFrRmSz) + "' Group By qRmcd, qFrRmSz")
      wOrTotQty = moCn.GetFldVal("Select Sum(qOrQty) From " + ms_TmpTbl + "  Where qRmCd= '" + wFRmDet!qFrRmCd + "' and qFrRmSz= '" + CStr(wFRmDet!qFrRmSz) + "' Group By qRmCd, qFrRmSz")

      If (wRsRmDet.RecCount > 0) Then wRsRmDet.MoveFirst
      Do While Not (wRsRmDet.EOF Or wRsRmDet.BOF)
        If wFRmDet!qFrRmCd = wRsRmDet!qFrRmCd And wFRmDet!qFrRmSz = wRsRmDet!qFrRmSz Then
          If moCn.RecSeek(" Select count(distinct qSetSCd) From " + ms_TmpTbl + " " + _
                          " Where qRmCd= '" + wRsRmDet!qRmCd + "' " + _
                          "   and qLn1= " + CStr(wRsRmDet!qLn1) + " " + _
                          " Group by qRmCd, qFrRmSz Having count(distinct qSetSCd)> 1") Then
            wRsRmDet.edit
            wRsRmDet!qWt = Round(MWLib.Div(wRsRmDet!qOrWt, wOrTotWt) * wFrRmWt, 3)
            wOrTotWt = wOrTotWt - wRsRmDet!qOrWt
            wFrRmWt = wFrRmWt - wRsRmDet!qWt
            wRsRmDet!qQty = Round(MWLib.Div(wRsRmDet!qOrQty, wOrTotQty) * wFrRmQty)
            wOrTotQty = wOrTotQty - wRsRmDet!qOrQty
            wFrRmQty = wFrRmQty - wRsRmDet!qQty

            wRsRmDet.Update
          End If
        End If
        wRsRmDet.MoveNext
      Loop
      wFRmDet.MoveNext
    Loop
    Set wFRmDet = Nothing
  End If

  If (wRsRmDet.RecCount > 0) Then wRsRmDet.MoveFirst
  Do While Not (wRsRmDet.EOF Or wRsRmDet.BOF)
    wRsRmDet.edit
    wOrLnStr = IIF(moCn.GetFldVal("Select PValue3 From Param Join  RmMst " + _
                              " on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                              "where RmCd= '" + wRsRmDet!qRmCd + "' ") = "Y", _
                     IIF(moCn.GetFldVal("select PValue2 From Param Join RmMst " + _
                              "on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                              "where RmCd= '" + wRsRmDet!qRmCd + "' ") = "Y", "OrRmPtr", _
                              " case when OrPrdQty =0 then 0 else OrPrdWt/OrPrdQty end "), "OrLn1")

    If moCn.RecSeek("Select Count(qSetSCd) From " + ms_TmpTbl + " " + _
                  "Where qRmCd= '" + wRsRmDet!qRmCd + "' " + _
                  " And qLn1= " + CStr(wRsRmDet!qLn1) + _
                  "Group By qRmCd, qLn1 Having Count(qSetSCd)> 1") Then
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      wOrStr = "Select OrLn2, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg " + _
              "From OrdRm where OrCoCd= '" + ms_OmCoCd + "' " + _
              " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
              " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
              " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
              " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
              " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
              " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
              " and " + wOrLnStr + " = " + CStr(wRsRmDet!qFrRmSz) + _
              " and OrSetSCd= '" + wRsRmDet!qSetSCd + "' " + _
              " Order by OrMainMet Desc"

    Else
    'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      wOrStr = "Select OrLn2, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg " + _
                " From OrdRm where OrCoCd= '" + ms_OmCoCd + "' " + _
                " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
                " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
                " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
                " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
                " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
                " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
                " and " + wOrLnStr + " = " + CStr(wRsRmDet!qLn1) + _
                "Order by OrMainMet Desc"
    End If

    Set wOrRecSet = moCn.OpenRes(wOrStr)
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
    If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
      wOrStr = "Select OrLn2, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg " + _
               "From OrdRm join RmRt on RrTcTyp= 'Rsz' and RrCmCd= '" + ctSelfCmCd + "' and " + _
               "RrCtg= OrRmCtg and RrSCtg= OrRmSCtg " + _
               "where OrCoCd= '" + ms_OmCoCd + "' " + _
               " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
               " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
               " and OrChr = '" + wRs!FdPrdOdChr + "' " + _
               " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
               " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
               " and OrRmCd =  '" + wRsRmDet!qRmCd + "' " + _
               " and " + wOrLnStr + " >= RrFrLn and " + wOrLnStr + " <= RrToLn and " + _
               CStr(wRsRmDet!qLn1) + " >= RrFrLn and " + _
               CStr(wRsRmDet!qLn1) + " <= RrToLn " + _
               "Order by OrMainMet Desc "
      Set wOrRecSet = moCn.OpenRes(wOrStr)
    End If
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
    If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
      wOrStr = "Select OrLn2, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg " + _
             "From OrdRm where OrCoCd= '" + ms_OmCoCd + "' " + _
             "  and OrTc = '" + wRs!FdPrdOdTc + "' " + _
             " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
             " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
             " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
             " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
             " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
             "Order by OrMainMet Desc"
      Set wOrRecSet = moCn.OpenRes(wOrStr)
    End If

    If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
      wRsRmDet!qSetSCd = ""
      wRsRmDet!qOrQty = 0
      wRsRmDet!qOrWt = 0
      wRsRmDet!qAlyCd = ""
      wRsRmDet!qSubShp = ""
      wRsRmDet!qMainMet = "N"
    Else
      wOrRecSet.MoveFirst
      wRsRmDet!qSetSCd = wOrRecSet!OrSetSCd

      If wRsRmDet!qRmPtr = 0 Then _
          wRsRmDet!qRmPtr = GetWtFrSz(wRsRmDet!qRmCtg, wRsRmDet!qRmSCtg, wRsRmDet!qLn1, wRsRmDet!qLn2, wRsRmDet!qRmSTWGrp)

      wRsRmDet!qLn2 = IIF(wRsRmDet!qOrRmExists <> "Y", wOrRecSet!OrLn2, wRsRmDet!qLn2)
      wRsRmDet!qOrQty = wOrRecSet!OrQty
      wRsRmDet!qOrWt = wOrRecSet!OrWt
      wRsRmDet!qAlyCd = wOrRecSet!OrAlyCd
      wRsRmDet!qSubShp = wOrRecSet!OrSubShp

      If wRs!Fdqty >= 1 Then
        wRsRmDet!qQty = MWLib.Div(wRsRmDet!qQty, wRs!Fdqty)
        wRsRmDet!qWt = MWLib.Div(wRsRmDet!qWt, wRs!Fdqty)
        wRsRmDet!qPrdQty = wRsRmDet!qQty
        wRsRmDet!qPrdWt = wRsRmDet!qWt
      End If

      If wRsRmDet!qRmCtg = "C" Or wRsRmDet!qRmCtg = "D" Then
        wRsRmDet!qWsQty = wRsRmDet!qQty * (wRsRmDet!qWsQty / (IIF((wRsRmDet!qWsQty + wRsRmDet!qHsQty) > 0, (wRsRmDet!qWsQty + wRsRmDet!qHsQty), 1)))
        wRsRmDet!qHsQty = wRsRmDet!qQty - wRsRmDet!qWsQty
      End If

      If wOrRecSet!OrMainMet = "Y" And wMainMet = False Then
        wRsRmDet!qMainMet = "Y": wMainMet = True
      ElseIf wOrRecSet!OrMainMet = "Y" And wMainMet = True Then
        wRsRmDet!qMainMet = "N"
      ElseIf wOrRecSet!OrMainMet = "N" Then
        wRsRmDet!qMainMet = "N"
      End If

    End If

    wRsRmDet.Update
    wRsRmDet.MoveNext
  Loop

  Set wRsRmDet = Nothing
  Set wOrRecSet = Nothing
End Sub

Private Sub GetBagWt(ByVal ms_TmpTbl As String, ByRef ms_Vch() As String, ByVal ms_CtgStr As String)
  
  Dim wCtgStr As String, wDmCtg As String, wTmpTbl As String
  Dim wOrStr As String, wStr As String, wMainMet As Boolean
  Dim wRsRmDet As MDORowSet, wOrRecSet As MDORowSet
  Dim wDivFactor As Single, wRmRow As Single
  Dim wTotAWt As Double, wf_CnvRt As Single
  Dim wDRrTcTyp As String, wCRrTcTyp As String, wDFrOrdYN As String
  Dim wCFrOrdYN As String, wSetRt As Boolean
  Dim wTotWtDiff As Double, wWtDiff As Double, wTotIrRmWt As Double, wAddWt As Double
  Dim wIrRmWt As MDORowSet, wRmCtg As String, wFrOrdYN As String, wMainMetWt As Double
  Dim wFrRmWt As Double, wFrRmQty As Double, wOrTotWt As Double, wOrTotQty As Double
  Dim wFRmDet As MDORowSet, wSetTyp As Boolean, wCnd As String
  Dim wOrLnStr As String, wRetMemCnd As String, wRs As MDORowSet
    
  Dim wRs_RmCd As MDORowSet, wb_WtFrOrd As Boolean, ws_ShowPtr As String
  Dim ws_OrLn As String, ws_Ptr As String
  
    '****** Sachin 3.02 - Current Partition
    'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
    Set wRs = moCn.OpenResultset("Select * From Fgd " + _
                                 "Where FdCoCd= '" + ms_OmCoCd + "' and FdTc= '" + ms_Vch(0) + "' " + _
                                 " And FdYy= '" + ms_Vch(1) + "' and FdChr= '" + ms_Vch(2) + "' " + _
                                 " And FdNo= " + ms_Vch(3) + " and FdSr= " + ms_Vch(4) + " and FdPrtKey='" + ctCurrPrtn + "'")
  
    ws_OrLn = "(case when Pvalue3='Y' then (Case when PValue2='Y' then  " + _
            "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty=0 then 0 else  " + _
            "cast((OrPrdWt/OrPrdQty) as Decimal(12,4)) end ) end )  " + _
            "else cast(Orln1 as Decimal(12,4)) end ) "
    'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
    ws_ShowPtr = moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ms_OmCoCd + "' and HCd= '" + ctSelfCmCd + "'")
    ws_Ptr = "max(case when '" + ws_ShowPtr + "'= 'Y' then (Case when PValue2='Y' then  " + _
             "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty= 0 then 0 else  " + _
             "cast((OrPrdWt/ OrPrdQty) as Decimal(12, 4)) end ) end )  " + _
             "else 0 end) as qRmPtr "
             
    ' ****** Manali 3.5.0 - 17/11/08 - Allow OtRmCd of Other RmCtg in case of Main Metals
    wStr = " Select (case when max(isnull(qOrRmCd, ''))= '' then '' else 'Y' end) as qOrRmExists, " + _
           " 0 as qSrNo, max(RmCtg) as qRmCtg, max(RmSCtg) as qRmSCtg, FrRmCd as qRmCd, max(RmCtg) as qRmOldCtg, max(RmSCtg) as qRmOldSCtg, FrRmCd as qRmOldCd, sum(FrRmStkRt*FrRmWt)/(case when sum(FrRmWt)> 0  " + _
           " then sum(FrRmWt) else 1 end) as qStkRt, " + _
           " Max(IsNull(qLn1, (case when PValue3= 'N' then FrRmSz else 0 end) )) as qLn1, Max(IsNull(qOrLn2,0)) as qLn2,Max(IsNull(qOrLn3,0)) as qLn3, " + _
           " sum(FrRmQty) as qQty, " + _
           " max(IsNull(qRmPtr, (case when PValue3= 'Y' then FrRmSz else 0 end))) as qRmPtr, sum(FrRmWt) As qWt, Convert(Decimal(14,3),0) as qXtraWt," + _
           " sum(FrRmQty) as qPrdQty, sum(FrRmWt) As qPrdWt, IsNull(qOrSetSCd, '') as qSetSCd, " + _
           " Sum(IsNull(qOrWsQty,0)) as qWsQty, Sum(IsNull(qOrHsQty,0)) as qHsQty, " + _
           " Max(IsNull(qOrSubShp,'')) as qSubShp, Max(IsNull(qOrAlyCd,''))as qAlyCd, Space(1) as qMainMet,  0 as OrLmeSal, " + _
           " Convert(Decimal(14,3),0) as OrSalRt, Convert(Decimal(14,3),0) as OrCstRt, Convert(Decimal(14,2),0) as OrSalVal, Convert(Decimal(14,2),0) as OrCstVal, Convert(Decimal(14,2),IsNull(qOrSetSalRt,0)) as OrSetSalRt, " + _
           " Convert(Decimal(14,2),IsNull(qOrSetSalRt,0)) as OrSetCstRt, Convert(Decimal(14,2),0) as OrSetSalVal, Convert(Decimal(14,2),0) as OrSetCstVal, Convert(Decimal(14,2),0) as OrAlySalRt, Convert(Decimal(14,2),0) as OrAlyCstRt, " + _
           " Max(IsNull(qOrQty,0)) as qOrQty, Max(RmSTWGrp) as qRmSTWGrp, max(Isnull(qOrWt,0)) as qOrWt,'' as OrLotNo "
           
           '****** Sachin - line below temporarily commented ******
           '" Max(PValue3) as qStkByPtr, Max(IsNull(qOrQty,0)) as qOrQty, Max(RmSTWGrp) as qRmSTWGrp, max(Isnull(qOrWt,0)) as qOrWt "
    
    '****** Sachin 3.02 - Current Partition
    'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
    wStr = wStr + " Into " + ms_TmpTbl + " From Fgd join FgRm on FrFdIdNo=FdIdNo And FrCoCd= FdCoCd and FrTc= FdTc and FrYy= Fdyy and " + _
           "FrChr= FdChr and FrNo = FdNo And FrSr = FdSr and FrPrtKey=FdPrtKey " + _
           "Join RmMst on FrRmCd = RmCd and FrPrtKey=RmPrtKey " + _
           "Join Param P1 on P1.PTyp= 'RMSCTG' and P1.PMCd= RmCtg and P1.PSCd= RmSCtg " + _
           "Left Outer Join (select OrRmCd as qOrRmCd, " + ws_OrLn + " as qOrLn1, OrSetSCd as qOrSetSCd, OrSetSalRt as qOrSetSalRt, " + _
           "sum(OrWt) as qOrWt, sum(OrQty) as qOrQty, Max(OrLn2) as qOrLn2,Max(OrLn3) as qOrLn3, Sum(OrWsQty) as qOrWsQty, " + _
           "Sum(OrHsQty) as qOrHsQty, Max(OrSubShp) as qOrSubShp, max(OrAlyCd) as qOrAlyCd, " + _
           ws_Ptr + ", max(OrLn1) as qLn1 from OrdRm " + _
           "Join RmMst on RmCd= OrRmCd and RmPrtKey=OrPrtKey " + _
           "Join Param on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
           "where OrCoCd= '" + ms_OmCoCd + "'  and OrTc = '" + wRs!FdPrdOdTc + "' " + _
           "and OrYy= '" + wRs!FdPrdOdYy + "' " + _
           " and OrChr= '" + wRs!FdPrdOdChr + "' and OrNo = " + CStr(wRs!FdPrdOdNo) + _
           " and OrSr= " + CStr(wRs!FdPrdOdSr) + " and OrPrtKey='" + ADC("OmPrtKey") + "' Group By " + _
           "OrRmCd, " + ws_OrLn + ", OrSetSCd , OrSetSalRt) Or2 On qOrRmCd= FrRmCd and qOrLn1= FrRmSz " + _
           " Where FdCoCd = '" + ms_OmCoCd + "' and FdTc= '" + wRs!FdTc + "' and FdYy= '" + _
           wRs!FdYy + "' and FdChr= '" + wRs!FdChr + "' and " + _
           "FdNo = " + CStr(wRs!FdNo) + " and FdSr = " + CStr(wRs!FdSr) + " and FdPrtKey='" + ctCurrPrtn + "'" + _
           IIF(ms_CtgStr <> "", " and '," + ms_CtgStr + ",' Not Like '%,'+ RmCtg+ ',%' ", " ") + _
           "Group by FrRmCd, FrRmSz, qOrSetSCd, qOrSetSalRt "
  
      '*** Creating Temporary Table #TmpOrdRm ***
       moCn.CreateTmpTable ms_TmpTbl, wStr
       
       Set wRsRmDet = moCn.OpenResultset("Select * from " + ms_TmpTbl)
      
      If moCn.RecSeek(" Select count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd) From " + ms_TmpTbl + " " + _
                    " Group by qRmCd, qLn1 Having count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd)> 1") Then
                    
       '*** To get Proportionate weights
      '****** Sachin 3.02 - Current Partition
      Set wFRmDet = moCn.OpenRes("Select Max(RmCtg) as qRmCtg, Max(RmSCtg) as qRmSCtg, FrRmCd as qFrRmCd, max(FrRmSz) as qFrRmsz, " + _
                         " Sum(FrRmWt) as qFrRmWt, Sum(FrRmQty) as qFrRmQty from FgRm  " + _
                         " Join RmMst On RmCd=FrRmCd and RmPrtKey=FrPrtKey " + _
                         " Join Fgd on FrFdIdNo=FdIdNo And FrCoCd= FdCoCd and FrTc= FdTc and FrYy= FdYy and  " + _
                         " FrChr= FdChr and FrNo = FdNo And FrSr = FdSr and FrPrtKey=FdPrtKey " + _
                         "where FdCoCd = '" + wRs!FdCoCd + "' and FdTc= '" + wRs!FdTc + "' and FdYy= '" + _
                         wRs!FdYy + "' and FdChr= '" + wRs!FdChr + "' and " + _
                         "FdNo = " + CStr(wRs!FdNo) + " and FdSr = " + CStr(wRs!FdSr) + " and FdPrtKey='" + ctCurrPrtn + "' " + _
                         IIF(ms_CtgStr <> "", " and '," + ms_CtgStr + ",' Not Like '%,'+ RmCtg+ ',%' ", " ") + _
                         "Group By FrRmCd, FrRmSz Order By FrRmCd, FrRmSz")
    
        Do While Not (wFRmDet.EOF Or wFRmDet.BOF)
        Dim wPtrYN As String
            wPtrYN = moCn.GetFldVal("Select PValue3 From Param Where PTyp='RMSCTG' And PMCd='" + wFRmDet!qRmCtg + "' And PSCd='" + wFRmDet!qRmSCtg + "'")
         wOrLnStr = IIF(wPtrYN = "Y", " qRmPtr ", " qLn1 ")
         
          wFrRmWt = wFRmDet!qFrRmWt
          wFrRmQty = wFRmDet!qFrRmQty
          wOrTotWt = moCn.GetFldVal("Select Sum(qOrWt) From " + ms_TmpTbl + " Where qRmCd= '" + wFRmDet!qFrRmCd + "' and " + wOrLnStr + "= '" + CStr(wFRmDet!qFrRmSz) + "' Group By qRmcd, qLn1")
          wOrTotQty = moCn.GetFldVal("Select Sum(qOrQty) From " + ms_TmpTbl + "  Where qRmCd= '" + wFRmDet!qFrRmCd + "' and " + wOrLnStr + "= '" + CStr(wFRmDet!qFrRmSz) + "' Group By qRmCd, qLn1")
          
          If (wRsRmDet.RecCount > 0) Then wRsRmDet.MoveFirst
          
          Do While Not (wRsRmDet.EOF Or wRsRmDet.BOF)
            wPtrYN = moCn.GetFldVal("Select PValue3 From Param Where PTyp='RMSCTG' And PMCd='" + wRsRmDet!qRmCtg + "' And PSCd='" + wRsRmDet!qRmSCtg + "'")
            If wFRmDet!qFrRmCd = wRsRmDet!qRmCd And wFRmDet!qFrRmSz = IIF(wPtrYN = "Y", wRsRmDet!qRmPtr, wRsRmDet!qLn1) Then
                
                wOrLnStr = IIF(wPtrYN = "Y", " qRmPtr ", " qLn1 ")
              
              If moCn.RecSeek(" Select count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd) From " + ms_TmpTbl + " " + _
                              " Where qRmCd= '" + wRsRmDet!qRmCd + "' " + _
                              "   and " + wOrLnStr + "= " + CStr(IIF(wPtrYN = "Y", wRsRmDet!qRmPtr, wRsRmDet!qLn1)) + " " + _
                              " Group by qRmCd, " + wOrLnStr + " Having count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd)> 1") Then
                wRsRmDet.edit
                wRsRmDet!qWt = Round(MWLib.Div(wRsRmDet!qOrWt, wOrTotWt) * wFrRmWt, 3)
                wOrTotWt = wOrTotWt - wRsRmDet!qOrWt
                wFrRmWt = wFrRmWt - wRsRmDet!qWt
                wRsRmDet!qQty = Round(MWLib.Div(wRsRmDet!qOrQty, wOrTotQty) * wFrRmQty)
                wOrTotQty = wOrTotQty - wRsRmDet!qOrQty
                wFrRmQty = wFrRmQty - wRsRmDet!qQty
                
                wRsRmDet.Update
              End If
            End If
            wRsRmDet.MoveNext
          Loop
          wFRmDet.MoveNext
        Loop
        Set wFRmDet = Nothing
      End If

      If (wRsRmDet.RecCount > 0) Then wRsRmDet.MoveFirst
      Do While Not (wRsRmDet.EOF Or wRsRmDet.BOF)
        wRsRmDet.edit
        wPtrYN = moCn.GetFldVal("Select PValue3 From Param Where PTyp='RMSCTG' And PMCd='" + wRsRmDet!qRmCtg + "' And PSCd='" + wRsRmDet!qRmSCtg + "'")
        
        '****** Sachin 3.02 - Current Partition
        wOrLnStr = IIF(moCn.GetFldVal("Select PValue3 From Param Join  RmMst " + _
                                " on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                                "where RmCd= '" + wRsRmDet!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "' ") = "Y", _
                       IIF(moCn.GetFldVal("select PValue2 From Param Join RmMst " + _
                                "on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                                "where RmCd= '" + wRsRmDet!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "' ") = "Y", "OrRmPtr", _
                                " case when OrPrdQty =0 then 0 else OrPrdWt/OrPrdQty end "), "OrLn1")
                                
      If moCn.RecSeek("Select Count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd) From " + ms_TmpTbl + " " + _
                    "Where qRmCd= '" + wRsRmDet!qRmCd + "' " + _
                    " And " + IIF(wPtrYN = "Y", " qRmPtr ", " qLn1 ") + "= " + CStr(IIF(wPtrYN = "Y", wRsRmDet!qRmPtr, wRsRmDet!qLn1)) + _
                    "Group By qRmCd, " + IIF(wPtrYN = "Y", " qRmPtr ", " qLn1 ") + " Having Count(distinct Str(OrSetSalRt, 16, 2) + qSetSCd)> 1") Then
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
        wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrCstRt, OrSalRt, OrSetScd, OrSetCstRt, OrSetSalRt, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg, OrLotNo " + _
                "From OrdRm where OrPrtKey='" + ctCurrPrtn + "' and OrCoCd= '" + ms_OmCoCd + "' " + _
                " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
                " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
                " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
                " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
                " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
                " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
                " and " + wOrLnStr + " = " + IIF(wPtrYN = "Y", CStr(wRsRmDet!qRmPtr), CStr(wRsRmDet!qLn1)) + _
                " and OrSetSCd= '" + wRsRmDet!qSetSCd + "' " + _
                " and OrSetSalRt= " + CStr(wRsRmDet!OrSetSalRt) + _
                " Order by OrMainMet Desc, OrSalRt Desc"
  
      Else
      'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
        wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrCstRt, OrSalRt, OrSetScd, OrSetCstRt, OrSetSalRt, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg, OrLotNo " + _
                  " From OrdRm where OrPrtKey='" + ctCurrPrtn + "' and OrCoCd= '" + ms_OmCoCd + "' " + _
                  " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
                  " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
                  " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
                  " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
                  " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
                  " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
                  " and " + wOrLnStr + " = " + IIF(wPtrYN = "Y", CStr(wRsRmDet!qRmPtr), CStr(wRsRmDet!qLn1)) + _
                  "Order by OrMainMet Desc, OrSalRt Desc"
      End If

      Set wOrRecSet = moCn.OpenRes(wOrStr)
'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
        wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrCstRt, OrSalRt, OrSetScd, OrSetCstRt, OrSetSalRt, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg, OrLotNo " + _
               "From OrdRm join RmRt on RrTcTyp= 'RSZ' and RrCmCd= '" + ctSelfCmCd + "' and " + _
               "RrCtg= OrRmCtg and RrSCtg= OrRmSCtg " + _
               "where OrPrtKey='" + ctCurrPrtn + "' and OrCoCd= '" + ms_OmCoCd + "' " + _
               " and OrTc = '" + wRs!FdPrdOdTc + "' " + _
               " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
               " and OrChr = '" + wRs!FdPrdOdChr + "' " + _
               " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
               " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
               " and OrPrtKey= '" + ADC("OmPrtKey") + "' " + _
               " and OrRmCd =  '" + wRsRmDet!qRmCd + "' " + _
               " and " + wOrLnStr + " >= RrFrLn and " + wOrLnStr + " <= RrToLn and " + _
               IIF(wPtrYN = "Y", CStr(wRsRmDet!qRmPtr), CStr(wRsRmDet!qLn1)) + " >= RrFrLn and " + _
               IIF(wPtrYN = "Y", CStr(wRsRmDet!qRmPtr), CStr(wRsRmDet!qLn1)) + " <= RrToLn " + _
               "Order by OrMainMet Desc, OrSalRt Desc "
            Set wOrRecSet = moCn.OpenRes(wOrStr)
        End If
          
      'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
        wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrCstRt, OrSalRt, OrSetScd, OrSetCstRt, OrSetSalRt, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg, OrLotNo " + _
               "From OrdRm where OrCoCd= '" + ms_OmCoCd + "' " + _
               "  and OrTc = '" + wRs!FdPrdOdTc + "' " + _
               " and OrYy= '" + wRs!FdPrdOdYy + "' " + _
               " and OrChr= '" + wRs!FdPrdOdChr + "' " + _
               " and OrNo = " + CStr(wRs!FdPrdOdNo) + _
               " and OrSr= " + CStr(wRs!FdPrdOdSr) + _
               " and OrPrtKey= '" + ADC("OmPrtKey") + "' " + _
               " and OrRmCd= '" + wRsRmDet!qRmCd + "' " + _
               "Order by OrMainMet Desc, OrSalRt Desc"
          Set wOrRecSet = moCn.OpenRes(wOrStr)
      End If
      

      If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
          wRsRmDet!qSetSCd = ""
          wRsRmDet!OrSetCstRt = 0
          wRsRmDet!OrSetSalRt = 0
          wRsRmDet!qOrQty = 0
          wRsRmDet!qOrWt = 0
          wRsRmDet!qAlyCd = ""
          wRsRmDet!qSubShp = ""
          wRsRmDet!qMainMet = "N"
      Else
          wOrRecSet.MoveFirst
          wRsRmDet!qSetSCd = wOrRecSet!OrSetSCd
          wRsRmDet!OrSetCstRt = wOrRecSet!OrSetCstRt
          wRsRmDet!OrSetSalRt = wOrRecSet!OrSetSalRt
        
        If wRsRmDet!qRmPtr = 0 Then _
            wRsRmDet!qRmPtr = GetWtFrSz(wRsRmDet!qRmCtg, wRsRmDet!qRmSCtg, wRsRmDet!qLn1, wRsRmDet!qLn2, wRsRmDet!qRmSTWGrp)
          
            wRsRmDet!qLn2 = IIF(wRsRmDet!qOrRmExists <> "Y", wOrRecSet!OrLn2, wRsRmDet!qLn2)
            wRsRmDet!qLn3 = IIF(wRsRmDet!qOrRmExists <> "Y", wOrRecSet!OrLn3, wRsRmDet!qLn3)
            wRsRmDet!qOrQty = wOrRecSet!OrQty
            wRsRmDet!qOrWt = wOrRecSet!OrWt
            wRsRmDet!OrCstRt = wOrRecSet!OrCstRt
            wRsRmDet!OrSalRt = wOrRecSet!OrSalRt
            wRsRmDet!qAlyCd = wOrRecSet!OrAlyCd
            wRsRmDet!qSubShp = wOrRecSet!OrSubShp
            
            If wRs!Fdqty >= 1 Then
                  wRsRmDet!qQty = MWLib.Div(wRsRmDet!qQty, wRs!Fdqty)
                  wRsRmDet!qWt = MWLib.Div(wRsRmDet!qWt, wRs!Fdqty)
                  wRsRmDet!qPrdQty = wRsRmDet!qQty
                  wRsRmDet!qPrdWt = wRsRmDet!qWt
            End If
            
            If wRsRmDet!qRmCtg = "C" Or wRsRmDet!qRmCtg = "D" Then
              wRsRmDet!qWsQty = wRsRmDet!qQty * (wRsRmDet!qWsQty / (IIF((wRsRmDet!qWsQty + wRsRmDet!qHsQty) > 0, (wRsRmDet!qWsQty + wRsRmDet!qHsQty), 1)))
              wRsRmDet!qHsQty = wRsRmDet!qQty - wRsRmDet!qWsQty
            End If
         
            If wOrRecSet!OrMainMet = "Y" And wMainMet = False Then
              wRsRmDet!qMainMet = "Y": wMainMet = True
            ElseIf wOrRecSet!OrMainMet = "Y" And wMainMet = True Then
              wRsRmDet!qMainMet = "N"
            ElseIf wOrRecSet!OrMainMet = "N" Then
              wRsRmDet!qMainMet = "N"
            End If
            
        End If
        
    wRsRmDet.Update
    wRsRmDet.MoveNext
  Loop

  Set wRsRmDet = Nothing
  Set wOrRecSet = Nothing

End Sub

Private Function GenSuffix(ByVal mi_Row As Integer) As String
  '*** Procedure used to Generate Suffix for PDC
  Dim ws_GenMethd As String, wSfx As String
  ws_GenMethd = moCn.GetFldVal("Select hPdcSfx from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")
  GenSuffix = ""
  Select Case UCase(ws_GenMethd)
  Case Is = "RANDOM"
    Do While GenSuffix = ""
      '****** Sachin 3.02 (10/09/07) - added id fields in joins
      ' ***** Manali Trading Module - OmCmCtg checked for 'PL'
      If moCn.GetFldVal("Select count('x') from OrdDsg join OrdMst On OmIdNo=OdOmIdNo And OmCoCd= OdCoCd and " + _
                        "OmTc= OdTc and OmYy= OdYy and OmChr= OdChr and OmNo= OdNo and OmPrtKey=OdPrtKey where " + _
                        "OmCoCd= '" + ms_OmCoCd + "' and OmPrtKey='" + ctCurrPrtn + "' and " + _
                        "(Select PValue from Param where PTyp='TC' and PMCd= OdTc)= 'PL' " + _
                        "and OdDmCd= '" + GrdOrdDsg.Value(mi_Row, "OdDmCd") + "' " + _
                        "and OdDmSz= '" + GrdOrdDsg.Value(mi_Row, "OdDmSz") + "' " + _
                        "and IsNumeric(OdSfx)= 1 and OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd= '" + ADC("OmCmCd") + "' ") >= 99899 Then _
        DispMsg "All The Random Numbers In The Specified Range Have Been Exhausted", etError: Exit Do
      
      '*** Formula to generate a random number within a range is : Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
      '****** Sachin 3.02 - Current Partition
      ' ***** Manali Trading Module - OmCmCtg checked for 'PL'
      wSfx = CStr(Int((99999 - 101 + 1) * Rnd + 101))
      If moCn.GetFldVal("Select count('x') from OrdDsg join OrdMst on OmIdNo=OdOmIdNo And OmCoCd= OdCoCd and " + _
                        "OmTc= OdTc and OmYy= OdYy and OmChr= OdChr and OmNo= OdNo and OmPrtKey=OdPrtKey where " + _
                        "OmCoCd= '" + ms_OmCoCd + "' and OmPrtKey='" + ctCurrPrtn + "' and " + _
                        "(Select PValue from Param where PTyp='TC' and PMCd= OdTc)= 'PL' " + _
                        "and OdDmCd= '" + GrdOrdDsg.Value(mi_Row, "OdDmCd") + "' " + _
                        "and OdDmSz= '" + GrdOrdDsg.Value(mi_Row, "OdDmSz") + "' " + _
                        "and OdSfx= '" + wSfx + "' and OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd= '" + ADC("OmCmCd") + "' ") = 0 Then _
        GenSuffix = wSfx: Exit Do
    Loop
  Case Is = "INC"
    '*********geeta****Emr207  Gets the max of Numeric Value added  IsNumeric(OdSfx)=1
    '****** Sachin 3.02 - Current Partition
    ' ***** Manali Trading Module - OmCmCtg checked for 'PL'
    wSfx = moCn.GetFldVal("Select max(OdSfx) from OrdDsg join OrdMst on OmIdNo=OdOmIdNo And OmCoCd= OdCoCd and " + _
                          "OmTc= OdTc and OmYy= OdYy and OmChr= OdChr and OmNo= OdNo and OmPrtKey=OdPrtKey where " + _
                          "OmCoCd= '" + ms_OmCoCd + "' and OmPrtKey='" + ctCurrPrtn + "' and " + _
                          "(Select PValue from Param where PTyp= 'TC' and PMCd= OdTc)= 'PL' " + _
                          "and OdDmCd= '" + GrdOrdDsg.Value(mi_Row, "OdDmCd") + "' " + _
                          "and OdDmSz= '" + GrdOrdDsg.Value(mi_Row, "OdDmSz") + "' " + _
                          "and OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd= '" + ADC("OmCmCd") + "' and IsNumeric(OdSfx)=1")
    
    GenSuffix = CStr(IIF(Val(wSfx) >= 101, Val(wSfx) + 1, 101))
    
  Case Is = "MANUAL"
    GenSuffix = ""
  End Select
End Function
Private Function GetGldAsWt(ByVal mOdRow As Double, Optional ByVal mOrRow As Double = 0) As Double
  '*** Procedure used for calculating value of the OdGldAsWt field
  
  '****** (Jen 2.13) , Optional ByVal mOrRow As Double = 0
  Dim wChnGldAs As String, ws_RmSCtg As String                                                           '************Bhavna for chain gold wt calc
  Dim wGldAsWt As Double, wBigStr As String, i As Integer, wWt As Double, wMainMetRmCtg As String
  Dim ws_RmCtg As String    '*** (Jen 2.14)
  wBigStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                  "PTyp='GLDAS' and PMCd = '" + GrdOrdDsg.Value(mOdRow, "OdGldAs") + "'") + ","
                  
  If ADC("wChnCustYn") = "Y" Then
    wChnGldAs = "," + moCn.GetFldVal("Select hChnSubCtgForGld from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain gold wt calc
  Else
    wChnGldAs = ""
  End If
  '*** (Jen 2.13)
  '(Bef 28/11/06)
  'If mOrRow > 0 And Not GrdOrdRm.IsDel(mOrRow) Then
  '  If GrdOrdRm.Value(mOrRow, "OrMainMet") = "Y" Then wMainMetRmCtg = GrdOrdRm.Value(mOrRow, "OrRmCtg")
  'Else
  '(Bef 28/11/06)
  '(28/11/06)
  If mOrRow > GrdOrdRm.Rows - 1 Then mOrRow = 0
  If mOrRow > 0 And Not GrdOrdRm.IsDel(mOrRow) Then
    If GrdOrdRm.Value(mOrRow, "OrMainMet") = "Y" Then wMainMetRmCtg = GrdOrdRm.Value(mOrRow, "OrRmCtg")
  Else
  '(28/11/06)
  '*** (Jen 2.13)
  
    '****** Sachin 3.02 - Current Partition
    wMainMetRmCtg = moCn.GetFldVal("Select OrRmCtg from OrdRm where OrCoCd= '" + ms_OmCoCd + "' and " + _
                    "OrTc= '" + ADC("OmTc") + "' and OrYy= '" + ADC("OmYy") + "' and " + _
                    "OrChr= '" + ADC("OmChr") + "' and OrNo= " + CStr(ADC("OmNo")) + " and " + _
                    "OrSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and OrPrtKey='" + ctCurrPrtn + "' and " + _
                    "OrMainMet= 'Y'")
  '*** (Jen 2.13)
  End If
  '*** (Jen 2.13)
  
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      '*** (Bef 2.14)
      'wWt = IIF((InStr(1, wBigStr, "," + GrdOrdRm.Value(i, "OrRmCtg") + ",") <> 0) And _
      '          (GrdOrdRm.Value(i, "OrRmCtg") <> wMainMetRmCtg Or GrdOrdRm.Value(i, "OrMainMet") = "Y"), _
      '          GrdOrdRm.Value(i, "OrWt"), 0)
      '*** (Bef 2.14)
                
      '*** (Jen 2.14)
      '*** (Bef 05/01/07)
      'wWt = IIF(((InStr(1, wBigStr, "," + GrdOrdRm.Value(i, "OrRmCtg") + ",") <> 0) And _
                  GrdOrdRm.Value(i, "OrRmCtg") <> wMainMetRmCtg) _
                  Or GrdOrdRm.Value(i, "OrMainMet") = "Y", _
                GrdOrdRm.Value(i, "OrWt"), 0)
      '*** (Bef 05/01/07)
      
      '*** (05/01/07)
      ws_RmCtg = UCase(GrdOrdRm.Value(i, "OrRmCtg"))
      ws_RmSCtg = UCase(GrdOrdRm.Value(i, "OrRmSCtg"))                                      '************Bhavna for chain gold wt calc
      ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
      ' *****bhavna included the check that rmsctg not in Chain gold as ctg
      wWt = IIF(((InStr(1, wBigStr, "," + ws_RmCtg + ",") <> 0) And GrdOrdRm.Value(i, "OrRmCtg") <> wMainMetRmCtg And _
                     (InStr(1, wChnGldAs, "," + ws_RmSCtg + ",") = 0) And _
                  ws_RmCtg <> "G" And ws_RmCtg <> "P" And ws_RmCtg <> "S" And ws_RmCtg <> "L") _
                  Or GrdOrdRm.Value(i, "OrMainMet") = "Y", _
                GrdOrdRm.Value(i, "OrWt"), 0)
      '*** (05/01/07)
      '*** (Jen 2.14)
                
      wGldAsWt = wGldAsWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D" Or _
                                GrdOrdRm.Value(i, "OrRmCtg") = "C", MWLib.Div(wWt, 5), wWt)
    End If
  Next i
  GetGldAsWt = IIF(wGldAsWt < 0, 0, wGldAsWt)
End Function

Private Function GetLabAsWt(ByVal mOdRow As Double) As Double
  '****** Sachin 2.13.0 - 25-05-2006 ******
  '*** Procedure used for calculating value of the OdLabAsWt field
  Dim wLabAsWt As Double, wBigStr As String, i As Integer, wWt As Double
  Dim wChnLabAs As String, ws_RmSCtg As String                                                   ' **************Bhavna for Chain Labour wt calc
  wBigStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                  "PTyp='GLDAS' and PMCd = '" + GrdOrdDsg.Value(mOdRow, "OdLabAs") + "'") + ","
                  
  If ADC("wChnCustYn") = "Y" Then
    wChnLabAs = "," + moCn.GetFldVal("Select hChnSubCtgForLab from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain labour gold wt calc
  Else
    wChnLabAs = ""
  End If
  
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      ws_RmSCtg = UCase(GrdOrdRm.Value(i, "OrRmSCtg"))                                              '************Bhavna for chain labour gold wt calc
      wWt = IIF((InStr(1, wBigStr, "," + GrdOrdRm.Value(i, "OrRmCtg") + ",") <> 0) And (InStr(1, wChnLabAs, "," + ws_RmSCtg + ",") = 0), _
                GrdOrdRm.Value(i, "OrWt"), 0)
      wLabAsWt = wLabAsWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D" Or _
                                GrdOrdRm.Value(i, "OrRmCtg") = "C", MWLib.Div(wWt, 5), wWt)
    End If
  Next i
  GetLabAsWt = IIF(wLabAsWt < 0, 0, wLabAsWt)
  '****** Sachin 2.13.0 - 25-05-2006 ******
End Function
Private Function GetCstLabAsWt(ByVal mOdRow As Double) As Double
  '****** Sachin 2.13.0 - 25-05-2006 ******
  '*** Procedure used for calculating value of the OdLabAsWt field
  Dim wLabAsWt As Double, wBigStr As String, i As Integer, wWt As Double
  Dim wChnLabAs As String, ws_RmSCtg As String                                                   ' **************Bhavna for Chain Labour wt calc
  wBigStr = "," + moCn.GetFldVal("Select PDesc225 from Param where " + _
                  "PTyp='GLDAS' and PMCd = '" + GrdOrdDsg.Value(mOdRow, "OdLabAs") + "'") + ","
                  
  If ADC("wChnCustYn") = "Y" Then
    wChnLabAs = "," + moCn.GetFldVal("Select hChnSubCtgForLab from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain labour gold wt calc
  Else
    wChnLabAs = ""
  End If
  
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      ws_RmSCtg = UCase(GrdOrdRm.Value(i, "OrRmSCtg"))                                              '************Bhavna for chain labour gold wt calc
      wWt = IIF((InStr(1, wBigStr, "," + GrdOrdRm.Value(i, "OrRmCtg") + ",") <> 0) And (InStr(1, wChnLabAs, "," + ws_RmSCtg + ",") = 0), _
                GrdOrdRm.Value(i, "OrWt"), 0)
      If Not (GrdOrdRm.Value(i, "OrRmCtg") = "D" Or GrdOrdRm.Value(i, "OrRmCtg") = "C" Or GrdOrdRm.Value(i, "OrRmCtg") = "X") Then _
            wLabAsWt = wLabAsWt + wWt
    End If
  Next i
  GetCstLabAsWt = IIF(wLabAsWt < 0, 0, wLabAsWt)
  '****** Sachin 2.13.0 - 25-05-2006 ******
End Function
Private Sub RefreshRt(Optional ws_LabMCd As String, Optional wOdSrStrWithErr As String)
  Dim wi_D As Integer, wi_R As Integer, wi_L As Integer
  Dim wf_BaseLmeSal As Single, wf_BaseLmeCst As Single
  ADC("OmRefreshDt") = ADC("wOmRefreshDt")
  If InStr(1, "," + ms_CpyRateOpt + ",", "G") >= 1 Then
    ADC("OmLmgDt") = ADC("wOmLmgDt")
    ADC("OmLmgCst") = ADC("wOmLmgCst")
    ADC("OmLmgSal") = ADC("wOmLmgSal")
  End If
  If InStr(1, "," + ms_CpyRateOpt + ",", "P") >= 1 Then
    ADC("OmLmpDt") = ADC("wOmLmpDt")
    ADC("OmLmpCst") = ADC("wOmLmpCst")
    ADC("OmLmpSal") = ADC("wOmLmpSal")
  End If
  If InStr(1, "," + ms_CpyRateOpt + ",", "S") >= 1 Then
    ADC("OmLmsDt") = ADC("wOmLmsDt")
    ADC("OmLmsCst") = ADC("wOmLmsCst")
    ADC("OmLmsSal") = ADC("wOmLmsSal")
  End If
  If InStr(1, "," + ms_CpyRateOpt + ",", "L") >= 1 Then
    ADC("OmLmlDt") = ADC("wOmLmlDt")
    ADC("OmLmlCst") = ADC("wOmLmlCst")
    ADC("OmLmlSal") = ADC("wOmLmlSal")
  End If
 ' Dim wSr As String
  'wSr = "," + CStr(GrdOrdDsg.Row(wi_D, "OdSr")) + ","
  If IsMissing(wOdSrStrWithErr) Then wOdSrStrWithErr = ""
  If ADC("wOmRefMulByYn") = "Y" Then ADC("OmMulBy") = ADC("wOmRefMulBy")
  MWLib.BeginProcess Me, "Refreshing Rates"
  BeginEmrProcess Me, "Refresh Rate"
    For wi_D = 1 To GrdOrdDsg.Rows - 1
      UpdateEmrProcess "Refreshing Rates For Design Sr No " + CStr(GrdOrdDsg.Value(wi_D, "OdSr")) + "::OrdRm: " + CStr(0) + ""
      GrdOrdDsg.Row = wi_D
      If GrdOrdDsg.Value(wi_D, "OdPrtKey") = ctCurrPrtn Then
        If ADC("wOmRefMulByYn") = "Y" Then GrdOrdDsg.Value(wi_D, "OdMulBy") = ADC("wOmRefMulBy")
        With GrdOrdRm
          For wi_R = 1 To .Rows - 1
            UpdateEmrProcess "Refreshing Rates For Design Sr No " + CStr(GrdOrdDsg.Value(wi_D, "OdSr")) + "::OrdRm: " + CStr(wi_R) + ""
            If .Value(wi_R, "OrPrtKey") = ctCurrPrtn Then
            If InStr(1, "," + ms_CpyRateOpt + ",", .Value(wi_R, "OrRmCtg")) >= 1 Then
              If UCase(.Value(wi_R, "OrRmCtg")) = "X" Then
                wf_BaseLmeSal = moCn.GetFldVal("Select IsNull((Select (case B.RmCtg when 'G' then " + CStr(ADC("OmLmgSal")) + " " + _
                                "when 'P' then " + CStr(ADC("OmLmpSal")) + " when 'S' then " + CStr(ADC("OmLmsSal")) + " " + _
                                "when 'L' then " + CStr(ADC("OmLmlSal")) + " else 0 end) from RmMst B where " + _
                                "RmCd= (Select Rm.RmBaseCd from RmMst Rm where Rm.RmCd= '" + .Value(wi_R, "OrRmCd") + "') and RmPrtKey='" + ctCurrPrtn + "'), 0) ")
                wf_BaseLmeCst = moCn.GetFldVal("Select IsNull((Select (case B.RmCtg when 'G' then " + CStr(ADC("OmLmgCst")) + " " + _
                                "when 'P' then " + CStr(ADC("OmLmpCst")) + " when 'S' then " + CStr(ADC("OmLmsCst")) + " " + _
                                "when 'L' then " + CStr(ADC("OmLmlCst")) + " else 0 end) from RmMst B where " + _
                                "RmCd= (Select Rm.RmBaseCd from RmMst Rm where Rm.RmCd= '" + .Value(wi_R, "OrRmCd") + "') and RmPrtKey='" + ctCurrPrtn + "'), 0) ")
              Else
                wf_BaseLmeSal = 0
                wf_BaseLmeCst = 0
              End If
              .Value(wi_R, "OrLmeSal") = IIF(.Value(wi_R, "OrRmCtg") = "G", ADC("OmLmgSal"), _
                                       IIF(.Value(wi_R, "OrRmCtg") = "P", ADC("OmLmpSal"), _
                                       IIF(.Value(wi_R, "OrRmCtg") = "S", ADC("OmLmsSal"), _
                                       IIF(.Value(wi_R, "OrRmCtg") = "L", ADC("OmLmlSal"), 0))))
    
                Dim wRtForChecking As Single
                wRtForChecking = GetRmRt(ADC("OmCmCd"), .Value(wi_R, "OrAlyCd"), _
                                           0, 0, 0, "C", 0, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                           IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
                If wRtForChecking > 0 Then .Value(wi_R, "OrAlyCstRt") = wRtForChecking
               
                wRtForChecking = GetRmRt(ADC("OmCmCd"), .Value(wi_R, "OrAlyCd"), _
                                           0, 0, 0, "S", 0, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                           IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
                If (wRtForChecking > 0) Then .Value(wi_R, "OrAlySalRt") = wRtForChecking
                
                If .Value(wi_R, "OrRmCtg") = "G" Then
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), .Value(wi_R, "OrLmeSal"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlySalRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                        IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                        IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                        IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""), "Y", _
                                        .Value(wi_R, "OrLn1"), .Value(wi_R, "OrLn2"), _
                                          Round(MWLib.Div(.Value(wi_R, "OrWt"), .Value(wi_R, "OrQty")), 5))
                      If wRtForChecking > 0 Then .Value(wi_R, "OrSalRt") = wRtForChecking
                      '6.1-13 , , added in GetGldrt of GPSL. these parameters ignored and partition key values entered in this palce
                      'so LkupRmrt parameter passed as C (partition key)
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), ADC("OmLmgCst"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlyCstRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
                     If wRtForChecking > 0 Then .Value(wi_R, "OrCstRt") = wRtForChecking
                ElseIf .Value(wi_R, "OrRmCtg") = "P" Then
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), .Value(wi_R, "OrLmeSal"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlySalRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                        IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                        IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                        IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""), "Y", _
                                        .Value(wi_R, "OrLn1"), .Value(wi_R, "OrLn2"), _
                                          Round(MWLib.Div(.Value(wi_R, "OrWt"), .Value(wi_R, "OrQty")), 5))
                      If wRtForChecking > 0 Then .Value(wi_R, "OrSalRt") = wRtForChecking
                      '6.1-13 , , added in GetGldrt of GPSL. these parameters ignored and partition key values entered in this palce
                      'so LkupRmrt parameter passed as C (partition key)
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), ADC("OmLmpCst"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlyCstRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
                      If wRtForChecking > 0 Then .Value(wi_R, "OrCstRt") = wRtForChecking
                ElseIf .Value(wi_R, "OrRmCtg") = "S" Then
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), .Value(wi_R, "OrLmeSal"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlySalRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                        IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                        IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                        IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""), "Y", _
                                        .Value(wi_R, "OrLn1"), .Value(wi_R, "OrLn2"), _
                                          Round(MWLib.Div(.Value(wi_R, "OrWt"), .Value(wi_R, "OrQty")), 5))
  
                      If wRtForChecking > 0 Then .Value(wi_R, "OrSalRt") = wRtForChecking
                      '6.1-13 , , added in GetGldrt of GPSL. these parameters ignored and partition key values entered in this palce
                      'so LkupRmrt parameter passed as C (partition key)
                      wRtForChecking = GetGldRt(ADC("OmCmCd"), ADC("OmLmsCst"), _
                                        .Value(wi_R, "OrRmCd"), .Value(wi_R, "OrAlyCstRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(wi_R, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
                                            
