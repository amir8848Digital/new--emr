                  " And OmYy = '" + ADC("OmYy") + "'" + _
                  " And OmChr ='" + ADC("OmChr") + "' " + _
                  " And OmNo =" + CStr(ADC("OmNo")) + " And OmPrtKey = (Case When '" + gs_Partition + "'='" + ctCurrPrtn + "' then '" + ctCurrPrtn + "' Else OmPrtKey End)"
