           wErrMsg = IIF(wErrMsg <> "", "/", "") + "InValid Customer Design Code."
    
       '****** Checking for valid Design Color in the Excel File
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 8)) <> "" And Not moCn.RecSeek("Select 'x' From Param Where PTyp='DMCOL' And PMCd='" + ReadCell(ADC("WXLSHTNO"), i, 8) + "' ") Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Design Color."
  
        '****** Checking for valid Design Size in the Excel File
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 5)) <> "" And Not moCn.RecSeek("Select 'x' From Param Where PTyp='DMSZ' And PMCd='" + ReadCell(ADC("WXLSHTNO"), i, 5) + "' ") Then _
              wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Design Size."
            
            
        '****** Checking for valid Design Quantity in the Excel File
        If ReadCell(ADC("WXLSHTNO"), i, 6) = "" Or Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 6)) Then Call SetCellVal(ADC("WXLSHTNO"), i, 6, "0")
        If (Not wb_IsJRI) And (Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 6)) Or Val(ReadCell(ADC("WXLSHTNO"), i, 6)) = 0 Or Val(ReadCell(ADC("WXLSHTNO"), i, 6)) > 99999.9) Then _
             wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Quantity Entered, Should be Between 1 and 99999.9"
            

        If ReadCell(ADC("WXLSHTNO"), i, 7) = "" Or Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 7)) Then Call SetCellVal(ADC("WXLSHTNO"), i, 7, "0")
        
        '****** Checking for valid Design Code in the Excel File
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 3)) <> "" And Not moCn.RecSeek("Select 'x' From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + Trim(ReadCell(ADC("WXLSHTNO"), i, 3)) + "' And DmSz='' ") Then _
            wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Design Code"
            
        '****** Checking for combination Or Our and Customer Dsg Code
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 2)) <> "" And Trim(ReadCell(ADC("WXLSHTNO"), i, 3)) <> "" And Not moCn.RecSeek("Select 'x' From CustDsg Where CdCustDmCd='" + Trim(ReadCell(ADC("WXLSHTNO"), i, 2)) + "' And " + _
                                  " CdOurDmCd ='" + Trim(ReadCell(ADC("WXLSHTNO"), i, 3)) + "' And CdOurSfx in ('','" + Trim(ReadCell(ADC("WXLSHTNO"), i, 4)) + "') And CdOurDmSz in ('','" + Trim(ReadCell(ADC("WXLSHTNO"), i, 5)) + "') ") Then _
