            'new
            moCn.Execute ("Delete From OrdCT Where OctCoCd ='" + ms_OmCoCd + "' And " + _
                          " OctTc = '" + ADC("OmTc") + "' And OctYy = '" + ADC("OmYy") + "' And " + _
                          " OctChr = '" + ADC("OmChr") + "' And OctNo = " + CStr(ADC("OmNo")) + " And " + _
                          " OctSr = " + CStr(Params(wctOdSr)))
                          
            moCn.Execute ("Delete From OrdDsg Where OdCoCd ='" + ms_OmCoCd + "' And " + _
