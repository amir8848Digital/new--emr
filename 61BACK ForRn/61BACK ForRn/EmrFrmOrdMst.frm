Private Sub DispFra(ByVal pv_DispFra As en_DispFra)
  '*** This is the common procedure which is used to toggle between hiding and displaying
      'the frames (i.e. if the frame is visible then make it invisible and viseversa)
      'associated with a command button

  Select Case pv_DispFra
  Case Is = DsgDet
    If FraDsgDet.Visible = True Then
      FraDsgDet.Visible = False
      '*** required to pass the array position DsgDet-0, to resotre the 'Causes Validation' State
      Call EnaDisaCmds(False, CmdDsgDet, DsgDet)
      'GrdOrdDsg.SetFocus   '*** (Bef 3.01)
      If GrdOrdDsg.Visible = True And GrdOrdDsg.Enabled = True Then GrdOrdDsg.SetFocus    '*** (Jen 3.01)
    Else
      FraDsgDet.Visible = True
      FraDsgDet.Enabled = IIF(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn, False, True)    '****** Sachin 3.02
      'ADC("wOdPrdSeq").SetFocus   '*** (Bef 3.01) (This field is not there from 3.01)
      '*** (3.01 Orig) If ADC("wOdVaCtg").Visible = True And ADC("wOdVaCtg").Enabled = True And FraDsgDet.Enabled = True Then ADC("wOdVaCtg").SetFocus '*** (Jen 3.01)
      If ADC("wOdVaCtg").Visible = True And ADC("wOdVaCtg").Enabled = True And FraDsgDet.Enabled = True Then ADC("wOdVaCtg").SetFocus '*** (Jen 3.01) '****** Sachin 3.02
      FraDsgDet.ZOrder
      
      Call EnaDisaCmds(True, CmdDsgDet)
    End If
  Case Is = OrdAmd
    If FraOrdAmd.Visible = True Then
      FraOrdAmd.Visible = False
      '*** required to pass the array position OrdAmd-5, to resotre the 'Causes Validation' State
      Call EnaDisaCmds(False, CmdOrdAmd, OrdAmd)
      'CmdOrdAmd.SetFocus    '*** (Bef 3.01)
      If CmdOrdAmd.Visible = True Then CmdOrdAmd.SetFocus    '*** (Jen 3.01)
    Else
      FraOrdAmd.Visible = True
      'GrdOrdAmd.SetFocus    '*** (Bef 3.01)
      If GrdOrdAmd.Visible = True And GrdOrdAmd.Enabled = True Then GrdOrdAmd.SetFocus    '*** (Jen 3.01)
      FraOrdAmd.ZOrder
      Call EnaDisaCmds(True, CmdOrdAmd)
    End If
  Case Is = OrdDet
    If FraOrdDet.Visible = True Then
      FraOrdDet.Visible = False
      '*** required to pass the array position OrdDet-1, to resotre the 'Causes Validation' State
      Call EnaDisaCmds(False, CmdOrdDet, OrdDet)
      'CmdOrdDet.SetFocus   '*** (Bef 3.01)
      If CmdOrdDet.Visible = True Then CmdOrdDet.SetFocus   '*** (Jen 3.01)
    Else
      FraOrdDet.Visible = True
      'ADC("OmMulBy").SetFocus    '*** (Bef 3.01)
      FraOrdDet.Enabled = IIF(ADC("OmPrtKey") <> ctCurrPrtn Or CDate(ms_PurgeDt) > ADC("OmDt"), False, True)  '****** Sachin 3.02
      '*** (Jen 3.01 Orig) If ADC("OmMulBy").Visible = True And ADC("OmMulBy").Enabled = True And FraOrdDet.Enabled = True Then ADC("OmMulBy").SetFocus    '*** (Jen 3.01)
      If ADC("OmMulBy").Visible = True And ADC("OmMulBy").Enabled = True And FraOrdDet.Enabled = True Then ADC("OmMulBy").SetFocus  '*** (Jen 3.01)
      ' **** Manali Trading Module
      If ms_OmTcTyp = ctJtTcTyp Then FraHistRt.Visible = False
      ' **** Manali Trading Module
      FraOrdDet.ZOrder
      Call EnaDisaCmds(True, CmdOrdDet)
    End If
  Case Is = DsgCpy
    If FraDsgCpy.Visible = True Then
      FraDsgCpy.Visible = False
      '*** required to pass the array position DsgCpy-2, to resotre the 'Causes Validation' State
      Call EnaDisaCmds(False, CmdDsgCpy, DsgCpy)
      'GrdOrdDsg.SetFocus     '*** (Bef 3.01)
      If GrdOrdDsg.Visible = True And GrdOrdDsg.Enabled = True Then GrdOrdDsg.SetFocus    '*** (Jen 3.01)
    Else
      FraDsgCpy.Visible = True
      'ADC("wDsgSfx").SetFocus    '*** (Bef 3.01)
      If ADC("wDsgSfx").Visible = True And ADC("wDsgSfx").Enabled = True Then ADC("wDsgSfx").SetFocus    '*** (Jen 3.01)
      FraDsgCpy.ZOrder
      Call EnaDisaCmds(True, CmdDsgCpy)
    End If
  Case Is = Summ
    If FraSumm.Visible = True Then
      FraSumm.Visible = False
      '*** required to pass the array position Summ-4, to resotre the 'Causes Validation' State
      Call EnaDisaCmds(False, CmdSumm, Summ)
      'CmdSumm.SetFocus   '*** (Bef 3.01)
      If CmdSumm.Visible = True Then CmdSumm.SetFocus   '*** (Jen 3.01)
