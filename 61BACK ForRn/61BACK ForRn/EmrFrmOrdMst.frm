Private Sub cmdRepRmRt_Click()
  Dim wi_D As Integer, wi_R As Integer, wi_L As Integer
  Dim wf_BaseLmeSal As Single, wf_BaseLmeCst As Single
  
  ADC("OmRefreshDt") = ADC("wOmRefreshDt")
  Dim i As Integer
  If ms_PwdFlag = False Then
     DispMsg "Enter SEO Password for Refreshing the Rates", etError
     MsgBox "Enter SEO Password for Refreshing the Rates"
     Exit Sub
  End If
  If ADC("WOCOCD") <> ADC("OmCoCd") Or ADC("wOmYy") <> ADC("OmYY") Or ADC("wOmTc") <> ADC("OmTc") Or ADC("wOmChr") <> ADC("OmChr") Or ADC("wOmNo") <> ADC("OmNo") Then
      MsgBox "This option can only be used on the same voucher"
      Exit Sub
  End If
  If (UCase(ADC("WORDCPYGRP")) <> UCase("RmRt") And UCase(ADC("WORDCPYGRP")) <> UCase("RmCdRt")) Then
    MsgBox "Please select Group By option as RmRt or RmCdRt for Replacing Rm Rates."
    Exit Sub
  End If
  Dim wi_OdFrSr As Long, wi_OdToSr As Long
  wi_OdFrSr = ADC("wFrOdSr")
  wi_OdToSr = ADC("wToOdSr")
  For wi_D = 1 To GrdOrdDsg.Rows - 1
  '5716 rate will replace only to Fr/To Sr
   If GrdOrdDsg.Value(wi_D, "OdSr") >= wi_OdFrSr And GrdOrdDsg.Value(wi_D, "OdSr") <= wi_OdToSr Or (ADC("wFrOdSr") = 0 And ADC("wToOdSr") = 0) Then
    For i = 1 To GrdOrdTgt.Rows - 1
      MWLib.BeginProcess Me, "Refreshing Rates"
      BeginEmrProcess Me, "Refresh Rate"
      UpdateEmrProcess "Refreshing Rates For Design Sr No " + CStr(GrdOrdDsg.Value(wi_D, "OdSr")) + "::OrdRm: " + CStr(0) + ""
      GrdOrdDsg.Row = wi_D
      If GrdOrdDsg.Value(wi_D, "OdPrtKey") = ctCurrPrtn Then
        With GrdOrdRm
          For wi_R = 1 To .Rows - 1
            If ADC("WORDCPYGRP") = "RMRT" Then
              UpdateEmrProcess "Refreshing Rates For Design Sr No " + CStr(GrdOrdDsg.Value(wi_D, "OdSr")) + "::OrdRm: " + CStr(wi_R) + ""
               If .Value(wi_R, "OrPrtKey") = ctCurrPrtn Then
                If GrdOrdTgt.Value(i, "OtRmCtg") = .Value(wi_R, "OrRmCtg") And GrdOrdTgt.Value(i, "OtRmSCtg") = .Value(wi_R, "OrRmSCtg") And GrdOrdTgt.Value(i, "OtRmRt") = .Value(wi_R, "OrSalRt") Then
                     If GrdOrdTgt.Value(i, "OtRmRtTgt") <> 0 Then .Value(wi_R, "OrSalRt") = GrdOrdTgt.Value(i, "OtRmRtTgt")
                End If
               End If
            End If
            If ADC("WORDCPYGRP") = "RMCDRT" Then
              UpdateEmrProcess "Refreshing Rates For Design Sr No " + CStr(GrdOrdDsg.Value(wi_D, "OdSr")) + "::OrdRm: " + CStr(wi_R) + ""
              If GrdOrdTgt.Value(i, "OtRmCtg") = .Value(wi_R, "OrRmCtg") And GrdOrdTgt.Value(i, "OtRmSCtg") = .Value(wi_R, "OrRmSCtg") And GrdOrdTgt.Value(i, "OtRmRt") = .Value(wi_R, "OrSalRt") And GrdOrdTgt.Value(i, "OtSrcRmCd") = .Value(wi_R, "OrRmCd") Then
                     If GrdOrdTgt.Value(i, "OtRmRtTgt") <> 0 Then .Value(wi_R, "OrSalRt") = GrdOrdTgt.Value(i, "OtRmRtTgt")
              End If
            End If
            GrdOrdRm.SaveRec (wi_R)
          Next wi_R
      End With
      End If
NextOdRow:
  Next i
 End If
Next wi_D
UpdateEmrProcess "Completed Refreshing Rates"
EndEmrProcess Me
MWLib.EndProcess Me
Call DispFra(ORDCPY)

End Sub


