      End If
'*** Jay 2.13(CT) ***
      ' ****** Manali 3.03 - Ct Cpy open for "QT"
      If mf_CTMod = True And (UCase(ms_OmTcTyp) = "PL" Or UCase(ms_OmTcTyp) = "SO" Or UCase(ms_OmTcTyp) = "QT") Then
        Dim ws_OctRmCdStr As String
        '****** Sachin 3.02 - Current Partition
        ws_OctRmCdStr = "Left Outer Join OrdTgt on OtCoCd= '" + ms_OmCoCd + "' and " + _
                        "OtTc= '" + ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and " + _
                        "OtChr= '" + ADC("OmChr") + "' and OtNo= " + CStr(ADC("OmNo")) + " and OtPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OtPrtKey") + " and " + _
                        IIF(pv_OrdCpy = True, "OtSr= 0 ", "OtSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))) + " and " + _
                        "OtRmCtg= RmCtg and OtRmSCtg= RmSCtg " + _
                        IIF(pv_CpyFrRet = True, "and 1= 2 ", " ") + " "
        
        If pv_CpyFrDsgMst = True Then
