Private Sub ForCpy_GetOdMinMaxDiaTolWt()
                Dim wRs_TolWt As MDORowSet
                Dim wTotDiaWt As Double
                wTotDiaWt = Params(qOdPerPcDiaPrdWt)
               If wTotDiaWt < Params(wOdMinDiaTolWt) Or wTotDiaWt > Params(wOdMaxDiaTolWt) Then
                 Set wRs_TolWt = moCn.OpenRes("Select Top 1 " + _
                                            "(Case when ('" + Params(wOdIWtEqOrd) + "'='Y' or '" + Params(wOdFixPrc) + "'='Y' Or ('" + Params(wOdIWtEqOrd) + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMinTol Else RrOpnMinTol End) as qMinTolWt, " + _
                                            "(Case when ('" + Params(wOdIWtEqOrd) + "'='Y' or '" + Params(wOdFixPrc) + "'='Y' Or ('" + Params(wOdIWtEqOrd) + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMaxTol Else RrOpnMaxTol End) as qMaxTolWt " + _
                                           "From RmRt Left Outer Join Param On  PTyp='IWTFRORD' and PMCd='" + Params(wOdIWtFrOrd) + "'  " + _
                                           "Where (RrCmCurCd='" + ADC("OmCmCurCd") + "' Or RrCmCurCd='') and RrTcTyp='WTT'  and RrCmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and RrCtg='D' and RrSCtg='' " + _
                                           "and " + CStr(Params(qOdPerPcDiaPrdWt)) + " between round(RrFrLn,3) and round(RrToLn,3) " + _
                                           "And RrCmCd In ('" + ADC("OmCmCd") + "','" + ctSelfCmCd + "') And RrDmCd In ('" + Params(woddmcd) + "','') " + _
                                           "Order By (Case when RrCmCd='" + ADC("OmCmCd") + "' Then 1 Else 2 End), " + _
                                           "(Case when RrCmCurCd<>'' Then  1 Else 2 End)," + _
                                           "(Case when RrDmCd='" + Params(woddmcd) + "' Then 1 Else 2 End) ")
              
                  If wRs_TolWt.RecCount > 0 Then
                          Dim wHRndOffOdTolWtYn As Boolean
                     wHRndOffOdTolWtYn = moCn.RecSeek("Select 'x' from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "' And HRndOffOdTolWtYn='Y'")
                     If wHRndOffOdTolWtYn = True Then

                    '3.11.0
                      SetParamsVal Fix((wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)) * 100) / 100, wOdMinDiaTolWt
                      SetParamsVal Round((wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)) + 0.004, 2), wOdMaxDiaTolWt
                    Else
                     SetParamsVal wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt), wOdMinDiaTolWt
                      SetParamsVal wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt), wOdMaxDiaTolWt
                    End If
                  ElseIf GrdOrdRm.Mode = fgmCopyOver Then
                    SetParamsVal 0, wOdMinDiaTolWt
                    SetParamsVal 0, wOdMaxDiaTolWt
                  End If
  
                 Set wRs_TolWt = Nothing
               End If

End Sub


Private Function GetOdIdKey(wOdBaseVchSr As String) As Long
