        If Trim(ReadCell(ADC("WXLSHTNO"), i, 17)) <> "" And Not moCn.RecSeek("Select 'x' From Param Where PTyp='SUBCUST' And PMCd='" + ReadCell(ADC("WXLSHTNO"), i, 17) + "' ") Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Sub Customer."
        '33 checking length of sub remark & size instruction
