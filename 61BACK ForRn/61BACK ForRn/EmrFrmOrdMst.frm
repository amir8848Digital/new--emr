Private Sub GrdOrdDsg_SetRecSource()
  '*** Set the CmpStr properties for the fields in the Scope frame so that only records
      'of the specified OrdCTg, Dsg Code can be selected into the GrdOrdDsg grid
  '*** Set the RecSource for GrdOrdDsg
  'Dim wScCnd As String
  GrdOrdDsg.RecSource = GetGrdOrdDsgRecSource
End Sub
Private Function GetGrdOrdDsgRecSource(Optional ByVal wCnd As String = "") As String
    Dim wSrtPdc As String
    wSrtPdc = " Order By OdSr "
    Dim ms_GrdOrdDsgSetRecSource As String
    
    If UCase(ms_MenuCd) = UCase("PrcLst") Then
      If ADC("wScSrtPdc") <> "" Then
        wSrtPdc = moCn.GetFldVal("Select PDesc225 from Param where PTYP= 'SRTPDC' and PMCD= '" + _
                                 ADC("wScSrtPdc") + "' and Pscd= '' ")
  
        wSrtPdc = " Order By " + wSrtPdc
      End If
    End If
    '**********************************************************************************
    
    ADC("wScDmCdFr").CmpStr = "DmCd>= "
    ADC("wScDmCdTo").CmpStr = "DmCd<= "
    ADC("wScDmCtgFr").CmpStr = "DmCtg>= "
    ADC("wScDmCtgTo").CmpStr = "DmCtg<= "
    ADC("wScOrdSrFr").CmpStr = "OdSr>= "
    ADC("wScOrdSrTo").CmpStr = "OdSr<= "
    'vm.4 variable name wScCnd changed as ms_ScCnd
    ms_ScCnd = ADC.RepCond
    
    ms_ScCnd = IIF(ms_ScCnd <> "", " and " + ms_ScCnd, "")
    ms_ScCnd = IIF(ms_ScCnd = "", "", " exists(Select 'x' from DsgMst where DmCd= OdDmCd " + _
                          ms_ScCnd + " ) ")
    'scope not working in jemr, PValue1='N' changed to PValue1='Y'.
    'scope condition is not needed for loose tcs
     Dim wIsJT As String
    wIsJT = moCn.GetFldVal("Select 'Y' from Param where PValue='JT' and PTyp= 'TC' and PMCd= '" + ADC("OmTc") + "' and PValue1='Y' ")
  
    If wIsJT = "Y" Then
      ms_ScCnd = ""
    End If
    GetGrdOrdDsgRecSource = " Select * from OrdDsg " + _
                          " Where OdCoCd ='" + ms_OmCoCd + "'" + _
                          " And OdTc ='" + ADC("OmTc") + "'" + _
                          " And OdYy = '" + ADC("OmYy") + "'" + _
                          " And OdChr ='" + ADC("OmChr") + "' " + _
                          " And OdNo =" + CStr(ADC("OmNo")) + _
                          IIF(gs_Partition = ctCurrPrtn, " And OdPrtKey= '" + ctCurrPrtn + "'", "") + _
                          IIF(ms_ScCnd <> "", " and " + ms_ScCnd, "") + IIF(wCnd <> "", " and ", "") + wCnd + wSrtPdc
    ADC("wScDmCdFr").CmpStr = ""
    ADC("wScDmCdTo").CmpStr = ""
    ADC("wScDmCtgFr").CmpStr = ""
    ADC("wScDmCtgTo").CmpStr = ""
    ADC("wScOrdSrFr").CmpStr = ""
    ADC("wScOrdSrTo").CmpStr = ""

End Function
