Private Function CpyRetMemoForSpclRtnCtg(ByVal pv_rsSrcOd As MDORowSet, ByVal wCoCd As String, ByVal ws_TmpOrdRmTbl As String, ByVal ws_TmpOrdRm1 As String) As String
  Dim ws_CnvRt As Double
  ws_CnvRt = CnvRt(moCn.GetFldVal("Select HBaseCurCd from Head where HCd= '" + ctSelfCmCd + "' and HCoCd= '" + ms_OmCoCd + "'"), ADC("OmCmCurCd"), ADC("OmDt"))

  CpyRetMemoForSpclRtnCtg = "Select IrSrNo as qSrNo, IrRmCtg as qRmCtg, IrRmSCtg as qRmSCtg, IrRmCd as qRmCd, IrRmCtg as qRmOldCtg," + _
              "IrRmSCtg as qRmOldSCtg, IrRmCd as qRmOldCd,(Case when PValue3= 'N' then IrRmSz else Cast(00.000 as Decimal(6,3)) End) as qIrRmSz," + _
              "0 as qStkRt,Cast(00.000 as Decimal(6,3)) as qLn2, Cast(00.000 as Decimal(6,3)) as qLn3, (IrRmQty / IdQty) as qQty, " + _
              "(Case When PValue3= 'Y' then IrRmSz else Cast(00.0000 as Decimal(6,4)) end)  as qRmPtr, " + _
              " case when IdQty <>0 then (IrRmAWt/IdQty) else 0 end as qWt, 0 as qXtraWt, case when IdQty<>0 then (IrRmQty / IdQty) else 0 end as qPrdQty," + _
              "(IrRmAWt/IdQty" + ") as qPrdWt, IrSetSCd as qSetSCd, case when IdQty <>0 then IrRmQty / IdQty else 0 end  as qWsQty, 0 as qHsQty, '' as qSubShp, ''  as qAlyCd, " + _
              "IrMainMet as qMainMet, Case When IrRmCtg='G' Then InLmgSal When IrRmCtg='P' Then InLmpSal " + _
              "When IrRmCtg='S' Then InLmsSal When IrRmCtg='L' Then InLmlSal Else 0 End as OrLmeSal," + _
              "(Case When IrRmCtg='D' Or IrRmCtg='C' Or IrRmCtg='X' then " + _
              "(Case when RmQw='Q' then Isnull(LotBaseRtByQ,0) " + IIF(ADC("OmMulDiv") = "D", "/", "*") + CStr(ADC("OmCnvFct")) + _
              " else Isnull(LotBaseRtByW,0)" + IIF(ADC("OmMulDiv") = "D", "/", "*") + CStr(ADC("OmCnvFct")) + "  end) else IrRmIRt end) as OrSalRt ," + _
              "0 as OrCstRt, 0 as OrSalVal ,0 as OrCstVal," + _
              "0 as OrSetSalRt,0 As OrSetCstRt,0 As OrSetSalVal, 0 As OrSetCstVal,IrAlySalRt as OrAlySalRt," + _
              "IrAlySalRt as  OrAlyCstRt, IrRmSz as qLn1 " + _
              IIF(ws_TmpOrdRmTbl = "", IIF(ws_TmpOrdRm1 <> "", " into " + ws_TmpOrdRm1, ""), " into " + ws_TmpOrdRmTbl) + " " + _
              " From InvRm Join InvHd On InPrtKey=IrPrtKey and InCoCd=IrCoCd And InTc=IrTc And InYy=IrYy And " + _
              " InChr=IrChr And InNo=IrNo Join RmMst On RmCd=IrRmCd And RmPrtKey=IrPrtKey  " + _
              " Join InvDsg on IdCoCd = IrCoCd and IdTc = IrTc and InYy = IdYy and IdChr = IrChr and IdNo = IrNo and IdSr = IrSr " + _
              "Join Param P1 on P1.PTyp= 'RMSCTG' and P1.PMCd= RmCtg and P1.PSCd= RmSCtg " + _
              "Left Outer Join LotMst on LotNo=IrLotNo " + _
              " where IrCoCd= '" + wCoCd + "' and IrTc='" + pv_rsSrcOd!IdTc + _
              "' and IrYy='" + pv_rsSrcOd!IdYy + "' and IrChr='" + pv_rsSrcOd!IdChr + "' and IrNo=" + CStr(pv_rsSrcOd!IdNo) + " and " + _
              " IrSr=" + CStr(pv_rsSrcOd!IdSr) + " Order By IrSrNo "
  
End Function

Private Sub CpyRtnCtgDiff(ByVal pv_rsSrcOd As MDORowSet, ByVal wCoCd As String, ByVal wi_OdRow As Integer, ByVal wOrSalVal As Double)
'IG.97 -If Rtn category is RMK then calculates the difference between OdSalPrc & InvSalPrc.
'Applied the difference to Sale Rate of DC only
Dim wOdCalcPrc As Double
Dim wIdSalPrc As Double
Dim wDiff As Double
Dim w_CnvRt As Double
If wOrSalVal = 0 Then Exit Sub

With GrdOrdRm
  wOdCalcPrc = Round(GrdOrdDsg.Value(wi_OdRow, "OdCalcPrc"), 2)
  'w_CnvRt = CnvRt(moCn.GetFldVal("Select HBaseCurCd from Head where HCd= '" + ctSelfCmCd + "' and HCoCd= '" + ms_OmCoCd + "'"), ADC("OmCmCurCd"), ADC("OmDt"))

  wIdSalPrc = Round(moCn.GetFldVal("Select IdiFOB/ IdQty from InvDsg where IdCoCd= '" + wCoCd + _
              "' and IdTc='" + pv_rsSrcOd!IdTc + "' and IdYy= '" + pv_rsSrcOd!IdYy + "' and IdChr= '" + pv_rsSrcOd!IdChr + _
              "' and IdNo= " + CStr(pv_rsSrcOd!IdNo) + " and IdSr= " + CStr(pv_rsSrcOd!IdSr)), 2)
  
  wDiff = 1 + Round(MWLib.Div((wIdSalPrc - wOdCalcPrc), wOrSalVal), 5)
  If wDiff > 0 Then
    Dim wRows, wRow As Integer
    wRows = .Rows
    For wRow = 1 To (wRows - 1)
      If .Value(wRow, "OrRmCtg") = "D" Or .Value(wRow, "OrRmCtg") = "C" Then
        .Value(wRow, "OrSalRt") = .Value(wRow, "OrSalRt") * wDiff
        .SaveRec (wRow)
      End If
    Next
  End If
End With
End Sub

Private Function CoCdVal(ByVal wrsSrcOd_OdTc As String, ByVal wOrdCpy As Boolean) As String
    If moCn.GetFldVal("Select PValue from Param where PTyp= 'TC' and PMCd= '" + wrsSrcOd_OdTc + "'") = "PL" Then
      CoCdVal = ctSelfCoCd
    ElseIf wOrdCpy = True Then
      CoCdVal = ADC("WOCoCd")
    ElseIf FraStkCpy.Visible Then
      CoCdVal = ms_StkCpyCoCd
    Else
      CoCdVal = ms_OmCoCd
    End If

