            ADC("wOdMinDiaTolWt") = Fix((wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)) * 100) / 100
            ADC("wOdMaxDiaTolWt") = Round((wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)) + 0.004, 2)
           Else
             ADC("wOdMinDiaTolWt") = wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)
           ADC("wOdMaxDiaTolWt") = wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)
          End If
        End If
        Set wRs_TolWt = Nothing
      End If
    End If
  ' ******** Manali 3.5.0 - 07/05/09 - Diamond Tolerance at Order Level
  
  ' ***** Manali 3.7.1
  Case Is = UCase("wDsCpyRt")
  If ADC.Mode = xNorm Then
    'moCn.GetFldVal ("Select * fro bag")
'    If UCase(SourceName) = UCase("wDsCpyFrYn") Then
'      If adc("wDsCpyFrYn") = "Y" Then
'          FraDsSrcCpy.Enabled = True: FraDsSrcCpy.Visible = True
'          FraDsCpyOpt.Enabled = True: FraDsCpyOpt.Visible = True
'          FraDsStkCpy.Enabled = False: FraDsStkCpy.Visible = False
'      Else
'          FraDsSrcCpy.Enabled = True: FraDsSrcCpy.Visible = True
'          'FraDsSrcCpy.Enabled = False: FraDsSrcCpy.Visible = False
'          FraDsCpyOpt.Enabled = False: FraDsCpyOpt.Visible = False
'          FraDsStkCpy.Enabled = True: FraDsStkCpy.Visible = True
'      End If
'    End If
     
     ' SRI
    If ADC("wDsCpyFrYn") = "Y" And ADC("wDsCpyTc") <> "JPO" Then
        ADC("wDsCpyRt") = "Y": ADC("wDsCpyLabRt") = "Y": ADC("wDsCpyDmId") = "Y"
    Else
        ADC("wDsCpyRt") = "N": ADC("wDsCpyLabRt") = "N":
        'ADC("wDsCpyDmId") = "N"
    End If
    If ADC("wDsCpyTc") = "IN" Then
        ChkStkFilter.Value = 0
        ChkStkFilter.Enabled = False
'        ADC("wdsenforcesubpo") = "N"
        ADC("WDSENFORCECMCD") = "N"
        OptDsCpyFr(0).Value = False
        OptDsCpyFr(1).Value = True
        OptDsCpyFr(0).Enabled = False
        OptDsCpyFr(1).Enabled = False
'        ADC("wDsEnforceSUBPO").Enabled = False
        ADC("WDSENFORCECMCD").Enabled = False
    Else
'        ChkStkFilter.Value = 1
        ChkStkFilter.Enabled = True
        OptDsCpyFr(0).Enabled = True
        OptDsCpyFr(1).Enabled = True
'        ADC("wDsEnforceSUBPO").Enabled = True
        ADC("WDSENFORCECMCD").Enabled = True
    End If
  'adc("wDsCpyRt") = "Y": adc("wDsCpyLabRt") = "Y": adc("wDsCpyDmId") = "Y"
  End If
  Case Is = UCase("wRmCpyRt")
  If ADC.Mode = xNorm Then
    If ADC("wRmCpyFrYn") = "Y" And ADC("wRmCpyTc") <> "LPO" Then
        ADC("wRmCpyRt") = "Y"
    Else
        ADC("wRmCpyRt") = "N"
        
    End If
  End If
      
  Case Is = UCase("wDsCpyRtOpt")
    If ADC.Mode = xNorm Then
'      If adc("wDsCpyFrYn") = "Y" Then
       ADC("wDsCpyRtOpt") = IIF(ADC("wDsCpyRt") = "N", "", moCn.GetFldVal("Select HOrdCpyRtOpt from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'"))
'      End If
    End If
  
'
'  Case Is = UCase("wDsCpyTc")
'    If adc.Mode = xNorm Then
'      'If adc("wDsCpyFrYn") = "Y" Then
'        If mBaseTc <> "" Then adc("wDsCpyTc") = mBaseTc
'         If mRefTc <> "" Then adc("wDsCpyTc") = mRefTc
'      'Else
'      '  adc("wDsCpyTc") = ""
'      'End If
'    End If
'
  Case Is = UCase("wDsDtFr")
    If ADC.Mode = xNorm Then
      'mw.117- getting voucher date
      Dim wDate As String
      If ADC("wDsCpyTc") = "IN" Then
        wDate = moCn.GetFldVal("Select InDt from InvHd where InCoCd='" + ADC("wDsCpyCoCd") + "' and " + _
                               "InTc='" + ADC("wDsCpyTc") + "' and InYy='" + ADC("wDsOmYy") + "' and " + _
                               "InChr='" + ADC("wDsOmChr") + "' and InNo=" + CStr(ADC("wDsOmNo")))
      Else
        wDate = moCn.GetFldVal("Select OmDt from OrdMst where OmCoCd='" + ADC("wDsCpyCoCd") + "' and " + _
                               "OmTc='" + ADC("wDsCpyTc") + "' and OmYy='" + ADC("wDsOmYy") + "' and " + _
                               "OmChr='" + ADC("wDsOmChr") + "' and OmNo=" + CStr(ADC("wDsOmNo")))
      End If
      If wDate <> "" Then
        ADC("wDsDtFr") = wDate
        ADC("wDsDtTo") = wDate
      End If
    End If
  ' ***** Manali 3.7.1
  Case Is = UCase("wRmDtFr")
    If ADC.Mode = xNorm Then
      If ADC("wRmDtFr") = "" Then ADC("wRmDtFr") = "01/01/80"
      If ADC("wRmDtTo") = "" Then ADC("wRmDtTo") = "01/01/80"
    End If
  
 ' ***** Manali 3.10.0 - 01/06/12  - Refresh multiply by factor
 Case Is = UCase("wOmRefMulBy")
    If ADC.Mode = xNorm Then
      If ADC("wOmRefMulByYn") = "Y" Then
        ADC("wOmRefMulBy") = moCn.GetFldVal("Select CmMulBy From CustMst Where CmCtg='" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
      Else
        ADC("wOmRefMulBy") = 0
      End If
    End If
    
 Case Is = UCase("wGsOdSfxDesc")
        If ADC.Mode = xNorm Then
          If ms_OmTc = "PL" Then _
           ADC("wGsOdSfxDesc") = moCn.GetFldVal("Select Top 1 OdSfxDesc From OrdDsg where OdCoCd='" + ms_OmCoCd + "' and OdTc='" + ADC("OmTc") + "' and OdYy='" + ADC("OMYY") + "'" + _
                                                    " and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")) + " and OdSfx='" + ADC("wGsOdSfx") + "' Order By OdSr Desc ")
        End If
        
 Case Is = UCase("wOdMrp")                '4.1.4
      If ADC.Mode = xNorm And GrdOrdDsg.Mode = fgmnorm And GrdOrdDsg.Row > 0 Then
        ADC("wOdMrp") = FnRndOff(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdCalcPrc") * ADC("wOdMrpMulBy"), 2, _
                                  moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' and CmCd= '" + ADC("OmCmCd") + "'"))
      End If
  Case Is = UCase("wRmCmCtg")
    If ADC.Mode = xNorm Then
        Dim wOldCmCtg As String
        wOldCmCtg = ADC("wRmCmCtg")
        ADC("wRmCmCtg") = moCn.GetFldVal("Select TmCmCtg From TcMst where TmCoCd='" + ADC("wRmCpyCOCD") + "' and TmTc='" + ADC("wRmCpyTC") + "'")
 '       If adc("wDsCpyTC") = "IN" Then adc("wDsCmCtg") = "C"
        
        If wOldCmCtg <> ADC("wRmCmCtg") Then
            If ADC("wRmCmCtg") = ADC("OmCmCtg") Then ADC("wRmCmCd") = ADC("OmCmCd") Else ADC("wRmCmCd") = ""
        End If
    End If
  '******bhavna added chain logic tag
  Case Is = UCase("wChnCustYn")
    If ADC.Mode = xNorm Then
    If moCn.RecSeek("select RrTcTyp from RmRt where RrTcTyp= 'CHN' and " + _
                         "RrCmCtg = '" + ADC("OmCmCtg") + "' and " + _
                         "RrCmCd = '" + ADC("OmCmCd") + "' ") Then
        ADC("wChnCustYn") = "Y"
    Else
        ADC("wChnCustYn") = "N"
    End If
    End If
  '*********Bhavna added Lkup default value from custMst
  'Uni.22- On change of Customer code lookup fields will chnage eventhough those are non blank
  Case Is = UCase("OmLkUpRmRt")
        If ADC.Mode = xNorm Then
        
           ADC("OmLkUpRmRt") = moCn.GetFldVal("Select CmLkUpRmRt from CustMst " + _
                            "where CmCtg= '" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
        End If
  Case Is = UCase("OmLkUpLabRt")
        If ADC.Mode = xNorm Then
        
           ADC("OmLkUpLabRt") = moCn.GetFldVal("Select CmLkUpLabRt from CustMst " + _
                            "where CmCtg= '" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
        End If
  Case Is = UCase("OmLkUpMetLs")
        If ADC.Mode = xNorm Then
        
           ADC("OmLkUpMetLs") = moCn.GetFldVal("Select CmLkUpMetLs from CustMst " + _
                            "where CmCtg= '" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
        End If
  'EmrSv
  Case Is = UCase("OmCell")
      If ADC.Mode = xNorm Then
      wCmCell = moCn.GetFldVal("Select CmCell from CustMst " + _
                            "where CmCtg= '" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "'")
      If wCmCell <> "" And ADC("OmCell") = "" Then ADC("OmCell") = wCmCell
      If wCmCell = "" And ADC("OmCell") = "" Then ADC("OmCell") = moCn.GetFldVal("Select hCell from Head where HCoCd = '" + ms_OmCoCd + "'")
      End If
  'CostRtPDCM-when Cost Rate Editable Module is No then Copy Cost Rt option Is No else
  'if source Tc is PL then Copy Cost rate value will be Yes else No
  Case Is = UCase("WCOSTFRPDCMYN")
    ADC("WCOSTFRPDCMYN") = IIF(mf_CstRtEdt = False, "N", IIF(UCase(ADC("wOmTc")) = "PL", "Y", "N"))
  
  'mw.117- When The Tc is changed, Src CmCtg will change
  Case Is = UCase("wDsCmCtg")
    If ADC.Mode = xNorm Then
      If ADC("wDsCpyTc") = "IN" Then
        ADC("wDsCmCtg") = "C"
      ElseIf ADC("wDsCpyTc") = "PL" Then
        ADC("wDsCmCtg") = "C"
      ElseIf ADC("wDsCpyTc") = "SPL" Then
        ADC("wDsCmCtg") = "S"
      ElseIf ADC("wDsCpyTc") = "SO" Or ADC("wDsCpyTc") = "QT" Then
        ADC("wDsCmCtg") = "C"
      Else
      
      ADC("wDsCmCtg") = moCn.GetFldVal("Select TmCmCtg From TcMst " + _
                              "where TmCoCd='" + ADC("wDsCpyCoCd") + "' and TmTc='" + ADC("wDsCpyTc") + "'")
      End If
    End If
  'mw.117- When the Src CmCtg changes the Src Customer changed to Blank
  Case Is = UCase("wDsCmCd")
    If ADC.Mode = xNorm Then
      If ADC("wDsCpyTc") = "IN" Then
        ADC("wDsCmCd") = moCn.GetFldVal("Select InCmCd from InvHd where InCoCd='" + ADC("wDsCpyCoCd") + "' and " + _
                               "InTc='" + ADC("wDsCpyTc") + "' and InYy='" + ADC("wDsOmYy") + "' and " + _
                               "InChr='" + ADC("wDsOmChr") + "' and InNo=" + CStr(ADC("wDsOmNo")))
      Else
        ADC("wDsCmCd") = moCn.GetFldVal("Select OmCmCd from OrdMst where OmCoCd='" + ADC("wDsCpyCoCd") + "' and " + _
                               "OmTc='" + ADC("wDsCpyTc") + "' and OmYy='" + ADC("wDsOmYy") + "' and " + _
                               "OmChr='" + ADC("wDsOmChr") + "' and OmNo=" + CStr(ADC("wDsOmNo")))
      End If
    
    
    End If
  'mw.117- when Tc is changed, default CHR will change
  Case Is = UCase("wDsOmChr")
    If ADC.Mode = xNorm Then
      ADC("wDsOmChr") = moCn.GetFldVal("Select vPValue from vParam where vPCoCd= '" + ADC("wDsCpyCoCd") + _
                                "' and vPTyp='DEFCHR' and vPMCd='" + ADC("wDsCpyTc") + "'")
    End If
  Case Is = UCase("WDSCPYBASEVCH")
      If ADC.Mode = xNorm Then
        If ADC("WDSCPYAUTOMAP") = "Y" Then
          ADC("WDSCPYBASEVCH") = ADC("WDSCPYAUTOMAP")
        End If
      End If
  Case Is = UCase("WOMREFLABMCD")
      If ADC("WOMREFLABRT") = "N" Then
        ADC("WOMREFLABMCD") = ""
      End If
  '5716 tag
  Case Is = UCase("WTGTAG")
    Dim wTgFactor As Double
    If ADC.Mode = xNorm Then
      wTgFactor = moCn.GetFldVal("Select HTag from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")
      ADC("wtgtag") = ADC("WTGCOST") * wTgFactor
    End If
  Case Is = UCase("WTGMRP")
    If ADC.Mode = xNorm Then
      Dim wTag As Double, wMRPDn As Double
      If ADC("WTGMRPDNPER") <> 0 Then
      wMRPDn = ADC("WTGTAG") * (1 - (ADC("WTGMRPDNPER") / 100))
      ADC("WTGMRP") = wMRPDn
      End If
    End If
  
  Case Is = UCase("WTGPROFIT")
    If ADC.Mode = xNorm Then
      ADC("WTGPROFIT") = ADC("WTGMRP") - ADC("WTGCOST")
    End If
  Case Is = UCase("WTGPROFITPER")
    If ADC.Mode = xNorm Then
      If ADC("WTGMRP") <> 0 Then
        ADC("WTGPROFITPER") = (ADC("WTGPROFIT") / ADC("WTGMRP")) * 100 '5716 WTGCOST replaced with ADC("WTGMRP")
      Else
        ADC("WTGPROFITPER") = 0
      End If
    End If

End Select
 
End Sub
  Private Sub ATXT_FldChange(Index As Integer, ByVal IdName As String, Cancel As Boolean, ErrMsg As String, ByVal pv_NewValue As Variant)
  '*** OmTc             valid PMCd('TC' and PValue= TcTyp obtained from the MenuCode)
