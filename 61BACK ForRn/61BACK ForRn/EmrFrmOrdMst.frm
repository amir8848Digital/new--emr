              "OlNo=" + CStr(pv_rsSrcOd!OdNo) + " and OlSr=" + CStr(pv_rsSrcOd!OdSr) + " and OlPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OlPrtKey") + _
              " Order By OlSrNo")
      End If
      
      TrackStatus ("Got Source of OrdLab of Row:" + CStr(ijk) + ":" + CStr(Now))
      
      'IG.97 -If Rtn category is R&R/RMK then No Lab records
      Dim wCpyLab As Boolean
      wCpyLab = True
      If pv_CpyFrRet Then
       If (pv_rsSrcOd!ReRtnCtg = "R&R" Or pv_rsSrcOd!ReRtnCtg = "RMK") Then
          wCpyLab = False
        End If
      End If
      If ADC("OmTc") = "JRI" Then
