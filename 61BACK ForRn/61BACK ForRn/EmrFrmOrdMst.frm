        '49 Checking for valid Karat
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 25)) <> "" And Not moCn.RecSeek("Select 'x' From Param Where PTyp='KT' And PMCd='" + ReadCell(ADC("WXLSHTNO"), i, 25) + "' ") Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Karat."
        '49 Checking for valid Gram min & max wt

     If ReadCell(ADC("WXLSHTNO"), i, 26) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 26, "0")
        If ReadCell(ADC("WXLSHTNO"), i, 27) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 27, "0")
        If Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 26)) Or Val(ReadCell(ADC("WXLSHTNO"), i, 26)) < 0 Or Val(ReadCell(ADC("WXLSHTNO"), i, 26)) > 9999.999 Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Gram Min Wt, Should be Between 0 and 9999.999"
        If Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 27)) Or Val(ReadCell(ADC("WXLSHTNO"), i, 27)) < 0 Or Val(ReadCell(ADC("WXLSHTNO"), i, 27)) > 9999.999 Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Gram Max Wt, Should be Between 0 and 9999.999"
        '49 Checking for valid Diamond min & max tolerance
        If ReadCell(ADC("WXLSHTNO"), i, 28) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 28, "0")
        If ReadCell(ADC("WXLSHTNO"), i, 29) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 29, "0")
        If Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 28)) Or Val(ReadCell(ADC("WXLSHTNO"), i, 28)) < 0 Or Val(ReadCell(ADC("WXLSHTNO"), i, 28)) > 9999.999 Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Min Diamond Tolerance, Should be Between 0 and 9999.999"



        If Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 29)) Or Val(ReadCell(ADC("WXLSHTNO"), i, 29)) < 0 Or Val(ReadCell(ADC("WXLSHTNO"), i, 29)) > 9999.999 Then _
           wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Invalid Max Diamond Tolerance, Should be Between 0 and 9999.999"
          
        'Write Error Message to Excel
       Call SetCellVal(ADC("WXLSHTNO"), i, 30, wErrMsg)
