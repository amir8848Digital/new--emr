    End If

    If ADC("wDsCpyTc") <> "IN" And (ChkStkFilter.Value <> vbChecked Or ChkVchrFliter.Value <> vbChecked) And (ADC("WDSENFORCECMCD") = "Y" Or ADC("WDSENFORCESUBPO") = "Y") Then
