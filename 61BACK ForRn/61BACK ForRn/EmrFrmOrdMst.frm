Private Function ChkIsJEmrMasterRecord(ByVal RowNum As Integer, ByRef Cancel As Boolean, ByRef ErrMsg As String) As Boolean
  Cancel = False
  ErrMsg = ""
  ChkIsJEmrMasterRecord = False
  If (ms_OmTcTyp <> "JT") Or (ms_PwdFlag = True) Or (RowNum <= 0) Or (RowNum > GrdOrdDsg.Rows - 1) Then
    Exit Function
  End If
  If (Not GrdOrdDsg.IsNew(RowNum)) Then
    Dim wCurrentRowOdIdNo As Long
    If GrdOrdDsg.Value(RowNum, "OdDmStkNo") <> 0 Then
      wCurrentRowOdIdNo = moCn.GetFldVal("Select OdIdNo From OrdDsg join TcMst on OdTc=TmTc and TmCoCd='" + ms_OmCoCd + "'" + _
                                              " where OdCoCd='" + ms_OmCoCd + "' And OdTc='" + ADC("OmTc") + "' " + _
                                              " And OdYy='" + ADC("OmYy") + "' And OdChr='" + ADC("OmChr") + "' And OdNo='" + CStr(ADC("OmNo")) + "'" + _
                                              " And OdSr=" + CStr(GrdOrdDsg.Value(RowNum, "OdSr")) + " and OdPrtKey='" + GrdOrdDsg.Value(RowNum, "OdPrtKey") + "'")
      If moCn.RecSeek("Select 1 where exists (Select 'a' from OrdDsg join vwDmStkNumMaster MasterRow on MasterRow.ODDmStkCoCd = OrdDsg.OdDmStkCocd and MasterRow.ODDmStkYy = OrdDsg.OdDmStkYy and " + _
                  " MasterRow.ODDmStkChr = OrdDsg.OdDmStkChr and MasterRow.ODDmStkNo = OrdDsg.OdDmStkNo and MasterRow.ODDmCd = OrdDsg.OdDmCd and MasterRow.ODDmSz = OrdDsg.OdDmSz and " + _
                  " MasterRow.OdSfx = OrdDsg.OdSfx where MasterRow.OdIdNo = " + CStr(wCurrentRowOdIdNo) + " and OrdDsg.OdIdNo <> " + CStr(wCurrentRowOdIdNo) + " and MasterYN='Y')") Then
        Cancel = True: ErrMsg = "This OrdDsg row is a master record for other Transactions of this DmCd, Sfx, Sz and DmStkNum, cannot edit or delete this record": Exit Function
      End If
    End If
'  Else
'    wCurrentRowOdIdNo = moCn.GetFldVal("Select OdIdNo From OrdDsg join TcMst on OdTc=TmTc and TmCoCd='" + ms_OmCoCd + "'" + _
                                              " where OdCoCd='" + ms_OmCoCd + "' And OdTc='" + ADC("OmTc") + "' " + _
                                              " And OdYy='" + ADC("OmYy") + "' And OdChr='" + ADC("OmChr") + "' And OdNo='" + CStr(ADC("OmNo")) + "'" + _
                                              " And OdSr=" + CStr(GrdOrdDsg.Value(RowNum, "OdSr")) + " and OdPrtKey='" + GrdOrdDsg.Value(RowNum, "OdPrtKey") + "'")
    
 '   If moCn.RecSeek("Select 1 where exists (Select 'a' from OrdDsg join vwDmStkNumMaster MasterRow on MasterRow.ODDmStkCoCd = OrdDsg.OdDmStkCocd and MasterRow.ODDmStkYy = OrdDsg.OdDmStkYy and " + _
                  " MasterRow.ODDmStkChr = OrdDsg.OdDmStkChr and MasterRow.ODDmStkNo = OrdDsg.OdDmStkNo and MasterRow.ODDmCd = OrdDsg.OdDmCd and MasterRow.ODDmSz = OrdDsg.OdDmSz and " + _
                  " MasterRow.OdSfx = OrdDsg.OdSfx where MasterRow.OdIdNo = " + CStr(wCurrentRowOdIdNo) + " and OrdDsg.OdIdNo <> " + CStr(wCurrentRowOdIdNo) + " and MasterYN='Y' and " + _
                  " (OrdDsg.OdOmDt>'" + ADC("OmDt") + "'") Then
    
        
  End If
End Function
Private Sub GrdOrdDsg_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  
'  '****** Sachin 3.02 05-12-07 - Locking Design Grid In Previous Partition
'  If ADC("OmPrtKey") = ctPrevPrtn Then Cancel = True: ErrMsg = "Cannot Edit Orders In Previous Partition": Exit Sub
  
  '*** Set Helps For Each Field
  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdDsg.Value(RowNum, "OdPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub
  ' If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
  
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub
  
'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If

  ' ***** Manali Trading Module
  Dim wf_invhdmust As Boolean
  wf_invhdmust = moCn.RecSeek("Select 'x' from TcMst where TmTc = '" + ADC("omTc") + "' and TmCoCd = '" + ms_OmCoCd + "' and TmInvHdMustYn = 'Y'")
  If (CmdInvHd.Visible = True And Not mInvExists And wf_invhdmust = True) Then
    Cancel = True: ErrMsg = "Invoice Does not exist, cannot edit record": Exit Sub
  End If
  ' ***** Manali Trading Module
  Call ChkIsJEmrMasterRecord(RowNum, Cancel, ErrMsg)
  If Cancel = True Then Exit Sub
  
  If (CmdInvHd.Visible = True And Not mInvExists And wf_invhdmust = True) Then
    Cancel = True: ErrMsg = "Invoice Does not exist, cannot edit record": Exit Sub
  End If
  
  
  With GrdOrdDsg
    Select Case ColName
       Case Is = UCase("OdOrdEnt")
        '****** Sachin 3.02 07-12-07 - Check On Current Partition
        ' ***** Manali Trading Module
        If ms_OmTcTyp = ctJtTcTyp Then
          If ms_OmTc = "sri" Then
            Cancel = True: ErrMsg = "Cannot Edit": Exit Sub
          End If
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And .Value(RowNum, "OdExpQty") > 0
          ErrMsg = "Cannot Edit Value when Quantity is Matched Partially/Completely": Exit Sub
        Else
        ' ***** Manali Trading Module
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn _
                    And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                            " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ms_OmCoCd + "' and " + _
                            "   OdTc= '" + ADC("OmTc") + "' and " + _
                            "   OdYy= '" + ADC("OmYy") + "' and " + _
                            "   OdChr= '" + ADC("OmChr") + "' and " + _
                            "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                            "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
                        Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ms_OmCoCd + "' and " + _
                                "   BOdTc= '" + ADC("OmTc") + "' and " + _
                                "   BOdYy= '" + ADC("OmYy") + "' and " + _
                                "   BOdChr= '" + ADC("OmChr") + "' and " + _
                                "   BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                                "   BOdSr= " + CStr(.Value(RowNum, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "'"))
          ErrMsg = "Cannot Edit Value when Recs exist in Bag"
          Exit Sub
         End If
      '************Geeta***********Emr207*****15/07/04
     Case Is = UCase("OdSalPrc")
       If ADC("OmLockSalPrcYN") = "Y" Then _
          Cancel = True: ErrMsg = "Cannot Edit Sales Price, When Lock sales Prices is 'Y'": Exit Sub
       If mf_MrpChr Then _
          Cancel = True: ErrMsg = "Cannot Edit Sales Price": Exit Sub
     Case Is = UCase("OdMrp")
       If mf_MrpChr Then _
          Cancel = True: ErrMsg = "Cannot Edit MRP": Exit Sub
     End Select
   
    Select Case ColName
    Case Is = UCase("wOdBag")
      '*** (Jen 2.11)
      Cancel = Not .IsNew(RowNum)
      If Cancel Then ErrMsg = "Cannot Edit Bag Number": Exit Sub
      '*** (Jen 2.11)
      Call HlpList.BagNo(ms_OmCoCd, "N", "PFG", , , , , , , , IIF(ms_OmTc = "sri", "N", ""))
      
    Case Is = UCase("OdDmCd")
      Cancel = Not .IsNew(RowNum)
      If Cancel Then ErrMsg = "Cannot Edit Design Cd": Exit Sub
      Call HlpList.DmCd(ms_DmTcTyp)
      ' Since OdChkTol is Hidden from ver 2.12 - a default value for ChkTol is set below for manually added new rows
      If .IsNew(RowNum) Then .Value(RowNum, "OdChkTol") = "Y"
      
    'SRITP
    Case Is = UCase("OdSfx")
      '*** Jay 3.4(FG)
      If ms_OmTcTyp = "FG" And Not .IsNew(RowNum) Then Cancel = True: ErrMsg = "Cannot Change Design Suffix": Exit Sub
      '*** Jay 3.4(FG)
      '*** JAY 2.14 ***
      ' ***** Manali Trading Module - OmCmCtg added
      Call HlpList.OdSfx(ctSelfCoCd, .Value(RowNum, "OdDmCd"), ADC("OmCmCtg"), ADC("OmCmCd"))
      'Call HlpList.OdSfx(ctSelfCoCd, .Value(RowNum, "OdDmCd"))
      '*** JAY 2.14 ***
      'Call HlpList.OdSfx(ms_OmCoCd, .Value(RowNum, "OdDmCd"))
    Case Is = UCase("OdDmSz")
      Call HlpList.PMCd("DMSZ")
    Case Is = UCase("OdPrtCd")
        Call HlpList.PMCd("PRTCD")
    Case Is = UCase("OdKt")
      Call HlpList.PMCd("KT")
    Case Is = UCase("OdDmCol")
      '****** Sachin 3.02 07-12-07 - Check On Current Partition
      Cancel = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") = ctCurrPrtn _
                  And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                          " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ms_OmCoCd + "' and " + _
                          "   OdTc= '" + ADC("OmTc") + "' and " + _
                          "   OdYy= '" + ADC("OmYy") + "' and " + _
                          "   OdChr= '" + ADC("OmChr") + "' and " + _
                          "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
                  Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ms_OmCoCd + "' and " + _
                          "     BOdTc= '" + ADC("OmTc") + "' and " + _
                          "     BOdYy= '" + ADC("OmYy") + "' and " + _
                          "     BOdChr= '" + ADC("OmChr") + "' and " + _
                          "     BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "     BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "' "))
      ' URMI PrdSeq HELP 2.04
      If Cancel = True Then ErrMsg = "Cannot Edit Value when Recs exist in Bag": Exit Sub
      Call HlpList.PMCd("DMCOL")
    Case Is = UCase("OdFixPrc")
      Call HlpList.PMCd("YN")
    
    '*** (Jen 3.01)
    Case Is = UCase("OdPrdSeq")
      '****** Sachin 3.02 07-12-07 - Check On Current Partition
      If ms_PwdFlag = False Then  '5717 password needed to change prdseq when bag exist
        Cancel = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") = ctCurrPrtn _
                 And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                            " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ms_OmCoCd + "' and " + _
                            "   OdTc= '" + ADC("OmTc") + "' and " + _
                            "   OdYy= '" + ADC("OmYy") + "' and " + _
                            "   OdChr= '" + ADC("OmChr") + "' and " + _
                            "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                            "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
                Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ms_OmCoCd + "' and " + _
                            " BOdTc= '" + ADC("OmTc") + "' and " + _
                            " BOdYy= '" + ADC("OmYy") + "' and " + _
                            " BOdChr= '" + ADC("OmChr") + "' and " + _
                            " BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                            " BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "' "))
        If Cancel = True Then ErrMsg = "Cannot Edit Value when Recs exist in Bag": Exit Sub
      End If
      'HlpList.MultiSelect = True  'EmrSv
      Call HlpList.vPMCd(ms_OmCoCd, "PRDSEQ")
    '*** (Jen 3.01)
    
    '****** Zubin 3.02.01 - 26/03/08
    Case Is = UCase("wOdPoNo")
      ' ***** Manali 3.03 - (Enabled status checked for IDE module)
      'vk.19 set focus chnaged to sub customer field
      If ADC("wOdPoNo").Enabled = True Then ADC("wOdSubCust").SetFocus
    '****** Zubin 3.02.01 - 26/03/08
    
    '*** Jay 3.4(FG)
    Case Is = UCase("OdDmStkYy")
      If ms_OmTcTyp = "FG" And Not .IsNew(RowNum) Then Cancel = True: ErrMsg = "Cannot Change Design Stk Yy": Exit Sub
      Call HlpList.PMCd("Yy")
         If .IsNew(RowNum) Then
        If (InStr(1, "," + ms_TCToAutoGenerateDmStkNum + ",", "," + ADC("OmTc") + ",") > 0) Then
          If GrdOrdDsg.Value(RowNum, "OdDmStkYy") = "" Then
            If RowNum > 1 Then
              GrdOrdDsg.Value(RowNum, "OdDmStkYy") = GrdOrdDsg.Value(RowNum - 1, "OdDmStkYy")
            Else
              GrdOrdDsg.Value(RowNum, "OdDmStkYy") = ms_OmYy
            End If
          End If
        End If
      End If
    Case Is = UCase("OdDmStkChr")
      Call HlpList.PMCd("BCHR", "'P'")
      If .IsNew(RowNum) Then
        If GrdOrdDsg.Value(RowNum, "OdDmStkChr") = "" Then
          If (InStr(1, "," + ms_TCToAutoGenerateDmStkNum + ",", "," + ADC("OmTc") + ",") > 0) Then
            If RowNum > 1 Then
              GrdOrdDsg.Value(RowNum, "OdDmStkChr") = GrdOrdDsg.Value(RowNum - 1, "OdDmStkChr")
            End If
          End If
        End If
      End If

    Case Is = UCase("OdDmStkCoCd")
      Call HlpList.hCoCd
        If .IsNew(RowNum) Then
        If (InStr(1, "," + ms_TCToAutoGenerateDmStkNum + ",", "," + ADC("OmTc") + ",") > 0) Then
          If GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") = "" Then
            If RowNum > 1 Then GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") = GrdOrdDsg.Value(RowNum - 1, "OdDmStkCoCd")
          End If
        End If
        End If
 
    Case Is = UCase("OdDmStkNo")
      ' **** added Repair in & out TC 'Stkcocd
      Call HlpList.OdDmStkNo(ms_OmCoCd, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx"), _
                          GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkCoCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr"), ADC("OmTc"))
            
    ' ***** Manali Trading Module
    Case Is = UCase("wOdBaseVchSr")
      Dim wb_TmJLooseTC  As String
      'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      wb_TmJLooseTC = moCn.GetFldVal("Select TmJLooseTC   from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'")
      If ADC("OmTc") = "PL" Or ADC("OmTc") = "QB" Or ADC("OmTc") = "QT" Or ADC("OmTc") = "SO" Then wb_TmJLooseTC = "N"
      If wb_TmJLooseTC = "N" Then
        Call HlpList.BaseRefVch(ms_OmCoCd, "B", ms_OmTc, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdSfx"), .Value(RowNum, "OdDmSz"), .Value(RowNum, "OdDmStkYy"), .Value(RowNum, "OdDmStkChr"), .Value(RowNum, "OdDmStkNo"), ADC("OmCmCtg"), ADC("OmCmCd"), ADC("OmBaseCoCd"))
      Else
        Call HlpList.BaseRefVchJL(ms_OmCoCd, "B", ms_OmTc, .Value(RowNum, "OdJLRmCd"), .Value(RowNum, "OdJLLotNo"), .Value(RowNum, "OdJLLn1"), .Value(RowNum, "OdJLLn2"), .Value(RowNum, "OdJLLn3"), ADC("OmCmCtg"), ADC("OmCmCd"), ADC("omBaseCoCd"))
      End If
    Case Is = UCase("wOdRefVchSr")
    'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
      wb_TmJLooseTC = moCn.GetFldVal("Select TmJLooseTC   from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'")
      If ADC("OmTc") = "PL" Or ADC("OmTc") = "QB" Or ADC("OmTc") = "QT" Or ADC("OmTc") = "SO" Then wb_TmJLooseTC = "N"
      If (wb_TmJLooseTC = "N") Then
        Call HlpList.BaseRefVch(ms_OmCoCd, "R", ms_OmTc, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdSfx"), .Value(RowNum, "OdDmSz"), .Value(RowNum, "OdDmStkYy"), .Value(RowNum, "OdDmStkChr"), .Value(RowNum, "OdDmStkNo"))
      Else
        Call HlpList.BaseRefVchJL(ms_OmCoCd, "R", ms_OmTc, .Value(RowNum, "OdJLRmCd"), .Value(RowNum, "OdJLLotNo"), .Value(RowNum, "OdJLLn1"), .Value(RowNum, "OdJLLn2"), .Value(RowNum, "OdJLLn3"))
      End If
    ' ***** Manali Trading Module
      Case Is = UCase("OdJLRmCd")
    Call HlpList.RmCd("N")
  Case Is = UCase("OdJLLn1")
      Dim wRmCtg As String
      wRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd = '" + GrdOrdDsg.Value(RowNum, "OdJLRmCd") + "'")
      If wRmCtg <> "D" And wRmCtg <> "C" And wRmCtg <> "X" Then
        Cancel = True
      End If
  Case Is = UCase("OdJLLn2")
      Dim wRmSCtg As String
      wRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd = '" + GrdOrdDsg.Value(RowNum, "OdJLRmCd") + "'")
      wRmSCtg = moCn.GetFldVal("Select RmSCtg from RmMst where RmCd = '" + GrdOrdDsg.Value(RowNum, "OdJLRmCd") + "'")
      If wRmCtg = "D" Or wRmCtg = "C" Then
        Cancel = ColWhenStkSz(2, wRmCtg, wRmSCtg, ErrMsg)
      Else
        Cancel = True
      End If
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master]******
  Case Is = UCase("OdJLLn3")
      wRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd = '" + GrdOrdDsg.Value(RowNum, "OdJLRmCd") + "'")
      wRmSCtg = moCn.GetFldVal("Select RmSCtg from RmMst where RmCd = '" + GrdOrdDsg.Value(RowNum, "OdJLRmCd") + "'")
      If wRmCtg = "D" Or wRmCtg = "C" Then
        Cancel = ColWhenStkSz(3, wRmCtg, wRmSCtg, ErrMsg)
      Else
        Cancel = True
      End If
  Case Is = UCase("OdJLRateByQW")
    Call HlpList.PMCd("LABQW")
    GrdOrdDsg.Value(RowNum, "ODJLRATEBYQW") = "W"
  Case Is = UCase("OdJLVchVal")
    Cancel = True
  Case Is = UCase("OdJLLotNo")
      If .Value(RowNum, "ODJLRmCd") = "" Or moCn.RecSeek("select 'x' from RmMst where RmZ= 'N' and RmCd= '" + .Value(RowNum, "ODJLRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "' and RmCtg IN " + ctLotNoRmCtg) Then
        Call HlpList.LotNoJL(ms_OmCoCd, ADC("OmFrDmLoc"), .Value(RowNum, "ODJLRmCd"), .Value(RowNum, "ODJLLn1"), .Value(RowNum, "ODJLLn2"), .Value(RowNum, "OdJLLn3"))
      Else
        Cancel = True: ErrMsg = "Lot No. Allowed For ONLY some RmCtg": Exit Sub
      End If
  Case Is = UCase("OdJLVchRt")
      Dim wRmLoc As String
      wRmLoc = IIF(ADC("OmFrDmDc") = "C", _
                             ADC("OmFrDmLoc"), _
                             ADC("OmToDmLoc"))
      If moCn.GetFldVal("Select hAvgSRtYn from Head where HCoCd= '" + ms_OmCoCd + "' and " + _
                      "HCd='" + ctSelfCmCd + "'") = "Y" And GrdOrdDsg.Value(RowNum, "ODJLVCHRT") = 0 _
                      And UCase(ADC("OmTc")) <> "LPR" Then
        GrdOrdDsg.Value(RowNum, "ODJLVCHRT") = GetAvgStkRtJL(ms_OmCoCd, ADC("OmFrDmLoc"), .Value(RowNum, "ODJLRmCd"), .Value(RowNum, "ODJLLotNo"), .Value(RowNum, "ODJLLn1"), .Value(RowNum, "ODJLLn2"), .Value(RowNum, "OdJLLn3"))
      End If
  Case Is = UCase("OdRepGrWt")
      If ADC("OmTc") <> "JRI" Then
        Cancel = True
        ErrMsg = "Repair In Gross Wt is not editable except for JRI"
      End If
  End Select
  End With
End Sub

Private Sub GrdOrdRm_RowValid(ByVal RowNum As Integer, Cancel As Boolean, ErrMsg As String)
  If GrdOrdRm.Mode = fgmnorm Then
    If GrdOrdDsg.Row > 0 And GrdOrdDsg.Row <= GrdOrdDsg.Rows - 1 Then
      If mb_SaveGrdOrdDsg = True Then
        GrdOrdDsg.SaveRec GrdOrdDsg.Row
      End If
    End If
  End If
End Sub

Private Sub GrdRmStk_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  Select Case UCase(ColName)
    Case Is = UCase("wRmCpyYn")
      ' Bef 3.7.1
      'Call HlpList.PMCd("YN")
      ' **** Manali 3.7.1 - Y/N on Click
      GrdRmStk.Value(RowNum, "wRmCpyYn") = IIF(Trim(GrdRmStk.Value(RowNum, "wRmCpyYn")) <> "Y", "Y", "N")
  End Select
End Sub

Private Sub GrdOrdDsg_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  '****** Grd1.AddSave "Grd2", asCurrent
  '****** The above line indicates that whenever the row of Grid1 which triggered the recal is
         'saved then save the recalculeted row of Grid2 also.
         '(The second parameter 'asCurrent' indicates that only the current rec of Grid2 should be saved)
         'For example if OrRmWt of GrdOrdRm changes, then recalc should happen only for
         '   the corresponding parent record in GrdOrdDsg
         '
         'ADC.AddSave "GrdOrdDsg", asAll
         'If the value of second parameter is 'asAll' then save all the records
         'For example if OmLmgSal of ADC changes and the recalc of OdLmgSal is dependent
         '   on OmLmgSal then recalc should happen for all the records in GrdOrdDsg
         '   and all the recs of GrdOrdDsg should be saved when ADC rec is saved
      
  '*** OdOrdQty on OdOrdEnt,OaOrdQty                          Normal,Copy of GrdOrdDsg and Normal,delete of GrdOrdAmd
      ' OdOrdQty= OdOrdEnt+ sum(OaOrdQty for the OdSr)
  '*** OdPrdQty on OdPrdEnt,OaPrdQty                          Normal,Copy of GrdOrdDsg and Normal,delete of GrdOrdAmd
      ' OdPrdQty= OdPrdEnt+ sum(OaPrdQty for the OdSr)
  '***/r OdCalcPrc on OrSalVal,OrSetSalVal,OlSalVal           Normal,Copy of GrdOrdDsg and (Normal,delete,CopyOver of GrdOrdRm or Normal,delete,CopyOver of GrdOrdLab)
      ' OdCalcPrc= sum(OrSalVal for the OdSr)+ sum(OrSetSalVal for the OdSr)+ sum(OlSalVal for the OdSr)
  '***/r OdSalPrc on OdCalcPrc* OdMulBy                       Normal,Copy
      'OdSalPrc= OdCalcPrc* OdMulBy
  '***/r OdCstPrc on OrCstVal,OrSetCstVal,OlCstVal,OdMulBy    Normal,Copy of GrdOrdDsg and (Normal,delete,CopyOver of GrdOrdRm or Normal,delete,CopyOver of GrdOrdLa`)
      ' OdCstPrc= sum(OrCstVal+ OrSetCstVal+ OlCstVal for the OdSr)* OdMulBy
  '*** OdPrdEnt on OdOrdEnt                                   Normal
      ' OdPrdEnt= OdOrdEnt
  '***/r OdGldAsWt on OdGldAs,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' If OrRmCtg= 'D' or 'C' then wt= OrWt/5 else wt= OrWt
      ' OdGldAsWt= sum(wt if the OrRmCtg exists in the OdGldAs Option selected)
  '***/r OdLabAsWt on OdLabAs,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' If OrRmCtg= 'D' or 'C' then wt= OrWt/5 else wt= OrWt
      ' OdLabAsWt= sum(wt if the OrRmCtg exists in the OdLabAs Option selected)
  '*** OdKt on OrRmCd, OrMainMet                              Normal of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' OdKt= RmKt from RmMst(RmCd= OrRmCd) where OrMainMet= 'Y'
  '*** OdDelDt on OmDelDt                                     Normal of ADC and Normal of GrdOrdDsg
      ' OdDelDt= OmDelDt
  '*** OdExpDelDt on OmExpDelDt                               Normal of ADC and Normal of GrdOrdDsg
      ' OdExpDelDt= OmExpDelDt
  '*** OdOmCtCd on OmhCtCd                                    Normal of ADC and Normal of GrdOrdDsg
      ' OdOmCtCd= OmhCtCd
      
  Dim i As Integer, wl_SourceGrdMode As en_fgMode, wModAvl As Integer
  
  ' ***** Manali Trading Module
  Dim wOdBaseRefVchSr As String, wOdKeyArr() As String
  Dim wOdTc As String, wOdYy As String, wOdChr As String, wOdNo As Long, wOdSr As Integer
  ' ***** Manali Trading Module
  

  With GrdOrdDsg
    Select Case ColName
    Case Is = UCase("wOdBag")
      '*** (Jen 2.11)
      If .Mode = fgminit Then
        .Value(RowNum, "wOdBag") = .Value(RowNum, "OdBYy") + "/" + .Value(RowNum, "OdBChr") + "/" + Trim(CStr(.Value(RowNum, "OdBNo")))
      End If
      '*** (Jen 2.11)
      
      Case Is = UCase("OdCmPrdInst")
       If (.Mode = fgmnorm Or .Mode = fgmCopy) And ADC.Mode = xNorm Then
        If .Value(RowNum, "OdCmPrdInst") = "" And .Value(RowNum, "OdDmCd") <> "" Then
            
         .Value(RowNum, "OdCmPrdInst") = moCn.GetFldVal("Select IsNull" + _
            "((Select CiCustPrdInst from CustInst where " + _
            "CiCtg = '" + ADC("OmCmCtg") + "' and CiCd = '" + ADC("OmCmCd") + "' and " + _
            "CiDmCtg = (select max(DmCtg) from DsgMst where DmCd = '" + .Value(RowNum, "OdDmCd") + "')) , " + _
            "(Select CmPrdInst from CustMst where CmCtg='" + ADC("OmCmCtg") + "' and CmCd='" + ADC("OmCmCd") + "') )")
        End If
      End If
      
    Case Is = UCase("OdOrdEnt")
    ' ***** Manali Trading Module
    If ADC("OmTc") = "JRI" Then
      If GrdOrdDsg.Mode <> fgminit And GrdOrdDsg.Mode <> fgmInitOver And GrdOrdDsg.Mode <> fgmCopy And GrdOrdDsg.Mode <> fgmCopyOver Then
        If (RowNum > 0 And RowNum <= GrdOrdDsg.Rows - 1) Then
          Dim wBQty As Long
              
          wBQty = moCn.GetFldVal("Select BQty from Bag where BCoCd = '" + GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") + "' and BYy='" + GrdOrdDsg.Value(RowNum, "OdDmStkYy") + "' and " + _
                                                        "BChr ='" + GrdOrdDsg.Value(RowNum, "OdDmStkChr") + "' and BNo = " + CStr(GrdOrdDsg.Value(RowNum, "OdDmStkNo")))
          If wBQty > 0 Then
            .Value(RowNum, "OdOrdEnt") = wBQty
          End If
        End If
      End If
    Else
  '  If UCase("OdDmStkCoCd") = UCase(SourceColName) Or UCase(SourceColName) = UCase("OdDmStkYy") Or UCase(SourceColName) = UCase("OdDmStkChr") Or UCase(SourceColName) = UCase("OdDmStkNo") Then
   '   Exit Sub
   ' End If
  Dim wb_TmJLooseTC  As String
  'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
    wb_TmJLooseTC = moCn.GetFldVal("Select TmJLooseTC   from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ms_OmTc + "'")

    If ms_OmTcTyp = ctJtTcTyp And wb_TmJLooseTC = "N" Then
      If .Mode = fgmnorm Then
        Dim wRsDsgDet As MDORowSet, wBaseRef As String
        wBaseRef = IIF(.Value(RowNum, "wOdBaseVchSr") <> "", .Value(RowNum, "wOdBaseVchSr"), .Value(RowNum, "wOdRefVchSr"))
        If wBaseRef <> "" Then
          Set wRsDsgDet = moCn.OpenRes("Select OdSfx, OdDmSz, OdDmStkYy, OdDmStkChr, OdDmStkNo, Convert(Decimal (14,1), OdOrdQty - OdExpQty) as qBalQty from OrdDsg " + _
                                     "Where OdCoCd='" + IIF(ms_OmTc = "JIN", ADC("OmBaseCoCd"), ms_OmCoCd) + "' and " + _
                                     "OdTc+'/'+OdYy+'/'+OdChr+'/'+LTrim(Rtrim(str(OdNo)))+'/'+LTrim(Rtrim(str(OdSr)))='" + wBaseRef + "' ")
          
          Do While Not (wRsDsgDet.EOF Or wRsDsgDet.BOF)
            .Value(.Row, "OdSfx") = wRsDsgDet!OdSfx
            .Value(.Row, "OdDmSz") = IIF(.Value(.Row, "OdDmSz") = "", wRsDsgDet!OdDmSz, .Value(.Row, "OdDmSz"))
            .Value(.Row, "OdDmStkYy") = IIF(.Value(.Row, "OdDmStkYy") = "", wRsDsgDet!OdDmStkYy, .Value(.Row, "OdDmStkYy"))
