    End If
    wSrcTcIsJT = moCn.GetFldVal("Select 'Y' from Param where PValue='JT' and PTyp= 'TC' and PMCd= '" + wSrcOd_OdTc + "' and PValue1='N' ")
    wTargetTcIsJT = moCn.GetFldVal("Select 'Y' from Param where PValue='JT' and PTyp= 'TC' and PMCd= '" + wTgt_OdTc + "' and PValue1='N' ")
    'HF.7 added JSO
    If ((wTgt_OdTc = "SO" And (wSrcOd_OdTc = "JPO" Or wSrcOd_OdTc = "JSO")) Or (wTargetTcIsJT = "Y" And wSrcTcIsJT = "Y")) Then
