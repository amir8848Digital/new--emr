Private Sub Timer1_Timer()
        If GrdOrdDsg.Row < 1 Or GrdOrdDsg.Row > GrdOrdDsg.Rows - 1 Then
          Exit Sub
        End If
        'sritmp
        'Timer1.Enabled = False
        Dim wRowNum As Long
        Dim w3DPth As String, wHskPth  As String
        wRowNum = GrdOrdDsg.Row
        FraPic3D.Left = wFraPic3DLft: FraPic3D.Top = wFraPic3DTop
        FraPic3D.Height = wFraPic3DHt: FraPic3D.Width = wFraPic3DWdt
        FraPicHsk.Left = wFraPicHskLft: FraPicHsk.Top = wFraPicHskTop
        FraPicHsk.Height = wFraPicHskHt: FraPicHsk.Width = wFraPicHskWdt
        w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(wRowNum, "OdDmCd"), GrdOrdDsg.Value(wRowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(wRowNum, "OdSr"), GrdOrdDsg.Value(wRowNum, "OdPicNm"))
        wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(wRowNum, "OdDmCd"), GrdOrdDsg.Value(wRowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(wRowNum, "OdSr"), GrdOrdDsg.Value(wRowNum, "OdPicNm"))
        lblNoPicture.Visible = False

        Call ShowPic(wPic3DHt, wPic3DWdt, w3DPth, Pic3D)
        Call ShowPic(wPicHskHt, wPicHskWdt, wHskPth, PicHsk)

End Sub
Private Function MakeQuoation() As Boolean
'***** Procedure to Make the Quotation ****
  Dim i As Integer, j As Integer
  Dim wo_rsSrcOd As MDORowSet
  'sv.71 deleting old error message once copy started
  moCn.Execute ("Delete from OrdCpyErr where OceCoCd= '" + ms_OmCoCd + "' and OceTc= '" + ADC("OmTc") + "' and OceYy= '" + ADC("OmYy") + "' and " + _
                   "OceChr= '" + ADC("OmChr") + "' and OceNo= " + CStr(ADC("OmNo")) + " and OcePrtKey = '" + ctCurrPrtn + "'")
  mi_ErrSr = 0

  i = 1
 ' GrdOrdDsg.StartCopy
 ' MWLib.BeginProcess Me, "Copying Records"
  Do While i <= GrdDsgSel.Rows - 1
'    DoEvents
    If GrdDsgSel.Value(i, "wDmSel") = "Y" Then
     ' MWLib.RunningProcess "Copying Details For Sr"   '" + CStr(GrdDsgSel.Value(i, "wDmSr")) + "'"
      '****** Sachin 3.02 - Current Partition
    Set wo_rsSrcOd = moCn.OpenRes("Select DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                       "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, " + _
                       "1 as OdPrdEnt,'' as OdTc, '' as OdYy,'' as OdChr,0 as OdNo, 0 as OdSr, " + _
                       "'" + ADC("OmCell") + "' as OdCell,0 as OdOmIdNo, " + _
                       "DmPrdInst as OdDmPrdInst, '' as OdSzInst, " + _
                       "DmVaCtg as OdVaCtg, DmKt as OdKt,DmBagPcs as OdBagPcs, " + _
                       "'' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm " + _
                       "from DsgMst where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                       "and DmCd= '" + Trim(GrdDsgSel.Value(i, "wDmCd")) + "' " + _
                       "and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' ")
            
      ADC.StartCopy
      'MWLib.RunningProcess "Copying Details For Sr '" + CStr(GrdDsgSel.Value(i, "WDMSR")) + "'"
      BeginEmrProcess Me, "Design Copy"   '578.40
      mf_CpyRate = False
      mf_CpyLabRate = False
      ms_CpyRateCd = "": ms_CpyRateOpt = ""
      mf_CpyFrSameCust = False
      mf_CpyVal = False     '*** (Jen 2.13)
          
      If Not ADC.SaveRec Then
        DispMsg "X Save Failed", etInfo
        EndEmrProcess Me  '578.40
        ADC.EndCopy
        Exit Function
      End If
      Call CpyDets(wo_rsSrcOd, True, True)
      EndEmrProcess Me  '578.40
     ADC.EndCopy
    Else
      j = j + 1
    End If
    i = i + 1
  Loop
  If i = j + 1 Then
    DispMsg "Please Select 'Y' In the Designs For Making Quotation", etError
    MakeQuoation = False
  Else
   ' GrdOrdDsg.EndCopy
   ' MWLib.EndProcess Me
    MakeQuoation = True
  End If
  Call ShowMsgBoxForErr   '578.40 show msgbox if any error captured
End Function
