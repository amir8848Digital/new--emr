        wExpQtyStr = "(Select isnull(Sum(OdOrdQty),0) From OrdDsg M where (M.OdCoCd=B.OdCoCd) and M.OdRefIdKey=B.OdIdNo) "
     End If



     Set wRs_DsgStk = moCn.OpenRes("Select OdTc+'/'+OdYy+'/'+OdChr+'/'+LTrim(Str(OdNo))+'/'+LTrim(Str(OdSr)) as qSrcVch, OdSubCust, OdPoNo, OdOmDt, " + _
                                   " OdDmCd as DDmCd, OdSfx as DOdSfx, OdDmSz as DDmSz, OdDmStkCoCd as DDmStkCoCd, OdDmStkYy as DDmStkYy, OdDmStkChr as DDmStkChr, OdDmStkNo as DDmStkNo, Convert(Decimal(14,1), (OdOrdQty-" + wExpQtyStr + ")) qStkQty, " + _
                                   " Convert(Decimal(14,2), OdSalPrc) OdSalPrc,IsNull((Select Sum(OrWt/ (Case When OrRmCtg In ('D', 'C') Then 5 Else 1 End)) From OrdRm " + _
