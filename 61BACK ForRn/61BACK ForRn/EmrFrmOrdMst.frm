      wi_Row = .Rows - 1
        .Value(wi_Row, "OTRMCTG") = wo_rsOrdRmSumm!DrRmCtg
        .Value(wi_Row, "OTRMSCTG") = wo_rsOrdRmSumm!DrRmSCtg
