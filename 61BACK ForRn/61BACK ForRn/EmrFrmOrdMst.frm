  Dim wr_pos As Long
  wr_pos = InStr(1, wErrMsg, ct_SqlErrMsg)
  If wr_pos <> 0 Then wErrMsg = Mid(wErrMsg, Len(ct_SqlErrMsg) + 1)
  GetErrorMessage = wErrMsg
End Function
