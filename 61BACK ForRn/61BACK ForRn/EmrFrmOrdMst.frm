                                          "  And OmYy='" + ADC("OmYy") + "' And OmChr='" + ADC("OmChr") + "' And OmNo=" + CStr(ADC("OmNo")) + " And OmPrtKey='" + ctCurrPrtn + "'")
                                          
        .Store "OdPrtFgQty", 0
        .Store "OdPrtExpQty", 0
   
        'indigo.164- SS Tc added
        .Store "OdDmIdNo", moCn.GetFldVal("Select DmIdNo From DsgMst Where DmTcTyp='" + IIF(ADC("OmTc") = "QS" Or ADC("OmTc") = "OS", "SM", "DM") + "' And DmCd='" + .Value(RowNum, "OdDmCd") + "' " + _
