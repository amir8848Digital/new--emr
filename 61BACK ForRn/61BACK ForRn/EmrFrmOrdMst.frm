  wOrderBy = "qOdDmcd, qOdDmSz, qOdSfx" + IIF(ADC("wDsCpyTc") = "JSO" Or ADC("wDsCpyTc") = "JPO" Or ADC("wDsCpyTc") = "IN", "", ",qOdDmStkCoCdForSrt, qOdDmStkYyForSrt, qOdDmStkChrForSrt, qOdDmStkNoForSrt")
  moCn.CreateTmpTable "#ShowDsgStkAutoMap", wSqlStr
