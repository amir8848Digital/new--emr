       ' ****** Manali 3.5.0 - 17/11/08 - Allow OtRmCd of Other RmCtg in case of Main Metals
       '6.1 Space(12) as qAlyCd TO Space(16) as qAlyCd
      ws_OrdRmStr = " Select ' ' as qOrRmExists, IrSrNo as qSrNo, " + _
                    " IrRmCtg as qRmCtg, IrRmSCtg as qRmSCtg, IrRmCd as qRmCd, " + _
                    " IrRmCtg as qRmOldCtg, IrRmSCtg as qRmOldSCtg, " + _
                    " IrRmCd as qRmOldCd, (Case when PValue3= 'N' then IrRmSz else Cast(00.000 as Decimal(6,3)) End) as qIrRmSz, " + _
                    " Cast(00.000 as Decimal(6,3)) as qLn2, Cast(00.000 as Decimal(6,3)) as qLn3, IrRmQty as qQty, " + _
                    " (Case When PValue3= 'Y' then IrRmSz else Cast(00.0000 as Decimal(6,4)) end) as qRmPtr, IrRmIWt/" + CStr(pv_rsSrcOd!IdQty) + " as qWt, " + _
                    " 9999.999 as qXtraWt, IrRmQty as qPrdQty, IrRmAWt/" + CStr(pv_rsSrcOd!IdQty) + " as qPrdWt, IrSetSCd as qSetSCd, IrRmQty as qWsQty, " + _
                    " 0 as qHsQty, Space(10) as qSubShp, Space(16) as qAlyCd, " + _
                    " IrMainMet as qMainMet, Case When IrRmCtg='G' Then InLmgSal When IrRmCtg='P' Then InLmpSal " + _
                    " When IrRmCtg='S' Then InLmsSal When IrRmCtg='L' Then InLmlSal Else 0 End as OrLmeSal, IrRmIRt as OrSalRt, IrRmARt as OrCstRt, IrRmIVal as OrSalVal, " + _
                    " IrRmAVal as OrCstVal, IrSetIRt as OrSetSalRt, " + _
                    " IrSetARt as OrSetCstRt, IrSetIVal as OrSetSalVal, IrSetAVal as OrSetCstVal, IrAlySalRt as OrAlySalRt, " + _
                    " IrAlySalRt as OrAlyCstRt, 0 as qOrQty, '' as qRmSTWGrp, 0 as qOrWt,  " + _
                    " IrRmSz as qLn1,IrLotNo as qLotNo  "
                    
       ws_OrdRmStr = ws_OrdRmStr + " Into " + wTmpTbl + " From InvRm " + _
                    " Join InvHd On InPrtKey=IrPrtKey and InCoCd=IrCoCd And InTc=IrTc And InYy=IrYy And InChr=IrChr And InNo=IrNo " + _
                    " Join RmMst On RmCd=IrRmCd And RmPrtKey='" + ctCurrPrtn + "' " + _
                    " Join Param P1 on P1.PTyp= 'RMSCTG' and P1.PMCd= RmCtg and P1.PSCd= RmSCtg " + _
                    " Where IrCoCd='" + IIF(ms_OmTcTyp = "PL", gs_CoCd, wo_rsExpOrd!OdCoCd) + "' and IrTc='" + pv_rsSrcOd!IdTc + "' and IrYy='" + pv_rsSrcOd!IdYy + "' and " + _
                    " IrChr='" + pv_rsSrcOd!IdChr + "' and IrNo=" + CStr(pv_rsSrcOd!IdNo) + " and " + _
                    " IrSr=" + CStr(pv_rsSrcOd!IdSr) + " Order By IrSrNo "
                    
        '*** Creating Temporary Table #TmpInvRm ***
        moCn.CreateTmpTable wTmpTbl, ws_OrdRmStr
        moCn.Execute ("Update " + wTmpTbl + " Set qXtraWt= 0.000 ")
        If pi_ApplyXDM = "Y" Then
        Call GetXtraWt("XDM", "XDM", wTmpTbl, "A", "A", ADC("OmCmCd"), _
                    moCn.GetFldVal("Select DmCtg from DsgMst where DmTcTyp= '" + ms_DmTcTyp + "' and " + _
                    "DmCd= '" + GrdOrdDsg.Value(wi_OdRow, "OdDmCd") + "' and DmSz= ''" + IIF(gs_Partition = ctCurrPrtn, " And DmPrtKey='" + ctCurrPrtn + "'", "")), _
                      "qWt", "qXtraWt", "OrSalRt", 1)
                    'GrdOrdDsg.Value(wi_OdRow, "OdOrdQty")
            
        End If
        Set wo_rsSrcORm = moCn.OpenResultset("Select * from " + wTmpTbl)
     
     Dim wOrLnStr As String, wOrLn1Str As String, wOrRecSet As MDORowSet, wOrStr As String
     If (wo_rsSrcORm.RecCount > 0) Then wo_rsSrcORm.MoveFirst
     Do While ADC("OmTc") <> "JRI" And (Not (wo_rsSrcORm.EOF Or wo_rsSrcORm.BOF))
        wo_rsSrcORm.edit
        
        ws_OrLn = "(case when Pvalue3='Y' then (Case when PValue2='Y' then  " + _
                "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty=0 then 0 else  " + _
                "cast((OrPrdWt/OrPrdQty) as Decimal(12,4)) end ) end )  " + _
                "else cast(Orln1 as Decimal(12,4)) end ) "
        'indigo.160- company code can change from ms_OmCoCd  to ms_OmCoCd
        ws_ShowPtr = moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ms_OmCoCd + "' and HCd= '" + ctSelfCmCd + "'")
        
        ws_Ptr = "max(case when '" + ws_ShowPtr + "'= 'Y' then (Case when PValue2='Y' then  " + _
                 "cast(OrRmPtr as Decimal(12,4)) else (case when OrPrdQty= 0 then 0 else  " + _
                 "cast((OrPrdWt/ OrPrdQty) as Decimal(12, 4)) end ) end )  " + _
                 "else 0 end) as qRmPtr "
                
        wOrLnStr = IIF(moCn.GetFldVal("select PValue3 From Param Join  RmMst " + _
                                " on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                                "where RmPrtKey='" + ctCurrPrtn + "' And RmCd= '" + wo_rsSrcORm!qRmCd + "' ") = "Y", _
                       IIF(moCn.GetFldVal("select PValue2 From Param Join RmMst " + _
                                "on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                                "where RmPrtKey='" + ctCurrPrtn + "' And RmCd= '" + wo_rsSrcORm!qRmCd + "' And RmPrtKey='" + ctCurrPrtn + "' ") = "Y", "OrRmPtr", _
                                " case when OrPrdQty =0 then 0 else OrPrdWt/OrPrdQty end "), "OrLn1")
        
        If mf_CpyFrSameCust = True Then
            ws_AlyCdStr = " OrAlyCd "
        Else
          If mf_CpyRate = True Then
               ws_AlyCdStr = " Case When '" + "," + ms_CpyRateOpt + "," + "' Like '%,' + Max(OrRmCtg) + ',%' Then OrAlyCd Else IsNull(CaAlyCd, OrAlyCd) End "
          Else
               ws_AlyCdStr = " IsNull(CaAlyCd, OrAlyCd) "
          End If
        End If
        
        ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
        wOrLn1Str = " Select " + ws_Ptr + ", Max(OrLn1) as qLn1, OrLn2 as qLn2,OrLn3 as qLn3, " + ws_AlyCdStr + " as qAlyCd from OrdRm " + _
                    "   Join RmMst on RmCd= OrRmCd And RmPrtKey=OrPrtKey " + _
                    "   Join Param on PTyp= 'RMSCTG' and PMCd= RmCtg and PSCd= RmSCtg " + _
                    IIF(mf_CpyFrSameCust = False, "Left Outer Join CustAly On CaCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CaCd= '" + ADC("OmCmCd") + "' " + _
                    "       and CaRmCd=OrRmCd and CaDmCol= '" + wo_rsExpOrd!OdDmCol + "' ", "") + _
                    "  Where OrCoCd= '" + IIF(ms_OmTcTyp = "PL", gs_CoCd, wo_rsExpOrd!OdCoCd) + "' and OrTc = '" + pv_rsSrcOd!IdExpOdTc + "' " + _
                    "     and OrYy= '" + pv_rsSrcOd!IdExpOdYy + "' " + _
                    "     and OrChr= '" + pv_rsSrcOd!IdExpOdChr + "' and OrNo = " + CStr(pv_rsSrcOd!IdExpOdNo) + _
                    "     and OrSr= " + CStr(pv_rsSrcOd!IdExpOdSr) + " and OrPrtKey='" + ADC("OmPrtKey") + "' " + _
                    "     And OrRmCd= '" + wo_rsSrcORm!qRmCd + "' and " + wOrLnStr + " = " + CStr(wo_rsSrcORm!qIrRmSz) + _
                    " Group By  OrRmCd, " + ws_OrLn + ", OrLn2,OrLn3, OrSetSCd, OrAlyCd " + IIF(mf_CpyFrSameCust = True, "", ",IsNull(CaAlyCd, OrAlyCd) ")
                    
        Set wOrRecSet = moCn.OpenRes(wOrLn1Str)
        If Not (wOrRecSet.EOF Or wOrRecSet.BOF) Then
          wOrRecSet.MoveFirst
          wo_rsSrcORm!qOrRmExists = "Y"
          wo_rsSrcORm!qAlyCd = wOrRecSet!qAlyCd
          If (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C") Then
              wo_rsSrcORm!qLn1 = wOrRecSet!qLn1
              wo_rsSrcORm!qLn2 = wOrRecSet!qLn2
              wo_rsSrcORm!qLn3 = wOrRecSet!qLn3
              wo_rsSrcORm!qRmPtr = wOrRecSet!qRmPtr
          End If
        End If
      
      If moCn.RecSeek("select count(distinct qSetSCd) From " + wTmpTbl + " " + _
                        "Where qRmCd= '" + wo_rsSrcORm!qRmCd + "' " + _
                        " and qIrRmSz= " + CStr(wo_rsSrcORm!qIrRmSz) + _
                        "group by qRmCd, qLn1 Having count(distinct qSetSCd)> 1") Then
        
          '****** Sachin 3.02 03-12-07 - Partition Key added below
          wOrStr = " Select OrLn2, OrLn3, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg,OrLotNo " + _
                  " From OrdRm Where OrCoCd= '" + wo_rsExpOrd!OdCoCd + "' " + _
                  " and OrTc = '" + pv_rsSrcOd!IdExpOdTc + "' " + _
                  " and OrYy= '" + pv_rsSrcOd!IdExpOdYy + "' " + _
                  " and OrChr= '" + pv_rsSrcOd!IdExpOdChr + "' " + _
                  " and OrNo = " + CStr(pv_rsSrcOd!IdExpOdNo) + _
                  " and OrSr= " + CStr(pv_rsSrcOd!IdExpOdSr) + _
                  " and OrRmCd= '" + wo_rsSrcORm!qRmCd + "' " + _
                  " and " + wOrLnStr + " = " + CStr(wo_rsSrcORm!qIrRmSz) + _
                  " and OrSetSCd= '" + wo_rsSrcORm!qSetSCd + "' And OrPrtKey='" + ctCurrPrtn + "' " + _
                  " Order by OrMainMet Desc"
          
        Else
          '****** Sachin 3.02 03-12-07 - Partition Key added below
          wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg,OrLotNo " + _
                    "From OrdRm Where OrCoCd= '" + wo_rsExpOrd!OdCoCd + "' " + _
                    " and OrTc = '" + pv_rsSrcOd!IdExpOdTc + "' " + _
                    " and OrYy= '" + pv_rsSrcOd!IdExpOdYy + "' " + _
                    " and OrChr= '" + pv_rsSrcOd!IdExpOdChr + "' " + _
                    " and OrNo = " + CStr(pv_rsSrcOd!IdExpOdNo) + _
                    " and OrSr= " + CStr(pv_rsSrcOd!IdExpOdSr) + _
                    " and OrRmCd= '" + wo_rsSrcORm!qRmCd + "' " + _
                    " and " + wOrLnStr + " = " + CStr(wo_rsSrcORm!qIrRmSz) + " And OrPrtKey='" + ctCurrPrtn + "' " + _
                    "Order by OrMainMet Desc"
        End If
      
        Set wOrRecSet = moCn.OpenRes(wOrStr)
      
        If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
          '****** Sachin 3.02 03-12-07 - Partition Key added below
          wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg,OrLotNo " + _
                   "From OrdRm join RmRt on RrPrtKey='" + ctCurrPrtn + "' And RrTcTyp= 'RSZ' and RrCmCd= '" + ctSelfCmCd + "' and " + _
                   "RrCtg= OrRmCtg and RrSCtg= OrRmSCtg " + _
                   "where OrCoCd= '" + wo_rsExpOrd!OdCoCd + "' " + _
                   " and OrTc = '" + pv_rsSrcOd!IdExpOdTc + "' " + _
                   " and OrYy= '" + pv_rsSrcOd!IdExpOdYy + "' " + _
                   " and OrChr= '" + pv_rsSrcOd!IdExpOdChr + "' " + _
                   " and OrNo = " + CStr(pv_rsSrcOd!IdExpOdNo) + _
                   " and OrSr= " + CStr(pv_rsSrcOd!IdExpOdSr) + _
                   " and OrRmCd =  '" + wo_rsSrcORm!qRmCd + "' " + _
                   " and " + wOrLnStr + " >= RrFrLn and " + wOrLnStr + " <= RrToLn and " + _
                   CStr(wo_rsSrcORm!qIrRmSz) + " >= RrFrLn and " + _
                   CStr(wo_rsSrcORm!qIrRmSz) + " <= RrToLn And OrPrtKey='" + ctCurrPrtn + "'" + _
                   " Order by OrMainMet Desc "
                   
          Set wOrRecSet = moCn.OpenRes(wOrStr)
        End If
      
        If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
          '****** Sachin 3.02 03-12-07 - Partition Key added below
          wOrStr = "Select OrLn2, OrLn3, OrQty, OrWt, OrSetScd, OrWsQty, OrHsQty, OrSubShp, OrAlyCd, OrMainMet, OrRmCtg,OrLotNo " + _
                   "From OrdRm where OrCoCd= '" + wo_rsExpOrd!OdCoCd + "' " + _
                   " and OrTc = '" + pv_rsSrcOd!IdExpOdTc + "' " + _
                   " and OrYy= '" + pv_rsSrcOd!IdExpOdYy + "' " + _
                   " and OrChr= '" + pv_rsSrcOd!IdExpOdChr + "' " + _
                   " and OrNo = " + CStr(pv_rsSrcOd!IdExpOdNo) + _
                   " and OrSr= " + CStr(pv_rsSrcOd!IdExpOdSr) + _
                   " and OrRmCd= '" + wo_rsSrcORm!qRmCd + "' And OrPrtKey='" + ctCurrPrtn + "' " + _
                   "Order by OrMainMet Desc"
          Set wOrRecSet = moCn.OpenRes(wOrStr)
        End If
    
        If (wOrRecSet.EOF Or wOrRecSet.BOF) Then
          wo_rsSrcORm!qSubShp = ""
          wo_rsSrcORm!qMainMet = "N"
        Else
          wOrRecSet.MoveFirst
          wo_rsSrcORm!qLn2 = IIF(wo_rsSrcORm!qOrRmExists <> "Y", wOrRecSet!OrLn2, wo_rsSrcORm!qLn2)
          wo_rsSrcORm!qLn3 = IIF(wo_rsSrcORm!qOrRmExists <> "Y", wOrRecSet!OrLn3, wo_rsSrcORm!qLn3)
          If mf_CpyFrSameCust = True Then wo_rsSrcORm!qAlyCd = wOrRecSet!OrAlyCd
          wo_rsSrcORm!qSubShp = wOrRecSet!OrSubShp
          wo_rsSrcORm!qWsQty = wOrRecSet!OrWsQty
          wo_rsSrcORm!qHsQty = wOrRecSet!OrHsQty
        End If
      
        wo_rsSrcORm.Update
        wo_rsSrcORm.MoveNext
    Loop
    
    '****** Sachin 3.3.0  - Applying the Order Target Details ******
    '' ****** Manali 3.5.0 - 17/11/08 - Allow OtRmCd of Other RmCtg in case of Main Metals
    ws_OrdRmStr = " Update " + wTmpTbl + _
                          " Set qRmCtg=IsNull(RmCtg,qRmCtg), qRmSCtg=IsNull(RmSCtg,qRmSCtg), qRmCd= IsNull(OtRmCd, qRmCd) " + _
                          " From " + wTmpTbl + _
                          " Left Outer Join (Select OtCoCd, OtTc, OtYy, OtChr, OtNo, OtSr, OtPrtKey, OtRmCtg, OtRmSCtg, OtRmCd, RmCtg, RmSCtg " + _
                          " From OrdTgt Join RmMst On RmCd=OtRmCd) Ott on OtCoCd= '" + IIF(ms_OmTcTyp = "PL", gs_CoCd, ms_OmCoCd) + "' and " + _
                          " OtTc= '" + ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and " + _
                          " OtChr= '" + ADC("OmChr") + "' and OtNo= " + CStr(ADC("OmNo")) + " and " + " OtPrtKey='" + ctCurrPrtn + "' and " + _
                          " OtSr= 0 and " + _
                          " OtRmCtg= qRmCtg and OtRmSCtg= qRmSCtg "
    moCn.Execute ws_OrdRmStr
    '****** Sachin 3.3.0  - Applying the Order Target Details ******
    
    Set wo_rsSrcORm = moCn.OpenRes("select * from " + wTmpTbl + " Order By qMainMet Desc")
      
      With GrdOrdRm
        GrdOrdRm.StartCopy
        Do While Not (wo_rsSrcORm.EOF Or wo_rsSrcORm.BOF)
          .AddItem
          wi_RmRow = .Rows - 1
          .Value(wi_RmRow, "OrSrNo") = wi_RmRow
          .Value(wi_RmRow, "OrRmCtg") = wo_rsSrcORm!qRmCtg
          .Value(wi_RmRow, "OrRmSCtg") = wo_rsSrcORm!qRmSCtg
          .Value(wi_RmRow, "OrRmCd") = wo_rsSrcORm!qRmCd
          .Value(wi_RmRow, "OrLn1") = wo_rsSrcORm!qLn1
          .Value(wi_RmRow, "OrLn2") = wo_rsSrcORm!qLn2
          .Value(wi_RmRow, "OrLn3") = wo_rsSrcORm!qLn3
          .Value(wi_RmRow, "OrQty") = wo_rsSrcORm!qQty / pv_rsSrcOd!IdQty
          
                   
          Dim wRmSTWGrpOld As String, wRmDetOld As String, wOldRmSCtg As String, wOldRmCtg As String
          Dim wRmSTWGrp As String, wRmDetArr() As String
          wRmSTWGrp = "": wRmSTWGrpOld = "": wOldRmSCtg = wo_rsSrcORm!qRmSCtg
          
          If UCase(moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")) = "Y" And _
              GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" And _
                (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C") Then
                  wRmDetOld = moCn.GetFldVal("Select RmCtg+','+RmSCtg+ ','+ RmSTWGrp from RmMst where RmCd= '" + wo_rsSrcORm!qRmOldCd + "' ")
                If wRmDetOld <> "" Then
                  wRmDetArr = Split(wRmDetOld, ",")
                  wOldRmCtg = wRmDetArr(0)
                  wOldRmSCtg = wRmDetArr(1)
                  wRmSTWGrpOld = wRmDetArr(2)
                  wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + wo_rsSrcORm!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "' ")
                End If
          End If
          
          If wRmSTWGrp <> wRmSTWGrpOld Or wo_rsSrcORm!qRmSCtg <> wOldRmSCtg Then
                .Value(wi_RmRow, "OrRmPtr") = GetWtFrSz(wo_rsSrcORm!qRmCtg, wo_rsSrcORm!qRmSCtg, wo_rsSrcORm!qLn1, wo_rsSrcORm!qLn2, wRmSTWGrp)
          Else
                .Value(wi_RmRow, "OrRmPtr") = wo_rsSrcORm!qRmPtr
          End If
          
'          If (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C") And .Value(wi_RmRow, "OrRmPtr") = 0 Then .Value(wi_RmRow, "OrRmPtr") = MWLib.Div(wo_rsSrcORm!qWt / pv_rsSrcOd!IdQty, wo_rsSrcORm!qQty / pv_rsSrcOd!IdQty)
          If (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C") And .Value(wi_RmRow, "OrRmPtr") = 0 Then .Value(wi_RmRow, "OrRmPtr") = MWLib.Div(wo_rsSrcORm!qWt, wo_rsSrcORm!qQty / pv_rsSrcOd!IdQty)
             
          If (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "G" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "P" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "S" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "L") And _
             wo_rsSrcORm!qRmOldCd <> wo_rsSrcORm!qRmCd Then
            Dim wFndPcWt As Double
            wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + wo_rsSrcORm!qRmCd + "' ")
            If wFndPcWt <> 0 Then
              .Value(wi_RmRow, "OrWt") = (wo_rsSrcORm!qQty / pv_rsSrcOd!IdQty) * wFndPcWt
              .Value(wi_RmRow, "OrPrdWt") = (IIF(Trim(ws_TmpOrdRmTbl) <> "", wo_rsSrcORm!qQty, wo_rsSrcORm!qPrdQty) / pv_rsSrcOd!IdQty) * wFndPcWt
            Else
               wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + wo_rsSrcORm!qRmOldCd + "' and RmPrtKey='" + ctCurrPrtn + "'")
               wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + wo_rsSrcORm!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "'")
              ' ***** Manali - 24/11/08 - RmWt for 1 piece taken
'              .Value(wi_RmRow, "OrWt") = (MWLib.Div(wo_rsSrcORm!qWt * wNewSpGrav, wOldSpGrav)) / pv_rsSrcOd!IdQty + wo_rsSrcORm!qXtraWt
              .Value(wi_RmRow, "OrWt") = (MWLib.Div(wo_rsSrcORm!qWt * wNewSpGrav, wOldSpGrav)) + wo_rsSrcORm!qXtraWt
'              .Value(wi_RmRow, "OrPrdWt") = (MWLib.Div(IIF(Trim(ws_TmpOrdRmTbl) <> "", wo_rsSrcORm!qWt, wo_rsSrcORm!qPrdWt) * wNewSpGrav, wOldSpGrav)) / pv_rsSrcOd!IdQty + wo_rsSrcORm!qXtraWt
              .Value(wi_RmRow, "OrPrdWt") = (MWLib.Div(IIF(Trim(ws_TmpOrdRmTbl) <> "", wo_rsSrcORm!qWt, wo_rsSrcORm!qPrdWt) * wNewSpGrav, wOldSpGrav)) + wo_rsSrcORm!qXtraWt
            End If
            
            wb_RmChgFlag = True
            'mb_CpyKT = False    ' ***** Manali 3.9.0 - Copy Kt From PDC
            If wo_rsSrcORm!qMainMet = "Y" Then
                
               If moCn.GetFldVal("Select RmKT from RmMst where RmCd= '" + wo_rsSrcORm!qRmOldCd + "' and RmPrtKey='" + ctCurrPrtn + "'") _
                        <> moCn.GetFldVal("Select RmKT from RmMst where RmCd= '" + wo_rsSrcORm!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "'") Then _
                  mb_CpyKT = False    ' ***** Manali 3.9.0 - Copy KT from PDC
               If moCn.GetFldVal("Select RmCol from RmMst where RmCd= '" + wo_rsSrcORm!qRmOldCd + "' and RmPrtKey='" + ctCurrPrtn + "'") _
                        <> moCn.GetFldVal("Select RmCol from RmMst where RmCd= '" + wo_rsSrcORm!qRmCd + "' and RmPrtKey='" + ctCurrPrtn + "'") Then _
                mb_CpyCol = False
             End If
          Else
            wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + wo_rsSrcORm!qRmCd + "' ")
            If wFndPcWt <> 0 And wo_rsSrcORm!qRmOldCd <> wo_rsSrcORm!qRmCd Then
                .Value(wi_RmRow, "OrWt") = wFndPcWt
                .Value(wi_RmRow, "OrPrdWt") = wFndPcWt
            ElseIf GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" And _
                  (wRmSTWGrp <> wRmSTWGrpOld Or wo_rsSrcORm!qRmSCtg <> wOldRmSCtg) And _
                   (UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C") Then
                  .Value(wi_RmRow, "OrWt") = (.Value(wi_RmRow, "OrRmPtr") * wo_rsSrcORm!qQty) / pv_rsSrcOd!IdQty + wo_rsSrcORm!qXtraWt
                  .Value(wi_RmRow, "OrPrdWt") = (.Value(wi_RmRow, "OrRmPtr") * IIF(Trim(ws_TmpOrdRmTbl) <> "", wo_rsSrcORm!qQty, wo_rsSrcORm!qPrdQty)) / pv_rsSrcOd!IdQty + wo_rsSrcORm!qXtraWt
            Else
                .Value(wi_RmRow, "OrWt") = wo_rsSrcORm!qWt + wo_rsSrcORm!qXtraWt
                .Value(wi_RmRow, "OrPrdWt") = wo_rsSrcORm!qWt + wo_rsSrcORm!qXtraWt
            End If
            
          End If
          
          .Value(wi_RmRow, "OrPrdQty") = wo_rsSrcORm!qPrdQty / pv_rsSrcOd!IdQty
          .Value(wi_RmRow, "OrSetSCd") = wo_rsSrcORm!qSetSCd
          
          If wo_rsSrcORm!qRmCtg = "C" Or wo_rsSrcORm!qRmCtg = "D" Then
            .Value(wi_RmRow, "OrWsQty") = .Value(wi_RmRow, "OrQty") * (wo_rsSrcORm!qWsQty / (IIF((wo_rsSrcORm!qWsQty + wo_rsSrcORm!qHsQty) > 0, (wo_rsSrcORm!qWsQty + wo_rsSrcORm!qHsQty), 1)))
            .Value(wi_RmRow, "OrHsQty") = .Value(wi_RmRow, "OrQty") - .Value(wi_RmRow, "OrWsQty")
          End If
          
          .Value(wi_RmRow, "OrSubShp") = wo_rsSrcORm!qSubShp
          .Value(wi_RmRow, "OrAlyCd") = wo_rsSrcORm!qAlyCd
          .Value(wi_RmRow, "OrMainMet") = wo_rsSrcORm!qMainMet
          CopyOrLotVal False, True, False, ADC("OmTc"), "IN", wo_rsExpOrd!OdCoCd, pv_rsSrcOd!IdExpOdYy, pv_rsSrcOd!IdExpOdTc, pv_rsSrcOd!IdExpOdChr, pv_rsSrcOd!IdExpOdNo, pv_rsSrcOd!IdExpOdSr, wo_rsSrcORm!qRmCd, wo_rsSrcORm!qLotNo, wi_RmRow
          If mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", wo_rsSrcORm!qRmCtg) >= 1 Then
            .Value(wi_RmRow, "OrLmeSal") = wo_rsSrcORm!OrLMESal
            .Value(wi_RmRow, "OrSalRt") = wo_rsSrcORm!OrSalRt
            If mf_CpyVal = True Then
              .Value(wi_RmRow, "OrSalVal") = wo_rsSrcORm!OrSalVal / pv_rsSrcOd!IdQty
            End If
            .Value(wi_RmRow, "OrAlySalRt") = wo_rsSrcORm!OrAlySalRt
          End If
          
          If mf_CpyLabRate = True Then 'And InStr(1, "," + ws_CtgStr + ",", wo_rsSrcORm!qRmCtg) >= 1 Then
              .Value(wi_RmRow, "OrSetSalRt") = wo_rsSrcORm!OrSetSalRt
              '.Value(wi_RmRow, "OrSetCstRt") = wo_rsSrcORm!OrSetCstRt    ' ***** Manali 3.03 - Cst Rt/Val always from Current
              If mf_CpyVal = True Then
                ' ***** Manali 3.03 - Cst Rt/Val always from Current
                '.Value(wi_RmRow, "OrSetCstVal") = wo_rsSrcORm!OrSetCstVal / pv_rsSrcOd!IdQty
                .Value(wi_RmRow, "OrSetSalVal") = wo_rsSrcORm!OrSetSalVal / pv_rsSrcOd!IdQty
              End If
            End If
          
          .Value(wi_RmRow, "OrPrtKey") = ADC("OmPrtKey")
          If .SaveRec(wi_RmRow) = False Then
            .DelAllRecs
            wErrMsg = wErrMsg + " " + "DesignCd/Sfx/Sz : " + pv_rsSrcOd!IdDmCd + "/" + pv_rsSrcOd!IdSfx + "/" + _
                                  IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                  "/" + wo_rsSrcORm!qRmCtg + "/" + wo_rsSrcORm!qRmSCtg + "/" + wo_rsSrcORm!qRmCd + " " + Err.Description + ":" + gs_ErrMsg
            Call CpyErrMsg(wErrMsg)     '578.40 capturing error message
            Exit Do
          End If
          
          wo_rsSrcORm.MoveNext
        Loop
        
        GrdOrdRm.EndCopy
      End With
      
    .Value(wi_OdRow, "OdMinWt") = IIF(.Value(wi_OdRow, "OdMinWt") <> 0, .Value(wi_OdRow, "OdMinWt"), 0)
    .Value(wi_OdRow, "OdMaxWt") = IIF(.Value(wi_OdRow, "OdMaxWt") <> 0, .Value(wi_OdRow, "OdMaxWt"), 0)
    
    
    
    ' ******* Manali 3.5.0 - 02/04/08 - Tolerance at Order Level
    .Value(wi_OdRow, "OdMinDiaTolWt") = IIF(.Value(wi_OdRow, "OdMinDiaTolWt") <> 0, .Value(wi_OdRow, "OdMinDiaTolWt"), 0)
    .Value(wi_OdRow, "OdMaxDiaTolWt") = IIF(.Value(wi_OdRow, "OdMaxDiaTolWt") <> 0, .Value(wi_OdRow, "OdMaxDiaTolWt"), 0)

     '****** Sachin 3.3.0 - Setting the String for Labour Copy ******
     Set wo_rsSrcOl = moCn.OpenRes("Select * from InvLab where " + _
              "IlCoCd='" + IIF(ms_OmTcTyp = "PL", gs_CoCd, wCoCd) + "' and IlTc='" + pv_rsSrcOd!IdTc + "' and " + _
              "IlYy='" + pv_rsSrcOd!IdYy + "' and IlChr='" + pv_rsSrcOd!IdChr + "' and " + _
              "IlNo=" + CStr(pv_rsSrcOd!IdNo) + " and IlSr=" + CStr(pv_rsSrcOd!IdSr) + " and IlPrtKey='" + ctCurrPrtn + "'" + _
              " Order By IlSrNo")
              
      With GrdOrdLab
        GrdOrdLab.StartCopy
        
        Do While (ADC("OmTc") <> "JRI" And Not (wo_rsSrcOl.EOF Or wo_rsSrcOl.BOF))
          .AddItem
          wi_LabRow = .Rows - 1
          .Value(wi_LabRow, "OlSrNo") = wi_LabRow
          .Value(wi_LabRow, "OlMCd") = wo_rsSrcOl!IlMCd
          .Value(wi_LabRow, "OlSCd") = wo_rsSrcOl!IlSCd
          .Value(wi_LabRow, "OlQty") = wo_rsSrcOl!IlQty
           
          If mf_CpyLabRate = True Then
            .Value(wi_LabRow, "OlQw") = wo_rsSrcOl!IlQw
            '.Value(wi_LabRow, "OlCstQw") = wo_rsSrcOl!IlCstQw      ' ***** Manali 3.03 - Cst Rt/Val always from Current
            .Value(wi_LabRow, "OlQty") = wo_rsSrcOl!IlQty
            .Value(wi_LabRow, "OlSalRt") = wo_rsSrcOl!IlIRt
            '.Value(wi_LabRow, "OlCstRt") = wo_rsSrcOl!IlARt        ' ***** Manali 3.03 - Cst Rt/Val always from Current
            
            If mf_CpyVal = True Then
              .Value(wi_LabRow, "OlSalVal") = wo_rsSrcOl!IlIVal / pv_rsSrcOd!IdQty
              ' ***** Manali 3.03 - Cst Rt/Val always from Current
              '.Value(wi_LabRow, "OlCstVal") = wo_rsSrcOl!IlAVal / pv_rsSrcOd!IdQty
            End If
            
          End If
          
          .Value(wi_LabRow, "OlPrtKey") = ADC("OmPrtKey")  '****** Sachin 3.02 - Partition Key value
          
          If .SaveRec(wi_LabRow) = False Then
            .DelAllRecs
            wErrMsg = wErrMsg + " " + "DesignCd/Sfx/Sz : " + pv_rsSrcOd!IdDmCd + "/" + pv_rsSrcOd!IdSfx + "/" + _
                                  IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                  "/" + wo_rsSrcOl!IlMCd + "/" + wo_rsSrcOl!IlSCd + "/" + " " + Err.Description + ":" + gs_ErrMsg
            Call CpyErrMsg(wErrMsg)     '578.40 capturing error message
            Exit Do
          End If
          
          wo_rsSrcOl.MoveNext
        Loop

        GrdOrdLab.EndCopy
      End With
      
    Call SetDsgPrc(wi_OdRow, VtCalc)
        'gnanu

  
    If Not .SaveRec(wi_OdRow) Then
      wErrMsg = wErrMsg + " " + "DesignCd/Sfx/Sz : " + pv_rsSrcOd!IdDmCd + "/" + _
                                                         pv_rsSrcOd!IdSfx + "/" + _
                                                         IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                                         " Message : " + Err.Description + ":" + gs_ErrMsg
      Call CpyErrMsg(wErrMsg)     '578.40 capturing error message
      GoTo NextOd
    End If
NextOd:
      If Not mf_CopyModeStartedByParent Then
        m_icunt = m_icunt + 1
      End If
      pv_rsSrcOd.MoveNext
    Loop
EndCopy:
    GrdOrdDsg.EndCopy
    mCpyInvDetsSpclErrMsg = wErrMsg
    mf_ShowDsg = True
    Set pv_rsSrcOd = Nothing
    Set wo_rsSrcORm = Nothing
    Set wo_rsSrcOl = Nothing
  End With
End Sub
Private Function FldEna(ByVal mEna As String) As Boolean
  '*** Function to return the Ena/Disa state of the controls on the form
  Select Case mEna
    Case Is = "E", "B"
      FldEna = True
    Case Else
      FldEna = False
  End Select
End Function
Private Sub ForCpy_CpyInvDets(ByVal pv_rsSrcOd As MDORowSet, Optional ByVal pi_ApplyXDM As String)
  Dim wi_OdRow As Integer, wi_RmRow As Integer, wi_LabRow As Integer, wi_OCTRow As Integer '*** Jay 2.13(CT) ***
  Dim wo_rsSrcORm As MDORowSet, wo_rsSrcOl As MDORowSet, wo_rsSrcOCT As MDORowSet, wo_rsExpOrd As MDORowSet
  Dim wOldSpGrav As Single, wNewSpGrav As Single, ws_OdWh As String, wCoCd As String, ws_AlyCdStr As String
  Dim wDmDefSz As String, wb_RmChgFlag As Boolean, ws_BagStr As String, ws_TmpOrdRmTbl As String
  Dim ws_OrdRmStr As String, ws_Vch() As String, ws_CtgStr As String, ws_HOdGmChk As String, ws_OrdStr As String
  Dim ws_OrLn As String, ws_ShowPtr As String, ws_Ptr As String, wTmpTbl As String
  mCpyInvDetsSpclErrMsg = ""
  Dim wErrMsg As String
'  Dim mf_InCopyFromServer As Boolean
  'mf_CpySalPrc = mf_CpyVal
  'indigo.160- company code can change from ms_OmCoCd to ms_OmCoCd
  mf_InCopyFromServer = True
  ws_HOdGmChk = moCn.GetFldVal("Select HOdGmChk From Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")
  'wCoCd = ADC("wOCoCd") ' ms_OmCoCd

  mf_CpyDmId = False
  mb_CpyCol = True
  mb_CpyKT = True

    If ms_OmTcTyp = "PL" Then
      wCoCd = ctSelfCoCd
    ElseIf FraOrdCpy.Visible Then
      wCoCd = ADC("WOCoCd")
      If ADC("wCpyDmId") = "Y" Then mf_CpyDmId = True
    ElseIf FraStkCpy.Visible Then
        wCoCd = ADC("wDsCpyCocd")
     If ADC("wDsCpyDmId") = "Y" Then mf_CpyDmId = True
    Else
      wCoCd = ms_OmCoCd
    End If
  
  mf_CpyDmId = IIF(ms_OmTc = "JPO" Or ms_OmTc = "JSO", False, mf_CpyDmId)
   If Not mf_CopyModeStartedByParent Then
  GrdOrdDsg.StartServerCopy (True)
  End If
  Dim ijk As Integer
  ijk = 0 '6.1b-31
  With GrdOrdDsg
      mf_ShowDsg = False
   '   GrdOrdDsg.StartCopy
      wErrMsg = ""
   
   Do While Not (pv_rsSrcOd.EOF Or pv_rsSrcOd.BOF)
         OrdDsgWhenForCpy
      If pv_rsSrcOd!IdDmSz = "" Then _
        wDmDefSz = moCn.GetFldVal("Select DmDefSz from DsgMst where DmTcTyp= 'DM' and DmCd= '" + pv_rsSrcOd!IdDmCd + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "'")
        
        'SRIDOUBT
        mf_CpyFrSameCust = IIF(moCn.GetFldVal("Select OdOmCmCd From InvDsg Join OrdDsg On IdCoCd=OdCoCd And IdExpOdTc=OdTc And IdExpOdYy=OdYy And IdExpOdChr=OdChr And IdExpOdNo=OdNo And IdExpOdSr=OdSr " + _
                                      " Where IdCoCd='" + IIF(ms_OmTcTyp = "PL", gs_CoCd, wCoCd) + "' And IdTc='" + pv_rsSrcOd!IdTc + "' And IdYy='" + pv_rsSrcOd!IdYy + "' " + _
                                      " And IdChr='" + pv_rsSrcOd!IdChr + "' And IdNo=" + CStr(pv_rsSrcOd!IdNo) + " and IdSr=" + CStr(pv_rsSrcOd!IdSr) + "  and IdPrtKey='" + ctCurrPrtn + "'") = ADC("OmCmCd"), True, False)
           
      ijk = ijk + 1 '6.1b-31
      UpdateEmrProcess "OrdDsg Copy In Progress...Row: " + CStr(m_icunt)  '6.1b-31
      
      If ADC.Mode = xCopy Then
        wi_OdRow = .Rows - 1
      
        SetParamsVal pv_rsSrcOd!IdDmCd, woddmcd
        SetParamsVal pv_rsSrcOd!IdSfx, wOdSfx
        If mb_UpdPDCMAddingNewDesign Then
          SetParamsVal "", wOdDmSz
        Else
          SetParamsVal IIF(pv_rsSrcOd!IdDmSz <> "", pv_rsSrcOd!IdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")), wOdDmSz
        End If
      End If
         mf_CpySalPrc = False
      If (Not mf_MrpChr) And mf_CpyVal = True And mf_CpyRate = True And ms_CpyRateCd = "GPSLDCXM" And mf_CpyLabRate = True Then
         mf_CpySalPrc = True
      End If
      If mf_MrpChr Then
        mf_CpySalPrc = False
      End If
      
      If ms_OmTcTyp = "QT" Then
          SetParamsVal "", wOdByy
          SetParamsVal "", wOdBChr
          SetParamsVal 0, wOdBNo
    '      SetParamsVal "", wod wOdBagNo
      End If
      
'      .Value(wi_OdRow, "OdPrdSeq") = moCn.GetFldVal("Select hDmPrdSeq from Head Where " + _
                                       "HCoCd = '" + ms_OmCoCd + "' and HCd= '" + ctSelfCmCd + "'")
      '6.1B-3 if omline blank it takes line from head
      If ADC("OmLine") <> "" Then
        SetParamsVal ADC("OmLine"), wOdLine
      Else
        SetParamsVal moCn.GetFldVal("Select hLine from Head Where " + _
                                         "HCoCd = '" + ms_OmCoCd + "' and HCd= '" + ctSelfCmCd + "'"), wOdLine
      End If
      
      'WAS GS_COCD - SRITEMP
      ws_OrdStr = "Select * from OrdDsg Where " + _
                  " OdCoCd = '" + IIF(ms_OmTcTyp = "PL", pv_rsSrcOd!IdCoCd, pv_rsSrcOd!IdCoCd) + "' and OdTc='" + pv_rsSrcOd!IdExpOdTc + "' And " + _
                  " OdYy='" + pv_rsSrcOd!IdExpOdYy + "' And OdChr='" + pv_rsSrcOd!IdExpOdChr + "' And " + _
                  " OdNo=" + CStr(pv_rsSrcOd!IdExpOdNo) + " And OdSr=" + CStr(pv_rsSrcOd!IdExpOdSr)
                  
      Set wo_rsExpOrd = moCn.OpenRes(ws_OrdStr)
      
      SetParamsVal wo_rsExpOrd!OdDmCol, wOdDmCol
      If mb_UpdPDCM Then
        SetParamsVal 1, wOdDmCol
      Else
        SetParamsVal pv_rsSrcOd!IdQty, wOdOrdEnt
      End If
      
      '*** Jay 3.4(FG)
      If mb_UpdPDCM Then
        SetParamsVal 1, wOdPrdEnt
      Else
        SetParamsVal IIF(ms_OmTcTyp = "FG", 0, pv_rsSrcOd!IdQty), wOdPrdEnt
      End If
      Dim wOdDmStkNum As String
      Dim wOdDmStkNumArr() As String
      If ms_OmTcTyp = ctJtTcTyp Then
         If Not FraStkCpy.Visible Then
            SetParamsVal 0, wOdPrdEnt
            If mf_CpyDmId Then
              wOdDmStkNum = moCn.GetFldVal("Select max( IfFdByy+'/'+ IfFdBChr+'/'+ltrim(str(IfFdBNo))) From InvFgd where IfCoCd='" + pv_rsSrcOd!IdCoCd + "' and IfTc='" + pv_rsSrcOd!IdTc + "' And " + _
                                                                                " IfYy='" + pv_rsSrcOd!IdYy + "' And IfChr='" + pv_rsSrcOd!IdChr + "' And " + _
                                                                                " IfNo=" + CStr(pv_rsSrcOd!IdNo) + " And IfSr=" + CStr(pv_rsSrcOd!IdSr))
              wOdDmStkNumArr() = Split(wOdDmStkNum, "/")
              SetParamsVal pv_rsSrcOd!IdCoCd, woddmstkcocd
              SetParamsVal wOdDmStkNumArr(0), woddmstkyy
              SetParamsVal wOdDmStkNumArr(1), woddmstkchr
              SetParamsVal wOdDmStkNumArr(2), woddmstkno
            End If
          Else
            SetParamsVal 0, wOdPrdEnt
            SetParamsVal pv_rsSrcOd!qTargetVchQty, wOdOrdEnt
            If mf_CpyDmId Then
              'wOdDmStkNum = moCn.GetFldVal("Select max( IfFdByy+'/'+ IfFdBChr+'/'+ltrim(str(IfFdBNo))) From InvFgd where IfCoCd='" + pv_rsSrcOd!IdCoCd + "' and IfTc='" + pv_rsSrcOd!IdTc + "' And " + _
                                                                                " IfYy='" + pv_rsSrcOd!IdYy + "' And IfChr='" + pv_rsSrcOd!IdChr + "' And " + _
                                                                                " IfNo=" + CStr(pv_rsSrcOd!IdNo) + " And IfSr=" + CStr(pv_rsSrcOd!IdSr))
              'wOdDmStkNumArr() = Split(wOdDmStkNum, "/")
              SetParamsVal pv_rsSrcOd!IfCoCd, woddmstkcocd
              SetParamsVal pv_rsSrcOd!IfFdBYy, woddmstkyy
              SetParamsVal pv_rsSrcOd!IfFdBChr, woddmstkchr
              SetParamsVal pv_rsSrcOd!IfFdBNo, woddmstkno
            End If
          End If
        End If
        
'        setparamsval wOdBaseVchSr ,""
        SetParamsVal wOdRefIdKey, 0
        If FraStkCpy.Visible Then
            If (ADC("WDSCPYAUTOMAP") = "Y" Or ADC("WDSCPYBASEVCH") = "Y") Then
            'mf_CpyFrBase And InStr(1, "," + mBaseTc + ",", "," + ADC("wDsCpyTc") + ",") >= 1 Then
              SetParamsVal GetOdIdKey(pv_rsSrcOd!qBaseRefVch), wOdBaseIdKey
        Else
            SetParamsVal 0, wOdBaseIdKey
        End If
      End If
      ' HF.7(adding JSO)
      SetParamsVal IIF(ms_OmTcTyp = "JT" Or ADC("wOmTc") = "JPO" Or ADC("wOmTc") = "JSO", wo_rsExpOrd!OdPONo, Params(wOdPoNo)), wOdPoNo
      SetParamsVal IIF(ADC("wCpyChgPtrOnStwYN") <> "", ADC("wCpyChgPtrOnStwYN"), "Y"), wOdChgPtrOnStwYN
      'vk.19 copying sub cust values
      'HF.7(adding JSO)
      SetParamsVal IIF(ms_OmTcTyp = "JT" Or ADC("wOmTc") = "JPO" Or ADC("wOmTc") = "JSO", wo_rsExpOrd!OdSubCust, Params(wOdSubCust)), wOdSubCust
      '6.1b-19 if subcust value is balnk then copy from omsubcust
      If Params(wOdSubCust) = "" Then SetParamsVal ADC("OmSubCust"), wOdSubCust

      If mf_CpyRate = True Then
        SetParamsVal wo_rsExpOrd!OdMulBy, wOdMulBy
        SetParamsVal wo_rsExpOrd!OdMrpMulBy, wOdMrpMulBy
        SetParamsVal pv_rsSrcOd!IdFixPrc, wOdFixPrc
        SetParamsVal pv_rsSrcOd!IdGldAs, wOdGldAs
        SetParamsVal wo_rsExpOrd!OdIwtEqOrd, wOdIWtEqOrd
        SetParamsVal wo_rsExpOrd!OdIwtFrOrd, wOdIWtFrOrd
        SetParamsVal wo_rsExpOrd!OdIGldRtEqOrd, wOdIGldRtEqOrd
        SetParamsVal ADC("OmILabWtFrOrd"), wOdILabWtFrOrd

        'If mf_CpyLabRate = True And mf_CpyVal = True Then
          '.Value(wi_OdRow, "OdCalcPrc") = (pv_rsSrcOd!IdIFob / pv_rsSrcOd!IdQty)
          ' ***** Manali 3.03 - Cst Rt/Val always from Current
          '.Value(wi_OdRow, "OdCstPrc") = (pv_rsSrcOd!IdIFob / pv_rsSrcOd!IdQty)
        'End If
        
        If mf_CpySalPrc = True Then SetParamsVal (pv_rsSrcOd!IdIFob / pv_rsSrcOd!IdQty), wOdSalPrc
        If mf_CpyVal = True Then SetParamsVal (pv_rsSrcOd!IdIGldAsWt / pv_rsSrcOd!IdQty), wOdGldAsWt
        
      End If
      SetParamsVal ADC("OmInvAllBags"), wOdInvAllBags

      If mf_CpyLabRate = True Then
        SetParamsVal pv_rsSrcOd!IdLabAs, wOdLabAs
        If mf_CpyVal = True Then SetParamsVal (pv_rsSrcOd!IdILabAsWt / pv_rsSrcOd!IdQty), wOdLabAsWt
      End If
      
      If mf_CpyFrSameCust = True Then
        SetParamsVal wo_rsExpOrd!OdCmPrdInst, wOdCmPrdInst
        SetParamsVal wo_rsExpOrd!OdCmStmpInst, wOdCmStmpInst
      Else
        SetParamsVal wo_rsExpOrd!OdDmPrdInst, wOdCmPrdInst
      End If
      
      SetParamsVal pv_rsSrcOd!IdVaCtg, wOdVaCtg
      SetParamsVal pv_rsSrcOd!IdKt, wOdKt
      SetParamsVal wo_rsExpOrd!OdBagPcs, wOdBagPcs
      SetParamsVal wo_rsExpOrd!OdSalRem, wOdSalRem
      SetParamsVal ADC("OmHCtCd"), wOdOmCtCd
      SetParamsVal IIF(ms_OmTcTyp = "PL", "N", ""), wOdCrmFixPrcYN
      SetParamsVal wo_rsExpOrd!OdPicNm, wOdPicNm
            
       ws_OdWh = moCn.GetFldVal(" Select (case when sum(OrWsQty)> 0 and sum(OrHsQty)= 0 then 'W' " + _
