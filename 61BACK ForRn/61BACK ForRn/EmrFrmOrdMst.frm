Private Function GetDCRmVal(ByVal ws_IdName As String, Optional wRmCtg As String, Optional wSubLogic As String, Optional wOrMainMetRmCtg As String, Optional wOrCS As String) As Double
  
  Dim wf_RmVal As Double, wi_i As Integer, ws_RmCtg As String, wChnLabAs As String, ws_RmCd As String
  Dim wb_CustRm As Boolean
  wf_RmVal = 0
  If ADC("wChnCustYn") = "Y" Then
    wChnLabAs = "," + moCn.GetFldVal("Select hChnSubCtgForLab from Head where hCoCd = 'ZZZ'") + ","        '************Bhavna for chain labour gold wt calc
  Else
    wChnLabAs = ""
  End If
  For wi_i = 1 To GrdOrdRm.Rows - 1
    ws_RmCtg = GrdOrdRm.Value(wi_i, "OrRmCtg")
    ws_RmCd = GrdOrdRm.Value(wi_i, "OrRmCd")
    If moCn.RecSeek("Select 'x' from CustMst where CmCtg='C' and CmCd = (select RmCmCd from RmMst where RmCd = '" + ws_RmCd + "')") Then
        wb_CustRm = True
    Else
        wb_CustRm = False
    End If
    If wRmCtg <> "" Then
      If wRmCtg = "CHN" And ADC("wChnCustYn") = "Y" And (InStr(1, wChnLabAs, "," + GrdOrdRm.Value(wi_i, "OrRmSCtg") + ",") <> 0) And Not (GrdOrdRm.IsDel(wi_i)) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      ElseIf wRmCtg = ctCDWLMCd And ws_RmCtg = "D" And Not (GrdOrdRm.IsDel(wi_i)) Then
        If wSubLogic = "C" And GrdOrdRm.Value(wi_i, "OrSubShp") = "C" Then
          wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
        ElseIf wSubLogic = "-" Then
          wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
        ElseIf wSubLogic = "NC" And GrdOrdRm.Value(wi_i, "OrSubShp") <> "C" Then
          wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
        End If
      ElseIf ws_RmCtg = wRmCtg And Not (GrdOrdRm.IsDel(wi_i)) And (Not mb_CHCDHCOnCustRm Or wb_CustRm) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      ElseIf wRmCtg = ctGHCLMCd And wSubLogic = "K" And (GrdOrdRm.Value(wi_i, "OrRmCtg") = wOrMainMetRmCtg And InStr(1, wChnLabAs, "," + GrdOrdRm.Value(wi_i, "OrRmSCtg") + ",") = 0) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      ElseIf wRmCtg = ctGHCLMCd And wSubLogic = "P" And (GrdOrdRm.Value(wi_i, "OrRmCtg") = wOrMainMetRmCtg And InStr(1, wChnLabAs, "," + GrdOrdRm.Value(wi_i, "OrRmSCtg") + ",") = 0) Then
        If GrdOrdRm.Value(wi_i, "OrMainMet") = "Y" Then
          wf_RmVal = wf_RmVal + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdGldAsWt")
        Else
          wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, "OrWt")
        End If
      End If
    Else
      If (ws_RmCtg = "C" Or ws_RmCtg = "D") And Not (GrdOrdRm.IsDel(wi_i)) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      End If
    End If
  Next wi_i
  If wRmCtg = ctGHCLMCd And wSubLogic = "P" Then
    wf_RmVal = wf_RmVal * GetOrRmCtgMainMetVal(wOrCS)
  End If
  GetDCRmVal = wf_RmVal
  '*** (Jen 2.12)
End Function

