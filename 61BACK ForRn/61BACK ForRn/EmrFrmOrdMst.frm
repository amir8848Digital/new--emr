        '****** Sachin 3.02 - Current Partition
          Set wo_rsSrcOCT = moCn.OpenRes("Select DctCd as qOctCd, DctSz as qOctSz, DctChr as qOctCtChr, " + _
                          "DctParts as qOctParts, IsNull(OtRmCd, DctRmCd) as qOctRmCd, RmCtg, RmSpGrav, DctRmCd as qOldRmCd, " + _
                          "DctDmCol as qOctDmCol, DctRmWt as qOctRmWt, DctDc as qOctDc, " + _
                          "DctPrdSeq as qOctPrdSeq, DctMainPrtYn as qOctMainPrtYn, DctDesc as qOctDesc " + _
                          "from DsgCT Join RmMst on RmCd= DctRmCd and RmPrtKey=DctPrtKey " + ws_OctRmCdStr + " " + _
                          "where DctTcTyp= '" + ms_DmTcTyp + "' and " + _
                          "DctDmCd= '" + pv_rsSrcOd!OdDmCd + "' and DctDmSz= '" + pv_rsSrcOd!OdDmSz + "' and DctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "DctPrtKey") + _
                          "Order By DctSr, DctChr")
        Else
          '*** JAY 3.1.0_1 [Comp Cpy from DsgMst]
          '****** Sachin 3.02 - Current Partition
          ' ****** Manali 3.03 - Ct Cpy open for "QT"
          If pv_rsSrcOd!OdTc <> "SO" And pv_rsSrcOd!OdTc <> "PL" And pv_rsSrcOd!OdTc <> "QT" Then
              Set wo_rsSrcOCT = moCn.OpenRes("Select DctCd as qOctCd, DctSz as qOctSz, DctChr as qOctCtChr, " + _
                          "DctParts as qOctParts, IsNull(OtRmCd, DctRmCd) as qOctRmCd, RmCtg, RmSpGrav, DctRmCd as qOldRmCd, " + _
                          "DctDmCol as qOctDmCol, DctRmWt as qOctRmWt, DctDc as qOctDc, " + _
                          "DctPrdSeq as qOctPrdSeq, DctMainPrtYn as qOctMainPrtYn, DctDesc as qOctDesc " + _
                          "from DsgCT join RmMst on RmCd= DctRmCd and RmPrtKey=DctPrtKey " + ws_OctRmCdStr + " " + _
                          "where DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = '" + pv_rsSrcOd!OdDmCd + "' and " + _
                          "DctDmSz = IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "' ),'') and DctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "DctPrtKey"))
          '*** JAY 3.1.0_1 [Comp Cpy from DsgMst]
          Else
            '*** Jay 2.14Next *** [Multiple Comp in One BCHR]
            '****** Sachin 3.02 - Current Partition
            Set wo_rsSrcOCT = moCn.OpenRes("Select OctCd as qOctCd, OctSz as qOctSz, OctCtChr as qOctCtChr, OctParts as qOctParts, " + _
                          "IsNull(OtRmCd, OctRmCd) as qOctRmCd, RmCtg, RmSpGrav, OctRmCd as qOldRmCd, " + _
                          "OctDmCol as qOctDmCol, OctRmWt as qOctRmWt, OctDc as qOctDc,  " + _
                          "OctPrdSeq as qOctPrdSeq, OctMainPrtYn as qOctMainPrtYn, OctDesc as qOctDesc " + _
                          "from OrdCT join RmMst on RmCd= OctRmCd and RmPrtKey=OctPrtKey " + ws_OctRmCdStr + " " + _
                          "where OctCoCd= '" + IIF(pv_CpyBags = True, ms_OmCoCd, wCoCd) + "' and OctTc='" + pv_rsSrcOd!OdTc + "' and " + _
                          "OctYy= '" + pv_rsSrcOd!OdYy + "' and OctChr='" + pv_rsSrcOd!OdChr + "' and " + _
                          "OctNo= " + CStr(pv_rsSrcOd!OdNo) + " and OctSr=" + CStr(pv_rsSrcOd!OdSr) + " and OctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OctPrtKey") + _
                          " Order By OctSrNo, OctCtChr")
          End If
          '*** Jay 2.14Next *** [Multiple Comp in One BCHR]
        '*** Jay 2.13(CT) *** (NEW CT)
        End If
        
        With GrdOrdCT
          GrdOrdCT.StartCopy
            CpyOCTWithGrd wo_rsSrcOCT
          GrdOrdCT.EndCopy
        End With
      End If
NextOd:
      mf_StopRecalcDuringCopySetting = False
      If pv_CpyXl = True Then
        If mi_xlSalPrc > 0 Then
         If Not mf_MrpChr Then .Value(wi_OdRow, "OdSalPrc") = mi_xlSalPrc
         If Not .SaveRec(wi_OdRow) Then
             wErrMsg = wErrMsg + vbCrLf + "DesignCd/Sfx/Sz : " + pv_rsSrcOd!OdDmCd + "/" + _
                                                         pv_rsSrcOd!OdSfx + "/" + _
                                                         IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                                         " Message : " + Err.Description + ":" + gs_ErrMsg

             MsgBox "System encountered an error while copying -" + wErrMsg
             GoTo chek2
         End If
        End If
      End If
      '****** Sachin 3.3.0
      If mf_CpyRtByStk = True Then
        Call SetDsgPrc(wi_OdRow, VtCalc)
        If Not mf_MrpChr Then .Value(wi_OdRow, "OdSalPrc") = .Value(wi_OdRow, "OdCalcPrc")
        If Not .SaveRec(wi_OdRow) Then GoTo chek2
      End If
      '****** Sachin 3.3.0
chek2:
      pv_rsSrcOd.MoveNext
      wErrMsg = ""
'      MWLib.RunningProcess "Done w OrdDsg Row: " + CStr(ijk)
      TrackStatus ("Done w OrdDsg of Row: " + CStr(ijk) + ":" + CStr(Now))
    Loop
EndCopy:
    mf_StopRecalcDuringCopySetting = False
    wi_Cnt = 0: wi_TotCnt = 0                   '4.1.3.0
  'Indigo.81
    If Not mf_CopyModeStartedByParent Then  '6.1-91 changed because of Procedure too large
      GrdOrdDsg.EndCopy
      MWLib.EndProcess Me
      EndEmrProcess Me
    End If
    mf_ShowDsg = True
    If wErrInCpyMsg <> "" Then MsgBox (wErrInCpyMsg)
    Set pv_rsSrcOd = Nothing
    Set wo_rsSrcORm = Nothing
    Set wo_rsSrcOl = Nothing
  End With
End Sub

Private Sub CpyOCTWithGrd(wo_rsSrcOCT As MDORowSet)
  Dim wi_OCTRow As Integer
  Dim wOldSpGrav As Single
  Dim wNewSpGrav As Single
  With GrdOrdCT

  Do While Not (wo_rsSrcOCT.EOF Or wo_rsSrcOCT.BOF)
  
            .AddItem
            wi_OCTRow = .Rows - 1
            .Value(wi_OCTRow, "OctSrNo") = wi_OCTRow          '*** Jay 2.14Next ***
            .Value(wi_OCTRow, "OctCd") = wo_rsSrcOCT!qOctCd
            .Value(wi_OCTRow, "OctSz") = wo_rsSrcOCT!qOctSz
            .Value(wi_OCTRow, "OctCtChr") = wo_rsSrcOCT!qOctCtChr
            .Value(wi_OCTRow, "OctParts") = wo_rsSrcOCT!qOctParts
            .Value(wi_OCTRow, "OctRmCd") = wo_rsSrcOCT!qOctRmCd
            .Value(wi_OCTRow, "OctDmCol") = wo_rsSrcOCT!qOctDmCol
            
            ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
            If (UCase(Trim(wo_rsSrcOCT!RmCtg)) = "G" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "P" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "S" _
              Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "L") And wo_rsSrcOCT!qOldRmCd <> wo_rsSrcOCT!qOctRmCd Then
                wOldSpGrav = wo_rsSrcOCT!RmSpGrav
                '****** Sachin 3.02 - Current Partition
                wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + wo_rsSrcOCT!qOctRmCd + "' and RmPrtKey=" + IIF(1 = 2, "'" + ctCurrPrtn + "'", "RmPrtKey"))
                .Value(wi_OCTRow, "OctRmWt") = MWLib.Div(wo_rsSrcOCT!qOctRmWt * wNewSpGrav, wOldSpGrav)
            Else
               .Value(wi_OCTRow, "OctRmWt") = wo_rsSrcOCT!qOctRmWt
            End If
           
            .Value(wi_OCTRow, "OctDc") = wo_rsSrcOCT!qOctDc
            .Value(wi_OCTRow, "OctPrdSeq") = wo_rsSrcOCT!qOctPrdSeq
            .Value(wi_OCTRow, "OctMainPrtYn") = wo_rsSrcOCT!qOctMainPrtYn
            .Value(wi_OCTRow, "OctDesc") = wo_rsSrcOCT!qOctDesc
            
            .Value(wi_OCTRow, "OctPrtKey") = ADC("OmPrtKey")    '****** Sachin 3.02 - Partition Key value
            
            If .SaveRec(wi_OCTRow) = False Then
              .DelAllRecs
              Exit Do
            End If
            wo_rsSrcOCT.MoveNext
          Loop
  End With
End Sub

Private Sub ADC_Load()
    m_rdEx = False
    Set m_ObjCmd = ADC.Connection.OpenQuery("InsOrderCpy")
    Set m_objCmdRm = ADC.Connection.OpenQuery("InsOrdRm")
    Set m_objCmdLab = ADC.Connection.OpenQuery("InsOrdLab")
    Set m_objCmdCT = ADC.Connection.OpenQuery("InsOrdCT")  'new
    Set m_ObjCmdGetRmRt = ADC.Connection.OpenQuery("ForCpy_GetRmRt")
    Set m_ObjCmdGetLabRt = ADC.Connection.OpenQuery("ForCpy_GetLabRt")
