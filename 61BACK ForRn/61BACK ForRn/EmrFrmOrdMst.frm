                        .Value(wi_L, "OlCstVal") = GetLabVal(ADC("OmCmCd"), .Value(wi_L, "OlMCd"), _
                                                  .Value(wi_L, "OlSCd"), .Value(wi_L, "OlCstRt"), _
                                                  .Value(wi_L, "OlQty"), GrdOrdDsg.Value(GrdOrdDsg.Row, "WODPERPCCSWT"), _
                                                  .Value(wi_L, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
