Private Sub ReadRfId()
  On Error GoTo ErrH
  Dim wRfIdNoArr() As String, wRfIdStr As String
  Dim i As Integer, wVbNo As Integer
  Dim wRsBag As MDORowSet
  Dim wRfIdNo As String
  Dim wCoCdNo As String
  
  ms_ErrMsg = ""
  ms_RfIdStr = ""
  
  wRfIdStr = ""

  If UCase(ADC.MenuCd) = UCase("Quot") Then
    wRfIdStr = ADC("wOrdRfIdStr")
  ElseIf UCase(ADC.MenuCd) = UCase("QB") Then
    wRfIdStr = ADC("wCbRfIdStr")
  End If
    wRfIdStr = PrepareRfIdString(wRfIdStr)
  If wRfIdStr <> "" Then
    wRfIdNoArr = Split(wRfIdStr, ",")

    If Left(wRfIdStr, 1) = "," Or Right(wRfIdStr, 1) = "," Then
        ms_ErrMsg = "Invalid Tag Input"
        DispMsg ms_ErrMsg, etError: Exit Sub
    End If
    wRfIdStr = ""
    For i = 0 To UBound(wRfIdNoArr)
      wRfIdNo = wRfIdNoArr(i)
      If Not IsNumeric(wRfIdNo) Then ms_ErrMsg = "Invalid Bag Alias No.": DispMsg ms_ErrMsg, etError: Exit Sub
      If Not moCn.RecSeek("Select 'x' from RfIdMst Where RimNo=" + wRfIdNo + " ") Then
        ms_ErrMsg = "Bag Alias No. Not Defined"
        DispMsg ms_ErrMsg, etError: Exit Sub
      End If
      wRfIdStr = wRfIdStr + IIF(wRfIdStr = "", "", ",") + wRfIdNo
    Next

    Set wRsBag = moCn.OpenRes("Select * From RfIdMst Where RimNo in (" + wRfIdStr + ") ")

    If UCase(ms_OmTcTyp) = UCase("QB") Then
      If moCn.GetFldVal("Select Count('x') From RfIdMst " + _
                        "Join Bag On RimBCoCd=BCoCd and RimBYy=BYy and RimBChr=BChr and RimBNo=BNo " + _
                        "Where RimNo in (" + wRfIdStr + ") and BLoc = '" + ctFgLoc + "' And BPrtKey='" + ctCurrPrtn + "' " + _
                        "and RimBCoCd='" + ms_OmCoCd + "' ") <> UBound(wRfIdNoArr) + 1 Then
          ms_ErrMsg = "Invalid Bag/ Bag Not in FG/Bag From Other Company Code"
          DispMsg ms_ErrMsg, etError: Exit Sub
      End If


      If MsgBox(Str(UBound(wRfIdNoArr) + 1) + " Bags Found. Do you want to Continue? ", vbYesNo) = vbNo Then
        ms_ErrMsg = "Copy Cancelled": DispMsg ms_ErrMsg, etError: Exit Sub
      End If
    ElseIf UCase(ms_OmTcTyp) = UCase("QT") Then
    '4.1.3.0
    'sv.71 old design exclusive check not necessary and removed
    'IIF(ms_OmTcTyp = "JT" Or ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                     "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmCmGrp= 'Y' and " + _
                     "(Select CmGrp from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) = '" + ms_CmGrp + "' ) or " + _
                     " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                     " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ")
    If moCn.GetFldVal(" Select Count('x') from RfIdMst " + _
                     " Join DsgMst Dm on DmTcTyp= '" + ms_DmTcTyp + "' and DmCd = RimDmCd and DmSz= '' " + _
                     " where DmPrtKey='" + ctCurrPrtn + "' and DmHld = 'N' and DmValidYn='Y' " + _
                     " And Not Exists (Select 'x' from DsgMst Pm " + _
                     " Join (Select DctCd, DctSz from DsgCt where  DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = Dm.DmCd and " + _
                     " DctDmSz = '' and DctPrtKey=Dm.DmPrtKey) CT " + _
                     " On Pm.DmCd = DctCd and Pm.DmSz= DctSz  " + _
                     " where Pm.DmTcTyp = 'PM' and Pm.DmHld = 'Y' and Pm.DmPrtKey=Dm.DmPrtKey) " + _
                     " and RimNo in (" + wRfIdStr + ") ") <> UBound(wRfIdNoArr) + 1 Then
            ms_ErrMsg = "Invalid Dsg/Component On Hold Or Exclusive For Another Cust/ Regn"
            DispMsg ms_ErrMsg, etError: Exit Sub
      End If
      If MsgBox(Str(UBound(wRfIdNoArr) + 1) + " Designs Found. Do you want to Continue? ", vbYesNo) = vbNo Then
        ms_ErrMsg = "Copy Cancelled": DispMsg ms_ErrMsg, etError: Exit Sub
      End If

    End If

    ms_RfIdStr = wRfIdStr
  Else
    ms_ErrMsg = "No Tags Read"
    ms_RfIdStr = ""
    DispMsg ms_ErrMsg, etError: Exit Sub
  End If
  
Exit Sub

ErrH:
ms_RfIdStr = ""
ms_ErrMsg = Err.Description
DispMsg Err.Description, etError
End Sub
Private Function FillRmRecs(pfilename As String) As MDORowSet
    Const wRmShtNo As Integer = 2
    Dim wRsRm As New MDORowSet, i As Integer, wTblNm As String
    On Error GoTo ErrHdlr
    If Not OpenExcelFile(pfilename) Then DispMsg "Improper File Format", etError: Exit Function
    If ChkSheet(wRmShtNo) = False Then DispMsg "RM WorkSheet does not Exist in the specified Excel File", etError: CloseExcel: Exit Function
    moCn.CreateTmpTable "#TmpXlRm", "Select 0 as qSr, Space(20) as qCrCd, OrRmCtg as qRmCtg, OrRmSCtg as qRmSCtg, OrRmCd as qRmCd, OrLn1 qSvLn, OrLn2 as qBrdth,OrLn3 as qDpth,OrQty qQty, " + _
                        " OrRmPtr as qPtr,OrWt as qWt,OrSalRt as qSalRt,OrSalVal as qSalVal, OrSetSCd as qSetCd,OrSetSalRt as qSetRt,OrSetSalVal as qSetVal,OrMainMet as qMainMet " + _
                        " Into #TmpXlRm From CustRm Where 1=2"
    i = 2
    Do While IsNumeric(ReadCell(wRmShtNo, i, 1))
       moCn.Execute ("Insert Into #TmpXlRm Values ('" + ReadCell(wRmShtNo, i, 1) + "','" + _
                                                        ReadCell(wRmShtNo, i, 2) + "','" + _
                                                        Left(Trim(ReadCell(wRmShtNo, i, 3)), 20) + "','" + _
                                                        ReadCell(wRmShtNo, i, 4) + "','" + _
                                                        ReadCell(wRmShtNo, i, 5) + "','" + _
                                                        ReadCell(wRmShtNo, i, 6) + "','" + _
                                                        ReadCell(wRmShtNo, i, 7) + "','" + _
                                                        ReadCell(wRmShtNo, i, 8) + "','" + _
                                                        ReadCell(wRmShtNo, i, 9) + "','" + _
                                                        ReadCell(wRmShtNo, i, 10) + "','" + _
                                                        ReadCell(wRmShtNo, i, 11) + "','" + _
                                                        ReadCell(wRmShtNo, i, 12) + "','" + _
                                                        ReadCell(wRmShtNo, i, 13) + "','" + _
                                                        ReadCell(wRmShtNo, i, 14) + "','" + _
                                                        ReadCell(wRmShtNo, i, 15) + "','" + _
                                                        ReadCell(wRmShtNo, i, 16) + "','" + _
                                                        ReadCell(wRmShtNo, i, 17) + "')")
    
    i = i + 1
    Loop
    CloseExcel
    Set wRsRm = moCn.OpenRes("Select * From #TmpXlRm")
    Exit Function
ErrHdlr:
    'Debug.Print Err.Description
End Function

Private Sub OrdCpyRmSumm(ByVal pv_DsgOrdSumm As String)
'Private Sub OrdCpyRmSumm()
  '*** Procedure to show the Entire Order Rm Summary in the Summary Frame
  Dim wo_rsOrdRmSumm As MwfLib.MDORowSet, wi_Row As Integer, ws_SQL As String
  If pv_DsgOrdSumm = ctDsgSumm Then
  ws_SQL = CpyRmSummSql(ctDsgSumm)
  GrdOrdDsgTgt.Rows = 1
  If ws_SQL = "" Then DispMsg "Invalid GroupBy option", etInfo: Exit Sub
  Set wo_rsOrdRmSumm = moCn.OpenRes(ws_SQL)
  
