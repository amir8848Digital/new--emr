Private Sub RecalcForCpy_GrdOrdLab(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String, pRsRmRows As MDORowSet)
  
   Dim wLabAsStr As String
   Dim wCstLabAsWt As Single
          
  With GrdOrdLab
    Select Case ColName
      Case Is = UCase("OlSalRt")
        Dim ws_OlQw As String
        Dim wLabAsWt As Single
        ws_OlQw = ""
        If (Not mf_InCopyFromServer And .Mode = fgmnorm) Or ((.Mode = fgmCopy Or mf_InCopyFromServer) And mf_CpyLabRate = False) Then
          If ParamsLab(wOlSalRt) < 0 And UCase(SourceColName) <> UCase("OlMCd") And _
             UCase(SourceColName) <> UCase("OlSCd") And ParamsLab(wOlQw) = "Q" Then Exit Sub
          If ParamsLab(wOlMcd) = ctDHCLMCd Then
            wLabAsWt = Params(qOdPerPcDiaWt)
          ElseIf ParamsLab(wOlMcd) = ctGHCLMCd Then
            wLabAsWt = Params(qOdPerPcDiaWt)
            
          ElseIf ParamsLab(wOlMcd) = ctCHCLMCd Then
            wLabAsWt = Params(qOdPerPcCsWt)
          ElseIf ParamsLab(wOlMcd) = ctCDWLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                ParamsLab(wOlMcd) + "' and " + _
                                "PSCd='" + ParamsLab(wOlScd) + "'")) = "W" Then
            wLabAsWt = GetDCRmVal("OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(ParamsLab(wOlMcd), ParamsLab(wOlScd)))
          ElseIf ParamsLab(wOlMcd) = ctCDWLMCd And _
            (moCn.GetFldVal("Select PValue from Param " + _
                                "where PTyp='LABSCD' and PMCd= '" + _
                                ParamsLab(wOlMcd) + "' and " + _
                                "PSCd='" + ParamsLab(wOlScd) + "'")) = "Q" Then
            wLabAsWt = 0#
          Else
            wLabAsWt = Params(wOdLabAsWt)
          End If
          SetParamsValLab GetLabRt(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                      ParamsLab(wOlScd), "S", _
                                      wLabAsWt, ADC("OmCmCtg"), ws_OlQw, , , ADC("OmCmCurCd"), _
                                      IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wOlSalRt
                                      
          If ws_OlQw <> "" Then
            SetParamsValLab ws_OlQw, wOlQw
          Else
            SetParamsValLab moCn.GetFldVal("select PValue from Param where PTyp= 'LABSCD' and PMCd= '" + ParamsLab(wOlMcd) + "' and PSCd= '" + ParamsLab(wOlScd) + "'"), wOlQw
          End If
          '6.1-35  ParamsLab(wOlMcd) = ctCDWLMCd removed to get original qty
          If ParamsLab(wOlQty) = 0 Or ParamsLab(wOlMcd) = ctBrkLMCd Or ParamsLab(wOlMcd) = ctDHCLMCd _
              Or ParamsLab(wOlMcd) = ctCHCLMCd Or ParamsLab(wOlMcd) = ctCDWLMCd Then SetParamsValLab 1, wOlQty
        End If
      Case Is = UCase("OlSalVal")
        If (Not mf_InCopyFromServer And .Mode = fgmnorm) Or ((.Mode = fgmCopy Or mf_InCopyFromServer) And mf_CpyLabRate = False) Then
          If ParamsLab(wOlMcd) = ctBrkLMCd Then
             SetParamsValLab ParamsLab(wOlSalRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrSalVal"), wOlSalVal
          ElseIf ParamsLab(wOlMcd) = ctDHCLMCd Then
             SetParamsValLab ParamsLab(wOlSalRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrSalVal", "D"), wOlSalVal
          ElseIf ParamsLab(wOlMcd) = ctGHCLMCd Then
             SetParamsValLab ParamsLab(wOlSalRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrSalVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, ParamsLab(wOlScd)), Params(qOdMainMetRmCtg), "S"), wOlSalVal
          ElseIf ParamsLab(wOlMcd) = ctCHCLMCd Then
             SetParamsValLab ParamsLab(wOlSalRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrSalVal", "C"), wOlSalVal
          ElseIf ParamsLab(wOlMcd) = ctCDWLMCd And ParamsLab(wOlQw) = "W" Then                     ' Diamond certification charges
            SetParamsValLab GetLabVal(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                          ParamsLab(wOlScd), ParamsLab(wOlSalRt), _
                                          ParamsLab(wOlQty), ForCpy_GetDCRmVal(pRsRmRows, "OrWt", ctCDWLMCd, GetLaborSubCdLabLogic(ParamsLab(wOlMcd), ParamsLab(wOlScd))), _
                                          ParamsLab(wOlQw), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wOlSalVal
          '6.1-35 CDW for Q is added
          ElseIf ParamsLab(wOlMcd) = ctCDWLMCd And ParamsLab(wOlQw) = "Q" Then                     ' Diamond certification charges
            SetParamsValLab GetLabVal(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                          ParamsLab(wOlScd), ParamsLab(wOlSalRt), _
                                          ParamsLab(wOlQty), 0, _
                                          ParamsLab(wOlQw), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wOlSalVal
                                          
          ElseIf ParamsLab(wOlMcd) = "CHN" And ADC("wChnCustYn") = "Y" Then
             SetParamsValLab ParamsLab(wOlSalRt) * ForCpy_GetDCRmVal(pRsRmRows, "OrWt", "CHN"), wOlSalVal
          
          ElseIf ParamsLab(wOlSalRt) < 0 Then
            SetParamsValLab ParamsLab(wOlSalRt) * ParamsLab(wOlQty), wOlSalVal
          Else
             SetParamsValLab GetLabVal(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                          ParamsLab(wOlScd), ParamsLab(wOlSalRt), _
                                          ParamsLab(wOlQty), Params(wOdLabAsWt), _
                                          ParamsLab(wOlQw), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wOlSalVal
          End If
        End If
      Case Is = UCase("OlCstRt")
        Dim wsOlCstQw As String
        wsOlCstQw = "Q"
        
        If (Not mf_InCopyFromServer And .Mode = fgmnorm) Or (.Mode = fgmCopy Or mf_InCopyFromServer) Then
           wCstLabAsWt = Params(qOdCstLabAsWt)
              
             SetParamsValLab GetLabRt(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                         ParamsLab(wOlScd), "C", _
                                         Params(qOdCstLabAsWt), ADC("OmCmCtg"), wsOlCstQw, , , ADC("OmCmCurCd")), wOlCstRt
          If wsOlCstQw <> "" Then
             SetParamsValLab wsOlCstQw, wOlCstQw
          Else
            SetParamsValLab moCn.GetFldVal("select PValue from Param where PTyp= 'LABSCD' and PMCd= '" + ParamsLab(wOlMcd) + "' and PSCd= '" + ParamsLab(wOlScd) + "'"), wOlCstQw
          End If
          If ParamsLab(wOlQty) = 0 Then SetParamsValLab 1, wOlQty
        End If
      Case Is = UCase("OlCstVal")
        If (Not mf_InCopyFromServer And .Mode = fgmnorm) Or (.Mode = fgmCopy Or mf_InCopyFromServer) Then
          If ParamsLab(wOlMcd) = ctBrkLMCd Then
             SetParamsValLab ParamsLab(wOlCstRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrCstVal"), wolcstval
          ElseIf ParamsLab(wOlMcd) = ctDHCLMCd Then
             SetParamsValLab ParamsLab(wOlCstRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrCstVal", "D"), wolcstval
          ElseIf ParamsLab(wOlMcd) = ctGHCLMCd Then
             SetParamsValLab ParamsLab(wOlCstRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrCstVal", ctGHCLMCd, GetLaborSubCdLabLogic(ctGHCLMCd, ParamsLab(wOlScd)), Params(qOdMainMetRmCtg), "C"), wolcstval
          ElseIf ParamsLab(wOlMcd) = ctCHCLMCd Then
             SetParamsValLab ParamsLab(wOlCstRt) / 100 * ForCpy_GetDCRmVal(pRsRmRows, "OrCstVal", "C"), wolcstval
          ElseIf ParamsLab(wOlMcd) = ctCDWLMCd And ParamsLab(wOlQw) = "W" Then
            SetParamsValLab GetLabVal(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                          ParamsLab(wOlScd), ParamsLab(wOlCstRt), _
                                          ParamsLab(wOlQty), GetDCRmVal("OrWt", ctCDWLMCd), _
                                          ParamsLab(wOlQw), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wolcstval
          ElseIf ParamsLab(wOlMcd) = "CHN" And ADC("wChnCustYn") = "Y" Then
             SetParamsValLab ParamsLab(wOlCstRt) * ForCpy_GetDCRmVal(pRsRmRows, "OrWt", "CHN"), wolcstval
          Else
            wCstLabAsWt = Params(wOdLabAsWt)
            If InStr(1, wLabAsStr, ",D,") <> 0 Or InStr(1, wLabAsStr, ",C,") <> 0 Or InStr(1, wLabAsStr, ",X,") <> 0 Then wCstLabAsWt = GetCstLabAsWt(GrdOrdDsg.Row)
             SetParamsValLab GetLabVal(ADC("OmCmCd"), ParamsLab(wOlMcd), _
                                          ParamsLab(wOlScd), CDbl(ParamsLab(wOlCstRt)), _
                                          ParamsLab(wOlQty), wCstLabAsWt, _
                                          ParamsLab(wOlCstQw), "C", ADC("OmCmCtg"), ADC("OmCmCurCd")), wolcstval
          End If
        End If
    End Select
  End With
End Sub














