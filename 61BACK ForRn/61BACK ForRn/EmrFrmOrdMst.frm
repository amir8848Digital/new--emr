  '*** (Bef 2.06)
  'wSetCdCnd = ""
  'wSetCdCnd = IIF(ADC("wDsgSetCdFr") = "", "", " and Dr1.DrSetSCd>= '" + ADC("wDsgSetCdFr") + "' ")
  'wSetCdCnd = wSetCdCnd + IIF(ADC("wDsgSetCdTo") = "", "", " and Dr1.DrSetSCd<= '" + ADC("wDsgSetCdTo") + "' ")
  'wCnd = wCnd + IIF(wSetCdCnd = "", "", " and exists(Select 'x' From DsgRm Dr1 where Dr1.DrTcTyp= DmTcTyp and Dr1.DrCd= DmCd and Dr1.DrSz= DmSz and DrRmCtg in ('C', 'D') " + wSetCdCnd + ")")
  '*** (Bef 2.06)
 
  If UCase(ADC("wDsgDiaWtFr")) > 0 Then wHaveCnd = wHaveCnd + " Having convert(decimal(16, 3), Sum (DrWt* (case when DrRmCtg in ('D') then 1 else 0 end))) >= " & ADC("wDsgDiaWtFr")
  If UCase(ADC("wDsgDiaWtTo")) > 0 Then wHaveCnd = wHaveCnd + IIF(wHaveCnd <> "", " and ", " Having ") + " convert(decimal(16, 3), Sum (DrWt* (case when DrRmCtg in ('D') then 1 else 0 end))) <=" & ADC("wDsgDiaWtTo")
  If UCase(ADC("wDsgColWtFr")) > 0 Then wHaveCnd = wHaveCnd + " Having convert(decimal(16, 3), Sum (DrWt* (case when DrRmCtg in ('C') then 1 else 0 end))) >= " & ADC("wDsgColWtFr")
  If UCase(ADC("wDsgColWtTo")) > 0 Then wHaveCnd = wHaveCnd + IIF(wHaveCnd <> "", " and ", " Having ") + " convert(decimal(16, 3), Sum (DrWt* (case when DrRmCtg in ('C') then 1 else 0 end))) <=" & ADC("wDsgColWtTo")
  If UCase(ADC("wDsgGrsWtFr")) > 0 Then wHaveCnd = wHaveCnd + IIF(wHaveCnd <> "", " and ", " Having ") + " convert(decimal(16, 3), Sum (DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end))) >= " & ADC("wDsgGrsWtFr")
  If UCase(ADC("wDsgGrsWtTo")) > 0 Then wHaveCnd = wHaveCnd + IIF(wHaveCnd <> "", " and ", " Having ") + " convert(decimal(16, 3), Sum (DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end))) <=" & ADC("wDsgGrsWtTo")
  
  'If UCase(ADC("wDsgDCWtFr")) > 0 Then wHaveCnd = wHaveCnd + " Having Sum (DrWt* (case when DrRmCtg in ('C', 'D') then 1 else 0 end)) >= " & ADC("wDsgDCWtFr")
  'If UCase(ADC("wDsgDCWtTo")) > 0 Then wHaveCnd = wHaveCnd + IIf(wHaveCnd <> "", " and ", " Having ") + " Sum (DrWt* (case when DrRmCtg in ('C', 'D') then 1 else 0 end)) <=" & ADC("wDsgDCWtTo")
  'If UCase(ADC("wDsgGrsWtFr")) > 0 Then wHaveCnd = wHaveCnd + IIf(wHaveCnd <> "", " and ", " Having ") + " Sum (DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end)) >= " & ADC("wDsgGrsWtFr")
  'If UCase(ADC("wDsgGrsWtTo")) > 0 Then wHaveCnd = wHaveCnd + IIf(wHaveCnd <> "", " and ", " Having ") + " Sum (DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end)) <=" & ADC("wDsgGrsWtTo")
  
  i = 1
  If GrdDsgAnaSel.Rows > 1 Then
    wDsgAnaCnd = " And (Select Count(*) From OrdScop " + _
                 "Join DsgAna on DaAnaSr = OsSr " + _
                 "where (DaAnaCd between OsDaAnaCdFr and OsDaAnaCdTo) and " + IIF(gs_Partition = ctCurrPrtn, " DaPrtKey=DmPrtKey and ", "") + _
                 "DaTcTyp = DmTcTyp and DaCd = DmCd and DaSz = DmSz and " + _
                 "OsCoCd = '" + ms_OmCoCd + "' and OsTc = '" + ADC("OmTc") + "' and " + _
                 "OsYy = '" + ADC("OmYy") + "' and OsChr = '" + ADC("OmChr") + "' " + _
                 "and OsNo = " + CStr(ADC("OmNo")) + ") = " & (GrdDsgAnaSel.Rows - 1) & " "
  End If
    
  '****** Sachin 3.01 - Custom Views ******
  wRunDsg = " And " + IIF(ADC("wRunDsg") = "N", " Not ", "") + " Exists (Select 'x' From OrdDsg Where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey=DmPrtKey and ", "") + " OdTc= 'SO' And OdDmCd= DmCd And OdDmSz= DmSz) "
  '*** (Jen 3.01 09/06/07)
  wOrdQty = " And Exists(Select 'x' From OrdDsg Where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey=DmPrtKey and ", "") + " OdTc= 'SO' And OdDmCd= DmCd Group By OdDmCd Having " + IIF(ADC("wOdQtyFr") <> 0, " convert (int, Sum(OdOrdQty))>= " + CStr(ADC("wOdQtyFr")), "") + IIF(ADC("wOdQtyTo") <> 0, IIF(ADC("wOdQtyFr") <> 0, " and ", "") + " convert (int, Sum(OdOrdQty))<= " + CStr(ADC("wOdQtyTo")), "") + ")"
  wOrdQty = IIF(ADC("wOdQtyFr") <> 0 Or ADC("wOdQtyTo") <> 0, wOrdQty, "")
  
  ws_InvCnd = IIF(ADC("wExpQtyFr") <> 0, " convert (int, Sum(IdQty))>= " + CStr(ADC("wExpQtyFr")), "")
  ws_InvCnd = ws_InvCnd + IIF(ws_InvCnd = "", "", IIF(ADC("wExpQtyTo") = 0, "", " and ")) + IIF(ADC("wExpQtyTo") <> 0, " convert (int, Sum(IdQty))<= " + CStr(ADC("wExpQtyTo")) + " ", "")
  ws_InvCnd = ws_InvCnd + IIF(ws_InvCnd = "", "", IIF(ADC("wInvFobFr") = 0, "", " and ")) + IIF(ADC("wInvFobFr") <> 0, " convert (decimal (14, 2), Sum(IdIFob))>= " + Format(ADC("wInvFobFr"), "0.00") + " ", "")
  ws_InvCnd = ws_InvCnd + IIF(ws_InvCnd = "", "", IIF(ADC("wInvFobTo") = 0, "", " and ")) + IIF(ADC("wInvFobTo") <> 0, " convert (decimal (14, 2), Sum(IdIFob))<= " + Format(ADC("wInvFobTo"), "0.00") + " ", "")
  ws_InvCnd = IIF(ws_InvCnd = "", "", " Having " + ws_InvCnd)
  '*** (Jen 3.01 09/06/07)
  '****** Sachin 3.01 - Custom Views ******
    
  '****** (Jen 11/06/07) added DmSz= '' in the condition & removed DmSz from Group By
  '****** Sachin 3.3.0 (27-06-08) - [37. Design Exclusive for Multiple Customers] ******
  ' **** Manali 3.5.0 - 08/11/08 - [Best-Seller Dsg Qty] added
  ' ***** Manali Trading Module - Cust/Region Exc Check skipped for OmCmCtg='S'
  '*********Bhavna added DmSrcDsgCd
  'sv.71 old design exclusive check not necessary and removed
  'IIF(ms_OmTcTyp = "JT" Or ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                               "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmCmGrp= 'Y' and " + _
                               "(Select CmGrp from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) = '" + ms_CmGrp + "' ) or " + _
                               " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                               " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ")
  wsql = " Select max(DmCtg) as DmCtg, max(DmPrdCtg) as DmPrdCtg, " + _
                               " max(DmSalCtg) as DmSalCtg, max(DmSalCtg2) as DmSalCtg2, max(DmSalCtg3) as DmSalCtg3, Max(DmPrtKey) as DmPrtKey, " + _
                               " DmCd, max(DmSrcDsgCd) as DmSrcDsgCd, /* DmSz, */ " + _
                               " Sum(IsNull(DrWt* (case when DrRmCtg in ('C', 'D') then 1 else 0 end), 0)) as qDrDCWt, " + _
                               " Sum(IsNull(DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end), 0)) as qDrGrsWt, " + _
                               " 0.00 as qBsQty " + _
                               " from DsgMst Dm " + _
                               " Left Outer Join DsgRm Dr on DmIdNo=DrDmIdNo And DmTcTyp = DrTcTyp and DmCd = DrCd and DmSz = DrSz and DmPrtKey=DrPrtKey /* and DrRmCtg in ('D','C') */ " + _
                               " where DmTcTyp = '" + ms_DmTcTyp + "' and DmSz= '' and DmPrtKey='" + ADC("OmPrtKey") + "' " + _
                               " and DmHld = 'N' and DmValidYN='Y' " + _
                               " and not exists (Select 'x' from DsgCt where DctTcTyp= '" + ms_DmTcTyp + "' " + _
                               "  and DctDmCd = Dm.DmCd and  DctDmSz = '' and DctPrtKey=Dm.DmPrtKey /*Dm.DmSz */ " + _
                               "  and exists(Select 'x' from DsgMst C where C.DmTcTyp = 'PM' and C.DmCd = DctCd " + _
                               "  and C.DmSz= DctSz and C.DmPrtKey=DctPrtKey and C.DmHld = 'Y')) " + _
                               wCnd + wDsgAnaCnd + IIF(ADC("wRunDsg") <> "", wRunDsg, "") + wOrdQty + _
                               " Group by DmCd /*, DmSz */ " + wHaveCnd
  '****** Sachin 3.3.0 (27-06-08) - [37. Design Exclusive for Multiple Customers] ******
  '****** (Jen 11/06/07) added DmSz= '' in the condition & removed DmSz from Group By
    
  '*** (Bef 3.01)
  'Set wRsDsgSel = moCn.OpenRes("Select max(DmCtg) as DmCtg, max(DmPrdCtg) as DmPrdCtg, " + _
  '                             "max(DmSalCtg) as DmSalCtg, " + _
  '                             "DmCd, Max(DmPrdCtg) as DmPrdCtg, Max(DmSalCtg) As DmSalCtg, " + _
  '                             "Sum(IsNull(DrWt* (case when DrRmCtg in ('C', 'D') then 1 else 0 end), 0)) as qDrDCWt, " + _
  '                             "Sum(IsNull(DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end), 0)) as qDrGrsWt from DsgMst " + _
  '                             "Left Outer Join DsgRm Dr on DmTcTyp = DrTcTyp and DmCd = DrCd and DmSz = DrSz /* and DrRmCtg in ('D','C') */ " + _
  '                             "where DmTcTyp = '" + ms_DmTcTyp + "' and DmSz = '' " + _
  '                             "and DmHld = 'N' and " + _
  '                             "(DmCmCd= '' or DmCmCd= '" + ADC("OmCmCd") + "' or " + _
  '                             "(DmCmCd<> '" + ADC("OmCmCd") + "' and DmRegnExc= 'Y' and " + _
  '                             "(Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= DmCmCd) <> '" + ms_CmRegnCd + "')) " + _
  '                             wCnd + wDsgAnaCnd + _
  '                             " Group by DmCd, DmSz " + wHaveCnd + " " + _
  '                             " Order By DmCtg, DmCd")
  '*** (Bef 3.01)
                              
  '****** Sachin 3.01 - Custom Views ******
  ' ***** Manali 3.10.0 - 10/03/12 - Customer in QT- Sel Dsg Scope
  If (ADC("wBSYy") <> "" And ADC("wBSQv") <> "") Or ws_InvCnd <> "" Or ADC("wDsgCust") <> "" Then
    '****** (Jen 3.01 11/06/07)
    ' **** Manali 3.5.0 - 08/11/08 - [Best-Seller Dsg Qty] added
    ' ***** Manali 3.10.0 - 10/03/12 - Customer in QT- Sel Dsg Scope
    wsql = " Select Top 200 max(DmCtg) as DmCtg, max(DmPrdCtg) as DmPrdCtg, max(DmSalCtg) as DmSalCtg, " + _
           " DmCd, max(DmSrcDsgCd) as DmSrcDsgCd,  " + IIF(ADC("wBSYy") = "", "", " Sum(IsNull(" + IIF(ADC("wBSQv") = "N", "IdIFob", "IdQty") + ",0)) as TotFld, ") + _
           " Max(qDrDCWt) as qDrDCWt, max(qDrGrsWt) as qDrGrsWt, Sum(IsNull(IdQty, 0)) as qBsQty  " + _
           " From ( " + _
           wsql + ") qDsg Join InvDsg On " + IIF(gs_Partition = ctCurrPrtn, " IdPrtKey=DmPrtKey and ", "") + " IdDmCd= DmCd " + _
           " Where IdTc= 'IN' " + IIF(ADC("wBSYy") = "", "", " And IdYy= '" + ADC("wBSYy") + "' ") + _
           IIF(ADC("wDsgCust") = "", "", " And IdExpCmCd= '" + ADC("wDsgCust") + "' ") + _
           " Group By DmCd " + ws_InvCnd + _
           " Order By " + IIF(ADC("wBSYy") = "", "", "TotFld Desc, ") + " DmCd "
    '****** (Jen 3.01 11/06/07)
    '****** (Jen 3.01 11/06/07)
  Else
    wsql = wsql + " Order By DmCtg, DmCd /*, DmSz */ "
  End If
  Set wRsDsgSel = moCn.OpenRes(wsql)
  '****** Sachin 3.01 - Custom Views ******
  
                              
  'If wRsDsgSel.RecCount > 200 Then DispMsg "More Than 200 Records, Please Reduce The Scope.", etError: Exit Sub
  If mf_QuotSelCnt = False Then
    If wRsDsgSel.RecCount > 200 Then DispMsg CStr(wRsDsgSel.RecCount) + " Records Selected, Please Reduce The Scope OR Click ""Show Designs"" Again to Continue.", etError: mf_QuotSelCnt = True: Exit Sub
  End If
  If wRsDsgSel.RecCount > 0 Then
    wRsDsgSel.MoveFirst
  Else
    DispMsg "No Designs Exist In The Given Scope, Please Change The Scope", etWarning
  End If
  
  GrdDsgSel.Rows = 1
  With GrdDsgSel
    GrdDsgSel.StartCopy
    Do While Not (wRsDsgSel.EOF Or wRsDsgSel.BOF)
      .AddItem
      i = .Rows - 1
      .Value(i, "wDmSr") = i
      .Value(i, "wDmCtg") = wRsDsgSel!DmCtg
      .Value(i, "wDmCd") = wRsDsgSel!DmCd
      .Value(i, "wDmSrcDsgCd") = wRsDsgSel!DmSrcDsgCd   '************Bhavna added source sketch/Dsg Cd
      .Value(i, "wDmSel") = "Y"
      .Value(i, "wDmPrdCtg") = wRsDsgSel!DmPrdCtg
      .Value(i, "wDmSalCtg") = wRsDsgSel!DmSalCtg
      .Value(i, "wDmSalCtg2") = wRsDsgSel!DmSalCtg2
      .Value(i, "wDmSalCtg3") = wRsDsgSel!DmSalCtg3
      .Value(i, "wDmDCWt") = wRsDsgSel!qDrDCWt
      .Value(i, "wDmGrsWt") = wRsDsgSel!qDrGrsWt
      .Value(i, "wDmBsQty") = wRsDsgSel!qBsQty    ' **** Manali 3.5.0 - 08/11/08 - [Best-Seller Dsg Qty] added
      wRsDsgSel.MoveNext
    Loop
    GrdDsgSel.EndCopy
  End With
  
  If GrdDsgSel.Rows - 1 > 0 Then
    ADC("wDsgDmPrdCtg") = GrdDsgSel.Value(1, "wDmPrdCtg")
    ADC("wDsgDmSalCtg") = GrdDsgSel.Value(1, "wDmSalCtg")
    ADC("wDsgDmSalCtg2") = GrdDsgSel.Value(1, "wDmSalCtg2")
    ADC("wDsgDmSalCtg3") = GrdDsgSel.Value(1, "wDmSalCtg3")
    ADC("wDsgDCWt") = GrdDsgSel.Value(1, "wDmDCWt")
    ADC("wDsgGrsWt") = GrdDsgSel.Value(1, "wDmGrsWt")
    ADC("wDsgSrcDsgCd") = GrdDsgSel.Value(1, "wDmSrcDsgCd")
    '''ADC("wBsQty") = GrdDsgSel.Value(1, "wDmBsQty")    ' **** Manali 3.5.0 - 08/11/08 - [Best-Seller Dsg Qty] added
  End If
  
  ADC("wDsgDmCtgFr").CmpStr = ""
  ADC("wDsgDmCtgTo").CmpStr = ""
  ADC("wDsgDmPrdCtgFr").CmpStr = ""
  ADC("wDsgDmPrdCtgTo").CmpStr = ""
  ADC("wDsgDmSalCtgFr").CmpStr = ""
  ADC("wDsgDmSalCtgTo").CmpStr = ""
  ADC("wDsgDmCdFr").CmpStr = ""
  ADC("wDsgDmCdTo").CmpStr = ""
  ADC("wDsgSrcDsgCdFr").CmpStr = ""
  ADC("wDsgSrcDsgCdTo").CmpStr = ""
  ADC("wDsgSetCdFr").CmpStr = ""
  ADC("wDsgSetCdTo").CmpStr = ""
  
  CmdDsgMkQuot.Enabled = True
End Sub
