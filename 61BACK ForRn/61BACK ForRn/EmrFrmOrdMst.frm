                          "DctParts as qOctParts, IsNull(OtRmCd, DctRmCd) as qOctRmCd, RmCtg, RmSpGrav, DctRmCd as qOldRmCd, " + _
                          "DctDmCol as qOctDmCol, DctRmWt as qOctRmWt, DctDc as qOctDc, " + _
                          "DctPrdSeq as qOctPrdSeq, DctMainPrtYn as qOctMainPrtYn, DctDesc as qOctDesc " + _
                          "from DsgCT join RmMst on RmCd= DctRmCd and RmPrtKey=DctPrtKey " + ws_OctRmCdStr + " " + _
                          "where DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = '" + pv_rsSrcOd!OdDmCd + "' and " + _
                          "DctDmSz = IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "' ),'') and DctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "DctPrtKey"))
          Else
            Set wo_rsSrcOCT = moCn.OpenRes("Select OctCd as qOctCd, OctSz as qOctSz, OctCtChr as qOctCtChr, OctParts as qOctParts, " + _
                          "IsNull(OtRmCd, OctRmCd) as qOctRmCd, RmCtg, RmSpGrav, OctRmCd as qOldRmCd, " + _
                          "OctDmCol as qOctDmCol, OctRmWt as qOctRmWt, OctDc as qOctDc,  " + _
                          "OctPrdSeq as qOctPrdSeq, OctMainPrtYn as qOctMainPrtYn, OctDesc as qOctDesc " + _
                          "from OrdCT join RmMst on RmCd= OctRmCd and RmPrtKey=OctPrtKey " + ws_OctRmCdStr + " " + _
                          "where OctCoCd= '" + IIF(pv_CpyBags = True, ms_OmCoCd, wCoCd) + "' and OctTc='" + pv_rsSrcOd!OdTc + "' and " + _
                          "OctYy= '" + pv_rsSrcOd!OdYy + "' and OctChr='" + pv_rsSrcOd!OdChr + "' and " + _
                          "OctNo= " + CStr(pv_rsSrcOd!OdNo) + " and OctSr=" + CStr(pv_rsSrcOd!OdSr) + " and OctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OctPrtKey") + _
                          " Order By OctSrNo, OctCtChr")
          End If
        End If
        
        OrdCTWhenForCpy wOdSrCopied  'new
        Dim wOctSrNoSeed As Long
        wOctSrNoSeed = 0
        wOldSpGrav = 0: wNewSpGrav = 0
        With GrdOrdCT
          GrdOrdCT.StartCopy
            'CpyOCT wo_rsSrcOCT, wOdSrCopied, ws_ErrMsg
            'new
          Do While Not (wo_rsSrcOCT.EOF Or wo_rsSrcOCT.BOF)
            wOctSrNoSeed = wOctSrNoSeed + 1
            SetParamsValCT wOctSrNoSeed, wOctSrNo
            SetParamsValCT wo_rsSrcOCT!qOctCd, wOctCd
            SetParamsValCT wo_rsSrcOCT!qOctSz, wOctSz
            SetParamsValCT wo_rsSrcOCT!qOctCtChr, wOctCtChr
            SetParamsValCT wo_rsSrcOCT!qOctParts, wOctParts
            SetParamsValCT wo_rsSrcOCT!qOctRmCd, wOctRmCd
            SetParamsValCT wo_rsSrcOCT!qOctDmCol, wOctDmCol
            
            ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
            If (UCase(Trim(wo_rsSrcOCT!RmCtg)) = "G" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "P" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "S" _
              Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "L") And wo_rsSrcOCT!qOldRmCd <> wo_rsSrcOCT!qOctRmCd Then
                wOldSpGrav = wo_rsSrcOCT!RmSpGrav
                '****** Sachin 3.02 - Current Partition
                wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + wo_rsSrcOCT!qOctRmCd + "' and RmPrtKey=" + IIF(1 = 2, "'" + ctCurrPrtn + "'", "RmPrtKey"))
                SetParamsValCT MWLib.Div(wo_rsSrcOCT!qOctRmWt * wNewSpGrav, wOldSpGrav), wOctRmWt
            Else
                SetParamsValCT wo_rsSrcOCT!qOctRmWt, wOctRmWt
            End If
           
            SetParamsValCT wo_rsSrcOCT!qOctDc, wOctDc
            SetParamsValCT wo_rsSrcOCT!qOctPrdSeq, wOctPrdSeq
            SetParamsValCT wo_rsSrcOCT!qOctMainPrtYn, wOctMainPrtYn
            SetParamsValCT wo_rsSrcOCT!qOctDesc, wOctDesc
            
            wb_Errinsrvrcpy = Not InsOrdCTCpy(wOdSrCopied, ws_ErrMsg)
            If wb_Errinsrvrcpy Then
              ws_errInSrvrCpyLvl = "C-2"
              wErrMsg = wErrMsg + "Order CT update error:" + "CTCode:" + ParamsCT(wOctCd) + " " + ws_ErrMsg
              GoTo NextOd
            End If
            wo_rsSrcOCT.MoveNext
          Loop
  
          GrdOrdCT.EndCopy
        End With
      End If
      If _
         ( _
              (mf_CpyVal = False Or mf_CpyRate = False Or _
              (mf_CpyRate = True And ms_CpyRateCd <> "GPSLDCXM") Or mf_CpyLabRate = False)) _
         Then

          SetParamsVal md_ForCpyOdCalcPrc, wOdCalcPrc
      End If
      SetParamsVal md_ForCpyOdCstPrc, wOdCstPrc
      
      Call ForCpy_GetOdMinMaxDiaTolWt
      Call ForCpy_CalcOdMrp
      
      If Not mf_MrpChr And Not mf_MRTChr Then
        If (mf_CpySalPrc = False) And ADC("OmLockSalPrcYN") = "N" Then
          SetParamsVal FnRndOff(Params(wOdCalcPrc) * Params(wOdMulBy), 2, _
                                    moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd= '" + ADC("OmCmCd") + "'")), wOdSalPrc
        End If
      Else
        If mf_MrpChr Then
          ForCpy_CalculateOdSalPrcFromMrp (0)
      End If
      End If

      
      mf_StopRecalcDuringCopySetting = False
      If pv_CpyXl = True Then
        If mi_xlSalPrc > 0 Then
         If Not mf_MrpChr Then SetParamsVal mi_xlSalPrc, wOdSalPrc
         End If
        End If
      
      If mf_CpyRtByStk = True Then
        SetParamsVal md_ForCpyOdCalcPrc, wOdCalcPrc
        
        If Not mf_MrpChr Then SetParamsVal Params(wOdCalcPrc), wOdSalPrc
      End If
      
      SetParamsVal Params(wOdOrdEnt), wOdOrdQty
      SetParamsVal Params(wOdPrdEnt), wOdPrdQty
      If ms_xlSz <> "" And pv_CpyXl = True Then
        SetParamsVal ms_xlSz, wOdDmSz
      End If
      
      SetParamsVal 2, qMode
         
         wb_Errinsrvrcpy = Not InsOrdCpy(ws_ErrMsg)
         
         If wb_Errinsrvrcpy Then
            wErrMsg = wErrMsg + " " + ws_ErrMsg

            ws_errInSrvrCpyLvl = "A-2"
            
            GoTo NextOd
          End If
NextOd:

chek2:
      If wb_Errinsrvrcpy Then
        If FraDsgCpy.Visible Or pv_CpyFrDsgMst = True Then
            wErrMsg = wErrMsg + "DesignCd/Sfx/Sz: " + pv_rsSrcOd!OdDmCd + "/" + _
                                                         pv_rsSrcOd!OdSfx + "/" + _
                                                         IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                                         " Message : " + ws_ErrMsg
        Else
            wErrMsg = wErrMsg + "Src: " + pv_rsSrcOd!OdCoCd + "/" + pv_rsSrcOd!OdTc + "/" + pv_rsSrcOd!OdChr + "/" + CStr(pv_rsSrcOd!OdNo) + "/" + CStr(pv_rsSrcOd!OdSr) + "/" + pv_rsSrcOd!OdDmCd + "/" + _
                                                         pv_rsSrcOd!OdSfx + "/" + _
                                                         IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, IIF(mb_CpyFrmHist = True, wDmDefSz, "")) + _
                                                         " " + ws_ErrMsg
        End If
        
'        If ws_errInSrvrCpyLvl <> "" Then
        'vws_errInSrvrCpyLvl = "C-1" Or ws_errInSrvrCpyLvl = "B-2" Or ws_errInSrvrCpyLvl = "A-2" Then
        DeleteProc
            Call CpyErrMsg(wErrMsg)
            ps_ErrMsg = ps_ErrMsg + " " + wErrMsg
            wErrMsg = ""
 '       End If
      End If
      
      pv_rsSrcOd.MoveNext

'      MWLib.RunningProcess "Done w OrdDsg Row: " + CStr(ijk)
'      TrackStatus ("Done w OrdDsg of Row: " + CStr(ijk) + ":" + CStr(Now))
      
     If Not mf_CopyModeStartedByParent Then
        m_icunt = m_icunt + 1
      End If
    Loop
    
EndCopy:

    mf_StopRecalcDuringCopySetting = False
    wi_Cnt = 0: wi_TotCnt = 0                   '4.1.3.0
    mf_ShowDsg = True
    If wErrMsg <> "" Then MsgBox ("Error copying details for the following" + wErrMsg)
    If Not mf_CopyModeStartedByParent Then
      GrdOrdDsg.EndServerCopy
      EndEmrProcess Me
      MWLib.EndProcess Me
    End If
    mf_InCopyFromServer = False
    Set pv_rsSrcOd = Nothing
    Set wo_rsSrcORm = Nothing
    Set wo_rsSrcOl = Nothing
  End With
End Sub
Private Sub DeleteProc()
            moCn.Execute ("Delete From OrdRm Where OrCoCd ='" + ms_OmCoCd + "' And " + _
                          " OrTc = '" + ADC("OmTc") + "' And OrYy = '" + ADC("OmYy") + "' And " + _
                          " OrChr = '" + ADC("OmChr") + "' And OrNo = " + CStr(ADC("OmNo")) + " And " + _
