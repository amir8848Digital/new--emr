                                                   "BCoCd = '" + wDmStkNumArr(0) + "' and BYy = '" + wDmStkNumArr(1) + _
                                                   "' and BChr ='" + wDmStkNumArr(2) + "' and BNo = " + CStr(wDmStkNumArr(3)) + "  and " + _
