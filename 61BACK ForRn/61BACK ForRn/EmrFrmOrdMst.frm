                                   "IdDmCd as DDmCd, IdSfx as DOdSfx, IdDmSz as DDmSz,(Select max(IfFdByy+'/'+ IfFdBChr+'/'+ltrim(str(IfFdBNo))) From InvFgd " + _
                                   "where IfCoCd=IdCoCd and IfTc=IdTc And " + _
                                                                            " IfYy=IdYy And IfChr=IdChr And IfNo=IdNo And IfSr=IdSr) as DDmStkNo, Convert(Decimal(14,1), IdQty) qStkQty, " + _
                                   "Convert(Decimal(14,2), IdIVal) OdSalPrc,IsNull((Select Sum(IrRmIWt/ (Case When IrRmCtg In ('D', 'C') Then 5 Else 1 End)) From InvRm " + _
