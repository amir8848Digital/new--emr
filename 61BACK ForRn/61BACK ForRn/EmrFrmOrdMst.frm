        ' row when doesnt fire and then all od fields are not getting initialized
        If .Row = .Rows Then
          .Row = 1
        End If
        .AddItem
        wi_OdRow = .Rows - 1
        GrdOrdDsg.Value(wi_OdRow, "OdSr") = IIF(pv_CpyXl = True And mi_xlOdSr > 0, mi_xlOdSr, GrdOrdDsg.Value(wi_OdRow, "OdSr"))
