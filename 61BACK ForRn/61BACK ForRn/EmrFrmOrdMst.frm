Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
  If Not (KeyCode = vbKeyP And Shift = 2) Then Exit Sub
      Dim wRowNum As Long
      Dim w3DPth As String, wHskPth  As String
      wRowNum = GrdOrdDsg.Row
      If (wRowNum > 0 And wRowNum <= GrdOrdDsg.Rows - 1) Then
        w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(wRowNum, "OdDmCd"), GrdOrdDsg.Value(wRowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(wRowNum, "OdSr"), GrdOrdDsg.Value(wRowNum, "OdPicNm"))
        wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(wRowNum, "OdDmCd"), GrdOrdDsg.Value(wRowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(wRowNum, "OdSr"), GrdOrdDsg.Value(wRowNum, "OdPicNm"))
