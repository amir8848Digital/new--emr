                     wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Design Sfx and Sz Combination Already Exist. "
            
       If ReadCell(ADC("WXLSHTNO"), i, 13) = "" Or Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 13)) Then Call SetCellVal(ADC("WXLSHTNO"), i, 13, "0")
       If ReadCell(ADC("WXLSHTNO"), i, 14) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 14, "01/01/80")
       If ReadCell(ADC("WXLSHTNO"), i, 15) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 15, "01/01/80")
         '6.1
       If ReadCell(ADC("WXLSHTNO"), i, 14) <> MWLib.EmptyDate Then _
             If moCn.GetFldVal("Select DateDiff(DAY,CONVERT(VARCHAR(8),'" + CStr(ADC("OmDt")) + "'," + CStr(DtFmtSlahVal()) + "),CONVERT(VARCHAR(8),'" + ReadCell(ADC("WXLSHTNO"), i, 14) + "'," + CStr(DtFmtSlahVal()) + "))") < 0 Then _
