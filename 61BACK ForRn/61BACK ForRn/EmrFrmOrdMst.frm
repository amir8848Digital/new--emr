      wi_Row = .Rows - 1
        .Value(wi_Row, "OTRMCTG") = wo_rsOrdRmSumm!OrRmCtg
        .Value(wi_Row, "OTRMSCTG") = wo_rsOrdRmSumm!OrRmSCtg
