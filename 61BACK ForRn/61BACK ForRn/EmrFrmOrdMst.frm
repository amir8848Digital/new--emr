     If ADC("wDsCpyDmId") = "Y" Then mf_CpyDmId = True
    Else
      wCoCd = ms_OmCoCd
    End If
  
  'If adc(" ") = "Y" Then mf_CpyDmId = True
  mf_CpyDmId = IIF(ms_OmTc = "JPO" Or ms_OmTc = "JSO", False, mf_CpyDmId)
  
  With GrdOrdDsg
      mf_ShowDsg = False
      GrdOrdDsg.StartCopy
      wErrMsg = ""
   Do While Not (pv_rsSrcOd.EOF Or pv_rsSrcOd.BOF)
      UpdateEmrProcess "CpyDets OrdDsg Copy In Progress...Row: " + CStr(m_icunt)
      
      If pv_rsSrcOd!IdDmSz = "" Then _
        wDmDefSz = moCn.GetFldVal("Select DmDefSz from DsgMst where DmTcTyp= 'DM' and DmCd= '" + pv_rsSrcOd!IdDmCd + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "'")
        
        'SRIDOUBT
        mf_CpyFrSameCust = IIF(moCn.GetFldVal("Select OdOmCmCd From InvDsg Join OrdDsg On IdCoCd=OdCoCd And IdExpOdTc=OdTc And IdExpOdYy=OdYy And IdExpOdChr=OdChr And IdExpOdNo=OdNo And IdExpOdSr=OdSr " + _
                                      " Where IdCoCd='" + IIF(ms_OmTcTyp = "PL", gs_CoCd, wCoCd) + "' And IdTc='" + pv_rsSrcOd!IdTc + "' And IdYy='" + pv_rsSrcOd!IdYy + "' " + _
                                      " And IdChr='" + pv_rsSrcOd!IdChr + "' And IdNo=" + CStr(pv_rsSrcOd!IdNo) + " and IdSr=" + CStr(pv_rsSrcOd!IdSr) + "  and IdPrtKey='" + ctCurrPrtn + "'") = ADC("OmCmCd"), True, False)
           
      
      If ADC.Mode = xCopy Then
        If .Row = .Rows Then
          .Row = 1
        End If
        
        Dim wDmAllowStr As String, ws_ErrMsg As String
        '578-12 calling DmAllow string and added to this code
