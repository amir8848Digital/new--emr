Private Sub CmdChgDtGo_Click()
    Dim wChgDt As String
    Dim wInLockDt As String
    Dim wInFutureDt As String
    On Error GoTo ErrH
    If gs_InNo <> 0 Then
      MsgBox "Invoice Header is open, please close and then use this option"
      Exit Sub
    End If
    
    If ADC("wNewDt") = "" Or ADC("wNewDt") = "01/01/80" Or ADC("wNewDt") = ADC("OmDt") Then
        DispMsg "Please enter a valid date/Date same as voucher date", etError
        Exit Sub
    End If

    If ADC("wnewdt") < CDate(ms_LockDt) Then DispMsg "New Date Cannot Be Less Than Lock Date", etError: Exit Sub
    If ADC("wnewdt") > CDate(ms_FutureDt) Then DispMsg "New Date Cannot Be Greater Than Future Date", etError: Exit Sub
    If ADC("wnewdt") <= CDate(ms_PurgeDt) Then DispMsg "New Date Cannot Be Less Than Or Equal To Purge Date", etError: Exit Sub
'    If moCn.GetFldVal("Select hHolChkYN From Head where HCd='ZSELF' and HCoCd='" + ms_OmCoCd + "'") = "Y" Then
        '53 company code added
'        If IsHOLYN(ADC("OmCoCd"), ADC("wnewdt")) Then Cancel = True: ErrMsg = "Date Cannot be Added on Holidays": Exit Sub
'    End If

    If Not moCn.RecSeek("Select * from InvHd where " + _
                  "InCoCd ='" + ADC("OmCoCd") + "' and InTc ='" + ADC("OmTc") + "' and InYy ='" + ADC("OmYy") + _
                  "' and InChr ='" + ADC("OmChr") + "' and InNo =" + CStr(ADC("OmNo"))) Then
        DispMsg "Invoice header is not yet open for this voucher.", etError
        Exit Sub
    End If

    Call GetLockDt(ADC("oMcOCD"), "TC", "IN", wInLockDt, wInFutureDt)

    If ADC("wNewDt") > CDate(wInFutureDt) Then
        DispMsg "New Date Cannot Be Greater Than Future Date limit set for Invoice", etError
        Exit Sub
      End If
    If ADC("wNewDt") < CDate(wInLockDt) Then
      DispMsg "Invoice Date Cannot Be Less Than Lock Date limit set for Invoice", etError
      Exit Sub
    End If
    GrdOrdDsg.StartCopy
    
    Dim wOldDt As Date
    wOldDt = ADC("OmDt")
    Dim wOldDelDt As Date
    wOldDelDt = ADC("OmDelDt")
    Dim wOldExpDelDt As Date
    wOldExpDelDt = ADC("OmExpDelDt")
    mb_ChgDt = True
    wChgDt = ADC("wNewDt")
    ADC("OmDt") = ADC("wNewDt")
    If ADC("OmDelDt") < ADC("OmDt") Then ADC("OmDelDt") = ADC("wNewDt")
    If ADC("OmExpDelDt") < ADC("OmDt") Then ADC("OmExpDelDt") = ADC("wNewDt")
    
    Dim wErrMsg As String
    Dim wf_SaveOrdMst As Boolean
    wf_SaveOrdMst = True
    If Not ADC.SaveRec Then
      wErrMsg = "Error saving OrderMst, see the error box for specific error details"
      wf_SaveOrdMst = False
      GoTo ErrH
    End If

    moCn.Execute ("Update OrdDsg set  OdOmDt='" + wChgDt + "' " + _
                  "," + " OdDelDt=case when OdDelDt<'" + wChgDt + "' then '" + wChgDt + "' else OdDelDt end " + _
                  "," + " OdExpDelDt=case when OdExpDelDt <'" + wChgDt + "' then '" + wChgDt + "' else OdExpDelDt end " + _
                  "where OdCoCd ='" + ADC("OmCoCd") + "' and OdTc ='" + ADC("OmTc") + "' and OdYy ='" + ADC("OmYy") + _
                  "' and OdChr ='" + ADC("OmChr") + "' and OdNo =" + CStr(ADC("OmNo")))


    'changing InvHd dates
    moCn.Execute ("Update InvHd set InDt='" + wChgDt + "',InPrnDt='" + wChgDt + "' " + _
                  "where InCoCd ='" + ADC("OmCoCd") + "' and InTc ='" + ADC("OmTc") + "' and InYy ='" + ADC("OmYy") + _
                  "' and InChr ='" + ADC("OmChr") + "' and InNo =" + CStr(ADC("OmNo")))
                    
    MsgBox "Date changed, please close and re-open the voucher"
   GrdOrdDsg.EndCopy
   Call DispFra(ChgDt)
   Exit Sub
ErrH:
   
   DispMsg wErrMsg + Err.Description, etError
   If wf_SaveOrdMst Then
      ADC("OmDt") = wOldDt
      ADC("OmExpDelDt") = wOldExpDelDt
      ADC("OmDelDt") = wOldDelDt
      ADC.SaveRec
   End If
   MsgBox "Error trying to update date" + wErrMsg + Err.Description
   Call DispFra(ChgDt)
   
End Sub

Private Sub CmdCpyBags_Click()

  '*** Display or hide the Refresh Rate frame depending on the toggle satate
  If mf_DtLocked = True Then DispMsg "Cannot Refresh Rates In Locked Entry", etError: Exit Sub
  
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If ADC("OmPrtKey") <> ctCurrPrtn And CDate(ms_PurgeDt) >= ADC("OmDt") Then DispMsg "Cannot Copy Bags In Previous Partition Orders/Orders Prior to Purge Date", etError: Exit Sub

  ' Zubin 213
  If ADC("OmCnvFct") = "0" Then DispMsg "Conversion Factor Should Be > 0", etError: Exit Sub
  If ADC("OmMulDiv") = "" Then DispMsg "Conversion Factor From Base Currency To Voucher Currency Not Defined In Date Table", etError: Exit Sub
  ' Zubin 213

  '****** Sachin 2.12 - 16/12/05 - Copy FG Bags in QB
  Dim wb_ValidCmCd As Boolean
  ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
  wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd = '" + ADC("OmCmCd") + "'")
  If wb_ValidCmCd = False Then DispMsg "Invalid " + mCmCtgName + " code", etError: Exit Sub
  
  ' **** Manali Trading Module
  If ms_OmTcTyp = ctJtTcTyp Then
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
      DispMsg "Invalid From Design Location", etError: Exit Sub
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ms_OmCoCd + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
      DispMsg "Invalid To Design Location", etError: Exit Sub
  End If

  If mf_DtLocked = True Then Exit Sub
  If RetMemExists = True Then Exit Sub    '*** (Jen 2.13)
  
  If FraCopyFGBags.Visible = False Then
      If GrdOrdDsg.HalfValidate Then
        GrdOrdDsg.SetFocus
        Exit Sub
      End If
      If ADC("wCbCpyFrmRfId") = "" Then ADC("wCbCpyFrmRfId") = "Y"
      If ADC("wCpyThruBagNo") = "" Then ADC("wCpyThruBagNo") = "N"    '****Bhavna added cpy thru bag no
  End If
      
  If ADC("WCPYBGQBWTEQORD") = "" Then ADC("WCPYBGQBWTEQORD") = "N"
      
  Call DispFra(CpyFgBags)
  '****** Sachin 2.12 - 16/12/05 - Copy FG Bags in QB

End Sub
