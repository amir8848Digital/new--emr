        .Value(wi_OdRow, "OdSfx") = IIF(pv_rsSrcOd!OdSfx = "" And pv_CpyXl = True, ms_xlSfx, pv_rsSrcOd!OdSfx)
        .Value(wi_OdRow, "OdDmSz") = IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, wDmDefSz) '*** Jay 3.2.0 [DefSz]
        .Row = wi_OdRow
        GrdOrdDsg.Col = 6   '*** Setting focus to the OdDmCd field
      End If
      ' setting here a special flag because if Adc.StartCopy Adc.EndCopy is done in StkVchCpy and not here then the flickering messagebox keeps coming
'      If mf_InStkVchCopy Then
 '       ADC.EndCopy
  '    End If

      
      wi_OdRow = .Row
      
      '4.1.3.0 - Sachin
