    If .IsNew(RowNum) Then
    
        .Store "OdOmIdNo", moCn.GetFldVal("Select OmIdNo From OrdMst " + _
                                          "Where OmCoCd='" + ms_OmCoCd + "' And OmTc='" + ADC("OmTc") + "' " + _
