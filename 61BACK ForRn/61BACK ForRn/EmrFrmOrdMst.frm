Private Function CpyRmSummSql(ByVal pv_DsgOrdSumm As String) As String
  Dim ws_OdQty As String, ws_HOdAmdQty As String, ws_CommStr As String, wf_Cancel As Boolean
  Dim ws_ErrMsg As String, ws_reqCnd As String, ws_reqIdName As String, ws_reqGrpBy As String
  Dim ws_rstg, wodcyctg As String
  If pv_DsgOrdSumm = ctDsgSumm Then
'    ws_reqCnd = " And OrSr =" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
'    ws_reqIdName = "wDsgRmGrp"
      ws_reqIdName = "WDSGCPYGRP"
      wodcyctg = ADC("WDSGCPYCTG")
  ElseIf pv_DsgOrdSumm = ctOrdSumm Then
      'ws_reqCnd = " And OrSr =" + adc("WFRODSR")
      'ws_reqCnd = " And OrSr >=" + adc("WFRODSR") + " And OrSr <=" + adc("WTOODSR")
      ws_reqIdName = "WORDCPYGRP"
      wodcyctg = ADC("WORDCPYCTG")
  End If
  Call ATXT_FldChange(99, ws_reqIdName, wf_Cancel, ws_ErrMsg, ADC(ws_reqIdName))
  If wf_Cancel = True Then
    DispMsg ws_ErrMsg, etError
    Exit Function
  End If
  Dim ii, nn As Integer
  'nn = Len(ADC("WORDCPYCTG"))
  nn = Len(wodcyctg)
  ws_rstg = ""
  If wodcyctg = "" Then
  ws_rstg = "G','P','S','L','M','X','D','C"
  Else
  For ii = 1 To nn
  'ws_rstg = ws_rstg + Mid(ADC("WORDCPYCTG"), ii, 1)
  ws_rstg = ws_rstg + Mid(wodcyctg, ii, 1)
  If ii <> nn Then
  ws_rstg = ws_rstg + "','"
  End If
  nn = nn + 1
  Next
  End If
  Text1.text = ws_rstg
  If pv_DsgOrdSumm = ctDsgSumm Then
    If ADC("wDsgSrNo") > 0 Then
          Select Case ADC(ws_reqIdName)
          Case Is = "-"
          ws_reqGrpBy = "OrRmCtg,OrRmSCtg"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, '*' as urngsz, '' as OrRmCd, "
          Case Is = "RMCOL"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg,RmCol"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  RmCol,  '*' as urngsz, '' as OrRmCd,"
          Case Is = "RMCOL-SZ"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg,RmCol,RrRngSz"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  RmCol, Isnull(RrRngSz,'') as urngsz,'' as OrRmCd,"
          Case Is = "RMCDSZ"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg,OrRmCd,RrRngSz"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  OrRmCd, Isnull(RrRngSz,'') as urngsz,'' as RmCol"
          
          Case Is = "RMRNGSZ"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg,  RrRngSz"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, Isnull(RrRngSz,'') as urngsz,'' as OrRmCd,"
          Case Is = "RMRT"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg,  OrSalRt"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg, OrSalRt as OrRmRt, '*' as RmCol, '*' as urngsz,'' as OrRmCd,"
          Case Is = "RMCDRT"
          ws_reqGrpBy = "OrRmCtg, OrRmSCtg, OrRmCd, OrSalRt"
          CpyRmSummSql = "Select OrRmCtg, OrRmSCtg, OrRmCd, OrSalRt as OrRmRt, '*' as RmCol, '*' as urngsz,"
          
          Case Else
          DispMsg "No Grouping Flds defined in system for selected GroupBy value", etError
          Exit Function
          End Select
   
   
   ws_CommStr = "IsNull(sum(OrQty),0) as Qty " + _
              "from OrdRm " + _
              " Join RmMst on RmCtg=OrRmCtg and RmSCtg=OrRmSCtg And RmCd =OrRmCd " + _
              " Left outer Join RmRt on RrTcTyp ='RSZ' and RrCtg=OrRmCtg and RrSCtg=OrRmSCtg and (OrLn1 >=RrFrLn and OrLn1 <=RrToLn) " + _
              " Where " + IIF(gs_Partition = ctCurrPrtn, " OrPrtKey='" + ctCurrPrtn + "' and ", "") + _
              " OrRmCtg in ('" + ws_rstg + "') and " + _
              "OrCoCd ='" + ms_OmCoCd + "' And OrTc ='" + ADC("OMTC") + "' And " + _
             "OrYy = '" + ADC("OMYY") + "' And OrChr ='" + ADC("OMCHR") + "' And " + _
             "OrNo = " + CStr(ADC("OMNO")) + " and OrSr = " + CStr(ADC("wDsgSrNo")) + _
            " Group By " + ws_reqGrpBy
        
              
  Else
  
  Select Case ADC(ws_reqIdName)
  Case Is = "-"
    ws_reqGrpBy = "DrRmCtg,DrRmSCtg"
    CpyRmSummSql = "Select DrRmCtg, DrRmSCtg,  '*' as RmCol, '*' as urngsz, "
  Case Is = "RMCOL"
    ws_reqGrpBy = "DrRmCtg, DrRmSCtg,RmCol"
    CpyRmSummSql = "Select DrRmCtg, DrRmSCtg,  RmCol,  '*' as urngsz, "
  Case Is = "RMCOL-SZ"
    ws_reqGrpBy = "DrRmCtg, DrRmSCtg,RmCol,RrRngSz"
    CpyRmSummSql = "Select DrRmCtg, DrRmSCtg,  RmCol, Isnull(RrRngSz,'') as urngsz,"
  Case Is = "RMRNGSZ"
    ws_reqGrpBy = "DrRmCtg, DrRmSCtg,  RrRngSz"
    CpyRmSummSql = "Select DrRmCtg, DrRmSCtg,  '*' as RmCol, Isnull(RrRngSz,'') as urngsz,"
  Case Is = "RMRT"
    ws_reqGrpBy = "DrRmCtg,DrRmSCtg"
    CpyRmSummSql = "Select DrRmCtg, DrRmSCtg,  '*' as RmCol, '*' as urngsz, "
    
  Case Else
    DispMsg "No Grouping Flds defined in system for selected GroupBy value", etError
    Exit Function
  End Select
              
   ws_CommStr = "IsNull(sum(DrQty),0) as Qty " + _
              "from DsgRm " + _
              " Join RmMst on RmCtg=DrRmCtg and RmSCtg=DrRmSCtg And RmCd =DrRmCd " + _
              " Left outer Join RmRt on RrTcTyp ='RSZ' and RrCtg=DrRmCtg and RrSCtg=DrRmSCtg and (DrLn1 >=RrFrLn and DrLn1 <=RrToLn) " + _
              " Where " + IIF(gs_Partition = ctCurrPrtn, " DrPrtKey='" + ctCurrPrtn + "' and ", "") + _
              " DrRmCtg in ('" + ws_rstg + "') and DrTcTyp='" + ms_DmTcTyp + _
              "' and DrCd='" + ADC("wDsgDmCd") + "' and DrSz= '" + ADC("wDsgSz") + "'" + _
              " Group By " + ws_reqGrpBy
      
    End If
       
             
  ElseIf pv_DsgOrdSumm = ctOrdSumm Then
  Select Case ADC(ws_reqIdName)
  Case Is = "-"
    ws_reqGrpBy = "OrRmCtg,OrRmSCtg"
    ' before deleting size option in all case
    'CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, '*' as OdDmSz, '*' as RrRndSz, "
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, '*' as urngsz, '*' as OrRmRt ,'' as OrRmCd,"
  Case Is = "RMCOL"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,RmCol"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  RmCol,  '*' as urngsz, '*' as OrRmRt ,'' as OrRmCd,"
  Case Is = "RMCOL-SZ"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,RmCol,RrRngSz"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  RmCol, Isnull(RrRngSz,'') as urngsz,'*' as OrRmRt ,'' as OrRmCd,"
  Case Is = "RMCDSZ"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,OrRmCd,RrRngSz"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  Isnull(RrRngSz,'') as urngsz,'*' as OrRmRt ,OrRmCd,'' as RmCol,"
  Case Is = "RMRNGSZ"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,  RrRngSz"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, Isnull(RrRngSz,'') as urngsz,'*' as OrRmRt ,'' as OrRmCd,"
 Case Is = "RMRT"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,  OrSalRt"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  '*' as RmCol, '*' as urngsz,OrSalRt as OrRmRt, '' as OrRmCd,"
 Case Is = "RMCDRT"
    ws_reqGrpBy = "OrRmCtg, OrRmSCtg,  OrRmCd, OrSalRt"
    CpyRmSummSql = "Select OrRmCtg, OrRmSCtg,  OrRmCd, '*' as RmCol, '*' as urngsz,OrSalRt as OrRmRt, "
    
  Case Else
    DispMsg "No Grouping Flds defined in system for selected GroupBy value", etError
    Exit Function
  End Select
  
  ws_HOdAmdQty = Trim(UCase(moCn.GetFldVal("Select hOdAmdQty from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")))
  ws_OdQty = IIF(ws_HOdAmdQty = "Y", "OdOrdQty", "OdOrdEnt")
    
  Dim ordsrft As String
  
     'uuuuuu before size option
  ' ws_CommStr = "IsNull(sum(OrQty),0) as Qty " + _
              "from OrdRm Join OrdDsg On OdIdNo=OrOdIdNo And OdCoCd= OrCoCd and OdTc= OrTc and OdYy= OrYy and " + _
              "OdChr= OrChr and OdNo= OrNo and OdSr= OrSr and OdPrtKey=OrPrtKey " + _
              " Join RmMst on RmCtg=OrRmCtg and RmSCtg=OrRmSCtg And RmCd =OrRmCd " + _
              " Where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey='" + ctCurrPrtn + "' and ", "") + _
              " OrRmCtg in ('" + ws_rstg + "') and " + _
              "OdCoCd ='" + adc("WOCOCD") + "' And OdTc ='" + adc("WOMTC") + "' And " + _
             "OdYy = '" + adc("WOMYY") + "' And OdChr ='" + adc("WOMCHR") + "' And " + _
             "OdNo = " + CStr(adc("WOMNO")) + " and OdSr>=" + CStr(adc("WFRODSR")) + " and OdSr<=" + CStr(adc("WTOODSR")) + _
             " Group By " + ws_reqGrpBy
  ' after deleting size option
  
  If ADC("WFRODSR") = 0 And ADC("WTOODSR") = 0 Then ordsrft = ""
  If ADC("WFRODSR") >= 0 And ADC("WTOODSR") > 0 Then ordsrft = "and OrSr>=" + CStr(ADC("WFRODSR")) + " and OrSr<=" + CStr(ADC("WTOODSR"))
  
  ws_CommStr = "IsNull(sum(OrQty),0) as Qty " + _
              "from OrdRm " + _
              " Join RmMst on RmCtg=OrRmCtg and RmSCtg=OrRmSCtg And RmCd =OrRmCd " + _
              " Left outer Join RmRt on RrTcTyp ='RSZ' and RrCtg=OrRmCtg and RrSCtg=OrRmSCtg and (OrLn1 >=RrFrLn and OrLn1 <=RrToLn) " + _
              " Where " + IIF(gs_Partition = ctCurrPrtn, " OrPrtKey='" + ctCurrPrtn + "' and ", "") + _
              " OrRmCtg in ('" + ws_rstg + "') and " + _
              "OrCoCd ='" + ADC("WOCOCD") + "' And OrTc ='" + ADC("WOMTC") + "' And " + _
             "OrYy = '" + ADC("WOMYY") + "' And OrChr ='" + ADC("WOMCHR") + "' And " + _
             "OrNo = " + CStr(ADC("WOMNO")) + ordsrft + _
             " Group By " + ws_reqGrpBy
  End If
  
  CpyRmSummSql = CpyRmSummSql + ws_CommStr

End Function

