                                    " ) Results " + " Join " + _
                                    " OrdDsg OrdDsgForMasterVoucherNo on MasterRowOdIdNo = OrdDsgForMasterVoucherNo.OdIdNo Where " + _
                                    " Results.OdIdNo <> Results.MasterRowOdIdNo ")
