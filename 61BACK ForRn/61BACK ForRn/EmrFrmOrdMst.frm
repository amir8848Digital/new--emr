Private Sub DsgSalHst(ByVal ps_DmCd As String)
  Dim wSqlStr As String, wRsDsg As MDORowSet, wRow As Integer
  '*** (Bef 2.14)
  'wSqlStr = "Set DateFormat DMY " & vbCrLf & "Select Top 5 IdCoCd, IdTc, IdYy, IdChr, IdNo, IdSr, InDt As IdDt, IdExpCmCd, IdKt, OdDmCol," & _
  '          " IdDmCd, IdSfx, IdDmSz, IdQty, (IdIFob/IdQty) As IdIUFOB, IdIFob" & _
  '          " from InvHd Join InvDsg  On InCoCd = IdCoCd And InTc = IdTc And InYy = IdYy And InChr = IdChr And InNo = IdNo" & _
  '          " Join OrdDsg On InCoCd = OdCoCd And IdExpOdTc = OdTc And IdExpOdYy = OdYy And IdExpOdChr = OdChr And IdExpOdNo = OdNo And IdExpOdSr = OdSr" & _
  '          " Where InCoCd = '" & gs_CoCd & "' And InCmCd = '" & ADC("OmCmCd") & "' And IdDmCd = '" & ps_DmCd & "' " + _
  '          "And InDt <= '" & CStr(ADC("OmDt")) & "' " & _
  '          " Order By InDt Desc, InTc, InYy, InChr, InNo Desc, IdSr Desc"
  '*** (Bef 2.14)
  
  '*** (Jen 2.14)
  '****** Sachin 3.02 - Current Partition
  'Geeta*******Removed Current Partition Check and InPrtKey='" + ctCurrPrtn + "' " ,and IdPrtKey=OdPrtKey
  ' ****** Manali 3.5.0 - 08/11/08 - IdExpCmCd also Considered for Design History
  ' ****** Manali 3.6.0 - Order Customer and Invoice Customer to be shown in History
  'indigo.160- company code can change from gs_CoCd to ms_OmCoCd
  
  Dim ws_CoCd As String
  ws_CoCd = IIF(moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + ADC("OmTc") + "' and PValue='PL'"), gs_CoCd, ms_OmCoCd)
'6.1
'6.1b-36 OdKt added
  wSqlStr = "Set DateFormat " + DtFmtStr() + " " & vbCrLf & "Select Top 5 IdCoCd, IdTc, IdYy, IdChr, IdNo, IdSr, InDt As IdDt, IdExpCmCd, InCmCd, IdKt, OdDmCol," & _
            " IdDmCd, IdSfx, IdDmSz, IdQty, (IdIFob/IdQty) As IdIUFOB, IdIFob,OdKt " & _
            " from InvHd Join InvDsg  On InIdNo=IdInIdNo And InCoCd = IdCoCd And InTc = IdTc And InYy = IdYy And InChr = IdChr And InNo = IdNo And InPrtKey=IdPrtKey " & _
            " Join OrdDsg On IdOdIdNo=OdIdNo And InCoCd = OdCoCd And IdExpOdTc = OdTc And IdExpOdYy = OdYy And IdExpOdChr = OdChr And IdExpOdNo = OdNo And IdExpOdSr = OdSr " & _
            " Where InCoCd = '" & ws_CoCd & "' And (InCmCd = '" & ADC("OmCmCd") & "' Or IdExpCmCd = '" & ADC("OmCmCd") & "' ) And IdDmCd = '" & ps_DmCd & "' " + _
            IIF(ms_OmTcTyp = "PL", " ", " And InDt <= '" & CStr(ADC("OmDt")) & "' ") & _
            " Order By InDt Desc, InTc, InYy, InChr, InNo Desc, IdSr Desc"
  '*** (Jen 2.14)
  
  Set wRsDsg = moCn.OpenResultset(wSqlStr)
  If wRsDsg.RecCount > 0 Then
    Call DispFra(SalHst)    '*** (Jen 2.14)
    wRsDsg.MoveFirst
    With GrdHD
      .AllowAdd = False
      .AllowDelete = False
      .Rows = 1
      Do While Not (wRsDsg.BOF Or wRsDsg.EOF)
        .AddItem
        wRow = .Rows - 1
        .Value(wRow, "whDSr") = .MaxVal("whDSr") + 1
        .Value(wRow, "whIdTc") = wRsDsg.FldValue("IdTc")
        .Value(wRow, "whIdYy") = wRsDsg.FldValue("IdYy")
        .Value(wRow, "whIdChr") = wRsDsg.FldValue("IdChr")
        .Value(wRow, "whIdNo") = wRsDsg.FldValue("IdNo")
        .Value(wRow, "whIdSr") = wRsDsg.FldValue("IdSr")
        .Value(wRow, "whIdDt") = wRsDsg.FldValue("IdDt")
        .Value(wRow, "whDmCd") = wRsDsg.FldValue("IdDmCD")
        .Value(wRow, "whDmSfx") = wRsDsg.FldValue("IdSfx")
        .Value(wRow, "whDmSz") = wRsDsg.FldValue("IdDmSz")
        .Value(wRow, "whIdKT") = wRsDsg.FldValue("OdKt")  '6.1b-36 OdKt added
        .Value(wRow, "whIdCol") = wRsDsg.FldValue("OdDmCol")
        .Value(wRow, "whIdQty") = wRsDsg.FldValue("IdQty")
        .Value(wRow, "whIdRt") = wRsDsg.FldValue("IdIUFob")
        .Value(wRow, "whIdVal") = wRsDsg.FldValue("IdIFob")
        ' ****** Manali 3.6.0 - Order Customer and Invoice Customer to be shown in History
        .Value(wRow, "whExpCmCd") = wRsDsg.FldValue("IdExpCmCd")
        .Value(wRow, "whInCmCd") = wRsDsg.FldValue("InCmCd")
        .Value(wRow, "wApplyXDM") = "N"
        ' ****** Manali 3.6.0 - Order Customer and Invoice Customer to be shown in History
        wRsDsg.MoveNext
      Loop
      If .Rows - 1 > 0 Then .Row = 1
      .AllowAdd = False
      .AllowDelete = False
    End With
  Else
    DispMsg "No History Found For This Design and Customer.", etInfo
    'GrdOrdDsg.SetFocus        '*** (Jen 2.14)    '*** (Bef 3.01)
    If GrdOrdDsg.Visible = True And GrdOrdDsg.Enabled = True Then GrdOrdDsg.SetFocus        '*** (Jen 3.01)
    'Call DispFra(SalHst)     '*** (Bef 2.14)
  End If
End Sub
