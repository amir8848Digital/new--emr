Private Function GetDsgMstMainMetFactor(TargetDmSz As Variant, SourceDmCd As Variant, SourceDmSz As Variant)
GetDsgMstMainMetFactor = 1
If SourceDmSz = "" Then
  SourceDmSz = moCn.GetFldVal("Select DmDefSz from DsgMst where DmCd='" + SourceDmCd + "' and DmSz=''")
End If
GetDsgMstMainMetFactor = GetDmSzMainMetFactor(TargetDmSz, SourceDmSz)
End Function
Private Function GetDmSzMainMetFactor(ByVal TargetDmSz As Variant, ByVal SourceDmSz As Variant) As Double
Dim wTargetDmSzFct As Double
wTargetDmSzFct = moCn.GetFldVal("Select Pnum from Param where Ptyp='DMSZ' and PMCd='" + TargetDmSz + "' and PSCd=''")
Dim wSourceDmSzFct As Double
wSourceDmSzFct = moCn.GetFldVal("Select PNum from Param where Ptyp='DMSZ' and PMCd='" + SourceDmSz + "' and PSCd=''")
GetDmSzMainMetFactor = wTargetDmSzFct / IIF(wSourceDmSzFct <> 0, wSourceDmSzFct, 1)
GetDmSzMainMetFactor = IIF(GetDmSzMainMetFactor <= 0, 1, GetDmSzMainMetFactor)
 
End Function

