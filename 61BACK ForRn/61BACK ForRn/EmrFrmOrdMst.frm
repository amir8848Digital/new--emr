        ElseIf .Value(RowNum, "OrRmCtg") = "P" Then
          .Value(RowNum, "OrCstRt") = GetGldRt(ADC("OmCmCd"), ADC("OmLmpCst"), _
                                      .Value(RowNum, "OrRmCd"), .Value(RowNum, "OrAlyCstRt"), _
                                      ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
        ElseIf .Value(RowNum, "OrRmCtg") = "S" Then
          If mf_SlvMod = True Then
            .Value(RowNum, "OrCstRt") = GetGldRt(ADC("OmCmCd"), ADC("OmLmsCst"), _
                                        .Value(RowNum, "OrRmCd"), .Value(RowNum, "OrAlyCstRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
          Else
            .Value(RowNum, "OrCstRt") = 0
          End If
        ' ****** Sachin - 2.12 - SJM - 01/12/05 ******
        ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
        ElseIf .Value(RowNum, "OrRmCtg") = "L" Then
          If mf_PdMod = True Then
            ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
            .Value(RowNum, "OrCstRt") = GetGldRt(ADC("OmCmCd"), ADC("OmLmlCst"), _
                                        .Value(RowNum, "OrRmCd"), .Value(RowNum, "OrAlyCstRt"), _
                                        ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), "C", ADC("OmCmCtg"), , ADC("OmCmCurCd"), , , IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
          Else
            .Value(RowNum, "OrCstRt") = 0
          End If
        Else
            If ADC("OmHistCmCtg") <> vbNullString Then
              .Value(RowNum, "OrCstRt") = GetRmRt(ADC("OmCmCd"), .Value(RowNum, "OrRmCd"), _
                                      .Value(RowNum, "OrLn1"), .Value(RowNum, "OrLn2"), _
                                      Round(MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), 5), "C", _
                                      0, ADC("OmCmCtg"), ADC("OmHistCmCtg"), ADC("OmHistCmCd"), ADC("OmHistYyyyMm"), ADC("OmCmCurCd"), , IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
              
            Else
              If UCase(GrdOrdRm.Value(RowNum, "OrRmCtg")) = "X" Then
                ws_BaseLme = moCn.GetFldVal("Select IsNull((Select (case B.RmCtg when 'G' then " + CStr(ADC("OmLmgCst")) + " " + _
                             "when 'P' then " + CStr(ADC("OmLmpCst")) + " when 'S' then " + CStr(ADC("OmLmsCst")) + " " + _
                             "when 'L' then " + CStr(ADC("OmLmlCst")) + " else 0 end) from RmMst B where " + _
                             "RmCd= (Select Rm.RmBaseCd from RmMst Rm where Rm.RmCd= '" + .Value(RowNum, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "')  and RmPrtKey='" + ctCurrPrtn + "'), 0) ")
              Else
                ws_BaseLme = 0
              End If
              .Value(RowNum, "OrCstRt") = GetRmRt(ADC("OmCmCd"), .Value(RowNum, "OrRmCd"), _
                                      .Value(RowNum, "OrLn1"), .Value(RowNum, "OrLn2"), _
                                      Round(MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), 5), _
                                        "C", ws_BaseLme, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                      IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
            
            End If
        End If
      End If

    Case Is = UCase("OrCstVal")
      '$$$ In the Change Event Of OdGldAsWt, recalc of OrCstVal takes place and if OrMainMet="Y" then OrSalVal = OdGldAsWt*OrCstRt
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        '*** (Bef 2.13)
        'If .Mode = fgmCopy And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
        '*** (Bef 2.13)
        'CostRtPDCM-If Cost Rate Editable Module is YES & Cost Rate from PDCM is Yes then
        'we can get cost rate from PDCM and exit from this procedure else we can get cost rate from Rate chart
        If .Mode = fgmCopy And mf_CpyVal = True And mf_CstRtEdt = True And mf_CstRatePDCM = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
        '*** (Jen 2.13)
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        'If .Mode = fgmCopy And mf_CpyVal = True And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        '*** (Jen 2.13)
        
        .Value(RowNum, "OrCstVal") = IIF(moCn.GetFldVal("Select RmQwCst from RmMst where " + _
                                     "RmCd= '" + .Value(RowNum, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "'") = "Q", _
                                     .Value(RowNum, "OrPrdQty"), .Value(RowNum, "OrPrdWt")) * .Value(RowNum, "OrCstRt")
        'If .Value(RowNum, "OrMainMet") = "Y" Then _
        '   .Value(RowNum, "OrCstVal") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdGldAsWt") * .Value(RowNum, "OrCstRt")
        'If .Value(RowNum, "OrMainMet") = "N" Then _
        '   .Value(RowNum, "OrCstVal") = .Value(RowNum, "OrWt") * .Value(RowNum, "OrCstRt")
      End If
    Case Is = UCase("OrSetCstRt")
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        Dim wSetCstRt As Double
        wWtRngChg = ""
        If (UCase(SourceColName) = UCase("OrPrdWt") And Val(OldVal) <> .Value(RowNum, "OrPrdWt")) Then
            ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
            wSetCstRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              .Value(RowNum, "OrSetSCd"), "C", _
                                              MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), ADC("OmCmCtg"), , _
                                              MWLib.Div(Val(OldVal), .Value(RowNum, "OrPrdQty")), wWtRngChg, ADC("OmCmCurCd"))
           
       ElseIf (UCase(SourceColName) = UCase("OrPrdQty") And Val(OldVal) <> .Value(RowNum, "OrPrdQty")) Then
            ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
            wSetCstRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              .Value(RowNum, "OrSetSCd"), "C", _
                                              MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), ADC("OmCmCtg"), , _
                                             MWLib.Div(.Value(RowNum, "OrPrdWt"), Val(OldVal)), wWtRngChg, ADC("OmCmCurCd"))
           
       ElseIf UCase(SourceColName) <> UCase("OrPrdWt") And UCase(SourceColName) <> UCase("OrPrdQty") Then
                ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
               .Value(RowNum, "OrSetCstRt") = GetLabRt(ADC("OmCmCd"), "SET", _
                                              .Value(RowNum, "OrSetSCd"), "C", _
                                              MWLib.Div(.Value(RowNum, "OrPrdWt"), .Value(RowNum, "OrPrdQty")), ADC("OmCmCtg"), , , , ADC("OmCmCurCd"))
      End If
      If wWtRngChg = "T" Then .Value(RowNum, "OrSetCstRt") = wSetCstRt

'Geeta*******2.11
    End If
    Case Is = UCase("OrSetCstVal")
      'If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") <= 0))) Then
'urmi 2.06 LabRt
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        'If .Mode = fgmCopy And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
         
        '*** (Bef 2.13)
        'If .Mode = fgmCopy And mf_CpyLabRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
        '*** (Bef 2.13)
        '*** (Jen 2.13)
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        'If .Mode = fgmCopy And mf_CpyVal = True And mf_CpyLabRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + .Value(RowNum, "OrRmCtg") + ",") >= 1 Or .Value(RowNum, "OrRmCtg") = "") Then Exit Sub
        ' ***** Bef 3.03- Manali - Cst Rt/Val always from Current
        '*** (Jen 2.13)
         ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
        .Value(RowNum, "OrSetCstVal") = GetLabVal(ADC("OmCmCd"), "SET", _
                                        .Value(RowNum, "OrSetSCd"), _
                                        .Value(RowNum, "OrSetCstRt"), _
                                        .Value(RowNum, "OrPrdQty"), 0, "Q", "C", ADC("OmCmCtg"), ADC("OmCmCurCd"))
      End If
    Case Is = UCase("OrAlyCstRt")
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
        .Value(RowNum, "OrAlyCstRt") = GetRmRt(ADC("OmCmCd"), .Value(RowNum, "OrAlyCd"), _
                                       0, 0, 0, "C", 0, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                       IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, ctCurrPrtn, ""))
        '*** (Jen 2.13)
      End If
    '****** Sachin 2.13.0 - 29-05-2006 ******
    Case Is = UCase("wQwSal")
      If .Mode = fgminit Or .Mode = fgmnorm Or .Mode = fgmCopy Then
        .Value(RowNum, "WQWSAL") = moCn.GetFldVal("Select RmQw From RmMst Where RmCd='" + .Value(RowNum, "OrRmCd") + "' " + IIF(gs_Partition = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "'", ""))
      End If
    Case Is = UCase("OrCustRmCd")
      If .Mode = fgmnorm Or .Mode = fgmCopy Then
         .Value(RowNum, "OrCustRmCd") = moCn.GetFldVal(" Select IsNull((Select CrCustRmCd from CustRm Where " + IIF(gs_Partition = ctCurrPrtn, " CrPrtKey='" + ctCurrPrtn + "' And ", "") + _
                                                            " CrCtg = '" + ADC("OmCmCtg") + "' And CrCd = '" + ADC("OmCmCd") + "' and CrRmCtg = '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                                                            " CrOurRmCd ='" + .Value(RowNum, "OrRmCd") + "'  and " + CStr(.Value(RowNum, "OrLn1")) + " Between CrFrLn and CrToLn),'')")
         ADC("wOrCustRmCd") = .Value(RowNum, "OrCustRmCd")
      End If
    'mw.84 Copy LotNo from Text box to grid
    End Select
  End With
End Sub
Private Sub RecalcForCpyRm_OrLmeSal(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
        If mf_InCopyFromServer And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + ParamsRm(wOrRmCtg) + ",") >= 1 Or ParamsRm(wOrRmCtg) = "") Then Exit Sub
        SetParamsValRm IIF(ParamsRm(wOrRmCtg) = "G", ADC("OmLmgSal"), _
                                     IIF(ParamsRm(wOrRmCtg) = "P", ADC("OmLmpSal"), _
                                     IIF(ParamsRm(wOrRmCtg) = "S", ADC("OmLmsSal"), _
                                     IIF(ParamsRm(wOrRmCtg) = "L", ADC("OmLmlSal"), 0)))), wOrLmeSal
End Sub
Private Sub RecalcForCpyRm_OrSalRt(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)

      Dim wRmQW As String
        Dim ws_BaseLme As Single

    '  Exit Sub
      If mf_InCopyFromServer Or GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmCopy Then
      
        wRmQW = moCn.GetFldVal("Select RmQw From RmMst Where RmCd='" + ParamsRm(wOrRmCd) + "'")
       ' .Mode = fgmCopy
        If mf_InCopyFromServer And mf_CpyRate = True And (InStr(1, "," + ms_CpyRateOpt + ",", "," + ParamsRm(wOrRmCtg) + ",") >= 1 Or ParamsRm(wOrRmCtg) = "") Then Exit Sub
        If ParamsRm(wOrRmCtg) = "G" Then
          If Not ((UCase(SourceColName) = UCase("OrQty") Or UCase(SourceColName) = UCase("OrWt")) Or _
                  (UCase(SourceName) = UCase("GrdOrdRm") And UCase(SourceColName) = UCase("OrAlySalRt") _
                   And wRmQW = "Q" And Params(wOrSalRt) <> 0)) Then
            SetParamsValRm GetGldRt(ADC("OmCmCd"), ParamsRm(wOrLmeSal), _
                                        ParamsRm(wOrRmCd), ParamsRm(wOrAlySalRt), _
                                        ms_DmTcTyp, Params(woddmcd), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                        IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                        IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                        IIF(1 = 1, ctCurrPrtn, ""), "Y", _
                                        ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5)), wOrSalRt
          End If
        ElseIf ParamsRm(wOrRmCtg) = "P" Then
          If Not ((UCase(SourceColName) = UCase("OrQty") Or UCase(SourceColName) = UCase("OrWt")) Or _
                  (UCase(SourceName) = UCase("GrdOrdRm") And UCase(SourceColName) = UCase("OrAlySalRt") _
                    And wRmQW = "Q" And ParamsRm(wOrSalRt) <> 0)) Then
            SetParamsValRm GetGldRt(ADC("OmCmCd"), ParamsRm(wOrLmeSal), _
                                        ParamsRm(wOrRmCd), ParamsRm(wOrAlySalRt), _
                                        ms_DmTcTyp, Params(woddmcd), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                        IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                        IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                        IIF(1 = 1, ctCurrPrtn, ""), "Y", _
                                        ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5)), wOrSalRt
          End If
        ElseIf ParamsRm(wOrRmCtg) = "S" Then
          If mf_SlvMod = True Then
            If Not ((UCase(SourceColName) = UCase("OrQty") Or UCase(SourceColName) = UCase("OrWt")) Or _
                  (UCase(SourceName) = UCase("GrdOrdRm") And UCase(SourceColName) = UCase("OrAlySalRt") _
                   And wRmQW = "Q" And ParamsRm(wOrSalRt) <> 0)) Then
              SetParamsValRm GetGldRt(ADC("OmCmCd"), ParamsRm(wOrLmeSal), _
                                          ParamsRm(wOrRmCd), ParamsRm(wOrAlySalRt), _
                                          ms_DmTcTyp, Params(woddmcd), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                          IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                          IIF(1 = 1, ctCurrPrtn, ""), "Y", _
                                        ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5)), wOrSalRt
            End If
          Else
              SetParamsValRm 0, wOrSalRt
          End If
        ElseIf ParamsRm(wOrRmCtg) = "L" Then
          If mf_PdMod = True Then
            If Not ((UCase(SourceColName) = UCase("OrQty") Or UCase(SourceColName) = UCase("OrWt")) Or _
                  (UCase(SourceName) = UCase("GrdOrdRm") And UCase(SourceColName) = UCase("OrAlySalRt") _
                   And wRmQW = "Q" And ParamsRm(wOrSalRt) <> 0)) Then
              SetParamsValRm GetGldRt(ADC("OmCmCd"), ParamsRm(wOrLmeSal), _
                                          ParamsRm(wOrRmCd), ParamsRm(wOrAlySalRt), _
                                          ms_DmTcTyp, ParamsRm(woddmcd), "S", ADC("OmCmCtg"), , ADC("OmCmCurCd"), _
                                          IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                          IIF(ADC("OmLkUpMetLs") <> "", ADC("OmLkUpMetLs"), ""), _
                                          IIF(1 = 1, ctCurrPrtn, ""), "Y", _
                                        ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5)), wOrSalRt
            End If
          Else
              SetParamsValRm 0, wOrSalRt
          End If
        Else
          If Not ((UCase(SourceColName) = UCase("OrQty") Or UCase(SourceColName) = UCase("OrWt")) And _
             ((moCn.GetFldVal("Select PValue from Param where PTyp= 'RMSCTG' and " + _
                             "PMCd= '" + ParamsRm(wOrRmCtg) + "' and " + _
                             "PSCd= '" + ParamsRm(wOrRmSCtg) + "'") <> "P" _
                    And moCn.RecSeek("Select 'x' From RmRt Where RrTcTyp= 'PTR' And " + _
                           "RrCmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and RrCmCd= '" + ADC("OmCmCd") + "' and " + _
                           "RrCtg= '" + ParamsRm(wOrRmCtg) + "' and " + _
                           "RrSCtg= '" + ParamsRm(wOrRmSCtg) + "' and RrPrtKey='" + ctCurrPrtn + "'") = False) _
              Or ParamsRm(wOrRmCtg) = "X")) Then
            If ADC("OmHistCmCtg") <> vbNullString And _
                (UCase(ParamsRm(wOrRmCtg)) = "D" Or UCase(ParamsRm(wOrRmCtg)) = "C") Then
              SetParamsValRm GetRmRt(ADC("OmCmCd"), ParamsRm(wOrRmCd), _
                                          ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5), "S", 0, _
                                          ADC("OmCmCtg"), ADC("OmHistCmCtg"), ADC("OmHistCmCd"), ADC("OmHistYyyyMm"), ADC("OmCmCurCd"), , IIF(1 = 1, ctCurrPrtn, "")), wOrSalRt
            Else
              If UCase(ParamsRm(wOrRmCtg)) = "X" Then
                ws_BaseLme = moCn.GetFldVal("Select IsNull((Select (case B.RmCtg when 'G' then " + CStr(ADC("OmLmgSal")) + " " + _
                             "when 'P' then " + CStr(ADC("OmLmpSal")) + " when 'S' then " + CStr(ADC("OmLmsSal")) + " when 'L' then " + CStr(ADC("OmLmlSal")) + " " + _
                             "else 0 end) from RmMst B where " + IIF(1 = 1, " RmPrtKey='" + ctCurrPrtn + "' and ", "") + _
                             "RmCd= (Select Rm.RmBaseCd from RmMst Rm where " + IIF(1 = 1, " Rm.RmPrtKey=B.RmPrtKey and ", "") + " Rm.RmCd= '" + ParamsRm(wOrRmCd) + "')), 0) ")
              Else
                ws_BaseLme = 0
              End If
              SetParamsValRm GetRmRt(ADC("OmCmCd"), ParamsRm(wOrRmCd), _
                                          ParamsRm(wOrLn1), ParamsRm(wOrLn2), _
                                          Round(MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), 5), "S", _
                                          ws_BaseLme, ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""), _
                                          IIF(1 = 1, ctCurrPrtn, "")), wOrSalRt
            End If
          End If
        End If
      End If
End Sub
Private Sub RecalcForCpyRm_OrSetSalRt(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
    With GrdOrdRm
      If .Mode = fgmnorm Or mf_InCopyFromServer Or .Mode = fgmCopy Then
        If mf_InCopyFromServer = True And mf_CpyLabRate = True Then
                Exit Sub
        End If
        Dim wWtRngChg As String, wSetSalRt As Double
        Dim wDsgPtrYN As String
        wWtRngChg = ""
        wDsgPtrYN = moCn.GetFldVal("Select PValue2 From Param where PTyp='RMSCTG' and PMCd='" + ParamsRm(wOrRmCtg) + "' and " + _
                                        " PSCd= '" + ParamsRm(wOrRmSCtg) + "'")
        If (UCase(SourceColName) = UCase("OrRmPtr") And Val(OldVal) <> ParamsRm(wOrRmPtr) And wDsgPtrYN = "Y") Then
            wSetSalRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "S", _
                                              ParamsRm(wOrRmPtr), ADC("OmCmCtg"), , Val(OldVal), wWtRngChg, ADC("OmCmCurCd"), _
                                              IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
        ElseIf (UCase(SourceColName) = UCase("OrWt") And Val(OldVal) <> ParamsRm(wOrWt) And wDsgPtrYN = "N") Then
            wSetSalRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "S", _
                                              MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), ADC("OmCmCtg"), , _
                                              MWLib.Div(Val(OldVal), ParamsRm(wOrQty)), wWtRngChg, ADC("OmCmCurCd"), _
                                              IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
       ElseIf (UCase(SourceColName) = UCase("OrQty") And Val(OldVal) <> ParamsRm(wOrQty) And wDsgPtrYN = "N") Then
            wSetSalRt = GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "S", _
                                              MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty)), ADC("OmCmCtg"), , _
                                             MWLib.Div(ParamsRm(wOrWt), Val(OldVal)), wWtRngChg, ADC("OmCmCurCd"), _
                                             IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))
       ElseIf UCase(SourceColName) <> UCase("OrRmPtr") And UCase(SourceColName) <> UCase("OrWt") And UCase(SourceColName) <> UCase("OrQty") Then
               SetParamsValRm GetLabRt(ADC("OmCmCd"), "SET", _
                                              ParamsRm(wOrSetScd), "S", _
                                              IIF(wDsgPtrYN = "Y", ParamsRm(wOrRmPtr), MWLib.Div(ParamsRm(wOrWt), ParamsRm(wOrQty))), ADC("OmCmCtg"), , , , ADC("OmCmCurCd"), _
                                              IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), "")), wOrSetSalRt
      End If
       If wWtRngChg = "T" Then SetParamsValRm wSetSalRt, wOrSetSalRt
      End If
      End With
End Sub
