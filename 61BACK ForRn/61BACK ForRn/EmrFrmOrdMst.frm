   wSqlStr = " Select isnull(qStkDmIdNo,'') as qStkDmIdNo, isnull(qStkMasterVch,'') as qStkMasterVch, isnull(qStkMasterVchSrt,'') as qStkMasterVchSrt, isnull(qSrcVch,'') as qSrcVch, isnull(qSrcVchSrt,'') as qSrcVchSrt, isnull(qStkQty,0) as qStkQty, isnull(qSrcVchBalQty,0) as qSrcVchBalQty, " + _
