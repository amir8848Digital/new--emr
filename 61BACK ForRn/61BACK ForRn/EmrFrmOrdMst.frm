                        ReadCell(ADC("WXLSHTNO"), i, 21) + "," + ReadCell(ADC("WXLSHTNO"), i, 22) + ", 0 " + _
                        ",'" + ReadCell(ADC("WXLSHTNO"), i, 23) + "','" + ReadCell(ADC("WXLSHTNO"), i, 24) + "','" + ReadCell(ADC("WXLSHTNO"), i, 25) + "'," + _
                        ReadCell(ADC("WXLSHTNO"), i, 26) + "," + ReadCell(ADC("WXLSHTNO"), i, 27) + "," + ReadCell(ADC("WXLSHTNO"), i, 28) + "," + ReadCell(ADC("WXLSHTNO"), i, 29) + ")")
