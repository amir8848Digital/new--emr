                                   " From OrdDsg B  " + _
                                   " Join OrdMst On OmCoCd=OdCoCd and OmTc=OdTc and OmTc=OdTc and OmYy=OdYY and OmChr=OdChr and OmNo=OdNo and OmIdNo=OdOmIdNo and OmPrtKey=OdPrtkey " + _
