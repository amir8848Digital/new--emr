Private Sub GrdOrdRm_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  '*** Set Helps For Each Field
  '*** In the help of OrRmCd do not show the Custom Codes
  '    The first param is Custom Code (Y/N), the 2nd is the RmCtg and third is RmSCtg
  '*** In the help of OrAlyCd
  '    the first param is Custom Code (Y/N), the 2nd is the RmCtg= 'A'

  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdRm.Value(RowNum, "OrPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub


'  If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub

'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If
  
  Call ChkIsJEmrMasterRecord(GrdOrdDsg.Row, Cancel, ErrMsg)
  If Cancel = True Then Exit Sub

  '****** Sachin 3.5.0 ******
  If mb_CustomiseOrd = True And ms_GrdUrStyle <> "I" Then
    Dim wRsCtrl As New MDORowSet, wExpRmCtg As String
    wExpRmCtg = "," + moCn.GetFldVal("Select PDesc225 from Param where PTyp='GLDAS' and PMCd = '" + ms_CustomiseRmExp + "'") + ","
    Set wRsCtrl = moCn.OpenRes(" Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                " from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                " and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + UCase("GrdOrdRm") + "' and UrName='" + UCase(ColName) + "' ")
    If Not (wRsCtrl.EOF Or wRsCtrl.BOF) And (InStr(1, wExpRmCtg, "," + GrdOrdRm.Value(RowNum, "OrRmCtg") + ",") = 0) Then _
    If wRsCtrl!UrStyle = "D" Then Cancel = True
  End If
  '****** Sachin 3.5.0 ******
    
  Select Case UCase(ColName)
  
  Case Is = UCase("OrRmCtg")
    Call HlpList.PMCd("RMCTG")
  
  Case Is = UCase("OrRmSCtg")
    Call HlpList.PSCd("RMSCTG", GrdOrdRm.Value(RowNum, "OrRmCtg"))
    
  Case Is = UCase("OrRmCd")
    If GrdOrdRm.Value(RowNum, "OrMainMet") = "Y" And ms_PwdFlag = False Then
        If (moCn.RecSeek("Select 'x' from Bag join Param on PTyp='BCHR' and PMCd=BChr where PValue='P' and BCoCd= '" + ms_OmCoCd + "' and " + _
                                "   BOdTc= '" + ADC("OmTc") + "' and " + _
                                "   BOdYy= '" + ADC("OmYy") + "' and " + _
                                "   BOdChr= '" + ADC("OmChr") + "' and " + _
                                "   BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                                "   BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "'")) Then

            Cancel = True
            ErrMsg = "Cannot edit Main Metal code when Bags exists, provide SEO password to proceed"
            Exit Sub
        End If
    End If
    Call HlpList.RmCd("N", "'" + GrdOrdRm.Value(RowNum, "OrRmCtg") + "'", GrdOrdRm.Value(RowNum, "OrRmSCtg"), , , ADC("OmCmCd"))    'Sachin 3.11.0 - Cust RM Code in help
'Manoj
'    ADC.AllowSave = False

  Case Is = UCase("OrLn1")
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master]******
    If mb_VldRmLn = True And (GrdOrdRm.Value(RowNum, "OrRmCtg") = "D" Or GrdOrdRm.Value(RowNum, "OrRmCtg") = "C") Then
      Dim ws_Arr() As String, ws_OrLn1 As String
      ws_OrLn1 = GrdOrdRm.Value(RowNum, "OrLn1")
      ws_Arr = Split("VrsLn2,OrLn2", ",")
      Call HlpList.OrLn1(GrdOrdRm.Value(RowNum, "OrRmCtg"), moCn.GetFldVal("Select RmId From RmMst Where RmCd='" + GrdOrdRm.Value(RowNum, "OrRmCd") + "'"), ws_Arr)
    End If
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master]******
  Case Is = UCase("OrLn3")
      Cancel = ColWhenStkSz(3, GrdOrdRm.Value(RowNum, "OrRmCtg"), GrdOrdRm.Value(RowNum, "OrRmSCtg"), ErrMsg)
  Case Is = UCase("OrSetSCd")
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "C" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "D" Then
      Cancel = True
      ErrMsg = "Can not Edit Setting Type For This RM Category."
    Else
      Call HlpList.PSCd("LABSCD", "SET")
    End If
  Case Is = UCase("OrSetSalRt")
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "C" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "D" Then
      Cancel = True
      ErrMsg = "Can not Edit Setting Rate For This RM Category."
    End If
  Case Is = UCase("OrSubShp")
    Call HlpList.PMCd("SUBSHP")   '5717 can enter subshp for metal also
    
'Manoj
  Case Is = UCase("OrAlyCd")
    Call HlpList.RmCd("N", "'A'")
    
'  Case Is = UCase("OrAlySalRt")
'    If GrdOrdRm.Value(RowNum, "OrAlyCd") = "" Then
'      Cancel = True: ErrMsg = "Please Specify the Alloy Code before Entering Alloy Rate"
'    End If
    
  Case Is = UCase("OrMainMet")
    If ms_PwdFlag = False Then
        If (moCn.RecSeek("Select 'x' from Bag join Param on PTyp='BCHR' and PMCd=BChr where PValue='P' and BCoCd= '" + ms_OmCoCd + "' and " + _
                                "   BOdTc= '" + ADC("OmTc") + "' and " + _
                                "   BOdYy= '" + ADC("OmYy") + "' and " + _
                                "   BOdChr= '" + ADC("OmChr") + "' and " + _
                                "   BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                                "   BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "'")) Then

            Cancel = True
            ErrMsg = "Cannot change Main Metal Yes/No when Bags exists, provide SEO password to proceed"
            Exit Sub
        End If
    End If
    Call HlpList.PMCd("YN")
  Case Is = UCase("OrRmPtr")
    If UCase(moCn.GetFldVal("Select PValue2 from Param where PTyp= 'RMSCTG' and " + _
            "PMCd= '" + GrdOrdRm.Value(RowNum, "OrRmCtg") + "' and " + _
            "PSCd= '" + GrdOrdRm.Value(RowNum, "OrRmSCtg") + "' ")) = "N" Then _
      Cancel = True: ErrMsg = "Cannot Edit Rm Pointer": Exit Sub
  Case Is = UCase("OrLmeSal")
    ' ****** Sachin 2.12 - 01/12/05 - SJM -Silver added below
    ' ****** Manali 3.03 - 19/06/08 - Pd Mod - Palladium added below
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "G" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "P" And _
      GrdOrdRm.Value(RowNum, "OrRmCtg") <> "S" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "L" Then _
       Cancel = True: ErrMsg = "Cannot Enter LME Rate For This Rm Ctg": Exit Sub
  End Select
End Sub
' Am creating this routine as a copy paste of GrdOrdRmRecalc so we can call this Routine from the GrdordRm_Recalc event and copy Routine
' We are doing this beccause during copy routine Recalc is being called several times for certain fields like SalRt for example for RmCd, RmLn1, Ln2, Wt etc
' Instead of putting commong code in a function etc we are doing this to keep changes and risks to a minimum at this stage of the product release cycle
Private Sub GrdOrdRmReCalcRoutine(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  '*** OrWt on OrRmCd,OrRmCtg,OrRmSCtg,OrLn1,OrLn2,OrQty    Normal
      ' If the SourceColName= OrRmCd (i.e. if OrRmCd has triggered the recalc)
      '     and OrRmCtg= 'G' or 'P' then
      '     if RmCtg of Old RmCode = RmCtg of New RmCode Then
      '         OrWt= OrWt* (RmSpGrav of New RmCd) / (RmSpGrav of Old RmCd)
      '     Else
      '         OrWt= 0
      ' Else
      '     If SourceColName is OrRmCd then
      '         calculate the OrWt only when OrWt is Zero or the OldRmCtg <> NewRmCtg
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
      '     If the SourceColName is not OrRmCd then
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
  
  '***/r OrSalRt on OrRmCtg,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      'If OrRmCtg= 'G' or 'P' then
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= ''
      '      for the specified customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      '   Apply the Inc % for the specified cust if SalRt is from customer= 'ZSELF' record
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '' for the specified customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      'Else
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrSalRt<> 0
      '      for the specified customer and for the specific Rate By option.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, for customer= 'ZSELF' and for the specific Rate By option.
  '***/r OrSalVal on OrMainMet,OrSalRt,OrWt                 Normal,Copy
      ' If OrMainMet= 'Y' then OrSalVal= OdGldAsWt* OrSalRt
      ' If OrMainMet= 'N' then OrSalVal= OrWt* OrSalRt
  '*** OrSetSCd on OrRmCtg,OrRmSCtg                         Normal
      ' OrSetSCd= ''
  '*** OrLn1 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn1= 0
  '*** OrLn2 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn2= 0
  '*** OrQty on OrRmCtg,OrRmSCtg                            Normal
      ' OrQty= 0
  '***/r OrSetSalRt on OmCmCd,OrSetSCd                      Normal,Copy
      'Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for the specified customer.
      'If Not, Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for customer= 'ZSELF'.
  '***/r OrSetSalVal on OmCmCd,OrSetSCd,OrSetSalRt,OrQty               Normal,Copy
      'GetLabVal(OmCmCd, 'SET', OrSetSCd, OrSetSalRt, OrQty, 0, 'Q', 'S')
  '*** OrSubShp on OrRmCtg,OrRmSCtg                         Normal
      ' OrSubShp= Blank
  '*** OrAlyCd on OmCmCd,OrRmCd,OdDmCol                     Normal
      'Check if CaAlyCd exists in CustAly(CaCtg='C', CaCd= OmCmCd, CaRmCd= OrRmCd
      '   CaDmCol=OdDmCol)
      'Check if CaAlyCd exists in CustAly(CaCtg='C', CaCd= 'ZSELF', CaRmCd= OrRmCd
      '   CaDmCol=OdDmCol)
  '***/r OrAlySalRt on OmCmCd,OrAlyCd                       Normal,Copy
      'GetRMRt(OmCmCd, OrAlyCd, 0, 0, 0, 'S')
  '*** OrWsQty on OrRmCtg,OrQty                             Normal
      'If OrRmCtg= 'D' or 'C' then OrWsQty= OrQty and OrHsQty= OrQty- OrWsQty else 0
  '*** OrHsQty on OrWsQty, OrQty                            Normal
      'If OrQty- OrWsQty> 0 then OrHsQty= OrQty- OrWsQty else 0
  '*** OrMainMet on OrRmCtg                                 Normal
      'OrMainMet= 'N'
  '***/r OrCstRt
      'Similar to OrSalRt except that here the Cost Rate is calculated instead of the sale rate
  '***/r OrCstVal
      'OrCstVal= OrWt * OrCstRt
  '***/r OrSetCstRt
      'Similar to OrSetSalRt except that here the Cost Setting Rate is calculated instead of the sale Setting Rate
  '***/r OrSetCstVal
      'Similar to OrSetSalVal except that here the Cost Setting Value is calculated instead of the sale Setting Value
  '***/r OrAlyCstRt
      'Similar to OrAlySalRt except that here the Cost Rate is calculated instead of the Sale Rate
  
  Dim wOldRmCtg As String, wRmSTWGrp As String
  Dim wOldSpGrav As Single, wNewSpGrav As Single
  Dim wOldRmSCtg As String
  
  Dim wRmDetOld As String, wRmSTWGrpOld As String    '*** (Jen 3.1.3)
  Dim wRmDetArr() As String
  
  '*** (Jen 2.13)
  Dim ws_BaseLme As Single
  '*** (Jen 2.13)
  
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  Dim wFndPcWt As Single
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  
  Dim wReqStrSri As String
  wReqStrSri = "ROW:" + CStr(RowNum) + "||+ID:" + ColName + "||Source:" + SourceColName
  With GrdOrdRm
    Select Case ColName
    Case Is = UCase("OrRmPtr")
      If .Mode = fgmnorm Then
        wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "' ", ""))
      
        If wRmSTWGrp <> "" And (.Value(RowNum, "OrRmCtg") = "C" Or .Value(RowNum, "OrRmCtg") = "D" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "G" _
           Or .Value(RowNum, "OrRmCtg") = "X" Or .Value(RowNum, "OrRmCtg") = "L" Or .Value(RowNum, "OrRmCtg") = "S") And UCase(moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")) = "Y" Then
          If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
            If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" Then
              wRmDetOld = moCn.GetFldVal("Select RmCtg+','+RmSCtg+ ','+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
              If wRmDetOld <> "" Then
                wRmDetArr = Split(wRmDetOld, ",")
                wOldRmCtg = wRmDetArr(0)
                wOldRmSCtg = wRmDetArr(1)
                wRmSTWGrpOld = wRmDetArr(2)
              End If
             If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or Trim(wOldRmSCtg) <> .Value(RowNum, "OrRmSCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
                 .Value(RowNum, "OrRmPtr") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                           .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                           .Value(RowNum, "OrLn2"), wRmSTWGrp)
             End If
            End If
          Else
           
              .Value(RowNum, "OrRmPtr") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                        .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                        .Value(RowNum, "OrLn2"), wRmSTWGrp)
          End If
        Else
          .Value(RowNum, "OrRmPtr") = 0
        End If
      End If
    Case Is = UCase("OrWt")
      If .Mode = fgmnorm Then
        wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
        wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
        If wRmSTWGrp = "" And (.Value(RowNum, "OrRmCtg") = "X" Or .Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Or .Value(RowNum, "OrRmCtg") = "M") Then
          If wFndPcWt <> 0 Then
             .Value(RowNum, "OrWt") = .Value(RowNum, "OrQty") * wFndPcWt
          Else
            If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
              wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "' ", ""))
              If (Trim(wOldRmCtg) = "G" Or Trim(wOldRmCtg) = "P" Or Trim(wOldRmCtg) = "S" Or Trim(wOldRmCtg) = "L" Or Trim(wOldRmCtg) = "M") And OldVal <> "" Then
                wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "' and RmPrtKey='" + ctCurrPrtn + "' ")
                wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                .Value(RowNum, "OrWt") = MWLib.Div(.Value(RowNum, "OrWt") * wNewSpGrav, wOldSpGrav)
              Else
                .Value(RowNum, "OrWt") = 0.001
              End If
            End If
          End If
        ElseIf wRmSTWGrp <> "" And (.Value(RowNum, "OrRmCtg") = "D" Or .Value(RowNum, "OrRmCtg") = "C" Or .Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Or .Value(RowNum, "OrRmCtg") = "M" Or .Value(RowNum, "OrRmCtg") = "X") Then
          If .Value(RowNum, "OrRmPtr") = 0 Then
            wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
            If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
              If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" Then
                wRmDetOld = moCn.GetFldVal("Select RmCtg+','+RmSCtg+ ','+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                If wRmDetOld <> "" Then
                  wRmDetArr = Split(wRmDetOld, ",")
                  wOldRmCtg = wRmDetArr(0)
                  wOldRmSCtg = wRmDetArr(1)
                  wRmSTWGrpOld = wRmDetArr(2)
                End If
                If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or Trim(wOldRmSCtg) <> .Value(RowNum, "OrRmSCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
                  .Value(RowNum, "OrWt") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                         .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                         .Value(RowNum, "OrLn2"), wRmSTWGrp) * .Value(RowNum, "OrQty")
                End If
              End If
            End If
          Else
            If (UCase(SourceColName) = UCase("OrRmPtr") And Val(OldVal) <> .Value(RowNum, "OrRmPtr")) Or _
               (UCase(SourceColName) = UCase("OrQty") And Val(OldVal) <> .Value(RowNum, "OrQty")) Then
              .Value(RowNum, "OrWt") = .Value(RowNum, "OrRmPtr") * .Value(RowNum, "OrQty")
            End If
          End If
        Else
          wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
          If .Value(RowNum, "OrRmCtg") = "X" And wFndPcWt <> 0 Then
            .Value(RowNum, "OrWt") = .Value(RowNum, "OrQty") * wFndPcWt
          Else
            If UCase(SourceColName) = UCase("OrRmCtg") And CStr(OldVal) <> .Value(RowNum, "OrRmCtg") Then
              .Value(RowNum, "OrWt") = 0.001
            End If
          End If
        End If
        If Round(.Value(RowNum, "OrWt"), 3) = 0 Then .Value(RowNum, "OrWt") = 0.001
      End If
      Case Is = UCase("OrPrdWt")
      
      If .Mode = fgmnorm Then
        wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
      
        If ms_ShBothWts = "N" Then
          .Value(RowNum, "OrPrdWt") = .Value(RowNum, "OrWt")
        ElseIf ms_ShBothWts = "Y" Then
          wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
        
          If wRmSTWGrp = "" And (.Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Or .Value(RowNum, "OrRmCtg") = "X") Then
          
            If wFndPcWt <> 0 Then
              If UCase(SourceColName) <> UCase("OrLn1") And UCase(SourceColName) <> UCase("OrLn2") Then
                .Value(RowNum, "OrPrdWt") = .Value(RowNum, "OrPrdQty") * wFndPcWt
              End If
            Else
              If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
                wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                If Trim(wOldRmCtg) = .Value(RowNum, "OrRmCtg") And OldVal <> "" Then
                  wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  .Value(RowNum, "OrPrdWt") = MWLib.Div(.Value(RowNum, "OrPrdWt") * wNewSpGrav, wOldSpGrav)
                
                ElseIf (Trim(wOldRmCtg) = "G" Or Trim(wOldRmCtg) = "P" Or Trim(wOldRmCtg) = "S" Or Trim(wOldRmCtg) = "L") And OldVal <> "" Then
                  wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  .Value(RowNum, "OrPrdWt") = MWLib.Div(.Value(RowNum, "OrPrdWt") * wNewSpGrav, wOldSpGrav)
