  End If
  DmHldExclChkStr = " and DmHld = 'N' " + wDmValidYnStr + " "
  'sv.71 old design exclusive check not necessary and removed
                    'IIF(ms_OmTcTyp = "JT" Or ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                    "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmCmGrp= 'Y' and " + _
                    "(Select CmGrp from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) = '" + ms_CmGrp + "' ) or " + _
                    " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                    " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ")

  '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******
    ' ***** Manali 3.03 - following line partially removed from query below - check is still applied for hold and design exclusivity
  'IIF(mb_CpyFrmHist = True, DmHldExclChkStr, "")
  
  Set wo_rsSrcOd = moCn.OpenRes("Select * from InvDsg Join DsgMst on DmIdNo=IdDmIdNo And DmTcTyp= '" + ms_DmTcTyp + "' " + _
                   " and DmCd = IdDmCd and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' " + _
                   " Where IdCoCd= '" + ps_cocd + "' and IdTc='" + ps_IdTc + "' and " + _
                   " IdYy= '" + ps_IdYy + "' and IdChr='" + ps_IdChr + "' and " + _
                   " IdNo= " + CStr(pi_IdNo) + " and IdSr>=" + IIF(pi_IdSrFr = 0, "IdSr", CStr(pi_IdSrFr)) + _
                   " and IdSr<=" + IIF(pi_IdSrTo = 0, "IdSr", CStr(pi_IdSrTo)) + _
                    DmHldExclChkStr + _
                   " AND NOT Exists (Select 'x' from DsgMst " + _
                   " Join (Select DctCd, DctSz from DsgCt where  DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = IdDmCd and " + _
                   " DctDmSz = '' and DctPrtKey=IdPrtKey /*IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd=IdDmCd And DmSz=IdDmSz ),'') */ ) CT " + _
                   " On DmCd = DctCd and DmSz= DctSz  " + _
                   " where DmTcTyp = 'PM' and DmHld = 'Y' and DmPrtKey=IdPrtKey) " + ws_Cnd + " Order By IdSr")
  '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******

  If wo_rsSrcOd.RecCount > 0 Then wo_rsSrcOd.MoveFirst
      mf_CpyRate = False
      ms_CpyRateCd = "": ms_CpyRateOpt = ""
      mf_CpyLabRate = False
      mf_CpyVal = True
      If ADC("wCpyRt") = "Y" Then mf_CpyRate = True
      If ADC("wCpyLabRt") = "Y" Then mf_CpyLabRate = True
      
      ms_CpyRateCd = ADC("wCpyRtOpt")
      ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                      "PMCd= '" + ms_CpyRateCd + "' ")
      
      ' ***** Manali 3.8.0 - Trading Module - Copy From IN in JPR
      mf_CpyDmId = False
      mf_CpyFrBase = False
      mf_CpyFrRef = False
      If ms_OmTcTyp = ctJtTcTyp Then
        If ADC("wCpyDmId") = "Y" Then mf_CpyDmId = True
        If mBaseTc = ADC("wOmTc") Then
          mf_CpyFrBase = True
        ElseIf InStr(1, mRefTc, ADC("wOmTc")) >= 1 Then
          mf_CpyFrRef = True
        End If
      End If
      ' ***** Manali 3.8.0 - Trading Module - Copy From IN in JPR
      
      mb_CpyKT = False     ' ***** Manali 3.9.0 - Copy KT from PDC
      
  If mb_CpyFrmHist = False Then
      ADC.StartCopy
      BeginEmrProcess Me, "Copying"   '578.40
     ' mf_CpyFrSameCust = IIF(moCn.GetFldVal("Select OdOmCmCd From InvDsg Join OrdDsg On IdCoCd=OdCoCd And IdExpOdTc=OdTc And IdExpOdYy=OdYy And IdExpOdChr=OdChr And IdExpOdNo=OdNo And IdExpOdSr=OdSr " + _
                                      " Where IdCoCd='" + ps_CoCd + "' And IdTc='" + ps_IdTc + "' And IdYy='" + ps_IdYy + "' " + _
                                      " And IdChr='" + ps_IdChr + "' And IdNo=" + CStr(pi_IdNo)) = adc("OmCmCd"), True, False)
                                      
      If Not ADC.SaveRec Then
          DispMsg "X Save Failed", etInfo
          EndEmrProcess Me  '578.40
          ADC.EndCopy
          Exit Sub
        End If
      
      If Not (wo_rsSrcOd.EOF Or wo_rsSrcOd.BOF) Then Call CpyInvDets(wo_rsSrcOd)
      EndEmrProcess Me  '578.40
      ADC.EndCopy
  
  Else
    BeginEmrProcess Me, "Copying"   '578.40
    'mf_CpyFrSameCust = IIF(moCn.GetFldVal("Select OdOmCmCd From InvDsg Join OrdDsg On IdCoCd=OdCoCd And IdExpOdTc=OdTc And IdExpOdYy=OdYy And IdExpOdChr=OdChr And IdExpOdNo=OdNo And IdExpOdSr=OdSr " + _
                                      " Where IdCoCd='" + ps_CoCd + "' And IdTc='" + ps_IdTc + "' And IdYy='" + ps_IdYy + "' " + _
                                      " And IdChr='" + ps_IdChr + "' And IdNo=" + CStr(pi_IdNo)) = adc("OmCmCd"), True, False)
    If Not (wo_rsSrcOd.EOF Or wo_rsSrcOd.BOF) Then Call CpyInvDets(wo_rsSrcOd, pi_ApplyXDM)
    EndEmrProcess Me  '578.40
  End If
  Call ShowMsgBoxForErr     '578.40 show msgbox if any error captured
End Sub
