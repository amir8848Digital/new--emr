                    " Else '' end) " + _
                    " From OrdRm where OrCoCd='" + wo_rsExpOrd!OdCoCd + "' And OrTc='" + wo_rsExpOrd!OdTc + "' And " + _
                    " OrYy='" + wo_rsExpOrd!OdYy + "' And OrChr='" + wo_rsExpOrd!OdChr + "' And " + _
                    " OrNo = " + CStr(wo_rsExpOrd!OdNo) + " and OrSr = " + CStr(wo_rsExpOrd!OdSr) + " and OrPrtKey='" + ctCurrPrtn + "'")
                    
