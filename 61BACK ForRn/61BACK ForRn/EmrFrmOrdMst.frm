                          " OdChr = '" + ADC("OmChr") + "' And OdNo = " + CStr(ADC("OmNo")) + " And " + _
                          " OdSr = " + CStr(Params(wctOdSr)))
                          

End Sub
Private Sub GetJRIJROOdRepGrWt(pv_rsSrcOd As Object)
      Dim wOdKeyArr() As String
      Dim wOdTcForJRO As String
      Dim wOdYyForJRO As String
      Dim wOdChrForJRO As String
      Dim wOdNoForJRO As String
      Dim wOdSrForJRO As String
      Dim i As Long
      Dim W As Double
      If ADC("OMTC") = "JRO" Then
              If pv_rsSrcOd!qBaseRefVch <> "" Then
                  wOdKeyArr = Split(pv_rsSrcOd!qBaseRefVch, "/")
                  If UBound(wOdKeyArr) = 4 Then
                    wOdTcForJRO = wOdKeyArr(0)
                    wOdYyForJRO = wOdKeyArr(1)
                    wOdChrForJRO = wOdKeyArr(2)
                    wOdNoForJRO = wOdKeyArr(3)
                    wOdSrForJRO = wOdKeyArr(4)
                    W = moCn.GetFldVal("Select OdRepGrWt from OrdDsg Where OdCoCd='" + IIF(ms_OmTc = "JIN" Or ms_OmTc = "LIN", ADC("OmBaseCoCd"), ms_OmCoCd) + "' and OdTc='" + wOdTcForJRO + "' " + _
                                            " and OdYy='" + wOdYyForJRO + "' and OdChr='" + wOdChrForJRO + "' and OdNo=" + CStr(wOdNoForJRO) + " and OdSr=" + CStr(wOdSrForJRO) + " " + _
                                            " and OdPrtKey='" + ctCurrPrtn + "' ")
                 End If
              End If
            'End If
            SetParamsVal W, wOdRepGrWt
    End If
                                             
    If ADC("OMTC") = "JRI" Then
      If (1 = 1) Then
'          Dim w As Double
          If 1 = 1 Then
            i = moCn.GetFldVal("Select BQty from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
                                      "BCoCd = '" + Params(woddmstkcocd) + "' and BOdDmCd='" + Params(woddmcd) + "' and BOdSfx='" + Params(wOdSfx) + _
                                      "' and BOdDmSz='" + Params(wOdDmSz) + "' and BYy = '" + Params(woddmstkyy) + _
                                      "' and BChr ='" + Params(woddmstkchr) + "' and BNo=" + CStr(Params(woddmstkno)))
        
            W = moCn.GetFldVal("Select BGrWt from Bag where " + IIF(gs_Partition = ctCurrPrtn, " BPrtKey= '" + ctCurrPrtn + "' And ", "") + _
                                      "BCoCd = '" + Params(woddmstkcocd) + "' and BOdDmCd='" + Params(woddmcd) + "' and BOdSfx='" + Params(wOdSfx) + _
                                      "' and BOdDmSz='" + Params(wOdDmSz) + "' and BYy = '" + Params(woddmstkyy) + _
                                      "' and BChr ='" + Params(woddmstkchr) + "' and BNo=" + CStr(Params(woddmstkno)))
            If Params(wOdOrdEnt) <= 0 Then
              SetParamsVal 0, wOdRepGrWt
            Else
              SetParamsVal (W / (IIF(i = 0, 1, i))) * Params(wOdOrdEnt), wOdRepGrWt
            End If
          End If
      End If
    End If
End Sub


Private Function GetTotalsFromOrdRm() As String
    Dim wRsTotals As MDORowSet
   If mf_InCopyFromServer Then
    Set wRsTotals = moCn.OpenRes("Select ISNULL(max(case when OrMainMet='Y' then isnull(PMCd,'-') else '' end),'') as OdCol,  ISNULL(max(case when OrMainMet='Y' then RmKt else '' end),'') as RmKt, " + _
    " ISNULL(max(case when OrMainmet='Y' then OrRmCtg else '' end),'') as wOdMainMetRmCtg, " + _
    " ISNULL(sum(case when OrRmCtg='D' then OrWt else 0 end ),0) as wOdPerPcDiaWt, " + _
    " ISNULL(sum(case when OrRmCtg='D' then OrPrdWt else 0 end ),0) as wOdPerPcDiaPrdWt, " + _
    " ISNULL(sum(case when OrRmCtg='C' then OrWt else 0 end),0) as wOdPerPcCsWt," + _
    " ISNULL(sum(case when OrRmCtg='C' then OrPrdWt else 0 end),0) as wOdPerPcCsPrdWt," + _
    " ISNULL(sum(case when OrRmCtg='D' then OrQty else 0 end),0) as wOdPerPcDiaQty, " + _
    " ISNULL(sum(case when OrRmCtg='C' then OrQty else 0 end),0) as wOdPerPcCsQty, " + _
    " ISNULL(sum(case when OrRmCtg='C' then OrQty else 0 end),0) as wOdPerPcCsQty1 " + _
    " from OrdRm join RmMst on RmCd=OrRmCd left outer join Param on PTyp='DMCOL' and PMCd=RmCol where OrCoCd='" + ADC("OmCoCd") + "' and OrTc='" + ADC("OmTc") + "' and OrYy='" + ADC("OmYy") + "' and OrChr='" + ADC("OmChr") + "' and OrNo=" + CStr(ADC("OmNo")) + " and OrSr=" + CStr(Params(wctOdSr)))
    If wRsTotals.RecCount > 0 Then
      SetParamsVal wRsTotals!wOdPerPcDiaWt, qOdPerPcDiaWt
      SetParamsVal wRsTotals!wOdPerPcDiaPrdWt, qOdPerPcDiaPrdWt
      SetParamsVal wRsTotals!wOdPerPcDiaQty, qOdPerPcDiaQty
      SetParamsVal wRsTotals!wOdPerPcCsQty, qOdPerPcCsQty
      SetParamsVal wRsTotals!wOdPerPcCSPrdWt, qOdPerPcCsPrdWt
      SetParamsVal wRsTotals!wOdPerPcCsWt, qOdPerPcCsWt
      SetParamsVal wRsTotals!wOdMainMetRmCtg, qOdMainMetRmCtg
      
      If Not mb_CpyKT Then
        SetParamsVal wRsTotals!RmKt, wOdKt
      End If
      If Not mb_CpyCol Then
        SetParamsVal wRsTotals!OdCol, wOdDmCol
      End If
    Else
      SetParamsVal wRsTotals!wOdPerPcDiaWt, 0
      SetParamsVal wRsTotals!wOdPerPcDiaQty, 0
      SetParamsVal wRsTotals!wOdPerPcCsQty, 0
      SetParamsVal wRsTotals!wOdPerPcCsWt, 0
      SetParamsVal wRsTotals!wOdMainMetRmCtg, ""
    
    End If
    GetTotalsFromOrdRm = ForCpy_GetGldAsCstLabAsAndLabAsWt()
   
  End If
End Function

Private Sub CpyXLJRIDetails(ByVal RowNum As Long)
    If ADC("OmTc") <> "JRI" Then Exit Sub
    GrdOrdDsg.Value(RowNum, "OdDmStkYy") = ms_xlOdDmStkYy
    GrdOrdDsg.Value(RowNum, "OdDmStkCoCd") = ms_xlOdDmStkCoCd
    GrdOrdDsg.Value(RowNum, "OdDmStkChr") = ms_xlOdDmStkChr
    If GrdOrdDsg.Value(RowNum, "OdDmStkNo") = 0 Then GrdOrdDsg.Value(RowNum, "OdDmStkNo") = mi_xlOdDmStkNo
    If GrdOrdDsg.Value(RowNum, "OdOrdEnt") = 0 Then GrdOrdDsg.Value(RowNum, "OdOrdEnt") = IIF(mi_xlRepQty <> 0, mi_xlRepQty, 1)
    If GrdOrdDsg.Value(RowNum, "OdRepGrWt") = 0 Then GrdOrdDsg.Value(RowNum, "OdRepGrWt") = mi_xlOdRepGrWt
End Sub
