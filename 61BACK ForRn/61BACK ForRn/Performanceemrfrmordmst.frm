Private Sub atxt_ReCalculate(Index As Integer, ByVal IdName As String, ByVal OldVal As Variant, ByVal RowNum As Integer, ByVal SourceName As String, ByVal SourceColName As String)
  '/'- indicates that recalc should not be done during copy
  '/r'- indicates that recalc should not be done when CopyRate= 'Y'
  '/c'- indicates that recalc should not be done when CopyFromSameCust= 'Y'
  
  '*** OmChr on OmTc                              Normal
      'valid PDesc225('TC', OmTc)
  '***/ OmLmgCst on OmDt                          Normal
      'GetDtVal("LMG", OmDt, wd_DtVal)
      'OmLmgCst= wd_DtVal
      '   This procedure gets DtVal from DtTbl(DtTag= 'LMG' and max(DtDt)<= OmDt)
  '***/ OmLmgDt on OmDt                           Normal
      'GetDtVal("LMG", OmDt, ,ws_DtDt)
      'OmLmgDt= ws_DtDt
