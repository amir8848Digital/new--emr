    ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                    "PMCd= '" + ms_CpyRateCd + "' ")
    If ADC("wOmRefLabRt") = "Y" Then mf_CpyLabRate = True
    
