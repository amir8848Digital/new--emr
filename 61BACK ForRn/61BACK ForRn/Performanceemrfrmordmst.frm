                   "          Left outer join Fmd on FmdCoCd= B.FdCoCd and FmdFdYy= B.FdYy and FmdFdKey= B.FdKey and FmdPrtKey=B.FdPrtKey " + _
                   "       Where Not Exists(Select 'x' From Fgd M Where M.FdCoCd= B.FdCoCd " + _
                   "            and M.FdRefYy= B.FdYy and M.FdRefKey= B.FdKey " + _
                   "            and (Select PValue from Param where PTyp= 'TC' " + _
                   "            and PMCd= M.FdTc)= 'FWB') " + _
                   "            and (Select PValue from Param where PTyp= 'TC' and PMCd= B.FdTc)= 'FB' " + _
                   "       Group by FdPrtKey, FdIdNo, FdCoCd, FdTc, FdYy, FdChr, FdNo, FdSr) Fg " + _
                   "       On FdCoCd= OdCoCd And FdBYy= BYy And FdBChr= BChr And FdBNo= BNo And FdBYyKey= BLstYyKey " + _
                   " Left Outer Join InvFgd On IfFdIdNo=FdIdNo And IfCoCd= FdCoCd And IfFdTc= FdTc And IfFdYy= FdYy And IfFdChr= FdChr And IfFdNo= FdNo And IfFdSr= FdSr /* And IfBIdNo=FdBIdNo */ And IfFdBYy= FdBYy And IfFdBChr= FdBChr And IfFdBNo= FdBNo And IfPrtKey=FdPrtKey " + _
                   " Where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                   " BLoc= '" + ctFgLoc + "' and " + wCnd + " and OmCmCurCd= '" + ADC("OmCmCurCd") + "' And BPrtKey='" + ctCurrPrtn + "' Order By BYy, BChr, BNo")
    
                              
    Set wRsSrcOd = moCn.OpenRes("Select BYy, BChr, BNo, OrdDsg.* from OrdDsg " + _
                   " Join OrdMst On OmIdNo=OdOmIdNo And OmCoCd= OdCoCd And OmTc= OdTc And OmYy= OdYy and OmChr= OdChr and OmNo= OdNo and OmPrtKey=OdPrtKey " + _
                   " Join Bag On BOdIdNo=OdIdNo And BCoCd= OdCoCd And BOdTc= Odtc And BOdYy= OdYy And BOdChr= OdChr And BOdNo= OdNo And BOdSr= OdSr And BPrtKey=OdPrtKey " + wBagCnd + _
                    wsRfidJoin + _
                   " Left Outer Join InvFgd On IfTc='" + ctInTcTyp + "' and IfBIdNo=BIdNo And IfCoCd= BCoCd And IfFdBYy= BYy And IfFdBChr= BChr And IfFdBNo= BNo And IfPrtKey=BPrtKey " + _
                   " Where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                   " BLoc= '" + ctFgLoc + "' and " + wCnd + " and OmCmCurCd= '" + ADC("OmCmCurCd") + "' And BPrtKey='" + ctCurrPrtn + "' Order By BYy, BChr, BNo")
                   
    If Not (wRsSrcOd.EOF Or wRsSrcOd.BOF) Then
        ADC.StartCopy
        If ADC.IsNew Then
          If Not ADC.SaveRec Then
            DispMsg "X Save Failed", etInfo
            ADC.EndCopy
            Call CmdCpyBags_Click
            Exit Sub
          End If
        End If
        mf_CpyRate = IIF(ADC("WCPYBGSCPYRT") = "Y", True, False)
        'mf_CpyVal = mf_CpyRate '*** (Jen 2.13)
        mf_CpyLabRate = IIF(ADC("WCPYBGSCPYLABRT") = "Y", True, False)
        'If mf_CpyLabRate = False Then mf_CpyVal = False   '*** (Jen 2.13)
        ms_CpyRateCd = ADC("wCpyBgsCpyRtOpt")    '*** (Jen 2.13)
        ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
            "PMCd= '" + ADC("wCpyBgsCpyRtOpt") + "' ")
        If ADC("wCpyBgsCpyRt") = "Y" And ADC("wCpyBgsCpyRtOpt") = "" Then DispMsg "Copy Rate Option Is Compulsory", etError: Exit Sub
        If ADC("wCpyBgQbWtEqOrd") = "" Then DispMsg "Weight Copy Option Is Compulsory", etError: Exit Sub
        If ADC("wCpyBgQbWtEqOrd") = "N" Then mf_CpyVal = False    '*** (Jen 2.13)
        Call CpyDets(wRsSrcOd, False, True, True)
        ADC.EndCopy
    End If
  End If
  Call CmdCpyBags_Click
'****** Sachin 2.12 - 28/02/06 - Copy FG Bags in QB

End Sub

Private Sub CmdCpyInvDsg_Click()

