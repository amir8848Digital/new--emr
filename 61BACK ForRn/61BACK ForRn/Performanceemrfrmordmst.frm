                               " OdTc='" + wsOrd(0) + "' And OdYy='" + wsOrd(1) + "' And OdChr='" + wsOrd(2) + "' And OdNo=" + CStr(wsOrd(3)) + _
                               " And OdSr=" + wsOrd(4) + ") And " + _
                               " DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' " + _
                               IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                               "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                               "(Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "')) ")) Then _
        DispMsg "Invalid Dsg Cd/ Dsg On Hold/ Dsg Is Exclusive For Another Cust Or Regn For Sr. (" + CStr(i) + ") ", etError: wDsSrStr = IIF(wDsSrStr = "", "", wDsSrStr + ",") + CStr(GrdDsgStk.Value(i, "wDsSr")): GoTo NextRow
    Else
        
        If Not moCn.RecSeek("Select 'x' from InvDsg where " + _
                        "IdCoCd= '" + ADC("WDSCPYCOCD") + "' and IdTc= '" + wsOrd(0) + "' and " + _
                        "IdYy= '" + wsOrd(1) + "' and IdChr= '" + wsOrd(2) + "' and " + _
                        "IdNo= " + CStr(wsOrd(3)) + " And IdSr= " + CStr(wsOrd(4)) + "  And IdPrtKey='" + ctCurrPrtn + "'  ") Then _
