Private Sub CmdOrdCpy_Click()
    '*** Display or hide the Order Copy frame depending on the toggle state
    
    If moCn.RecSeek("Select 'x' from InvHd Where InCoCd='" + ADC("OmCoCd") + "' and InTc='" + ADC("OmTc") + "' " + _
                  " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' ") Then mInvExists = True

    
    
    '*** Display or hide the Refresh Rate frame depending on the toggle state
    If mf_DtLocked = True Then DispMsg "Cannot Refresh Rates In Locked Entry", etError: Exit Sub
    
    '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
    If ADC("OmPrtKey") <> ctCurrPrtn Or (ADC("OmTc") <> "PL" And CDate(ms_PurgeDt) > ADC("OmDt")) Then DispMsg "Cannot Copy In Previous Partition Orders/Orders Prior to Purge Date", etError: Exit Sub
  
    '*** urmi Validity of Customer Code
    Dim wb_ValidCmCd As Boolean
    ' ***** Manali Trading Module - 'C' Replaced By adc("OmCmCtg")
    wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= '" + ADC("OmCmCtg") + "' and " + _
                            "CmCd = '" + ADC("OmCmCd") + "'")
'    wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= 'C' and " + _
'                            "CmCd = '" + adc("OmCmCd") + "'")
     
    If wb_ValidCmCd = False Then DispMsg "Invalid Customer code", etError: Exit Sub
    '*** urmi Validity of Customer Code
    
    ' **** Manali Trading Module
    If ms_OmTcTyp = ctJtTcTyp Then
      If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                          "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
        DispMsg "Invalid From Design Location", etError: Exit Sub
      If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                          "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
        DispMsg "Invalid To Design Location", etError: Exit Sub
       If ms_OmTc = "JIN" Then
        If ADC("OmBaseCoCd") = "" Then DispMsg "Base Company Code Cannot be Blank.", etError: Exit Sub
           ADC("WOCOCD") = ADC("OmBaseCoCd"): ADC("wOCoCd").Enabled = False
        End If
    End If
    

    'Or mf_UsrFlag = False
    If mf_DtLocked = True Then Exit Sub
    
    If RetMemExists = True Then Exit Sub    '*** (Jen 2.13)
    ' Zubin 213
    If ADC("OmCnvFct") = "0" Then DispMsg "Conversion Factor Should Be > 0", etError: Exit Sub
    If ADC("OmMulDiv") = "" Then DispMsg "Conversion Factor From Base Currency To Voucher Currency Not Defined In Date Table", etError: Exit Sub
    ' Zubin 213
    
    ' **** Manali Trading Module
    If ms_OmTcTyp = ctJtTcTyp Then
      If Not mInvExists And CmdInvHd.Visible Then DispMsg "Invoice Header Not Created", etError: Exit Sub
    End If
  
    chkFCInst.Value = vbUnchecked
    chkFCMinMaxWt.Value = vbUnchecked
    chkFCPOSubPO.Value = vbUnchecked
    chkFCSTW.Value = vbUnchecked
    
    ' ########################  Manoj #### Ver: 2.0.9 #### Date: 01/12/2004  ########################
    If Trim(ADC("WOCOCD")) = "" Then ADC("WOCOCD") = ADC("OMCOCD")

    '****** Zubin 3.02.01 - 26/03/08
    ADC("WCPYCHGPTRONSTWYN") = ADC("OMCHGPTRONSTWYN")
    '****** Zubin 3.02.01 - 26/03/08

    ' ########################  Manoj #### Ver: 2.0.10 #### Date: 09/05/2005  ########################
    'ADC("WOCOCD").Enabled = (Not gb_SingleCoCd) And UCase$(Left$(gs_CoNm, 8)) = "DIAJEWEL"
    ' ***** Manali 3.10.0 - 12/04/12 - "PL" added below to allow copy from QT
    If ms_OmTcTyp = "SO" Or ms_OmTcTyp = "QT" Or ms_OmTcTyp = "PL" Then
      '*** (Jen 3.01)
      If mb_CustomiseOrd = False Then
        ADC("woCoCd").Enabled = True
      Else
        Call SetMedEnaVis("woCoCd", True, True)
      End If
