Private Sub cmdStkCpy_Click()
  ' **** Manali Trading Module
  '*** Display or hide the Stock Copy frame depending on the toggle state
  
  If moCn.RecSeek("Select 'x' from InvHd Where InCoCd='" + ADC("OmCoCd") + "' and InTc='" + ADC("OmTc") + "' " + _
                  " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' ") Then mInvExists = True

  
  If mf_DtLocked = True Then DispMsg "Cannot Copy In Locked Entry", etError: Exit Sub
  
  If ADC("OmPrtKey") <> ctCurrPrtn Or CDate(ms_PurgeDt) > ADC("OmDt") Then DispMsg "Cannot Copy In Previous Partition Orders/Orders Prior to Purge Date", etError: Exit Sub

  Dim wb_ValidCmCd As Boolean
  wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= '" + ADC("OmCmCtg") + "' and " + _
                          "CmCd = '" + ADC("OmCmCd") + "'")
   
  If wb_ValidCmCd = False Then DispMsg "Invalid " + mCmCtgName + "  code", etError: Exit Sub
  
  If mf_DtLocked = True Then Exit Sub
  
  If RetMemExists = True Then Exit Sub
  
  If ADC("OmCnvFct") = "0" Then DispMsg "Conversion Factor Should Be > 0", etError: Exit Sub
  If ADC("OmMulDiv") = "" Then DispMsg "Conversion Factor From Base Currency To Voucher Currency Not Defined In Date Table", etError: Exit Sub
  
  
  If ms_OmTcTyp = ctJtTcTyp Then
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
      DispMsg "Invalid From Design Location", etError: Exit Sub
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
      DispMsg "Invalid To Design Location", etError: Exit Sub
    If ms_OmTc = "JIN" Then
        If ADC("OmBaseCoCd") = "" Then DispMsg "Base Company Code Cannot be Blank.", etError: Exit Sub
           ADC("wDsCpyCoCd") = ADC("OmBaseCoCd"): ADC("wDsCpyCoCd").Enabled = False
    End If
  End If

  ' **** Manali Trading Module
  If ms_OmTcTyp = ctJtTcTyp Then
    If Not mInvExists And CmdInvHd.Visible Then DispMsg "Invoice Header Not Created", etError: Exit Sub
  End If

  Call DispFra(StkCpy)

  If FraStkCpy.Visible = True Then
    ' ***** Manali 3.7.1 - Copy From Voucher
    If ADC("wDsCpyFrYn") = "" Then ADC("wDsCpyFrYn") = "Y"
    If ADC("wDsDtFr") = "" Then ADC("wDsDtFr") = moCn.GetFldVal("Select DateAdd(mm,-1,Getdate())")  '"01/01/80"
    If ADC("wDsDtTo") = "" Then ADC("wDsDtTo") = moCn.SrvrDate '"01/01/80"
    If ADC("wDsCpyCoCd") = "" Then ADC("wDsCpyCoCd") = ADC("OmCoCd")
    If ADC("wDsCmCtg") = "" Then ADC("wDsCmCtg") = moCn.GetFldVal("Select TmSrcCmCtg From TcMst where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "'")
    If ADC("wDsCmCd") = "" And ADC("wDsCmCtg") = ADC("OmCmCtg") Then ADC("wDsCmCd") = ADC("OmCmCd")
    
    If ADC("wDsSLocFr") = "" And ADC("wDsSLocTo") = "" Then ADC("wDsSLocFr") = ADC("OmFrDmLoc"): ADC("wDsSLocTo") = ADC("OmFrDmLoc")
    
    
    
    If mBaseTc <> "" And ADC("wDsCpyTc") = "" Then ADC("wDsCpyTc") = mBaseTc
    If mRefTc <> "" And ADC("wDsCpyTc") = "" Then ADC("wDsCpyTc") = IIF(InStr(1, mRefTc + ",", ",", vbTextCompare) > 0, Mid(mRefTc, 1, InStr(1, mRefTc + ",", ",", vbTextCompare) - 1), mRefTc)
    If ADC("wDsCpyTc") = "" And mSrcTc <> "" Then ADC("wDsCpyTc") = IIF(InStr(1, mSrcTc + ",", ",", vbTextCompare) > 0, Mid(mSrcTc, 1, InStr(1, mSrcTc + ",", ",", vbTextCompare) - 1), mSrcTc)
    If ms_OmTc = "JPO" Or ms_OmTc = "JSO" Then ADC("wDsCpyDmId") = "N"
    
    
    If moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' and TmBaseMustYn='Y' ") Then
      ADC("wDsCpyFrYn").Enabled = False
    End If
     ' ***** Manali 3.7.1 - Copy From Voucher
  ' ***** Bef 3.7.1
  '    adc("wDsDmCdFr").CmpStr = "DDmCd >=": adc("wDsDmCdTo").CmpStr = "DDmCd <="
  '    adc("wDsOdSfxFr").CmpStr = "DOdSfx >=": adc("wDsOdSfxTo").CmpStr = "DOdSfx <="
  '    adc("wDsDmSzFr").CmpStr = "DDmSz >=": adc("wDsDmSzTo").CmpStr = "DDmSz <="
  '    adc("wDsDmIdFr").CmpStr = "DDmId >=": adc("wDsDmIdTo").CmpStr = "DDmId <="
  '    adc("wDsSLocFr").CmpStr = "DLoc >=": adc("wDsSLocTo").CmpStr = "DLoc <="
  Else
    ADC("wDsDmCdFr").CmpStr = "": ADC("wDsDmCdTo").CmpStr = ""
    ADC("wDsOdSfxFr").CmpStr = "": ADC("wDsOdSfxTo").CmpStr = ""
    ADC("wDsDmSzFr").CmpStr = "": ADC("wDsDmSzTo").CmpStr = ""
    ADC("wDsDmStkNoFr").CmpStr = "": ADC("wDsDmStkNoTo").CmpStr = ""
    ADC("wDsDmStkYyFr").CmpStr = "": ADC("wDsDmStkYyTo").CmpStr = ""
    ADC("wDsDmStkChrFr").CmpStr = "": ADC("wDsDmStkChrTo").CmpStr = ""
    ADC("wDsSLocFr").CmpStr = "": ADC("wDsSLocTo").CmpStr = ""
    ADC("wDsDtFr").CmpStr = "": ADC("wDsDtTo").CmpStr = ""
    ADC("wDsCpyTc").CmpStr = ""
    ADC("WDSCPYCOCD").CmpStr = "": ADC("WDSCMCTG").CmpStr = "": ADC("WDSCMCd").CmpStr = ""
  End If

End Sub

Private Sub cmdStkCpyDsg_Click()
  Dim wo_rsSrcOd As MwfLib.MDORowSet, i As Integer
  
  If ADC("OMLOCKYN") = "Y" Then DispMsg "Cannot Copy As Current Order is Locked", etError: Exit Sub
  If ADC("OMLOCKSALPRCYN") = "Y" Then DispMsg "Cannot Copy As Current Order Sales Price is Locked.", etError: Exit Sub
  If ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then DispMsg "Cannot Copy, Invoice Is Closed.", etError: Exit Sub
  
  If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
    DispMsg "Order/Quotation is Unacknowledged,Acknowledge to Edit Value", etError: Exit Sub
  ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
    DispMsg "Order/Quotation is Submitted,Can not Copy.", etError: Exit Sub
  End If
  
  If GrdDsgStk.Rows = 1 Then Exit Sub
  'adc("wDsCpyDmId") = "Y"
  mf_CpyRate = False: mf_CpyLabRate = False
  ms_CpyRateCd = "": ms_CpyRateOpt = ""
  mf_CpyFrSameCust = False
  mf_CpyVal = False
  mf_CpyRate = False
  mf_CpyLabRate = False
  mf_CpyRtByStk = False
  ms_CpyRtByStkOpt = ""
  mf_CpyDmId = False
  mf_CpyFrBase = False
  mf_CpyFrRef = False
  mb_CpyKT = False   ' ***** Manali 3.9.0 - Copy KT from PDC
  
  If ADC("wDsCpyDmId") = "Y" Then mf_CpyDmId = True
  ' ***** Manali 3.7.1
  
  If mBaseTc <> "" And InStr(1, "," + mBaseTc + ",", "," + ADC("wDsCpyTc") + ",") >= 1 Then
     mf_CpyFrBase = True
   'ElseIf mRefTc = adc("wDsCpyTc") Then
   ElseIf InStr(1, "," + mRefTc + ",", "," + ADC("wDsCpyTc") + ",") >= 1 Then
     mf_CpyFrRef = True
  End If
   
  
  'If ms_CpySrcStk = "Y" Then
     
   If ADC("wDsCpyRt") = "Y" Then
     mf_CpyRate = True
   End If
   If ADC("wDsCpyLabRt") = "Y" Then mf_CpyLabRate = True
   ms_CpyRateCd = ADC("wDsCpyRtOpt")
   ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and PMCd= '" + ADC("wDsCpyRtOpt") + "' ")
   If ADC("OmTc") <> "JPO" Then mf_CpyFrSameCust = True
   
   If mf_CpyLabRate And mf_CpyRate And ms_CpyRateCd = "GPSLDCXM" Then mf_CpyVal = True: mf_CpySalPrc = True
   
   
   If ADC("wDsCpyRt") = "Y" Then
     mf_CpyRate = True
   End If
 ' End If
  ' ***** Manali 3.7.1
  
  
  Dim wOrdVch As String, wsOrd() As String
  Dim wDsSrStr As String
  

  For i = 1 To GrdDsgStk.Rows - 1
  If GrdDsgStk.Value(i, "wDsCpyYn") = "Y" Then
    
    With GrdDsgStk
      ' ***** Manali 3.7.1
      If ms_CpySrcStk = "Y" Then
        wOrdVch = .Value(i, "wDsSrcVch")
      Else
        If ADC("WDSCPYTC") = "IN" Then
                wOrdVch = moCn.GetFldVal("Select Top 1 IdTc+'/'+IdYy+'/'+IdChr+'/'+LTrim(Str(IdNo))+'/'+LTrim(Str(IdSr)) " + _
                "from InvDsg Join InvHd on IdInIdNo=InIdNo And " + _
                "IdCoCd=InCoCd and IdTc=InTc and IdYy=InYy and IdChr=InChr and IdNo= InNo and IdPrtKey=InPrtKey " + _
                "Where IdCoCd= '" + ADC("WDSCPYCOCD") + "' and IdDmCd='" + .Value(i, "wDsDmCd") + "' and " + _
                "IdSfx='" + .Value(i, "wDsOdSfx") + "' and IdDmSz='" + .Value(i, "wDsDmSz") + "' and " + _
                "IdTc ='IN' " + _
                "and IdPrtKey='" + ctCurrPrtn + "' Order by InDt Desc, IdIdNo Desc")
            
        Else
           ' ***** Manali 3.7.1
              wOrdVch = moCn.GetFldVal("Select Top 1 OdTc+'/'+OdYy+'/'+OdChr+'/'+LTrim(Str(OdNo))+'/'+LTrim(Str(OdSr)) " + _
                "from OrdDsg Join OrdMst on OdOmIdNo=OmIdNo And " + _
                "OdCoCd=OmCoCd and OdTc=OmTc and OdYy=OmYy and OdChr=OmChr and OdNo= OmNo and OdPrtKey=OmPrtKey " + _
                "Where OdCoCd= '" + ADC("WDSCPYCOCD") + "' and OdDmCd='" + .Value(i, "wDsDmCd") + "' and " + _
                "OdDmStkYy ='" + CStr(.Value(i, "wDsDmStkYy")) + "' and " + _
                "OdDmStkChr ='" + CStr(.Value(i, "wDsDmStkChr")) + "' and " + _
                "OdDmStkNo = " + CStr(.Value(i, "wDsDmStkNo")) + " and " + _
                "OdSfx='" + .Value(i, "wDsOdSfx") + "' and OdDmSz='" + .Value(i, "wDsDmSz") + "' and " + _
                "OdTc In  (Select PMCd from Param where Ptyp= 'TC' and PValue = '" + ms_OmTcTyp + "') " + _
                "and OdPrtKey='" + ctCurrPrtn + "' Order by OmDt , OdIdNo")
         End If
      End If
        'IIF(mBaseTc <> "", " and OdTc In ('" + mBaseTc + "') ", IIF(mRefTc <> "", " and '," + mRefTc + ",' Like '%,'+OdTc+',%' ", ""))
    End With

    wsOrd = Split(wOrdVch, "/")
    If UBound(wsOrd) <> 4 Then DispMsg "Invalid  Voucher Format", etError: wDsSrStr = IIF(wDsSrStr = "", "", wDsSrStr + ",") + CStr(GrdDsgStk.Value(i, "wDsSr")): GoTo NextRow
    If Not IsNumeric(wsOrd(3)) Then DispMsg "Invalid Voucher No Format", etError: wDsSrStr = IIF(wDsSrStr = "", "", wDsSrStr + ",") + CStr(GrdDsgStk.Value(i, "wDsSr")): GoTo NextRow
    If Not IsNumeric(wsOrd(4)) Then DispMsg "Invalid Voucher Sr Format", etError: wDsSrStr = IIF(wDsSrStr = "", "", wDsSrStr + ",") + CStr(GrdDsgStk.Value(i, "wDsSr")): GoTo NextRow

