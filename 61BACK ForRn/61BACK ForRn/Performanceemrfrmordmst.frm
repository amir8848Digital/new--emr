      'GetLmgSal = if exists (RrSalRt from RmRt(RrTcTyp = 'LMG', RrCtg= 'G',
      '                                         RrFrLn <= OmLmgCst, RrToLn >= OmLmgCst,
      '                                         RrCmCd= OmCmCd, RrSalRt<> 0)
      '
      '            else (RrSalRt from RmRt(RrTcTyp = 'LMG', RrCtg= 'G', RrFrLn <= OmLmgCst,
      '                                    RrToLn >= OmLmgCst, RrCmCd= 'ZSELF', RrSalRt<> 0)
      '                 *(1+ (Select RrSalRt from RmRt(RrTcTyp = 'INC', RrCtg = 'G',
      '                   RrCmCd = OmCmCd)/100)
      '
      'If GetLmgSal = 0 then OmLmgSal = OmLmgCst
  '***/c OmCmDelTerms on OmCmCd                   Normal,Copy
      'OmCmDelTerms= CmDelTerms from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/c OmCmPayTerms on OmCmCd                   Normal,Copy
      'OmCmPayTerms= CmPayTerms from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/r OmMulBy on OmCmCd                        Normal,Copy
      'OmMulBy= CmMulBy from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '*** OmFixPrc on OmCmCd                         Normal
      'OmFixPrc= CmFixPrc from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '*** OmGldAs on OmCmCd                          Normal
      'OmGldAs= CmGldAs from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '*** OmLabAs on OmCmCd                          Normal
      'OmLabAs= CmLabAs from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/r OmIWtEqOrd on OmCmCd                     Normal,Copy
      'OmIWtEqOrd= CmIWtEqOrd from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/r OmIWtFrOrd on OmCmCd                     Normal,Copy
      'If OmIWtEqOrd = 'Y' Then OmIWtFrOrd = Blank else
      'OmIWtFrOrd= CmIWtFrOrd from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/r OmIRtEqOrd on OmCmCd                     Normal,Copy
      'OmIRtEqOrd= CmIRtEqOrd from CustMst(CmCtg= 'C', CmCd= OmCmCd)
  '***/r wOdHldDesc on wOdHld                     Normal
      'If wOdHld= 'N' then wOdHldDesc= ''
  '*** wOdPrdQty on wOdPrdEnt,OaPrdQty            Normal
      'wOdPrdQty= wOdPrdEnt+ sum(OaPrdQty) for the DsgSr
  '*** wDsgSfx on wDsgSrNo                        Normal
      'If wDsgSrNo <> 0 then wDsgSfx= ''
  '*** wDsgSz on wDsgSrNo                         Normal
      'If wDsgSrNo <> 0 then wDsgSz= ''
  '*** wDsgCpyRt on wDsgSource                    Normal
      'If wDsgSource= ctDsgCpyCust then wDsgCpyRt= 'Y'
      'If wDsgSource= ctDsgCpyMst or ctDsgCpySelf then wDsgCpyRt= 'N'
  '*** wDsgSource on wDsgDmCd, wDsgSfx, wDsgSz    Normal
      'If wDsgSrNo= 0 then
      '   Check If Dsg, Sfx and Sz Combination Exists In Party-Design Combination Master For The Specified Cust. If then wDsgSource= Cust ***
      '   If Not, Check If Dsg, Sfx and Sz Combination Exists In Party-Design Combination Master For ZSelf. If then wDsgSource= Self ***
      '   If Not, Check If Dsg, Sfx and Sz Combination Exists In DsgMst. If Then wDsgSource= DsgMst ***
      'If wDsgSrNo<> 0 then wDsgSource= ''
  '*** wDsgSrcVch on wDsgSource                   Normal
      'If wDsgSource= Cust or ZSelf then give the voucher no from which the copy is taking
      'place
      'else wDsgSrcVch = ''
  '*** wCustFr on wOmTc,wOmYy,wOmChr,wOmNo        Normal
      'wCustFr= OmCmCd from
      'OrdMst(wOmTc= OmTc and wOmYy= OmYy and wOmChr= OmChr and wOmNo= OmNo)
  '*** wOmChr on wOmTc                            Normal
      'wOmChr= PDesc225('TC', wOmTc)
  '*** wCpyRt on wCustFr                          Normal
      'If wCustFr= OmCmCd then wCpyRt= 'Y' else wCpyRt= 'N'
  '*** OmDelDt on OmDt                            Normal
      'OmDelDt= OmDt
  '*** OmExpDelDt on OmDt                         Normal
      'OmExpDelDt= OmDt
  '*** wCpyRtOpt on wCpyRt                        Normal
      'If wCpyRt = 'Y' then wCpyRtOpt= HOrdCpyRtOpt from Head
      'If wCpyRt = 'N' then wCpyRtOpt= ''
  '*** wDsgCpyRtOpt on wDsgCpyRt                  Normal
      'If wDsgCpyRt = 'Y' then wDsgCpyRtOpt= HOrdCpyRtOpt from Head
      'If wDsgCpyRt = 'N' then wDsgCpyRtOpt= ''
  
  Dim i As Integer
  Dim wCmCd As String, wCustName As String, wd_DtVal As Double, ws_DtDt As String
  Dim wCmCtg As String      ' ***** Manali Trading Module
    
  Select Case UCase(IdName)

  Case Is = UCase("OmChr")
        If ADC.Mode = xNorm Then
         ADC("OmChr") = moCn.GetFldVal("Select vPValue from vParam where " + _
                                    "vPCoCd= '" + ADC("OmCoCd") + "' and vPTyp='DEFCHR' " + _
                                    "and vPMCd='" + ADC("OmTc") + "'")
         '("Select PDesc225 from Param where PTyp='TC' " + _
                                        "and PMCd='" + ADC("OmTc") + "'")
        End If
  
  Case Is = UCase("OmLmgCst")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          ' Zubin 213 (OmCmCurCd added)
          Call GetDtVal("LMG", ADC("OmDt"), wd_DtVal, , ADC("OmCmCurCd"))
          ADC("OmLmgCst") = wd_DtVal
        End If
  
  Case Is = UCase("OmLmgDt")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          ' Zubin 213 (OmCmCurCd added)
          Call GetDtVal("LMG", ADC("OmDt"), , ws_DtDt, ADC("OmCmCurCd"))
          ADC("OmLmgDt") = ws_DtDt
        End If
  
  Case Is = UCase("OmLmgSal")
        '*** Jay 3.4(FG)
        If (ADC.Mode = xNorm And ms_OmTc <> "FG") Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",G,") <= 0))) Then
        'If ADC.Mode = xNorm Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",G,") <= 0))) Then
        '*** Jay 3.4(FG)
          ' Zubin 213
          ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpRmRt") passed as parameter if not blank
          ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
          ADC("OmLmgSal") = GetLmgSal("LMG", ADC("OmCmCd"), ADC("OmLmgCst"), ADC("OmCmCtg"), ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""))
          If ADC("OmLmgSal") = 0 Then ADC("OmLmgSal") = ADC("OmLmgCst")
        End If
  
  Case Is = UCase("OmLmpCst")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          ' Zubin 213 (OmCmCurCd added)
          Call GetDtVal("LMP", ADC("OmDt"), wd_DtVal, , ADC("OmCmCurCd"))
          ADC("OmLmpCst") = wd_DtVal
        End If
  
  Case Is = UCase("OmLmpDt")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          ' Zubin 213 (OmCmCurCd added)
          Call GetDtVal("LMP", ADC("OmDt"), , ws_DtDt, ADC("OmCmCurCd"))
          ADC("OmLmpDt") = ws_DtDt
        End If
  
  Case Is = UCase("OmLmpSal")
        '*** Jay 3.4(FG)
        If (ADC.Mode = xNorm And ms_OmTc <> "FG") Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",P,") <= 0))) Then
        'If ADC.Mode = xNorm Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",P,") <= 0))) Then
        '*** Jay 3.4(FG)
          ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpRmRt") passed as parameter if not blank
          ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
          ADC("OmLmpSal") = GetLmgSal("LMP", ADC("OmCmCd"), ADC("OmLmpCst"), ADC("OmCmCtg"), ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""))
          If ADC("OmLmpSal") = 0 Then ADC("OmLmpSal") = ADC("OmLmpCst")
        End If
  
'*************************** URMI 11/07/03 **************************************
  Case Is = UCase("wOmLmgCst")
        If ADC.Mode = xNorm Then
           ' Zubin 213 (OmCmCurCd added)
           ADC("wOmLmgCst") = moCn.GetFldVal("Select DtVal from DtTbl where DtTag= 'LMG' and " + _
               "DtCurCd1= '" + ADC("OmCmCurCd") + "' and DtDt=(Select max(DtDt) from DtTbl where DtTag='LMG' and " + _
               "DtDt <= '" + CStr(ADC("wOmRefreshDt")) + "' and DtCurCd1= '" + ADC("OmCmCurCd") + "') ")
        End If

' ****** Sachin 2.12 - 01/12/05 - SJM ******
 Case Is = UCase("OmLmsCst")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          If mf_SlvMod = True Then
            ' Zubin 213 (OmCmCurCd added)
            Call GetDtVal("LMS", ADC("OmDt"), wd_DtVal, , ADC("OmCmCurCd"))
            ADC("OmLmsCst") = wd_DtVal
          Else
            ADC("OmLmsCst") = 1
          End If
        End If
    
 Case Is = UCase("OmLmsDt")
        '*** Jay 3.4(FG)
        If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
        'If ADC.Mode = xNorm Then
        '*** Jay 3.4(FG)
          If mf_SlvMod = True Then
            ' Zubin 213 (OmCmCurCd added)
            Call GetDtVal("LMS", ADC("OmDt"), , ws_DtDt, ADC("OmCmCurCd"))
            ADC("OmLmsDt") = ws_DtDt
          Else
            ADC("OmLmsDt") = ADC("OmDt")
          End If
        End If
    
 Case Is = UCase("OmLmsSal")
        '*** Jay 3.4(FG)
        If (ADC.Mode = xNorm And ms_OmTc <> "FG") Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",S,") <= 0))) Then
        'If ADC.Mode = xNorm Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",S,") <= 0))) Then
        '*** Jay 3.4(FG)
          If mf_SlvMod = True Then
            ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpRmRt") passed as parameter if not blank
            ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
            ADC("OmLmsSal") = GetLmgSal("LMS", ADC("OmCmCd"), ADC("OmLmsCst"), ADC("OmCmCtg"), ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""))
            If ADC("OmLmsSal") = 0 Then ADC("OmLmsSal") = ADC("OmLmsCst")
          Else
            ADC("OmLmsSal") = 1
          End If
        End If
' ****** Sachin 2.12 - 01/12/05 - SJM ******

' **** Manali 3.03 - 19/06/08 - Pd Module ******
  Case Is = UCase("OmLmlCst")
      '*** Jay 3.4(FG)
      If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
      'If ADC.Mode = xNorm Then
      '*** Jay 3.4(FG)
        If mf_PdMod = True Then
          Call GetDtVal("LML", ADC("OmDt"), wd_DtVal, , ADC("OmCmCurCd"))
          ADC("OmLmlCst") = wd_DtVal
        Else
          ADC("OmLmlCst") = 1
        End If
      End If
      
  Case Is = UCase("OmLmlDt")
      '*** Jay 3.4(FG)
      If ADC.Mode = xNorm And ms_OmTc <> "FOT" Then
      'If ADC.Mode = xNorm Then
      '*** Jay 3.4(FG)
        If mf_PdMod = True Then
          Call GetDtVal("LML", ADC("OmDt"), , ws_DtDt, ADC("OmCmCurcd"))
          ADC("OmLmlDt") = ws_DtDt
        Else
          ADC("OmLmlDt") = ADC("OmDt")
        End If
      End If
      
  Case Is = UCase("OmLmlSal")
      '*** Jay 3.4(FG)
      If (ADC.Mode = xNorm And ms_OmTc <> "FG") Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",L,") <= 0))) Then
      'If ADC.Mode = xNorm Or (ADC.Mode = xCopy And (mf_CpyRate = False Or (mf_CpyRate = True And InStr(1, "," + ms_CpyRateOpt + ",", ",L,") <= 0))) Then
      '*** Jay 3.4(FG)
        If mf_PdMod = True Then
          ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpRmRt") passed as parameter if not blank
          ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
          ADC("OmLmlSal") = GetLmgSal("LML", ADC("OMCmCd"), ADC("OmLmlCst"), ADC("OmCmCtg"), ADC("OmCmCurCd"), IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), ""))
          If ADC("OmLmlSal") = 0 Then ADC("OmLmlSal") = ADC("OmLmlCst")
        Else
          ADC("OmLmlSal") = 1
        End If
      End If
' **** Manali 3.03 - 19/06/08 - Pd Module ******

  Case Is = UCase("wOmLmgDt")
        If ADC.Mode = xNorm Then
          ' Zubin 213 (OmCmCurCd added)
          ADC("wOmLmgDt") = moCn.GetFldVal("Select max(DtDt) from DtTbl where DtTag='LMG' and " + _
               "DtCurCd1= '" + ADC("OmCmCurCd") + "' and DtDt <= '" + CStr(ADC("wOmRefreshDt")) + "' ")
        End If

  Case Is = UCase("wOmLmgSal")
        If ADC.Mode = xNorm Then
          Dim wInc As Double, wRrCtg As String, wCmLkUpRmRt As String
          
          wRrCtg = "G"
          
          '********** Increments on Self Record *********
          ' ***** Manali Trading Module - OmCmCtg added
          wInc = moCn.GetFldVal("Select RrSalRt from RmRt where RrTcTyp = 'INC' " + _
                 "and RrCtg = '" + wRrCtg + "' and RrCmCtg='" + ADC("OmCmCtg") + "' and RrCmCd =  '" + ADC("OmCmCd") + "'  and RrPrtKey='" + ctCurrPrtn + "'")
          ' ***** Manali 3.03 - 17/07/08 - LkUp fields from Order given preference
          ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
          wCmLkUpRmRt = IIF(ADC("OmLkUpRmRt") <> "", ADC("OmLkUpRmRt"), _
                            moCn.GetFldVal("Select CmLkUpRmRt from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd= '" + ADC("OmCmCd") + "'"))
        
          '********** 1st get sale rate from PLCust (CmLkUpRmRt), then from Cust record;
          '********** then from Self (applying increments for the customer)
          ' Zubin 213 (OmCmCurCd added)
          ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
            ADC("wOmLmgSal") = moCn.GetFldVal("Select IsNull" + _
