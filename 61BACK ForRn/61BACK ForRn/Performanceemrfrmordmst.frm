              wCol = moCn.GetFldVal("Select IsNull((Select PmCd From Param where PTyp='DMCOL' and PMCd='" + wCol + "' and PSCd=''),'-')")
           End If
         End If
        
      End If
         If wCol <> "" Then .Value(GrdOrdDsg.Row, "OdDmCol") = wCol
          Controls(SourceName).AddSave "GrdOrdDsg", asCurrent
     End If
      
    Case Is = UCase("OdDelDt")
      If .Mode = fgmnorm And ADC.Mode = xNorm Then
        For i = 1 To GrdOrdDsg.Rows - 1
          .Value(i, "OdDelDt") = ADC("OmDelDt")
        Next i
        ADC.AddSave "GrdOrdDsg", asAll
      End If
    Case Is = UCase("OdExpDelDt")
      If .Mode = fgmnorm And ADC.Mode = xNorm Then
