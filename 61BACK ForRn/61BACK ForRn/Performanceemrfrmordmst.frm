                                                            " CrCtg = '" + ADC("OmCmCtg") + "' And CrCd = '" + ADC("OmCmCd") + "' and CrRmCtg = '" + .Value(RowNum, "OrRmCtg") + "' And " + _
                                                            " CrOurRmCd ='" + .Value(RowNum, "OrRmCd") + "'  and " + CStr(.Value(RowNum, "OrLn1")) + " Between CrFrLn and CrToLn),'')")
         ADC("wOrCustRmCd") = .Value(RowNum, "OrCustRmCd")
      End If
    End Select
  End With
End Sub
Private Sub GrdOrdRm_ColChangeDone(ByVal RowNum As Integer, ByVal ColName As String, ByVal NewValue As Variant, Cancel As Boolean, ErrMsg As String)
  With GrdOrdRm
    Select Case ColName
    Case Is = UCase("OrRmWt")
        GrdOrdRm.Value(2, "OrWt") = 4.5
    End Select
  End With
End Sub
Private Sub SRIGrdOrdRm_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String, Optional ByVal ForcedRun As Boolean = False)
      If Not ForcedRun Then Exit Sub
  '*** OrWt on OrRmCd,OrRmCtg,OrRmSCtg,OrLn1,OrLn2,OrQty    Normal
      ' If the SourceColName= OrRmCd (i.e. if OrRmCd has triggered the recalc)
      '     and OrRmCtg= 'G' or 'P' then
      '     if RmCtg of Old RmCode = RmCtg of New RmCode Then
      '         OrWt= OrWt* (RmSpGrav of New RmCd) / (RmSpGrav of Old RmCd)
      '     Else
      '         OrWt= 0
      ' Else
      '     If SourceColName is OrRmCd then
      '         calculate the OrWt only when OrWt is Zero or the OldRmCtg <> NewRmCtg
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
      '     If the SourceColName is not OrRmCd then
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
  
  '***/r OrSalRt on OrRmCtg,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      'If OrRmCtg= 'G' or 'P' then
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= ''
      '      for the specified customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      '   Apply the Inc % for the specified cust if SalRt is from customer= 'ZSELF' record
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '' for the specified customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      'Else
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrSalRt<> 0
      '      for the specified customer and for the specific Rate By option.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, for customer= 'ZSELF' and for the specific Rate By option.
  '***/r OrSalVal on OrMainMet,OrSalRt,OrWt                 Normal,Copy
      ' If OrMainMet= 'Y' then OrSalVal= OdGldAsWt* OrSalRt
      ' If OrMainMet= 'N' then OrSalVal= OrWt* OrSalRt
  '*** OrSetSCd on OrRmCtg,OrRmSCtg                         Normal
      ' OrSetSCd= ''
  '*** OrLn1 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn1= 0
  '*** OrLn2 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn2= 0
  '*** OrQty on OrRmCtg,OrRmSCtg                            Normal
      ' OrQty= 0
  '***/r OrSetSalRt on OmCmCd,OrSetSCd                      Normal,Copy
      'Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for the specified customer.
      'If Not, Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for customer= 'ZSELF'.
  '***/r OrSetSalVal on OmCmCd,OrSetSCd,OrSetSalRt,OrQty               Normal,Copy
      'GetLabVal(OmCmCd, 'SET', OrSetSCd, OrSetSalRt, OrQty, 0, 'Q', 'S')
  '*** OrSubShp on OrRmCtg,OrRmSCtg                         Normal
      ' OrSubShp= Blank
  '*** OrAlyCd on OmCmCd,OrRmCd,OdDmCol                     Normal
      'Check if CaAlyCd exists in CustAly(CaCtg='C', CaCd= OmCmCd, CaRmCd= OrRmCd
      '   CaDmCol=OdDmCol)
      'Check if CaAlyCd exists in CustAly(CaCtg='C', CaCd= 'ZSELF', CaRmCd= OrRmCd
      '   CaDmCol=OdDmCol)
  '***/r OrAlySalRt on OmCmCd,OrAlyCd                       Normal,Copy
      'GetRMRt(OmCmCd, OrAlyCd, 0, 0, 0, 'S')
  '*** OrWsQty on OrRmCtg,OrQty                             Normal
      'If OrRmCtg= 'D' or 'C' then OrWsQty= OrQty and OrHsQty= OrQty- OrWsQty else 0
  '*** OrHsQty on OrWsQty, OrQty                            Normal
      'If OrQty- OrWsQty> 0 then OrHsQty= OrQty- OrWsQty else 0
  '*** OrMainMet on OrRmCtg                                 Normal
      'OrMainMet= 'N'
  '***/r OrCstRt
      'Similar to OrSalRt except that here the Cost Rate is calculated instead of the sale rate
  '***/r OrCstVal
      'OrCstVal= OrWt * OrCstRt
  '***/r OrSetCstRt
      'Similar to OrSetSalRt except that here the Cost Setting Rate is calculated instead of the sale Setting Rate
  '***/r OrSetCstVal
      'Similar to OrSetSalVal except that here the Cost Setting Value is calculated instead of the sale Setting Value
  '***/r OrAlyCstRt
      'Similar to OrAlySalRt except that here the Cost Rate is calculated instead of the Sale Rate
  
  Dim wOldRmCtg As String, wRmSTWGrp As String
  Dim wOldSpGrav As Single, wNewSpGrav As Single
  Dim wOldRmSCtg As String
  
  Dim wRmDetOld As String, wRmSTWGrpOld As String    '*** (Jen 3.1.3)
  Dim wRmDetArr() As String
  
  '*** (Jen 2.13)
  Dim ws_BaseLme As Single
  '*** (Jen 2.13)
  
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  Dim wFndPcWt As Single
  ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
  
  With GrdOrdRm
    Select Case ColName
    Case Is = UCase("OrRmPtr")
      If .Mode = fgmnorm Then 'Or (.Mode = fgmCopy 4And GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y") Then
       '******************Geeta********Emr206********23/04/04****************
       '*************************New**********
       ' If .Value(RowNum, "OrRmCtg") = "C" Or .Value(RowNum, "OrRmCtg") = "D" And _
           UCase(moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")) = "Y" And _
           UCase(moCn.GetFldVal("Select PValue2 from Param where PTyp='RMSCTG' and PMCD= '" + .Value(RowNum, "OrRmCtg") + "' and PSCd='" + .Value(RowNum, "OrRmSCtg") + "'")) = "Y" Then
       '******************Geeta********Emr206********23/04/04****************
        If .Value(RowNum, "OrRmCtg") = "C" Or .Value(RowNum, "OrRmCtg") = "D" And _
           UCase(moCn.GetFldVal("Select HPtrYN from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")) = "Y" Then
             
          '****** Sachin 3.02 08-12-07 - Current Partition
          wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "' ", ""))
          If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
            '****** Sachin 3.02 08-12-07 - Current Partition
            
            '*** (Bef 3.1.3)
            'wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
            'If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or .Value(RowNum, "OrWt") = 0 Then
            '*** (Bef 3.1.3)
            
            '*** (Jen 3.1.3)
'            wRmDetOld = moCn.GetFldVal("Select RTrim(LTrim(RmCtg))+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
'            wOldRmCtg = Mid(wRmDetOld, 1, 1)
'            wRmSTWGrpOld = Mid(wRmDetOld, 2)
            If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" Then
              wRmDetOld = moCn.GetFldVal("Select RmCtg+','+RmSCtg+ ','+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
              If wRmDetOld <> "" Then
                wRmDetArr = Split(wRmDetOld, ",")
                wOldRmCtg = wRmDetArr(0)
                wOldRmSCtg = wRmDetArr(1)
                wRmSTWGrpOld = wRmDetArr(2)
              End If
          
             'If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
             '***Geeta***3.02**
             If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or Trim(wOldRmSCtg) <> .Value(RowNum, "OrRmSCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
             '*** (Jen 3.1.3)]
            
                 .Value(RowNum, "OrRmPtr") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                           .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                           .Value(RowNum, "OrLn2"), wRmSTWGrp)
             End If
            End If
          Else
           
              .Value(RowNum, "OrRmPtr") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                        .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                        .Value(RowNum, "OrLn2"), wRmSTWGrp)
          End If
        Else
          .Value(RowNum, "OrRmPtr") = 0
        End If
      End If
    Case Is = UCase("OrWt")
      If .Mode = fgmnorm Then
        ' ***** Manali 3.8.0 - Default Wt for GPSL From RmMst Based On Qty
        wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
        'If UCase(SourceColName) = UCase("OrRmCd") And (.Value(RowNum, "OrRmCtg") = "G" Or _
           .Value(RowNum, "OrRmCtg") = "P") And CStr(OldVal) <> "0" Then
        ' ****** Sachin 2.12 - 01/12/05 - SJM
        ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
        
        If .Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Or .Value(RowNum, "OrRmCtg") = "M" Then
        ' ****** Sachin 2.12 - 01/12/05 - SJM
          ' ***** Manali 3.8.0 - Default Wt for GPSL From RmMst Based On Qty
          If wFndPcWt <> 0 Then
            'If UCase(SourceColName) <> UCase("OrLn1") And UCase(SourceColName) <> UCase("OrLn2") Then
             .Value(RowNum, "OrWt") = .Value(RowNum, "OrQty") * wFndPcWt
           ' End If
          Else
          ' ***** Manali 3.8.0 - Default Wt for GPSL From RmMst Based On Qty
            If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
              '*** ### Even though the following line is executed only when the sourcecolname= 'ORRMCD' even then sometimes the value of OldVal is 0. Hence use CStr. Also tell Rajesh sir about this problem.
              '****** Sachin 3.02 08-12-07 - Current Partition
              wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "' ", ""))
              'If Trim(wOldRmCtg) = .Value(RowNum, "OrRmCtg") And OldVal <> "" Then
              '*** To allow conversion from Gld To Platinum
              ' ****** Sachin 2.12 - 01/12/05 - SJM
              ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
              If (Trim(wOldRmCtg) = "G" Or Trim(wOldRmCtg) = "P" Or Trim(wOldRmCtg) = "S" Or Trim(wOldRmCtg) = "L" Or Trim(wOldRmCtg) = "M") And OldVal <> "" Then
              ' ****** Sachin 2.12 - 01/12/05 - SJM
                '****** Sachin 3.02 08-12-07 - Current Partition
                wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "' and RmPrtKey='" + ctCurrPrtn + "' ")
                wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                .Value(RowNum, "OrWt") = MWLib.Div(.Value(RowNum, "OrWt") * wNewSpGrav, wOldSpGrav)
              Else
                .Value(RowNum, "OrWt") = 0.001
              End If
            End If
          End If
        ElseIf .Value(RowNum, "OrRmCtg") = "D" Or .Value(RowNum, "OrRmCtg") = "C" Then
          If .Value(RowNum, "OrRmPtr") = 0 Then
            '****** Sachin 3.02 08-12-07 - Current Partition
            wRmSTWGrp = moCn.GetFldVal("Select RmSTWGrp from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
            If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
              '****** Sachin 3.02 08-12-07 - Current Partition
              
              '*** (Bef 3.1.3)
              'wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
              'If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or .Value(RowNum, "OrWt") = 0 Then
              '*** (Bef 3.1.3)
              
              '*** (Jen 3.1.3)
'              wRmDetOld = moCn.GetFldVal("Select RTrim(LTrim(RmCtg))+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
'              wOldRmCtg = Mid(wRmDetOld, 1, 1)
'              wRmSTWGrpOld = Mid(wRmDetOld, 2)
'              If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
              '*** (Jen 3.1.3)

              '***Geeta***3.02**
              If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN") = "Y" Then
                wRmDetOld = moCn.GetFldVal("Select RmCtg+','+RmSCtg+ ','+ RmSTWGrp from RmMst where RmCd= '" + OldVal + "' " + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                If wRmDetOld <> "" Then
                  wRmDetArr = Split(wRmDetOld, ",")
                  wOldRmCtg = wRmDetArr(0)
                  wOldRmSCtg = wRmDetArr(1)
                  wRmSTWGrpOld = wRmDetArr(2)
                End If
                If Trim(wOldRmCtg) <> .Value(RowNum, "OrRmCtg") Or Trim(wOldRmSCtg) <> .Value(RowNum, "OrRmSCtg") Or wRmSTWGrp <> wRmSTWGrpOld Or .Value(RowNum, "OrWt") = 0 Then
               '***Geeta***3.02**
                  .Value(RowNum, "OrWt") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                         .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                         .Value(RowNum, "OrLn2"), wRmSTWGrp) * .Value(RowNum, "OrQty")
                End If
              End If
           ' Else
            '  .Value(RowNum, "OrWt") = GetWtFrSz(.Value(RowNum, "OrRmCtg"), _
                                       .Value(RowNum, "OrRmSCtg"), .Value(RowNum, "OrLn1"), _
                                       .Value(RowNum, "OrLn2"), wRmSTWGrp) * .Value(RowNum, "OrQty")
            End If
          Else
            If (UCase(SourceColName) = UCase("OrRmPtr") And Val(OldVal) <> .Value(RowNum, "OrRmPtr")) Or _
               (UCase(SourceColName) = UCase("OrQty") And Val(OldVal) <> .Value(RowNum, "OrQty")) Then
              .Value(RowNum, "OrWt") = .Value(RowNum, "OrRmPtr") * .Value(RowNum, "OrQty")
            End If
          End If
        
        Else
          ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
          '****** Sachin 3.02 08-12-07 - Current Partition
          wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
          If .Value(RowNum, "OrRmCtg") = "X" And wFndPcWt <> 0 Then
            .Value(RowNum, "OrWt") = .Value(RowNum, "OrQty") * wFndPcWt
          Else
          ' ****** Sachin 2.12 - 06/12/05 - Fnd Wt/Pc
            If UCase(SourceColName) = UCase("OrRmCtg") And CStr(OldVal) <> .Value(RowNum, "OrRmCtg") Then
              .Value(RowNum, "OrWt") = 0.001
            End If
          End If
        End If
        If Round(.Value(RowNum, "OrWt"), 3) = 0 Then .Value(RowNum, "OrWt") = 0.001
      
      End If
    Case Is = UCase("OrPrdWt")
      If .Mode = fgmnorm Then
        If ms_ShBothWts = "N" Then
          .Value(RowNum, "OrPrdWt") = .Value(RowNum, "OrWt")
        ElseIf ms_ShBothWts = "Y" Then
        ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
          ' ***** Manali 3.8.0 - Default Wt for GPSL From RmMst Based On Qty
          wFndPcWt = moCn.GetFldVal("Select RmFndWt From RmMst Where RmCd = '" + .Value(RowNum, "OrrmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
        
          If .Value(RowNum, "OrRmCtg") = "G" Or .Value(RowNum, "OrRmCtg") = "P" Or .Value(RowNum, "OrRmCtg") = "S" Or .Value(RowNum, "OrRmCtg") = "L" Then
            ' ***** Manali 3.8.0 - Default Wt for GPSL From RmMst Based On Qty
            If wFndPcWt <> 0 Then
              If UCase(SourceColName) <> UCase("OrLn1") And UCase(SourceColName) <> UCase("OrLn2") Then
                .Value(RowNum, "OrPrdWt") = .Value(RowNum, "OrPrdQty") * wFndPcWt
              End If
            Else
            
              If UCase(SourceColName) = UCase("OrRmCd") And CStr(OldVal) <> "0" Then
                '*** ### Even though the following line is executed only when the sourcecolname= 'ORRMCD' even then sometimes the value of OldVal is 0. Hence use CStr. Also tell Rajesh sir about this problem.
                '****** Sachin 3.02 08-12-07 - Current Partition
                wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                If Trim(wOldRmCtg) = .Value(RowNum, "OrRmCtg") And OldVal <> "" Then
                  '****** Sachin 3.02 08-12-07 - Current Partition
                  wOldSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + .Value(RowNum, "OrRmCd") + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " and RmPrtKey='" + ctCurrPrtn + "' ", ""))
                  .Value(RowNum, "OrPrdWt") = MWLib.Div(.Value(RowNum, "OrPrdWt") * wNewSpGrav, wOldSpGrav)
                
                '*** (Jen 2.12)
                ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
