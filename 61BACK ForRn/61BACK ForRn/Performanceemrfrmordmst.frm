  'If wRsDsgSel.RecCount > 200 Then DispMsg "More Than 200 Records, Please Reduce The Scope.", etError: Exit Sub
  If mf_QuotSelCnt = False Then
    If wRsDsgSel.RecCount > 200 Then DispMsg CStr(wRsDsgSel.RecCount) + " Records Selected, Please Reduce The Scope OR Click ""Show Designs"" Again to Continue.", etError: mf_QuotSelCnt = True: Exit Sub
  End If
  If wRsDsgSel.RecCount > 0 Then
    wRsDsgSel.MoveFirst
  Else
    DispMsg "No Designs Exist In The Given Scope, Please Change The Scope", etWarning
  End If
  
  GrdDsgSel.Rows = 1
  With GrdDsgSel
    GrdDsgSel.StartCopy
    Do While Not (wRsDsgSel.EOF Or wRsDsgSel.BOF)
      .AddItem
      i = .Rows - 1
      .Value(i, "wDmSr") = i
      .Value(i, "wDmCtg") = wRsDsgSel!DmCtg
      .Value(i, "wDmCd") = wRsDsgSel!DmCd
