              wOldRmCtg = moCn.GetFldVal("Select RmCtg from RmMst where RmCd= '" + OldVal + "'" + IIF(.Value(RowNum, "OrPrtKey") = ctCurrPrtn, " And RmPrtKey='" + ctCurrPrtn + "' ", ""))
