    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.PMCd("YN")
    End If
  
  Case Is = UCase("wDsDmCdFr"), UCase("wDsDmCdTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.DmCd(ms_DmTcTyp)
    End If
  
  Case Is = UCase("wDsDmSzFr"), UCase("wDsDmSzTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.PMCd("DMSZ")
    End If

  Case Is = UCase("WDSDmStkYyFr"), UCase("WDSDmStkYyTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.PMCd("YY")
    End If
  
  Case Is = UCase("WDSDmStkChrFr"), UCase("WDSDmStkChrTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.PMCd("BCHR", "'P'")
    End If
  
  Case Is = UCase("WDSDmStkNoFr"), UCase("WDSDmStkNoTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      If UCase(IdName) = UCase("wDsDmStkYyFr") Then Call HlpList.OdDmStkNo(ADC("wDsDmCdFr"), ADC("wDsodSfxFr"), ADC("wDsDmSzFr"), ADC("wDsDmStkYyFr"), ADC("wDsDmStkChrFr"))
      If UCase(IdName) = UCase("wDsDmStkYyTo") Then Call HlpList.OdDmStkNo(ADC("wDsDmCdTo"), ADC("wDsodSfxTo"), ADC("wDsDmSzTo"), ADC("wDsDmStkYyTo"), ADC("wDsDmStkChrTo"))
    End If
    
  Case Is = UCase("wDsSLocFr"), UCase("wDsSLocTo")
    If ms_OmTcTyp = ctJtTcTyp Then
      Call HlpList.Loc(ADC("OmCoCd"), "'S'")
    End If
  
  Case Is = UCase("wDsCpyFrYn")
     Call HlpList.PMCd("YN")
  
  Case Is = UCase("wDsCpyRtOpt")
    If ADC("wDsCpyRt") = "N" Then Cancel = True: ErrMsg = "This Field Should Not Be Entered As Copy Rate Is 'N'": Exit Sub
    Call HlpList.PMCd("CPYRT")

 Case Is = UCase("wDsCpyTc")
'    If Not (mBaseTc = "" And mRefTc = "" And mSrcTc = "") Then
'      Call HlpList.PMCd("TC", , , " '," + mBaseTc + "," + mRefTc + "," + mSrcTc + ",' like '%,'+PMCd+',%' ")
'    Else
'      Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "'")
'    End If
      Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "','SO','QT','FG'" + IIF(ADC("OmTc") = "JPR" Or ADC("OmTc") = "JCI", ",'IN'", ""))
 Case Is = UCase("wDsCmCtg")
      Call HlpList.PMCd("CmCtg")
 Case Is = UCase("wDsCmCd")
      Call HlpList.CustCd(ADC("wDsCmCtg"))
 Case Is = UCase("wDsOmChr")
    Call HlpList.vPSCd(ADC("WDsCpyCoCd"), "CHR", ADC("wDsCpyTc"))
    
 Case Is = UCase("wDsOmNo")
   
    ' Zubin 213
    '****** Sachin 3.3.0 (25-06-08) - [13. Copy From Invoice] ******
    If Not ADC("wDsCpyTc") = "IN" Then
      ' ***** Manali Trading Module
      If ms_OmTcTyp = ctJtTcTyp Then
       
        If ADC("wDsCpyTc") = "JPO" Or ADC("wDsCpyTc") = "JSO" Or (mBaseTc <> "" And mBaseTc <> ADC("wDsCpyTc")) Or (mRefTc <> "" And InStr(1, mRefTc, ADC("wDsCpyTc")) <= 0) Then
          Call HlpList.OmNo(ADC("wDsCpyCoCd"), ADC("wDsCpyTc"), ADC("wDsOmYy"), ADC("wDsOmChr"), , , , , IIF(Not (mBaseTc = "" And mRefTc = ""), True, False), IIF(mBaseTc <> "", True, False))
        Else
          Call HlpList.OmNo(ADC("WDsCpyCoCd"), ADC("wDsCpyTc"), ADC("wDsOmYy"), ADC("wDsOmChr"), , , ADC("wDsCmCtg"), ADC("wDsCmCd"), IIF(Not (mBaseTc = "" And mRefTc = ""), True, False), IIF(mBaseTc <> "", True, False))
        End If
      Else
      ' ***** Manali Trading Module
        Call HlpList.OmNo(ADC("wDsCpyCoCd"), ADC("wDsCpyTc"), ADC("wDsCpyOmYy"), ADC("wDsCpyOmChr"))   ', adc("OmCmCurCd"))
      End If
    Else
      Call HlpList.InNo(ADC("wDsCpyCoCd"), ADC("wDsCpyTc"), ADC("wDsOmYy"), ADC("wDsOmChr"))
    End If
      
 End Select
  
  
  ' ****** Manali Trading Module
'  If ms_OmTcTyp = "JT" And CmdInvHd.Visible Then
'    If UCase$(adc("wInCls")) = UCase$("Y") And UCase$(IdName) <> UCase$("wInCls") Then
'      Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
'    End If
    
 ' End If
End Sub
