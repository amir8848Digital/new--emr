Private Sub GrdOrdDsg_GotFocus()
   Dim wf_Cancel As Boolean, wf_errmsg As String
' ***** Manali Trading Module
If moCn.RecSeek("Select 'x' from InvHd Where InCoCd='" + ADC("OmCoCd") + "' and InTc='" + ADC("OmTc") + "' " + _
                  " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' ") Then mInvExists = True

If (CmdInvHd.Visible = True And Not mInvExists) Then
    GrdOrdDsg.AllowAdd = False    ': GrdOrdDsg.AllowDelete = False
