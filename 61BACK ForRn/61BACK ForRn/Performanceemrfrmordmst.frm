            wKt = ""
            For i = 1 To GrdOrdRm.Rows - 1
              If Not GrdOrdRm.IsDel(i) Then
                If GrdOrdRm.Value(i, "OrMainMet") = "Y" Then
                  wKt = moCn.GetFldVal("Select RmKt from RmMst where RmCd= '" + GrdOrdRm.Value(i, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "'")
                  Exit For
                End If
              End If
            Next i
      
         ElseIf (wl_SourceGrdMode = fgmnorm) Then
          If UCase(SourceName) = UCase("GrdOrdRm") And GrdOrdRm.Row > 0 Then
           If GrdOrdRm.Value(GrdOrdRm.Row, "OrMainMet") = "Y" Then
              wKt = moCn.GetFldVal("Select RmKt from RmMst where RmCd= '" + GrdOrdRm.Value(GrdOrdRm.Row, "OrRmCd") + "' and RmPrtKey='" + ctCurrPrtn + "'")
              If wKt <> "" And wKt = moCn.GetFldVal("Select RmKT from RmMst where RmCd= '" + OldVal + "' and RmPrtKey='" + ctCurrPrtn + "'") Then wKt = ""
