  With GrdOrdDsg
    .Store "OdCoCd", ADC("OmCoCd")
    .Store "OdTc", ADC("OmTc")
    .Store "OdYy", ADC("OmYy")
    .Store "OdChr", ADC("OmChr")
    .Store "OdNo", ADC("OmNo")
    
    '****** Geeta CRM 212
    .Store "OdGrCS", ""
    .Store "OdGrFin", ""
    '****** Geeta CRM 212
        
    '****** Sachin 3.02 (10/09/07) ******
    If .IsNew(RowNum) Then
    
        .Store "OdOmIdNo", moCn.GetFldVal("Select OmIdNo From OrdMst " + _
                                          "Where OmCoCd='" + ADC("OmCoCd") + "' And OmTc='" + ADC("OmTc") + "' " + _
