  Dim wScCnd As String
  
  '******************* urmi 10/07/03 *************************************************
  Dim wSrtPdc As String
  wSrtPdc = " Order By OdSr "
  
  If UCase(ms_MenuCd) = UCase("PrcLst") Then
    If ADC("wScSrtPdc") <> "" Then
      wSrtPdc = moCn.GetFldVal("Select PDesc225 from Param where PTYP= 'SRTPDC' and PMCD= '" + _
                               ADC("wScSrtPdc") + "' and Pscd= '' ")

      wSrtPdc = " Order By " + wSrtPdc
    End If
  End If
  '**********************************************************************************
  
  ADC("wScDmCdFr").CmpStr = "DmCd>= "
  ADC("wScDmCdTo").CmpStr = "DmCd<= "
  ADC("wScDmCtgFr").CmpStr = "DmCtg>= "
  ADC("wScDmCtgTo").CmpStr = "DmCtg<= "

  wScCnd = ADC.RepCond
  wScCnd = IIF(wScCnd <> "", " and " + wScCnd, "")
  wScCnd = IIF(wScCnd = "", "", " and exists(Select 'x' from DsgMst where DmCd= OdDmCd " + _
                        wScCnd + " ) ")
  
  GrdOrdDsg.RecSource = " Select * from OrdDsg " + _
                        " Where OdCoCd ='" + ADC("OmCoCd") + "'" + _
                        " And OdTc ='" + ADC("OmTc") + "'" + _
                        " And OdYy = '" + ADC("OmYy") + "'" + _
                        " And OdChr ='" + ADC("OmChr") + "' " + _
                        " And OdNo =" + CStr(ADC("OmNo")) + _
                        IIF(gs_Partition = ctCurrPrtn, " And OdPrtKey= '" + ctCurrPrtn + "'", "") + wScCnd + wSrtPdc
  ADC("wScDmCdFr").CmpStr = ""
  ADC("wScDmCdTo").CmpStr = ""
  ADC("wScDmCtgFr").CmpStr = ""
  ADC("wScDmCtgTo").CmpStr = ""
                      
