   Else
    Set wo_rsSrcOd = moCn.OpenRes("Select OrdDsg.*, " + CStr(GrdDsgStk.Value(i, "wDsStkQty")) + " as qStkQty,'" + GrdDsgStk.Value(i, "wDsSrcVch") + "' as qBaseRefVch from OrdDsg " + _
                    "Join OrdMst On OmCoCd=OdCoCd and OmTc=OdTC and OmYy=OdYy and OmChr=OdChr and OmNo=OdNo  and OmIdNo=OdOmIdNo and OmPrtKey=OdPrtKey " + _
                    "Join DsgMst on DmIdNo=OdDmIdNo And DmTcTyp= '" + ms_DmTcTyp + "' and DmCd = OdDmCd and DmSz= '' and DmPrtKey=OdPrtKey " + _
