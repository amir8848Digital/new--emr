        '****** Check 3 : Valid Design Code ******
        '4.1.3.0
        If Not moCn.RecSeek("Select 'x' From DsgMst Where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                               "And DmHld = 'N' And DmValidYN='Y' and DmCd = (Select IdDmCd From InvDsg Where IdCoCd = '" + ADC("WDSCPYCOCD") + "' and " + _
                               " IdTc='" + wsOrd(0) + "' And IdYy='" + wsOrd(1) + "' And IdChr='" + wsOrd(2) + "' And IdNo=" + CStr(wsOrd(3)) + _
                               " And IdSr=" + wsOrd(4) + ") And " + _
                               " DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' " + _
                               IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                               "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
