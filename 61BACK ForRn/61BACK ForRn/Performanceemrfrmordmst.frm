Private Sub OrdDsgSumm()
  '*** Procedure to show the Order Design Summary in the Summary Frame
  Dim ws_OdQty As String, ws_HOdAmdQty As String, wd_OrdDsgTotQty As Double, wd_OrdDsgTotVal As Double
  Dim ws_reqGrpBy As String, ws_str As String, ws_CommStr As String, wi_Row As Integer
  Dim wd_OrdDsgProfit As Double
  wd_OrdDsgProfit = 0
  
  Select Case ADC("wOrdDsgGrp")
  Case Is = "DMCD"
    ws_str = "Select '*' as OdSr, DmCtg as OdDmCtg, OdDmCd, 0 as OdSalPrc, "
    ws_reqGrpBy = "DmCtg,OdDmCd"
  Case Is = "DMCTG"
    ws_str = "Select '*' as OdSr, DmCtg as OdDmCtg, '*' as OdDmCd, 0 as OdSalPrc, "
    ws_reqGrpBy = "DmCtg"
  Case Is = "DSGSR"
    ws_str = "Select OdSr, max(DmCtg) as OdDmCtg, max(OdDmCd) as OdDmCd, max(OdSalPrc) as OdSalPrc , "
    ws_reqGrpBy = "OdSr"
  Case Else
    DispMsg "Enter Order Design Group Option", etError: Exit Sub
  End Select
  
  wd_OrdDsgTotQty = 0: wd_OrdDsgTotVal = 0

  ws_HOdAmdQty = Trim(UCase(moCn.GetFldVal("Select hOdAmdQty from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")))
  ws_OdQty = IIF(ws_HOdAmdQty = "Y", "OdOrdQty", "OdOrdEnt")
  '****** Sachin 3.02 (10/09/07) - Complete Partition(when logon in current partition only summary for current will be displayed)
  ws_CommStr = "sum(" + ws_OdQty + ") as qOdQty, " + _
               "sum(OdSalPrc*" + ws_OdQty + ") as qSalVal, " + _
               "sum(OdCstPrc*" + ws_OdQty + ") as qCstVal " + _
               "from OrdDsg join DsgMst on DmTcTyp='" + ms_DmTcTyp + "' and " + _
               "DmCd=OdDmCd and DmSz= IsNull((Select DmSz from DsgMst where " + _
               "DmTcTyp='" + ms_DmTcTyp + "' and DmCd=OdDmCd and DmSz=OdDmSz " + IIF(gs_Partition = ctCurrPrtn, " And DmPrtKey= OdPrtKey ", "") + "),'') " + _
               "Where " + IIF(gs_Partition = ctCurrPrtn, " OdPrtKey='" + ctCurrPrtn + "' and ", "") + " OdCoCd ='" + ADC("OmCoCd") + "' And " + _
               "OdTc ='" + ADC("OmTc") + "' And OdYy = '" + ADC("OmYy") + "' And " + _
               "OdChr ='" + ADC("OmChr") + "' And OdNo =" + CStr(ADC("OmNo")) + _
               " group by  " + ws_reqGrpBy
               '(index=DsgMst)
             
  ws_str = ws_str + ws_CommStr
  
  Dim wo_rsOrdDsgSumm As MDORowSet
  Set wo_rsOrdDsgSumm = moCn.OpenRes(ws_str)

  GrdOrdDsgSumm.AllowAdd = True

  GrdOrdDsgSumm.Rows = 1
  With GrdOrdDsgSumm
    Do While Not (wo_rsOrdDsgSumm.EOF Or wo_rsOrdDsgSumm.BOF)
      .AddItem
      wi_Row = .Rows - 1
      .Value(wi_Row, "wOrdDsgSr") = wo_rsOrdDsgSumm!OdSr
      .Value(wi_Row, "wOrdDsgCtg") = wo_rsOrdDsgSumm!OdDmCtg
      .Value(wi_Row, "wOrdDsgCd") = wo_rsOrdDsgSumm!OdDmCd
      .Value(wi_Row, "wOrdDsgQty") = wo_rsOrdDsgSumm!qOdQty
      .Value(wi_Row, "wOrdDsgSalPrc") = wo_rsOrdDsgSumm!OdSalPrc
      .Value(wi_Row, "wOrdDsgSalVal") = wo_rsOrdDsgSumm!qSalVal
      .Value(wi_Row, "wOrdDsgCstVal") = wo_rsOrdDsgSumm!qCstVal
      
      If UCase(ADC("wBaseVal")) = "C" Then
        'If wo_rsOrdDsgSumm!qCstVal <> 0 Then
          wd_OrdDsgProfit = MWLib.Div((wo_rsOrdDsgSumm!qSalVal - wo_rsOrdDsgSumm!qCstVal) * 100, wo_rsOrdDsgSumm!qCstVal)
        'Else
        '  wd_OrdDsgProfit = (wo_rsOrdDsgSumm!qSalVal * 100) / 1
        'End If
      ElseIf UCase(ADC("wBaseVal")) = "S" Then
        'If wo_rsOrdDsgSumm!qSalVal <> 0 Then
          wd_OrdDsgProfit = MWLib.Div((wo_rsOrdDsgSumm!qSalVal - wo_rsOrdDsgSumm!qCstVal) * 100, wo_rsOrdDsgSumm!qSalVal)
        'Else
        '  wd_OrdDsgProfit = (wo_rsOrdDsgSumm!qCstVal * 100) / 1
        'End If
      End If
      
      .Value(wi_Row, "wOrdDsgProfit") = wd_OrdDsgProfit
      
      
      wd_OrdDsgTotQty = wd_OrdDsgTotQty + wo_rsOrdDsgSumm!qOdQty
      wd_OrdDsgTotVal = wd_OrdDsgTotVal + wo_rsOrdDsgSumm!qSalVal
      
      wo_rsOrdDsgSumm.MoveNext
    Loop
  End With
  ADC("wOrdDsgTotQty") = wd_OrdDsgTotQty
  ADC("wOrdDsgTotVal") = wd_OrdDsgTotVal
  GrdOrdDsgSumm.AllowAdd = False
End Sub
Private Function RmSummSql(ByVal pv_DsgOrdSumm As String) As String
  '*** Common Procedure used in the Order and Design Rm Summary option
  '*** The quantity to be displayed (Ord Entered or Ord Qty) depends on the hOdAmdQty
      'field of the Head file
  Dim ws_OdQty As String, ws_HOdAmdQty As String, ws_CommStr As String, wf_Cancel As Boolean
  Dim ws_ErrMsg As String, ws_reqCnd As String, ws_reqIdName As String, ws_reqGrpBy As String
  If pv_DsgOrdSumm = ctDsgSumm Then
    ws_reqCnd = " And OrSr =" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
    ws_reqIdName = "wDsgRmGrp"
  ElseIf pv_DsgOrdSumm = ctOrdSumm Then
    ws_reqIdName = "wOrdRmGrp"
  End If
  Call atxt_FldChange(99, ws_reqIdName, wf_Cancel, ws_ErrMsg, ADC(ws_reqIdName))
  If wf_Cancel = True Then
    DispMsg ws_ErrMsg, etError
    Exit Function
  End If
  Select Case ADC(ws_reqIdName)
  Case Is = "RMCTG"
    ws_reqGrpBy = "OrRmCtg"
    RmSummSql = "Select OrRmCtg, '*' as OrRmSCtg, '*' as OrRmCd, "
  Case Is = "RMSCTG"
    ws_reqGrpBy = "OrRmCtg,OrRmSCtg"
    RmSummSql = "Select OrRmCtg, OrRmSCtg, '*' as OrRmCd, "
  Case Is = "RMCD"
    ws_reqGrpBy = "OrRmCtg,OrRmSCtg,OrRmCd"
    RmSummSql = "Select OrRmCtg, OrRmSCtg, OrRmCd, "
  Case Else
    DispMsg "No Grouping Flds defined in system for selected GroupBy value", etError
    Exit Function
  End Select
  
  ws_HOdAmdQty = Trim(UCase(moCn.GetFldVal("Select hOdAmdQty from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")))
  ws_OdQty = IIF(ws_HOdAmdQty = "Y", "OdOrdQty", "OdOrdEnt")
  '****** Sachin 3.02 (10/09/07) - Complete Partition
  ws_CommStr = "IsNull(sum(OrQty*" + ws_OdQty + "),0) as OrQty, IsNull(sum(OrWt*" + ws_OdQty + "),0) as OrWt, " + _
             "IsNull(sum(OrSalVal*" + ws_OdQty + "),0) as OrSalVal, " + _
             "IsNull(sum(OrCstVal*" + ws_OdQty + "),0) as OrCstVal " + _
             "from OrdRm Join OrdDsg On OdIdNo=OrOdIdNo And OdCoCd= OrCoCd and OdTc= OrTc and OdYy= OrYy and " + _
             "OdChr= OrChr and OdNo= OrNo and OdSr= OrSr and OdPrtKey=OrPrtKey Where " + IIF(gs_Partition = ctCurrPrtn, " OrPrtKey='" + ctCurrPrtn + "' and ", "") + _
             "OrCoCd ='" + ADC("OmCoCd") + "' And OrTc ='" + ADC("OmTc") + "' And " + _
             "OrYy = '" + ADC("OmYy") + "' And OrChr ='" + ADC("OmChr") + "' And " + _
             "OrNo =" + CStr(ADC("OmNo")) + ws_reqCnd + _
             "Group By " + ws_reqGrpBy
             '(index=OrdDsg)
  RmSummSql = RmSummSql + ws_CommStr
End Function
Private Function LabSummSql(ByVal pv_DsgOrdSumm As String) As String
  '*** Common Procedure used in the Order and Design Labour Summary option
  Dim ws_OdQty As String, ws_HOdAmdQty As String, ws_Commstr1 As String, ws_Commstr2 As String
  Dim ws_DsgStr1 As String, ws_DsgStr2 As String, ws_reqIdName As String, wf_Cancel As Boolean
  Dim ws_ErrMsg As String
  If pv_DsgOrdSumm = ctDsgSumm Then
    ws_DsgStr1 = " And OlSr =" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
    ws_DsgStr2 = " And OrSr =" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
    ws_reqIdName = "wDsgLabGrp"
  ElseIf pv_DsgOrdSumm = ctOrdSumm Then
    ws_reqIdName = "wOrdLabGrp"
  End If
  Call atxt_FldChange(99, ws_reqIdName, wf_Cancel, ws_ErrMsg, ADC(ws_reqIdName))
  If wf_Cancel = True Then
    DispMsg ws_ErrMsg, etError
    Exit Function
  End If
  
  ws_HOdAmdQty = Trim(UCase(moCn.GetFldVal("Select hOdAmdQty from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")))
  ws_OdQty = IIF(ws_HOdAmdQty = "Y", "OdOrdQty", "OdOrdEnt")
  '****** Sachin 3.02 (10/09/07) - Complete Partition
  ws_Commstr1 = "IsNull(sum(OlQty*" + ws_OdQty + "), 0) as OlQty, IsNull(sum(OlSalVal*" + ws_OdQty + "), 0) as OlSalVal, " + _
              "IsNull(sum(OlCstVal*" + ws_OdQty + "), 0) as OlCstVal " + _
              "from OrdLab Join OrdDsg On OdIdNo=OlOdIdNo And OdCoCd= OlCoCd and OdTc= OlTc and " + _
              "OdYy= OlYy and OdChr= OlChr and OdNo= OlNo and OdSr= OlSr and OdPrtKey=OlPrtKey " + _
              "Where " + IIF(gs_Partition = ctCurrPrtn, " OlPrtKEy='" + ctCurrPrtn + "' and ", "") + " OlCoCd ='" + ADC("OmCoCd") + "' And OlTc ='" + ADC("OmTc") + "' And " + _
              "OlYy = '" + ADC("OmYy") + "' And OlChr ='" + ADC("OmChr") + "' And " + _
              "OlNo =" + CStr(ADC("OmNo")) + ws_DsgStr1
  '****** Sachin 3.02 (10/09/07) - Complete Partition
  ws_Commstr2 = "IsNull(sum(OrQty*" + ws_OdQty + "),0) as OlQty, IsNull(sum(OrSetSalVal*" + ws_OdQty + "),0) as OlSalVal, " + _
              "IsNull(sum(OrSetCstVal*" + ws_OdQty + "),0) as OlCstVal " + _
              "from OrdRm Join OrdDsg On OdIdNo=OrOdIdNo And OdCoCd= OrCoCd and OdTc= OrTc and " + _
              "OdYy= OrYy and OdChr= OrChr and OdNo= OrNo and OdSr= OrSr and OdPrtKey=OrPrtKey where OrSetSCd<>'' " + _
              IIF(gs_Partition = ctCurrPrtn, " and OrPrtKey='" + ctCurrPrtn + "' ", "") + " And OrCoCd ='" + ADC("OmCoCd") + "' And OrTc ='" + ADC("OmTc") + "' And " + _
              "OrYy = '" + ADC("OmYy") + "' And OrChr ='" + ADC("OmChr") + "' And " + _
              "OrNo =" + CStr(ADC("OmNo")) + ws_DsgStr2
  Select Case ADC(ws_reqIdName)
  Case Is = "LMCD"
    LabSummSql = "Select OlMCd, '*' as OlSCd, '*' as OlQw, " + ws_Commstr1 + _
           " group by OlMCd " + _
           " Union All " + _
           " Select 'SET' as OlMCd, '*' as OlSCd, '*' as OlQw, " + ws_Commstr2
  Case Is = "LSCD"
    LabSummSql = "Select OlMCd, OlSCd, OlQw, " + ws_Commstr1 + _
           " group by OlMCd,OlSCd,OlQw " + _
           " Union All " + _
           "Select 'SET' as OlMCd, OrSetSCd as OlSCd, " + _
           "(Select max(PValue) from Param where PTyp='LABSCD' and " + _
           "PMCd='SET' and PSCd=OrSetSCd) as OlQw, " + ws_Commstr2 + _
           "Group By OrSetSCd"
    
'    LabSummSql = "Select OlMCd, OlSCd, IsNull(max(OlQw), '') as OlQw, " + ws_Commstr1 + _
'           " group by OlMCd,OlSCd " + _
'           " Union All " + _
'           "Select 'SET' as OlMCd, OrSetSCd as OlSCd, " + _
'           "(Select max(PValue) from Param where PTyp='LABSCD' and " + _
'           "PMCd='SET' and PSCd=OrSetSCd) as OlQw, " + ws_Commstr2 + _
'           "Group By OrSetSCd"
  
  
  Case Else
    DispMsg "No Grouping Flds defined in system for selected GroupBy value", etError
    Exit Function
  End Select
End Function

Private Sub CpyDets(ByVal pv_rsSrcOd As MDORowSet, ByVal pv_CpyFrDsgMst As Boolean, ByVal pv_OrdCpy As Boolean, Optional pv_CpyBags As Boolean, Optional pv_CpyFrRet As Boolean = False, Optional pv_CpyXl As Boolean = False, Optional pv_StkCpy As Boolean = False)
  '****** added pv_CpyFrRet (Jen 2.13) ******'
  '****** Sachin 2.12 16/12/05 New optional variable declared for Copying FG Bags
  '*** Common Procedure used in the Order and Design Copy option
  Dim wi_OdRow As Integer, wi_RmRow As Integer, wi_LabRow As Integer, wi_OCTRow As Integer '*** Jay 2.13(CT) ***
  Dim wo_rsSrcORm As MDORowSet, wo_rsSrcOl As MDORowSet, wo_rsSrcOCT As MDORowSet, wo_rsStkRt As MDORowSet
  Dim ws_TmpTbl As String, ws_RmStr As String, ws_RmCdStr As String, wOldSpGrav As Single, wNewSpGrav As Single
  Dim ws_OdWh As String, wb_RetVch As Boolean
  Dim ws_RmCount As Integer, i As Integer
  Dim wCoCd As String, ws_AlyCdStr As String
  Dim wDmDefSz As String
  Dim ws_BaseVch() As String
  
  Dim ws_TmpOrdRm1 As String
  ''*** (Jen 3.01)
  ''If GrdOrdDsg.ColProp("OdDmCd").Style <> fgcNormal Then DispMsg "Cannot Copy As Design Code Field Is Not Enabled", etError: Exit Sub
  ''*** (Jen 3.01)
  
  'Dim wVldRmLnStr As String   '****** Sachin 3.3.0 (30-06-08) - [28. Valid RmSz Master]
  
  mDsgSrNotCopied = ""    ' ***** Manali 3.10.0 - Copy in PDCM allowed From QT
  
  '*** Geeta ***'
  Dim wb_RmChgFlag As Boolean
  wb_RmChgFlag = False
  '*************'

  '*** Jen 2.13
  Dim wi_MainMetRow As Integer, wd_NonMainMetWt As Double
  mf_CpySalPrc = mf_CpyVal
  '*** Jen 2.13

  Dim ws_StkRtStr As String   '****** Sachin 3.3.0
  

  '*** (Jen 2.11)
  Dim ws_BagStr As String, ws_TmpOrdRmTbl As String, ws_OrdRmStr As String, ws_Vch() As String
  Dim ws_CtgStr As String
  Dim ws_HOdGmChk As String
  Dim wi_Cnt As Integer, wi_TotCnt As Integer, ws_RunMsg As String    '4.1.3.0 - Sachin

  ws_HOdGmChk = moCn.GetFldVal("Select HOdGmChk From Head where HCoCd= '" + ms_OmCoCd + "' and HCd='" + ctSelfCmCd + "'")
  '*** (Jen 2.11)
   
  If pv_CpyFrDsgMst = False Then
    If moCn.GetFldVal("Select PValue from Param where PTyp= 'TC' and PMCd= '" + pv_rsSrcOd!OdTc + "'") = "PL" Then
      wCoCd = ctSelfCoCd
    ElseIf pv_OrdCpy = True Then
      wCoCd = ADC("WOCoCd")
    ElseIf FraStkCpy.Visible Then
        wCoCd = ADC("wDsCpyCocd")
    Else
      wCoCd = ADC("OmCoCd")
    End If
  End If
  
  wb_RetVch = IIF(ADC("OmReNo") <> 0, True, False)
  
  '4.1.3.0
  wi_TotCnt = pv_rsSrcOd.RecCount
  'If IsMissing(pi_TotRecs) Then pi_TotRecs = 0
  'If pi_TotRecs > 0 Then wi_TotCnt = pi_TotRecs
  wi_Cnt = 0
  Dim ijk As Integer
  ijk = 0
  With GrdOrdDsg
      mf_ShowDsg = False
      GrdOrdDsg.StartCopy
       MWLib.BeginProcess Me, "Copying Order"              '4.1.3.0 - Sachin
      mFrmTrackStatus.txtStatus.text = mFrmTrackStatus.txtStatus.text + vbCrLf + "Started Copying"
    Do While Not (pv_rsSrcOd.EOF Or pv_rsSrcOd.BOF)
      ijk = ijk + 1
      MWLib.RunningProcess "Me" + CStr(ijk)
      mFrmTrackStatus.txtStatus.text = mFrmTrackStatus.txtStatus.text + vbCrLf + "Started Od of" + CStr(ijk) + CStr(Now)
      mb_CpyKT = True
      mb_CpyCol = True
      If wb_RetVch = False Then
        '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******
        ' ***** Manali Trading Module - Cust/Region Exc Check skipped for OmCmCtg='S'
        '4.1.3.0
        If moCn.RecSeek("Select 'x' From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' " + _
          " And DmSz=IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "'" + _
          "  and DmPrtKey='" + ctCurrPrtn + "'" + _
          " ),'') and DmPrtKey='" + ctCurrPrtn + "'" + _
          " And DmHld = 'Y'  And DmValidYN='N' " + _
          IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " And ((DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
          " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
          " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' ))) ")) Then _
          GoTo NextOd
        '****** Sachin 3.3.0 (28-06-08) - [37. Design Exclusive for Multiple Customers] ******
          
        '*** Jay 3.1.0_1 [Comp On Hold Added.]
        If mf_CTMod = True And (UCase(ms_OmTcTyp) <> "QS") Then
          If moCn.RecSeek("Select 'x' from DsgMst " + _
            "Join (Select DctCd, DctSz from DsgCt where DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = '" + pv_rsSrcOd!OdDmCd + "' and " + _
            "DctDmSz = '' and DctPrtKey='" + ctCurrPrtn + "'  /* IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd='" + pv_rsSrcOd!OdDmCd + "' And DmSz='" + pv_rsSrcOd!OdDmSz + "' and DmPrtKey='" + ADC("OmPrtKey") + "' ),'') */ ) CT " + _
            "On DmCd = DctCd and DmSz= DctSz " + _
            "where DmTcTyp = 'PM' and DmHld = 'Y' ") Then _
            GoTo NextOd
        End If
        '*** Jay 3.1.0_1 [Comp On Hold Added]
      End If
      
      '*** Jay 3.2.0 [PicNm]
      ' ***** Manali 3.5.0 - 11/11/08 - Return Memo cond added
      If ADC("OmTc") = "SO" And pv_rsSrcOd!OdDmSz = "" And wb_RetVch = False Then
        wDmDefSz = moCn.GetFldVal("Select DmDefSz from DsgMst where DmTcTyp= 'DM' and DmCd= '" + pv_rsSrcOd!OdDmCd + "' and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "'")
      End If
      '*** Jay 3.2.0 [PicNm]
      
      ' ***** Manali 3.10.0 - Copy in PDCM allowed From QT
      If UCase(ms_OmTcTyp) = UCase("PL") And pv_OrdCpy Then
        If moCn.RecSeek("Select 'x' from OrdDsg where " + _
                  "OdCoCd= '" + ADC("OmCocd") + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                  "OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and " + _
                  "OdNo= " + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "' and " + _
                  "OdDmCd='" + pv_rsSrcOd!OdDmCd + "' and OdSfx ='" + pv_rsSrcOd!OdSfx + "' and OdDmSz='" + pv_rsSrcOd!OdDmSz + "' ") Then
              mDsgSrNotCopied = mDsgSrNotCopied + IIF(mDsgSrNotCopied <> "", ", ", "") + CStr(pv_rsSrcOd!OdSr)
              GoTo NextOd
        End If
      End If
      ' ***** Manali 3.10.0 - Copy in PDCM allowed From QT
      
      If ADC.Mode = xCopy Then
        .AddItem
        wi_OdRow = .Rows - 1
        .Value(wi_OdRow, "OdSr") = IIF(pv_CpyXl = True And mi_xlOdSr > 0, mi_xlOdSr, .Value(wi_OdRow, "OdSr"))
        .Value(wi_OdRow, "OdDmCd") = pv_rsSrcOd!OdDmCd
        .Value(wi_OdRow, "OdSfx") = IIF(pv_rsSrcOd!OdSfx = "" And pv_CpyXl = True, ms_xlSfx, pv_rsSrcOd!OdSfx)
        .Value(wi_OdRow, "OdDmSz") = IIF(pv_rsSrcOd!OdDmSz <> "", pv_rsSrcOd!OdDmSz, wDmDefSz) '*** Jay 3.2.0 [DefSz]
        .Row = wi_OdRow
        GrdOrdDsg.Col = 6   '*** Setting focus to the OdDmCd field
      End If
      wi_OdRow = .Row
      
      '4.1.3.0 - Sachin
      wi_Cnt = wi_Cnt + 1
      'ws_RunMsg = IIF(Trim(pv_CpyStr) <> "", "Copying from " + pv_CpyStr, "Copying Design " + IIF(pi_TotRecs <> 0, " Sr : " + CStr(.Value(wi_OdRow, "OdSr")), CStr(wi_Cnt)) + " of " + CStr(wi_TotCnt) + " ")
      If wi_TotCnt <= 1 Then
         ws_RunMsg = "Copying Design Sr : " + CStr(.Value(wi_OdRow, "OdSr")) + " "
      Else
         ws_RunMsg = "Copying Design " + CStr(wi_Cnt) + " of " + CStr(wi_TotCnt) + " "
      End If
      'MWLib.RunningProcess ws_RunMsg
                       
      '*** (Jen 2.13)
      mf_CpySalPrc = False
      If pv_CpyFrRet = True Then
        If pv_rsSrcOd!IdFixPrc = "Y" Then
          mf_CpySalPrc = True
        Else
          mf_CpySalPrc = False
        End If
      Else
        ' ********  Bef 3.03 ********
        'If mf_CpyVal = True And mf_CpyRate = True And ms_CpyRateCd = "GPSDCXAM" And mf_CpyLabRate = True Then
        ' ***** Manali 3.03 - Pd Mod - "GPSDCXAM" replaced by "GPSLDCXM"
        If mf_CpyVal = True And mf_CpyRate = True And ms_CpyRateCd = "GPSLDCXM" And mf_CpyLabRate = True Then
          mf_CpySalPrc = True
        End If
      End If
      If pv_CpyFrRet = True Then
        .Value(wi_OdRow, "OdSr") = pv_rsSrcOd!RedSr
      End If
      '*** (Jen 2.13)
                     
      '****** Sachin 2.12 16/12/05 Copy FG Bags In QB
      If pv_OrdCpy = True And pv_CpyBags = True Then
        mf_CpyFrSameCust = (moCn.GetFldVal("Select OmCmCd From OrdMst Where OmCoCd='" + pv_rsSrcOd!OdCoCd + "' " + _
                              " And OmTc='" + pv_rsSrcOd!OdTc + "' And OmYy='" + pv_rsSrcOd!OdYy + "' And OmChr='" + pv_rsSrcOd!OdChr + "' And OmNo=" + CStr(pv_rsSrcOd!OdNo)) = ADC("OmCmCd") + " And OmPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OmPrtKey"))
      End If
      '****** Sachin 2.12 16/12/05 Copy FG Bags In QB
                 
      '*** (Jen 2.11)
      If (ms_OmTcTyp = "QB" Or ms_OmTc = "JCN") And pv_OrdCpy = True Then
        If pv_CpyBags = False Then
          .Value(wi_OdRow, "OdBYy") = pv_rsSrcOd!OdBYy
          .Value(wi_OdRow, "OdBChr") = pv_rsSrcOd!OdBChr
          .Value(wi_OdRow, "OdBNo") = pv_rsSrcOd!OdBNo
          .Value(wi_OdRow, "wOdBag") = pv_rsSrcOd!OdBYy + "/" + pv_rsSrcOd!OdBChr + "/" + Trim(CStr(pv_rsSrcOd!OdBNo))
        ' ****** Sachin 2.12 16/12/05 - Copy FG Bags in QB
        Else
          .Value(wi_OdRow, "OdBYy") = pv_rsSrcOd!BYy
          .Value(wi_OdRow, "OdBChr") = pv_rsSrcOd!BChr
          .Value(wi_OdRow, "OdBNo") = pv_rsSrcOd!BNo
          .Value(wi_OdRow, "wOdBag") = pv_rsSrcOd!BYy + "/" + pv_rsSrcOd!BChr + "/" + Trim(CStr(pv_rsSrcOd!BNo))
        End If
        ' ****** Sachin 2.12 16/12/05 - Copy FG Bags in QB
      End If
      '*** (Jen 2.11)
      
      If .Value(wi_OdRow, "OdSfx") = pv_rsSrcOd!OdSfx Then .Value(wi_OdRow, "OdSfxDesc") = pv_rsSrcOd!OdSfxDesc
      If pv_CpyXl Then .Value(wi_OdRow, "OdSfxDesc") = ms_XlSfxDesc     ' ***** Manali Excel Import (From Axis)
            
      If moCn.RecSeek("Select vPMCd from vParam where vPCoCd = '" + ADC("OmCoCd") + "' and " + _
                      "vPTyp = 'PRDSEQ' and vPMCd = '" + pv_rsSrcOd!OdPrdSeq + "'") Then
        .Value(wi_OdRow, "OdPrdSeq") = pv_rsSrcOd!OdPrdSeq
      Else
        .Value(wi_OdRow, "OdPrdSeq") = moCn.GetFldVal("Select hDmPrdSeq from Head Where " + _
                                       "HCoCd = '" + ADC("OmCoCd") + "' and HCd= '" + ctSelfCmCd + "'")
      End If
      
