  Case Is = UCase("wOdMinDiaTolWt")
  ' ******** Manali 3.5.0 - 07/05/09 - Diamond Tolerance at Order Level
    If ADC.Mode = xNorm Then
      ' ***** Manali Trading Module
      If ms_OmTcTyp = "JT" Then
        ADC("wOdMinDiaTolWt") = 0
        ADC("wOdMaxDiaTolWt") = 0
      Else
      ' ***** Manali Trading Module
        Dim wTotDiaWt As Single, wRs_TolWt As MwfLib.MDORowSet
        wTotDiaWt = 0#
        For i = 1 To GrdOrdRm.Rows - 1
          wTotDiaWt = wTotDiaWt + IIF(GrdOrdRm.Value(i, "OrRmCtg") = "D", GrdOrdRm.Value(i, "OrPrdWt"), 0)
        Next i
        
        ' ***** Manali Trading Module - 'SPL' - 'C' Replaced By adc("OmCmCtg")
        Set wRs_TolWt = moCn.OpenRes("Select Top 1 " + _
                                   "(Case when ('" + ADC("wOdIWtEqOrd") + "'='Y' or '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdFixPrc") + "'='Y' Or ('" + ADC("wOdIWtEqOrd") + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMinTol Else RrOpnMinTol End) as qMinTolWt, " + _
                                   "(Case when ('" + ADC("wOdIWtEqOrd") + "'='Y' or '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdFixPrc") + "'='Y' Or ('" + ADC("wOdIWtEqOrd") + "'='N' and ','+PDesc225+',' Like '%,D,%')) then RrFixMaxTol Else RrOpnMaxTol End) as qMaxTolWt " + _
                                  "From RmRt Left Outer Join Param On  PTyp='IWTFRORD' and PMCd='" + ADC("wOdIWtFrOrd") + "'  " + _
                                  "Where RrTcTyp='WTT'  and RrCmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and RrCtg='D' and RrSCtg='' " + _
                                  "and " + CStr(wTotDiaWt) + " between round(RrFrLn,3) and round(RrToLn,3) " + _
                                  "And RrCmCd In ('" + ADC("OmCmCd") + "','" + ctSelfCmCd + "') And RrDmCd In ('" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "','') " + _
                                  "Order By (Case when RrCmCd='" + ADC("OmCmCd") + "' Then 1 Else 2 End), " + _
                                  "(Case when RrDmCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' Then 1 Else 2 End) ")
        If wRs_TolWt.RecCount > 0 Then
           '3.11.0
           ADC("wOdMinDiaTolWt") = Fix((wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMinTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMinTolWt)) * 100) / 100
           ADC("wOdMaxDiaTolWt") = Round((wTotDiaWt + IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qMaxTolWt * wTotDiaWt / 100), 3), wRs_TolWt!qMaxTolWt)) + 0.004, 2)
             'ADC("wOdMinDiaTolWt") = wTotDiaWt - IIF(InStr(1, "," + ms_hTolWtPctDC + ",", ",D,", vbTextCompare) > 0, Round((wRs_TolWt!qmintolwt * wTotDiaWt / 100), 3), wRs_TolWt!qmintolwt)
