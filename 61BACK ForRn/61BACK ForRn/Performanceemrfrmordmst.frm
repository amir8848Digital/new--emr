                If GrdOrdLab.Value(i, "OlQty") = 0 Then GrdOrdLab.Value(i, "OlQty") = 1

                ' ***** Manali 3.03 - 03/07/08 - ADC("OmLkUpLabRt") passed as parameter if not blank
                ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
                GrdOrdLab.Value(i, "OlSalVal") = GetLabVal(ADC("OmCmCd"), _
                          GrdOrdLab.Value(i, "OlMCd"), GrdOrdLab.Value(i, "OlSCd"), _
                          GrdOrdLab.Value(i, "OlSalRt"), GrdOrdLab.Value(i, "OlQty"), _
                          NewValue, GrdOrdLab.Value(i, "OlQw"), "S", ADC("OmCmCtg"), ADC("OmCmCurCd"), _
                          IIF(ADC("OmLkUpLabRt") <> "", ADC("OmLkUpLabRt"), ""))

              End If

              ' ***** Manali Trading Module - Cmctg ="C" replaced by OmCmCtg
              GrdOrdLab.Value(i, "OlCstVal") = GetLabVal(ADC("OmCmCd"), _
                        GrdOrdLab.Value(i, "OlMCd"), GrdOrdLab.Value(i, "OlSCd"), _
                        GrdOrdLab.Value(i, "OlCstRt"), GrdOrdLab.Value(i, "OlQty"), _
                        NewValue, GrdOrdLab.Value(i, "OlCstQw"), "C", ADC("OmCmCtg"), ADC("OmCmCurCd"))

              GrdOrdLab.SaveRec (i)
            End If

          Next i
        End If
      End If
'    ' ******* Manali 3.5.0 - 15/05/09 - LabMCd "CHC" calculated On "wOdPerPcCSWt"
    
    ' ***** Manali Trading Module
    Case Is = UCase("wOdBaseVchSr")
      If ms_OmTcTyp = ctJtTcTyp Then
        If .Mode = fgmnorm Or .Mode = fgmCopy Or .Mode = fgmInitOver Then
'          If GrdOrdRm.Rows - 1 > 0 Or GrdOrdLab.Rows - 1 > 0 Then
'            Cancel = NewValue <> "" And NewValue <> .Value(RowNum, "wOdBaseVchSr") And .Value(RowNum, "wOdBaseVchSr") <> ""
'            If Cancel = True Then ErrMsg = "Base Voucher Cannot be changed when Rm/lab Details Exist": Exit Sub
'          End If
          Dim wBaseMustYn As String
          If mBaseTc <> "" Then
            wBaseMustYn = moCn.GetFldVal("Select TmBaseMustYn from TcMst where TmCoCd='" + gs_CoCd + "' and TmTc='" + ms_OmTc + "' and TmBaseTcs<>'' ")
            If NewValue <> "" Then
              wOdKeyArr = Split(NewValue, "/")
              If UBound(wOdKeyArr) <> 4 Then Cancel = True: ErrMsg = "Invalid Base Voucher": Exit Sub
              If Not (IsNumeric(wOdKeyArr(3)) And IsNumeric(wOdKeyArr(4))) Then Cancel = True: ErrMsg = "Invalid Base Voucher": Exit Sub
              wOdTc = wOdKeyArr(0)
              wOdYy = wOdKeyArr(1)
              wOdChr = wOdKeyArr(2)
              wOdNo = wOdKeyArr(3)
              wOdSr = wOdKeyArr(4)
              Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg " + _
                                        " Join OrdMst On OmCoCd=OdCoCd and OmTc=OdTc and OmChr=OdChr and OmNo=OdNo and OmIdNo=OdOmIdNo and OmPrtKey=OdPrtKey " + _
                                        " Join TcMst On TmCoCd=OdCoCd and TmTc='" + ms_OmTc + "' and TmBaseTcs=OdTc " + _
                                        " Where OdCoCd='" + IIF(ms_OmTc = "JIN", ADC("OmBaseCoCd"), ADC("OmCoCd")) + "' and OdTc='" + wOdTc + "' " + _
                                        " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                        " and OdDmCd='" + .Value(RowNum, "OdDmCd") + "'  " + _
                                        " and OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd='" + ADC("OmCmCd") + "' " + _
                                        " and OdPrtKey='" + ctCurrPrtn + "' ")
              If Cancel = True Then ErrMsg = "Invalid Base Voucher": Exit Sub
'            ElseIf wBaseMustYn = "Y" And NewValue = "" Then
'              Cancel = True: ErrMsg = "Base Voucher Is Must, Cannot Be Blank": Exit Sub
            End If
          End If
        End If
      End If

    ' ***** Manali Trading Module
    Case Is = UCase("wOdRefVchSr")
      If ms_OmTcTyp = ctJtTcTyp Then
        If .Mode = fgmnorm Or .Mode = fgmCopy Or .Mode = fgmInitOver Then
'          If GrdOrdRm.Rows - 1 > 0 Or GrdOrdLab.Rows - 1 > 0 Then
'            Cancel = NewValue <> "" And NewValue <> .Value(RowNum, "wOdRefVchSr") And .Value(RowNum, "wOdRefVchSr") <> ""
'            If Cancel = True Then ErrMsg = "Reference Voucher Cannot be changed when Rm/lab Details Exist": Exit Sub
'          End If
          If mRefTc <> "" Then
            If NewValue <> "" Then
              wOdKeyArr = Split(NewValue, "/")
              If UBound(wOdKeyArr) <> 4 Then Cancel = True: ErrMsg = "Invalid Reference Voucher": Exit Sub
              If Not (IsNumeric(wOdKeyArr(3)) And IsNumeric(wOdKeyArr(4))) Then Cancel = True: ErrMsg = "Invalid Reference Voucher": Exit Sub
              wOdTc = wOdKeyArr(0)
              wOdYy = wOdKeyArr(1)
              wOdChr = wOdKeyArr(2)
              wOdNo = wOdKeyArr(3)
              wOdSr = wOdKeyArr(4)
              Cancel = Not moCn.RecSeek("Select 'x' from OrdDsg " + _
                                        " Join TcMst On TmCoCd=OdCoCd and TmTc='" + ms_OmTc + "' and ','+TmRefTcs+',' like '%,'+OdTc +',%' " + _
                                        " Where OdCoCd='" + ADC("OmCoCd") + "' and OdTc='" + wOdTc + "' " + _
                                        " and OdYy='" + wOdYy + "' and OdChr='" + wOdChr + "' and OdNo=" + CStr(wOdNo) + " and OdSr=" + CStr(wOdSr) + " " + _
                                        " and OdDmCd='" + .Value(RowNum, "OdDmCd") + "' " + _
                                        " and OdPrtKey='" + ctCurrPrtn + "'  ")
              If Cancel = True Then ErrMsg = "Invalid Reference Voucher": Exit Sub

            End If
          End If
        End If
      End If

    End Select
  End With
End Sub
