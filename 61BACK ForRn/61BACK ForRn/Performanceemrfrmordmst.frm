Private Sub SetDsgPrc(ByVal pDsgRowNum As Integer, Optional ByVal pValTyp As en_ValTyp = VtCalc)
  Dim i As Integer, wd_RmVal As Double, wd_LabVal As Double
  For i = 1 To GrdOrdRm.Rows - 1
    If Not GrdOrdRm.IsDel(i) Then
      If pValTyp = VtCalc Then
        wd_RmVal = wd_RmVal + GrdOrdRm.Value(i, "OrSalVal") + GrdOrdRm.Value(i, "OrSetSalVal")
      ElseIf pValTyp = VtCst Then
        wd_RmVal = wd_RmVal + GrdOrdRm.Value(i, "OrCstVal") + GrdOrdRm.Value(i, "OrSetCstVal")
      End If
    End If
  Next i
  For i = 1 To GrdOrdLab.Rows - 1
    If Not GrdOrdLab.IsDel(i) Then
      If pValTyp = VtCalc Then
        wd_LabVal = wd_LabVal + GrdOrdLab.Value(i, "OlSalVal")
      ElseIf pValTyp = VtCst Then
        wd_LabVal = wd_LabVal + GrdOrdLab.Value(i, "OlCstVal")
      End If
    End If
  Next i
  If pValTyp = VtCalc Then
    GrdOrdDsg.Value(pDsgRowNum, "OdCalcPrc") = IIF(wd_RmVal + wd_LabVal < 0, 0, wd_RmVal + wd_LabVal)
  ElseIf pValTyp = VtCst Then
    GrdOrdDsg.Value(pDsgRowNum, "OdCstPrc") = IIF(wd_RmVal + wd_LabVal < 0, 0, wd_RmVal + wd_LabVal)
  End If
End Sub
Private Function GetDCRmVal(ByVal ws_IdName As String, Optional wRmCtg As String) As Double
  ' ****** Manali 3.5.0 - 16/05/09 - new optional parameter added wRmCtg for "DHC" and "CHC"
  '*** (Jen 2.12)
  Dim wf_RmVal As Double, wi_i As Integer, ws_RmCtg As String
  wf_RmVal = 0
  For wi_i = 1 To GrdOrdRm.Rows - 1
    ws_RmCtg = GrdOrdRm.Value(wi_i, "OrRmCtg")
    ' ****** Manali 3.5.0 - 16/05/09 - for "DHC" and "CHC"
    'If Not IsMissing(wRmCtg) Then
    If wRmCtg <> "" Then
      If ws_RmCtg = wRmCtg And Not (GrdOrdRm.IsDel(wi_i)) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      End If
    Else
    ' ****** Manali 3.5.0 - 16/05/09 - for "DHC" and "CHC"
      If (ws_RmCtg = "C" Or ws_RmCtg = "D") And Not (GrdOrdRm.IsDel(wi_i)) Then
        wf_RmVal = wf_RmVal + GrdOrdRm.Value(wi_i, ws_IdName)
      End If
    End If
  Next wi_i
  
  GetDCRmVal = wf_RmVal
  '*** (Jen 2.12)
End Function

