  '                             "Sum(IsNull(DrWt/ (case when DrRmCtg in ('C', 'D') then 5 else 1 end), 0)) as qDrGrsWt from DsgMst " + _
  '                             "Left Outer Join DsgRm Dr on DmTcTyp = DrTcTyp and DmCd = DrCd and DmSz = DrSz /* and DrRmCtg in ('D','C') */ " + _
