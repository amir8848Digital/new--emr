Private Sub CmdGS_Click()
  '*** Display or hide the Suffix Generation frame depending on the toggle state
  '*** The CausesValidation property of this command button is false. The purpose of this is
  '*** when the Design Details option is selected, the grid GrdOrdDsg should not be fully
      'validated i.e. only the validation of the column on which the cursor was previously
      'standing should take place and the row itself should not be saved. When the user exits
      'out of this option, the cursor returns to the same row.
      
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn Then DispMsg "Cannot Generate Suffix In Orders Design of Previous Partition", etError: Exit Sub
  If ms_OmTcTyp <> "PL" And CDate(ms_PurgeDt) > ADC("OmDt") Then DispMsg "Cannot Generate Suffix In Orders Prior to Purge Date", etError: Exit Sub
  
  Dim wi_Row As Integer
  If FraGS.Visible = False Then
    If GrdOrdDsg.HalfValidate Then
      GrdOrdDsg.SetFocus
      Exit Sub
    End If
    '*** Jay 3.4(FG)
    If ms_OmTcTyp = "FG" And Not GrdOrdDsg.IsNew(GrdOrdDsg.Row) Then DispMsg "Can Not Generate Suffix for Existing Record", etError: Exit Sub
    '*** Jay 3.4(FG)
    Call DispFra(GenSfx)
    wi_Row = GrdOrdDsg.Row
    If GrdOrdDsg.IsNew(wi_Row) And ms_OmTcTyp = "PL" Then
      ADC("wGsOdSfx") = GenSuffix(wi_Row)
      'adc("wGsOdSfxDesc") = ""
    Else
      ADC("wGsOdSfx") = GrdOrdDsg.Value(wi_Row, "OdSfx")
      ADC("wGsOdSfxDesc") = GrdOrdDsg.Value(wi_Row, "OdSfxDesc")
    End If
  Else
    Call DispFra(GenSfx)
    wi_Row = GrdOrdDsg.Row
    GrdOrdDsg.Value(wi_Row, "OdSfx") = ADC("wGsOdSfx")
    GrdOrdDsg.Value(wi_Row, "OdSfxDesc") = ADC("wGsOdSfxDesc")
  End If
End Sub
