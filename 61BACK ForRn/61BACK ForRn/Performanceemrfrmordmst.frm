Private Sub GrdOrdDsg_RowWhen(ByVal RowNum As Integer)
'DispMsg "RowWhen", etWarning   ' Trading
'  Debug.Print "RowWhen"

  '*** Show the Sketch and 3D pictures for the design in the current row of GrdOrdDsg
  '*** If GrdOrdDsg.IsNew Then
  '       OdSr= {Max(OdSr) from OrdDsg(OdTc= OmTc, OdYy= OmYy, OdChr= OmChr, OdNo= OmNo)} + 1
  '       (If the scope option was not given then we could have used the following syntax: OdSr= {Max of GrdDsg} + 1)
  '       Set the default values for OdPrtCd, OdDelDt, OdExpDelDt, OdCmPrdInst, OdCmStmpInst,
  '       OdVaCtg, OdMulby, OdFixPrc, OdGldAs, OdLabAs, OdIWtEqOrd, OdIWtFrOrd, OdIGldRtEqOrd, OdCls,
  '       OdHld
  
    
  Dim w3DPth As String, wHskPth  As String
  Dim wo_rsCustDsg As MDORowSet
  
  
  With GrdOrdDsg

      If .IsNew(RowNum) Then .Value(RowNum, "OdPrtKey") = ctCurrPrtn   '****** Sachin 3.02 Default value for Partition Key field
  
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
      If ADC("wCustDmCd").Enabled = True Then
        ADC("wCustDmCd").Enabled = False
        ADC("wCustDmCdTmp").Enabled = False
      End If
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
    
'    '****** Zubin 3.02.01 - 26/03/08
    ADC("wOdPicNm") = GrdOrdDsg.Value(RowNum, "OdPicNm")
    ADC("wOdPoNo") = GrdOrdDsg.Value(RowNum, "OdPoNo")
'    '****** Zubin 3.02.01 - 26/03/08

    If ms_OmTcTyp = "JT" Then CmdGenDmStkNo.Enabled = True 'Or
    
    If Not GrdOrdDsg.IsNew(RowNum) Then
      
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
      ms_CustDsg = False
      CmdCustDsg.CausesValidation = True
      CmdCustDsg.Enabled = False
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
      ' ***** Manali Trading Module
      If ms_OmTc = "FIN" Then CmdGenDmStkNo.Enabled = False 'Or ms_OmTcTyp = "JT"  '*** Jay 3.4(FG)
      ' ***** Manali Trading Module
      FraPic3D.Left = wFraPic3DLft: FraPic3D.Top = wFraPic3DTop
      FraPic3D.Height = wFraPic3DHt: FraPic3D.Width = wFraPic3DWdt
      FraPicHsk.Left = wFraPicHskLft: FraPicHsk.Top = wFraPicHskTop
      FraPicHsk.Height = wFraPicHskHt: FraPicHsk.Width = wFraPicHskWdt
      
      '*** Jay 3.2.0 [PicNm]
      w3DPth = GetPictPath(ms_DmTcTyp, False, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), .Value(RowNum, "OdSr"), .Value(RowNum, "OdPicNm"))
      wHskPth = GetPictPath(ms_DmTcTyp, True, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), .Value(RowNum, "OdSr"), .Value(RowNum, "OdPicNm"))
      '*** Jay 3.2.0 [PicNm]
      'w3DPth = GetPictPath(ms_DmTcTyp, .Value(RowNum, "OdDmCd"), , False)
      'wHskPth = GetPictPath(ms_DmTcTyp, .Value(RowNum, "OdDmCd"), , True)
      
      Call ShowPic(wPic3DHt, wPic3DWdt, w3DPth, Pic3D)
      Call ShowPic(wPicHskHt, wPicHskWdt, wHskPth, PicHsk)
      
      '****** Sachin 2.12 - Patch 03 - 20/04/2006
      FraCustDsg.ZOrder
      CmdOrdCpy.ZOrder
      CmdOrdDet.ZOrder
      CmdRefRt.ZOrder
      CmdSM.ZOrder
      CmdCustDsg.ZOrder
      '****** Sachin 2.12 - Patch 03 - 20/04/2006
    End If
    
    If GrdOrdDsg.IsNew(RowNum) Then
      ' ****** Sachin 2.12 - 20/12/05 - Cust Dsg Copy
      '*** Jay 3.4(FG) [Tctyp = fg added]
      If ms_OmTcTyp = "SO" Or ms_OmTcTyp = "PL" Or ms_OmTcTyp = "QT" Or ms_OmTcTyp = "FG" Or ms_OmTcTyp = "JT" Then
      '*** Jay 3.4(FG)
        CmdCustDsg.CausesValidation = False
        CmdCustDsg.Enabled = True
        ' ***** Manali Trading Module
        If ms_OmTc = "FIN" Or ms_OmTcTyp = ctJtTcTyp Then CmdGenDmStkNo.Enabled = True '*** Jay 3.4(FG)
        ' ***** Manali Trading Module
        If ms_CustDsg = False Then ADC("wCustDmCd") = "": ADC("WOURDMCD") = "": ADC("WOURSFX") = "": ADC("WOURDMSZ") = ""
        If ADC("wOurDmCd") = "" Then
          '****** Sachin 3.02 08-12-07 - Current Partition
          Set wo_rsCustDsg = moCn.OpenRes("Select cdourdmcd, cdoursfx, cdourdmsz " + _
                                          "From CustDsg " + _
                                          "Where CdCtg='C' And CdCd='" + ADC("OmCmCd") + "' And CdCustDmCd='" + ADC("wCustDmCd") + "' And CdPrtKey='" + ctCurrPrtn + "' " + _
                                          "And cdoursfx = IsNull((Select max(cdoursfx) From CustDsg " + _
                                          "Where CdCtg='C' And CdCd='" + ADC("OmCmCd") + "' And cdcustdmcd='" + ADC("wCustDmCd") + "' and cdoursfx <> '' And CdPrtKey='" + ctCurrPrtn + "' ),'')" + _
                                          "Group By cdoursfx, cdourdmsz, cdourdmcd   " + _
                                          "Order By CdOurSfx Desc, CdOurDmSz Desc, CdOurDmCd Desc")
          
          If Not (wo_rsCustDsg.EOF Or wo_rsCustDsg.BOF) Then
             .Value(RowNum, "OdDmCd") = wo_rsCustDsg!CdOurDmCd
             .Value(RowNum, "OdSfx") = wo_rsCustDsg!CdOurSfx
             .Value(RowNum, "OdDmSz") = wo_rsCustDsg!CdOurDmSz
          End If
          '.Value(RowNum, "OdDmCd") = moCn.GetFldVal("Select IsNull((Select max(CdOurDmCd) from CustDsg where CdCtg= 'C' and CdCd= '" + ADC("OmCmCd") + "' and CdCustDmCd= '" + ADC("wCustDmCd") + "' and CdOurSfx= '" + .Value(RowNum, "OdSfx") + "' and CdOurDmSz= '" + .Value(RowNum, "OdDmSz") + "' Group By CdCustDmCd, CdOurSfx, CdOurDmSz), " + _
                                        " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg= 'C' and CdCd= '" + ADC("OmCmCd") + "' and CdCustDmCd= '" + ADC("wCustDmCd") + "' and CdOurSfx= '" + .Value(RowNum, "OdSfx") + "' and CdOurDmSz= '' Group By CdCustDmCd, CdOurSfx, CdOurDmSz), " + _
                                        " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg= 'C' and CdCd= '" + ADC("OmCmCd") + "' and CdCustDmCd= '" + ADC("wCustDmCd") + "' and CdOurSfx= '' and CdOurDmSz= '" + .Value(RowNum, "OdDmSz") + "'  Group By CdCustDmCd, CdOurSfx, CdOurDmSz), " + _
                                        " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg= 'C' and CdCd= '" + ADC("OmCmCd") + "' and CdCustDmCd= '" + ADC("wCustDmCd") + "' and CdOurSfx= '' and CdOurDmSz= '' Group By CdCustDmCd, CdOurSfx, CdOurDmSz), ''))))")
         
          Set wo_rsCustDsg = Nothing
        Else
          .Value(RowNum, "OdDmCd") = ADC("WOURDMCD")
          .Value(RowNum, "OdSfx") = ADC("WOURSFX")
          .Value(RowNum, "OdDmSz") = ADC("WOURDMSZ")
          'ADC("WOURDMCD") = "": ADC("WOURSFX") = "": ADC("WOURDMSZ") = ""
        End If
        
      End If
      ' ****** Sachin 2.12 - 20/12/05 - Cust Dsg Copy
      
      '##### If .Value(RowNum, "OdSr") = 0 Then .Value(RowNum, "OdSr") = .MaxVal("OdSr") + 1
      If .Value(RowNum, "OdSr") = 0 Then .Value(RowNum, "OdSr") = _
         moCn.GetFldVal("Select max(OdSr) from OrdDsg where " + _
         "OdCoCd= '" + ADC("OmCoCd") + "' and OdTc= '" + ADC("OmTc") + "' and " + _
         "OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and OdNo= " + CStr(ADC("OmNo")) + IIF(ADC("OmTc") <> "PL", " And OdPrtKey='" + ctCurrPrtn + "' ", "")) + 1
        
        .Value(RowNum, "OdPrtCd") = ADC("OmPrtCd")
        .Value(RowNum, "OdDelDt") = ADC("OmDelDt")
        .Value(RowNum, "OdExpDelDt") = ADC("OmExpDelDt")
        
        
        '****** Zubin 3.02.01 - 26/03/08
        .Value(RowNum, "OdChgPtrOnStwYN") = ADC("OmChgPtrOnStwYN")
        '****** Zubin 3.02.01 - 26/03/08
      
      '****** (Jen 2.12) (give default value only when the field is blank/ zero) ******
      ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
      If .Value(RowNum, "OdCmPrdInst") = "" Then .Value(RowNum, "OdCmPrdInst") = moCn.GetFldVal("Select CmPrdInst from CustMst where " + _
                                      "CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd='" + ADC("OmCmCd") + "'")
      If .Value(RowNum, "OdCmStmpInst") = "" Then .Value(RowNum, "OdCmStmpInst") = moCn.GetFldVal("Select CmStmpInst from CustMst where " + _
                                       "CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd='" + ADC("OmCmCd") + "'")
      If .Value(RowNum, "OdVaCtg") = "" Then .Value(RowNum, "OdVaCtg") = moCn.GetFldVal("Select hDmVaCtg from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")
      If .Value(RowNum, "OdMulby") = 0 Then .Value(RowNum, "OdMulby") = ADC("OmMulBy")
      If .Value(RowNum, "OdMrpMulby") = 0 Then .Value(RowNum, "OdMrpMulby") = ADC("OmMrpMulBy")          '4.1.4
      If .Value(RowNum, "OdFixPrc") = "" Then .Value(RowNum, "OdFixPrc") = ADC("OmFixPrc")
      If .Value(RowNum, "OdGldAs") = "" Then .Value(RowNum, "OdGldAs") = ADC("OmGldAs")
      '****** Sachin 2.13.0 - 24-05-2006 ******
      If .Value(RowNum, "OdLabAs") = "" Then .Value(RowNum, "OdLabAs") = ADC("OmLabAs")
      '****** Sachin 2.13.0 - 24-05-2006 ******
      If .Value(RowNum, "OdIWtEqOrd") = "" Then .Value(RowNum, "OdIWtEqOrd") = ADC("OmIWtEqOrd")
      If .Value(RowNum, "OdIWtFrOrd") = "" Then .Value(RowNum, "OdIWtFrOrd") = ADC("OmIWtFrOrd")
      If .Value(RowNum, "OdIGldRtEqOrd") = "" Then .Value(RowNum, "OdIGldRtEqOrd") = ADC("OmIGldRtEqOrd")
      
      '****** Zubin 3.02.01 - 26/03/08
      If .Value(RowNum, "OdILabWtFrOrd") = "" Then .Value(RowNum, "OdILabWtFrOrd") = ADC("OmILabWtFrOrd")
      '****** Zubin 3.02.01 - 26/03/08

      .Value(RowNum, "OdCls") = "N"
      If .Value(RowNum, "OdHld") = "" Then .Value(RowNum, "OdHld") = "N"
      '***Geeta*****3.02 Patch****
      If .Value(RowNum, "OdChgPtrOnStwYN") = "" Then .Value(RowNum, "OdChgPtrOnStwYN") = ADC("OmChgPtrOnStwYN")
      '***Geeta*****3.02 Patch****
      
'*********************************** urmi *************************************************
      If .Value(RowNum, "OdLine") = "" Then .Value(RowNum, "OdLine") = ADC("OmLine")
      If CStr(.Value(RowNum, "OdWDiaAvlblDt")) = "" Then .Value(RowNum, "OdWDiaAvlblDt") = ADC("OmWDiaAvlblDt")
      If CStr(.Value(RowNum, "OdHDiaAvlblDt")) = "" Then .Value(RowNum, "OdHDiaAvlblDt") = ADC("OmHDiaAvlblDt")
      If .Value(RowNum, "OdWH") = "" Then .Value(RowNum, "OdWH") = moCn.GetFldVal("Select hWH from Head where HCoCd= '" + ADC("OmCoCd") + "' and HCd='" + ctSelfCmCd + "'")
'*********************************** urmi *************************************************
      If .Value(RowNum, "OdOmCtCd") = "" Then .Value(RowNum, "OdOmCtCd") = ADC("OmHCtCd")
      
      ' ***** Manali 3.5.0 - 08/11/08 - Inserted Date at Od-level added
      If .Value(RowNum, "InsDt") = "" Then .Value(RowNum, "InsDt") = moCn.SrvrDate
      ' ***** Manali 3.5.0 - 08/11/08 - Inserted Date at Od-level added
    Else
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
      ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
      ADC("WCUSTDMCD") = moCn.GetFldVal("Select IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CdCd= '" + ADC("OmCmCd") + "' and CdOurDmCd= '" + .Value(RowNum, "OdDmCd") + "' and CdOurSfx= '" + .Value(RowNum, "OdSfx") + "' and CdOurDmSz= '" + .Value(RowNum, "OdDmSz") + "' " + IIF(.Value(RowNum, "OdPrtKey") = ctCurrPrtn, " and CdPrtKey='" + ctCurrPrtn + "' ", "") + "  Group By CdOurDmCd, CdOurSfx, CdOurDmSz), " + _
                                      " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CdCd= '" + ADC("OmCmCd") + "' and CdOurDmCd= '" + .Value(RowNum, "OdDmCd") + "' and CdOurSfx= '" + .Value(RowNum, "OdSfx") + "' and CdOurDmSz= '' " + IIF(.Value(RowNum, "OdPrtKey") = ctCurrPrtn, " and CdPrtKey='" + ctCurrPrtn + "' ", "") + " Group By CdOurDmCd, CdOurSfx, CdOurDmSz), " + _
                                      " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CdCd= '" + ADC("OmCmCd") + "' and CdOurDmCd= '" + .Value(RowNum, "OdDmCd") + "' and CdOurSfx= '' and CdOurDmSz= '" + .Value(RowNum, "OdDmSz") + "' " + IIF(.Value(RowNum, "OdPrtKey") = ctCurrPrtn, " and CdPrtKey='" + ctCurrPrtn + "' ", "") + " Group By CdOurDmCd, CdOurSfx, CdOurDmSz), " + _
                                      " IsNull((Select max(CdCustDmCd) from CustDsg where CdCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CdCd= '" + ADC("OmCmCd") + "' and CdOurDmCd= '" + .Value(RowNum, "OdDmCd") + "' and CdOurSfx= '' and CdOurDmSz= '' " + IIF(.Value(RowNum, "OdPrtKey") = ctCurrPrtn, " and CdPrtKey='" + ctCurrPrtn + "' ", "") + " Group By CdOurDmCd, CdOurSfx, CdOurDmSz), ''))))")
                                      
      LblModDesc.Caption = moCn.GetFldVal("Select DmaDesc From DsgModAvl Where DmaTcTyp='" + IIF(ADC("OMTC") = "QS", "SM", "DM") + "' And DmaCd='" + .Value(RowNum, "ODDMCD") + "' " + _
                                                "And DmaSz='' And DmaAvlSz ='" + .Value(RowNum, "ODDMSZ") + "'")
      '****** Sachin 2.12 20/12/05 - Cust Dsg in SO
      
    ' ******** Manali 3.5.0 - 16/05/09 - Per Pc Dia Qty/Wt on Od Footer
      lblOdDiaDet.Caption = "[" + CStr(.Value(.Row, "wOdPerPcDiaQty")) + "/" + CStr(.Value(.Row, "wOdPerPcDiaWt")) + "]"
    ' ******** Manali 3.5.0 - 16/05/09 - Per Pc Dia Qty/Wt on Od Footer
    End If

    '****** Zubin 3.02.01 - 26/03/08
    .ColProp("wModYN").ToolTipText = LblModDesc.Caption
    '****** Zubin 3.02.01 - 26/03/08
  End With
End Sub
Private Sub GrdOrdDsg_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  
'  '****** Sachin 3.02 05-12-07 - Locking Design Grid In Previous Partition
'  If ADC("OmPrtKey") = ctPrevPrtn Then Cancel = True: ErrMsg = "Cannot Edit Orders In Previous Partition": Exit Sub
  
  '*** Set Helps For Each Field
  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdDsg.Value(RowNum, "OdPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub
  ' If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
  
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub
  
'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If

  ' ***** Manali Trading Module
  If CmdInvHd.Visible = True And Not mInvExists Then
    Cancel = True: ErrMsg = "Invoice Does not exist, cannot edit record": Exit Sub
  End If
  ' ***** Manali Trading Module
  
  With GrdOrdDsg
    Select Case ColName
       Case Is = UCase("OdOrdEnt")
        '****** Sachin 3.02 07-12-07 - Check On Current Partition
        ' ***** Manali Trading Module
        If ms_OmTcTyp = ctJtTcTyp Then
          If ms_OmTc = "JCN" Then
            Cancel = True: ErrMsg = "Cannot Edit": Exit Sub
          End If
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn And .Value(RowNum, "OdExpQty") > 0
          ErrMsg = "Cannot Edit Value when Quantity is Matched Partially/Completely": Exit Sub
        Else
        ' ***** Manali Trading Module
          Cancel = .Value(RowNum, "OdPrtKey") = ctCurrPrtn _
                    And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                            " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ADC("OmCoCd") + "' and " + _
                            "   OdTc= '" + ADC("OmTc") + "' and " + _
                            "   OdYy= '" + ADC("OmYy") + "' and " + _
                            "   OdChr= '" + ADC("OmChr") + "' and " + _
                            "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                            "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
                        Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                                "   BOdTc= '" + ADC("OmTc") + "' and " + _
                                "   BOdYy= '" + ADC("OmYy") + "' and " + _
                                "   BOdChr= '" + ADC("OmChr") + "' and " + _
                                "   BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                                "   BOdSr= " + CStr(.Value(RowNum, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "'"))
          ErrMsg = "Cannot Edit Value when Recs exist in Bag"
          Exit Sub
         End If
      '************Geeta***********Emr207*****15/07/04
     Case Is = UCase("OdSalPrc")
       If ADC("OmLockSalPrcYN") = "Y" Then _
          Cancel = True: ErrMsg = "Cannot Edit Sales Price, When Lock sales Prices is 'Y'": Exit Sub
     End Select
   
    Select Case ColName
    Case Is = UCase("wOdBag")
      '*** (Jen 2.11)
      Cancel = Not .IsNew(RowNum)
      If Cancel Then ErrMsg = "Cannot Edit Bag Number": Exit Sub
      '*** (Jen 2.11)
      Call HlpList.BagNo(ADC("OmCoCd"), "N", "PFG", , , , , , , , IIF(ms_OmTc = "JCN", "N", ""))
      
    Case Is = UCase("OdDmCd")
      Cancel = Not .IsNew(RowNum)
      If Cancel Then ErrMsg = "Cannot Edit Design Cd": Exit Sub
      Call HlpList.DmCd(ms_DmTcTyp)
      ' Since OdChkTol is Hidden from ver 2.12 - a default value for ChkTol is set below for manually added new rows
      If .IsNew(RowNum) Then .Value(RowNum, "OdChkTol") = "Y"
      
    Case Is = UCase("OdSfx")
      '*** Jay 3.4(FG)
      If ms_OmTcTyp = "FG" And Not .IsNew(RowNum) Then Cancel = True: ErrMsg = "Cannot Change Design Suffix": Exit Sub
      '*** Jay 3.4(FG)
      '*** JAY 2.14 ***
      ' ***** Manali Trading Module - OmCmCtg added
      Call HlpList.OdSfx(ctSelfCoCd, .Value(RowNum, "OdDmCd"), ADC("OmCmCtg"), ADC("OmCmCd"))
      'Call HlpList.OdSfx(ctSelfCoCd, .Value(RowNum, "OdDmCd"))
      '*** JAY 2.14 ***
      'Call HlpList.OdSfx(ADC("OmCoCd"), .Value(RowNum, "OdDmCd"))
    Case Is = UCase("OdDmSz")
      Call HlpList.PMCd("DMSZ")
    Case Is = UCase("OdPrtCd")
        Call HlpList.PMCd("PRTCD")
    Case Is = UCase("OdKt")
      Call HlpList.PMCd("KT")
    Case Is = UCase("OdDmCol")
      '****** Sachin 3.02 07-12-07 - Check On Current Partition
      Cancel = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") = ctCurrPrtn _
                  And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                          " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ADC("OmCoCd") + "' and " + _
                          "   OdTc= '" + ADC("OmTc") + "' and " + _
                          "   OdYy= '" + ADC("OmYy") + "' and " + _
                          "   OdChr= '" + ADC("OmChr") + "' and " + _
                          "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
                  Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                          "     BOdTc= '" + ADC("OmTc") + "' and " + _
                          "     BOdYy= '" + ADC("OmYy") + "' and " + _
                          "     BOdChr= '" + ADC("OmChr") + "' and " + _
                          "     BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "     BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "' "))
      ' URMI PrdSeq HELP 2.04
      If Cancel = True Then ErrMsg = "Cannot Edit Value when Recs exist in Bag": Exit Sub
      Call HlpList.PMCd("DMCOL")
    Case Is = UCase("OdFixPrc")
      Call HlpList.PMCd("YN")
    
    '*** (Jen 3.01)
    Case Is = UCase("OdPrdSeq")
      '****** Sachin 3.02 07-12-07 - Check On Current Partition
      Cancel = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") = ctCurrPrtn _
               And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                          " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ADC("OmCoCd") + "' and " + _
                          "   OdTc= '" + ADC("OmTc") + "' and " + _
                          "   OdYy= '" + ADC("OmYy") + "' and " + _
                          "   OdChr= '" + ADC("OmChr") + "' and " + _
                          "   OdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "   OdSr= " + CStr(.Value(RowNum, "OdSr"))) > 0 _
              Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                          " BOdTc= '" + ADC("OmTc") + "' and " + _
                          " BOdYy= '" + ADC("OmYy") + "' and " + _
                          " BOdChr= '" + ADC("OmChr") + "' and " + _
                          " BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                          " BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "' "))
      If Cancel = True Then ErrMsg = "Cannot Edit Value when Recs exist in Bag": Exit Sub
    
      Call HlpList.vPMCd(ADC("OmCoCd"), "PRDSEQ")
    '*** (Jen 3.01)
    
    '****** Zubin 3.02.01 - 26/03/08
    Case Is = UCase("wOdPoNo")
      ' ***** Manali 3.03 - (Enabled status checked for IDE module)
      If ADC("wOdPoNo").Enabled = True Then ADC("wOdPoNo").SetFocus
    '****** Zubin 3.02.01 - 26/03/08
    
    '*** Jay 3.4(FG)
    Case Is = UCase("OdDmStkYy")
      If ms_OmTcTyp = "FG" And Not .IsNew(RowNum) Then Cancel = True: ErrMsg = "Cannot Change Design Stk Yy": Exit Sub
      Call HlpList.PMCd("Yy")
    
    Case Is = UCase("OdDmStkChr")
      Call HlpList.PMCd("BCHR", "'P'")
          
    Case Is = UCase("OdDmStkNo")
      Call HlpList.OdDmStkNo(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx"), _
                          GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr"))
    ' ***** Manali Trading Module
    Case Is = UCase("wOdBaseVchSr")
      Call HlpList.BaseRefVch("B", ms_OmTc, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdSfx"), .Value(RowNum, "OdDmSz"), .Value(RowNum, "OdDmStkYy"), .Value(RowNum, "OdDmStkChr"), .Value(RowNum, "OdDmStkNo"), ADC("OmCmCtg"), ADC("OmCmCd"))
      
    Case Is = UCase("wOdRefVchSr")
      Call HlpList.BaseRefVch("R", ms_OmTc, .Value(RowNum, "OdDmCd"), .Value(RowNum, "OdSfx"), .Value(RowNum, "OdDmSz"), .Value(RowNum, "OdDmStkYy"), .Value(RowNum, "OdDmStkChr"), .Value(RowNum, "OdDmStkNo"))
    ' ***** Manali Trading Module
    End Select
  End With
End Sub
Private Sub GrdOrdDsg_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
  '****** Grd1.AddSave "Grd2", asCurrent
  '****** The above line indicates that whenever the row of Grid1 which triggered the recal is
         'saved then save the recalculeted row of Grid2 also.
         '(The second parameter 'asCurrent' indicates that only the current rec of Grid2 should be saved)
         'For example if OrRmWt of GrdOrdRm changes, then recalc should happen only for
         '   the corresponding parent record in GrdOrdDsg
         '
         'ADC.AddSave "GrdOrdDsg", asAll
         'If the value of second parameter is 'asAll' then save all the records
         'For example if OmLmgSal of ADC changes and the recalc of OdLmgSal is dependent
         '   on OmLmgSal then recalc should happen for all the records in GrdOrdDsg
         '   and all the recs of GrdOrdDsg should be saved when ADC rec is saved
      
  '*** OdOrdQty on OdOrdEnt,OaOrdQty                          Normal,Copy of GrdOrdDsg and Normal,delete of GrdOrdAmd
      ' OdOrdQty= OdOrdEnt+ sum(OaOrdQty for the OdSr)
  '*** OdPrdQty on OdPrdEnt,OaPrdQty                          Normal,Copy of GrdOrdDsg and Normal,delete of GrdOrdAmd
      ' OdPrdQty= OdPrdEnt+ sum(OaPrdQty for the OdSr)
  '***/r OdCalcPrc on OrSalVal,OrSetSalVal,OlSalVal           Normal,Copy of GrdOrdDsg and (Normal,delete,CopyOver of GrdOrdRm or Normal,delete,CopyOver of GrdOrdLab)
      ' OdCalcPrc= sum(OrSalVal for the OdSr)+ sum(OrSetSalVal for the OdSr)+ sum(OlSalVal for the OdSr)
  '***/r OdSalPrc on OdCalcPrc* OdMulBy                       Normal,Copy
      'OdSalPrc= OdCalcPrc* OdMulBy
  '***/r OdCstPrc on OrCstVal,OrSetCstVal,OlCstVal,OdMulBy    Normal,Copy of GrdOrdDsg and (Normal,delete,CopyOver of GrdOrdRm or Normal,delete,CopyOver of GrdOrdLa`)
      ' OdCstPrc= sum(OrCstVal+ OrSetCstVal+ OlCstVal for the OdSr)* OdMulBy
  '*** OdPrdEnt on OdOrdEnt                                   Normal
      ' OdPrdEnt= OdOrdEnt
  '***/r OdGldAsWt on OdGldAs,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' If OrRmCtg= 'D' or 'C' then wt= OrWt/5 else wt= OrWt
      ' OdGldAsWt= sum(wt if the OrRmCtg exists in the OdGldAs Option selected)
  '***/r OdLabAsWt on OdLabAs,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' If OrRmCtg= 'D' or 'C' then wt= OrWt/5 else wt= OrWt
      ' OdLabAsWt= sum(wt if the OrRmCtg exists in the OdLabAs Option selected)
  '*** OdKt on OrRmCd, OrMainMet                              Normal of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      ' OdKt= RmKt from RmMst(RmCd= OrRmCd) where OrMainMet= 'Y'
  '*** OdDelDt on OmDelDt                                     Normal of ADC and Normal of GrdOrdDsg
      ' OdDelDt= OmDelDt
  '*** OdExpDelDt on OmExpDelDt                               Normal of ADC and Normal of GrdOrdDsg
      ' OdExpDelDt= OmExpDelDt
  '*** OdOmCtCd on OmhCtCd                                    Normal of ADC and Normal of GrdOrdDsg
      ' OdOmCtCd= OmhCtCd
      
  Dim i As Integer, wl_SourceGrdMode As en_fgMode, wModAvl As Integer
  
  ' ***** Manali Trading Module
  Dim wOdBaseRefVchSr As String, wOdKeyArr() As String
  Dim wOdTc As String, wOdYy As String, wOdChr As String, wOdNo As Integer, wOdSr As Integer
  ' ***** Manali Trading Module
  

  With GrdOrdDsg
    Select Case ColName
    Case Is = UCase("wOdBag")
      '*** (Jen 2.11)
      If .Mode = fgminit Then
        .Value(RowNum, "wOdBag") = .Value(RowNum, "OdBYy") + "/" + .Value(RowNum, "OdBChr") + "/" + Trim(CStr(.Value(RowNum, "OdBNo")))
      End If
      '*** (Jen 2.11)
      
    Case Is = UCase("OdOrdEnt")
    ' ***** Manali Trading Module
    If ms_OmTcTyp = ctJtTcTyp Then
      If .Mode = fgmnorm Then
        Dim wRsDsgDet As MDORowSet, wBaseRef As String
        wBaseRef = IIF(.Value(RowNum, "wOdBaseVchSr") <> "", .Value(RowNum, "wOdBaseVchSr"), .Value(RowNum, "wOdRefVchSr"))
        If wBaseRef <> "" Then
          Set wRsDsgDet = moCn.OpenRes("Select OdSfx, OdDmSz, OdDmStkYy, OdDmStkChr, OdDmStkNo, Convert(Decimal (14,1), OdOrdQty - OdExpQty) as qBalQty from OrdDsg " + _
                                     "Where OdCoCd='" + IIF(ms_OmTc = "JIN", ADC("OmBaseCoCd"), ADC("OmCoCd")) + "' and " + _
                                     "OdTc+'/'+OdYy+'/'+OdChr+'/'+LTrim(Rtrim(str(OdNo)))+'/'+LTrim(Rtrim(str(OdSr)))='" + wBaseRef + "' ")
          
          Do While Not (wRsDsgDet.EOF Or wRsDsgDet.BOF)
            .Value(.Row, "OdSfx") = wRsDsgDet!OdSfx
            .Value(.Row, "OdDmSz") = IIF(.Value(.Row, "OdDmSz") = "", wRsDsgDet!OdDmSz, .Value(.Row, "OdDmSz"))
            .Value(.Row, "OdDmStkYy") = IIF(.Value(.Row, "OdDmStkYy") = "", wRsDsgDet!OdDmStkYy, .Value(.Row, "OdDmStkYy"))
            .Value(.Row, "OdDmStkChr") = IIF(.Value(.Row, "OdDmStkChr") = "", wRsDsgDet!OdDmStkChr, .Value(.Row, "OdDmStkChr"))
            .Value(.Row, "OdDmStkNo") = IIF(.Value(.Row, "OdDmStkNo") = 0, wRsDsgDet!OdDmStkNo, .Value(.Row, "OdDmStkNo"))
            .Value(.Row, "OdOrdEnt") = IIF(.Value(.Row, "OdOrdEnt") = 0 Or .Value(.Row, "OdOrdEnt") > wRsDsgDet!qBalQty, wRsDsgDet!qBalQty, .Value(.Row, "OdOrdEnt"))
            Exit Do
          Loop
        End If
      End If
    End If
    
    Case Is = UCase("OdOrdQty")
      Dim wd_OaOrdQty As Double
      If (.Mode = fgmnorm Or .Mode = fgmCopy) And (GrdOrdAmd.Mode = fgmnorm Or GrdOrdAmd.Mode = fgmdel) Then
        wd_OaOrdQty = 0
        For i = 1 To GrdOrdAmd.Rows - 1
          If Not GrdOrdAmd.IsDel(i) Then wd_OaOrdQty = wd_OaOrdQty + GrdOrdAmd.Value(i, "OaOrdQty")
        Next i
        .Value(.Row, "OdOrdQty") = .Value(.Row, "OdOrdEnt") + wd_OaOrdQty
        If SourceName = UCase("GrdOrdAmd") Then
            GrdOrdAmd.AddSave "GrdOrdDsg", asCurrent
        End If
      End If
      
    Case Is = UCase("OdPrdQty")
      If (.Mode = fgmnorm Or .Mode = fgmCopy) And (GrdOrdAmd.Mode = fgmnorm Or GrdOrdAmd.Mode = fgmdel) Then
        Dim wd_OaPrdQty As Double
        wd_OaPrdQty = 0
        For i = 1 To GrdOrdAmd.Rows - 1
          If Not GrdOrdAmd.IsDel(i) Then wd_OaPrdQty = wd_OaPrdQty + GrdOrdAmd.Value(i, "OaPrdQty")
        Next i
        .Value(GrdOrdDsg.Row, "OdPrdQty") = .Value(GrdOrdDsg.Row, "OdPrdEnt") + wd_OaPrdQty
        If SourceName = UCase("GrdOrdAmd") Then
          GrdOrdAmd.AddSave "GrdOrdDsg", asCurrent
        End If
      End If
    Case Is = UCase("OdCalcPrc")
      Dim wd_RmVal As Double, wd_LabVal As Double
      'urmi 2.06 LabRt
      'If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM"))) Then
      'urmi 2.06 LabRt
      'Manoj 2.10.0
      wl_SourceGrdMode = Me.Controls(SourceName).Mode
      'Manoj 2.10.0
      
      '*** (Bef 2.13)
      'If .Mode = fgmnorm _
      '   Or (.Mode = fgmCopy And _
      '        (mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or mf_CpyLabRate = False)) _
      '   Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then
      '*** (Bef 2.13)
      
      '*** (Jen 2.13)
      ' ****** Bef 3.03
'      If .Mode = fgmnorm _
'         Or (.Mode = fgmCopy And _
'              (mf_CpyVal = False Or mf_CpyRate = False Or _
'              (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or mf_CpyLabRate = False)) _
'         Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then

      ' ***** Manali 3.03 - Pd Mod - "GPSDCXAM" replaced by "GPSLDCXM"
      If .Mode = fgmnorm _
         Or (.Mode = fgmCopy And _
              (mf_CpyVal = False Or mf_CpyRate = False Or _
              (mf_CpyRate = True And ms_CpyRateCd <> "GPSLDCXM") Or mf_CpyLabRate = False)) _
         Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then

      '*** (Jen 2.13)
                
        'Manoj 2.10.0
                'mf_CpyLabRate = False)) Then
        'Manoj 2.10.0
        If (wl_SourceGrdMode = fgmnorm Or wl_SourceGrdMode = fgmCopyOver Or wl_SourceGrdMode = fgmdel) Then
' ###########################################  Manoj  ###########################################
          'Manoj 2.10.0
          Call SetDsgPrc(GrdOrdDsg.Row, VtCalc)
          'Manoj 2.10.0
' ###########################################  Manoj  ###########################################
          'If UCase(SourceName) <> UCase("GrdOrdDsg") Then Controls(SourceName).AddSave "GrdOrdDsg", asCurrent
          If UCase(SourceName) <> UCase("GrdOrdDsg") Then Controls(SourceName).AddSave "GrdOrdDsg", asCurrent
        End If
      End If
    Case Is = UCase("OdSalPrc")
      'urmi 2.06 LabRt
      ' If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM"))) Then
      '*********geeta********Emr207****ADC("OmLockSalPrcYN") = "N"
      wl_SourceGrdMode = Me.Controls(SourceName).Mode
     
      '*** (Bef 2.13)
      'If (.Mode = fgmnorm _
      '   Or (.Mode = fgmCopy And (mf_CpyRate = False Or _
      '                              (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or _
      '                               mf_CpyLabRate = False))) And ADC("OmLockSalPrcYN") = "N" Then
      '*** (Bef 2.13)
      
      '*** (Jen 2.13)
      If (.Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpySalPrc = False)) And ADC("OmLockSalPrcYN") = "N" Then
      '*** (Jen 2.13)
        .Value(RowNum, "OdSalPrc") = FnRndOff(.Value(RowNum, "OdCalcPrc") * .Value(RowNum, "OdMulBy"), 2, _
                                  moCn.GetFldVal("Select CmHRndOrdSalPrc from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd= '" + ADC("OmCmCd") + "'"))
      End If
    Case Is = UCase("OdCstPrc")
      'urmi 2.06 LabRt
      'If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM"))) Then
      'Manoj 2.10.0
      wl_SourceGrdMode = Me.Controls(SourceName).Mode
      '*** (Bef 2.13)
      'Manoj 2.10.0
      'If .Mode = fgmnorm _
      '   Or (.Mode = fgmCopy And (mf_CpyRate = False Or _
      '                              (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or _
      '                               mf_CpyLabRate = False)) Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then
      'Manoj 2.10.0
      '*** (Bef 2.13)
      
      '*** (Jen 2.13)
      ' ***** Bef 3.03 - Manali - Cst Rt/Val always from Current
'      If .Mode = fgmnorm _
'         Or (.Mode = fgmCopy And (mf_CpyVal = False Or mf_CpyRate = False Or _
'                                    (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or _
'                                     mf_CpyLabRate = False)) Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then
      ' ***** Bef 3.03 - Manali - Cst Rt/Val always from Current
      '*** (Jen 2.13)
      
      ' ***** Manali 3.03 - Cst Rt/Val/Prc always from Current
      If .Mode = fgmnorm Or .Mode = fgmCopy Or (SourceName <> .Name And wl_SourceGrdMode = fgmdel) Then
      ' ***** Manali 3.03 - Cst Rt/Val/Prc always from Current
      
      'If .Mode = fgmnorm _
         Or (.Mode = fgmCopy And (mf_CpyRate = False Or _
                                    (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM") Or _
                                     mf_CpyLabRate = False)) Then
        'wl_SourceGrdMode = Me.Controls(SourceName).Mode
        'Manoj 2.10.0
        If (wl_SourceGrdMode = fgmnorm Or wl_SourceGrdMode = fgmCopyOver Or wl_SourceGrdMode = fgmdel) Then
' ###########################################  Manoj  ###########################################
          'Manoj 2.10.0
'          For i = 1 To GrdOrdRm.Rows - 1
'            If Not GrdOrdRm.IsDel(i) Then
'              wd_RmVal = wd_RmVal + GrdOrdRm.Value(i, "OrCstVal") + GrdOrdRm.Value(i, "OrSetCstVal")
'              'wd_RmVal = wd_RmVal + IIf(GrdOrdRm.Value(i, "OrCstVal") > 0, GrdOrdRm.Value(i, "OrCstVal"), 0) + GrdOrdRm.Value(i, "OrSetCstVal")
'            End If
'          Next i
'          For i = 1 To GrdOrdLab.Rows - 1
'            If Not GrdOrdLab.IsDel(i) Then
'              wd_LabVal = wd_LabVal + GrdOrdLab.Value(i, "OlCstVal")
'            End If
'          Next i
'         .Value(GrdOrdDsg.Row, "OdCstPrc") = IIF(wd_RmVal + wd_LabVal < 0, 0, wd_RmVal + wd_LabVal) * .Value(GrdOrdDsg.Row, "OdMulBy")
'         '.Value(GrdOrdDsg.Row, "OdCstPrc") = (wd_RmVal + wd_LabVal) * .Value(GrdOrdDsg.Row, "OdMulBy")
          Call SetDsgPrc(GrdOrdDsg.Row, VtCst)
          'Manoj 2.10.0
' ###########################################  Manoj  ###########################################
          If UCase(SourceName) <> UCase("GrdOrdDsg") Then Controls(SourceName).AddSave "GrdOrdDsg", asCurrent
        End If
      End If
      
      
    Case Is = UCase("OdPrdEnt")
      '*** Jay 3.4(FG)
      ' ***** Manali Trading Module
      If .Mode = fgmnorm Then
         .Value(RowNum, "OdPrdEnt") = IIF(ms_OmTcTyp <> "FG" And ms_OmTcTyp <> "JT", .Value(RowNum, "OdOrdEnt"), 0)
      End If
      'If .Mode = fgmnorm Then .Value(RowNum, "OdPrdEnt") = .Value(RowNum, "OdOrdEnt")
      '*** Jay 3.4(FG)
    Case Is = UCase("OdGldAsWt")
      '*** (Bef 2.13)
      '#If (.Mode = fgmnorm) Or (.Mode = fgmCopy And mf_CpyRate = False) Then
      '*** (Bef 2.13)
      '*** (Jen 2.13)
      ''If .Mode = fgmnorm Or (.Mode = fgmCopy And mf_CpyVal = False) Then
      ' ********* Bef 3.03 **********
      'If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyVal = False Or mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSDCXAM"))) Then
      
      ' ***** Manali 3.03 - Pd Mod - "GPSDCXAM" replaced by "GPSLDCXM"
      If .Mode = fgmnorm Or (.Mode = fgmCopy And (mf_CpyVal = False Or mf_CpyRate = False Or (mf_CpyRate = True And ms_CpyRateCd <> "GPSLDCXM"))) Then
      '*** (Jen 2.13)
        If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmdel Or GrdOrdRm.Mode = fgmCopyOver) Then
          '****** (Bef 2.13 17/08/2006) .Value(.Row, "OdGldAsWt") = GetGldAsWt(.Row)
          
          '*** (Jen 2.13 17/08/2006)
          .Value(.Row, "OdGldAsWt") = GetGldAsWt(.Row, IIF(UCase(SourceColName) = UCase("OrMainMet") And RowNum > 0, RowNum, 0))
          '*** (Jen 2.13 17/08/2006)
                    
          '### This line is actually wrong if the recalc happens due to change in the GrdOrdRm field and OdGldAsWt changes and GrdOrdDsg row is saved and the user exits out of the project mid way without saving ordrm line
          If UCase(SourceName) <> UCase("GrdOrdDsg") Then GrdOrdDsg.SaveRec GrdOrdDsg.Row
        
          '### AddSave is not working
          'If UCase(SourceName) = UCase("GrdOrdRm") Then
          '  GrdOrdRm.AddSave "GrdOrdDsg", asCurrent
          'End If
          '### AddSave is not working
        End If
      End If
    
    '****** Sachin - 2.13.0 - 25-05-2006 ******
    Case Is = UCase("OdLabAsWt")
      '*** (Sachin 2.13)
      'If (.Mode = fgmnorm) Or (.Mode = fgmCopy And mf_CpyLabRate = False) Then
      '*** (Sachin 2.13)
      
      '*** (Jen 2.13)
      If (.Mode = fgmnorm) Or (.Mode = fgmCopy And (mf_CpyVal = False Or mf_CpyLabRate = False)) Then
      '*** (Jen 2.13)
        If (GrdOrdRm.Mode = fgmnorm Or GrdOrdRm.Mode = fgmdel Or GrdOrdRm.Mode = fgmCopyOver) Then
          .Value(.Row, "OdLabAsWt") = GetLabAsWt(.Row)
                    
          '### This line is actually wrong if the recalc happens due to change in the GrdOrdRm field and OdGldAsWt changes and GrdOrdDsg row is saved and the user exits out of the project mid way without saving ordrm line
          If UCase(SourceName) <> UCase("GrdOrdDsg") Then GrdOrdDsg.SaveRec GrdOrdDsg.Row
        
        End If
      End If
    '****** Sachin - 2.13.0 - 25-05-2006 ******
      
    Case Is = UCase("OdKt")
