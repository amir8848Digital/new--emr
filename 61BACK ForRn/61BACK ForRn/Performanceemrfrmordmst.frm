        If ADC("WDSCPYTC") = "IN" Then Call CpyInvDets(wo_rsSrcOd) Else Call CpyDets(wo_rsSrcOd, False, False, , , False, True)         '4.1.3
        ADC.EndCopy
    End If
  End If

NextRow:
    
    'wDsSrStr = IIF(wDsSrStr = "", "", wDsSrStr + ",") + CStr(GrdDsgStk.Value(i, "wDsSr"))
