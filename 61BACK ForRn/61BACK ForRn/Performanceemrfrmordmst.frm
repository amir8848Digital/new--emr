        .Store "OdOmDt", moCn.GetFldVal("Select OmDt From OrdMst " + _
                                          "Where OmCoCd='" + ADC("OmCoCd") + "' And OmTc='" + ADC("OmTc") + "' " + _
                                          "  And OmYy='" + ADC("OmYy") + "' And OmChr='" + ADC("OmChr") + "' And OmNo=" + CStr(ADC("OmNo")) + " And OmPrtKey='" + ctCurrPrtn + "'")
                                          
        .Store "OdPrtFgQty", 0
        .Store "OdPrtExpQty", 0
   
    
        .Store "OdDmIdNo", moCn.GetFldVal("Select DmIdNo From DsgMst Where DmTcTyp='" + IIF(ADC("OMTC") = "QS", "SM", "DM") + "' And DmCd='" + .Value(RowNum, "ODDMCD") + "' " + _
                                        " And DmSz='' " + IIF(.Value(RowNum, "OdPrtKey") = ctCurrPrtn, " And DmPrtKey='" + ctCurrPrtn + "'", ""))
    End If

    '****** Sachin 3.02 (10/09/07) ******
    
  End With
