'*** Jay 2.13(CT) ***
      
      If mf_CTMod = True And (UCase(ms_OmTcTyp) = "PL" Or UCase(ms_OmTcTyp) = "SO") Then
        Dim ws_OctRmCdStr As String
        ws_OctRmCdStr = " join RmMst on RmCd= " + IIF(pv_CpyFrDsgMst = True, "DctRmCd", "OctRmCd") + " " + _
                        "Left Outer Join OrdTgt on OtCoCd= '" + ADC("OmCoCd") + "' and " + _
                        "OtTc= '" + ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and " + _
                        "OtChr= '" + ADC("OmChr") + "' and OtNo= " + CStr(ADC("OmNo")) + " and " + _
                        IIF(pv_OrdCpy = True, "OtSr= 0 ", "OtSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))) + " and " + _
                        "OtRmCtg= RmCtg and OtRmSCtg= RmSCtg " + _
                        IIF(pv_CpyFrRet = True, "and 1= 2 ", " ") + " "
      
        If pv_CpyFrDsgMst = True Then
        '*** Jay 2.13(CT) *** (NEW CT)
          Set wo_rsSrcOCT = moCn.OpenRes("Select DctCd as qOctCd, DctSz as qOctSz, DctChr as qOctCtChr, " + _
                          "DctParts as qOctParts, IsNull(OtRmCd, DctRmCd) as qOctRmCd, RmCtg, RmSpGrav, DctRmCd as qOldRmCd, " + _
                          "DctDmCol as qOctDmCol, DctRmWt as qOctRmWt, DctDc as qOctDc, " + _
                          "DctPrdSeq as qOctPrdSeq, DctMainPrtYn as qOctMainPrtYn, DctDesc as qOctDesc " + _
                          "from DsgCT " + ws_OctRmCdStr + _
                          " where DctTcTyp= '" + ms_DmTcTyp + "' and " + _
