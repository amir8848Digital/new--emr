          '  If wo_rsSrcORm!qMainMet = "Y" Then
          '    wi_MainMetRow = wi_RmRow
          '  Else
          '    wd_NonMainMetWt = wd_NonMainMetWt + .Value(wi_RmRow, "OrWt") / IIF(UCase(Trim(wo_rsSrcORm!qRmCtg)) = "C" Or UCase(Trim(wo_rsSrcORm!qRmCtg)) = "D", 5, 1)
          '  End If
