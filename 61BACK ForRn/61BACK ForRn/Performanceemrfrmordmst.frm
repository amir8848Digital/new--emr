Private Sub GrdOrdRm_ColWhen(ByVal RowNum As Integer, ByVal ColName As String, Cancel As Boolean, ErrMsg As String, ByVal Action As MwfCtl.en_fgAction)
  '*** Set Helps For Each Field
  '*** In the help of OrRmCd do not show the Custom Codes
  '    The first param is Custom Code (Y/N), the 2nd is the RmCtg and third is RmSCtg
  '*** In the help of OrAlyCd
  '    the first param is Custom Code (Y/N), the 2nd is the RmCtg= 'A'

  If mf_DtLocked = True Then Cancel = True: ErrMsg = "Cannot Edit Locked Entry": Exit Sub
  
  '****** Sachin 3.02 18-12-07 - Locking Records of Previous Partition
  If GrdOrdRm.Value(RowNum, "OrPrtKey") <> ctCurrPrtn Then Cancel = True: ErrMsg = "Cannot Edit Previous Partition Records": Exit Sub


'  If mf_UsrFlag = False Then Cancel = True: ErrMsg = "User cannot Add/Delete/Edit for this Order Character": Exit Sub
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If ADC.AddFndMode = xFndMode And ADC("OmLockYN") = "Y" Then _
      Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
' ###########################################  Manoj  ###########################################

  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    Cancel = True: ErrMsg = "Cannot Edit, Invoice Is Closed.": Exit Sub

'*****Geeta***Crm***2.12
'  If ADC.AddFndMode = xFndMode And ADC("OmAckYN") = "N" Then _
'      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
  If ADC.AddFndMode = xFndMode Then
    If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
      Cancel = True: ErrMsg = "Order/Quotation is Unacknowledged,Acknowledge to Edit Value": Exit Sub
    ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
      Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
  End If

  '****** Sachin 3.5.0 ******
  If mb_CustomiseOrd = True And ms_GrdUrStyle <> "I" Then
    Dim wRsCtrl As New MDORowSet, wExpRmCtg As String
    wExpRmCtg = "," + moCn.GetFldVal("Select PDesc225 from Param where PTyp='GLDAS' and PMCd = '" + ms_CustomiseRmExp + "'") + ","
    Set wRsCtrl = moCn.OpenRes(" Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                " from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                " and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + UCase("GrdOrdRm") + "' and UrName='" + UCase(ColName) + "' ")
    If Not (wRsCtrl.EOF Or wRsCtrl.BOF) And (InStr(1, wExpRmCtg, "," + GrdOrdRm.Value(RowNum, "OrRmCtg") + ",") = 0) Then _
    If wRsCtrl!UrStyle = "D" Then Cancel = True
  End If
  '****** Sachin 3.5.0 ******
    
  Select Case UCase(ColName)
  
  Case Is = UCase("OrRmCtg")
    Call HlpList.PMCd("RMCTG")
  
  Case Is = UCase("OrRmSCtg")
    Call HlpList.PSCd("RMSCTG", GrdOrdRm.Value(RowNum, "OrRmCtg"))
    
  Case Is = UCase("OrRmCd")
    Call HlpList.RmCd("N", "'" + GrdOrdRm.Value(RowNum, "OrRmCtg") + "'", GrdOrdRm.Value(RowNum, "OrRmSCtg"), , , ADC("OmCmCd"))    'Sachin 3.11.0 - Cust RM Code in help
'Manoj

  Case Is = UCase("OrLn1")
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master]******
    If mb_VldRmLn = True And (GrdOrdRm.Value(RowNum, "OrRmCtg") = "D" Or GrdOrdRm.Value(RowNum, "OrRmCtg") = "C") Then
      Dim ws_Arr() As String, ws_OrLn1 As String
      ws_OrLn1 = GrdOrdRm.Value(RowNum, "OrLn1")
      ws_Arr = Split("VrsLn2,OrLn2", ",")
      Call HlpList.OrLn1(GrdOrdRm.Value(RowNum, "OrRmCtg"), moCn.GetFldVal("Select RmId From RmMst Where RmCd='" + GrdOrdRm.Value(RowNum, "OrRmCd") + "'"), ws_Arr)
    End If
    '****** Sachin 3.3.0 (28-06-08) - [28. Valid RmSz Master]******

  Case Is = UCase("OrSetSCd")
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "C" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "D" Then
      Cancel = True
      ErrMsg = "Can not Edit Setting Type For This RM Category."
    Else
      Call HlpList.PSCd("LABSCD", "SET")
    End If
  Case Is = UCase("OrSetSalRt")
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "C" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "D" Then
      Cancel = True
      ErrMsg = "Can not Edit Setting Rate For This RM Category."
    End If
  Case Is = UCase("OrSubShp")
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "C" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "D" Then
      Cancel = True
      ErrMsg = "Can not Edit Sub Shape For This RM Category."
    Else
      Call HlpList.PMCd("SUBSHP")
    End If
'Manoj
  Case Is = UCase("OrAlyCd")
    Call HlpList.RmCd("N", "'A'")
    
'  Case Is = UCase("OrAlySalRt")
'    If GrdOrdRm.Value(RowNum, "OrAlyCd") = "" Then
'      Cancel = True: ErrMsg = "Please Specify the Alloy Code before Entering Alloy Rate"
'    End If
    
  Case Is = UCase("OrMainMet")
    Call HlpList.PMCd("YN")
  Case Is = UCase("OrRmPtr")
    If UCase(moCn.GetFldVal("Select PValue2 from Param where PTyp= 'RMSCTG' and " + _
            "PMCd= '" + GrdOrdRm.Value(RowNum, "OrRmCtg") + "' and " + _
            "PSCd= '" + GrdOrdRm.Value(RowNum, "OrRmSCtg") + "' ")) = "N" Then _
      Cancel = True: ErrMsg = "Cannot Edit Rm Pointer": Exit Sub
  Case Is = UCase("OrLmeSal")
    ' ****** Sachin 2.12 - 01/12/05 - SJM -Silver added below
    ' ****** Manali 3.03 - 19/06/08 - Pd Mod - Palladium added below
    If GrdOrdRm.Value(RowNum, "OrRmCtg") <> "G" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "P" And _
      GrdOrdRm.Value(RowNum, "OrRmCtg") <> "S" And GrdOrdRm.Value(RowNum, "OrRmCtg") <> "L" Then _
       Cancel = True: ErrMsg = "Cannot Enter LME Rate For This Rm Ctg": Exit Sub
  End Select
End Sub
Private Sub GrdOrdRm_ReCalc(ByVal RowNum As Integer, ByVal ColName As String, ByVal OldVal As Variant, ByVal SourceName As String, ByVal SourceColName As String)
      If Not ForcedRun Then Exit Sub
  '*** OrWt on OrRmCd,OrRmCtg,OrRmSCtg,OrLn1,OrLn2,OrQty    Normal
      ' If the SourceColName= OrRmCd (i.e. if OrRmCd has triggered the recalc)
      '     and OrRmCtg= 'G' or 'P' then
      '     if RmCtg of Old RmCode = RmCtg of New RmCode Then
      '         OrWt= OrWt* (RmSpGrav of New RmCd) / (RmSpGrav of Old RmCd)
      '     Else
      '         OrWt= 0
      ' Else
      '     If SourceColName is OrRmCd then
      '         calculate the OrWt only when OrWt is Zero or the OldRmCtg <> NewRmCtg
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
      '     If the SourceColName is not OrRmCd then
      '         OrWt= Wt from the Size to Weight Master (RmRt table where RrTcTyp= 'STW')
      '         for the specified Ctg, SCtg, RmCd, From & To Lengths multiplied by the OrQty
  
  '***/r OrSalRt on OrRmCtg,OrRmCtg,OrWt                    Normal,Copy of GrdOrdDsg and Normal,Delete,CopyOver of GrdOrdRm
      'If OrRmCtg= 'G' or 'P' then
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= ''
      '      for the specified customer.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrFrLn<= OmLmgSal,
      '      RrToLn >= OmLmgSal, RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrFrLn<= OmLmgSal, RrToLn >= OmLmgSal, RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      '   Apply the Inc % for the specified cust if SalRt is from customer= 'ZSELF' record
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '' for the specified customer
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0 for the specified OrdCTg and customer= 'ZSELF'
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'LS', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, OrdCTg= '', customer= 'ZSELF'
      'Else
      '   Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg, RrSalRt<> 0
      '      for the specified customer and for the specific Rate By option.
      '   If Not, Check if SalRt exists in RmRt for RrTcTyp= 'RM', RrCtg= OrRmCtg,
      '      RrSalRt<> 0, for customer= 'ZSELF' and for the specific Rate By option.
  '***/r OrSalVal on OrMainMet,OrSalRt,OrWt                 Normal,Copy
      ' If OrMainMet= 'Y' then OrSalVal= OdGldAsWt* OrSalRt
      ' If OrMainMet= 'N' then OrSalVal= OrWt* OrSalRt
  '*** OrSetSCd on OrRmCtg,OrRmSCtg                         Normal
      ' OrSetSCd= ''
  '*** OrLn1 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn1= 0
  '*** OrLn2 on OrRmCtg,OrRmSCtg                            Normal
      ' OrLn2= 0
  '*** OrQty on OrRmCtg,OrRmSCtg                            Normal
      ' OrQty= 0
  '***/r OrSetSalRt on OmCmCd,OrSetSCd                      Normal,Copy
      'Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for the specified customer.
      'If Not, Check if Labour Rates exists in LabRt for LrMCd= 'SET', LrSCd= OrSetSCd
      '   for customer= 'ZSELF'.
  '***/r OrSetSalVal on OmCmCd,OrSetSCd,OrSetSalRt,OrQty               Normal,Copy
      'GetLabVal(OmCmCd, 'SET', OrSetSCd, OrSetSalRt, OrQty, 0, 'Q', 'S')
  '*** OrSubShp on OrRmCtg,OrRmSCtg                         Normal
      ' OrSubShp= Blank
  '*** OrAlyCd on OmCmCd,OrRmCd,OdDmCol                     Normal
      'Check if CaAlyCd exists in CustAly(CaCtg='C', CaCd= OmCmCd, CaRmCd= OrRmCd
      '   CaDmCol=OdDmCol)
