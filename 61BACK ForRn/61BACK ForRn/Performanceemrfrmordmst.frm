      End If
    Else
      FraCpyRet.Visible = True
      FraCpyRet.Enabled = True
      FraCpyRet.ZOrder
      'ADC("wCrReYy").SetFocus    '*** (Bef 3.01)
      If ADC("wCrReYy").Visible = True And ADC("wCrReYy").Enabled = True Then ADC("wCrReYy").SetFocus  '*** (Jen 3.01)
      Call EnaDisaCmds(True, CmdCpyRet)
    End If
  '*** (Jen 2.13)
    
  '*** Jay 2.13(CT) ***
  Case Is = Ordct
    If FraOrdCT.Visible = True Then
      FraOrdCT.Visible = False
      Call EnaDisaCmds(False, CmdCT, Ordct)
      If GrdOrdDsg.Rows - 1 > 0 Then
        'GrdOrdDsg.SetFocus    '*** (Bef 3.01)
