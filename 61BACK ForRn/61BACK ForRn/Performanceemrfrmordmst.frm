    Dim wsOdDiaStr As String
    
    wsOdDiaStr = "Round((Select sum(OrPrdWt) " + _
                "From OrdRm where OrOdIdNo=OdIdNo and OrCoCd= OdCoCd and OrTc= OdTc and OrYy=OdYy  and " + _
                "OrChr=OdChr and OrNo=OdNo and OrSr=OdSr and OrPrtKey=OdPrtKey and OrRmCtg='D'), 3)"
                    
    wOdSr = moCn.GetFldVal("Select min(OdSr) from OrdDsg where " + _
              "OdCoCd= '" + ADC("OmCoCd") + "' and OdTc= '" + ADC("OmTc") + "' and " + _
              "OdYy='" + ADC("OmYy") + "' and OdChr='" + ADC("OmChr") + "' and " + _
              "OdNo=" + CStr(ADC("OmNo")) + " and OdPrtKey='" + ctCurrPrtn + "' and " + _
              "((OdMinDiaTolWt<> 0 and " + wsOdDiaStr + " < Round(OdMinDiaTolWt, 3)) or " + _
              "(OdMaxDiaTolWt<> 0 and " + wsOdDiaStr + " > Round(OdMaxDiaTolWt, 3)))")
    If wOdSr <> 0 Then pr_Cancel = True: pr_ErrMsg = "Total Diamond wt is not between the specified Diamond Tolerance Limits For Sr " + CStr(wOdSr): Exit Sub
    ' ****** Manali 3.5.0 - 09/04/09 - Tolerance for Diamond at Order Level
    
    
      'Manoj 2.10.0
     '****** Sachin 3.02 (10/09/07) - Check below will be on the Current Db Only
      Set wOdRec = moCn.OpenRes("Select OdSr From OrdMst Join OrdDsg " + _
                          "On OmIdNo=OdOmIdNo And OmIdNo=OdOmIdNo and OmCoCd = OdCoCd And OmTc = OdTc And OmYy = OdYy And OmChr = OdChr And OmNo = OdNo and OdPrtKey=OmPrtKey " + _
                          "Left Outer Join (Select OrOdIdNo,OrCoCd, OrTc, OrYy, OrChr, OrNo, OrSr, OrPrtKey, " + _
                          "Sum(Cast(OrSalVal as Decimal(10,2)) + Cast(OrSetSalVal as Decimal(10,2))) as RmVal " + _
                          "From OrdRm where OrCoCD = '" + ADC("OmCoCd") + "' And OrTc = '" + ADC("OmTc") + "' And " + _
                          "OrYy = '" + ADC("OmYy") + "' And OrChr = '" + ADC("OmChr") + "' And OrNo = " + CStr(ADC("OmNo")) + _
                          IIF(gs_Partition = ctCurrPrtn, " And OrPrtKey = '" + ctCurrPrtn + "'", "") + _
                          " Group By  OrOdIdNo, OrCoCd, OrTc, OrYy, OrChr, OrNo, OrSr, OrPrtKey) OrdR On " + _
                          "OdIdNo=OrOdIdNo and OdCoCd = OrCoCd And OdTc = OrTc And OdYy = OrYy And OdChr = OrChr And OdNo = OrNo And OdSr = OrSr And OdPrtKey=OrPrtKey " + _
                          "Left Outer Join (Select OlOdIdNo, OlCoCd, OlTc, OlYy, OlChr, OlNo, OlSr, OlPrtKey, " + _
                          "Sum(Cast(isNull(OlSalVal, 0) as Decimal(10,2)))  as LabVal " + _
                          "From OrdLab where OlCoCD = '" + ADC("OmCoCd") + "' And OlTc = '" + ADC("OmTc") + "' And " + _
                          "OlYy = '" + ADC("OmYy") + "' And OlChr = '" + ADC("OmChr") + "' And OlNo = " + CStr(ADC("OmNo")) + _
                          IIF(gs_Partition = ctCurrPrtn, " And OlPrtKey = '" + ctCurrPrtn + "'", "") + _
                          " Group By OlOdIdNo, OlCoCd, OlTc, OlYy, OlChr, OlNo, OlSr, OlPrtKey) OrdL On " + _
                          "OdIdNo=OlOdIdNo and OdCoCd = OlCoCd And OdTc = OlTc And OdYy = OlYy And OdChr = OlChr And OdNo = OlNo And OdSr = OlSr And OdPrtKey=OrPrtKey " + _
                          "Where Abs(Cast((OdCalcPrc - (IsNull(RmVal, 0) + isNull(LabVal, 0))) as Decimal(10,0))) > 1 " + _
                          "And OmCoCD = '" + ADC("OmCoCd") + "' And OmTc = '" + ADC("OmTc") + "' And " + _
                          "OmYy = '" + ADC("OmYy") + "' And OmChr = '" + ADC("OmChr") + "' And OmNo = " + CStr(ADC("OmNo")) + " And OmPrtKey = '" + IIF(gs_Partition = ctCurrPrtn, ctCurrPrtn, "OmPrtKey") + "' " + _
                          "And OmDt>='01/01/05'")
       
      If wOdRec.RecCount > 0 Then
        With wOdRec
          wOdSrStr = ""
          .MoveFirst
          Do While Not (.BOF Or .EOF)
            wOdSrStr = IIF(wOdSrStr = "", "", wOdSrStr + ",") + CStr(wOdRec.FldValue("OdSr"))
            .MoveNext
          Loop
        End With
      End If
      If wOdSrStr <> "" Then pr_Cancel = True: pr_ErrMsg = "Calculated Price is Not same as (RmVal + RmSetVal + LabVal) for Design Serial(s): " + wOdSrStr + ", Please Check These Design Serial(s)."
      'Manoj 2.10.0
      '*** Delete All The UnUsed Recs From
      '****** Sachin 3.02 07-12-07 - Statement below will be fired on the Current Partition only
      moCn.Execute ("Delete From OrdTgt where OtCoCd= '" + ADC("OmCoCd") + "' and OtTc= '" + _
                    ADC("OmTc") + "' and OtYy= '" + ADC("OmYy") + "' and OtChr= '" + ADC("OmChr") + _
                    "' and OtNo= " + CStr(ADC("OmNo")) + " and OtSr> 0 and OtPrtKey='" + ctCurrPrtn + "' And " + _
                    "not exists(Select 'x' from OrdDsg where " + _
                    "OdCoCd= '" + ADC("OmCoCd") + "' and OdTc= '" + ADC("OmTc") + "' and " + _
                    "OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and " + _
                    "OdNo= " + CStr(ADC("OmNo")) + " and OdSr= OtSr And OdPrtKey=OtPrtKey) ")
    
      '*** (Jen 2.14 Next)
      wOdSr = 0
      
      '****** Sachin 3.02 (10/09/07) - Check below will be on the Current Partition
      wOdSr = moCn.GetFldVal("select min(OdSr) from OrdDsg left outer join OrdAmd on OaPrtKey=OdPrtKey and OaOdIdNo=OdIdNo And OaCoCd= OdCoCd and OaTc= OdTc " + _
                             "and OaYy= OdYy and OaChr= OdChr and OaNo= OdNo and OaSr= OdSr " + _
                             "where OdCoCd= '" + ADC("OmCoCd") + "' and OdTc= '" + ADC("OmTc") + "' " + _
                             "and OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' " + _
                             "and OdNo= " + CStr(ADC("OmNo")) + " And OdPrtKey='" + ctCurrPrtn + "' " + _
                             "group By OdSr " + _
                             "having convert (decimal (16, 1), max(OdOrdQty)) <> convert (decimal (16, 1), max(OdOrdEnt) + IsNull(sum(OaOrdQty) , 0)) " + _
                             "Or convert (decimal (16, 1), max(OdPrdQty)) <> convert (decimal (16, 1), max(OdPrdEnt) + IsNull(sum(OaPrdQty) , 0)) ")
      If wOdSr <> 0 Then pr_Cancel = True: pr_ErrMsg = "Ord/ Prd Qty <> Entered Qty + Amendment Qty for Sr No : " + CStr(wOdSr): Exit Sub
      '*** (Jen 2.14 Next)
  
      lblOdDiaDet = ""     ' ****** Manali 3.5.0
      
      ' ***** Manali Trading Module
      If ms_OmTcTyp = ctJtTcTyp Then
        GrdDsgStk.Rows = 1
'        If Not mRsInvHd Is Nothing Then Call FillInvHd(True)
'        If msInvErr <> "" Then pr_Cancel = True: pr_ErrMsg = msInvErr: Exit Sub
'        msInvErr = "" ': Set mRsInvHd = Nothing
      End If
      ' ***** Manali Trading Module
End Sub



Private Sub ATXT_FldWhen(Index As Integer, ByVal IdName As String, Cancel As Boolean, ErrMsg As String)
  '*** Set Helps For Each Field
  '*** Cannot Edit fields OmDt, OmCmCd, OmPrtCd, OmGldAs, OmLabAs, OmIWtEqOrd, OmIWtFrOrd
      'OmIGldRtEqOrd, OmFixPrc, OmLmgCst, OmLmgDt, OmLmgSal, OmMulBy when Recs exist in Design Grid
  '*** For OmTc show help of 'TC' for the specified TcTyp
      'Similarly for the working field wOmTc  (In the Order copy frame)
  '*** OmIWtFrOrd
      'If OmIWtEqOrd= 'Y' then cannot edit OmIWtFrOrd
  '*** wOdIWtFrOrd
      'If wOdIWtEqOrd= 'Y' then cannot edit wOdIWtFrOrd
  '*** wOdHldDesc
      'If wOdHld= 'N' i.e. if design is not on hold, then Holding Description should not be entered
      
  Dim wCmCtg As String, wRsCmDet As MDORowSet ' ***** Manali Trading Module
      
  '****** Sachin 3.02.0 - Purge Partition - Previous Partition Records to be Locked
  If ADC.AddFndMode = xFndMode And ADC("OmPrtKey") <> ctCurrPrtn And _
        (IdName <> UCase("OMTC") And IdName <> UCase("OMYY") And _
        IdName <> UCase("OMCHR") And IdName <> UCase("OMNO") And _
        IdName <> UCase("wDsgRmGrp") And IdName <> UCase("wOrdRmGrp") And _
        IdName <> UCase("wOrdLabGrp") And IdName <> UCase("wDsgLabGrp") And _
        IdName <> UCase("wOrdDsgGrp") And IdName <> UCase("WSCDMCTGFR") And _
        IdName <> UCase("WSCDMCTGTO") And IdName <> UCase("WSCDMCDFR") And _
        IdName <> UCase("WSCDMCDTO") And IdName <> UCase("WSCSRTPDC")) Then
        Cancel = True: ErrMsg = "Orders In Previous Partition Cannot Be Edited "
        ADC.AllowDelete = False
        Exit Sub
  End If
  '****** Sachin 3.02.0 - Purge Partition - Previous Partition Records to be Locked
  
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  If mf_DtLocked = True And (IdName <> UCase("wDsgRmGrp") And IdName <> UCase("wOrdRmGrp") And _
                             IdName <> UCase("wOrdLabGrp") And IdName <> UCase("wDsgLabGrp") And _
                             IdName <> UCase("wOrdDsgGrp")) Then                    ' Or mf_UsrFlag = False)
    Cancel = True: ErrMsg = "Cannot Add/Edit/Delete Locked Entry": Exit Sub
  End If
                                                                                  '  Or mf_UsrFlag = False)
  ' **** Manali Trading Module - wInCls added below
  If UCase(IdName) <> UCase("OmTC") And UCase(IdName) <> UCase("OmYy") _
    And UCase(IdName) <> UCase("OmChr") And UCase(IdName) <> UCase("OmNo") _
    And UCase(IdName) <> UCase("OmLockYN") And IdName <> UCase("wDsgRmGrp") _
    And IdName <> UCase("wOrdRmGrp") And IdName <> UCase("wOrdLabGrp") _
    And IdName <> UCase("wDsgLabGrp") And IdName <> UCase("wOrdDsgGrp") _
    And ADC.AddFndMode = xFndMode Then
    '*******Geeta***Crm**2.12**
      If ADC("OmLockYN") = "Y" Then _
        Cancel = True: ErrMsg = "Order/PDC/Quotation is Locked, Open Lock to Edit Value": Exit Sub
        
'      If ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And ADC("wInCls") = "Y" Then _
'        Cancel = True: ErrMsg = "Invoice Is Closed, Cannot Edit Entry": Exit Sub
        
'      If ADC("OmChr") = "WEB" And ADC("OmAckYN") = "N" And UCase(IdName) <> UCase("OmAckYN") Then _
'        Cancel = True: ErrMsg = "Order/Quotation is UnAcknowledged,Acknowledge to Edit Value": Exit Sub
      If ((Not mb_CrmDb) And ADC("OmChr") = "WEB" And ADC("OmAckYN") = "N") And UCase(IdName) <> UCase("OmAckYN") Then _
        Cancel = True: ErrMsg = "Order/Quotation is UnAcknowledged,Acknowledge to Edit Value": Exit Sub
      If (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then _
        Cancel = True: ErrMsg = "Order/Quotation is Submitted,Can not Edit.": Exit Sub
    End If
' ###########################################  Manoj  ###########################################
  If ms_OmTcTyp = "JT" And (UCase(IdName) = UCase("OmDt") Or UCase(IdName) = UCase("OmCmCd") Or UCase(IdName) = UCase("wCmName") _
                    Or UCase(IdName) = UCase("OmLmgCst") Or UCase(IdName) = UCase("OmLmgDt") Or UCase(IdName) = UCase("OmLmgSal") _
                    Or UCase(IdName) = UCase("OmLmpCst") Or UCase(IdName) = UCase("OmLmpDt") Or UCase(IdName) = UCase("OmLmpSal") _
                    Or UCase(IdName) = UCase("OmLmsCst") Or UCase(IdName) = UCase("OmLmsDt") Or UCase(IdName) = UCase("OmLmsSal") _
                    Or UCase(IdName) = UCase("OmLmlCst") Or UCase(IdName) = UCase("OmLmlDt") Or UCase(IdName) = UCase("OmLmlSal")) _
                And moCn.RecSeek("Select * from InvHd Where InCoCd='" + ADC("OmCoCd") + "' and InTc='" + ADC("OmTc") + "' " + _
                                    " and InYy='" + ADC("OmYy") + "' and InChr='" + ADC("OmChr") + "' and InNo='" + CStr(ADC("OmNo")) + "' " + _
                                    " and InPrtKey=(Case When '" + gs_Partition + "'='" + ctCurrPrtn + "' Then '" + ctCurrPrtn + "' Else InPrtKey End) ") Then _
                Cancel = True: ErrMsg = "Invoice Header Exist,Cannot Edit.": Exit Sub
                                    
  
  
  
  
  If GrdOrdDsg.Rows > 1 Then
    Select Case IdName
      ' Zubin 213 (OmCnvFct, OmCnvFctDt and OmCmCurCd added)
       ' ****** Sachin 2.12 - 01/12/05 - SJM
       '****** Zubin 3.02.01 - 26/03/08 - added OmILabWtFrOrd
       ' **** Manali 3.03 - 19/06/08 - Palladium - LML fields added
       ' **** Manali 3.03 - 02/07/08 - look fields added
       ' ***** Manali 3.9.0 - Val Addn Ctg at Order Master Level
       ' 4.1.4
      Case Is = UCase("OmDt"), UCase("OmCmCd"), UCase("wCmName"), _
                UCase("OmGldAs"), UCase("OmLabAs"), UCase("OmIWtEqOrd"), UCase("OmIWtFrOrd"), _
                UCase("OmIGldRtEqOrd"), UCase("OmFixPrc"), UCase("OmLmgCst"), _
                UCase("OmLmgDt"), UCase("OmLmgSal"), UCase("OmMulBy"), UCase("OmMrpMulBy"), _
                UCase("OmLmpCst"), UCase("OmLmpDt"), UCase("OmLmpSal"), _
                UCase("OmLmsCst"), UCase("OmLmsDt"), UCase("OmLmsSal"), _
                UCase("OmLmlCst"), UCase("OmLmlDt"), UCase("OmLmlSal"), _
                UCase("OmCnvFct"), UCase("OmCnvFctDt"), UCase("OmCmCurCd"), _
                UCase("OmChgPtrOnStwYN"), UCase("OmILabWtFrOrd"), _
                UCase("OmLkUpRmRt"), UCase("OmLkUpLabRt"), UCase("OmLkUpMetLs"), UCase("OmVaCtg")
        'UCase("OmDelDt"),
        
        '*** (Bef 27/02/06) Removed in 2.12 Patch (Jen)
        'UCase("OmPrtCd"),
        '*** (Bef 27/02/06) Removed in 2.12 Patch (Jen)
        
        
        Cancel = True
        ErrMsg = "Cannot Edit Value when Recs exist in Design Box"
        Exit Sub
    End Select
  
    Select Case IdName
    '************************Geeta***********Emr206****UCase("wOdHld"),**Not Required***********
    'Manoj 2.10.0
    ' Zubin 213 (wOdDmCol Shifted to grid)
    '*** (Jen 3.01)
    Case Is = UCase("wOdPrdEnt")
    '*** (Jen 3.01)
    'Case Is = UCase("wOdPrdSeq"), UCase("wOdPrdEnt") ', UCase("wOdDmCol")    '*** (Bef 3.01)
    'Manoj 2.10.0
      '*** Jay 3.4(FG)
      ' ***** Manali Trading Module
      If ms_OmTcTyp = "FG" Or ms_OmTcTyp = "JT" Then Cancel = True: ErrMsg = "Cannot Edit Production Qty": Exit Sub
      '*** Jay 3.4(FG)
      '****** Sachin 3.02 07-12-07 - Check below to be done on Current Partition
      Cancel = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") = ctCurrPrtn _
                And (moCn.GetFldVal("Select OdPrtFGQty From OrdDsg " + _
                          " Where OdPrtKey='" + ctCurrPrtn + "' And OdCoCd= '" + ADC("OmCoCd") + "' and " + _
                          "     OdTc= '" + ADC("OmTc") + "' and " + _
                          "     OdYy= '" + ADC("OmYy") + "' and " + _
                          "     OdChr= '" + ADC("OmChr") + "' and " + _
                          "     OdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "     OdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))) > 0 _
                Or moCn.RecSeek("Select 'x' from Bag where BCoCd= '" + ADC("OmCoCd") + "' and " + _
                          "     BOdTc= '" + ADC("OmTc") + "' and " + _
                          "     BOdYy= '" + ADC("OmYy") + "' and " + _
                          "     BOdChr= '" + ADC("OmChr") + "' and " + _
                          "     BOdNo= " + CStr(ADC("OmNo")) + " and " + _
                          "     BOdSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " And BPrtKey='" + ctCurrPrtn + "' "))
      ' URMI PrdSeq HELP 2.04
      If Cancel = True Then ErrMsg = "Cannot Edit Value when Recs exist in Bag": Exit Sub
    End Select
  End If
  
  Select Case IdName
  Case Is = UCase("OmTc")
    Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "'")
  'Manoj 2.10.0
  
  Case Is = UCase("WoCoCd"), UCase("wDsCpyCoCd"), UCase("OmBaseCoCd")
    '*** Bef 3.1.0_1
    '*** (Jen 2.14)
    'If ms_OmTcTyp = "SO" Or ms_OmTcTyp = "QT" Then
    '  If ADC("wOmTc") <> "QT" And ADC("wOmTc") <> "" Then Cancel = True: ErrMsg = "Source Company Can Be Edited Only When Source Tc= 'QT' or Blank": Exit Sub
    'End If
    '*** (Jen 2.14)
    '*** Bef 3.1.0_1
    Call HlpList.hCoCd
    
  Case Is = UCase("wOmTc")
    '*** (Bef 03/07/05)
    'If ms_OmTcTyp = "SO" Or ms_OmTcTyp = "QT" Then
    '  Call HlpList.PMCd("TC", "'SO','QT','PL'")
    '*** (Bef 03/07/05)
    
    '*** (Jen 2.11)
    If ms_OmTcTyp = "SO" Then
      'Call HlpList.PMCd("TC", "'SO','QT','PL'")    '*** (Bef 2.14)
      '*** (Jen 2.14)
      If ADC("WOCoCd") = ADC("OmCoCd") Then
'        Call HlpList.PMCd("TC", "'SO','QT','PL','IN'")
            Call HlpList.PMCd("TC", , , " PmCd In ('SO','QT','PL','JPO')")
      Else
        If ADC("WOCoCd") = ctSelfCoCd Then
          Call HlpList.PMCd("TC", "'PL'")
        Else
          'Call HlpList.PMCd("TC", "'QT','SO'") '*** Jay 3.1.0_1 ['SO' copy over Company]
          Call HlpList.PMCd("TC", , , " PmCd In ('SO','QT','JPO')")
        End If
      End If
      '*** (Jen 2.14)
    ElseIf ms_OmTcTyp = "QT" Then
      'Call HlpList.PMCd("TC", "'SO','QT','PL','QB'")    '*** (Bef 2.14)
    
      '*** (Jen 2.14)
'      If adc("WOCoCd") = adc("OmCoCd") Then
'        Call HlpList.PMCd("TC", "'SO','QT','PL','QB','IN'")   '****** Sachin 3.3.0 (25-06-08) - [13. Copy From Invoice] ******
'      Else
        If ADC("WOCoCd") = ctSelfCoCd Then
          Call HlpList.PMCd("TC", "'PL'")
        Else
          Call HlpList.PMCd("TC", "'SO','QT','PL','QB','IN','SPL'")
        End If
'      End If
      '*** (Jen 2.14)
   
    '*** (Jen 2.11)
    ' **** Manali Trading Module
    ElseIf ms_OmTcTyp = "JT" Then
'      If Not (mBaseTc = "" And mRefTc = "" And mSrcTc = "") Then
'        Call HlpList.PMCd("TC", , , " '," + mBaseTc + "," + mRefTc + "," + mSrcTc + ",' like '%,'+PMCd+',%' ")
'      Else
'        Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "'")
'      End If
    ' **** Manali Trading Module
    ' ***** Manali 3.10.0 - Copy in PDCM allowed From QT
    
    Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "','SO','QT','SPL','PL'" + IIF(ADC("OmTc") = "JPR" Or ADC("OmTc") = "JCI", ",'IN'", ""))
    
    ElseIf ms_OmTcTyp = "PL" Then
      Call HlpList.PMCd("TC", "'PL','QT'")
    Else
      Call HlpList.PMCd("TC", "'" + ms_OmTcTyp + "'")
    End If
  'Manoj 2.10.0
  '* (Sachin 3.01) added wBSYy
  Case Is = UCase("OmYy"), UCase("wOmYy"), UCase("wOrdYy"), UCase("WBAGYYFR"), UCase("WBAGYYTO"), UCase("WIFYYFR"), _
            UCase("WIFYYTO"), UCase("WBSYY"), UCase("WDSOMYY")
    Call HlpList.PMCd("YY")
  Case Is = UCase("OmChr")
' **** Zubin 211 **** '
    'Call HlpList.vPSCd(ADC("OmCoCd"), "CHR", ADC("OmTc"))
    Call HlpList.vPSCd(ADC("OmCoCd"), "CHR", ADC("OmTc"), "Y")
' **** Zubin 211 **** '
  Case Is = UCase("OmNo")
    '*** Jay 3.4(FG)
    If ms_OmTc <> "FOT" Then
      Call HlpList.OmNo(ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), , IIF(gs_Partition = ctCurrPrtn, ctCurrPrtn, ""))
    Else
      Call HlpList.InNo(ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"))
    End If
    '*** Jay 3.4(FG)
  Case Is = UCase("OmCmCd")
    ' ***** Manali Trading Module
    Call HlpList.CustCd(ADC("OmCmCtg"))
    'Call HlpList.CustCd("C")

  Case Is = UCase("wCmName")
    ' ***** Manali Trading Module
    Call HlpList.CmName(ADC("OmCmCtg"))
    'Call HlpList.CmName("C")

  Case Is = UCase("OmPrtCd")
    Call HlpList.PMCd("PRTCD")
' ########################  Manoj #### Ver: 2.0.6 #### Date: 22/12/2004  ########################
  Case Is = UCase("OmLockYN")
    '*** JAY 2.13 ***
    'If ADC("OmLockYN") = "Y" And Trim$(txtPwd.text) <> ms_Pwd Then
    If ADC("OmLockYN") = "Y" And ms_PwdFlag = False Then
    '*** JAY 2.13 ***
      Cancel = True: ErrMsg = "Enter SEO Password to Edit Value": Exit Sub
    End If
    Call HlpList.PMCd("YN")
' ###########################################  Manoj  ###########################################
  Case Is = UCase("OmAckYN")
  '*******Geeta***CRM***2.12
      If ADC("OmSubmitYN") = "N" And IdName = UCase("OmAckYN") Then
          Cancel = True: ErrMsg = "Cannot Acknowledge UnSubmitted Order": Exit Sub
      ElseIf ADC("OmSubmitYN") = "" And IdName = UCase("OmAckYN") Then
           Cancel = True: ErrMsg = "Cannot Edit": Exit Sub
      ElseIf ADC("OmAckYN") = "Y" And IdName = UCase("OmAckYN") Then
           Cancel = True: ErrMsg = "Acknowldged Order Cannot be UnAcknowledged ": Exit Sub
      End If
    Call HlpList.PMCd("YN")
    '*******Geeta***CRM***2.12
  Case Is = UCase("OmGldAs"), UCase("wOdGldAs"), UCase("OmLabAs"), UCase("wOdLabAs")
    Call HlpList.PMCd("GLDAS")
  
  '****** Zubin 3.02.01 - 27/03/08
  Case Is = UCase("wOdChgPtrOnStwYN")
    If GrdOrdRm.Rows > 1 Then _
       Cancel = True: ErrMsg = "Cannot Edit This Value When Rm Rec Exists": Exit Sub
    Call HlpList.PMCd("YN")

  '****** Zubin 3.02.01 - 26/03/08 - added OmILabWtFrOrd, wOdILabWtFrOrd, wDsgCpyChgPtrOnStwYN, wCpyChgPtrOnStwYN
  Case Is = UCase("OmIWtEqOrd"), UCase("wOdIWtEqOrd"), UCase("OmChgPtrOnStwYN"), _
            UCase("OmILabWtFrOrd"), UCase("wOdILabWtFrOrd"), UCase("wDsgCpyChgPtrOnStwYN"), UCase("wCpyChgPtrOnStwYN")
    Call HlpList.PMCd("YN")
    
  Case Is = UCase("OmIWtFrOrd")
    Call HlpList.PMCd("IWTFRORD")
