            .Value(wi_RmRow, "OrCstRt") = wo_rsSrcORm!OrCstRt
            
            '*** (Bef 2.13)
            '.Value(wi_RmRow, "OrSalVal") = wo_rsSrcORm!OrSalVal
            '.Value(wi_RmRow, "OrCstVal") = wo_rsSrcORm!OrCstVal
            '*** (Bef 2.13)
            '*** (Jen 2.13)
            If mf_CpyVal = True Then
              .Value(wi_RmRow, "OrSalVal") = wo_rsSrcORm!OrSalVal
              .Value(wi_RmRow, "OrCstVal") = wo_rsSrcORm!OrCstVal
            End If
            '*** (Jen 2.13)
'            .Value(wi_RmRow, "OrSetSalRt") = wo_rsSrcORm!OrSetSalRt
'            .Value(wi_RmRow, "OrSetCstRt") = wo_rsSrcORm!OrSetCstRt
'            .Value(wi_RmRow, "OrSetSalVal") = wo_rsSrcORm!OrSetSalVal
            '***(Bef 2.13) .Value(wi_RmRow, "OrSetCstVal") = wo_rsSrcORm!OrSetCstVal
            .Value(wi_RmRow, "OrAlySalRt") = wo_rsSrcORm!OrAlySalRt
            .Value(wi_RmRow, "OrAlyCstRt") = wo_rsSrcORm!OrAlyCstRt
          End If
'URMI 2.06 LabRt
'And InStr(1, "," + ms_CpyRateOpt + ",", wo_rsSrcORm!qRmCtg) >= 1
          If mf_CpyLabRate = True Then
            .Value(wi_RmRow, "OrSetSalRt") = wo_rsSrcORm!OrSetSalRt
            .Value(wi_RmRow, "OrSetCstRt") = wo_rsSrcORm!OrSetCstRt
                        
            '*** (Bef 2.13)
            '.Value(wi_RmRow, "OrSetSalVal") = wo_rsSrcORm!OrSetSalVal
