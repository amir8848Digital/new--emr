                    " Order By OdSr")
    End If
     If Not (wo_rsSrcOd.EOF Or wo_rsSrcOd.BOF) Then
        mf_CpyDmId = IIF(ADC("OmTc") = "JPO" Or ADC("OmTc") = "JSO", False, mf_CpyDmId)
