            '****** Sachin 3.02 - Current Partition
            Set wo_rsSrcOCT = moCn.OpenRes("Select OctCd as qOctCd, OctSz as qOctSz, OctCtChr as qOctCtChr, OctParts as qOctParts, " + _
                          "IsNull(OtRmCd, OctRmCd) as qOctRmCd, RmCtg, RmSpGrav, OctRmCd as qOldRmCd, " + _
                          "OctDmCol as qOctDmCol, OctRmWt as qOctRmWt, OctDc as qOctDc,  " + _
                          "OctPrdSeq as qOctPrdSeq, OctMainPrtYn as qOctMainPrtYn, OctDesc as qOctDesc " + _
                          "from OrdCT join RmMst on RmCd= OctRmCd and RmPrtKey=OctPrtKey " + ws_OctRmCdStr + " " + _
                          "where OctCoCd= '" + IIF(pv_CpyBags = True, ADC("OmCoCd"), wCoCd) + "' and OctTc='" + pv_rsSrcOd!OdTc + "' and " + _
                          "OctYy= '" + pv_rsSrcOd!OdYy + "' and OctChr='" + pv_rsSrcOd!OdChr + "' and " + _
                          "OctNo= " + CStr(pv_rsSrcOd!OdNo) + " and OctSr=" + CStr(pv_rsSrcOd!OdSr) + " and OctPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "OctPrtKey") + _
                          " Order By OctSrNo, OctCtChr")
          End If
          '*** Jay 2.14Next *** [Multiple Comp in One BCHR]
        '*** Jay 2.13(CT) *** (NEW CT)
        End If
        With GrdOrdCT
          GrdOrdCT.StartCopy
          Do While Not (wo_rsSrcOCT.EOF Or wo_rsSrcOCT.BOF)
            .AddItem
            wi_OCTRow = .Rows - 1
            .Value(wi_OCTRow, "OctSrNo") = wi_OCTRow          '*** Jay 2.14Next ***
            .Value(wi_OCTRow, "OctCd") = wo_rsSrcOCT!qOctCd
            .Value(wi_OCTRow, "OctSz") = wo_rsSrcOCT!qOctSz
            .Value(wi_OCTRow, "OctCtChr") = wo_rsSrcOCT!qOctCtChr
            .Value(wi_OCTRow, "OctParts") = wo_rsSrcOCT!qOctParts
            .Value(wi_OCTRow, "OctRmCd") = wo_rsSrcOCT!qOctRmCd
            .Value(wi_OCTRow, "OctDmCol") = wo_rsSrcOCT!qOctDmCol
            
            ' ***** Manali 3.03 - 19/06/08 - Pd Mod - "L" included
            If (UCase(Trim(wo_rsSrcOCT!RmCtg)) = "G" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "P" Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "S" _
              Or UCase(Trim(wo_rsSrcOCT!RmCtg)) = "L") And wo_rsSrcOCT!qOldRmCd <> wo_rsSrcOCT!qOctRmCd Then
                wOldSpGrav = wo_rsSrcOCT!RmSpGrav
                '****** Sachin 3.02 - Current Partition
                wNewSpGrav = moCn.GetFldVal("Select RmSpGrav from RmMst where RmCd= '" + wo_rsSrcOCT!qOctRmCd + "' and RmPrtKey=" + IIF(pv_CpyFrRet = False, "'" + ctCurrPrtn + "'", "RmPrtKey"))
                .Value(wi_OCTRow, "OctRmWt") = MWLib.Div(wo_rsSrcOCT!qOctRmWt * wNewSpGrav, wOldSpGrav)
            Else
               .Value(wi_OCTRow, "OctRmWt") = wo_rsSrcOCT!qOctRmWt
            End If
           
            .Value(wi_OCTRow, "OctDc") = wo_rsSrcOCT!qOctDc
            .Value(wi_OCTRow, "OctPrdSeq") = wo_rsSrcOCT!qOctPrdSeq
            .Value(wi_OCTRow, "OctMainPrtYn") = wo_rsSrcOCT!qOctMainPrtYn
            .Value(wi_OCTRow, "OctDesc") = wo_rsSrcOCT!qOctDesc
            
            .Value(wi_OCTRow, "OctPrtKey") = ADC("OmPrtKey")    '****** Sachin 3.02 - Partition Key value
            
            If .SaveRec(wi_OCTRow) = False Then
              .DelAllRecs
              Exit Do
            End If
            wo_rsSrcOCT.MoveNext
          Loop
          GrdOrdCT.EndCopy
        End With
      End If
'*** Jay 2.13(CT) ***
                        
NextOd:
       If pv_CpyXl = True And mi_xlSalPrc > 0 Then
         .Value(wi_OdRow, "OdSalPrc") = mi_xlSalPrc
         If Not .SaveRec(wi_OdRow) Then GoTo NextOd
       End If
        
      '****** Sachin 3.3.0
      If mf_CpyRtByStk = True Then
        Call SetDsgPrc(wi_OdRow, VtCalc)
        .Value(wi_OdRow, "OdSalPrc") = .Value(wi_OdRow, "OdCalcPrc")
        If Not .SaveRec(wi_OdRow) Then GoTo NextOd
      End If
      '****** Sachin 3.3.0
      pv_rsSrcOd.MoveNext
      MWLib.RunningProcess "Me" + CStr(ijk) + "done w this OrdDsg"
      mFrmTrackStatus.txtStatus.text = mFrmTrackStatus.txtStatus.text + vbCrLf + "Done w Od" + CStr(ijk) + CStr(Now)
    Loop
EndCopy:
    wi_Cnt = 0: wi_TotCnt = 0                   '4.1.3.0
    GrdOrdDsg.EndCopy
    MWLib.EndProcess Me                   '4.1.3.0
    mf_ShowDsg = True
    Set pv_rsSrcOd = Nothing
    Set wo_rsSrcORm = Nothing
    Set wo_rsSrcOl = Nothing
  End With

End Sub


