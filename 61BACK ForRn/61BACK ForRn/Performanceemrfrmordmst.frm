Private Sub PropSet(Optional ByVal pb_JtFld As Boolean = False)
  '*** Set Visible and Enabled Properties for X Fields ***
  '*** Set Visible and Enabled Properties for Grid controls and Grid Columns ***
  '*** Set Visible and Enabled Properties for Command Buttons ***
  '*** Set Visible and Enabled Properties for ADC Buttons ***
  On Error GoTo ErrProp
  
  Dim wRsCtrl As MwfLib.MDORowSet, wRsGrds As MwfLib.MDORowSet
  Dim wo_Grd As MwfCtl.MWCTL_FLX
  Dim wColSty_Curr As en_fgColStyle, wColSty_Prop As en_fgColStyle
  
  If Not pb_JtFld Then
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'ADC' ")
     
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I", "D"
         If wRsCtrl!UrName = "ADD" Then ADC.AllowAdd = False
         If wRsCtrl!UrName = "DELETE" Then ADC.AllowDelete = False
       Case Is = "E"
         '*** Add, Delete is allowed
       End Select
       wRsCtrl.MoveNext
     Loop
    
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'X' and UrName<> ''")
     
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I"
         'ADC(wRsCtrl!UrName).Visible = False
         ADC(wRsCtrl!UrName).Enabled = False
         
         '***
         'ADC(wRsCtrl!UrName).BckColorDisable = FRA_KEYS.BackColor
         'ADC(wRsCtrl!UrName).ForColorDisable = FRA_KEYS.BackColor     '*** This doesn't work
         '***
         
         '*** This works
         ADC(wRsCtrl!UrName).BckColorDisable = ADC(wRsCtrl!UrName).ForColorDisable
         'ADC(wRsCtrl!UrName).ForColor = ADC(wRsCtrl!UrName).ForColorDisable
         '*** This works
       Case Is = "D"
         ADC(wRsCtrl!UrName).Enabled = False
         'ADC(wRsCtrl!UrName).Visible = True
       Case Is = "E"
         'ADC(wRsCtrl!UrName).Enabled = True
         'ADC(wRsCtrl!UrName).Visible = True
       End Select
       
       ''ADC(wRsCtrl!UrName).Enabled = FldEna(wRsCtrl!TsStyle)
       ''ADC(wRsCtrl!UrName).Visible = FldVis(wRsCtrl!TsStyle)
       wRsCtrl.MoveNext
     Loop
     
     Set wRsGrds = moCn.OpenRes("Select upper(RTrim(LTrim(UrCtlSTyp))) as UrCtlSTyp, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight " + _
                                "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'GRD' and UrName= '' and UrCtlSTyp<> '' " + _
                                "Order By UrCtlSTyp ")
     
     Do While Not (wRsGrds.EOF Or wRsGrds.BOF)
       Set wo_Grd = GetGrd(wRsGrds!UrCtlSTyp)
       ms_GrdUrStyle = IIF(wRsGrds!UrCtlSTyp = "GRDORDRM", wRsGrds!UrStyle, "")    '****** Sachin 3.5.0
       Select Case UCase(wRsGrds!UrStyle)
       Case Is = ""
         '*** Full Rights
       Case Is = "I"
         wo_Grd.Enabled = False
         wo_Grd.Visible = False
       Case Is = "D"
         wo_Grd.Enabled = False
         'wo_Grd.Visible = True
       Case Is = "E"
         '*** This option means the grid is available for editing but new
         'wo_Grd.Enabled = True
         'wo_Grd.Visible = True
         
         wo_Grd.AllowAdd = False
         wo_Grd.AllowDelete = False
       End Select
     
       If wRsGrds!UrStyle = "" Or wRsGrds!UrStyle = "E" Or wRsGrds!UrStyle = "D" Then
         Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                    "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                    "and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + wRsGrds!UrCtlSTyp + "' and UrName<> '' ")
         
         Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
           wColSty_Curr = wo_Grd.ColProp(wRsCtrl!UrName).Style
           wColSty_Prop = ColSty(wColSty_Curr, wRsCtrl!UrStyle)
           If wColSty_Curr <> wColSty_Prop And Not (wRsGrds!UrCtlSTyp = "GRDORDRM" And wRsCtrl!UrStyle = "D") Then _
                   wo_Grd.ColProp(wRsCtrl!UrName).Style = wColSty_Prop
           'wo_Grd.ColProp(wRsCtrl!UrName).Style = ColSty(wo_Grd.ColProp(wRsCtrl!UrName).Style, wRsCtrl!UrStyle)
           wRsCtrl.MoveNext
         Loop
       End If
       
       wRsGrds.MoveNext
     Loop
     
     Set wRsCtrl = moCn.OpenRes("Select upper(RTrim(LTrim(UrName))) as UrName, upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                                "from UsrRight where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= '" + ms_UsrGrp + "' " + _
                                "and UrCtlTyp= 'CMD' ")
     
     '*** Setting Vis and Ena Properties for MwCtl_Btn1 (Button) Conrols ***
     'Dim wo_CmdCtrl As Control
     Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
       Select Case UCase(wRsCtrl!UrStyle)
       Case Is = "I"
         Me.Controls(wRsCtrl!UrName).Enabled = False
         Me.Controls(wRsCtrl!UrName).Visible = False
       Case Is = "D"
         Me.Controls(wRsCtrl!UrName).Enabled = False
       Case Is = "E"
       End Select
       
       wRsCtrl.MoveNext
     Loop
  Else
  ' **** Manali Trading Module
    Set wRsCtrl = moCn.OpenRes("Select * from TcStr where TsTbl='ORD' and TsTyp= '" + ms_OmTc + "' and TsSTyp= 'X' ")
    
    Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
      ADC(wRsCtrl!TsIdName).Enabled = FldEna(wRsCtrl!TsStyle)
      ADC(wRsCtrl!TsIdName).Visible = FldVis(wRsCtrl!TsStyle)
       wRsCtrl.MoveNext
    Loop

    Set wRsCtrl = Nothing
  
    Call GrdPropSet(GrdOrdDsg, "DSG")
      
    Set wRsCtrl = moCn.OpenRes("Select * from TcStr where TsTbl='ORD' and TsTyp='" + ms_OmTc + "' and TsSTyp='Lbl'")
    Do While Not (wRsCtrl.EOF Or wRsCtrl.BOF)
      Me.Controls(wRsCtrl!TsIdName).Visible = FldVis(wRsCtrl!TsStyle)
      wRsCtrl.MoveNext
    Loop
    Set wRsCtrl = Nothing
       
    Call CmdPropSet
    
  End If
  
  Set wRsCtrl = Nothing
  Set wRsGrds = Nothing
  
  Exit Sub

ErrProp:
  If pb_JtFld = False Then
    DispMsg "Invalid UsrRight Settings", etError
  Else
    DispMsg "Invalid Display Settings", etError
  End If
  Resume Next
End Sub
Private Function GetGrd(ps_GrdName As String) As MwfCtl.MWCTL_FLX
  Dim wo_Grd As MwfCtl.MWCTL_FLX
  
  Select Case UCase(ps_GrdName)
  Case Is = UCase("GrdOrdDsg")
    Set wo_Grd = GrdOrdDsg
  Case Is = UCase("GrdOrdLab")
    Set wo_Grd = GrdOrdLab
  Case Is = UCase("GrdOrdRm")
    Set wo_Grd = GrdOrdRm
  Case Is = UCase("GrdOrdAmd")
    Set wo_Grd = GrdOrdAmd
  Case Is = UCase("GrdOrdTgt")
    Set wo_Grd = GrdOrdTgt
  Case Is = UCase("GrdOrdCT")
    Set wo_Grd = GrdOrdCT
  Case Is = UCase("GrdDsgSel")
    Set wo_Grd = GrdDsgSel
  Case Is = UCase("GrdDsgAnaSel")
    Set wo_Grd = GrdDsgAnaSel
  Case Is = UCase("GrdOrdDsgTgt")
    Set wo_Grd = GrdOrdDsgTgt
  Case Is = UCase("GrdOrdDsgSumm")
    Set wo_Grd = GrdOrdDsgSumm
  Case Is = UCase("GrdDsgLabSumm")
    Set wo_Grd = GrdDsgLabSumm
  Case Is = UCase("GrdDsgRmSumm")
    Set wo_Grd = GrdDsgRmSumm
  Case Is = UCase("GrdOrdLabSumm")
    Set wo_Grd = GrdOrdLabSumm
  Case Is = UCase("GrdOrdRmSumm")
    Set wo_Grd = GrdOrdRmSumm
  Case Is = UCase("GrdHR")
    Set wo_Grd = GrdHR
  Case Is = UCase("GrdHL")
    Set wo_Grd = GrdHL
  Case Is = UCase("GrdHD")
    Set wo_Grd = GrdHD
  End Select
  
  Set GetGrd = wo_Grd
  Set wo_Grd = Nothing
End Function

Private Function ColSty(ByVal pe_CurrStyle As en_fgColStyle, ByVal ps_ColSty As String) As en_fgColStyle
  '*** Function to return the Style of columns in the Grid
  Select Case ps_ColSty
  Case Is = "I"
    ColSty = en_fgColStyle.fgcinvisible
  Case Is = "D"
    If pe_CurrStyle = fgcReadOnly Or pe_CurrStyle = fgcNormal Then
      ColSty = en_fgColStyle.fgcReadOnly
    Else
      ColSty = pe_CurrStyle
    End If
  Case Is = "E"
    If pe_CurrStyle = fgcNormal Then
      ColSty = en_fgColStyle.fgcNormal
    Else
      ColSty = pe_CurrStyle
    End If
  End Select
End Function
Private Sub SetGrdEnaVis(ByVal ps_GrdName As String, ByVal pb_Enable As Boolean, ByVal pb_visible As Boolean)
  '*** Procedure to set the Enable/ Disable property of Grid.
  Dim wo_Grd As MwfCtl.MWCTL_FLX, ws_Style As String
  Set wo_Grd = GetGrd(ps_GrdName)
  
  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                            "and UrCtlTyp= 'GRD' and UrCtlSTyp= '" + ps_GrdName + "' and UrName= '' ")
  
  Select Case UCase(ws_Style)
  Case Is = "", "E"
    wo_Grd.Enabled = True
    wo_Grd.Visible = True
  Case Is = "D"
    wo_Grd.Enabled = False
    wo_Grd.Visible = True
  Case Is = "I"
    wo_Grd.Enabled = False
    wo_Grd.Visible = False
  End Select
  
  If pb_Enable = False Then wo_Grd.Enabled = False
  If pb_visible = False Then wo_Grd.Visible = False
End Sub

