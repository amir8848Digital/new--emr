Private Sub CmdCpyRet_Click()
  '*** (Jen 2.13)
  
  '*** Display or hide the Refresh Rate frame depending on the toggle satate
  If mf_DtLocked = True Then DispMsg "Cannot Refresh Rates In Locked Entry", etError: Exit Sub
  
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If ADC("OmPrtKey") <> ctCurrPrtn Or CDate(ms_PurgeDt) >= ADC("Omdt") Then DispMsg "Cannot Copy Returns In Previous Partition Orders", etError: Exit Sub
    
  'If RetMemExists = True Then Exit Sub
  
  ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
  If Not moCn.RecSeek("select CmCd from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd = '" + ADC("OmCmCd") + "'") Then
    DispMsg "Invalid " + mCmCtgName + " code", etError: Exit Sub
  End If
  
  If GrdOrdDsgTgt.Rows - 1 > 0 Or GrdOrdTgt.Rows - 1 > 0 Then
    DispMsg "Cannot Use This Option As Record(s) Exists In Rm Target Grid(s)", etError: Exit Sub
  End If
  
  If FraCpyRet.Visible = False Then
    If GrdOrdDsg.Rows - 1 > 0 And ADC("OmReNo") = 0 Then DispMsg "Cannot Copy When Design Records Exist", etError: Exit Sub
    ADC("wCrReYy") = IIF(ADC("OmReYy") <> "", ADC("OmReYy"), IIF(ADC("wCrReYy") = "", ADC("OmYy"), ADC("wCrReYy")))
    If ADC("OmReChr") <> "" Then ADC("wCrReChr") = ADC("OmReChr")
    If ADC("OmReNo") <> 0 Then ADC("wCrReNo") = ADC("OmReNo")
  End If
  
  Call DispFra(CpyRet)
  '*** (Jen 2.13)
End Sub
Private Sub CmdCpyRetGo_Click()
  '*** (Jen 2.13)
  Dim wRsSrcOd As MwfLib.MDORowSet, ws_OrdNo As String
  ms_CpyRateCd = "": ms_CpyRateOpt = "": mf_CpyRate = False: mf_CpyLabRate = False
  mf_CpyVal = False: mf_CpyFrSameCust = False
  mb_CpyKT = False   ' ***** Manali 3.9.0 - Copy KT from PDC
  
  If Not moCn.RecSeek("select 'x' From RetMem where ReCoCd= '" + ADC("OmCoCd") + "' and ReYy= '" + ADC("wCrReYy") + "' " + _
                      "and ReChr= '" + ADC("wCrReChr") + "' and ReNo= " + CStr(ADC("wCrReNo")) + " " + _
                      "and (Select CmCurCd from CustMst where CmCtg= 'C' and CmCd= ReCmCd)= " + _
                      "IsNull((Select CmCurCd from CustMst where CmCtg= 'C' and CmCd= '" + ADC("OmCmCd") + "'), '') ") Then
    DispMsg "Invalid Return Memo Voucher/ Currency Not Matching", etError: Call CmdCpyRet_Click: Exit Sub
  End If
                 
  ws_OrdNo = Trim(moCn.GetFldVal("select OmTc+ '/' + OmYy+ '/' + OmChr+ '/' + LTrim(Str(OmNo)) " + _
                       "from OrdMst where OmCoCd= '" + ADC("OmCoCd") + "' " + _
                       "and OmReYy= '" + ADC("wCrReYy") + "' and OmReChr= '" + ADC("wCrReChr") + "' " + _
                       "and OmReNo= " + CStr(ADC("wCrReNo")) + " " + _
                       "and (OmTc<> '" + ADC("OmTc") + "' Or OmYy<> '" + ADC("OmYy") + "' " + _
                       "     Or OmChr<> '" + ADC("OmChr") + "' Or OmNo<> " + CStr(ADC("OmNo")) + " ) "))
  If ws_OrdNo <> "" Then DispMsg "Return Memo Voucher Already Used In Another Order: " + ws_OrdNo, etError: Call CmdCpyRet_Click: Exit Sub
                 
  '****** Sachin 3.02 (10/09/07) - added id fields in joins
  Set wRsSrcOd = moCn.OpenRes("Select RedQty, IdVaCtg, IdKt, DmBagPcs, RedGrsWt, IdTc, IdYy, IdChr, IdNo, IdSr, RedSr, " + _
                 "IdFixPrc, OrdDsg.* from RetMemDet " + _
                 "join InvDsg on IdCoCd= RedCoCd and IdTc= RedIdTc and IdYy= RedIdYy and IdChr= RedIdChr " + _
                 "and IdNo= RedIdNo and IdSr= RedIdSr " + _
                 "Join OrdDsg on OdIdNo=IdOdIdNo And OdCoCd= IdCoCd and OdTc= IdExpOdTc and OdYy= IdExpOdYy " + _
                 "and OdChr= IdExpOdChr and OdNo= IdExpOdNo and OdSr= IdExpOdSr " + _
                 "join DsgMst on DmIdNo=OdDmIdNo And DmTcTyp= 'DM' and DmCd= OdDmCd and DmSz= '' " + _
                 "Where RedCoCd= '" + ADC("OmCoCd") + "' and RedYy= '" + ADC("wCrReYy") + "' " + _
                 "and RedChr= '" + ADC("wCrReChr") + "' and RedNo= " + CStr(ADC("wCrReNo")) + " " + _
                 "and not exists(Select 'x' from OrdDsg where OdCoCd= '" + ADC("OmCoCd") + "' and OdTc= '" + ADC("OmTc") + "' " + _
                 "and OdYy= '" + ADC("OmYy") + "' and OdChr= '" + ADC("OmChr") + "' and OdNo= " + CStr(ADC("OmNo")) + " " + _
                 "and OdSr= RedSr) " + _
                 "Order By RedSr ")
                 
  If Not (wRsSrcOd.EOF Or wRsSrcOd.BOF) Then
    ADC.StartCopy
    ADC("OmReYy") = ADC("wCrReYy")
    ADC("OmReChr") = ADC("wCrReChr")
    ADC("OmReNo") = ADC("wCrReNo")
    
    ' *** Jen - Commented IsNew [2.14] ***
    'If ADC.IsNew Then
      If Not ADC.SaveRec Then
        DispMsg "X Save Failed", etInfo
        ADC("OmReYy") = "": ADC("OmReChr") = "": ADC("OmReNo") = 0
        ADC.EndCopy
        Call CmdCpyRet_Click
        Exit Sub
      End If
    'End If
    
    mf_CpyRate = True
    mf_CpyVal = False
    mf_CpyLabRate = True
    ' ***** Manali 3.03 - Pd Mod - "GPSDCXAM" replaced by "GPSLDCXM"
    ms_CpyRateCd = "GPSLDCXM"
    'ms_CpyRateCd = "GPSDCXAM"      ' ****** Bef 3.03
    ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and PMCd= '" + ms_CpyRateCd + "' ")
    
    mf_CpyDmId = False    ' ****** Manali Trading Module
    mf_CpyFrBase = False
    
    
    Call CpyDets(wRsSrcOd, False, False, False, True)
    ADC.EndCopy
  End If
  
  Call CmdCpyRet_Click
  '*** (Jen 2.13)
End Sub

Private Sub CmdCpyZoomSel_Click()

'****** Sachin 3.3.0 (26-06-08) - [21. Copy From Order Zoom] ******
Dim wOrdLst() As String, wOrdNo() As String, wStr As String, wCtr As Integer, OrdExist As Boolean
Dim wf_Cancel As Boolean, wf_errmsg As String, wo_rsSrcOM As MDORowSet, wo_rsSrcOd As MDORowSet

Dim ws_CoCd As String


If gs_OrdZoomSel = "" Then DispMsg "No Order Selected for copying in Order Zoom ", etError: Exit Sub

wOrdLst = Split(Left(gs_OrdZoomSel, Len(gs_OrdZoomSel) - 1), ",")
wCtr = 0

Do While Not wCtr > UBound(wOrdLst)
    wOrdNo = Split(wOrdLst(wCtr), "/")
    
    ' ***** Manali 3.10.0 - 09/03/12 - Allow Copy from PDCM Zoom
    ws_CoCd = IIF(moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + wOrdNo(0) + "' and PValue='PL'"), ctSelfCoCd, gs_CoCd)
    
    If Not moCn.RecSeek("Select 'x' from OrdMst where OmCoCd= '" + ws_CoCd + "' and " + _
                "OmTc= '" + wOrdNo(0) + "' and OmYy= '" + wOrdNo(1) + "' and OmChr= '" + wOrdNo(2) + "' and " + _
                "OmNo= " + CStr(wOrdNo(3)) + " and OmCmCurCd= '" + ADC("OmCmCurCd") + "' And OmPrtKey='" + ctCurrPrtn + "' ") _
        And (ADC("wCpyRt") = "Y" Or ADC("wCpyLabRt") = "Y") Then
        DispMsg "Copy Rate Options Cannot Be 'Y' When Source And Target Currencies Are Not Matching", etError: Exit Sub
    End If
      wCtr = wCtr + 1
 Loop
 wCtr = 0
    
    ' ***** Manali 3.10.0 - 09/03/12 - Allow Copy from PDCM Zoom
    '****** Check 1 : Currencies Should Match ******
'    If Not moCn.RecSeek("Select 'x' from OrdMst where OmCoCd= '" + ws_CoCd + "' /*'" + adc("woCoCd") + "'*/ and " + _
'              "OmTc= '" + wOrdNo(0) + "' and OmYy= '" + wOrdNo(1) + "' and OmChr= '" + wOrdNo(2) + "' and " + _
'              "OmNo= " + CStr(wOrdNo(3)) + " and OmCmCurCd= '" + adc("OmCmCurCd") + "' And OmPrtKey='" + ctCurrPrtn + "' ") Then
'      DispMsg "Invalid Voucher No. / Source And Target Currencies Are Not Matching", etError: Exit Sub
'    End If



'****** General Checks ******
If ADC("OMLOCKYN") = "Y" Then DispMsg "Cannot Copy As Current Order is Locked", etError: Exit Sub
If ADC("OMLOCKSALPRCYN") = "Y" Then DispMsg "Cannot Copy As Current Order Sales Price is Locked.", etError: Exit Sub
' ***** Manali Trading Module
If ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
  DispMsg "Cannot Copy Invoice Is Closed", etError: Exit Sub


If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
    DispMsg "Order/Quotation is Unacknowledged,Acknowledge to Edit Value", etError: Exit Sub
ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
    DispMsg "Order/Quotation is Submitted,Can not Edit.", etError: Exit Sub
End If

wf_Cancel = False
Call atxt_FldChange(99, "OmCmCd", wf_Cancel, wf_errmsg, ADC("OmCmCd"))
If wf_Cancel = True Then
    DispMsg wf_errmsg, etError
    Exit Sub
End If

If ADC("wCpyRt") = "Y" And ADC("wCpyRtOpt") = "" Then DispMsg "Copy Rate Option Is Compulsory", etError: Exit Sub
'****** General Checks ******

' ***** Manali 3.10.0 - 06/04/12 - Allow Copy Rates for RmCtg Other Than in Target Grid
  Dim wRsTgt As MDORowSet, wRmCtgStr As String
  If ADC("wCpyRtOpt") <> "" Then
  Set wRsTgt = moCn.OpenRes(" Select Distinct OtRmCtg as OtRmCtg from OrdTgt " + _
                      " Where OtCoCd ='" + ADC("OmCoCd") + "'" + _
                      " And OtTc ='" + ADC("OmTc") + "'" + _
                      " And OtYy = '" + ADC("OmYy") + "'" + _
                      " And OtChr ='" + ADC("OmChr") + "' " + _
                      " And OtNo =" + CStr(ADC("OmNo")) + _
                      " And OtSr = 0  " + _
                      " And OtPrtKey = '" + ctCurrPrtn + "' ")
                          
  ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wCpyRtOpt") + "' ")
  
  Do While Not (wRsTgt.EOF Or wRsTgt.BOF)
    If InStr(1, "," + ms_CpyRateOpt + ",", "," + wRsTgt!OtRmCtg + ",") >= 1 Then
      wRmCtgStr = wRmCtgStr + IIF(wRmCtgStr = "", "", ",") + wRsTgt!OtRmCtg
    End If
    wRsTgt.MoveNext
  Loop
  If wRmCtgStr <> "" Then DispMsg "Cannot Copy Rates for RmCtg '" + wRmCtgStr + "' as Record Exists in Target Grid For The Same", etError: Exit Sub
  End If
' ***** Manali 3.10.0 - 06/04/12 - Allow Copy Rates for RmCtg Other Than in Target Grid

Do While Not wCtr > UBound(wOrdLst)
    wOrdNo = Split(wOrdLst(wCtr), "/")
    
    ' ***** Manali 3.10.0 - 09/03/12 - Allow Copy from PDCM Zoom
    ws_CoCd = IIF(moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + wOrdNo(0) + "' and PValue='PL'"), ctSelfCoCd, gs_CoCd)
    
    
    ' ***** Manali 3.10.0 - 09/03/12 - Allow Copy from PDCM Zoom
    '****** Check 1 : Currencies Should Match ******
'    If Not moCn.RecSeek("Select 'x' from OrdMst where OmCoCd= '" + ws_CoCd + "' /*'" + adc("woCoCd") + "'*/ and " + _
'              "OmTc= '" + wOrdNo(0) + "' and OmYy= '" + wOrdNo(1) + "' and OmChr= '" + wOrdNo(2) + "' and " + _
'              "OmNo= " + CStr(wOrdNo(3)) + " and OmCmCurCd= '" + adc("OmCmCurCd") + "' And OmPrtKey='" + ctCurrPrtn + "' ") Then
'      DispMsg "Invalid Voucher No. / Source And Target Currencies Are Not Matching", etError: Exit Sub
'    End If
'
    '****** Check 2 : Order Should Exist ******
    If Not moCn.RecSeek("Select 'x' from OrdDsg where " + _
                    "OdCoCd= '" + ws_CoCd + "' /*'" + ADC("WOCoCd") + "'*/ and OdTc= '" + wOrdNo(0) + "' and " + _
                    "OdYy= '" + wOrdNo(1) + "' and OdChr= '" + wOrdNo(2) + "' and " + _
                    "OdNo= " + CStr(wOrdNo(3)) + " And OdSr= " + CStr(wOrdNo(4)) + "  And OdPrtKey='" + ctCurrPrtn + "'  ") Then _
    DispMsg "Cannot Copy As Order details do not Exist", etError: Exit Sub
    
    '****** Check 3 : Valid Design Code ******
    ' ***** Manali Trading Module - 19/02/10 - Check skipped for OmCmCtg='S'
    '4.1.3.0
    If Not moCn.RecSeek(" Select 'x' From DsgMst Where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                           " And DmHld = 'N'  And DmValidYN='Y' and DmCd = (Select OdDmCd From OrdDsg Where OdCoCd = '" + ws_CoCd + "' /*'" + ADC("WOCocd") + "'*/ and " + _
                           " OdTc='" + wOrdNo(0) + "' And OdYy='" + wOrdNo(1) + "' And OdChr='" + wOrdNo(2) + "' And OdNo=" + CStr(wOrdNo(3)) + _
                           " And OdSr=" + wOrdNo(4) + ") And " + _
                           " DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' " + _
                           IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                           " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                           " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "')) ")) Then _
    DispMsg "Invalid Dsg Cd/ Dsg On Hold/ Dsg Is Exclusive For Another Cust Or Regn In Cpy Sel. Sr. (" + CStr(wCtr) + ") ", etError: Exit Sub
    
    '****** Actual Recordset ******
    ' ***** Manali Trading Module - 19/02/10 - DsgExc Check skipped for OmCmCtg='S'
    Set wo_rsSrcOd = moCn.OpenRes("Select * from OrdDsg Join DsgMst on DmIdNo=OdDmIdNo And DmTcTyp= '" + ms_DmTcTyp + "' " + _
                     "and DmCd = OdDmCd and DmSz= '' and DmPrtKey=OdPrtKey where " + _
                     "OdCoCd= '" + ws_CoCd + "' /*'" + ADC("WOCocd") + "'*/ and OdTc='" + wOrdNo(0) + "' and " + _
                     "OdYy= '" + wOrdNo(1) + "' and OdChr='" + wOrdNo(2) + "' and " + _
                     "OdNo= " + CStr(wOrdNo(3)) + " And OdSr=" + CStr(wOrdNo(4)) + " and OdPrtKey='" + ctCurrPrtn + "' and DmHld = 'N' and DmValidYN='Y' " + _
                     IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", "and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                     "(','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                     "(Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd,0,CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ") + _
                     "AND NOT Exists (Select 'x' from DsgMst " + _
                     " Join (Select DctCd, DctSz from DsgCt where  DctTcTyp = '" + ms_DmTcTyp + "' and DctDmCd = OdDmCd and " + _
                     " DctDmSz = '' and DctPrtKey=OdPrtKey /*IsNull((Select DmSz From DsgMst Where DmTcTyp='" + ms_DmTcTyp + "' And DmCd=OdDmCd And DmSz=OdDmSz ),'') */ ) CT " + _
                     " On DmCd = DctCd and DmSz= DctSz  " + _
                     " where DmTcTyp = 'PM' and DmHld = 'Y' and DmPrtKey=OdPrtKey) Order By OdSr")
              
     If Not (wo_rsSrcOd.EOF Or wo_rsSrcOd.BOF) Then
              mf_CpyRate = IIF(ADC("WCPYRT") = "Y", True, False): mf_CpyLabRate = IIF(ADC("WCPYLABRT") = "Y", True, False)
              ms_CpyRateCd = ADC("wCpyRtOpt")
              ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and PMCd= '" + ADC("wCpyRtOpt") + "' ")
              If wo_rsSrcOd!OdOmCmCd = ADC("OmCmCd") Then mf_CpyFrSameCust = True
              mf_CpyVal = True
              mf_CpyDmId = False    ' ****** Manali Trading Module
              mf_CpyFrBase = False
              mf_CpyFrRef = False
              mb_CpyKT = moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + wOrdNo(0) + "' and PValue='PL' ") ' ***** Manali 3.9.0 - Copy KT from PDC
              ADC.StartCopy
              If Not ADC.SaveRec Then DispMsg "OrdMst Save Failed", etError: Exit Sub
                 Call CpyDets(wo_rsSrcOd, False, True, , , False)
              ADC.EndCopy
      End If
      wCtr = wCtr + 1
      
    Loop
    
    Call CmdOrdCpy_Click
'****** Sachin 3.3.0 (26-06-08) - [21. Copy From Order Zoom] ******

End Sub

