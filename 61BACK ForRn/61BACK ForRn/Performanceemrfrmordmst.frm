                   IIF(ws_TmpOrdRmTbl = "", "", " into " + ws_TmpOrdRmTbl) + " " + _
                   "from OrdRm " + _
                   "left outer join CustAly on CaCtg= 'C' and CaCd= '" + ADC("OmCmCd") + "' " + _
