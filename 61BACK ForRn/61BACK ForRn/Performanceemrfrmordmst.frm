Private Sub SetGrdAllowAddDel(ByVal ps_GrdName As String, ByVal ps_AddDel As String, ByVal pb_ProposedVal As Boolean)
  '*** Function to set the AllowAdd/ AllowDelete properties of the grids. Note that the least right is set.
  Dim wo_Grd As MwfCtl.MWCTL_FLX, ws_Style As String
  Set wo_Grd = GetGrd(ps_GrdName)

  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                            "and UrCtlTyp= 'GRD' and UrName= '' and UrCtlSTyp= '" + ps_GrdName + "' ")

  Select Case UCase(ws_Style)
  Case Is = ""
    wo_Grd.AllowAdd = True
    wo_Grd.AllowDelete = True
  Case Is = "I", "D", "E"
    wo_Grd.AllowAdd = False
    wo_Grd.AllowDelete = False
  End Select

  Select Case UCase(ps_AddDel)
  Case Is = ""
    If pb_ProposedVal = False Then wo_Grd.AllowAdd = False: wo_Grd.AllowDelete = False
  Case Is = "A"
    If pb_ProposedVal = False Then wo_Grd.AllowAdd = False
  Case Is = "D"
    If pb_ProposedVal = False Then wo_Grd.AllowDelete = False
  End Select
End Sub

Private Sub SetGrdColStyle(ByVal ps_GrdName As String, ByVal ps_Name As String, ByVal pe_ProposedStyle As en_fgColStyle)
  '*** Procedure to set the Style property of Mw Grid Columns.
  '*** Possible values of ps_ProposedStyle can be 'I', 'D', 'E'
  
  Dim wo_Grd As MwfCtl.MWCTL_FLX, ws_Style As String
  Set wo_Grd = GetGrd(ps_GrdName)
  
  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') and UrCtlTyp= 'GRD' " + _
                            "and UrCtlSTyp= '" + ps_GrdName + "' and UrName= '" + ps_Name + "' and UrName<> ''")
  
  Select Case ws_Style
  Case Is = "I"
    wo_Grd.ColProp(ps_Name).Style = fgcinvisible
  Case Is = "D"
    wo_Grd.ColProp(ps_Name).Style = fgcReadOnly
  Case Is = "E", ""
    wo_Grd.ColProp(ps_Name).Style = fgcNormal
  End Select
  
  'ps_ProposedStyle = UCase(Trim(ps_ProposedStyle))
  'If ps_ProposedStyle = "I" Then wo_Grd.ColProp(ps_Name).Style = fgcinvisible
  'If ps_ProposedStyle = "D" And (ws_Style = "E" Or ws_Style = "") Then wo_Grd.ColProp(ps_Name).Style = fgcReadOnly
  
  If pe_ProposedStyle = fgcinvisible Then wo_Grd.ColProp(ps_Name).Style = fgcinvisible
  If pe_ProposedStyle = fgcReadOnly And (ws_Style = "E" Or ws_Style = "") Then wo_Grd.ColProp(ps_Name).Style = fgcReadOnly
End Sub
Private Sub SetCmdEnaVis(ByVal ps_CmdName As String, ByVal pb_Enable As Boolean, ByVal pb_visible As Boolean)
  '*** Procedure to set the Enable/ Disable property of Mw Buttons.
  Dim ws_Style As String
  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                            "and UrCtlTyp= 'CMD' and UrName= '" + ps_CmdName + "' ")
  
  Select Case UCase(ws_Style)
  Case Is = "I"
    Me.Controls(ps_CmdName).Enabled = False
    Me.Controls(ps_CmdName).Visible = False
  Case Is = "D"
    Me.Controls(ps_CmdName).Enabled = False
    Me.Controls(ps_CmdName).Visible = True
  Case Is = "E", ""
    Me.Controls(ps_CmdName).Enabled = True
    Me.Controls(ps_CmdName).Visible = True
  End Select
  
  If pb_Enable = False Then Me.Controls(ps_CmdName).Enabled = False
  If pb_visible = False Then Me.Controls(ps_CmdName).Visible = False
End Sub
Private Sub SetAdcAllowAddDel(ByVal ps_Name As String, ByVal pb_ProposedVal As Boolean)
  '*** Function to set the AllowAdd/ AllowDelete properties of DC. Note that the least right is set.
    
  Dim ws_Style As String
  
  ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                            "from UsrRight " + _
                            "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                            "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                            "and UrCtlTyp= 'ADC' and UrName= '" + ps_Name + "' ")
  
  Select Case UCase(ps_Name)
  Case Is = "ADD"
    ADC.AllowAdd = IIF(ws_Style = "E" Or ws_Style = "", True, False)
    If pb_ProposedVal = False Then ADC.AllowAdd = False
  Case Is = "DELETE"
    ADC.AllowDelete = IIF(ws_Style = "E" Or ws_Style = "", True, False)
    If pb_ProposedVal = False Then ADC.AllowDelete = False
  End Select
End Sub

Private Sub SetMedEnaVis(ByVal ps_IdName As String, ByVal pb_Enable As Boolean, ByVal pb_visible As Boolean, Optional ByVal pb_JTFlds As Boolean = False)
  ' ***** Manali Trading Module - pb_JTFlds added in parameters
  '*** Procedure to set the Enable/ Disable property of Mw Buttons.
  Dim ws_Style As String
  If pb_JTFlds = False Then
    ws_Style = moCn.GetFldVal("Select upper(RTrim(LTrim(UrStyle))) as UrStyle " + _
                              "from UsrRight " + _
                              "where UrTcTyp= '" + ms_OmTcTyp + "' and UrGrp= (Select PValue3 From Param where " + _
                              "      PTyp= 'USR' and PMCd= '" + gs_UsrCd + "') " + _
                              "and UrCtlTyp= 'X' and UrName= '" + ps_IdName + "' ")
    
    Select Case UCase(ws_Style)
    Case Is = "I"
      ADC(ps_IdName).Enabled = False
      ADC(ps_IdName).Visible = True
      ADC(ps_IdName).BckColorDisable = ADC(ps_IdName).ForColorDisable
    Case Is = "D"
      ADC(ps_IdName).Enabled = False
      ADC(ps_IdName).Visible = True
      
      If Not (GetRecClrSet Is Nothing) Then
        If GetRecClrSet.RecCount > 0 Then ADC(ps_IdName).BckColorDisable = Val(GetRecClrSet!CsMedBckClrDisa)
      End If
    Case Is = "E", ""
      ADC(ps_IdName).Enabled = True
      ADC(ps_IdName).Visible = True
      If Not (GetRecClrSet Is Nothing) Then
        If GetRecClrSet.RecCount > 0 Then ADC(ps_IdName).BckColorDisable = Val(GetRecClrSet!CsMedBckClrDisa)
      End If
    End Select
    
    If pb_Enable = False Then ADC(ps_IdName).Enabled = False
    If pb_visible = False Then ADC(ps_IdName).Visible = False
  Else
  End If
End Sub
