Private Sub atxt_FldValid(Index As Integer, ByVal IdName As String, ByVal OldVal As Variant)
  '*** If New value in the field is same as the old value then do not call the function to fill the grid
  '*** wDsgRmGrp        call the procedure DsgRmSumm to fill in the records in the DesignRm Grid of the Summary frame
  '*** wOrdRmGrp        call the procedure OrdRmSumm to fill in the records in the OrderRm Grid of the Summary frame
  '*** wOrdLabGrp       call the procedure OrdLabSumm to fill in the records in the OrderRm Grid of the Summary frame
  '*** wDsgLabGrp       call the procedure DsgLabSumm to fill in the records in the DesignLab Grid of the Summary frame
  '*** wOrdDsgGrp       call the procedure OrdDsgSumm to fill in the records in the OrderDesign Grid of the Summary frame
  
  If ADC(IdName) = OldVal Then Exit Sub
  Select Case UCase(IdName)
  Case Is = UCase("wDsgRmGrp")
    Call DsgRmSumm
  Case Is = UCase("wOrdRmGrp")
    Call OrdRmSumm
  Case Is = UCase("wOrdLabGrp")
    Call OrdLabSumm
  Case Is = UCase("wDsgLabGrp")
    Call DsgLabSumm
  Case Is = UCase("wDsCpyFrYn") ' WDSCPYFRYN
    If ADC.Mode = xNorm Then
'      Cancel = Not moCn.RecSeek("select PMCd from Param where PTyp= 'YN' and PMCd = '" + pv_NewValue + "'")
 '     ErrMsg = "Enter 'Y' to Copy from Source Voucher or 'N' to Copy from Stock ": Exit Sub
      If ADC("wDsCpyFrYn") = "Y" Then
        ADC("WDSCPYRFID") = ""
'        ADC("WDSCPYRFID").Enabled = False
      End If
    End If
    
  Case Is = UCase("wOrdDsgGrp")
    Call OrdDsgSumm
' ########################  Manoj #### Ver: 2.0.9 #### Date: 01/12/2004  ########################
  Case Is = UCase$("woCoCd")
    'If adc("woCoCd") <> "" And adc("woCoCd") <> gs_CoCd Then   '*** (Bef 2.14)
    '*** (Jen 2.14)
    '*** (Bef 3.01.0_1)
    'If ADC("woCoCd") = gs_CoCd And ADC("wOmTc") = "" Then
    ''*** (Jen 2.14)
    '  ADC("wOmTc") = ADC("OmTc")
    '  ADC("wOmYy") = ADC("OmYy")
    '  ADC("wOmChr") = ADC("OmChr")
    '  'adc("wOmNo") = adc("OmNo")   '*** (Bef 2.14)
    '  ADC("wOmNo") = 0    '*** (Jen 2.14)
    'End If
    '*** (Bef 3.01.0_1)
' ###########################################  Manoj  ###########################################
  End Select
End Sub


Private Sub CmdCpyBags_Click()

  '*** Display or hide the Refresh Rate frame depending on the toggle satate
  If mf_DtLocked = True Then DispMsg "Cannot Refresh Rates In Locked Entry", etError: Exit Sub
  
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If ADC("OmPrtKey") <> ctCurrPrtn And CDate(ms_PurgeDt) >= ADC("OmDt") Then DispMsg "Cannot Copy Bags In Previous Partition Orders/Orders Prior to Purge Date", etError: Exit Sub

  ' Zubin 213
  If ADC("OmCnvFct") = "0" Then DispMsg "Conversion Factor Should Be > 0", etError: Exit Sub
  If ADC("OmMulDiv") = "" Then DispMsg "Conversion Factor From Base Currency To Voucher Currency Not Defined In Date Table", etError: Exit Sub
  ' Zubin 213

  '****** Sachin 2.12 - 16/12/05 - Copy FG Bags in QB
  Dim wb_ValidCmCd As Boolean
  ' ***** Manali Trading Module - Cmctg ='C' replaced by OmCmCtg
  wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg='" + ADC("OmCmCtg") + "' /*'C'*/ and CmCd = '" + ADC("OmCmCd") + "'")
  If wb_ValidCmCd = False Then DispMsg "Invalid " + mCmCtgName + " code", etError: Exit Sub
  
  ' **** Manali Trading Module
  If ms_OmTcTyp = ctJtTcTyp Then
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
      DispMsg "Invalid From Design Location", etError: Exit Sub
    If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                        "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
      DispMsg "Invalid To Design Location", etError: Exit Sub
  End If

  If mf_DtLocked = True Then Exit Sub
  If RetMemExists = True Then Exit Sub    '*** (Jen 2.13)
  
  If FraCopyFGBags.Visible = False Then
      If GrdOrdDsg.HalfValidate Then
        GrdOrdDsg.SetFocus
        Exit Sub
      End If
      If ADC("wCbCpyFrmRfId") = "" Then ADC("wCbCpyFrmRfId") = "Y"
  End If
      
  If ADC("WCPYBGQBWTEQORD") = "" Then ADC("WCPYBGQBWTEQORD") = "N"
      
  Call DispFra(CpyFgBags)
  '****** Sachin 2.12 - 16/12/05 - Copy FG Bags in QB

End Sub
