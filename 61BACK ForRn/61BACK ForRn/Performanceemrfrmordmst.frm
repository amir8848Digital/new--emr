              wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Design Does Not Exist In PDCM."
    
    
        If ms_OmTcTyp = "PL" And moCn.RecSeek("Select 'x' From OrdDsg where OdCoCd='" + ADC("OmCoCd") + "' and " + _
                                        " OdTc='" + ADC("OmTc") + "' and OdYy='" + ADC("OmYY") + "' and OdChr='" + ADC("OmChr") + "' and OdNo=" + CStr(ADC("OmNo")) + _
                                        " and OdDmCd='" + ReadCell(ADC("WXLSHTNO"), i, 3) + "' and OdDmSz='" + ReadCell(ADC("WXLSHTNO"), i, 5) + "' and  OdSfx='" + ReadCell(ADC("WXLSHTNO"), i, 4) + "'") Then _
                     wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + " Design Sfx and Sz Combination Already Exist. "
            
        If ReadCell(ADC("WXLSHTNO"), i, 12) = "" Or Not IsNumeric(ReadCell(ADC("WXLSHTNO"), i, 12)) Then Call SetCellVal(ADC("WXLSHTNO"), i, 12, "0")
        If ReadCell(ADC("WXLSHTNO"), i, 13) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 13, "01/01/80")
        If ReadCell(ADC("WXLSHTNO"), i, 14) = "" Then Call SetCellVal(ADC("WXLSHTNO"), i, 14, "01/01/80")
         
        If ReadCell(ADC("WXLSHTNO"), i, 13) <> MWLib.EmptyDate Then _
              If moCn.GetFldVal("Select DateDiff(DAY,CONVERT(VARCHAR(8),'" + CStr(ADC("OmDt")) + "',3),CONVERT(VARCHAR(8),'" + ReadCell(ADC("WXLSHTNO"), i, 13) + "',3))") < 0 Then _
                        wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + "Production Delivery Date Cannot Be Less Than Order Date."
    
       If ReadCell(ADC("WXLSHTNO"), i, 14) <> MWLib.EmptyDate Then _
            If moCn.GetFldVal("Select DateDiff(DAY,CONVERT(VARCHAR(8),'" + CStr(ADC("OmDt")) + "',3),CONVERT(VARCHAR(8),'" + ReadCell(ADC("WXLSHTNO"), i, 14) + "',3))") < 0 Then _
              wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + "Export Delivery Date Cannot Be Less Than Order Date"
              
        If Trim(ReadCell(ADC("WXLSHTNO"), i, 15)) <> "" And Not moCn.RecSeek("Select 'x' From  vParam  where vPTyp='LINE'  And  vPCoCd='" + ADC("OmCoCd") + "' and vPMCd='" + Trim(ReadCell(ADC("WXLSHTNO"), i, 15)) + "' and vPSCd='' and vPMCd<> 'ZZZ' ") Then _
            wErrMsg = wErrMsg + IIF(wErrMsg <> "", "/", "") + "Line Not Defined/ Line Cannot Be 'ZZZ'"
     
              
        
        ' **** Manali 3.8.0
       
       Call SetCellVal(ADC("WXLSHTNO"), i, 16, wErrMsg)
       If wErrMsg = "" Then _
        moCn.Execute ("Insert Into #TmpXls Values (" + CStr(i) + "," + ReadCell(ADC("WXLSHTNO"), i, 1) + ",'" + ReadCell(ADC("WXLSHTNO"), i, 2) + "','" + ReadCell(ADC("WXLSHTNO"), i, 3) + "','" + ReadCell(ADC("WXLSHTNO"), i, 4) + "','" + ReadCell(ADC("WXLSHTNO"), i, 5) + "'," + ReadCell(ADC("WXLSHTNO"), i, 6) + ",'" + ReadCell(ADC("WXLSHTNO"), i, 7) + "', '" + Left(Trim(ReadCell(ADC("WXLSHTNO"), i, 8)), 100) + "',Left('" + ReadCell(ADC("WXLSHTNO"), i, 9) + "', 45), '" + ReadCell(ADC("WXLSHTNO"), i, 10) + "', '" + ReadCell(ADC("WXLSHTNO"), i, 11) + "'," + ReadCell(ADC("WXLSHTNO"), i, 12) + "," + _
                            "'" + IIF(ReadCell(ADC("WXLSHTNO"), i, 13) = "", "01/01/80", ReadCell(ADC("WXLSHTNO"), i, 13)) + "','" + IIF(ReadCell(ADC("WXLSHTNO"), i, 14) = "", "01/01/80", ReadCell(ADC("WXLSHTNO"), i, 14)) + "','" + ReadCell(ADC("WXLSHTNO"), i, 15) + "' )")
       
        'moCn.Execute ("Insert Into #TmpXls Values ('" + ReadCell(adc("WXLSHTNO"), i, 3) + "','" + ReadCell(adc("WXLSHTNO"), i, 2) + "','" + Left(Trim(ReadCell(adc("WXLSHTNO"), i, 8)), 100) + "','" + ReadCell(adc("WXLSHTNO"), i, 5) + "','" + ReadCell(adc("WXLSHTNO"), i, 4) + "'," + ReadCell(adc("WXLSHTNO"), i, 6) + ",'" + ReadCell(adc("WXLSHTNO"), i, 7) + "', '" + ReadCell(adc("WXLSHTNO"), i, 10) + "', '" + ReadCell(adc("WXLSHTNO"), i, 11) + "', 0, Left('" + ReadCell(adc("WXLSHTNO"), i, 12) + "', 45))")
        ' **** Bef 3.8.0
        ' ***** Manali Excel Import (From Axis)
        ''moCn.Execute ("Insert Into #TmpXls Values ('" + ReadCell(adc("WXLSHTNO"), i, 3) + "','" + ReadCell(adc("WXLSHTNO"), i, 2) + "','" + Left(Trim(ReadCell(adc("WXLSHTNO"), i, 8)), 100) + "','" + ReadCell(adc("WXLSHTNO"), i, 5) + "','" + ReadCell(adc("WXLSHTNO"), i, 4) + "'," + ReadCell(adc("WXLSHTNO"), i, 6) + ",'" + ReadCell(adc("WXLSHTNO"), i, 7) + "', '" + ReadCell(adc("WXLSHTNO"), i, 10) + "', '" + ReadCell(adc("WXLSHTNO"), i, 11) + "', 0)")
        ' Bef ' ***** Manali Excel Import (From Axis)
        'moCn.Execute ("Insert Into #TmpXls Values ('" + ReadCell(ADC("WXLSHTNO"), i, 3) + "','" + ReadCell(ADC("WXLSHTNO"), i, 2) + "','" + Left(Trim(ReadCell(ADC("WXLSHTNO"), i, 8)), 100) + "','" + ReadCell(ADC("WXLSHTNO"), i, 5) + "','" + ReadCell(ADC("WXLSHTNO"), i, 4) + "'," + ReadCell(ADC("WXLSHTNO"), i, 6) + ",'" + ReadCell(ADC("WXLSHTNO"), i, 7) + "')")
    Next
    'CloseExcel
    
    
    'FillRmRecs (ADC("WXLFILE"))
    Set wo_rsExcel = moCn.OpenRes("Select * From #TmpXls")
    If wb_OnlyChk Then
          CloseExcel
          If wo_rsExcel.RecCount < (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then DispMsg "Check completed with Error(s).Check Excel for Errors.", etInfo: Exit Sub
          If wo_rsExcel.RecCount = (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then DispMsg "Check completed Successfully with No Errors ", etInfo: Exit Sub
    Else
         If wo_rsExcel.RecCount = 0 Then DispMsg "No Records to Copy.Check Excel for Errors.", etError: CloseExcel: Exit Sub
    End If
   
    wo_rsExcel.MoveFirst
    
    If wo_rsExcel.RecCount > 0 Then
      Do While Not wo_rsExcel.EOF
             If Trim(wo_rsExcel!qOurDmCd) = "" Then
                   Set wo_rsCDsg = moCn.OpenRes(" Select Top 1 CdOurDmCd, CdOurSfx, (Case When '" + wo_rsExcel!qOurDmSz + "'<>'' then '" + wo_rsExcel!qOurDmSz + "' Else CdOurDmSz End) CdOurDmSz " + _
                                                " From CustDsg " + _
                                                " Where CdCd='" + ADC("OmCmCd") + "' " + _
                                                "       And CdCustDmCd='" + wo_rsExcel!qCustDmCd + "' " + _
                                                " Order By CdOurDmCd, CdOurSfx Desc, CdOurDmSz Desc ")
                  If Not (wo_rsCDsg.EOF Or wo_rsCDsg.BOF) Then
                     wCdDmCd = wo_rsCDsg!CdOurDmCd
                     wCdSfx = wo_rsCDsg!CdOurSfx
                     wCdSz = wo_rsCDsg!CdOurDmSz
                  End If
              Else
                   wCdDmCd = Trim(wo_rsExcel!qOurDmCd)
                   wCdSfx = Trim(wo_rsExcel!qCdOurSfx)
                   wCdSz = Trim(wo_rsExcel!qOurDmSz)
              End If
          
              
              '****** Sachin 3.02 08-12-07 - Current Partition
              ' ***** Manali Trading Module - Check skipped for OmCmCtg='S'
              ' ***** Manali Trading Module - OmCmCtg checked for 'PL'
              Set wo_rsSrcOd = moCn.OpenRes("Select Top 1 * from OrdDsg join OrdMst " + _
                   "on OdOmIdNo=OmIdNo And OdCoCd=OmCoCd and OdTc=OmTc and OdYy=OmYy and OdChr=OmChr " + _
                   "and OdNo=OmNo and OdPrtKey=OmPrtKey Join DsgMst On DmPrtKey=OdPrtKey and DmIdNo=OdDmIdNo and DmTcTyp='" + ms_DmTcTyp + "' and DmCd=OdDmCd and DmSz='' Where " + _
                   " DmHld = 'N' " + _
                   IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                   " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                   " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ") + _
                   " and OmCoCd= '" + ctSelfCoCd + "' and (Select PValue from Param where " + _
                   "PTyp='TC' and PMCd=OmTc)='PL' and OdDmCd='" + wCdDmCd + "' and " + _
                   "OdDmSz In ('','" + wCdSz + "') and OdSfx='" + wCdSfx + "' and " + _
                   "OmCmCtg='" + ADC("OmCmCtg") + "' and OmCmCd In (" + IIF(mb_CmSeekZSelfPDCM, "'" + ctSelfCmCd + "',", "") + "'" + ADC("OmCmCd") + "') and OmCmCurCd= '" + ADC("OmCmCurCd") + "' and OdPrtKey='" + ctCurrPrtn + "'" + _
                   "Order By OdSfx Desc, (Case When OmCmCd<>'" + ctSelfCmCd + "' Then 1 Else 2 End), OdDmSz Desc")
                   
              ' ***** Manali 350NXt - Check of Design and Region Exclusivity excluded for OmCMCd='ZSELF'
              ' ***** Manali Trading Module - Cust/Region Exc Check skipped for OmCmCtg='S'
              If wo_rsSrcOd.RecCount = 0 Then
                  Set wo_rsSrcOd = moCn.OpenRes("Select Top 1 DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                                     "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, 1 as OdPrdEnt, " + _
                                     "DmPrdInst as OdDmPrdInst,'' as OdSzInst, DmVaCtg as OdVaCtg, " + _
                                     "DmKt as OdKt,DmBagPcs as OdBagPcs, '' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm " + _
                                     " from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                                     " and DmCd='" + wCdDmCd + "' and " + _
                                     " DmHld = 'N' " + _
                                     IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                                     " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                                     " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ") + _
                                     "and (DmSz In ('','" + wCdSz + "') /* or (DmDefSz<> '' and DmDefSz= '" + wCdSz + "')*/ ) " + _
                                     "and DmPrtKey= '" + ctCurrPrtn + "' " + _
                                     "Order By DmSz desc")
                   If wo_rsSrcOd.RecCount > 0 Then
                      mf_CpyRate = False: mf_CpyLabRate = False
                      ms_CpyRateCd = "": ms_CpyRateOpt = "": mf_CpyFrSameCust = False
                      mf_CpyVal = False: wf_CpyFrDsgMst = True
                      mb_CpyKT = False       ' ***** Manali 3.9.0 - Copy KT from PDC
                   Else
                      DispMsg "This Dsg/Sz Combination Does Not Exist In Design Mst/Dsg On Hold/Exclusive For Other Customer", etError: Exit Sub
                   End If
              Else
                  mf_CpyRate = IIF(ADC("WCPYRT") = "Y", True, False): mf_CpyLabRate = IIF(ADC("WCPYLABRT") = "Y", True, False)
                  ms_CpyRateCd = ADC("wCpyRtOpt")
                  ms_CpyRateOpt = moCn.GetFldVal(" Select PDesc225 from Param where PTyp= 'CPYRT' and PMCd= '" + ADC("wCpyRtOpt") + "' ")
                  If wo_rsSrcOd!OmCmCd = ADC("OmCmCd") Then mf_CpyFrSameCust = True
                  mf_CpyVal = True
                  wf_CpyFrDsgMst = False
                  ' ***** Manali 3.9.0 - Copy KT from PDC
                  mb_CpyKT = moCn.RecSeek("Select 'x' from Param Where PTyp='TC' and PMCd='" + wo_rsSrcOd!OmTc + "' and PValue='PL' ")
              End If
                
              ADC.StartCopy
              If Not ADC.SaveRec Then DispMsg "OrdMst Save Failed", etError: Exit Sub
                mi_xlQty = Trim(wo_rsExcel!qQty): ms_xlCol = UCase(Trim(wo_rsExcel!qCol)): ms_xlSpDesc = Left(Trim(wo_rsExcel!qOdSalRem), 100): ms_xlSfx = UCase(Left(Trim(wo_rsExcel!qCdOurSfx), 10))
                ' ***** Manali Excel Import (From Axis)
                ms_xlOdPoNo = UCase(Left(Trim(wo_rsExcel!qOdPoNo), 20)): ms_XlSfxDesc = Left(Trim(wo_rsExcel!qSfxDesc), 255)
                ' ***** Manali Excel Import (From Axis)
                ' ***** Manali 3.8.0 - Stamp Instr added
                mi_xlOdSr = IIF(wb_CpyOdSrFrXl, wo_rsExcel!qOdSr, 0)
                ms_xlExpDelDt = wo_rsExcel!qOdExpDelDt
                ms_xlPrdDelDt = wo_rsExcel!qOdDelDt
                ms_xlStmpInstr = Left(Trim(wo_rsExcel!qStmpInstr), 45)
                mi_xlSalPrc = wo_rsExcel!qOdSalPrc
                ms_xlPrdLine = UCase(wo_rsExcel!qOdLine)
                  Call CpyDets(wo_rsSrcOd, wf_CpyFrDsgMst, True, , , True)
                  If GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz") = "" Then GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz") = wCdSz
                  Call SetCellVal(ADC("WXLSHTNO"), wo_rsExcel!qRow, 16, "Copied To  Sr : " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")))
                  Call SetCellVal(ADC("WXLSHTNO"), wo_rsExcel!qRow, 17, gs_CoCd + "/" + ms_OmTc + "/" + ms_OmYy + "/" + ms_OmChr + "/" + CStr(ADC("OmNo")))
              ADC.EndCopy
              wo_rsExcel.MoveNext
           
      Loop
        If wo_rsExcel.RecCount < (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then DispMsg "Copy completed with Error(s).Check Excel for Errors.", etInfo
        If wo_rsExcel.RecCount = (ADC("WXLToROW") - ADC("WXLFrROW") + 1) Then DispMsg "Copy completed Successfully.", etInfo
        CloseExcel
    End If
  ElseIf ADC("wCpyFrmOrdRfId") = "N" Then
  
    Dim wRs_RfId As MDORowSet
    ms_ErrMsg = "": ms_RfIdStr = ""
    ReadRfId
    ''CmdOrdRfIdRead.Enabled = True         ' ***** Manali 3.10.0 - 20/04/12 - Instead of Read RfId Button, Text box given Where RfId Dtring can be kept to initiate copy
    If ms_ErrMsg <> "" Then Call CmdOrdCpy_Click: Exit Sub
    'ms_RfIdStr = "1,2,6"

    Set wRs_RfId = moCn.OpenRes("Select * from RfIdMst Where RimNo In (" + ms_RfIdStr + ") ")
    wRs_RfId.MoveFirst
    
    If wRs_RfId.RecCount > 0 Then
      Do While Not wRs_RfId.EOF
        
        Set wo_rsSrcOd = moCn.OpenRes("Select DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                           "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, 1 as OdPrdEnt, " + _
                           "DmPrdInst as OdDmPrdInst,'' as OdSzInst, DmVaCtg as OdVaCtg, " + _
                           "DmKt as OdKt,DmBagPcs as OdBagPcs, '' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm " + _
                           " from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                           " and DmCd='" + wRs_RfId!RimDmCd + "' and " + _
                           " DmHld = 'N' " + _
                           IIF(ADC("OmCmCtg") = "S" Or ADC("OmCmCd") = ctSelfCmCd, "", " and (DmCmCd= '' or ','+DmCmCd+',' Like '%,'+'" + ADC("OmCmCd") + "'+',%' or " + _
                           " (','+DmCmCd+',' Not Like '%,'+'" + ADC("OmCmCd") + "'+',%' and DmRegnExc= 'Y' and " + _
                           " (Select CmRegnCd from CustMst where CmCtg= 'C' and CmCd= SubString(DmCmCd, 0, CharIndex(',',DmCmCd+','))) <> '" + ms_CmRegnCd + "' )) ") + _
                           "and DmSz = '' and DmPrtKey= '" + ctCurrPrtn + "' ")
        If wo_rsSrcOd.RecCount > 0 Then
          mf_CpyRate = False: mf_CpyLabRate = False
          ms_CpyRateCd = "": ms_CpyRateOpt = "": mf_CpyFrSameCust = False
          mf_CpyVal = False: wf_CpyFrDsgMst = True
          mb_CpyKT = False
        Else
          DispMsg "This Dsg Does Not Exist In Design Mst/Dsg On Hold/Exclusive For Other Customer", etError: Exit Sub
        End If
        ADC.StartCopy
        If Not ADC.SaveRec Then DispMsg "OrdMst Save Failed", etError: Exit Sub
        Call CpyDets(wo_rsSrcOd, True, True)        '4.1.3.0
        ADC.EndCopy
        wRs_RfId.MoveNext
      Loop
    End If
  
  End If
           
  Call CmdOrdCpy_Click
  Exit Sub
  
ErrHdlr:
  If Err.Number = 429 Then
    DispMsg "MS Excel is either Corrupt Or Missing on this PC. Please Install/Re-Install MS Excel ! ", etError
  ElseIf Err.Number = 70 Then       '4.1.4
    DispMsg "Cannot Access Template File. Close If Already Open and Continue.", etError
  Else
    DispMsg Err.Description, etError
  End If
  If ADC("WCPYFRMEXCEL") = "Y" Then CloseExcel
  '****** Sachin 3.3.0 - (25-06-08) - [12. Import From Excel] ******
End Sub

Private Sub CmdOrdDet_Click()
    '*** Display or hide the Order Detail frame depending on the toggle satate
    
    '*********************** urmi Validity of Customer Code ************************
    Dim wb_ValidCmCd As Boolean
    ' ***** Manali Trading Module - 'C' Replaced By adc("OmCmCtg")
    wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= '" + ADC("OmCmCtg") + "' and " + _
                           "CmCd = '" + ADC("OmCmCD") + "'")
'    wb_ValidCmCd = moCn.RecSeek("select CmCd from CustMst where CmCtg= 'C' and " + _
'                           "CmCd = '" + adc("OmCmCD") + "'")
    
    If wb_ValidCmCd = False Then DispMsg "Invalid Customer code", etError: Exit Sub
    
    ' **** Manali Trading Module
    If ms_OmTcTyp = ctJtTcTyp Then
      If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                          "and TmLocTypFr=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmFrDmLoc") + "'), '') ") Then _
        DispMsg "Invalid From Design Location", etError: Exit Sub
      If Not moCn.RecSeek("Select 'x' from TcMst Where TmCoCd='" + ADC("OmCoCd") + "' and TmTc='" + ADC("OmTc") + "' " + _
                          "and TmLocTypTo=IsNull((Select LocTyp from Loc Where LocCoCd=TmCoCd and LocCd='" + ADC("OmToDmLoc") + "'), '') ") Then _
        DispMsg "Invalid To Design Location", etError: Exit Sub
    End If
    
    '*********************************Zubin ********************************************
    If FraOrdDet.Visible = True Then
    'Check if OmHistCmCtg, OmHistCmCd, OmHistYyyyMm Combination Exists in RmRtHist
    If UCase(ADC("OmHistCmCtg")) = "C" Then
      If ADC("OmHistCmcd") = "" Then _
                  DispMsg " Customer code Cannot be Blank", etError: Exit Sub
'      If Not moCn.RecSeek("select 'x' from RmRtHist where " + _
'            "RhCmCtg = 'C' and RhCmCd = isnull((Select max(RhCmCd) from RmRtHist where " + _
'            "RhCmCtg = 'C' and RhCmCd = '" + adc("OmHistCmCd") + "' and RhYyyyMm = " + _
'            CStr(adc("OmHistYyyyMm")) + "),'ZSELF')") Then
      
      ' ***** Manali Trading Module - 'SPL' - 'C' Replaced By adc("OmCmCtg")
      If Not moCn.RecSeek("select 'x' from RmRtHist where " + _
            "RhCmCtg = '" + ADC("OmCmCtg") + "' and RhCmCd = isnull((Select max(RhCmCd) from RmRtHist where " + _
            "RhCmCtg = '" + ADC("OmCmCtg") + "' and RhCmCd = '" + ADC("OmHistCmCd") + "' and RhYyyyMm = " + _
            CStr(ADC("OmHistYyyyMm")) + "),'ZSELF')") Then
        DispMsg "Customer Category, Customer Code and YyyyMm combination does not exist in RM Rate History", etWarning
        'ADC("OmHistCmCtg").SetFocus  '*** (Bef 3.01)
        '*** (Jen 3.01)
        If ADC("OmHistCmCtg").Visible = True And ADC("OmHistCmCtg").Enabled = True Then ADC("OmHistCmCtg").SetFocus
        '*** (Jen 3.01)
        Exit Sub
      End If
    ElseIf UCase(ADC("OmHistCmCtg")) = "P" Then
'      If Not moCn.RecSeek("Select 'x' from RmRtHist where " + _
'                "RhCmCtg = 'P' and RhCmCd = (Select CmLkUpRmRt from CustMst " + _
'                "where CmCtg = 'C' and CmCd = '" + adc("OmCmCd") + "' and " + _
'                "RhYyyyMm = " + CStr(adc("OmHistYyyyMm")) + ")") Then
                
        ' ***** Manali Trading Module - 'SPL' - 'C' Replaced By adc("OmCmCtg")
      If Not moCn.RecSeek("Select 'x' from RmRtHist where " + _
                "RhCmCtg = 'P' and RhCmCd = (Select CmLkUpRmRt from CustMst " + _
                "where CmCtg = '" + ADC("OmCmCtg") + "' and CmCd = '" + ADC("OmCmCd") + "' and " + _
                "RhYyyyMm = " + CStr(ADC("OmHistYyyyMm")) + ")") Then
        DispMsg "Customer Category, Customer Code and YyyyMm does not exist in RM Rate History", etWarning
        'ADC("OmHistCmCtg").SetFocus   '*** (Bef 3.01)
        '*** (Jen 3.01)
        If ADC("OmHistCmCtg").Visible = True And ADC("OmHistCmCtg").Enabled = True Then ADC("OmHistCmCtg").SetFocus
        '*** (Jen 3.01)
        Exit Sub
      End If
    ElseIf UCase(ADC("OmHistCmCtg")) = vbNullString And ADC("OmHistYyyyMm") <> 0 Then
        DispMsg "Invalid Customer Category", etWarning
        'ADC("OmHistCmCtg").SetFocus    '*** (Bef 3.01)
        '*** (Jen 3.01)
        If ADC("OmHistCmCtg").Visible = True And ADC("OmHistCmCtg").Enabled = True Then ADC("OmHistCmCtg").SetFocus
        '*** (Jen 3.01)
        Exit Sub
    End If
    If ADC.IsNew = False Then ADC.SaveRec
  End If
    Call DispFra(OrdDet)
End Sub
