Private Function MakeQuoation() As Boolean
'***** Procedure to Make the Quotation ****
  Dim i As Integer, j As Integer
  Dim wo_rsSrcOd As MDORowSet

  i = 1
 ' GrdOrdDsg.StartCopy
 ' MWLib.BeginProcess Me, "Copying Records"
  Do While i <= GrdDsgSel.Rows - 1
'    DoEvents
    If GrdDsgSel.Value(i, "wDmSel") = "Y" Then
     ' MWLib.RunningProcess "Copying Details For Sr"   '" + CStr(GrdDsgSel.Value(i, "wDmSr")) + "'"
      '****** Sachin 3.02 - Current Partition
      Set wo_rsSrcOd = moCn.OpenRes("Select DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                       "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, " + _
                       "1 as OdPrdEnt, DmPrdInst as OdDmPrdInst,'' as OdSzInst, " + _
                       "DmVaCtg as OdVaCtg, DmKt as OdKt,DmBagPcs as OdBagPcs, " + _
                       "'' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm " + _
                       "from DsgMst where DmTcTyp= '" + ms_DmTcTyp + "' " + _
                       "and DmCd= '" + Trim(GrdDsgSel.Value(i, "wDmCd")) + "' " + _
                       "and DmSz= '' and DmPrtKey='" + ctCurrPrtn + "' ")
      
      ADC.StartCopy
      'MWLib.RunningProcess "Copying Details For Sr '" + CStr(GrdDsgSel.Value(i, "WDMSR")) + "'"
      mf_CpyRate = False
      mf_CpyLabRate = False
      ms_CpyRateCd = "": ms_CpyRateOpt = ""
      mf_CpyFrSameCust = False
      mf_CpyVal = False     '*** (Jen 2.13)
          
      If Not ADC.SaveRec Then
        DispMsg "X Save Failed", etInfo
        ADC.EndCopy
        Exit Function
      End If
      Call CpyDets(wo_rsSrcOd, True, True)
     ADC.EndCopy
    Else
      j = j + 1
    End If
    i = i + 1
  Loop
  If i = j + 1 Then
    DispMsg "Please Select 'Y' In the Designs For Making Quotation", etError
    MakeQuoation = False
  Else
   ' GrdOrdDsg.EndCopy
   ' MWLib.EndProcess Me
    MakeQuoation = True
  End If
End Function
