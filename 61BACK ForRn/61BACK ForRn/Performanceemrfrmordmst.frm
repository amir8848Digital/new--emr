Private Sub TabSumm_Click(PreviousTab As Integer)
  '*** Whenever a tab is selected enable the frame on the clicked tab and disable the previous tab frame
  '*** Initialise the group option fields (working fields) in the current tab from the Head table
  '*** Call the Summary sub procedures associated with the current tab

  FraTabSumm(TabSumm.Tab).Enabled = True
  FraTabSumm(PreviousTab).Enabled = False
  Select Case TabSumm.Tab
  Case Is = 0
    Call InitSummFlds("wOrdDsgGrp", "hOrdDsgGr")
    Call OrdDsgSumm

'    Call InitSummFlds("wDsgRmGrp", "hOrdRmGr")
'    Call InitSummFlds("wDsgLabGrp", "hOrdLabGr")
'    Call DsgRmSumm
'    Call DsgLabSumm
  Case Is = 1
    Call InitSummFlds("wDsgRmGrp", "hOrdRmGr")
    Call InitSummFlds("wDsgLabGrp", "hOrdLabGr")
    Call DsgRmSumm
    Call DsgLabSumm

'    Call InitSummFlds("wOrdDsgGrp", "hOrdDsgGr")
'    Call OrdDsgSumm
  Case Is = 2
    Call InitSummFlds("wOrdRmGrp", "hOrdRmGr")
    Call InitSummFlds("wOrdLabGrp", "hOrdLabGr")
    Call OrdRmSumm
    Call OrdLabSumm
  End Select
End Sub
Private Sub Pic3D_DblClick()
  '*** If wPic3DDblClk flag option is False then Enlarge the 3-Dimensional picture to fit the FraNKeyAll Frame
  '*** If wPic3DDblClk flag option is True then bring the 3-Dimensional picture to the original pic control size
  
  If GrdOrdDsg.Rows - 1 = 0 Then Exit Sub
  ADC.SetFocus    '*** 2.06
  Dim w3DPth As String
  If wPic3DDblClk = False Then
    '*** Enlarge The Picture ***
    '*** Jay 3.2.0 [PicNm]
    w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPicNm"), , True)  '4.1.0.0 - HD Image
    'w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"))
    
    'Sachin - 4.1.0.0
    If Dir(w3DPth) = "" Then w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPicNm"))
    
    '*** Jay 3.2.0 [PicNm]
    'w3DPth = GetPictPath(ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), , False)
    Call ShowLargePic(IIF(FraNKeyAll.Height - 195 > 0, FraNKeyAll.Height - 195, 0), FraNKeyAll.Width, w3DPth, Pic3D)
   
    FraPic3D.Left = 0: FraPic3D.Top = 195
    FraPic3D.Height = Pic3D.Height + 100: FraPic3D.Width = Pic3D.Width + 100
    FraNKeyAll.ZOrder
    FraPic3D.ZOrder (0)
  Else
    '*** Make The Picture Small ***
    '*** Jay 3.2.0 [PicNm]
    w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPicNm"))
    'w3DPth = GetPictPath(ms_DmTcTyp, False, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"))
    '*** Jay 3.2.0 [PicNm]
    'w3DPth = GetPictPath(ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), , False)
    Call ShowPic(wPic3DHt, wPic3DWdt, w3DPth, Pic3D)
    FraPic3D.Left = wFraPic3DLft: FraPic3D.Top = wFraPic3DTop
    FraPic3D.Height = Pic3D.Height + 100: FraPic3D.Width = Pic3D.Width + 100
    FraNKeyAll.ZOrder
    FraCustDsg.ZOrder   '****** Sachin 2.12 - Cust Dsg in SO
    FraCustRm.ZOrder    '4.1.0.0
    FraDsgFt.ZOrder     '***** Added on 07/05/08 by Sachin
    CmdOrdCpy.ZOrder
    CmdOrdDet.ZOrder
    CmdRefRt.ZOrder
    CmdSM.ZOrder
    CmdCustDsg.ZOrder   '****** Sachin 2.12 - Cust Dsg in SO
  End If
  If wPic3DDblClk = False Then
    wPic3DDblClk = True
  Else
    wPic3DDblClk = False
  End If
End Sub
Private Sub PicHsk_DblClick()
  '*** If wPicHskDblClk flag option is False then Enlarge the Line Drawing to fit the FraNKeyAll Frame
  '*** If wPicHskDblClk flag option is True then bring the Line Drawing to the original pic control size
  
  If GrdOrdDsg.Rows - 1 = 0 Then Exit Sub
  ADC.SetFocus    '*** 2.06
  Dim wHskPth As String
  If wPicHskDblClk = False Then
    '*** Enlarge The Picture ***
    '*** Jay 3.2.0 [PicNm]
    wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPicNm"))
    'wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"))
    '*** Jay 3.2.0 [PicNm]
    'wHskPth = GetPictPath(ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), , True)
    Call ShowLargePic(IIF(FraNKeyAll.Height - 195 > 0, FraNKeyAll.Height - 195, 0), FraNKeyAll.Width, wHskPth, PicHsk)
    FraPicHsk.Left = 0: FraPicHsk.Top = 195
    FraPicHsk.Height = PicHsk.Height + 100: FraPicHsk.Width = PicHsk.Width + 100
    FraNKeyAll.ZOrder
    FraPicHsk.ZOrder (0)
  Else
    '*** Make The Picture Small ***
    '*** Jay 3.2.0 [PicNm]
    wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz"), ADC("OmCoCd"), ADC("OmTc"), ADC("OmYy"), ADC("OmChr"), ADC("OmNo"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"), GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPicNm"))
    'wHskPth = GetPictPath(ms_DmTcTyp, True, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"))
    '*** Jay 3.2.0 [PicNm]
    'wHskPth = GetPictPath(ms_DmTcTyp, GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd"), , True)
    Call ShowPic(wPicHskHt, wPicHskWdt, wHskPth, PicHsk)
    FraPicHsk.Left = wFraPicHskLft: FraPicHsk.Top = wFraPicHskTop
    FraPicHsk.Height = PicHsk.Height + 100: FraPicHsk.Width = PicHsk.Width + 100
    FraNKeyAll.ZOrder
    FraCustDsg.ZOrder   '****** Sachin 2.12 - Cust Dsg in SO
    FraCustRm.ZOrder    '4.1.0.0
    FraDsgFt.ZOrder     '***** Added on 07/05/08 by Sachin
    CmdOrdCpy.ZOrder
    CmdOrdDet.ZOrder
    CmdRefRt.ZOrder
    CmdSM.ZOrder
    CmdCustDsg.ZOrder   '****** Sachin 2.12 - Cust Dsg in SO
  End If
  If wPicHskDblClk = False Then
    wPicHskDblClk = True
  Else
    wPicHskDblClk = False
  End If
End Sub
Private Sub CmdDsgCpy_Click()
  '*** Display or hide the Copy frame depending on the toggle state
  '*** The CausesValidation property of this command button is false. The purpose of this is
      'when the Design Copy option is selected, the grid GrdOrdDsg should not be fully
      'validated i.e. only the validation of the column on which the cursor was previously
      'standing should take place and the row itself should not be saved. When the user exits
      'out of this option, the cursor returns to the same row. The reason is some of the
      'key fields can be filled up only during copy. Hence the row should not be saved
      'before copy as it might generate a trigger error
      
  If mf_DtLocked = True Then Exit Sub
  If FraDsgCpy.Visible = False Then
  
  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  If (GrdOrdDsg.Value(GrdOrdDsg.Row, "OdPrtKey") <> ctCurrPrtn) Or (ADC("OmTc") <> "PL" And CDate(ms_PurgeDt) > ADC("OmDt")) Then DispMsg "Cannot Copy Designs In Orders Prior to Purge Date", etError: Exit Sub
      If GrdOrdDsg.HalfValidate Then
      GrdOrdDsg.SetFocus
      Exit Sub
    End If
    
    '*** Jay 3.4(FG) ***
    If ms_OmTc = "FOT" And Not moCn.RecSeek("select 'x' from OrdDsg where OdTc= 'FIN' and OdDmCd= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' " + _
                "and OdSfx= '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx") + "' and OdDmStkYy = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkYy") + "' and OdDmStkChr = '" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkChr") + "' " + _
                " and OdDmStkNo= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmStkNo")) + " and OdCoCd= '" + ADC("OmCocd") + "' ") Then
        DispMsg "DmStkNum Not Present For Dsg Code and Suffix Combination in ''FG In'' Entry", etError: GrdOrdDsg.SetFocus: Exit Sub
    End If
    '*** Jay 3.4(FG) ***
    '*** (Jen 2.11)
    Dim ws_QbWtEqOrd As String, ws_QbWtFrOrd As String
    ws_QbWtEqOrd = ADC("wDsgQbWtEqOrd")
    ws_QbWtFrOrd = ADC("wDsgQbWtFrOrd")
    '*** (Jen 2.11)
    
    If RetMemExists = True Then Exit Sub    '*** (Jen 2.13)
    
    Call DispFra(DsgCpy)
    ADC("wDsgDmCd") = "": ADC("wDsgSrNo") = 0
    ADC("wDsgDmCd") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd")
    ADC("wDsgSfx") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSfx")
    ADC("wDsgSz") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmSz")
    
    '*** (Jen 2.11)
    If UCase(ADC("wDsgSource")) = UCase(ctDsgCpyBag) And ws_QbWtEqOrd <> "" Then
      ADC("wDsgQbWtEqOrd") = ws_QbWtEqOrd
      ADC("wDsgQbWtFrOrd") = ws_QbWtFrOrd
    End If
    '*** (Jen 2.11)
    
    If GrdOrdDsg.IsNew(GrdOrdDsg.Row) Then
      GrdOrdDsgTgt.Rows = 1
      '****** Sachin 3.02 08-12-07 - Ordtgt will be deleted from Current Partition
      moCn.Execute ("Delete From OrdTgt where " + _
                    "OtCoCd= '" + ADC("OmCoCd") + "' and OtTc= '" + ADC("OmTc") + "' and " + _
                    "OtYy= '" + ADC("OmYy") + "' and OtChr= '" + ADC("OmChr") + "' and " + _
                    "OtNo= " + CStr(ADC("OmNo")) + " and OtSr= " + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + " and OtPrtKey='" + ctCurrPrtn + "'  ")
      
      Dim wRsOrdTgt As MDORowSet, i As Integer
      '****** Sachin 3.02 08-12-07 - Ordtgt will be deleted from Current Partition
      Set wRsOrdTgt = moCn.OpenRes("Select OtRmCtg, OtRmSCtg, OtRmCd from OrdTgt where " + _
                      "OtCoCd= '" + ADC("OmCoCd") + "' and OtTc= '" + ADC("OmTc") + "' and " + _
                      "OtYy= '" + ADC("OmYy") + "' and OtChr= '" + ADC("OmChr") + "' and " + _
                      "OtNo= " + CStr(ADC("OmNo")) + " and OtPrtKey='" + ctCurrPrtn + "' and OtSr= 0 ")
      With GrdOrdDsgTgt
        GrdOrdDsgTgt.StartCopy
        Do While Not (wRsOrdTgt.EOF Or wRsOrdTgt.BOF)
          .AddItem
          i = .Rows - 1
          .Value(i, "OtSr") = CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr"))
          .Value(i, "OtRmCtg") = wRsOrdTgt!OtRmCtg
          .Value(i, "OtRmSCtg") = wRsOrdTgt!OtRmSCtg
          .Value(i, "OtRmCd") = wRsOrdTgt!OtRmCd
          .SaveRec (i)
          wRsOrdTgt.MoveNext
        Loop
        GrdOrdDsgTgt.EndCopy
        If GrdOrdDsgTgt.Rows - 1 > 0 Then ADC("wDsgCpyRt") = "N": ADC("wDsgCpyLabRt") = "N"
      End With
    End If

    If ADC("wDsgCpyRt") = "" Then ADC("wDsgCpyRt") = "N"
    If ms_OmTcTyp = "QB" And ADC("wDsgQbWtEqOrd") = "" Then ADC("wDsgQbWtEqOrd") = "N" '*** Manali 3.3 (QB Condition Added)
    If ADC("wRtByStkYN") = "" Then ADC("wRtByStkYN") = "N"          '****** Sachin 3.3.0
    If ADC("wDsgCpyLabRt") = "" Then ADC("wDsgCpyLabRt") = "N"
    '****** Zubin 3.02.01 - 26/03/08
    ADC("wDsgCpyChgPtrOnStwYN") = GrdOrdDsg.Value(GrdOrdDsg.Row, "OdChgPtrOnStwYN")
    '****** Zubin 3.02.01 - 26/03/08
  Else
    '(Bef 2.11) If ADC("WDSGSOURCE") <> "" Then ADC("WDSGSOURCE") = ""
    Call DispFra(DsgCpy)
  End If
End Sub
Private Sub CmdDsgCpyGo_Click()
  '*** Check if record exists for the specified customer,design,suffix,size in the Party-Design Combination Master
  '*** If then Copy the details of this record
  '*** If Not, Check if record exists for the customer= 'ZSELF' and the specified design,suffix,size in the Party-Design Combination Master
  '*** If then Copy the details of this record
  '*** If Not, Check if record exists for the specified design,suffix,size in the Design Master
  '*** If then Copy the details of this record
  '*** If value is entered in the working field wDsgSrNo, then details of that Sr is copied
  '*** The user can select the copy source of his choice by entering appropriate value in
      'the wDsgSource working field. i.e. the user can copy the details from the design
      'master even if record exists in the Party-Design Combination Master
  
  If GrdOrdRm.Rows > 1 Then DispMsg "Cannot Copy As Raw Material Details Already Exist", etError: Exit Sub
  If GrdOrdLab.Rows > 1 Then DispMsg "Cannot Copy As Labour Details Already Exist", etError: Exit Sub
  ' better to chk isnew
  
  '****** Sachin 3.02 08-12-07 - Current Partition
  If Not moCn.RecSeek("Select * from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                   "and DmCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' and DmSz='' and DmPrtKey='" + ctCurrPrtn + "' ") Then
    DispMsg "Invalid Design Code. Cannot proceed with Copy", etError: Exit Sub
' shall I also chk for suffix and size
  End If
  
  'urmi 2.06 LabRt
  If UCase(ADC("wDsgSource")) = UCase(ctDsgCpyMst) And (ADC("wDsgCpyRt") = "Y" Or ADC("wDsgCpyLabRt") = "Y") Then _
     DispMsg "Cannot Copy Rate As Copy Is From Design Master", etError: Exit Sub
  
  If ADC("wDsgCpyRt") = "Y" And ADC("wDsgCpyRtOpt") = "" Then DispMsg "Copy Rate Option Is Compulsory", etError: Exit Sub
  
  '****** Sachin 3.3.0
  If ADC("WRTBYSTKYN") = "Y" And ADC("WRTBYSTKOPT") = "" Then DispMsg "Copy Stock Rate Option Is Compulsory If Copy Stock Rate is 'Y'", etError: Exit Sub
  
  '*** (Jen 2.11)
  If UCase(ADC("wDsgSource")) = UCase(ctDsgCpyBag) Then
    If ADC("wDsgQbWtEqOrd") = "" Then DispMsg "Weight Copy Option Is Compulsory", etError: Exit Sub
    If ADC("WRTBYSTKYN") = "Y" And ADC("WRTBYSTKOPT") = "" Then DispMsg "Copy Stock Rate Option Is Compulsory", etError: Exit Sub
    'If ADC("wDsgQbWtEqOrd") = "N" And ADC("wDsgQbWtFrOrd") = "" Then DispMsg "Copy Weight From Option Is Compulsory", etError: Exit Sub
  End If
  '*** (Jen 2.11)
  
  '****** Sachin 2.14.0 - Final [16-03-07] ******
  If UCase(ADC("WDSGCPYRT")) = "Y" And UCase(ADC("WDSGQBWTEQORD")) = "N" And _
        UCase(ADC("WDSGCPYRTOPT")) <> UCase(ADC("WDSGQBWTFRORD")) Then
    DispMsg "The Rate Copy Option Should be Same as the Weight Copy Option", etError: Exit Sub
  End If
  '****** Sachin 2.14.0 - Final [16-03-07] ******
   
   ' **** Manali 3.8.0 - Allow Copy Rates for RmCtg Other Than in Target Grid
  Dim wRsTgt As MDORowSet, wRmCtgStr As String
  Set wRsTgt = moCn.OpenRes(" Select Distinct OtRmCtg as OtRmCtg from OrdTgt " + _
                      " Where OtCoCd ='" + ADC("OmCoCd") + "'" + _
                      " And OtTc ='" + ADC("OmTc") + "'" + _
                      " And OtYy = '" + ADC("OmYy") + "'" + _
                      " And OtChr ='" + ADC("OmChr") + "' " + _
                      " And OtNo =" + CStr(ADC("OmNo")) + _
                      " And OtSr =" + CStr(GrdOrdDsg.Value(GrdOrdDsg.Row, "OdSr")) + _
                      IIF(gs_Partition = ctCurrPrtn, " And OtPrtKey = '" + ctCurrPrtn + "'", ""))
                          
  ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wDsgCpyRtOpt") + "' ")
  
  Do While Not (wRsTgt.EOF Or wRsTgt.BOF)
    If InStr(1, "," + ms_CpyRateOpt + ",", "," + wRsTgt!OtRmCtg + ",") >= 1 Then
      wRmCtgStr = wRmCtgStr + IIF(wRmCtgStr = "", "", ",") + wRsTgt!OtRmCtg
    End If
    wRsTgt.MoveNext
  Loop
  If wRmCtgStr <> "" Then DispMsg "Cannot Copy Rates for RmCtg " + wRmCtgStr + " as Record Exists in Target Grid For The Same", etError: Exit Sub
   ' **** Manali 3.8.0 - Allow Copy Rates for RmCtg Other Than in Target Grid
  
  Dim wo_rsSrcOd As MDORowSet, wf_CpyFrDsgMst As Boolean, wCust As String
  mf_CpyRate = False: mf_CpyLabRate = False
  ms_CpyRateCd = "": ms_CpyRateOpt = ""
  mf_CpyFrSameCust = False
  mf_CpyVal = True '*** (Jen 2.13)
  If ADC("wDsgCpyRt") = "Y" Then
    mf_CpyRate = True
    'mf_CpyVal = True    '*** (Jen 2.13)
  End If
  'urmi 2.06 LabRt
  If ADC("wDsgCpyLabRt") = "Y" Then mf_CpyLabRate = True
  
  '****** Sachin 3.3.0 (30-06-08) - [46. FG Quotation By Stk Rate]******
  mf_CpyRtByStk = False
  If GrdOrdDsgTgt.Rows > 1 Then ADC("WRTBYSTKYN") = "N": ADC("wRtByStkOpt") = ""
  If ADC("WRTBYSTKYN") = "Y" Then mf_CpyRtByStk = True
  ms_CpyRtByStkOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wRtByStkOpt") + "' ")
  '****** Sachin 3.3.0 (30-06-08) - [46. FG Quotation By Stk Rate]******
  
  'If mf_CpyLabRate = False Then mf_CpyVal = False    '*** (Jen 2.13)
  ms_CpyRateCd = ADC("wDsgCpyRtOpt")
  'If ms_CpyRateCd <> "GPSDCXAM" Then mf_CpyVal = False    '*** (Jen 2.13)
  If ADC("wDsgQbWtEqOrd") = "N" Then mf_CpyVal = False    '*** (Jen 2.13)
  
  ms_CpyRateOpt = moCn.GetFldVal("Select PDesc225 from Param where PTyp= 'CPYRT' and " + _
                  "PMCd= '" + ADC("wDsgCpyRtOpt") + "' ")
  wf_CpyFrDsgMst = False
  
  ' ****** Manali Trading Module
  mf_CpyDmId = False:  mf_CpyFrBase = False:  mf_CpyFrRef = False
  ' ****** Manali Trading Module
  
  mb_CpyKT = False     ' ***** Manali 3.9.0 - Copy KT from PDC
  
  If ADC("wDsgSrNo") > 0 Then
    mf_CpyFrSameCust = True
    '****** Sachin 3.02 08-12-07 - Current Partition
    Set wo_rsSrcOd = moCn.OpenRes("Select * from OrdDsg where " + _
                 "OdCoCd='" + ADC("OmCoCd") + "' and OdTc='" + ADC("OmTc") + "' and " + _
                 "OdYy='" + ADC("OmYy") + "' and OdChr='" + ADC("OmChr") + "' and " + _
                 "OdNo=" + CStr(ADC("OmNo")) + " and OdSr=" + CStr(ADC("wDsgSrNo")) + _
                 " and OdDmCd='" + GrdOrdDsg.Value(GrdOrdDsg.Row, "OdDmCd") + "' and OdPrtKey='" + ctCurrPrtn + "'")
    If wo_rsSrcOd.RecCount <> 1 Then DispMsg "Invalid SrNo/ SrNo Not Of This Design", etError: Exit Sub
  Else
    If ADC("wDsgSource") = "" Then DispMsg "Design Copy Source Should Be Entered", etError: Exit Sub
    Select Case UCase(ADC("wDsgSource"))
    Case Is = UCase(ctDsgCpyCust), UCase(ctDsgCpySelf)
      If UCase(ADC("wDsgSource")) = UCase(ctDsgCpyCust) Then mf_CpyFrSameCust = True
      wCust = Switch(UCase(ADC("wDsgSource")) = UCase(ctDsgCpyCust), ADC("OmCmCd"), UCase(ADC("wDsgSource")) = UCase(ctDsgCpySelf), ctSelfCmCd)
      mb_CpyKT = True        ' ***** Manali 3.9.0 - Copy KT from PDC
      ' Zubin 213 (CurCd added)
    '****** Sachin 3.02 08-12-07 - Current Partition
    ' ***** Manali Trading Module - OmCmCtg checked for 'PL'
        Set wo_rsSrcOd = moCn.OpenRes("Select * from OrdDsg join OrdMst " + _
                     "on OdOmIdNo=OmIdNo And OdCoCd=OmCoCd and OdTc=OmTc and OdYy=OmYy and OdChr=OmChr " + _
                     "and OdNo=OmNo and OdPrtKey=OmPrtKey Where OmCoCd= '" + ctSelfCoCd + "' and (Select PValue from Param where " + _
                     "PTyp='TC' and PMCd=OmTc)='PL' and OdDmCd='" + ADC("wDsgDmCd") + "' and " + _
                     "OdDmSz='" + ADC("wDsgSz") + "' and OdSfx='" + ADC("wDsgSfx") + "' and OmCmCtg='" + ADC("OmCmCtg") + "' and " + _
                     "OmCmCd='" + wCust + "' and OmCmCurCd= '" + ADC("OmCmCurCd") + "' and OdPrtKey='" + ctCurrPrtn + "'")
                     '(index=OrdMst)
        If wo_rsSrcOd.RecCount <> 1 Then DispMsg "This Cur/Dsg/Suf/Sz Combination Does Not Exist In Party-Design Combination Master", etError: Exit Sub
    '*** Jay 3.4(FG)
    '*** (Jen 2.11)
    Case Is = UCase(ctDsgCpyBag), UCase(ctDsgCpyDmId)
      Dim ws_Ord() As String
      If ADC("wDsgSrcVch") = "" Then
          DispMsg IIF(UCase(ADC("wDsgSource")) = UCase(ctDsgCpyBag), "Design Copy  Should Be Entered", "Design Copy Source Vch for DmStkNo Does Not Exists"), etError: Exit Sub
      End If
      If ADC("wDsgSrcVch") <> "" Then
        ws_Ord = Split(ADC("wDsgSrcVch"), "/")
        If UBound(ws_Ord) <> 4 Then DispMsg "Invalid Order Voucher Format", etError: Exit Sub
        If Not IsNumeric(ws_Ord(3)) Then DispMsg "Invalid Ord No Format", etError: Exit Sub
        If Not IsNumeric(ws_Ord(4)) Then DispMsg "Invalid Ord Sr Format", etError: Exit Sub
        
        ' ***** Manali Trading Module
        If ADC("OmCmCurCd") <> moCn.GetFldVal("Select OmCmCurCd from OrdMst where OmCoCd= '" + ADC("OmCoCd") + "' " + _
                         "and (Select PValue from Param where PTyp= 'TC' and " + _
                         "PMCd= OmTc)= " + IIF(UCase(ADC("wDsgSource")) <> UCase(ctDsgCpyDmId), "'SO'", "'" + ms_OmTcTyp + "'") + _
                         "and OmTc= '" + ws_Ord(0) + "' and OmYy= '" + ws_Ord(1) + "' " + _
                         "and OmChr= '" + ws_Ord(2) + "' and OmNo= " + ws_Ord(3) + " " + _
                         "and OmPrtKey='" + ctCurrPrtn + "' ") And _
          (ADC("wDsgCpyRt") = "Y" Or ADC("wDsgCpyLabRt") = "Y") Then
          DispMsg "Currency of Source Vch and Target Voucher not matching", etError: Exit Sub
        End If
        
        '****** Sachin 3.02 08-12-07 - Current Partition
        ' ***** Manali Trading Module -
        Set wo_rsSrcOd = moCn.OpenRes("Select * from OrdDsg where OdCoCd= '" + ADC("OmCoCd") + "' " + _
                         "and (Select PValue from Param where PTyp= 'TC' and " + _
                         "PMCd= OdTc)= " + IIF(UCase(ADC("wDsgSource")) <> UCase(ctDsgCpyDmId), "'SO'", "'" + ms_OmTcTyp + "'") + _
                         "and OdTc= '" + ws_Ord(0) + "' and OdYy= '" + ws_Ord(1) + "' " + _
                         "and OdChr= '" + ws_Ord(2) + "' and OdNo= " + ws_Ord(3) + " " + _
                         "and OdSr= " + ws_Ord(4) + " and OdPrtKey='" + ctCurrPrtn + "' ")

        If wo_rsSrcOd.RecCount <> 1 Then DispMsg "This Order Voucher Sr Does Not Exist", etError: Exit Sub
        If ADC("wDsgSource") = UCase(ctDsgCpyDmId) Then
            ' ***** Manali Trading Module
            mf_CpyDmId = True
            If mBaseTc = ws_Ord(0) And GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdBaseVchSr") <> "" Then
              mf_CpyFrBase = True
            'ElseIf mRefTc = ws_Ord(0) And GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdRefVchSr") <> "" Then
            ElseIf InStr(1, mRefTc, ws_Ord(0)) >= 1 And GrdOrdDsg.Value(GrdOrdDsg.Row, "wOdRefVchSr") <> "" Then
              mf_CpyFrRef = True
            End If
            ' ***** Manali Trading Module
        End If
      End If
    '*** (Jen 2.11)
    '*** Jay 3.4(FG)
    Case Is = UCase(ctDsgCpyMst)
      '****** Sachin 3.02 08-12-07 - Current Partition
      '*** Jay 3.2.0 [DefSz]
      '***(Bef 08/02/08)
      'Set wo_rsSrcOd = moCn.OpenRes("Select DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                       "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, 1 as OdPrdEnt, " + _
                       "DmPrdInst as OdDmPrdInst,'' as OdSzInst, DmVaCtg as OdVaCtg, " + _
                       "DmKt as OdKt,DmBagPcs as OdBagPcs, '' as OdSfxDesc, '' as OdSalRem " + _
                       "from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                       "and DmCd='" + ADC("wDsgDmCd") + "' and (DmSz='" + ADC("wDsgSz") + "' or DmDefSz='" + ADC("wDsgSz") + "' ) and DmPrtKey='" + ctCurrPrtn + "' ")
      '***(Bef 08/02/08)
      '*** (Jen 08/02/08)
      Set wo_rsSrcOd = moCn.OpenRes("Select Top 1 DmCd as OdDmCd, DmSz as OdDmSz, '' as OdSfx, " + _
                       "DmPrdSeq as OdPrdSeq, DmCol as OdDmCol, 1 as OdOrdEnt, 1 as OdPrdEnt, " + _
                       "DmPrdInst as OdDmPrdInst,'' as OdSzInst, DmVaCtg as OdVaCtg, " + _
                       "DmKt as OdKt,DmBagPcs as OdBagPcs, '' as OdSfxDesc, '' as OdSalRem, '' as OdPicNm " + _
                       "from DsgMst where DmTcTyp='" + ms_DmTcTyp + "' " + _
                       "and DmCd='" + ADC("wDsgDmCd") + "' " + _
                       "and (DmSz= '" + ADC("wDsgSz") + "' or (DmDefSz<> '' and DmDefSz= '" + ADC("wDsgSz") + "') ) " + _
                       "and DmPrtKey= '" + ctCurrPrtn + "' " + _
                       "Order By DmSz desc")
      '*** (Jen 08/02/08)
      '*** Jay 3.2.0 [DefSz]
      If wo_rsSrcOd.RecCount <> 1 Then DispMsg "This Dsg/Sz Combination Does Not Exist In Design Mst", etError: Exit Sub
      wf_CpyFrDsgMst = True
    End Select
  End If
