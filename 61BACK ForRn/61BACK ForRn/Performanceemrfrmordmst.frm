Private Sub CmdRefRt_Click()

  '*** Display or hide the Refresh Rate frame depending on the toggle satate
  If mf_DtLocked = True Then DispMsg "Cannot Refresh Rates In Locked Entry", etError: Exit Sub

  '****** Sachin 3.02 19-12-07 - Cannot Copy Order In Orders that are entered before Purge date
  ' ******* Manali - 05/01/08
  If ADC("OmPrtKey") <> ctCurrPrtn Then DispMsg "Cannot Refresh Rates In Orders of Previous Partition", etError: Exit Sub
  'If ADC("OmPrtKey") <> ctCurrPrtn Or CDate(ms_PurgeDt) >= ADC("OmDt") Then DispMsg "Cannot Refresh Rates In Orders of Previous Partition or Order Prior to Purge Date", etError: Exit Sub
  
  
  '*** Display or hide the Refresh Rate frame depending on the toggle satate
  If ADC("OmLockYN") = "Y" Then DispMsg "Order is Locked, Rates can not be Refreshed.", etError
  
  ' ***** Manali Trading Module
  If ADC.AddFndMode = xFndMode And ms_OmTcTyp = ctJtTcTyp And CmdInvHd.Visible And mb_InvCls Then _
    DispMsg "Rates can not be Refreshed, Invoice Is Closed.", etError: Exit Sub
  
  '*****Geeta***Crm***2.12
'  If ADC("OmAckYN") = "N" Then DispMsg "Order is UnAcknowledged,Rates Cannot be Refreshed", etError
  If (ADC("OmAckYN") = "N" And (Not mb_CrmDb)) Then
    DispMsg "Order/Quotation is Unacknowledged,Rates Cannot be Refreshed", etError: Exit Sub
  ElseIf (mb_CrmDb And ADC("OmSubmitYN") <> "N") Then
    DispMsg "Order/Quotation is Submitted,Rates Cannot be Refreshed.", etError: Exit Sub
  End If

  ' ***** Manali 3.9.0 - Scope check skipped for PDC
  If ms_OmTcTyp <> "PL" And (ADC("WSCDMCTGFR") <> "" Or ADC("WSCDMCTGTO") <> "" Or ADC("WSCDMCDFR") <> "" Or _
     ADC("WSCDMCDTO") <> "" Or ADC("WSCSRTPDC") <> "") Then
      DispMsg "Scope and Sort Options should be Blank To Refresh Rates", etWarning
  Else
    If ADC("wOmRefMulByYn") = "" Then ADC("wOmRefMulByYn") = "N"
    CmdRefRtGo.Enabled = True
    Call DispFra(RefRt)
  End If
End Sub
