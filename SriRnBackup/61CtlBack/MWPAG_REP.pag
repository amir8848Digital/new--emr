   End
End
Attribute VB_Name = "MWPAG_REP"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Dim wtmpconn As mwflib.MDOConnection
Dim wtmprs As mwflib.MDORowSet
Dim ColName As String
Private Sub CMB_TABLES_Click()
    LST_COLUMNS.Clear
    LST_COLDET.Clear
    Set wtmprs = wtmpconn.OpenRes("Select * from " + CMB_TABLES)
    For i = 0 To wtmprs.FldCount - 1
        LST_COLUMNS.Additem " ¶ " + wtmprs.FldDets(i).fdFldName
    Next
End Sub
Private Sub CMB_TABLES_GotFocus()
    If TXT_DB <> "" And CMB_TABLES.ListCount = 0 Then
        Call FilTables
    End If
    Const CB_SHOWDROPDOWN = &H14F
    Dim Tmp
    Tmp = SendMessage(CMB_TABLES.hwnd, CB_SHOWDROPDOWN, 1, ByVal 0&)
End Sub
Private Sub LST_COLUMNS_Click()
    Dim wdata As EnMDOFldType
    ColName = Mid(LST_COLUMNS, 4)
    LST_COLDET.Clear
    wdata = wtmprs.FldDets(ColName).fdFldType
    wdatatype = Switch(wdata = mdoftString, "Character", wdata = mdoftInt, "Integer", wdata = mdoftFloat, "Float", wdata = mdoftDateTime, "DateTime")
    LST_COLDET.Additem "Data Type      : " + wdatatype
    LST_COLDET.Additem "Data Size      : " + CStr(wtmprs.FldDets(ColName).fdFldsize)
End Sub
Private Sub LST_COLUMNS_DBLCLICK()
    TXT_CMPSTR = ColName
    If UCase(Right(SelectedControls(0).IdName, 2)) = "FR" Then
        TXT_CMPSTR = TXT_CMPSTR + " >= "
    ElseIf UCase(Right(SelectedControls(0).IdName, 2)) = "TO" Then
        TXT_CMPSTR = TXT_CMPSTR + " <= "
    ElseIf UCase(Right(SelectedControls(0).IdName, 3)) = "SEL" Then
        TXT_CMPSTR = TXT_CMPSTR + " in "
    End If
End Sub
Private Sub PropertyPage_ApplyChanges()
    With SelectedControls(0)
        .CmpStr = TXT_CMPSTR
    End With
End Sub
Private Sub PropertyPage_GotFocus()
    TXT_DB.SetFocus
End Sub
Private Sub PropertyPage_SelectionChanged()
    TXT_DB = Mid(App.EXEName, 1, 3)
    With SelectedControls(0)
        TXT_CMPSTR = .CmpStr
    End With
End Sub
Private Sub TXT_CMPSTR_Change()
    PropertyPage.Changed = True
End Sub
Private Sub TXT_DB_LostFocus()
    Call FilTables
End Sub
Private Sub FilTables()
    On Error GoTo errh
    CMB_TABLES.Clear
    Dim wLogindets As SQLLogInDets
    wLogindets.m_DSNName = Trim(TXT_DB)
    Set wtmpconn = New MDOConnection
    Call wtmpconn.SetConn(wLogindets)
    Dim wtmptblrs As MDORowSet
    Set wtmptblrs = wtmpconn.OpenTableRes
    Do While Not (wtmptblrs.EOF Or wtmptblrs.BOF)
'??? hcdd
        If wtmptblrs.FldValue(3) = "TABLE" Then
            CMB_TABLES.Additem wtmptblrs.FldValue(2)
        End If
        wtmptblrs.MoveNext
    Loop
    Set wtmptblrs = Nothing
    Exit Sub
errh:
    MsgBox Err.Description
End Sub

