Attribute VB_Name = "MWPAG_FLX"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Dim wprop_arr()
Dim wf_callchng As Boolean
Dim wtmpconn As mwflib.MDOConnection
Dim wtmprs As mwflib.MDORowSet
Dim ms_selcolname As String
Dim me_selcoltype As en_FldDataType
Dim mi_SelColSize As Integer
Private Sub arr_txt_props_Change(Index As Integer)
    If Index = 2 And arr_txt_props(0) = "" Then
        arr_txt_props(0) = arr_txt_props(2)
    End If
    wprop_arr(Combo1.ListIndex + 1, Index) = arr_txt_props(Index)
    PropertyPage.Changed = True
End Sub
Private Sub arr_cmb_props_Click(Index As Integer)
    wprop_arr(Combo1.ListIndex + 1, Index + 7) = arr_cmb_props(Index).ItemData(arr_cmb_props(Index).ListIndex)
    PropertyPage.Changed = True
End Sub
Private Sub Combo1_Click()
    wf_callchng = False
    wcolname = wprop_arr(Combo1.ListIndex + 1, 0)
    For i = 0 To 6
        arr_txt_props(i) = wprop_arr(Combo1.ListIndex + 1, i)
    Next i
    Call IniDataType(wprop_arr(Combo1.ListIndex + 1, 7))
    For i = 0 To arr_cmb_props(1).ListCount - 1
        If arr_cmb_props(1).ItemData(i) = wprop_arr(Combo1.ListIndex + 1, 8) Then
            arr_cmb_props(1).ListIndex = i
            Exit For
        End If
    Next i
    For i = 0 To arr_cmb_props(2).ListCount - 1
        If arr_cmb_props(2).ItemData(i) = wprop_arr(Combo1.ListIndex + 1, 9) Then
            arr_cmb_props(2).ListIndex = i
            Exit For
        End If
    Next i
    TXT_RECALCPARENT = wprop_arr(Combo1.ListIndex + 1, 10)
    wf_callchng = True
End Sub
Private Sub IniDataType(Value As Variant)
    For i = 0 To arr_cmb_props(0).ListCount - 1
        If arr_cmb_props(0).ItemData(i) = Value Then
            arr_cmb_props(0).ListIndex = i
            Exit For
        End If
    Next i
End Sub
Private Sub IniStyle(Value As Variant)
    For i = 0 To arr_cmb_props(1).ListCount - 1
        If arr_cmb_props(1).ItemData(i) = Value Then
            arr_cmb_props(1).ListIndex = i
            Exit For
        End If
    Next i
End Sub
Private Sub CmdData_Click()
    TXT_DB = Mid(App.EXEName, 1, 3)
    fra_Data.Visible = True
    TXT_DB.SetFocus
End Sub
Private Sub List1_Click()
    arr_txt_props(5) = IIf(arr_txt_props(5) <> "", arr_txt_props(5) + ",", "") + List1
End Sub
Private Sub PropertyPage_ApplyChanges()
    wffrmt = Space(2) + "|"
    For i = 1 To UBound(wprop_arr)
        SelectedControls(0).ColProp(i).ColName = wprop_arr(i, 0)
        SelectedControls(0).ColProp(i).Heading = wprop_arr(i, 1)
        wffrmt = wffrmt + wprop_arr(i, 1) + "|"
        SelectedControls(0).ColProp(i).DataFld = wprop_arr(i, 2)
        SelectedControls(0).ColProp(i).Mask = wprop_arr(i, 3)
        SelectedControls(0).ColProp(i).MaxLength = wprop_arr(i, 4)
        SelectedControls(0).ColProp(i).ReCalcOn(SelectedControls(0)) = wprop_arr(i, 5)
        SelectedControls(0).ColProp(i).ToolTipText = wprop_arr(i, 6)
        SelectedControls(0).ColProp(i).DataType = wprop_arr(i, 7)
        SelectedControls(0).ColProp(i).Style = wprop_arr(i, 8)
        'SelectedControls(0).ColProp(i).HlpType = wprop_arr(i, 9)
        'SelectedControls(0).ColProp(i).ReCalcParent = wprop_arr(i, 10)
    Next i
    SelectedControls(0).FormatString = Mid(wffrmt, 1, Len(wffrmt) - 1)
    Set wtmprs = Nothing
    Set wtmpconn = Nothing
End Sub
Private Sub PropertyPage_SelectionChanged()
    Combo1.Clear
    wtotcol = SelectedControls(0).Cols
    ReDim wprop_arr(1 To wtotcol - 1, 10)
    For i = 1 To UBound(wprop_arr)
            wReqStr = "Columns" + Trim(CStr(i))
            Combo1.Additem wReqStr
            wprop_arr(i, 0) = SelectedControls(0).ColProp(i).ColName
            wprop_arr(i, 1) = SelectedControls(0).ColProp(i).Heading
            wprop_arr(i, 2) = SelectedControls(0).ColProp(i).DataFld
            wprop_arr(i, 3) = SelectedControls(0).ColProp(i).Mask
            wprop_arr(i, 4) = SelectedControls(0).ColProp(i).MaxLength
            wprop_arr(i, 5) = SelectedControls(0).ColProp(i).ReCalcOn
            wprop_arr(i, 6) = SelectedControls(0).ColProp(i).ToolTipText
            wprop_arr(i, 7) = SelectedControls(0).ColProp(i).DataType
            wprop_arr(i, 8) = SelectedControls(0).ColProp(i).Style
            wprop_arr(i, 9) = ""
            wprop_arr(i, 10) = SelectedControls(0).ColProp(i).ReCalcParent
    Next i
    List1.Clear
    Dim waddstr As String
    Dim waddstrcoll As String
    
    
'*** Bef 20/01/05
'    For Each Control In SelectedControls(0).ParentRef.Controls
'        If TypeOf Control Is MWCTL_MED Or TypeOf Control Is MWCTL_FLX Then
'            If TypeOf Control Is MWCTL_FLX Then
'                For i = 1 To Control.Cols - 1
'                    waddstr = Control.Name + "(" + Control.ColProp(i).ColName + ")"
'                    List1.Additem waddstr
'                Next i
'            Else
'                waddstr = Control.IdName
'                List1.Additem waddstr
'            End If
'        End If
'    Next
'*** Bef 20/01/05

    
    '*** Jenny
    Dim wo_Ctrl As Object
    For Each wo_Ctrl In SelectedControls(0).ParentRef.Controls
        If TypeOf wo_Ctrl Is MWCTL_MED Or TypeOf wo_Ctrl Is MWCTL_FLX Then
            If TypeOf wo_Ctrl Is MWCTL_FLX Then
                For i = 1 To wo_Ctrl.Cols - 1
                    waddstr = wo_Ctrl.Name + "(" + wo_Ctrl.ColProp(i).ColName + ")"
                    List1.Additem waddstr
                Next i
            Else
                waddstr = wo_Ctrl.IdName
                List1.Additem waddstr
            End If
        End If
    Next
    '*** Jenny
    
    arr_cmb_props(0).Clear
    arr_cmb_props(0).Additem "CharType"
    arr_cmb_props(0).ItemData(0) = en_FldDataType.fdtCharType
    arr_cmb_props(0).Additem "Number"
    arr_cmb_props(0).ItemData(1) = en_FldDataType.fdtNumber
    arr_cmb_props(0).Additem "Float"
    arr_cmb_props(0).ItemData(2) = en_FldDataType.fdtFloat
    arr_cmb_props(0).Additem "DateType"
    arr_cmb_props(0).ItemData(3) = en_FldDataType.fdtDateType
    arr_cmb_props(0).Additem "ConvertToUpper"
    arr_cmb_props(0).ItemData(4) = en_FldDataType.fdtConvertToUpper
    arr_cmb_props(0).Additem "TimeType"
    arr_cmb_props(0).ItemData(5) = en_FldDataType.fdtTimeType

    arr_cmb_props(1).Additem "Normal"
    arr_cmb_props(1).ItemData(0) = en_fgColStyle.fgcNormal
    arr_cmb_props(1).Additem "ReadOnly"
    arr_cmb_props(1).ItemData(1) = en_fgColStyle.fgcReadOnly
    arr_cmb_props(1).Additem "Invisible"
    arr_cmb_props(1).ItemData(2) = en_fgColStyle.fgcinvisible
End Sub
Private Sub CMB_TABLES_Click()
    LST_COLUMNS.Clear
    LST_COLDET.Clear
    Set wtmprs = wtmpconn.OpenRes("Select * from " + CMB_TABLES)
    For i = 0 To wtmprs.FldCount - 1
        LST_COLUMNS.Additem " ¶ " + wtmprs.FldDets(i).fdFldName
    Next
End Sub
Private Sub CMB_TABLES_GotFocus()
    If TXT_DB <> "" And CMB_TABLES.ListCount = 0 Then
        Call FilTables
    End If
    Const CB_SHOWDROPDOWN = &H14F
    Dim Tmp
    Tmp = SendMessage(CMB_TABLES.hwnd, CB_SHOWDROPDOWN, 1, ByVal 0&)
End Sub
Private Sub LST_COLUMNS_Click()
    Dim wdata As EnMDOFldType
    ColName = Mid(LST_COLUMNS, 4)
    LST_COLDET.Clear
    wdata = wtmprs.FldDets(ColName).fdFldType
    wdatatype = Switch(wdata = mdoftString, "Character", wdata = mdoftInt, "Integer", wdata = mdoftFloat, "Float", wdata = mdoftDateTime, "DateTime")
    LST_COLDET.Additem "Data Type      : " + wdatatype
    LST_COLDET.Additem "Data Size      : " + CStr(wtmprs.FldDets(ColName).fdFldsize)
    ms_selcolname = ColName
    me_selcoltype = Switch(wdata = mdoftString, en_FldDataType.fdtConvertToUpper, wdata = mdoftInt, fdtNumber, wdata = mdoftFloat, fdtFloat, wdata = mdoftDateTime, fdtDateType)
    mi_SelColSize = wtmprs.FldDets(ColName).fdFldsize
End Sub
Private Sub CmdOk_Click()
    arr_txt_props(2) = ms_selcolname
    Call IniDataType(me_selcoltype)
    arr_txt_props(4) = mi_SelColSize
    Call IniStyle(en_fgColStyle.fgcNormal)
    fra_Data.Visible = False
End Sub
Private Sub cmdcancel_click()
    fra_Data.Visible = False
End Sub
Private Sub FilTables()
    On Error GoTo errh
    CMB_TABLES.Clear
    Dim wLogindets As SQLLogInDets
    wLogindets.m_DSNName = Trim(TXT_DB)
    Set wtmpconn = New MDOConnection
    Call wtmpconn.SetConn(wLogindets)
    Dim wtmptblrs As MDORowSet
    Set wtmptblrs = wtmpconn.OpenTableRes
    Do While Not (wtmptblrs.EOF Or wtmptblrs.BOF)
'??? hcdd
        If wtmptblrs.FldValue(3) = "TABLE" Then
            CMB_TABLES.Additem wtmptblrs.FldValue(2)
        End If
        wtmptblrs.MoveNext
    Loop
    Set wtmptblrs = Nothing
    Exit Sub
errh:
    MsgBox Err.Description
End Sub
Private Sub TXT_RECALCparent_Change()
    wprop_arr(Combo1.ListIndex + 1, 10) = TXT_RECALCPARENT
    PropertyPage.Changed = True
End Sub
