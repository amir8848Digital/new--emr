   ClientLeft      =   0
   ClientTop       =   0
   ClientWidth     =   5625
   PaletteMode     =   0  'Halftone
   ScaleHeight     =   4020
   ScaleWidth      =   5625
   Begin VB.TextBox TXT_DB 
      Height          =   375
      Left            =   2040
      TabIndex        =   0
      Top             =   120
      Width           =   2775
   End
   Begin VB.ListBox LST_COLDET 
      BeginProperty Font 
         Name            =   "Courier"
         Size            =   9.75
         Charset         =   0
         Weight          =   400
         Underline       =   0   'False
