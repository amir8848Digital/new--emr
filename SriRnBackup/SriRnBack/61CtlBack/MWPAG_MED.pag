Attribute VB_Name = "MWPAG_MED"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Dim wcurobj As Object
Private Sub lst_CTLS_Click()
    TXT_RECALC = IIf(TXT_RECALC <> "", TXT_RECALC + ",", "") + lst_ctls
End Sub
Private Sub PropertyPage_ApplyChanges()
    wcurobj.ReCalcOn = TXT_RECALC
'    wcurobj.ReCalcParent = TXT_RECALCPARENT
End Sub
