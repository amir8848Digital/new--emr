'*** Bef 20/01/05

Private Sub PropertyPage_SelectionChanged()
    Dim wo_Control As Object   '*** Jenny
    Set wasd = SelectedControls(0).ParentRef
    lst_ctls.Clear
    For Each wo_Control In wasd.Controls
        ASD = wo_Control.Name
        If TypeOf wo_Control Is MWCTL_FLX Or TypeOf wo_Control Is MWCTL_MED Then
            If TypeOf wo_Control Is MWCTL_FLX Then
                For i = 1 To wo_Control.Cols - 1
                    wReqStr = wo_Control.Name + "(" + wo_Control.ColProp(i).ColName + ")"
                    lst_ctls.Additem wReqStr
                Next i
            Else
                wReqStr = wo_Control.IdName
                lst_ctls.Additem wReqStr
            End If
        End If
    Next wo_Control
    Set wcurobj = SelectedControls(0)
    TXT_RECALC = SelectedControls(0).ReCalcOn
    TXT_RECALCPARENT = SelectedControls(0).ReCalcParent
End Sub
Private Sub TXT_RECALC_Change()
    PropertyPage.Changed = True
End Sub
Private Sub TXT_RECALCparent_Change()
    PropertyPage.Changed = True
End Sub
        
